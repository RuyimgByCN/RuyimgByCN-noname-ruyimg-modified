--- /dev/null
+++ b/apps/game-server/src/native_ws_e2e/peer.rs
@@ -0,0 +1,211 @@
+//! Shared authenticated production WebSocket test peer.
+use super::*;
+
+impl Peer {
+    pub(super) async fn connect(server: &Server) -> Self {
+        Self::connect_url(&server.url).await
+    }
+
+    pub(super) async fn connect_url(url: &str) -> Self {
+        let (ws, response) = tokio_tungstenite::connect_async(url).await.unwrap();
+        assert_eq!(response.status().as_u16(), 101);
+        let mut peer = Self {
+            ws,
+            room: 0,
+            player: PlayerId::NONE,
+            token: String::new(),
+            seq: 0,
+        };
+        peer.until(|message| matches!(message, ServerMessage::Welcome { .. }))
+            .await;
+        peer.send(ClientMessage::Hello {
+            versions: engine_api::VersionBundle::current(),
+            display_name: "ws-test".into(),
+        })
+        .await;
+        peer
+    }
+
+    pub(super) async fn send(&mut self, message: ClientMessage) {
+        self.ws
+            .send(Message::Text(encode_c2s(&message).unwrap().into()))
+            .await
+            .unwrap();
+    }
+
+    pub(super) async fn until(&mut self, matches: impl Fn(&ServerMessage) -> bool) -> ServerMessage {
+        for _ in 0..40 {
+            let frame = tokio::time::timeout(Duration::from_secs(10), self.ws.next())
+                .await
+                .expect("WS response timeout")
+                .expect("WS remains open")
+                .unwrap();
+            if let Message::Text(text) = frame {
+                let message = decode_s2c(text.as_ref()).expect("valid server protocol");
+                if matches(&message) {
+                    return message;
+                }
+                assert!(
+                    !matches!(message, ServerMessage::Error { .. }),
+                    "unexpected {message:?}"
+                );
+            }
+        }
+        panic!("expected WS response within 40 frames");
+    }
+
+    pub(super) async fn join_result(&mut self) -> State {
+        let message = self
+            .until(|message| matches!(message, ServerMessage::JoinOk { .. }))
+            .await;
+        if let ServerMessage::JoinOk {
+            room_id,
+            player_id,
+            reconnect_token,
+            role,
+            seat,
+            ..
+        } = &message
+        {
+            match role {
+                ClientRole::Player => assert_eq!(*seat as u32 + 1, *player_id),
+                ClientRole::Spectator | ClientRole::Referee => {
+                    assert_eq!(*player_id, 0);
+                    assert_eq!(*seat, u8::MAX);
+                }
+            }
+            self.room = *room_id;
+            self.player = PlayerId::new(*player_id);
+            self.token = reconnect_token.clone();
+        }
+        State::from_message(message)
+    }
+
+    pub(super) async fn create(&mut self) -> State {
+        self.send(ClientMessage::CreateRoom {
+            choice_timeout_secs: None,
+            players: 2,
+            seed: SEED,
+            password: PASSWORD.into(),
+        })
+        .await;
+        self.join_result().await
+    }
+
+    pub(super) async fn join(&mut self, room_id: u64, seat: u8, token: Option<String>) -> State {
+        self.send(ClientMessage::JoinRoom {
+            room_id,
+            password: PASSWORD.into(),
+            preferred_seat: Some(seat),
+            reconnect_token: token,
+        })
+        .await;
+        self.join_result().await
+    }
+
+    pub(super) async fn spectate(&mut self, room_id: u64) -> State {
+        self.send(ClientMessage::Spectate { room_id }).await;
+        self.join_result().await
+    }
+
+    pub(super) async fn snapshot(&mut self) -> State {
+        self.seq += 1;
+        let sequence = self.seq;
+        self.send(ClientMessage::RequestSnapshot {
+            header: MessageHeader::new(self.room, sequence, 0),
+            last_revision: 0,
+        })
+        .await;
+        State::from_message(self.until(|message| {
+            matches!(message, ServerMessage::Snapshot { header, .. } if header.conn_seq == sequence)
+        }).await)
+    }
+
+    pub(super) async fn submit(
+        &mut self,
+        actor: PlayerId,
+        expected: u64,
+        key: u64,
+        kind: CommandKind,
+    ) -> (CommandResult, State) {
+        self.seq += 1;
+        let sequence = self.seq;
+        self.send(ClientMessage::SubmitCommand {
+            header: MessageHeader::new(self.room, sequence, expected),
+            command: Command {
+                actor,
+                expected_revision: ExpectedRevision(expected),
+                idempotency_key: IdempotencyKey(key),
+                kind,
+            },
+            idempotency_key: IdempotencyKey(key),
+            replay: false,
+        })
+        .await;
+        let message = self.until(|message| {
+            matches!(message, ServerMessage::CommandOutcome { header, .. } if header.conn_seq == sequence)
+        }).await;
+        let result = match &message {
+            ServerMessage::CommandOutcome { result, .. } => result.clone(),
+            _ => unreachable!(),
+        };
+        (result, State::from_message(message))
+    }
+
+    pub(super) async fn submit_replay(
+        &mut self,
+        actor: PlayerId,
+        expected: u64,
+        key: u64,
+        kind: CommandKind,
+    ) -> (CommandResult, State) {
+        self.seq += 1;
+        let sequence = self.seq;
+        self.send(ClientMessage::SubmitCommand {
+            header: MessageHeader::new(self.room, sequence, expected),
+            command: Command {
+                actor,
+                expected_revision: ExpectedRevision(expected),
+                idempotency_key: IdempotencyKey(key),
+                kind,
+            },
+            idempotency_key: IdempotencyKey(key),
+            replay: true,
+        })
+        .await;
+        let message = self
+            .until(|message| {
+                matches!(message, ServerMessage::CommandOutcome { header, .. } if header.conn_seq == sequence)
+            })
+            .await;
+        let result = match &message {
+            ServerMessage::CommandOutcome { result, .. } => result.clone(),
+            _ => unreachable!(),
+        };
+        (result, State::from_message(message))
+    }
+
+    pub(super) async fn pushed(&mut self, key: u64) -> State {
+        State::from_message(
+            self.until(|message| {
+                matches!(message, ServerMessage::CommandOutcome { header, idempotency_key, .. }
+                if header.conn_seq == 0 && idempotency_key.0 == key)
+            })
+            .await,
+        )
+    }
+
+    pub(super) async fn error(&mut self, expected: ErrorCode) {
+        let message = self
+            .until(|message| matches!(message, ServerMessage::Error { .. }))
+            .await;
+        assert!(
+            matches!(message, ServerMessage::Error { code, .. } if code == expected),
+            "{message:?}"
+        );
+    }
+
+    pub(super) async fn close(mut self) {
+        self.ws.close(None).await.unwrap();
+    }
+}
diff --git a/apps/game-server/src/room_native/timeout.rs b/apps/game-server/src/room_native/timeout.rs
new file mode 100644
index 00000000..299af3be
--- /dev/null
+++ b/apps/game-server/src/room_native/timeout.rs
@@ -0,0 +1,190 @@
+//! Durable room control; clocks remain outside the deterministic engine.
+use super::*;
+use engine_native::view::PolicyInput;
+use engine_native::ChoiceView;
+
+#[derive(Debug, Clone, serde::Serialize, serde::Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct NativeTimeoutState {
+    pub choice_timeout_secs: u8,
+    pub managed_seats: Vec<u8>,
+    pub deadline: Option<NativeChoiceDeadline>,
+}
+#[derive(Debug, Clone, PartialEq, Eq, serde::Serialize, serde::Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct NativeChoiceDeadline {
+    pub choice_id: u64,
+    pub observer: u8,
+    pub deadline_unix_ms: u64,
+}
+
+pub(crate) fn unix_ms() -> Result<u64, String> {
+    let elapsed = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map_err(|_| "server clock before Unix epoch")?;
+    u64::try_from(elapsed.as_millis()).map_err(|_| "server clock overflow".into())
+}
+pub fn validate_timeout_secs(secs: u8) -> Result<(), String> {
+    if [10, 15, 30, 60, 90].contains(&secs) {
+        Ok(())
+    } else {
+        Err("choice_timeout_secs must be 10, 15, 30, 60 or 90".into())
+    }
+}
+
+/// Minimum legal candidates from the seat's authorized projection, without planning.
+fn baseline(input: &PolicyInput) -> Option<GameAction> {
+    match &input.choice {
+        Some(ChoiceView::Own {
+            id, options, min, ..
+        }) => {
+            let mut selection = Vec::new();
+            for option in options {
+                if selection.len() == *min {
+                    break;
+                }
+                if !selection.contains(option) {
+                    selection.push(*option);
+                }
+            }
+            Some(GameAction::Answer {
+                choice_id: *id,
+                selection,
+            })
+        }
+        Some(ChoiceView::Other { .. }) => None,
+        None => Some(GameAction::NextPhase),
+    }
+}
+
+impl NativeRoomSession {
+    pub fn set_choice_timeout_secs(&mut self, secs: u8) -> Result<(), String> {
+        validate_timeout_secs(secs)?;
+        self.timeout.choice_timeout_secs = secs;
+        Ok(())
+    }
+    pub fn timeout_state(&self) -> &NativeTimeoutState {
+        &self.timeout
+    }
+    pub(crate) fn sync_deadline(&mut self) -> Result<(), String> {
+        let current = self.engine.open_choice();
+        if current.map(|c| (c.id, c.observer))
+            == self
+                .timeout
+                .deadline
+                .as_ref()
+                .map(|d| (d.choice_id, d.observer))
+        {
+            return Ok(());
+        }
+        self.timeout.deadline = match current {
+            Some(c) => Some(NativeChoiceDeadline {
+                choice_id: c.id,
+                observer: c.observer,
+                deadline_unix_ms: unix_ms()?
+                    .checked_add(u64::from(self.timeout.choice_timeout_secs) * 1000)
+                    .ok_or("deadline overflow")?,
+            }),
+            None => None,
+        };
+        Ok(())
+    }
+    pub(crate) fn validate_timeout(&self) -> Result<(), String> {
+        validate_timeout_secs(self.timeout.choice_timeout_secs)?;
+        if self
+            .timeout
+            .managed_seats
+            .iter()
+            .any(|s| *s >= self.max_seats)
+            || self.timeout.managed_seats.windows(2).any(|s| s[0] >= s[1])
+        {
+            return Err("invalid managed seats".into());
+        }
+        if self.engine.open_choice().map(|c| (c.id, c.observer))
+            != self
+                .timeout
+                .deadline
+                .as_ref()
+                .map(|d| (d.choice_id, d.observer))
+            || self
+                .timeout
+                .deadline
+                .as_ref()
+                .is_some_and(|d| d.deadline_unix_ms == 0)
+        {
+            return Err("deadline does not match current choice".into());
+        }
+        Ok(())
+    }
+    pub(crate) fn choice_for(
+        &self,
+        role: RoomRole,
+        player: Option<PlayerId>,
+    ) -> Option<engine_api::ChoiceRequest> {
+        let mut choice = crate::native_view::choice_for(&self.engine, role, player)?;
+        // A trusted Referee retains complete choice metadata, but no control capability.
+        choice.deadline_unix_ms = self
+            .timeout
+            .deadline
+            .as_ref()
+            .filter(|d| d.choice_id == u64::from(choice.choice_id.raw()))
+            .map(|d| d.deadline_unix_ms);
+        if choice.deadline_unix_ms.is_some() {
+            choice.timeout_policy = engine_api::TimeoutPolicy::Standard;
+        }
+        Some(choice)
+    }
+    pub(crate) fn automatic_command(
+        &self,
+        now: u64,
+        allow_managed: bool,
+    ) -> Option<(u8, GameAction, bool)> {
+        let seat = self
+            .engine
+            .open_choice()
+            .map(|c| c.observer)
+            .unwrap_or(self.engine.turn().current);
+        let managed = self.timeout.managed_seats.contains(&seat);
+        let expired = self
+            .timeout
+            .deadline
+            .as_ref()
+            .is_some_and(|d| d.deadline_unix_ms <= now);
+        if managed && !allow_managed {
+            return None;
+        }
+        if !expired && !managed {
+            return None;
+        }
+        if self.engine.outcome().is_some() && self.engine.open_choice().is_none() {
+            return None;
+        }
+        let action = baseline(&self.engine.ai_session(seat).input())?;
+        let takeover = expired && !managed;
+        let action = match action {
+            GameAction::Answer {
+                choice_id,
+                selection,
+            } if takeover => GameAction::TimeoutAction {
+                choice_id,
+                selection,
+            },
+            other => other,
+        };
+        Some((seat, action, takeover))
+    }
+    pub(crate) fn submit_automatic(
+        &mut self,
+        seat: u8,
+        action: GameAction,
+        takeover: bool,
+    ) -> Result<CommandResult, String> {
+        let result = self.submit_native(seat, action, self.engine.revision())?;
+        if matches!(result, CommandResult::Accepted { .. }) && takeover {
+            self.timeout.managed_seats.push(seat);
+            self.timeout.managed_seats.sort_unstable();
+            self.timeout.managed_seats.dedup();
+        }
+        Ok(result)
+    }
+}
