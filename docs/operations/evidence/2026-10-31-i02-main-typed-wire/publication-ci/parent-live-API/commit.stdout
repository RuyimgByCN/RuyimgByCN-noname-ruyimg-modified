com/libnoname/noname.git\",\n+              \"adopted_revision\": \"1111111111111111111111111111111111111111\",\n+              \"catalog_sha256\": \"2222222222222222222222222222222222222222222222222222222222222222\",\n+              \"asset_manifest_sha256\": \"3333333333333333333333333333333333333333333333333333333333333333\"\n+            },\n+            \"kind\": \"skill\",\n+            \"local_id\": {\n+              \"pack\": \"standard\",\n+              \"raw_symbol\": \"rende\"\n+            }\n+          }\n+        },\n+        \"targets\": null,\n+        \"voice\": {\n+          \"role\": {\n+            \"owner\": {\n+              \"kind\": \"original\",\n+              \"repository\": \"https://github.com/libnoname/noname.git\",\n+              \"adopted_revision\": \"1111111111111111111111111111111111111111\",\n+              \"catalog_sha256\": \"2222222222222222222222222222222222222222222222222222222222222222\",\n+              \"asset_manifest_sha256\": \"3333333333333333333333333333333333333333333333333333333333333333\"\n+            },\n+            \"kind\": \"general\",\n+            \"local_id\": {\n+              \"pack\": \"standard\",\n+              \"raw_symbol\": \"liubei\"\n+            }\n+          },\n+          \"form\": null,\n+          \"assets\": [\n+            {\n+              \"source\": {\n+                \"kind\": \"original\",\n+                \"repository\": \"https://github.com/libnoname/noname.git\",\n+                \"adopted_revision\": \"1111111111111111111111111111111111111111\",\n+                \"catalog_sha256\": \"2222222222222222222222222222222222222222222222222222222222222222\",\n+                \"asset_manifest_sha256\": \"3333333333333333333333333333333333333333333333333333333333333333\"\n+              },\n+              \"reference\": {\n+                \"kind\": \"original\",\n+                \"path\": \"audio-declared/standard/die/liubei/0001/liubei.mp3\",\n+                \"source_category\": \"core\",\n+                \"source_path\": \"audio/die/liubei.mp3\"\n+              },\n+              \"digest_algorithm\": \"sha256\",\n+              \"digest\": \"6666666666666666666666666666666666666666666666666666666666666666\",\n+              \"size\": 1234\n+            }\n+          ]\n+        }\n+      }\n+    },\n+    {\n+      \"ordinal\": 3,\n+      \"event\": {\n+        \"kind\": \"damage_dealt\",\n+        \"source\": 1,\n+        \"target\": 2,\n+        \"amount\": 1,\n+        \"nature\": \"fire\"\n+      }\n+    },\n+    {\n+      \"ordinal\": 4,\n+      \"event\": {\n+        \"kind\": \"damage_prevented\",\n+        \"source\": null,\n+        \"target\": 2,\n+        \"nature\": \"thunder\"\n+      }\n+    },\n+    {\n+      \"ordinal\": 5,\n+      \"event\": {\n+        \"kind\": \"hp_recovered\",\n+        \"actor\": 1,\n+        \"amount\": 1\n+      }\n+    },\n+    {\n+      \"ordinal\": 6,\n+      \"event\": {\n+        \"kind\": \"player_died\",\n+        \"actor\": 2,\n+        \"killer\": 1,\n+        \"voice\": {\n+          \"role\": {\n+            \"owner\": {\n+              \"kind\": \"original\",\n+              \"repository\": \"https://github.com/libnoname/noname.git\",\n+              \"adopted_revision\": \"1111111111111111111111111111111111111111\",\n+              \"catalog_sha256\": \"2222222222222222222222222222222222222222222222222222222222222222\",\n+              \"asset_manifest_sha256\": \"3333333333333333333333333333333333333333333333333333333333333333\"\n+            },\n+            \"kind\": \"general\",\n+            \"local_id\": {\n+              \"pack\": \"standard\",\n+              \"raw_symbol\": \"liubei\"\n+            }\n+          },\n+          \"form\": null,\n+          \"assets\": [\n+            {\n+              \"source\": {\n+                \"kind\": \"original\",\n+                \"repository\": \"https://github.com/libnoname/noname.git\",\n+                \"adopted_revision\": \"1111111111111111111111111111111111111111\",\n+                \"catalog_sha256\": \"2222222222222222222222222222222222222222222222222222222222222222\",\n+                \"asset_manifest_sha256\": \"3333333333333333333333333333333333333333333333333333333333333333\"\n+              },\n+              \"reference\": {\n+                \"kind\": \"original\",\n+                \"path\": \"audio-declared/standard/die/liubei/0001/liubei.mp3\",\n+                \"source_category\": \"core\",\n+                \"source_path\": \"audio/die/liubei.mp3\"\n+              },\n+              \"digest_algorithm\": \"sha256\",\n+              \"digest\": \"6666666666666666666666666666666666666666666666666666666666666666\",\n+              \"size\": 1234\n+            }\n+          ]\n+        }\n+      }\n+    }\n+  ]\n+}"},{"sha":"1232ae2b739eecd98f8ee884c38d73b6f2517375","filename":"crates/engine-protocol/tests/presentation.rs","status":"added","additions":118,"deletions":0,"changes":118,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/crates%2Fengine-protocol%2Ftests%2Fpresentation.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/crates%2Fengine-protocol%2Ftests%2Fpresentation.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/crates%2Fengine-protocol%2Ftests%2Fpresentation.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1,118 @@\n+use engine_api::PublicPresentationBatch;\n+use engine_protocol::{decode_s2c, encode_s2c, ServerMessage};\n+use serde_json::{json, Value};\n+\n+fn batch() -> Value {\n+    serde_json::from_str(include_str!(\"fixtures/i02-presentation.json\")).unwrap()\n+}\n+fn outcome(presentation: Option<Value>) -> Value {\n+    let seat = |player| json!({\"player\":player,\"seat\":player-1,\"hp\":4,\"max_hp\":4,\"alive\":true,\"hand_count\":0,\"identity\":null,\"skills\":[]});\n+    let mut v = json!({\"type\":\"CommandOutcome\",\"payload\":{\n+        \"header\":{\"protocol_version\":6,\"room_id\":7,\"conn_seq\":9,\"revision\":2},\"idempotency_key\":9,\n+        \"result\":{\"Accepted\":{\"new_revision\":2,\"state_hash\":vec![0;32]}},\n+        \"view\":{\"revision\":2,\"state_hash\":vec![0;32],\"observer\":\"Spectator\",\"round\":1,\"current_player\":1,\"phase\":\"Play\",\"seats\":[seat(1),seat(2)],\"known_cards\":[],\"outcome\":\"InProgress\"},\n+        \"legal_actions\":[],\"choice\":null,\"public_event_codes\":[3,5,7]\n+    }});\n+    if let Some(p) = presentation {\n+        v[\"payload\"][\"presentation\"] = p;\n+    }\n+    v\n+}\n+\n+#[test]\n+fn old_absence_and_seven_typed_events_roundtrip() {\n+    let absent = decode_s2c(&outcome(None).to_string()).unwrap();\n+    assert!(!encode_s2c(&absent).unwrap().contains(\"presentation\"));\n+    let message = decode_s2c(&outcome(Some(batch())).to_string()).unwrap();\n+    let roundtrip = decode_s2c(&encode_s2c(&message).unwrap()).unwrap();\n+    assert_eq!(message, roundtrip);\n+    let ServerMessage::CommandOutcome {\n+        presentation: Some(p),\n+        ..\n+    } = message\n+    else {\n+        panic!()\n+    };\n+    assert_eq!(p.occurrences.len(), 7);\n+}\n+\n+#[test]\n+fn invalid_present_payloads_are_rejected_at_actual_wire_ingress() {\n+    let cases: Vec<Value> =\n+        serde_json::from_str(include_str!(\"fixtures/i02-presentation-invalid.json\")).unwrap();\n+    for case in cases {\n+        let mut bad = batch();\n+        for change in case[\"changes\"].as_array().unwrap() {\n+            let (parent, key) = change[\"pointer\"]\n+                .as_str()\n+                .unwrap()\n+                .rsplit_once('/')\n+                .unwrap();\n+            let target = bad.pointer_mut(parent).unwrap();\n+            if change[\"remove\"] == true {\n+                target.as_object_mut().unwrap().remove(key);\n+            } else if let Some(object) = target.as_object_mut() {\n+                object.insert(key.into(), change[\"value\"].clone());\n+            } else {\n+                target[key.parse::<usize>().unwrap()] = change[\"value\"].clone();\n+            }\n+        }\n+        assert!(\n+            decode_s2c(&outcome(Some(bad)).to_string()).is_err(),\n+            \"{}\",\n+            case[\"name\"]\n+        );\n+    }\n+    assert!(decode_s2c(&outcome(Some(Value::Null)).to_string()).is_err());\n+    let mut too_many = batch();\n+    too_many[\"occurrences\"] = Value::Array(\n+        (0..1025)\n+            .map(|i| json!({\"ordinal\":i,\"event\":{\"kind\":\"hp_recovered\",\"actor\":1,\"amount\":1}}))\n+            .collect(),\n+    );\n+    assert!(serde_json::from_value::<PublicPresentationBatch>(too_many).is_err());\n+    let mut too_large = batch();\n+    let voice = too_large[\"occurrences\"][0][\"event\"][\"voice\"].clone();\n+    too_large[\"occurrences\"] = Value::Array((0..90).map(|i|json!({\"ordinal\":i,\"event\":{\"kind\":\"player_died\",\"actor\":1,\"killer\":null,\"voice\":voice}})).collect());\n+    assert!(decode_s2c(&outcome(Some(too_large)).to_string()).is_err());\n+}\n+\n+#[test]\n+fn package_and_original_identities_are_discriminated() {\n+    let mut b = batch();\n+    let owner = json!({\"kind\":\"package\",\"namespace\":\"author\",\"package_id\":\"voices\",\"version\":\"1.0.0\",\"logic_hash\":\"1\".repeat(64),\"content_hash\":\"2\".repeat(64)});\n+    let role = &mut b[\"occurrences\"][0][\"event\"][\"voice\"][\"role\"];\n+    role[\"owner\"] = owner.clone();\n+    role[\"local_id\"] = json!(42);\n+    let asset = &mut b[\"occurrences\"][0][\"event\"][\"voice\"][\"assets\"][0];\n+    asset[\"source\"] = owner;\n+    asset[\"reference\"] = json!({\"kind\":\"package\",\"namespace\":\"author\",\"package_id\":\"voices\",\"asset_id\":\"die_liubei\"});\n+    asset[\"digest_algorithm\"] = json!(\"blake3\");\n+    assert!(decode_s2c(&outcome(Some(b.clone())).to_string()).is_ok());\n+    b[\"occurrences\"][0][\"event\"][\"voice\"][\"role\"][\"local_id\"] =\n+        json!({\"pack\":\"standard\",\"raw_symbol\":\"liubei\"});\n+    assert!(decode_s2c(&outcome(Some(b)).to_string()).is_err());\n+}\n+\n+#[test]\n+fn raw_json_surrogates_reject_before_utf8_string_creation_and_valid_astral_pairs_pass() {\n+    let cases: Vec<Value> =\n+        serde_json::from_str(include_str!(\"fixtures/i02-presentation-surrogates.json\")).unwrap();\n+    for case in cases {\n+        let mut bad = batch();\n+        *bad.pointer_mut(case[\"pointer\"].as_str().unwrap()).unwrap() =\n+            json!(\"I02_RAW_UNICODE_SENTINEL\");\n+        // Keep invalid escapes in raw JSON: parsing the injected value as Value first would lose this boundary.\n+        let raw = outcome(Some(bad)).to_string().replace(\n+            \"\\\"I02_RAW_UNICODE_SENTINEL\\\"\",\n+            case[\"raw_json_value\"].as_str().unwrap(),\n+        );\n+        assert!(decode_s2c(&raw).is_err(), \"{}\", case[\"name\"]);\n+    }\n+    let mut good = batch();\n+    good[\"occurrences\"][0][\"event\"][\"voice\"][\"role\"][\"owner\"][\"repository\"] = json!(\"repo🐉\");\n+    good[\"occurrences\"][0][\"event\"][\"effective\"][\"key\"] = json!(\"sha🐉\");\n+    good[\"occurrences\"][0][\"event\"][\"voice\"][\"assets\"][0][\"reference\"][\"path\"] =\n+        json!(\"audio/die/role🐉.mp3\");\n+    assert!(decode_s2c(&outcome(Some(good)).to_string()).is_ok());\n+}"},{"sha":"3c416672cdb2f6f4940680da632dad8b894336d5","filename":"crates/engine-protocol/tests/presentation_main5fc_reader.rs","status":"added","additions":33,"deletions":0,"changes":33,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/crates%2Fengine-protocol%2Ftests%2Fpresentation_main5fc_reader.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/crates%2Fengine-protocol%2Ftests%2Fpresentation_main5fc_reader.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/crates%2Fengine-protocol%2Ftests%2Fpresentation_main5fc_reader.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1,33 @@\n+//! Frozen 5fc source readers, not rewritten compatibility approximations.\n+#[path = \"fixtures/i02-main5fc/messages.rs\"]\n+mod messages;\n+#[path = \"fixtures/i02-main5fc/wire.rs\"]\n+mod wire;\n+pub use messages::*;\n+pub const NETWORK_PROTOCOL_VERSION: u32 = 6;\n+pub const MAX_MESSAGE_BYTES: usize = 256 * 1024;\n+\n+#[test]\n+fn actual_old_reader_ignores_optional_new_response_field() {\n+    let input = serde_json::json!({\"type\":\"CommandOutcome\",\"payload\":{\n+        \"header\":{\"protocol_version\":6,\"room_id\":1,\"conn_seq\":2,\"revision\":2},\"idempotency_key\":2,\n+        \"result\":{\"Accepted\":{\"new_revision\":2,\"state_hash\":vec![0;32]}},\n+        \"view\":{\"revision\":2,\"state_hash\":vec![0;32],\"observer\":\"Spectator\",\"round\":1,\"current_player\":0,\"phase\":\"Idle\",\"seats\":[],\"known_cards\":[],\"outcome\":\"InProgress\"},\n+        \"legal_actions\":[],\"choice\":null,\"public_event_codes\":[],\n+        \"presentation\":{\"revision\":2,\"status\":\"complete\",\"unavailable\":[],\"occurrences\":[]}\n+    }});\n+    let old = wire::decode_s2c(&input.to_string()).unwrap();\n+    assert!(!wire::encode_s2c(&old).unwrap().contains(\"presentation\"));\n+    assert!(engine_protocol::decode_s2c(&input.to_string()).is_ok());\n+}\n+\n+#[test]\n+fn old_and_new_client_request_contract_remains_strict_and_unchanged() {\n+    let input = serde_json::json!({\"type\":\"RequestSnapshot\",\"payload\":{\"header\":{\"protocol_version\":6,\"room_id\":1,\"conn_seq\":2,\"revision\":2},\"last_revision\":2}});\n+    assert!(wire::decode_c2s(&input.to_string()).is_ok());\n+    assert!(engine_protocol::decode_c2s(&input.to_string()).is_ok());\n+    let mut with_presentation = input.clone();\n+    with_presentation[\"payload\"][\"presentation\"] = serde_json::json!({});\n+    assert!(wire::decode_c2s(&with_presentation.to_string()).is_err());\n+    assert!(engine_protocol::decode_c2s(&with_presentation.to_string()).is_err());\n+}"},{"sha":"ffc8ffb8fc65377bffed9eed524b0c3862619d0b","filename":"docs/architecture/native-progress.md","status":"modified","additions":3,"deletions":3,"changes":6,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Farchitecture%2Fnative-progress.md","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Farchitecture%2Fnative-progress.md","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Farchitecture%2Fnative-progress.md?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -9,11 +9,11 @@\n \n ## 当前交付与带日期核验记录\n \n-**C7／C8私有基础已审、C9首轮8红且前置流程修复中（2026-10-31；Main仍5fc/330）**：C7完整148文件及六测试增量由父独立核验，原生1761/0/75、前端181、独立目标Gate1b通过，两次限定源码复审No issues，见[C7证据](../operations/evidence/2026-10-31-c331-phase7-main-integration/README.md)。C8 schema5数据链35增量／166组合源已实现并封存，四内容包609/0/0、最终原生1773/0/75、前端183/type与Gate1b通过；父fresh核166源码／130证据及pre-full同源，但独立复审发现两个P1：缺modules的资源入场绕过声明守卫、真实JSON导入规范化掩盖重复字段；另有active执行器SDK互斥P2。原C8红审与绿测保留，随后7文件[实际入场修复](../operations/evidence/2026-10-31-c331-phase8-schema5-datachain/admission-repair/README.md)以原始JSON进入既有typed reader／RawValue，关闭两P1与P2；真实当前私有WASM／SDK11坏输入拒绝且原store／handle／hash／archive不变，旧3/4正控通过。父fresh核170源码／91证据／6匹配node-WASM及原生1773/0/75／前端186／独立Gate1b，复审No issues，限定接纳C8入场基础。原文见[C8冻结和原复审](../operations/evidence/2026-10-31-c331-phase8-schema5-datachain/README.md)。C9首轮canonical signed量／HP loss与post-HP窗口实现已封存，九项定向绿、独立Gate1b绿，但全原生1774/8/75、exit101；独立triage确认前置driver／窗口缺失、chain资格和解链时点、restore settlement/progress矩阵三P1，完整性审计不作验收。原42增量／191组合与所有红保留，phase9b正补实际pre-HP及callback归位；SubmitHp遵已批合同为root进度和原子提交，不发明新可订阅事件。见[C9原始失败与语义triage](../operations/evidence/2026-10-31-c331-phase9-partial-damage/README.md)。262/290、剩28、16译名及全部37范围保持。\n+**C7／C8私有基础已审、C9c仍排序P1与golden红（2026-10-31；Main已验收d07/330）**：C7完整148文件及六测试增量由父独立核验，原生1761/0/75、前端181、独立目标Gate1b通过，两次限定源码复审No issues，见[C7证据](../operations/evidence/2026-10-31-c331-phase7-main-integration/README.md)。C8 schema5数据链35增量／166组合源已实现并封存，四内容包609/0/0、最终原生1773/0/75、前端183/type与Gate1b通过；父fresh核166源码／130证据及pre-full同源，但独立复审发现两个P1：缺modules的资源入场绕过声明守卫、真实JSON导入规范化掩盖重复字段；另有active执行器SDK互斥P2。原C8红审与绿测保留，随后7文件[实际入场修复](../operations/evidence/2026-10-31-c331-phase8-schema5-datachain/admission-repair/README.md)以原始JSON进入既有typed reader／RawValue，关闭两P1与P2；真实当前私有WASM／SDK11坏输入拒绝且原store／handle／hash／archive不变，旧3/4正控通过。父fresh核170源码／91证据／6匹配node-WASM及原生1773/0/75／前端186／独立Gate1b，复审No issues，限定接纳C8入场基础。原文见[C8冻结和原复审](../operations/evidence/2026-10-31-c331-phase8-schema5-datachain/README.md)。C9首轮canonical signed量／HP loss与post-HP窗口实现已封存，九项定向绿、独立Gate1b绿，但全原生1774/8/75、exit101；独立triage确认前置driver／窗口缺失、chain资格和解链时点、restore settlement/progress矩阵三P1，完整性审计不作验收。原42增量／191组合与所有红保留。随后[C9b实际前置流程](../operations/evidence/2026-10-31-c331-phase9b-prehp/README.md)限制共享构造只作用Damage/Window，保留非Damage行为，最终1791/1/75与独立Gate1b0；唯一golden组仍12场不符，复审发现inline先于First竞争及子窗stage伪造两P1。C9c以三个真实SkillDef／既有队列及有限NativeDamageSkill修复部分竞争，加入子窗矩阵与damage日志先后反例；最终1796/1/75、Gate1b0，仍有Huoshen等inline排序缺口，独立复审仍BLOCK，正由同一writer继续闭合。相对精确C8基线的12场362配对capture，11场仅已观察业务面相同、chain场存在真实解链日志顺序变化，不能用作全规则等价；golden未重录。SubmitHp遵已批合同为root进度和原子提交，不发明新可订阅事件。见[C9原始失败](../operations/evidence/2026-10-31-c331-phase9-partial-damage/README.md)及[C9c限定修复和处置](../operations/evidence/2026-10-31-c331-phase9c-dispositions/README.md)。262/290、剩28、16译名及全部37范围保持。\n \n-**NC10公开Own修复已接Main、本地限定验收完成待提交发布（2026-10-31；5fc/330/105/758/WS6基线）**：完整Plan泄露nodes4/11的真实配对已由纯公开Own分支消除，两个建议实际提交Pending；五文件初审及v2取消边界增量审查No issues。原484断言得到119的1718/1/75及缺fixtures的另一轮失败分开保留。质量处置复审将该断言确认为旧策略快照；当前测试改为900操作内终局／P3、每次规划完整状态／日志不变、正式返回成功、无模拟／探针故障及完整字节恢复，只允许既有auth_generation+1。最终私有六文件原生1719/0/75、Own4／Shan1／seed1／session6与独立Gate1b通过，增量复审No issues，父核全部十命令／六源与原红保全后精确接入Main；Main新验收原生1719/0/75、workspace6922/0/77、前端179/type、独立Gate1b、当前WASM／真实UI及Worker、40+20轨迹和legacy conformance19／crosshash通过；父核714原产物／26命令、六源／保护与完整冻结21门禁，综合审查No issues。父另发现私有探针旁路check查询index并形成21个不同于Main的依赖版本；原记录保留，不能宣整会话离线。以Main锁30外部条目对齐后，仅重跑原native探针，七组完整存档／回复／事件与已保留当前WASM逐字节相等，父新产物／锁审计及补充复审通过，限定本地验收完成。WASM新SHA30e97f8a…，默认dist37／旧legacy保持，规则和桌面transport默认不变。原raw index在冻结前变化原因未知，冻结11:42:19–11:49:59 raw／逻辑项及11字段相同；12:21:30明确解除冻结后的证据／文档另查，不冒称属于原门禁快照。见[Main最终证据与限制](../operations/evidence/2026-10-31-nc10-public-own-plan/main-acceptance/README.md)，尚未提交或发布。正式结果测量各200局完成，共135,200次提交均Accepted/Pending，400份终局档恢复成功；父独立解析全部行并核441证据／源码与恢复，通过。固定旧规划器对手的held-out 32种子×4挑战席×两臂256局随后已封存：胜32/128对31/128、84,344提交无拒绝、256终局档恢复；父已核全部原始行／源码还原／24校准／256档SHA及冻结源恢复，独立质量复审支持限定隐私修复；不能宣统计非劣或全强度通过。原报告校准Own数3更正为4、session数7更正为6，原报告／SHA不改并另存勘误。seed8211还暴露现有其他玩家Jiu救援的上游规则缺口，已登记规则基准；未用AI特判掩盖或改restore。见[实现、原红与质量证据](../operations/evidence/2026-10-31-nc10-public-own-plan/README.md)。两次任务超时均晚于封存，不作为新增测试红；原19 NoCert／no-choice／VM与全NC10仍BLOCK。\n+**NC10公开Own修复已限定验收并发布d07（2026-10-31；5fc/330/105/758/WS6基线）**：完整Plan泄露nodes4/11的真实配对已由纯公开Own分支消除，两个建议实际提交Pending；五文件初审及v2取消边界增量审查No issues。原484断言得到119的1718/1/75及缺fixtures的另一轮失败分开保留。质量处置复审将该断言确认为旧策略快照；当前测试改为900操作内终局／P3、每次规划完整状态／日志不变、正式返回成功、无模拟／探针故障及完整字节恢复，只允许既有auth_generation+1。最终私有六文件原生1719/0/75、Own4／Shan1／seed1／session6与独立Gate1b通过，增量复审No issues，父核全部十命令／六源与原红保全后精确接入Main；Main新验收原生1719/0/75、workspace6922/0/77、前端179/type、独立Gate1b、当前WASM／真实UI及Worker、40+20轨迹和legacy conformance19／crosshash通过；父核714原产物／26命令、六源／保护与完整冻结21门禁，综合审查No issues。父另发现私有探针旁路check查询index并形成21个不同于Main的依赖版本；原记录保留，不能宣整会话离线。以Main锁30外部条目对齐后，仅重跑原native探针，七组完整存档／回复／事件与已保留当前WASM逐字节相等，父新产物／锁审计及补充复审通过，限定本地验收完成。WASM新SHA30e97f8a…，默认dist37／旧legacy保持，规则和桌面transport默认不变。原raw index在冻结前变化原因未知，冻结11:42:19–11:49:59 raw／逻辑项及11字段相同；12:21:30明确解除冻结后的证据／文档另查，不冒称属于原门禁快照。见[Main最终证据与限制](../operations/evidence/2026-10-31-nc10-public-own-plan/main-acceptance/README.md)。按裁决18