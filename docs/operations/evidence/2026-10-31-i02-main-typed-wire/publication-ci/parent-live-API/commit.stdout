{"sha":"3825e0ead69750b405be9891a2572e34b9debe2a","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20-v2/baseline-changed/crates/engine-native-content/src/content/standard/boss_skills.rs","status":"added","additions":1128,"deletions":0,"changes":1128,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v2%2Fbaseline-changed%2Fcrates%2Fengine-native-content%2Fsrc%2Fcontent%2Fstandard%2Fboss_skills.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v2%2Fbaseline-changed%2Fcrates%2Fengine-native-content%2Fsrc%2Fcontent%2Fstandard%2Fboss_skills.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v2%2Fbaseline-changed%2Fcrates%2Fengine-native-content%2Fsrc%2Fcontent%2Fstandard%2Fboss_skills.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1,1128 @@\n+use super::*;\n+mod boss_host;\n+\n+pub(super) fn skills() -> Vec<SkillDef> {\n+    let mut skills = vec![\n+        SkillDef {\n+            name: BOSS_XIONGSHOU,\n+            // 权限型能力三面：杀伤条件臂（kernel emit_sha_damage）、\n+            // computed_distance 距离 -1（state）、翻面取消（commit 入口\n+            // 直读跳过——死亡取消型同款），均经 skill_by_name 查询\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_WUZANG,\n+            // 权限型能力两面：摸牌阶段额外量与手牌上限基数归零，均在\n+            // kernel 阶段臂经 skill_by_name 查询\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_XIANGDE,\n+            // 伤害前置触发：来源有武器对持有者伤害 +1（机器一步直改\n+            // 载荷，YiShang 同款窗口）\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::DamageBefore,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: Vec::new(),\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(XiangDeBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_YINZEI,\n+            // 权限型两面：激活门控与伤害后弃牌在 commit_damage/\n+            // commit_lose_hp 尾经 skill_by_name 查询（激活=SkillInstance\n+            // .enabled 直写，初始装配即未激活）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_ZHUE,\n+            // 权限型单面：global damageEnd 双摸在 commit_damage 尾经\n+            // skill_by_name 查询\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_FUTAI,\n+            // 准备阶段触发（判定阶段开始锚点，神智同口径）：全体受伤\n+            // 者按座位序各回 1（机器一步，无挂起；锁定=forced 无确认）\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::PhaseBegin,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: Vec::new(),\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(FutaiBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_YANDU,\n+            // 权限型两面：激活门控（commit_damage 尾，隐贼先例同构）与\n+            // 他人结束阶段获得牌（kernel Phase::End 臂）均经 skill_by_name\n+            // 查询；装配即未激活\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_TANYU,\n+            // 权限型两面：跳过弃牌阶段（kernel Phase::Discard 臂直查）\n+            // 与结束阶段全场最多手牌失 1 体（Phase::End 臂）均经\n+            // skill_by_name 查询\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_CANGMU,\n+            // 权限型单面：摸牌基数=存活角色数（kernel Draw 臂，无脏同位）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_JICAI,\n+            // 权限型两面：激活门控（commit_damage 尾，延妒并列）与回复\n+            // 后双摸（commit_recover 新臂）均经 skill_by_name 查询；装配\n+            // 即未激活\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_NITAI,\n+            // 权限型两面：回合内受伤防止与回合外火伤 +1 均在\n+            // commit_damage 内联经 skill_by_name 查询\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_LUANCHANG,\n+            // 两面：准备阶段（判定阶段开始锚点）视为用【南蛮入侵】（触\n+            // 发机一步 use_virtual_card）；结束阶段视为用【万箭齐发】\n+            // （kernel Phase::End 臂查询式）；激活门控同隐贼/延妒/积财\n+            // 先例（装配即未启用）\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::PhaseBegin,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: Vec::new(),\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(LuanChangBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_MINWAN,\n+            // 权限型三面：伤害后锁定集（commit_damage 尾）、每用牌摸 1\n+            //（commit_card_used 尾）、PlayCard 目标校验（engine 校验段）\n+            // 均经 skill_by_name 查询；锁定集=TurnState.minwan_targets\n+            //（回合级，更替自然清零）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_CUIDUI,\n+            // 权限型单面：伤害后授毒（commit_damage 尾经 skill_by_name\n+            // 查询）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_ZHONGDU,\n+            // 中毒（运行时授技）：回合开始判定（commit_phase Judge begin\n+            // 段内联 draw_judge_card，铁骑式确定性判定）——非红桃伤 1、\n+            // 非黑桃失去此技（实例移除）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_YAOSHOU,\n+            // 权限型单面：computed_distance 距离 -2（state 距离链，凶兽\n+            // 同款）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_JIUSHOU,\n+            // 权限型三面：手牌上限恒 9（state hand_limit）、跳过摸牌与\n+            // 出牌/结束补至 9（kernel 阶段臂）均经 skill_by_name 查询\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_DUQU,\n+            // 权限型单面：受击者给来源加蛇毒标记（commit_damage 尾经\n+            // skill_by_name 查询；PlayerState.shedu 承载）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_ECHOU,\n+            // 权限型两面：激活门控（commit_damage 尾延妒并列）与他人桃\n+            // /酒获标记（commit_card_used）均经 skill_by_name 查询；装配\n+            // 即未激活\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_SHEDU,\n+            // 蛇毒标记结算（运行时触发技）：Judge begin 持有标记>0 →\n+            // 「弃 X 张牌或失去 X 体力」（挂起选择；取消/空选=失 X）→\n+            // 标记-1；X=当前标记数\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::PhaseBegin,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: Vec::new(),\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(ShedUBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_BINGXIAN,\n+            // 权限型单面：他人回合未出杀 → 结束阶段虚拟杀（kernel\n+            // Phase::End 臂，乱常万箭同款 use_virtual_card）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_XUSHI,\n+            // 权限型两面：出牌阶段结束自翻面（commit_phase Play begin:\n+            // false 臂）与翻回正面全场伤 1（commit_turn_over_before 尾）\n+            // 均经 skill_by_name 查询；激活门控同隐贼先例（装配即未激活）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_JUYUAN,\n+            // 权限型两面：回合结束体力记录（kernel Phase::End 臂）与杀\n+            // 目标 mod（engine max_targets）均经 skill_by_name 查询；\n+            // juyuan_storage=PlayerState 跨回合持久字段\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_ZHAOHUO,\n+            // 两面：造成伤害视为火（DamageBefore 触发机一步直改 nature\n+            // ——相德同款窗口）；免疫火伤（commit_damage 入口直读——拟\n+            // 态回合内免伤同位）\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::DamageBefore,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: Vec::new(),\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(ZhaoHuoBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_HONGLIANX,\n+            // 权限型两面：红色不计上限+弃牌阶段红牌不可弃（hand_limit\n+            // 与 Discard 臂查询）；回合开始获红牌/对至多 3 名各 1 火伤\n+            // （Judge begin 段内联，确定性近似登记）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_YANYU,\n+            // 权限型两面：激活门控（commit_damage 尾第八并列臂）与判定\n+            // 红色火伤（kernel Judge begin 段内联，回合计数至多 3）均经\n+            // skill_by_name 查询；装配即未激活\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_FENGDONG,\n+            // 权限型两面：回合开始他人获封印（Judge begin 段内联，神智\n+            // 锚）与回合结束全清（Phase::End 臂）经 skill_by_name 查询；\n+            // PlayCard 手牌校验（engine 校验段）禁用封印者手牌\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_XUNYOU,\n+            // 权限型单面：他人回合开始获得座位序首名有手牌者一张手牌\n+            //（Judge begin 段内联，确定性近似；装备牌自动使用=直接装上）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_SIPU,\n+            // 权限型两面：激活门控（commit_damage 尾第九并列臂；装配即\n+            // 未激活）与响应/救禁（respond_shan、dying_save 选项排除）\n+            // 均经 skill_by_name 查询；使用面由回合模型天然承载；无懈等\n+            // 其余响应窗未纳入禁令（登记差异）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_SHENYI,\n+            // 查询型两面：翻面取消（commit_turn_over_before 臂——凶兽\n+            // 同位，仅正→背取消）与判定阶段延时锦囊无效化（apply_\n+            // judgement 逐臂条件）均经 skill_by_name 查询；洪荒之力禁\n+            // 用交互未落（登记差异）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_RELEIJI,\n+            // 查询型单面：杀/万箭闪消费位内联臂（releiji_on_shan）经\n+            // skill_by_name 查询；青木链见 BOSS_QINGMU2/2X（v292）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_KUANGXIAO,\n+            // 查询型两面：杀无距离（engine sha_range_free 链追加）与目\n+            // 标数无限（engine kuangxiao_inf 臂，天弦同构）均经 skill_\n+            // by_name 查询；友方禁指面登记差异（关系网边界）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_FENTIAN,\n+            // 火改写面=ZhaoHuoBehavior 同构复用（数据less nature 改写，\n+            // 快照变体共用 BossZhaohuo——机器不携带技能身份，恢复路径按\n+            // 技能表重挂）；其余为查询面（engine 红牌免次数/免距离、\n+            // kernel 红杀跳八卦）；wuxie 禁面登记差异未挂钩\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::DamageBefore,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: Vec::new(),\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(ZhaoHuoBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_LINGQU,\n+            // 查询型两面：受击摸 1+计数（commit_damage damageEnd 段）与\n+            // 大于 1 点伤害归零（commit_damage 入口臂）均经 skill_by_name\n+            // 查询；手牌上限 +X（hand_limit 查询+PlayerState.lingqu_count\n+            // 新字段）；玄麟=关卡流程面登记不落\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_SHENEN,\n+            // 全局光环查询型三面：engine sha/顺手距离链 boss 方豁免、\n+            // hand_limit 挑战者 +1（state）、Draw 臂挑战者 +1（kernel）\n+            // 均经 skill_by_name 查询+is_boss_side 判定；光环激活=场上\n+            // 存在持有者\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_XINGQIU,\n+            // 查询型单面：Play begin 臂（交替开关+横置敌方，direct 直写\n+            // linked+日志，索链甲同款）；授 boss_jiding 面登记差异未入库\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_BUCHUN,\n+            // 主动技两线（ActivateSkill 直调 activate——复活线/恢复线按\n+            // 场面分派；间隔门控读 buchun_used_round）；快照变体\n+            // BossBuchun（archive tag 66/机哈希 67）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(BuchunBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_HUIHUO,\n+            // 查询型两面：杀上限 +1（engine 限次臂 once_used 额度，元宝\n+            // 肉同款）与死亡反噬（kernel 死亡结算移除前捕获+PlayerDied\n+            // 后敌方 3 点火伤）均经 skill_by_name 查询\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_FURAN,\n+            // 查询型单面：濒死救援选项扩展（is_tao_like 臂——敌方红色\n+            // 牌可当桃救焰灵）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_XINGXIA,\n+            // 主动技（ActivateSkill 直调 activate——损焰灵线/追击线按\n+            // 挂起阶段推进；间隔门控读 xingxia_used_round）；快照变体\n+            // BossXingxia（archive tag 67/机哈希 68）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(XingxiaBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_JUEHONG,\n+            // 查询型单面：准备阶段臂（Judge begin 段——封冻同位；装备全\n+            // 弃撤技能+入弃堆，随机弃→首张确定性近似登记）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_QINGZHU,\n+            // 查询型两面：跳弃牌（Discard 臂——贪欲同位）+杀禁用（engine\n+            // 校验臂——获急叮解除）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_JIAZU,\n+            // 查询型单面：准备阶段臂（相邻敌方坐骑全弃）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_JIDING,\n+            // 查询型单面：damageEnd 臂（友方受伤→对敌方来源虚拟雷杀，\n+            // LeiSha kind 载体；蓐收加成尾面登记差异）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_ZAOYI,\n+            // 查询型三面：死亡触发（DeathMachine 移除后捕获+授技）、\n+            // targetEnabled 双门控（engine 校验）、造异异变授予（运行时\n+            // skills.insert，中毒/蛇毒先例）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_ZAOYI_HP,\n+            // 查询型单面（运行时授予）：回合开始敌方最低体力全体失去全\n+            // 部体力（Judge begin 臂）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_ZIRUN,\n+            // 查询型单面：准备阶段臂（Judge begin 段——全体摸牌：有装备\n+            // 2/无装备 1）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_NIANRUI,\n+            // 查询型单面：Draw 臂固定摸 2 后补摸 2（藏目同位）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_MENGTAI,\n+            // 查询型多面：准备置位/摸牌清位/出牌清位/结束补摸 3/弃牌闸门\n+            // （TurnState.mengtai_* 双旗标承载）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_NBIANSHEN,\n+            // 查询型单面：Judge begin 轮换臂（assembly 重挂+hp 保留；\n+            // versus 替补换将先例同构；确定性互斥轮转登记）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_RENXING,\n+            // 查询型双臂：damageEnd（commit_damage 段）+recoverEnd\n+            // （commit_recover_skills 头）——非当前回合摸 1\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_RUIZHI,\n+            // 查询型单面：准备阶段臂（global 修剪：其余角色保留 1 手+1\n+            // 装，弃其余——保留首张确定性近似登记）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_SHOUYI,\n+            // 查询型单面：sha_range_free 链+顺手距离链追加（全牌无距离，\n+            // 狂笑/神恩同位）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_DANSHU,\n+            // 查询型单面：CardsDiscarded 臂（失去手牌后非当前回合且已受\n+            // 伤判定红回 1）——夜叉批条目复用同名 def\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_JINGJUE,\n+            // 查询型单面：继承胆术（同内容共用 commit 臂按名双查）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_MODAO,\n+            // 查询型单面：Judge begin 臂自摸 2（藏目/年瑞同位）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_MOJIAN,\n+            // 查询型单面：Play begin 臂虚拟万箭（乱常 End 臂同款\n+            // use_virtual_card；异侧存活全目标）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_YUSHOU,\n+            // 查询型单面：Play begin 臂虚拟南蛮（魔剑同款 use_virtual_card）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_MOYANY,\n+            // 查询型单面：CardsDiscarded 臂（非当前回合判定红→2 火伤打\n+            // 座位序首个其他存活——确定性近似登记）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_BAOLIAN,\n+            // 查询型单面：End 臂摸 2\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_QIANGZHENG,\n+            // 查询型单面：End 臂——每名其他有手牌角色随机一张→首张确定\n+            // 性近似登记，获得至手牌\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_ZUIJIU,\n+            // 查询型单面：commit_damage 臂——source sha 伤害 +1\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_XIAOSHOU,\n+            // 查询型单面：End 臂——座位序首个 hp≥self 其他存活受 3 伤害\n+            // （目标自选可放弃→恒发动确定性近似登记）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_GUIJI,\n+            // 查询型单面：Judge begin 臂弃自己判定区首张（随机→首张近似）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_TAIPING,\n+            // 查询型单面：Draw 臂 +2（年瑞同位）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_SUOMING,\n+            // 查询型单面：End 臂——全部未链接异侧存活横置（链接机直写+\n+            // Linked 日志，[1,num] 自选→全部确定性近似登记）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_XIXING,\n+            // 查询型单面：Judge begin 臂——座位序首个已链接异侧受 1 雷伤\n+            // +持有者回 1（目标自选→首个已链接确定性近似登记）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_LIANYU,\n+            // 查询型单面：End 臂——全部其他存活各 1 火伤（无询问直伤）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_JUECE,\n+            // 查询型单面：CardsDiscarded 臂——自己回合内其他角色失去最后\n+            // 一手牌（弃后空手）→ 1 伤害（chooseBool AI→恒发动近似登记）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_JIUCHI,\n+            // 查询型单面：PlayCard kind 改写臂（黑桃手牌→酒，viewAs 转化\n+            // 武圣/奇袭同族）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_GUIMOU,\n+            // 查询型单面：End begin 臂——座位序首个其他未混乱存活角色\n+            // boss_mad 置位（其回合收束解除；随机→首个确定性近似登记）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_YUANCE,\n+            // 查询型单面：Damage commit 尾臂——来源≠受伤者且双方存活 →\n+            // 判定（选项一恒定：黑→受伤者失 1 / 红→来源失 1；chooseControl\n+            // AI 态度面→恒选项一确定性近似登记）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_QIZUO,\n+            // CardUsed AfterTriggers 触发：锦囊复用一步机（QizuoBehavior\n+            // 门=无懈/铁索排除+延时同名去重+原目标存活；载体槽守卫递归）\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::CardUsed,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: Vec::new(),\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(QizuoBehavior),\n+        },\n+        SkillDef {\n+            name: JUE_QING,\n+            // 查询型单面：commit_damage 入口直读臂（急冻前——上游\n+            // damageBefore 层）——来源伤害改为目标失去等量体力\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_WUXIN,\n+            // 查询型双面：commit_damage 入口直读臂（受伤→失 1）+\n+            // PlayCard 校验臂（乐/兵拒——延时禁指定他人）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_SHANGSHIX,\n+            // 查询型双面：四 commit 臂补牌（CardsDiscarded/Damage/LoseHp/\n+            // Recover——手牌<4 补至 4）+ End begin 臂（hp>1 全体各失 1）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_XIAOXIONG,\n+            // CardUsed AfterTriggers 触发：副本入手一步机（XiaoxiongBehavior\n+            // 门=他人使用+基本/锦囊白名单；End begin 臂=子技未用牌伤害）\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::CardUsed,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: Vec::new(),\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(XiaoxiongBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_ZHANGWU,\n+            // 查询型单面：Damage commit 尾臂（damageEnd 族）——持有者弃 1\n+            // 张+来源弃 1 张或受 1 伤害（双方恒弃首张确定性近似登记）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_LINGBO,\n+            // CardResponded+CardUsed 触发：打出/使用闪后摸 2 一步机\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::CardResponded,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: vec![EventKind::CardUsed],\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(LingboBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_JIAOXIA,\n+            // 查询型单面：CardUsed commit 臂——成为红色牌目标后摸 1\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_FANGHUA,\n+            // 查询型单面：End begin 臂——存在翻面角色则全部各失 1\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_TASHUI,\n+            // CardResponded+CardUsed 触发：打出/使用黑牌后翻面一步机\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::CardResponded,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: vec![EventKind::CardUsed],\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(TashuiBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_HUOSHEN,\n+            // 查询型单面：commit_damage 火伤分支直读臂（招祸同位扩展——\n+            // 免疫火伤+回复 1）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_ZYHONGLIAN,\n+            // 查询型单面：End begin 臂——摸 2+全部其他存活各 1 火伤\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_XIANYIN,\n+            // 查询型单面：CardsDiscarded 臂（非当前回合）——判定红→座位\n+            // 序首个其他存活失 1（chooseTarget AI→首个确定性近似登记）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_TIANDAO,\n+            // 查询型单面：改判机 rewriters 扩展（hes 任意牌改判+获得原判\n+            // 定牌）——JudgePhase 机器内联，无独立触发\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_ZJLEIJI,\n+            // CardResponded+CardUsed 触发：打出/使用【闪】后一步机（首个\n+            // 其他存活判定黑→1 雷伤+摸 1）\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::CardResponded,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: vec![EventKind::CardUsed],\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(ZjLeijiBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_JIDIAN,\n+            // 查询型单面：Damage commit 尾臂——距受伤者 ≤1 的首个其他存\n+            // 活判定黑→1 雷伤（链挡旗标不自我递归=登记差异）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_ZHIWANG,\n+            // 查询型单面：CardsMoved commit 臂——其他角色获得牌（非摸牌\n+            // 阶段摸牌，CardsDrawn 天然隔离）→其弃首张手牌\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_GONGZHENG,\n+            // 查询型单面：Judge begin 臂——判定区有牌则弃首张（鬼计同款）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_XUECHI,\n+            // 查询型单面：End begin 臂——座位序首个其他存活失 2（随机→\n+            // 首个确定性近似登记）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_HEISHENG,\n+            // Death 触发（死亡前置窗口=遗言面）：全体其他横置一步机\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::Death,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: Vec::new(),\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(HeishengBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_SHENGFU,\n+            // 查询型单面：End begin 臂——首个有坐骑的其他存活弃其一\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_LEIZHOU,\n+            // 查询型单面：Judge begin 臂——首个其他存活 1 雷伤\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_LEIFU,\n+            // 查询型单面：End begin 臂——首个其他存活横置态切换\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_LEIZHU,\n+            // Death 触发（遗言面，黑绳同位）：座位序逐发雷伤\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::Death,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: Vec::new(),\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(LeizhuBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_FUDU,\n+            // 查询型单面：CardUsed commit 臂——他人用桃随机其他失 1\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_KUJIU,\n+            // 查询型单面：Judge begin 臂（global 扫持有者）——其他角色\n+            // 准备阶段失 1+视为用酒\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_RENAO,\n+            // Death 触发（遗言面，雷诛同位）：首发其他 3 火伤\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::Death,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: Vec::new(),\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(RenaoBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_LUNHUI,\n+            // 查询型单面：Judge begin 臂——hp≤2 与首个 hp>2 其他交换体力\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_WANGSHENG,\n+            // 查询型单面：Play begin 臂——恒定虚拟南蛮（全部其他存活）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_ZLFANSHI,\n+            // 查询型单面：Damage commit 尾臂——terra 旗交替+反噬 1 伤\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_SHIYOU,\n+            // 查询型单面：弃牌机 Done 前臂——弃牌阶段弃牌花色互异获得\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_WANGHUN,\n+            // Death 触发（遗言面）：清往事旗+前两个其他各禁用首个技\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::Death,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: Vec::new(),\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(WanghunBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_WANGSHI,\n+            // 查询型单面：Judge begin global 臂（恒定禁基本牌）+\n+            // PlayCard 拒绝位+回合结束全清\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_TIEMIAN,\n+            // 查询型单面：sha 机仁王块扩展（防具槽空视为仁王盾）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_ZHADAO,\n+            // 查询型单面：sha 机青釭穿透链扩展（来源持有者即穿透）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_ZHUXIN,\n+            // Death 触发（遗言面）：最低体力其他存活受 2 伤一步机\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::Death,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: Vec::new(),\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(ZhuxinBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_SUOZU,\n+            // 查询型单面：Prepare begin 臂——全部其他存活横置\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_ABI,\n+            // 查询型单面：Damage commit 尾臂——来源受 1 火伤（恒定火）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_PINGDENG,\n+            // Death 触发（遗言面）：最高体力两波火伤（2+1）两步机\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::Death,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: Vec::new(),\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(PingdengBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_REMEN,\n+            // 查询型单面：PlayCard 拒绝位（plain 杀）+AOE 机窗口前跳过\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_ZHIFEN,\n+            // 查询型单面：Prepare begin 臂——获得座位序首个其他首张手\n+            // 牌+其受 1 火伤（无来源）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_HUOXING,\n+            // Death 触发（遗言面）：全部其他存活逐座火伤机\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::Death,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: Vec::new(),\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(HuoxingBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_BUFO,\n+            // 查询型单面×2：伤害入口减 1（终值>1）+准备阶段距离 1 火伤\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_WULIANG,\n+            // 查询型单面×2：结束阶段摸 2+准备阶段体力<3 回复至 3\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_DITING,\n+            // 查询型单面：computed_distance 双向链（from -1 / to +1）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_WEIMU,\n+            // 查询型单面：黑锦囊 PlayCard 拒绝位+黑色 AOE 窗口前跳过\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_BINGFENG,\n+            // Death 触发（遗言面）：翻面来源一步机\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::Death,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: Vec::new(),\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(BingfengBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_PANGUAN,\n+            // 查询型单面：延时锦囊 PlayCard 拒绝位\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_JUHUN,\n+            // 查询型单面：End begin 臂——座位序首个其他翻面（恒定翻面）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_WANGXIANG,\n+            // Death 触发（遗言面）：全场装备全弃一步机\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::Death,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: Vec::new(),\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(WangxiangBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_TIANYU,\n+            // 查询型单面：End begin 臂——自横置先解除+全场未横置横置\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_QIWU,\n+            // 查询型单面：CardUsed commit 臂——梅花牌使用后受伤回复 1\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+    ];\n+    skills.extend(boss_host::skills());\n+    skills\n+}"},{"sha":"2d6dde0d939842e9c305c042443b85b8e5f9957a","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20-v2/baseline-changed/crates/engine-native-kernel/src/archive/damage.rs","status":"added","additions":73,"deletions":0,"changes":73,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v2%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Farchive%2Fdamage.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v2%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Farchive%2Fdamage.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v2%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Farchive%2Fdamage.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1,73 @@\n+//! Private106 damage settlement codec; old machine field layouts are unchanged.\n+use super::*;\n+use crate::event::{DamageOutcome as O, DamageProgress as P, DamageSettlement};\n+pub(super) fn enc_settlement(w: &mut W, s: &DamageSettlement) {\n+    enc_opt_u32(w, s.committed_damage);\n+    w.u32(s.hp_loss);\n+    w.u8(match s.outcome {\n+        O::Running => 0,\n+        O::Cancelled => 1,\n+        O::ReplacedByLoseHp => 2,\n+        O::Zero => 3,\n+        O::Completed => 4,\n+    });\n+    w.boolean(s.notrigger);\n+    let (tag, remaining) = match &s.progress {\n+        P::Before => (0, None),\n+        P::HpCommitted => (1, None),\n+        P::TargetDamage => (2, None),\n+        P::DyingPending => (3, None),\n+        P::DyingDone => (4, None),\n+        P::Source => (5, None),\n+        P::End => (6, None),\n+        P::After => (7, None),\n+        P::Chain { remaining } => (8, Some(remaining)),\n+        P::Done => (9, None),\n+        P::ZeroPending => (10, None),\n+        P::Stopped => (11, None),\n+    };\n+    w.u8(tag);\n+    if let Some(remaining) = remaining {\n+        w.len(remaining.len());\n+        for p in remaining {\n+            w.u8(*p);\n+        }\n+    }\n+}\n+pub(super) fn dec_settlement(r: &mut R<'_>) -> Result<DamageSettlement, ArchiveError> {\n+    let committed_damage = dec_opt_u32(r)?;\n+    let hp_loss = r.u32()?;\n+    let outcome = match r.u8()? {\n+        0 => O::Running,\n+        1 => O::Cancelled,\n+        2 => O::ReplacedByLoseHp,\n+        3 => O::Zero,\n+        4 => O::Completed,\n+        t => return Err(ArchiveError::BadTag(\"damage_outcome\", t)),\n+    };\n+    let notrigger = r.boolean()?;\n+    let progress = match r.u8()? {\n+        0 => P::Before,\n+        1 => P::HpCommitted,\n+        2 => P::TargetDamage,\n+        3 => P::DyingPending,\n+        4 => P::DyingDone,\n+        5 => P::Source,\n+        6 => P::End,\n+        7 => P::After,\n+        8 => P::Chain {\n+            remaining: r.vec(|r| r.u8())?,\n+        },\n+        9 => P::Done,\n+        10 => P::ZeroPending,\n+        11 => P::Stopped,\n+        t => return Err(ArchiveError::BadTag(\"damage_progress\", t)),\n+    };\n+    Ok(DamageSettlement {\n+        committed_damage,\n+        hp_loss,\n+        outcome,\n+        notrigger,\n+        progress,\n+    })\n+}"},{"sha":"52bf9d02af23304293f8d306b3a66c96117db9ba","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20-v2/baseline-changed/crates/engine-native-kernel/src/archive/values.rs","status":"added","additions":277,"deletions":0,"changes":277,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v2%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Farchive%2Fvalues.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v2%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Farchive%2Fvalues.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v2%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Farchive%2Fvalues.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1,277 @@\n+use super::*;\n+\n+// ---- 基础类型编码 ----\n+\n+pub(super) fn enc_opt_u32(w: &mut W, v: Option<u32>) {\n+    match v {\n+        Some(x) => {\n+            w.u8(1);\n+            w.u32(x);\n+        }\n+        None => w.u8(0),\n+    }\n+}\n+\n+pub(super) fn dec_opt_u32(r: &mut R<'_>) -> Result<Option<u32>, ArchiveError> {\n+    match r.u8()? {\n+        0 => Ok(None),\n+        1 => Ok(Some(r.u32()?)),\n+        t => Err(ArchiveError::BadTag(\"opt_u32\", t)),\n+    }\n+}\n+\n+/// PlayerId = u8。\n+pub(super) fn enc_pid(w: &mut W, v: &PlayerId) {\n+    w.u8(*v);\n+}\n+\n+pub(super) fn dec_pid(r: &mut R<'_>) -> Result<PlayerId, ArchiveError> {\n+    Ok(r.u8()?)\n+}\n+\n+/// Option<PlayerId>。\n+pub(super) fn enc_opt_pid(w: &mut W, v: &Option<PlayerId>) {\n+    match v {\n+        Some(x) => {\n+            w.u8(1);\n+            w.u8(*x);\n+        }\n+        None => w.u8(0),\n+    }\n+}\n+\n+pub(super) fn dec_opt_pid(r: &mut R<'_>) -> Result<Option<PlayerId>, ArchiveError> {\n+    match r.u8()? {\n+        0 => Ok(None),\n+        1 => Ok(Some(r.u8()?)),\n+        t => Err(ArchiveError::BadTag(\"opt_pid\", t)),\n+    }\n+}\n+\n+/// Vec<PlayerId>。\n+pub(super) fn enc_pids(w: &mut W, v: &[PlayerId]) {\n+    w.len(v.len());\n+    for p in v {\n+        w.u8(*p);\n+    }\n+}\n+\n+pub(super) fn dec_pids(r: &mut R<'_>) -> Result<Vec<PlayerId>, ArchiveError> {\n+    r.vec(|r| r.u8())\n+}\n+\n+/// SkillDefId = u16。\n+pub(super) fn enc_skill(w: &mut W, v: &SkillDefId) {\n+    w.u16(*v);\n+}\n+\n+pub(super) fn dec_skill(r: &mut R<'_>) -> Result<SkillDefId, ArchiveError> {\n+    Ok(r.u16()?)\n+}\n+\n+pub(super) fn enc_damage_nature(w: &mut W, v: &DamageNature) {\n+    w.u8(match v {\n+        DamageNature::Normal => 0,\n+        DamageNature::Fire => 1,\n+        DamageNature::Thunder => 2,\n+    });\n+}\n+\n+pub(super) fn dec_damage_nature(r: &mut R<'_>) -> Result<DamageNature, ArchiveError> {\n+    Ok(match r.u8()? {\n+        0 => DamageNature::Normal,\n+        1 => DamageNature::Fire,\n+        2 => DamageNature::Thunder,\n+        t => return Err(ArchiveError::BadTag(\"damage_nature\", t)),\n+    })\n+}\n+\n+pub(super) fn enc_phase(w: &mut W, v: &Phase) {\n+    w.u8(match v {\n+        Phase::Judge => 0,\n+        Phase::Draw => 1,\n+        Phase::Play => 2,\n+        Phase::Discard => 3,\n+        Phase::End => 4,\n+    });\n+}\n+\n+pub(super) fn dec_phase(r: &mut R<'_>) -> Result<Phase, ArchiveError> {\n+    Ok(match r.u8()? {\n+        0 => Phase::Judge,\n+        1 => Phase::Draw,\n+        2 => Phase::Play,\n+        3 => Phase::Discard,\n+        4 => Phase::End,\n+        t => return Err(ArchiveError::BadTag(\"phase\", t)),\n+    })\n+}\n+\n+pub(super) fn enc_event_kind(w: &mut W, v: &EventKind) {\n+    use EventKind::*;\n+    let t = match v {\n+        DamageBefore => 0u8,\n+        Damage => 1,\n+        Recover => 2,\n+        CardsDrawn => 3,\n+        CardsMoved => 4,\n+        CardUsed => 5,\n+        CardResponded => 6,\n+        Dying => 7,\n+        Death => 8,\n+        PhaseBegin => 9,\n+        PhaseEnd => 10,\n+        TurnEnded => 11,\n+        SkillToggled => 12,\n+        Equipped => 13,\n+        Linked => 14,\n+        CardsDiscarded => 15,\n+        TurnOverBefore => 16,\n+        TurnOvered => 17,\n+        LoseHp => 18,\n+        DyingSaved => 19,\n+        CardsLost => 20,\n+        ShaDodged => 21,\n+        CardsGiven => 22,\n+        DamageSource => 23, DamageEnd => 24, DamageAfter => 25, DamageZero => 26, DamageCancelled => 27,\n+    };\n+    w.u8(t);\n+}\n+\n+pub(super) fn dec_event_kind(r: &mut R<'_>) -> Result<EventKind, ArchiveError> {\n+    use EventKind::*;\n+    Ok(match r.u8()? {\n+        0 => DamageBefore,\n+        1 => Damage,\n+        2 => Recover,\n+        3 => CardsDrawn,\n+        4 => CardsMoved,\n+        5 => CardUsed,\n+        6 => CardResponded,\n+        7 => Dying,\n+        8 => Death,\n+        9 => PhaseBegin,\n+        10 => PhaseEnd,\n+        11 => TurnEnded,\n+        12 => SkillToggled,\n+        13 => Equipped,\n+        14 => Linked,\n+        15 => CardsDiscarded,\n+        16 => TurnOverBefore,\n+        17 => TurnOvered,\n+        18 => LoseHp,\n+        19 => DyingSaved,\n+        20 => CardsLost,\n+        21 => ShaDodged,\n+        22 => CardsGiven,\n+        23 => DamageSource,24 => DamageEnd,25 => DamageAfter,26 => DamageZero,27 => DamageCancelled,\n+        t => return Err(ArchiveError::BadTag(\"event_kind\", t)),\n+    })\n+}\n+\n+pub(super) fn enc_stage(w: &mut W, v: &Stage) {\n+    w.u8(match v {\n+        Stage::BeforeTriggers => 0,\n+        Stage::Commit => 1,\n+        Stage::AfterTriggers => 2,\n+        Stage::Intrinsic => 3,\n+        Stage::Done => 4,\n+    });\n+}\n+\n+pub(super) fn dec_stage(r: &mut R<'_>) -> Result<Stage, ArchiveError> {\n+    Ok(match r.u8()? {\n+        0 => Stage::BeforeTriggers,\n+        1 => Stage::Commit,\n+        2 => Stage::AfterTriggers,\n+        3 => Stage::Intrinsic,\n+        4 => Stage::Done,\n+        t => return Err(ArchiveError::BadTag(\"stage\", t)),\n+    })\n+}\n+\n+pub(super) fn enc_role(w: &mut W, v: &Role) {\n+    w.u8(match v {\n+        Role::Lord => 0,\n+        Role::Loyalist => 1,\n+        Role::Rebel => 2,\n+        Role::Traitor => 3,\n+    });\n+}\n+\n+pub(super) fn dec_role(r: &mut R<'_>) -> Result<Role, ArchiveError> {\n+    Ok(match r.u8()? {\n+        0 => Role::Lord,\n+        1 => Role::Loyalist,\n+        2 => Role::Rebel,\n+        3 => Role::Traitor,\n+        t => return Err(ArchiveError::BadTag(\"role\", t)),\n+    })\n+}\n+\n+pub(super) fn enc_faction(w: &mut W, f: &crate::catalog::Faction) {\n+    w.u8(match f {\n+        crate::catalog::Faction::Wei => 0,\n+        crate::catalog::Faction::Shu => 1,\n+        crate::catalog::Faction::Wu => 2,\n+        crate::catalog::Faction::Qun => 3,\n+    });\n+}\n+\n+pub(super) fn dec_faction(r: &mut R<'_>) -> Result<crate::catalog::Faction, ArchiveError> {\n+    Ok(match r.u8()? {\n+        0 => crate::catalog::Faction::Wei,\n+        1 => crate::catalog::Faction::Shu,\n+        2 => crate::catalog::Faction::Wu,\n+        3 => crate::catalog::Faction::Qun,\n+        t => return Err(ArchiveError::BadTag(\"faction\", t)),\n+    })\n+}\n+\n+pub(super) fn enc_winner(w: &mut W, v: &Winner) {\n+    match v {\n+        Winner::Player(p) => {\n+            w.u8(0);\n+            w.u8(*p);\n+        }\n+        Winner::LordSide => w.u8(1),\n+        Winner::Rebels => w.u8(2),\n+        Winner::Traitor => w.u8(3),\n+        // P0 解码加固：势力编码走显式表（与 dec_faction 同源），避免\n+        // `*f as u8` 依赖枚举声明顺序——重排/增删势力不再静默错位。\n+        Winner::Faction(f) => {\n+            w.u8(4);\n+            enc_faction(w, f);\n+        }\n+        Winner::Versus(t) => {\n+            w.u8(5);\n+            w.u8(*t as u8);\n+        }\n+        Winner::Doudizhu { lord_won } => {\n+            w.u8(6);\n+            w.boolean(*lord_won);\n+        }\n+        Winner::Boss { boss_won } => {\n+            w.u8(7);\n+            w.boolean(*boss_won);\n+        }\n+    }\n+}\n+\n+pub(super) fn dec_winner(r: &mut R<'_>) -> Result<Winner, ArchiveError> {\n+    Ok(match r.u8()? {\n+        0 => Winner::Player(r.u8()?),\n+        1 => Winner::LordSide,\n+        2 => Winner::Rebels,\n+        3 => Winner::Traitor,\n+        4 => Winner::Faction(dec_faction(r)?),\n+        5 => Winner::Versus(r.u8()? as usize),\n+        6 => Winner::Doudizhu {\n+            lord_won: r.boolean()?,\n+        },\n+        7 => Winner::Boss {\n+            boss_won: r.boolean()?,\n+        },\n+        t => return Err(ArchiveError::BadTag(\"winner\", t)),\n+    })\n+}"},{"sha":"64ca5bcd8bf76d05e9e0289af0202b5a1c2106d9","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20-v2/baseline-changed/crates/engine-native-kernel/src/event.rs","status":"added","additions":379,"deletions":0,"changes":379,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v2%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fevent.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v2%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fevent.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v2%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fevent.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1,379 @@\n+//! 事件模型：显式事件栈的帧。\n+//!\n+//! 与旧实现的差别：事件嵌套是一棵真实的栈（父/子/返回值都在帧上），\n+//! 不再是「单槽恢复 + 三个延迟队列」；帧载荷是类型化的 `EventData`，\n+//! 技能可以在结算窗口内改写帧载荷（如伤害转移）。\n+\n+use crate::ids::{CardId, EventId, PlayerId, SkillDefId};\n+mod damage;\n+pub use damage::*;\n+\n+/// 触发唤醒用的事件类别。\n+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash)]\n+pub enum EventKind {\n+    DamageBefore,\n+    Damage,\n+    Recover,\n+    CardsDrawn,\n+    CardsMoved,\n+    CardUsed,\n+    CardResponded,\n+    Dying,\n+    Death,\n+    PhaseBegin,\n+    PhaseEnd,\n+    TurnEnded,\n+    SkillToggled,\n+    Equipped,\n+    Linked,\n+    CardsDiscarded,\n+    TurnOverBefore,\n+    TurnOvered,\n+    LoseHp,\n+    /// 濒死救回（U05 xianjian 焚逝挂点，规则 v157）：固有救援机在\n+    /// 体力>0 且脱离濒死时发射（上游 dyingAfter 时序等价）。\n+    DyingSaved,\n+    /// 失去牌（swd 批 125，规则 v312）：手牌被弃置/交出或装备被取走时\n+    /// 发射（上游 `loseEnd` 触发窗；装备替换过程不发——上游 `equiping`\n+    /// 期过滤同口径）。\n+    CardsLost,\n+    /// 杀被闪避（swd 批 141，规则 v316 同批）：目标成功闪避【杀】时发射\n+    /// （上游 `shaMiss` 触发窗；用于李香龙等「杀被闪后反击」类技能）。\n+    ShaDodged,\n+    /// 手牌直接给予另一角色（NC04 未映射事件批）：`give_hand_card` 共享\n+    /// 原语发射；DSL `cards_given` 触发窗（旧线 EventKind 同名同义）。\n+    CardsGiven,\n+    DamageSource,\n+    DamageEnd,\n+    DamageAfter,\n+    DamageZero,\n+    DamageCancelled,\n+}\n+\n+/// 失去牌的来源区（`CardsLost` 载荷；上游 `card.original`）。\n+#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n+pub enum LostOrigin {\n+    Hand,\n+    Equip,\n+    Judge,\n+}\n+\n+/// 伤害属性：普通 / 火 / 雷。属性伤害触发铁索连环传导。\n+#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n+pub enum DamageNature {\n+    Normal,\n+    Fire,\n+    Thunder,\n+}\n+\n+/// 伤害事件载荷：结算窗口内可被技能改写（转移/防止）。\n+#[derive(Debug, Clone, PartialEq, Eq)]\n+pub struct DamageData {\n+    pub source: Option<PlayerId>,\n+    /// 当前承受者——转移技能改写此字段。\n+    pub target: PlayerId,\n+    pub amount: i32,\n+    /// One canonical submission and continuation authority.\n+    pub settlement: DamageSettlement,\n+    pub nature: DamageNature,\n+    /// 防止类技能改写此字段；提交阶段读到 true 则不扣血。\n+    pub prevented: bool,\n+    /// 转移链记录：原始承受者 -> …… -> 最终承受者。\n+    pub redirect_chain: Vec<PlayerId>,\n+    /// 造成伤害的牌（奸雄/遗计类技能依赖；非牌类伤害为 None）。\n+    pub card: Option<CardId>,\n+    /// 铁索连环传导伤害（ow 源氏飞刃 notLink 过滤依赖；主伤害为\n+    /// false——上游 event.notLink() 同口径，规则 v129）。\n+    pub from_chain: bool,\n+}\n+\n+#[derive(Debug, Clone, PartialEq, Eq)]\n+pub struct CardUseData {\n+    pub card: CardId,\n+    pub player: PlayerId,\n+    pub targets: Vec<PlayerId>,\n+    /// 杀的属性（仅 Sha/FireSha 有意义）。\n+    pub nature: DamageNature,\n+    /// view-as 转化声明（武圣/龙胆）：以此牌种结算而非目录牌种。\n+    pub use_as: Option<crate::catalog::CardKind>,\n+    /// E03 使用前取消（猴子偷桃）：确认后由窗口机器执行夺桃并把本位\n+    /// 置真；提交阶段读到真值即跳过结算。不入 canonical_hash（取消的\n+    /// 最终状态——牌的位置与体力——已可观测）。\n+    pub cancelled: bool,\n+}\n+\n+/// 类型化事件载荷。\n+#[derive(Debug, Clone, PartialEq, Eq)]\n+pub enum EventData {\n+    /// E03 翻面前置窗口（漩涡面具等锁定技可取消）。\n+    TurnOverBefore {\n+        player: PlayerId,\n+        cancelled: bool,\n+    },\n+    /// E03 翻面完成。\n+    TurnOvered {\n+        player: PlayerId,\n+        face_down: bool,\n+    },\n+    Damage(DamageData),\n+    /// A real child window referencing its canonical damage ancestor.\n+    DamageWindow { root: EventId, window: DamageWindowKind },\n+    Recover {\n+        player: PlayerId,\n+        amount: u32,\n+        by_card: Option<CardId>,\n+    },\n+    CardsDrawn {\n+        player: PlayerId,\n+        cards: Vec<CardId>,\n+    },\n+    CardsMoved {\n+        cards: Vec<CardId>,\n+        from: PlayerId,\n+        to: PlayerId,\n+    },\n+    CardUsed(CardUseData),\n+    CardResponded {\n+        card: CardId,\n+        player: PlayerId,\n+    },\n+    Dying {\n+        player: PlayerId,\n+        source: Option<PlayerId>,\n+    },\n+    Death {\n+        player: PlayerId,\n+        killer: Option<PlayerId>,\n+    },\n+    Phase {\n+        player: PlayerId,\n+        phase: Phase,\n+        begin: bool,\n+    },\n+    TurnEnded {\n+        player: PlayerId,\n+    },\n+    SkillToggled {\n+        player: PlayerId,\n+        skill: SkillDefId,\n+        enabled: bool,\n+        /// 是否临时获得、回合结束移除。\n+        temporary: bool,\n+    },\n+    /// 装备一张装备牌；同栏旧牌被替换入弃牌堆。\n+    Equipped {\n+        player: PlayerId,\n+        card: CardId,\n+        /// 同栏被替换下的旧牌（若有）。\n+        replaced: Option<CardId>,\n+    },\n+    /// 连环状态切换（铁索连环横置/重置）。\n+    Linked {\n+        player: PlayerId,\n+        linked: bool,\n+    },\n+    /// 弃牌（弃牌阶段批量弃置等；供连营类「失去手牌」触发）。\n+    CardsDiscarded {\n+        player: PlayerId,\n+        cards: Vec<CardId>,\n+    },\n+    /// 失去牌（swd 批 125）：`origins` 与 `cards` 等长，标出每张的来源区\n+    /// （上游 `card.original`——'h'/'e'/'j'）。\n+    CardsLost {\n+        player: PlayerId,\n+        cards: Vec<CardId>,\n+        origins: Vec<LostOrigin>,\n+    },\n+    /// 杀被闪避（swd 批 141）：`card` = 被闪的【杀】，`source` = 使用者，\n+    /// `target` = 闪避者（上游 `shaMiss` 的 trigger.card/player）。\n+    ShaDodged {\n+        card: CardId,\n+        source: PlayerId,\n+        target: PlayerId,\n+    },\n+    /// 手牌直接给予（NC04 未映射事件批）：`giver` 交出、`recipient` 收入，\n+    /// 与旧线 `DomainEvent::CardsGiven` 同形（giver≠recipient 且非空才发）。\n+    /// 触发上下文：事件主玩家=recipient、来源=giver、amount=张数（旧线\n+    /// dispatch 同口径）。**每次给牌动作一帧、携带全部牌**（规则 v326，\n+    /// `give_hand_cards` 批量原语）；CardsLost/CardsMoved 仍逐张。\n+    CardsGiven {\n+        giver: PlayerId,\n+        recipient: PlayerId,\n+        cards: Vec<CardId>,\n+    },\n+    /// 失去体力（逐技对照批三 v77）：直接扣减体力——不经护甲、不触发\n+    /// 伤害类窗口/铁索/伤害来源技；体力 ≤0 进入濒死（上游 loseHp）。\n+    LoseHp {\n+        player: PlayerId,\n+        amount: u32,\n+    },\n+    /// 濒死救回（dyingAfter 等价，见 EventKind::DyingSaved）。\n+    DyingSaved {\n+        player: PlayerId,\n+        source: Option<PlayerId>,\n+    },\n+}\n+\n+impl EventData {\n+    pub fn kind(&self) -> EventKind {\n+        match self {\n+            EventData::Damage(_) => EventKind::Damage,\n+            EventData::DamageWindow { window, .. } => window.event_kind(),\n+            EventData::Recover { .. } => EventKind::Recover,\n+            EventData::CardsDrawn { .. } => EventKind::CardsDrawn,\n+            EventData::CardsMoved { .. } => EventKind::CardsMoved,\n+            EventData::CardUsed(_) => EventKind::CardUsed,\n+            EventData::CardResponded { .. } => EventKind::CardResponded,\n+            EventData::Dying { .. } => EventKind::Dying,\n+            EventData::Death { .. } => EventKind::Death,\n+            EventData::Phase { begin: true, .. } => EventKind::PhaseBegin,\n+            EventData::Phase { begin: false, .. } => EventKind::PhaseEnd,\n+            EventData::TurnEnded { .. } => EventKind::TurnEnded,\n+            EventData::SkillToggled { .. } => EventKind::SkillToggled,\n+            EventData::Equipped { .. } => EventKind::Equipped,\n+            EventData::Linked { .. } => EventKind::Linked,\n+            EventData::CardsDiscarded { .. } => EventKind::CardsDiscarded,\n+            EventData::CardsLost { .. } => EventKind::CardsLost,\n+            EventData::ShaDodged { .. } => EventKind::ShaDodged,\n+            EventData::CardsGiven { .. } => EventKind::CardsGiven,\n+            EventData::TurnOverBefore { .. } => EventKind::TurnOverBefore,\n+            EventData::TurnOvered { .. } => EventKind::TurnOvered,\n+            EventData::LoseHp { .. } => EventKind::LoseHp,\n+            EventData::DyingSaved { .. } => EventKind::DyingSaved,\n+        }\n+    }\n+\n+    /// DamageBefore 与 Damage 共用 Damage 载荷。\n+    pub fn trigger_kind(&self, before: bool) -> EventKind {\n+        match self {\n+            EventData::Damage(_) if before => EventKind::DamageBefore,\n+            other => other.kind(),\n+        }\n+    }\n+}\n+\n+/// 回合阶段。\n+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]\n+pub enum Phase {\n+    Judge,\n+    Draw,\n+    Play,\n+    Discard,\n+    End,\n+}\n+\n+impl Phase {\n+    pub const ALL: [Phase; 5] = [\n+        Phase::Judge,\n+        Phase::Draw,\n+        Phase::Play,\n+        Phase::Discard,\n+        Phase::End,\n+    ];\n+\n+    pub fn next(self) -> Option<Phase> {\n+        Some(match self {\n+            Phase::Judge => Phase::Draw,\n+            Phase::Draw => Phase::Play,\n+            Phase::Play => Phase::Discard,\n+            Phase::Discard => Phase::End,\n+            Phase::End => return None,\n+        })\n+    }\n+\n+    pub fn name(&self) -> &'static str {\n+        match self {\n+            Phase::Judge => \"judge\",\n+            Phase::Draw => \"draw\",\n+            Phase::Play => \"play\",\n+            Phase::Discard => \"discard\",\n+            Phase::End => \"end\",\n+        }\n+    }\n+}\n+\n+/// 触发时机带（镜像非官方 first/normal/last 三段）。\n+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]\n+pub enum Timing {\n+    First,\n+    Normal,\n+    Last,\n+}\n+\n+/// 已入队待运行的触发项。\n+#[derive(Debug, Clone, PartialEq, Eq)]\n+pub struct QueuedTrigger {\n+    pub def: SkillDefId,\n+    pub owner: PlayerId,\n+    /// Canonical timing / effective priority / reserved zero / relative seat / definition.\n+    pub order: (u8, i32, u8, u8, u16),\n+}\n+\n+/// 帧所处的管线阶段。\n+#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n+pub enum Stage {\n+    /// 伤害前置触发窗口。\n+    BeforeTriggers,\n+    /// 内核提交动作（扣血/摸牌/移牌等）。\n+    Commit,\n+    /// 提交后触发窗口。\n+    AfterTriggers,\n+    /// 内核固有流程机器（濒死救援/出牌结算/弃牌选择等）。\n+    Intrinsic,\n+    /// 已完成，待弹栈。\n+    Done,\n+}\n+\n+/// 事件栈上的一帧。\n+#[derive(Debug, Clone, PartialEq, Eq)]\n+pub struct Frame {\n+    pub id: EventId,\n+    pub parent: Option<EventId>,\n+    pub kind: EventKind,\n+    pub data: EventData,\n+    pub stage: Stage,\n+    pub queue: Vec<QueuedTrigger>,\n+    /// 当前阶段的触发队列是否已收集。\n+    pub planned: bool,\n+    pub intrinsic_done: bool,\n+}\n+\n+impl Frame {\n+    pub fn damage(&self) -> &DamageData {\n+        match &self.data {\n+            EventData::Damage(d) => d,\n+            other => panic!(\"frame {:?} is not damage: {other:?}\", self.kind),\n+        }\n+    }\n+\n+    pub fn damage_mut(&mut self) -> &mut DamageData {\n+        match &mut self.data {\n+            EventData::Damage(d) => d,\n+            other => panic!(\"frame {other:?} is not damage\"),\n+        }\n+    }\n+\n+    /// TurnOverBefore 帧载荷可变访问（漩涡面具取消写回）。\n+    pub fn turn_over_before_mut(&mut self) -> (&mut PlayerId, &mut bool) {\n+        match &mut self.data {\n+            EventData::TurnOverBefore { player, cancelled } => (player, cancelled),\n+            other => panic!(\"frame {other:?} is not turn_over_before\"),\n+        }\n+    }\n+\n+    /// CardUsed 帧载荷可变访问（猴子偷桃取消写回）。\n+    pub fn card_use_mut(&mut self) -> &mut CardUseData {\n+        match &mut self.data {\n+            EventData::CardUsed(u) => u,\n+            other => panic!(\"frame {other:?} is not card_use\"),\n+        }\n+    }\n+\n+    /// CardUsed 帧载荷只读访问（同疾读目标；非 CardUsed 帧返回 None）。\n+    pub fn card_use(&self) -> Option<&CardUseData> {\n+        match &self.data {\n+            EventData::CardUsed(u) => Some(u),\n+            _ => None,\n+        }\n+    }\n+}"},{"sha":"64053a3bd7d16a1f11d04b33b25c6ece73319ea7","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20-v2/baseline-changed/crates/engine-native-kernel/src/event/damage.rs","status":"added","additions":124,"deletions":0,"changes":124,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v2%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fevent%2Fdamage.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v2%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fevent%2Fdamage.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v2%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fevent%2Fdamage.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1,124 @@\n+//! Canonical damage quantity, submission receipt and sole continuation progress.\n+use super::*;\n+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]\n+pub enum DamageOutcome {\n+    #[default]\n+    Running,\n+    Cancelled,\n+    ReplacedByLoseHp,\n+    Zero,\n+    Completed,\n+}\n+#[derive(Debug, Clone, PartialEq, Eq, Default)]\n+pub enum DamageProgress {\n+    #[default]\n+    Before,\n+    HpCommitted,\n+    TargetDamage,\n+    DyingPending,\n+    DyingDone,\n+    Source,\n+    End,\n+    After,\n+    Chain {\n+        remaining: Vec<PlayerId>,\n+    },\n+    Done,\n+    ZeroPending,\n+    Stopped,\n+}\n+#[derive(Debug, Clone, PartialEq, Eq, Default)]\n+pub struct DamageSettlement {\n+    pub committed_damage: Option<u32>,\n+    pub hp_loss: u32,\n+    pub outcome: DamageOutcome,\n+    pub notrigger: bool,\n+    pub progress: DamageProgress,\n+}\n+#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n+pub enum DamageWindowKind {\n+    Source,\n+    End,\n+    After,\n+    Zero,\n+    Cancelled,\n+}\n+impl DamageWindowKind {\n+    pub fn event_kind(self) -> EventKind {\n+        match self {\n+            Self::Source => EventKind::DamageSource,\n+            Self::End => EventKind::DamageEnd,\n+            Self::After => EventKind::DamageAfter,\n+            Self::Zero => EventKind::DamageZero,\n+            Self::Cancelled => EventKind::DamageCancelled,\n+        }\n+    }\n+    pub fn tag(self) -> u8 {\n+        match self {\n+            Self::Source => 0,\n+            Self::End => 1,\n+            Self::After => 2,\n+            Self::Zero => 3,\n+            Self::Cancelled => 4,\n+        }\n+    }\n+    pub fn from_tag(tag: u8) -> Option<Self> {\n+        Some(match tag {\n+            0 => Self::Source,\n+            1 => Self::End,\n+            2 => Self::After,\n+            3 => Self::Zero,\n+            4 => Self::Cancelled,\n+            _ => return None,\n+        })\n+    }\n+}\n+impl DamageSettlement {\n+    pub fn canonical_bytes(&self) -> Vec<u8> {\n+        let mut out = b\"native-damage-settlement/1\".to_vec();\n+        out.push(u8::from(self.committed_damage.is_some()));\n+        out.extend_from_slice(&self.committed_damage.unwrap_or(0).to_le_bytes());\n+        out.extend_from_slice(&self.hp_loss.to_le_bytes());\n+        out.push(match self.outcome {\n+            DamageOutcome::Running => 0,\n+            DamageOutcome::Cancelled => 1,\n+            DamageOutcome::ReplacedByLoseHp => 2,\n+            DamageOutcome::Zero => 3,\n+            DamageOutcome::Completed => 4,\n+        });\n+        out.push(u8::from(self.notrigger));\n+        let (tag, remaining) = match &self.progress {\n+            DamageProgress::Before => (0, None),\n+            DamageProgress::HpCommitted => (1, None),\n+            DamageProgress::TargetDamage => (2, None),\n+            DamageProgress::DyingPending => (3, None),\n+            DamageProgress::DyingDone => (4, None),\n+            DamageProgress::Source => (5, None),\n+            DamageProgress::End => (6, None),\n+            DamageProgress::After => (7, None),\n+            DamageProgress::Chain { remaining } => (8, Some(remaining)),\n+            DamageProgress::Done => (9, None),\n+            DamageProgress::ZeroPending => (10, None),\n+            DamageProgress::Stopped => (11, None),\n+        };\n+        out.push(tag);\n+        if let Some(xs) = remaining {\n+            out.extend_from_slice(&(xs.len() as u32).to_le_bytes());\n+            out.extend_from_slice(xs);\n+        }\n+        out\n+    }\n+}\n+\n+/// A window carries only its checked ancestor identity; filters read the live canonical root.\n+pub fn damage_event<'a>(frames: &'a [Frame], frame: &'a Frame) -> &'a EventData {\n+    if let EventData::DamageWindow { root, .. } = frame.data {\n+        &frames\n+            .iter()\n+            .find(|f| f.id == root)\n+            .expect(\"checked damage ancestor\")\n+            .data\n+    } else {\n+        &frame.data\n+    }\n+}"},{"sha":"ddfffcae9975f2b1c735f94bd3d1ce7b6adf64f4","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20-v2/baseline-changed/crates/engine-native-kernel/src/kernel.rs","status":"added","additions":85,"deletions":0,"changes":85,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v2%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fkernel.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v2%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fkernel.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v2%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fkernel.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1,85 @@\n+//! 内核固有机制：帧提交动作与内核流程机器。\n+//!\n+//! 原则：移动牌、扣血、摸牌、事件推进、濒死/死亡/出牌结算等**规则机制**\n+//! 归内核；具体技能的条件与流程归内容模块（`content`），两者通过同一套\n+//! 事件帧 + 机器接口协作。\n+\n+use crate::catalog::{CardKind, SkillMachine};\n+use crate::choice::{ChoiceKind, ChoiceOption, ChoiceSpec};\n+use crate::event::{EventData, Phase};\n+use crate::ids::EventId;\n+use crate::ids::PlayerId;\n+use crate::machine::{damage_data, damage_data_with, Ctx, Flow, LogEvent};\n+\n+/// 帧提交阶段的一次性内核动作。\n+pub fn commit_frame(ctx: &mut Ctx<'_>, frame_id: EventId) {\n+    let (kind, data) = {\n+        let f = ctx.res.frame(frame_id).expect(\"commit frame\");\n+        (f.kind, f.data.clone())\n+    };\n+    record_vm_history(ctx, &data);\n+    match data {\n+        EventData::Damage(d) => { if d.settlement.committed_damage.is_none() { commit_damage(ctx, frame_id, d); } },\n+        EventData::DamageWindow { root, window: crate::event::DamageWindowKind::End } => {\n+            let d=ctx.res.frame(root).expect(\"damage root\").damage().clone();\n+            if d.amount>0 && !d.prevented && !d.settlement.notrigger {post_damage(ctx,d);}\n+        },\n+        EventData::LoseHp { player, amount } => commit_lose_hp(ctx, player, amount),\n+        EventData::CardUsed(u) => commit_card_used(ctx, u),\n+        EventData::Equipped { player, card, .. } => commit_equip(ctx, frame_id, player, card),\n+        EventData::Linked { player, .. } => commit_linked(ctx, frame_id, player),\n+        EventData::Phase {\n+            player,\n+            phase,\n+            begin,\n+        } => commit_phase(ctx, player, phase, begin),\n+        EventData::TurnEnded { player } => commit_turn_ended(ctx, player),\n+        EventData::TurnOverBefore { player, cancelled } => {\n+            commit_turn_over_before(ctx, player, cancelled)\n+        }\n+        EventData::CardsDiscarded { player, .. } => commit_cards_discarded(ctx, player),\n+        EventData::CardsMoved { to, .. } => commit_cards_moved(ctx, to),\n+        EventData::Recover { player, .. } => commit_recover_skills(ctx, player),\n+        // CardsDrawn/Recover/CardsMoved 等在构造时已由助手完成区移动作。\n+        _ => {\n+            let _ = kind;\n+        }\n+    }\n+}\n+\n+mod damage;\n+mod damage_flow;\n+pub use damage_flow::DamageFlow;\n+use damage::*;\n+mod events;\n+use events::*;\n+mod equipment;\n+pub use equipment::{grant_equip_skills, revoke_equip_skills};\n+use equipment::commit_equip;\n+mod intrinsic;\n+pub use intrinsic::*;\n+mod combat_rules;\n+pub(crate) use combat_rules::*;\n+pub use combat_rules::tao_futai2_banned;\n+mod sha;\n+pub use sha::*;\n+mod dying;\n+pub use dying::*;\n+mod duel;\n+pub use duel::*;\n+mod tricks;\n+pub use tricks::*;\n+mod nullify;\n+pub use nullify::*;\n+mod judge;\n+pub use judge::*;\n+mod aoe;\n+pub use aoe::*;\n+mod discard;\n+pub use discard::*;\n+mod death;\n+pub use death::*;\n+mod monkey;\n+pub use monkey::*;\n+mod phase;\n+use phase::*;"},{"sha":"a4877dc07745c7370d3305b788e3c54edbb3d4cc","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20-v2/baseline-changed/crates/engine-native-kernel/src/kernel/damage.rs","status":"added","additions":1119,"deletions":0,"changes":1119,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v2%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fkernel%2Fdamage.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v2%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fkernel%2Fdamage.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v2%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fkernel%2Fdamage.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1,1119 @@\n+use super::*;\n+\n+/// Submit one canonical source amount; DamageFlow owns later callbacks and Dying.\n+pub(super) fn commit_damage(ctx: &mut Ctx<'_>, frame_id: EventId, mut d: crate::event::DamageData) {\n+    if d.prevented {\n+        ctx.log(LogEvent::DamagePrevented { target: d.target });\n+        finish_damage(ctx, frame_id, d, crate::event::DamageOutcome::Cancelled);\n+        return;\n+    }\n+    if d.amount <= 0 {\n+        finish_damage(ctx, frame_id, d, crate::event::DamageOutcome::Zero);\n+        return;\n+    }\n+    // 绝情（Boss 张春华，规则 v260；一将包旧绝情）：锁定——你造成的伤害\n+    // 改为目标失去等量体力（上游 source damageBefore cancel+loseHp(num)\n+    // 同口径；num=增幅前原始值=d.amount；取消后伤害事件不再结算=受击/\n+    // 加成类不触发；置于急冻前——上游 damageBefore 同层内容序）\n+    if let Some(jqdef) = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::names::JUE_QING)\n+    {\n+        if let Some(src) = d.source {\n+            if src != d.target && ctx.core.player(src).alive && ctx.core.has_skill(src, jqdef) {\n+                ctx.emit(EventData::LoseHp {\n+                    player: d.target,\n+                    amount: d.amount as u32,\n+                });\n+                finish_damage(ctx, frame_id, d, crate::event::DamageOutcome::ReplacedByLoseHp);\n+        return;\n+            }\n+        }\n+    }\n+    // 无心（Boss 张春华，规则 v260）伤害半：锁定——你受到的伤害改为失去\n+    // 1 点体力（上游 damageBefore priority 10 cancel+loseHp() 无参=1 同\n+    // 口径；置于绝情后=同层 priority 序）\n+    if let Some(wxdef) = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::names::BOSS_WUXIN)\n+    {\n+        if ctx.core.has_skill(d.target, wxdef) && ctx.core.player(d.target).alive {\n+            ctx.emit(EventData::LoseHp {\n+                player: d.target,\n+                amount: 1,\n+            });\n+            finish_damage(ctx, frame_id, d, crate::event::DamageOutcome::ReplacedByLoseHp);\n+        return;\n+        }\n+    }\n+    // 急冻冰封（U05 ow 美，规则 v127）：锁定——冰封目标受所有伤害无\n+    // 效（上游 jidong2 damageBefore trigger.cancel() 同口径；铁索传导\n+    // 的独立事件同门控）。置于各伤害增幅钩前：伤害已整体取消，\n+    // damageBegin 类增幅同上游一样不再结算。\n+    if ctx.core.player(d.target).jidong_active {\n+        ctx.log(LogEvent::DamagePrevented { target: d.target });\n+        finish_damage(ctx, frame_id, d, crate::event::DamageOutcome::Cancelled);\n+        return;\n+    }\n+    // 诚信免伤（U05 xianjian 明绣，规则 v164）：锁定——免伤状态目标受\n+    // 所有伤害无效（上游 chengxin2 damageBefore trigger.cancel 同口径）\n+    if ctx.core.player(d.target).chengxin_active {\n+        ctx.log(LogEvent::DamagePrevented { target: d.target });\n+        finish_damage(ctx, frame_id, d, crate::event::DamageOutcome::Cancelled);\n+        return;\n+    }\n+    // 招祸（Boss 毕方，规则 v227）：锁定——你免疫所有火属性伤害（上游\n+    // boss_zhaohuo damageBegin4 trigger.cancel 的火伤分支同口径；诚信免\n+    // 伤同位）\n+    if d.nature == crate::event::DamageNature::Fire {\n+        if let Some(zdef) = ctx\n+            .catalog\n+            .skill_by_name(crate::vocabulary::names::BOSS_ZHAOHUO)\n+        {\n+            if ctx.core.has_skill(d.target, zdef) {\n+                ctx.log(LogEvent::DamagePrevented { target: d.target });\n+                finish_damage(ctx, frame_id, d, crate::event::DamageOutcome::Cancelled);\n+        return;\n+            }\n+        }\n+    }\n+    // 火神（Boss 周瑜，规则 v263）：锁定——火属性伤害对你无效，你回复\n+    // 1 点体力（上游 damageBegin1 cancel+recover() 无参=1 同口径；置于\n+    // 招祸同位=damageBegin 层，取消后增幅不结算）\n+    if d.nature == crate::event::DamageNature::Fire {\n+        if let Some(hsdef) = ctx\n+            .catalog\n+            .skill_by_name(crate::vocabulary::names::BOSS_HUOSHEN)\n+        {\n+            if ctx.core.player(d.target).alive && ctx.core.has_skill(d.target, hsdef) {\n+                ctx.log(LogEvent::DamagePrevented { target: d.target });\n+                ctx.recover(d.target, 1, None);\n+                finish_damage(ctx, frame_id, d, crate::event::DamageOutcome::Cancelled);\n+        return;\n+            }\n+        }\n+    }\n+    // 拟态（Boss 梼杌，规则 v217）：锁定——防止你于回合内受到的伤害\n+    //（上游 boss_nitai_in damageBegin4 trigger.cancel 同口径：当前回合\n+    // =持有者）\n+    if let Some(ndef) = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::names::BOSS_NITAI)\n+    {\n+        if ctx.core.has_skill(d.target, ndef) && ctx.core.turn.current == d.target {\n+            ctx.log(LogEvent::DamagePrevented { target: d.target });\n+            finish_damage(ctx, frame_id, d, crate::event::DamageOutcome::Cancelled);\n+        return;\n+        }\n+    }\n+    let mut amount = i64::from(d.amount);\n+    // 拟态（Boss 梼杌，规则 v217）：锁定——你于回合外受到的火属性伤害\n+    // +1（上游 boss_nitai_out damageBegin1 num++ 同口径）\n+    if d.nature == crate::event::DamageNature::Fire {\n+        if let Some(ndef) = ctx\n+            .catalog\n+            .skill_by_name(crate::vocabulary::names::BOSS_NITAI)\n+        {\n+            if ctx.core.has_skill(d.target, ndef) && ctx.core.turn.current != d.target {\n+                amount += 1;\n+            }\n+        }\n+    }\n+    // 赤龙牙（U05 swd 第四批，规则 v88）：锁定——来源装备赤龙牙时\n+    // 火属性伤害 +1（上游 damageBegin num++；非铁索传导照常）\n+    if d.nature == crate::event::DamageNature::Fire {\n+        if let Some(src) = d.source {\n+            if ctx.core.player(src).alive\n+                && ctx\n+                    .core\n+                    .player(src)\n+                    .equips\n+                    .iter()\n+                    .any(|c| ctx.catalog.card_kind(*c) == CardKind::Chilongya)\n+            {\n+                amount += 1;\n+            }\n+        }\n+    }\n+    // 星君眼（U05 swd 第九批，规则 v93）：锁定——你的【杀】伤害 +1\n+    //（上游 damageBegin num++；card==sha 同口径；铁索传导为独立事件\n+    // 照常 +1）\n+    if d.card\n+        .map(|c| ctx.catalog.card_kind(c) == CardKind::Sha)\n+        .unwrap_or(false)\n+    {\n+        if let Some(src) = d.source {\n+            if ctx.core.player(src).alive\n+                && ctx\n+                    .core\n+                    .player(src)\n+                    .equips\n+                    .iter()\n+                    .any(|c| ctx.catalog.card_kind(*c) == CardKind::Xingjunyan)\n+            {\n+                amount += 1;\n+            }\n+        }\n+    }\n+    // 链钩（U05 ow 路霸，规则 v128）：本回合被钩者首次受伤害 +1\n+    //（上游 liangou2 damageBegin trigger.num++ usable:1 同口径；来源\n+    // 不限=上游无 source 条件；仅路霸出牌阶段可钩住，换回合解除）\n+    if let Some(t) = ctx.core.turn.liangou_hook {\n+        if d.target == t && !ctx.core.turn.liangou_bonus_used {\n+            amount += 1;\n+            ctx.core.turn.liangou_bonus_used = true;\n+        }\n+    }\n+    // 飞刃（U05 ow 源氏，规则 v129）：锁定——你的黑桃杀伤害 +1（非\n+    // 铁索传导；上游 damageBegin trigger.num++ notLink 同口径；花色按\n+    // 实体牌——火/雷杀为黑桃时同样命中）\n+    if d.card\n+        .map(|c| {\n+            ctx.catalog.card_kind(c).is_sha_like()\n+                && ctx.catalog.cards[c as usize].suit == crate::catalog::Suit::Spade\n+        })\n+        .unwrap_or(false)\n+        && !d.from_chain\n+    {\n+        if let Some(src) = d.source {\n+            let has_feiren = ctx\n+                .catalog\n+                .skill_by_name(crate::vocabulary::host::WUDIAN_FEIREN_KEY)\n+                .map(|def| ctx.core.has_skill(src, def))\n+                .unwrap_or(false);\n+            if has_feiren && ctx.core.player(src).alive {\n+                amount += 1;\n+            }\n+        }\n+    }\n+    // 刺猬（U07 玩点论杀韩龙，规则 v111）：锁定——你的杀对满血目标伤\n+    // 害 +1；加后 ≥ 目标体力则目标获本回合濒死即死标记（上游\n+    // addTempSkill(\"ciqiu_dying\")）且本技能移除（一次性）\n+    if d.card\n+        .map(|c| ctx.catalog.card_kind(c) == CardKind::Sha)\n+        .unwrap_or(false)\n+    {\n+        if let Some(src) = d.source {\n+            if ctx.core.player(d.target).alive\n+                && ctx.core.player(d.target).hp == ctx.core.player(d.target).max_hp as i32\n+            {\n+                if let Some(def) = ctx\n+                    .catalog\n+                    .skill_by_name(crate::vocabulary::host::WUDIAN_CIQIU_KEY)\n+                {\n+                    if ctx.core.has_skill(src, def) {\n+                        amount += 1;\n+                        if amount >= i64::from(ctx.core.player(d.target).hp) {\n+                            ctx.core.turn.ciqiu_dying.push(d.target);\n+                            ctx.core.skills.remove(&(src, def));\n+                        }\n+                    }\n+                }\n+            }\n+        }\n+    }\n+    // 毒瘟（U07 ow，规则 v122）：锁定——造成伤害时若你手牌数与受伤害\n+    // 角色相等，伤害 +1（上游 duwen damageBegin num++ 同口径；铁索传\n+    // 导为独立事件照常判定）\n+    if let Some(src) = d.source {\n+        if ctx.core.player(src).alive\n+            && ctx.core.player(src).hand.len() == ctx.core.player(d.target).hand.len()\n+        {\n+            if let Some(def) = ctx\n+                .catalog\n+                .skill_by_name(crate::vocabulary::host::WUDIAN_DUWEN_KEY)\n+            {\n+                if ctx.core.has_skill(src, def) {\n+                    amount += 1;\n+                }\n+            }\n+        }\n+    }\n+    // 回合伤害统计（U05 xianjian 明绣，规则 v160 灵火门控）：来源本回\n+    // 合已造成伤害 +实际量（护甲/机甲吸收后；上游 getStat(\"damage\") 按\n+    // 醉酒（Boss 白无常，规则 v255）：你使用的【杀】造成的伤害 +1（上\n+    // 游 damageBegin1 sha+shaParent 同口径；火杀/雷杀同属 sha 族）\n+    if d.card\n+        .map(|c| {\n+            matches!(\n+                ctx.catalog.card_kind(c),\n+                CardKind::Sha | CardKind::FireSha | CardKind::LeiSha\n+            )\n+        })\n+        .unwrap_or(false)\n+    {\n+        if let Some(zjdef) = ctx\n+            .catalog\n+            .skill_by_name(crate::vocabulary::names::BOSS_ZUIJIU)\n+        {\n+            if let Some(src) = d.source {\n+                if ctx.core.has_skill(src, zjdef) {\n+                    amount += 1;\n+                }\n+            }\n+        }\n+    }\n+    // 灵渠（Boss 玄武，规则 v237）：受到的大于 1 点伤害视为 0 点（上游\n+    // 不佛（Boss 地藏王，规则 v274）：受到大于 1 点的伤害时改为其中 1\n+    // 点（上游 boss_bufo damageBegin4 num>1→num-1 同口径；置于灵渠归零\n+    // 检查前——灵渠读调整后终值；两技同持为不同武将不共存，序未登记）\n+    if amount > 1 {\n+        if let Some(bfdef) = ctx\n+            .catalog\n+            .skill_by_name(crate::vocabulary::names::BOSS_BUFO)\n+        {\n+            if ctx.core.has_skill(d.target, bfdef) {\n+                amount -= 1;\n+            }\n+        }\n+    }\n+    // boss_lingqu cancel damageBegin4 num>1 → num=0 同口径；置于增幅后\n+    // 统计前——终值>1 才归零；0 点伤害仍完成事件→受击摸 1/计数照常）\n+    if amount > 1 {\n+        if let Some(ldef) = ctx\n+            .catalog\n+            .skill_by_name(crate::vocabulary::names::BOSS_LINGQU)\n+        {\n+            if ctx.core.has_skill(d.target, ldef) {\n+                amount = 0;\n+            }\n+        }\n+    }\n+    // 脉轮（swd 批 137，规则 v316）：3=首次造成/受到伤害 -1、4=+1（各自\n+    // 一次性；上游 mailun31/32/41/42 damageBegin 用后移除同口径）\n+    {\n+        if let Some(src) = d.source {\n+            let mode = ctx.core.player(src).mailun_mode;\n+            if (mode == 3 || mode == 4) && !ctx.core.player(src).mailun_out_used {\n+                amount = if mode == 3 {\n+                    amount.saturating_sub(1)\n+                } else {\n+                    amount.saturating_add(1)\n+                };\n+                ctx.core.player_mut(src).mailun_out_used = true;\n+            }\n+        }\n+        let mode = ctx.core.player(d.target).mailun_mode;\n+        if (mode == 3 || mode == 4) && !ctx.core.player(d.target).mailun_in_used {\n+            amount = if mode == 3 {\n+                amount.saturating_sub(1)\n+            } else {\n+                amount.saturating_add(1)\n+            };\n+            ctx.core.player_mut(d.target).mailun_in_used = true;\n+        }\n+    }\n+    // 护天护体（swd 批 131，规则 v314）：目标寄存护天牌时伤害以「体力降至\n+    // 寄存数」为上限（上游 hutian2 damageBegin priority -55 `trigger.num =\n+    // hp - storage.hutian2.length` 同口径）\n+    {\n+        let hold = ctx.core.player(d.target).hutian_hold.len() as i32;\n+        if hold > 0 {\n+            let hp = ctx.core.player(d.target).hp;\n+            let cap = hp - hold;\n+            if i64::from(cap) < amount {\n+                amount = i64::from(cap.max(0));\n+            }\n+        }\n+    }\n+    let Ok(amount)=i32::try_from(amount) else {\n+        ctx.res.fault=Some(crate::machine::VmFault{skill:\"intrinsic_damage\".into(),owner:d.target,event:\"Damage\".into(),kind:\"DamageAmountOverflow\".into(),detail:\"canonical source amount exceeds i32\".into()});return;\n+    };\n+    d.amount = amount;\n+    if amount <= 0 { finish_damage(ctx, frame_id, d, crate::event::DamageOutcome::Zero); return; }\n+    let submitted = amount as u32;\n+    d.settlement.committed_damage = Some(submitted);\n+    d.settlement.progress = crate::event::DamageProgress::HpCommitted;\n+    // Source counters and logs consume canonical submitted event.num, never armor HP loss.\n+    // damageEnd num 同口径）\n+    if let Some(src) = d.source {\n+        if src != d.target {\n+            let p = ctx.core.player_mut(src);\n+            p.turn_damage = p.turn_damage.saturating_add(amount.clamp(0,255) as u8);\n+        }\n+    }\n+    // 还侠跟踪（swd 屈娴，批 27）：还侠转化杀造成真实伤害 → 置位（上\n+    // 游 expire 子技 source damageAfter 同口径；牌 id 匹配最后提交者）\n+    if let Some(dcard) = d.card {\n+        if let Some((card, caused)) = ctx.core.turn.huanxia_track.last_mut() {\n+            if *card == dcard {\n+                *caused = true;\n+            }\n+        }\n+    }\n+    // 鼠槌（swd 卡牌面窗口机批）：多杀循环链武装中，任一杀造成真实伤害\n+    // → 置位（上游 shuchui2 charlotte source damageEnd filter card=sha\n+    // 同口径；武装=当前回合玩家=链主）\n+    if ctx.core.turn.shuchui_armed\n+        && d.source == Some(ctx.core.turn.current)\n+        && d.card\n+            .map(|c| ctx.catalog.card_kind(c).is_sha_like())\n+            .unwrap_or(false)\n+    {\n+        ctx.core.turn.shuchui_hit = true;\n+    }\n+    let mut hp_loss = submitted;\n+    // 护甲（G1 扩展）：1:1 抵扣伤害，先于体力扣减\n+    let hujia = ctx.core.player(d.target).hujia;\n+    if hujia > 0 {\n+        let absorbed = (hujia as u32).min(hp_loss);\n+        ctx.core.player_mut(d.target).hujia = hujia - absorbed as u8;\n+        hp_loss -= absorbed;\n+        ctx.log(LogEvent::HujiaAbsorbed {\n+            player: d.target,\n+            amount: absorbed,\n+        });\n+    }\n+    // 机甲血（U05 ow D.Va，规则 v141）：1:1 抵扣伤害（体力不损）——\n+    // 上游 changeHp 拦截（体力回补+机甲血同扣）观察等价；归零后照常\n+    // 扣体力（chongzhuang 重装累计登记暂缓）。\n+    let has_jijia = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::host::WUDIAN_JIJIA_KEY)\n+        .map(|def| ctx.core.has_skill(d.target, def))\n+        .unwrap_or(false);\n+    if has_jijia {\n+        let j = ctx.core.player(d.target).jijia_hp;\n+        if j > 0 {\n+            let absorbed = (j as u32).min(hp_loss);\n+            ctx.core.player_mut(d.target).jijia_hp = j - absorbed as u8;\n+            hp_loss -= absorbed;\n+            ctx.log(LogEvent::HujiaAbsorbed {\n+                player: d.target,\n+                amount: absorbed,\n+            });\n+        }\n+    }\n+    let receipt = format!(\"vm_damage_receipt:{frame_id}\");\n+    for ((_, key), value) in &mut ctx.core.vm_aux.flags {\n+        if key == &receipt {\n+            *value = d.target as u32 + 1;\n+        }\n+    }\n+    let p = ctx.core.player_mut(d.target);\n+    // 无限体力（上游 Infinity）：伤害照常结算与记录，但不改变体力\n+    //（hp 保持 == max_hp，故「已受伤」类判据恒假——与上游一致）。\n+    if !p.infinite_hp() {\n+        let Some(hp)=p.hp.checked_sub(hp_loss as i32) else {\n+            ctx.res.fault=Some(crate::machine::VmFault{skill:\"intrinsic_damage\".into(),owner:d.target,event:\"Damage\".into(),kind:\"DamageHpOverflow\".into(),detail:\"HP subtraction exceeds i32\".into()});return;\n+        };\n+        p.hp = hp;\n+    }\n+    d.settlement.hp_loss = if p.infinite_hp() { 0 } else { hp_loss };\n+    ctx.res.frame_mut(frame_id).expect(\"damage root\").data = EventData::Damage(d.clone());\n+    hlss_light_refill(ctx, d.target);\n+    ctx.log(LogEvent::DamageDealt {\n+        source: d.source,\n+        target: d.target,\n+        amount: d.amount.max(0) as u32,\n+        redirected_from: d.redirect_chain.clone(),\n+        card: d.card,\n+    });\n+}\n+\n+pub(super) fn post_damage(ctx: &mut Ctx<'_>, d: crate::event::DamageData) {\n+    // 炮台降级（U05 ow，规则 v123）：炮台持有者受伤 1 点降 1 级（上游\n+    // paotai3 damageEnd forced：storage -= trigger.num；下限 0）\n+    if ctx.core.player(d.target).paotai_lv > 0 && d.amount > 0 && !d.prevented {\n+        let lv = ctx.core.player(d.target).paotai_lv;\n+        ctx.core.player_mut(d.target).paotai_lv = lv.saturating_sub(d.amount as u8);\n+    }\n+    // 吸血鬼指环（U05 swd 第六批，规则 v90）：锁定——你的【杀】造成\n+    // 伤害后，若你已受伤，回复等量体力（上游 xixue：damageEnd sha &&\n+    // hp<maxHp → recover(num)）\n+    if let Some(src) = d.source {\n+        if src != d.target\n+            && ctx.core.player(src).alive\n+            && ctx.core.player(src).hp < ctx.core.player(src).max_hp as i32\n+            && d.card\n+                .map(|c| ctx.catalog.card_kind(c) == CardKind::Sha)\n+                .unwrap_or(false)\n+            && ctx\n+                .core\n+                .player(src)\n+                .equips\n+                .iter()\n+                .any(|c| ctx.catalog.card_kind(*c) == CardKind::Xixueguizhihuan)\n+        {\n+            ctx.recover(src, d.amount.max(0) as u32, None);\n+        }\n+    }\n+    // 青龙令珠（U05 swd 第九批，规则 v93）：你对其他角色造成属性伤害\n+    // 后（目标存活），获得其一张牌（上游 damageEnd hasNature + alive →\n+    // gainPlayerCard he；RNG 口径同批四代抽）\n+    if d.nature != crate::event::DamageNature::Normal {\n+        if let Some(src) = d.source {\n+            let t = d.target;\n+            if src != t\n+                && ctx.core.player(src).alive\n+                && ctx.core.player(t).alive\n+                && ctx\n+                    .core\n+                    .player(src)\n+                    .equips\n+                    .iter()\n+                    .any(|c| ctx.catalog.card_kind(*c) == CardKind::Qinglonglingzhu)\n+            {\n+                let he_len = ctx.core.player(t).hand.len() + ctx.core.player(t).equips.len();\n+                if he_len > 0 {\n+                    let pick = ctx.core.rng.gen_range(he_len as u32) as usize;\n+                    let hand_n = ctx.core.player(t).hand.len();\n+                    let c = if pick < hand_n {\n+                        ctx.core.player(t).hand[pick]\n+                    } else {\n+                        ctx.core.player(t).equips[pick - hand_n]\n+                    };\n+                    if ctx.core.player(t).hand.contains(&c) {\n+                        ctx.core.player_mut(t).hand.retain(|x| *x != c);\n+                    } else {\n+                        ctx.core.player_mut(t).equips.retain(|x| *x != c);\n+                        crate::kernel::revoke_equip_skills(ctx.core, ctx.catalog, t, c);\n+                    }\n+                    ctx.core.player_mut(src).hand.push(c);\n+                    ctx.log(LogEvent::CardsGiven {\n+                        from: t,\n+                        to: src,\n+                        cards: vec![c],\n+                    });\n+                }\n+            }\n+        }\n+    }\n+    // 隐贼（Boss 混沌，规则 v210）双臂：①激活门控——体力首次减至一半\n+    // 或更少时启用（SkillInstance.enabled 直写+SkillToggled；上游\n+    // boss_yinzei_switch changeHp enableSkill 同口径）；②伤害后弃牌——\n+    // 已激活且持有者无手牌 → 来源弃置一张手牌（确定性取首张；上游\n+    // damageEnd randomDiscard 随机改首张登记差异）\n+    if let Some(ydef) = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::names::BOSS_YINZEI)\n+    {\n+        let holder = d.target;\n+        let has_yinzei = ctx.core.has_skill_any_state(holder, ydef);\n+        if has_yinzei {\n+            let p = ctx.core.player(holder);\n+            if p.hp > 0 && p.hp <= p.max_hp as i32 / 2 {\n+                let was_enabled = ctx.core.has_skill(holder, ydef);\n+                if !was_enabled {\n+                    if let Some(inst) = ctx.core.skills.get_mut(&(holder, ydef)) {\n+                        inst.enabled = true;\n+                    }\n+                    ctx.log(LogEvent::SkillToggled {\n+                        player: holder,\n+                        skill: ctx.catalog.skill_name(ydef),\n+                        enabled: true,\n+                    });\n+                }\n+            }\n+            // 伤害后弃牌（激活态）\n+            if ctx.core.has_skill(holder, ydef)\n+                && ctx.core.player(holder).hand.is_empty()\n+                && ctx.core.player(holder).hp > 0\n+            {\n+                if let Some(src) = d.source {\n+                    if src != holder\n+                        && ctx.core.player(src).alive\n+                        && !ctx.core.player(src).hand.is_empty()\n+                    {\n+                        let c = ctx.core.player(src).hand[0];\n+                        ctx.discard_from_hand(src, c);\n+                    }\n+                }\n+            }\n+        }\n+    }\n+    // 伤逝（规则 v260）：体力变化（受伤扣血）后补牌\n+    shangshix_draw(ctx, d.target);\n+    // 章武（Boss 刘备，规则 v261）：你受到伤害后（来源存活且非自己）——\n+    // 你弃置一张牌，来源弃置一张牌，或来源受到 1 点伤害（上游 [1,∞] 自\n+    // 选+来源 chooseToDiscard/取消双 AI 态度面→双方恒弃首张确定性近似\n+    // 登记；num=刘备弃牌数可多张登记；弃牌面=手牌首张，两手皆空跳过）\n+    if let Some(zwdef) = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::names::BOSS_ZHANGWU)\n+    {\n+        if ctx.core.has_skill(d.target, zwdef) && ctx.core.player(d.target).alive {\n+            if let Some(src) = d.source {\n+                if src != d.target && ctx.core.player(src).alive {\n+                    let hold = ctx.core.player(d.target).hand.first().copied();\n+                    if let Some(c) = hold {\n+                        ctx.discard_from_hand(d.target, c);\n+                    }\n+                    let src_card = ctx.core.player(src).hand.first().copied();\n+                    if let Some(c) = src_card {\n+                        ctx.discard_from_hand(src, c);\n+                    } else {\n+                        // 来源无牌可弃 → 受 1 点伤害（上游取消分支同口径；\n+                        // 来源亦空手牌时装备面不弃登记差异）\n+                        ctx.emit(EventData::Damage(crate::machine::damage_data(\n+                            Some(d.target),\n+                            src,\n+                            1,\n+                        )));\n+                    }\n+                }\n+            }\n+        }\n+    }\n+    // 极点（Boss 张角，规则 v263）：你造成伤害后——距离受伤者 1 以内的\n+    // 一名其他角色判定：黑则其受到 1 点雷伤（上游 source damageAfter\n+    // chooseTarget get.distance(trigger.player,target)<=1 + judge 黑 →\n+    // damage(\"thunder\") 同口径；chooseTarget AI→座位序首个确定性近似；\n+    // 链挡旗标=极点雷伤不自我递归，登记差异：上游 damageAfter 真递归；\n+    // 判定为内联确定性口径，无改判窗）\n+    if let Some(jddef) = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::names::BOSS_JIDIAN)\n+    {\n+        if let Some(src) = d.source {\n+            if ctx.core.player(src).alive && ctx.core.has_skill(src, jddef) {\n+                // 链挡：极点造成的雷伤不再触发极点\n+                if !ctx.core.turn.jidian_chain {\n+                    let seats = ctx.core.players.len() as PlayerId;\n+                    if let Some(t) = (0..seats).find(|&t| {\n+                        t != d.target\n+                            && ctx.core.player(t).alive\n+                            && ctx.core.computed_distance(ctx.catalog, d.target, t) <= 1\n+                    }) {\n+                        // 置链挡后 emit：嵌套 Damage 帧的极点臂见旗标清除\n+                        // 并跳过（挡恰一层=极点雷伤不链式，登记差异）\n+                        ctx.core.turn.jidian_chain = true;\n+                        let judged = ctx.draw_judge_card();\n+                        let black = matches!(\n+                            ctx.catalog.cards[judged as usize].suit,\n+                            crate::catalog::Suit::Spade | crate::catalog::Suit::Club\n+                        );\n+                        ctx.to_discard(judged);\n+                        if black {\n+                            ctx.emit(EventData::Damage(crate::machine::damage_data_with(\n+                                Some(src),\n+                                t,\n+                                1,\n+                                crate::event::DamageNature::Thunder,\n+                                None,\n+                            )));\n+                        }\n+                    }\n+                } else {\n+                    // 嵌套极点雷伤到达：清链挡（仅挡一层）\n+                    ctx.core.turn.jidian_chain = false;\n+                }\n+            }\n+        }\n+    }\n+    // 反噬（十殿阎罗转轮王，规则 v269）：每回合第一次受伤后置 terra 旗，\n+    // 同回合再次受伤 → 随机一名其他角色受 1 点伤害（上游 boss_zlfanshi\n+    // damageEnd addTempSkill boss_zlfanshi_terra 交替同口径；随机→座位序\n+    // 首个确定性近似登记；旗清零=回合结束全清，封印解除同位）\n+    if let Some(fsdef) = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::names::BOSS_ZLFANSHI)\n+    {\n+        if ctx.core.has_skill(d.target, fsdef) && ctx.core.player(d.target).alive {\n+            if ctx.core.player(d.target).zlfanshi_terra {\n+                ctx.core.player_mut(d.target).zlfanshi_terra = false;\n+                let seats = ctx.core.players.len() as PlayerId;\n+                if let Some(t) = (0..seats).find(|&t| t != d.target && ctx.core.player(t).alive) {\n+                    ctx.emit(EventData::Damage(crate::machine::damage_data(\n+                        Some(d.target),\n+                        t,\n+                        1,\n+                    )));\n+                }\n+            } else {\n+                ctx.core.player_mut(d.target).zlfanshi_terra = true;\n+            }\n+        }\n+    }\n+    // 逐厄（Boss 穷奇，规则 v211）：global damageEnd——任何人受到伤害\n+    // 后（来源存活且非穷奇），穷奇与来源各摸一张（上游 boss_zhue\n+    // asyncDraw([player, source]) 同口径）\n+    if let Some(zdef) = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::names::BOSS_ZHUE)\n+    {\n+        // 任一存活穷奇持有者（单 boss 场景恰一）\n+        let holders: Vec<PlayerId> = ctx\n+            .core\n+            .skills\n+            .iter()\n+            .filter(|((_, dd), i)| *dd == zdef && i.enabled)\n+            .map(|((o, _), _)| *o)\n+            .collect();\n+        for holder in holders {\n+            if !ctx.core.player(holder).alive {\n+                continue;\n+            }\n+            if let Some(src) = d.source {\n+                if src != holder && ctx.core.player(src).alive {\n+                    ctx.draw_cards(holder, 1);\n+                    ctx.draw_cards(src, 1);\n+                }\n+            }\n+        }\n+    }\n+    // 阿鼻（Boss 平等王，规则 v272）：受到有来源的伤害后——来源受 1\n+    // 点火焰伤害（上游 randomGet fire/thunder→恒定火确定性近似登记；\n+    // 无来源伤害不触发；新伤害无来源→天然无递归）\n+    if let Some(abdef) = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::names::BOSS_ABI)\n+    {\n+        if let Some(src) = d.source {\n+            if ctx.core.has_skill(d.target, abdef)\n+                && ctx.core.player(d.target).alive\n+                && ctx.core.player(src).alive\n+            {\n+                ctx.emit(EventData::Damage(crate::machine::damage_data_with(\n+                    None,\n+                    src,\n+                    1,\n+                    crate::event::DamageNature::Fire,\n+                    None,\n+                )));\n+            }\n+        }\n+    }\n+    // 远策（Boss 郭嘉，规则 v259）：global damageEnd——其他角色对另一\n+    // 其他角色造成伤害后（双方存活），判定：黑→受伤角色失 1 体力 / 红→\n+    // 来源失 1 体力（chooseControl 选项一恒定确定性近似登记——上游 AI\n+    // 态度选面+rejudge stop 检查+判定修正回调不落；hp>0 门=濒死未决者\n+    // 跳过登记差异）\n+    if let Some(ycdef) = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::names::BOSS_YUANCE)\n+    {\n+        let holders: Vec<PlayerId> = ctx\n+            .core\n+            .skills\n+            .iter()\n+            .filter(|((_, dd), i)| *dd == ycdef && i.enabled)\n+            .map(|((o, _), _)| *o)\n+            .collect();\n+        if let Some(holder) = holders.first() {\n+            if let Some(src) = d.source {\n+                if ctx.core.player(*holder).alive\n+                    && src != d.target\n+                    && ctx.core.player(src).alive\n+                    && ctx.core.player(d.target).alive\n+                    && ctx.core.player(src).hp > 0\n+                    && ctx.core.player(d.target).hp > 0\n+                {\n+                    let judged = ctx.draw_judge_card();\n+                    let black = matches!(\n+                        ctx.catalog.cards[judged as usize].suit,\n+                        crate::catalog::Suit::Spade | crate::catalog::Suit::Club\n+                    );\n+                    ctx.to_discard(judged);\n+                    let loser = if black { d.target } else { src };\n+                    ctx.emit(EventData::LoseHp {\n+                        player: loser,\n+                        amount: 1,\n+                    });\n+                }\n+            }\n+        }\n+    }\n+    // 灵渠（Boss 玄武，规则 v237）：每次受到伤害后摸 1 张牌且受击计数\n+    // +1（上游 boss_lingqu damageEnd draw+storage++ 同口径；0 点伤害照常；\n+    // 计数=PlayerState.lingqu_count 跨回合持久，手牌上限 +X）\n+    if let Some(ldef) = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::names::BOSS_LINGQU)\n+    {\n+        if ctx.core.has_skill(d.target, ldef) && ctx.core.player(d.target).alive {\n+            ctx.draw_cards(d.target, 1);\n+            let p = ctx.core.player_mut(d.target);\n+            p.lingqu_count = p.lingqu_count.saturating_add(1);\n+        }\n+    }\n+    // 急叮（Boss 明星，规则 v245）：global damageEnd——友方（同侧非己）\n+    // 受敌方来源伤害后，对来源用虚拟雷杀（LeiSha kind 载体——机器直发不\n+    // 经 PlayCard 校验；蓐收加成尾面登记差异未建模）\n+    if let Some(jddef) = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::names::BOSS_JIDING)\n+    {\n+        let holders: Vec<PlayerId> = ctx\n+            .core\n+            .skills\n+            .iter()\n+            .filter(|((_, dd), i)| *dd == jddef && i.enabled)\n+            .map(|((o, _), _)| *o)\n+            .filter(|o| {\n+                ctx.core.player(*o).alive\n+                    && *o != d.target\n+                    && ctx.core.is_boss_side(*o) == ctx.core.is_boss_side(d.target)\n+            })\n+            .collect();\n+        if let Some(holder) = holders.first() {\n+            if let Some(src) = d.source {\n+                if src != *holder\n+                    && ctx.core.player(src).alive\n+                    && ctx.core.is_boss_side(src) != ctx.core.is_boss_side(*holder)\n+                {\n+                    ctx.use_virtual_card(*holder, CardKind::LeiSha, vec![src]);\n+                }\n+            }\n+        }\n+    }\n+    // 忍性（年兽形态，规则 v249）：global damageEnd——持有者非当前回\n+    // 合角色时，任意角色受到伤害后其摸 1（上游 boss_renxing damageEnd\n+    // global `_status.currentPhase != player` 同口径）\n+    if let Some(rxdef) = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::names::BOSS_RENXING)\n+    {\n+        let holders: Vec<PlayerId> = ctx\n+            .core\n+            .skills\n+            .iter()\n+            .filter(|((_, dd), i)| *dd == rxdef && i.enabled)\n+            .map(|((o, _), _)| *o)\n+            .filter(|o| ctx.core.player(*o).alive && ctx.core.turn.current != *o)\n+            .collect();\n+        for holder in holders {\n+            ctx.draw_cards(holder, 1);\n+        }\n+    }\n+    // 延妒门控（Boss 穷奇，规则 v213）：体力首次≤一半激活（隐贼同款\n+    // enable 直写；穷奇持延妒——与隐贼块并列， holder 独立判定）\n+    if let Some(dudef) = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::names::BOSS_YANDU)\n+    {\n+        let holder = d.target;\n+        if ctx.core.has_skill_any_state(holder, dudef) && !ctx.core.has_skill(holder, dudef) {\n+            let p = ctx.core.player(holder);\n+            if p.hp > 0 && p.hp <= p.max_hp as i32 / 2 {\n+                if let Some(inst) = ctx.core.skills.get_mut(&(holder, dudef)) {\n+                    inst.enabled = true;\n+                }\n+                ctx.log(LogEvent::SkillToggled {\n+                    player: holder,\n+                    skill: ctx.catalog.skill_name(dudef),\n+                    enabled: true,\n+                });\n+            }\n+        }\n+    }\n+    // 积财门控（Boss 饕餮，规则 v216）：体力首次≤一半激活（隐贼/延妒\n+    // 同款 enable 直写）\n+    if let Some(jdef) = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::names::BOSS_JICAI)\n+    {\n+        let holder = d.target;\n+        if ctx.core.has_skill_any_state(holder, jdef) && !ctx.core.has_skill(holder, jdef) {\n+            let p = ctx.core.player(holder);\n+            if p.hp > 0 && p.hp <= p.max_hp as i32 / 2 {\n+                if let Some(inst) = ctx.core.skills.get_mut(&(holder, jdef)) {\n+                    inst.enabled = true;\n+                }\n+                ctx.log(LogEvent::SkillToggled {\n+                    player: holder,\n+                    skill: ctx.catalog.skill_name(jdef),\n+                    enabled: true,\n+                });\n+            }\n+        }\n+    }\n+    // 催毒（Boss 书精，规则 v220）：来源持催毒且目标非己、无中毒 →\n+    // 目标授中毒实例（运行时授技=skills.insert；木神勾芒不在目录跳过\n+    // 联动摸牌；上游 boss_cuidui damageEnd addSkill 同口径）\n+    if let Some(cdef) = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::names::BOSS_CUIDUI)\n+    {\n+        let zdef = ctx\n+            .catalog\n+            .skill_by_name(crate::vocabulary::names::BOSS_ZHONGDU);\n+        if let (Some(src), Some(zd)) = (d.source, zdef) {\n+            if src != d.target\n+                && ctx.core.has_skill(src, cdef)\n+                && ctx.core.player(src).alive\n+                && ctx.core.player(d.target).alive\n+                && !ctx.core.has_skill_any_state(d.target, zd)\n+            {\n+                // 中毒标记技+蛇毒结算触发技一并授（上游 temp boss_zhongdu\n+                // +global boss_shedu 组合同批生效）\n+                for skdef in [\n+                    zd,\n+                    ctx.catalog\n+                        .skill_by_name(crate::vocabulary::names::BOSS_SHEDU)\n+                        .expect(\"蛇毒 def\"),\n+                ] {\n+                    ctx.core.skills.insert(\n+                        (d.target, skdef),\n+                        crate::state::SkillInstance {\n+                            owner: d.target,\n+                            enabled: true,\n+                            once_used: false,\n+                            expires_end_of_turn: false,\n+                            rounds: 0,\n+                        },\n+                    );\n+                    ctx.log(LogEvent::SkillToggled {\n+                        player: d.target,\n+                        skill: ctx.catalog.skill_name(skdef),\n+                        enabled: true,\n+                    });\n+                }\n+            }\n+        }\n+    }\n+    // 毒妒（Boss 相柳，规则 v223）：你受到伤害时来源获 1 蛇毒标记（自\n+    // 身不获；上游 boss_duqu damageEnd storage++ 同口径）\n+    if let Some(dddef) = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::names::BOSS_DUQU)\n+    {\n+        if ctx.core.has_skill(d.target, dddef) {\n+            if let Some(src) = d.source {\n+                if src != d.target && ctx.core.player(src).alive {\n+                    let p = ctx.core.player_mut(src);\n+                    p.shedu = p.shedu.saturating_add(1);\n+                }\n+            }\n+        }\n+    }\n+    // 邪酬门控（Boss 相柳，规则 v223）：体力首次≤一半激活（隐贼/延妒/\n+    // 积财/乱常同款 enable 直写）\n+    if let Some(edef) = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::names::BOSS_ECHOU)\n+    {\n+        let holder = d.target;\n+        if ctx.core.has_skill_any_state(holder, edef) && !ctx.core.has_skill(holder, edef) {\n+            let p = ctx.core.player(holder);\n+            if p.hp > 0 && p.hp <= p.max_hp as i32 / 2 {\n+                if let Some(inst) = ctx.core.skills.get_mut(&(holder, edef)) {\n+                    inst.enabled = true;\n+                }\n+                ctx.log(LogEvent::SkillToggled {\n+                    player: holder,\n+                    skill: ctx.catalog.skill_name(edef),\n+                    enabled: true,\n+                });\n+            }\n+        }\n+    }\n+    // 乱常门控（Boss 梼杌，规则 v218）：体力首次≤一半激活（隐贼/延妒/\n+    // 积财同款 enable 直写）\n+    if let Some(ldef) = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::names::BOSS_LUANCHANG)\n+    {\n+        let holder = d.target;\n+        if ctx.core.has_skill_any_state(holder, ldef) && !ctx.core.has_skill(holder, ldef) {\n+            let p = ctx.core.player(holder);\n+            if p.hp > 0 && p.hp <= p.max_hp as i32 / 2 {\n+                if let Some(inst) = ctx.core.skills.get_mut(&(holder, ldef)) {\n+                    inst.enabled = true;\n+                }\n+                ctx.log(LogEvent::SkillToggled {\n+                    player: holder,\n+                    skill: ctx.catalog.skill_name(ldef),\n+                    enabled: true,\n+                });\n+            }\n+        }\n+    }\n+    // 虚失门控（Boss 朱厌，规则 v225）：体力首次≤一半激活（隐贼/延妒/\n+    // 积财/乱常同款 enable 直写）\n+    if let Some(sdef) = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::names::BOSS_SIPU)\n+    {\n+        let holder = d.target;\n+        if ctx.core.has_skill_any_state(holder, sdef) && !ctx.core.has_skill(holder, sdef) {\n+            let p = ctx.core.player(holder);\n+            if p.hp > 0 && p.hp <= p.max_hp as i32 / 2 {\n+                if let Some(inst) = ctx.core.skills.get_mut(&(holder, sdef)) {\n+                    inst.enabled = true;\n+                }\n+                ctx.log(LogEvent::SkillToggled {\n+                    player: holder,\n+                    skill: ctx.catalog.skill_name(sdef),\n+                    enabled: true,\n+                });\n+            }\n+        }\n+    }\n+    if let Some(xdef) = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::names::BOSS_XUSHI)\n+    {\n+        let holder = d.target;\n+        if ctx.core.has_skill_any_state(holder, xdef) && !ctx.core.has_skill(holder, xdef) {\n+            let p = ctx.core.player(holder);\n+            if p.hp > 0 && p.hp <= p.max_hp as i32 / 2 {\n+                if let Some(inst) = ctx.core.skills.get_mut(&(holder, xdef)) {\n+                    inst.enabled = true;\n+                }\n+                ctx.log(LogEvent::SkillToggled {\n+                    player: holder,\n+                    skill: ctx.catalog.skill_name(xdef),\n+                    enabled: true,\n+                });\n+            }\n+        }\n+    }\n+    // 炎狱门控（Boss 毕方，规则 v229）：体力首次≤一半激活（隐贼/延妒/\n+    // 积财/乱常/虚失同款 enable 直写）\n+    if let Some(ydef) = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::names::BOSS_YANYU)\n+    {\n+        let holder = d.target;\n+        if ctx.core.has_skill_any_state(holder, ydef) && !ctx.core.has_skill(holder, ydef) {\n+            let p = ctx.core.player(holder);\n+            if p.hp > 0 && p.hp <= p.max_hp as i32 / 2 {\n+                if let Some(inst) = ctx.core.skills.get_mut(&(holder, ydef)) {\n+                    inst.enabled = true;\n+                }\n+                ctx.log(LogEvent::SkillToggled {\n+                    player: holder,\n+                    skill: ctx.catalog.skill_name(ydef),\n+                    enabled: true,\n+                });\n+            }\n+        }\n+    }\n+    // 冥顽锁定集（Boss 梼杌，规则 v219）：回合内自己使用牌对其他角色\n+    // 造成伤害后，受伤者入锁定集（首次同时记自己——上游 storage\n+    // boss_minwan=[player]+add(target) 同口径；回合更替自然清零）\n+    if let Some(mdef) = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::names::BOSS_MINWAN)\n+    {\n+        if let Some(src) = d.source {\n+            if src != d.target\n+                && ctx.core.turn.current == src\n+                && ctx.core.has_skill(src, mdef)\n+                && ctx.core.player(src).alive\n+            {\n+                let turn = &mut ctx.core.turn;\n+                if turn.minwan_targets.is_empty() {\n+                    turn.minwan_targets.push(src);\n+                }\n+                if !turn.minwan_targets.contains(&d.target) {\n+                    turn.minwan_targets.push(d.target);\n+                }\n+            }\n+        }\n+    }\n+\n+}\n+\n+/// 禳星·光（T11 Boss 诸葛亮族批 115，规则 v303）：持有「禳星」且星未\n+/// 归零（技能实例启用）时，任意体力变化后回满体力（上游 `hlss_xiangxing_hp`\n+/// 子技 changeHp/loseMaxHp/gainMaxHp → `hp = maxHp` 同口径；在伤害/失去\n+/// 体力提交点、濒死判定前调用，故星未耗尽者不会进入濒死）。\n+pub(crate) fn hlss_light_refill(ctx: &mut Ctx<'_>, player: PlayerId) {\n+    let Some(def) = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::host::HLSS_XIANGXING_KEY)\n+    else {\n+        return;\n+    };\n+    let p = ctx.core.player_mut(player);\n+    if !p.alive || p.hp >= p.max_hp as i32 {\n+        return;\n+    }\n+    let enabled = ctx\n+        .core\n+        .skills\n+        .get(&(player, def))\n+        .map(|i| i.enabled)\n+        .unwrap_or(false);\n+    if !enabled {\n+        return;\n+    }\n+    let max = ctx.core.player(player).max_hp as i32;\n+    ctx.core.player_mut(player).hp = max;\n+}\n+\n+/// 护天归还（swd 批 131，规则 v314）：把持有者寄存于目标处的牌归还目标，\n+/// 清理双方寄存状态（上游 `hutian3` 收束同口径）。\n+pub(crate) fn hutian_return_deposit(ctx: &mut Ctx<'_>, owner: PlayerId) {\n+    let Some(target) = ctx.core.player_mut(owner).hutian_deposit.take() else {\n+        return;\n+    };\n+    let cards = std::mem::take(&mut ctx.core.player_mut(target).hutian_hold);\n+    ctx.core.player_mut(target).hutian_owner = None;\n+    if !cards.is_empty() {\n+        for c in cards.iter().copied() {\n+            ctx.core.player_mut(target).hand.push(c);\n+        }\n+        ctx.log(LogEvent::CardsGiven {\n+            from: owner,\n+            to: target,\n+            cards,\n+        });\n+    }\n+    ctx.core.player_mut(owner).hutian_just_given = false;\n+}\n+\n+/// 失去体力提交（逐技对照批三 v77）：直接扣减体力——不经护甲抵扣、\n+/// 无伤害前置窗口/铁索传导/伤害来源触发技（LoseHp 是独立事件种）；\n+/// 体力 ≤0 与伤害同口径进入濒死（上游 loseHp 语义）。\n+pub(crate) fn commit_lose_hp(ctx: &mut Ctx<'_>, player: PlayerId, mut amount: u32) {\n+    if amount == 0 {\n+        return;\n+    }\n+    // 护天护体（swd 批 131，规则 v314）：失去体力同样以「体力降至寄存数」\n+    // 为上限（上游 hutian2 loseHpBegin 同口径）\n+    {\n+        let hold = ctx.core.player(player).hutian_hold.len() as i32;\n+        if hold > 0 {\n+            let hp = ctx.core.player(player).hp;\n+            let cap = hp - hold;\n+            if cap < amount as i32 {\n+                amount = cap.max(0) as u32;\n+            }\n+        }\n+    }\n+    if amount == 0 {\n+        ctx.log(LogEvent::HpLost { player, amount: 0 });\n+        return;\n+    }\n+    let p = ctx.core.player_mut(player);\n+    if !p.infinite_hp() {\n+        p.hp -= amount as i32;\n+    }\n+    hlss_light_refill(ctx, player);\n+    ctx.log(LogEvent::HpLost { player, amount });\n+    let entering = ctx.core.player(player).hp <= 0 && !ctx.core.player(player).dying;\n+    if entering {\n+        ctx.core.player_mut(player).dying = true;\n+        ctx.log(LogEvent::DyingEntered { player });\n+        ctx.emit(EventData::Dying {\n+            player,\n+            source: None,\n+        });\n+    }\n+    // 伤逝（规则 v260）：体力变化（失去）后补牌\n+    shangshix_draw(ctx, player);\n+}\n+\n+/// 伤逝（Boss 张春华，规则 v260）补牌半：\n+pub(super) fn shangshix_draw(ctx: &mut Ctx<'_>, player: PlayerId) {\n+    if let Some(ssdef) = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::names::BOSS_SHANGSHIX)\n+    {\n+        if ctx.core.player(player).alive && ctx.core.has_skill(player, ssdef) {\n+            let n = ctx.core.player(player).hand.len();\n+            if n < 4 {\n+                ctx.draw_cards(player, 4 - n);\n+            }\n+        }\n+    }\n+}\n+\n+fn finish_damage(ctx: &mut Ctx<'_>, root: EventId, mut d: crate::event::DamageData, outcome: crate::event::DamageOutcome) {\n+    d.settlement.outcome = outcome;\n+    d.settlement.progress = if outcome == crate::event::DamageOutcome::Zero { crate::event::DamageProgress::ZeroPending } else { crate::event::DamageProgress::Stopped };\n+    ctx.res.frame_mut(root).expect(\"damage root\").data = EventData::Damage(d);\n+}"},{"sha":"f8a3d1c99254d0ecf0a855ba7db93e154e0751ad","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20-v2/changed-source.tar.gz","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v2%2Fchanged-source.tar.gz","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v2%2Fchanged-source.tar.gz","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v2%2Fchanged-source.tar.gz?ref=34e83f0550bb70ef4af6083697428de7be2f02f8"},{"sha":"ea47ccb89e9a51060dcdbdc9bd2a8c3e84074ba2","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20-v3-result.json","status":"added","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3-result.json","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3-result.json","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3-result.json?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1 @@\n+{\"path\": \"/private/var/folders/b5/2mh_j5tj7m71xhcjsk2z1t4c0000gn/T/noname-c331-phase7-ktqqj1fb/evidence/phase9b/checkpoint20-v3\", \"changed_files\": 27, \"manifest_sha256\": \"7b05dc499dc317c8999d58bad69ed7287351d0cc63528324325f598da0867f98\", \"tar_sha256\": \"d8e0c4354158a921c8ac6199a69fe030cc86a9f512105f7dc091a8d789b01246\", \"patch_sha256\": \"276800a90f169da46d92d637a25b820d3f27cfd0f71046f09c6295919f33227a\"}"},{"sha":"3825e0ead69750b405be9891a2572e34b9debe2a","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20-v3/baseline-changed/crates/engine-native-content/src/content/standard/boss_skills.rs","status":"added","additions":1128,"deletions":0,"changes":1128,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-content%2Fsrc%2Fcontent%2Fstandard%2Fboss_skills.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-content%2Fsrc%2Fcontent%2Fstandard%2Fboss_skills.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-content%2Fsrc%2Fcontent%2Fstandard%2Fboss_skills.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1,1128 @@\n+use super::*;\n+mod boss_host;\n+\n+pub(super) fn skills() -> Vec<SkillDef> {\n+    let mut skills = vec![\n+        SkillDef {\n+            name: BOSS_XIONGSHOU,\n+            // 权限型能力三面：杀伤条件臂（kernel emit_sha_damage）、\n+            // computed_distance 距离 -1（state）、翻面取消（commit 入口\n+            // 直读跳过——死亡取消型同款），均经 skill_by_name 查询\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_WUZANG,\n+            // 权限型能力两面：摸牌阶段额外量与手牌上限基数归零，均在\n+            // kernel 阶段臂经 skill_by_name 查询\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_XIANGDE,\n+            // 伤害前置触发：来源有武器对持有者伤害 +1（机器一步直改\n+            // 载荷，YiShang 同款窗口）\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::DamageBefore,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: Vec::new(),\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(XiangDeBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_YINZEI,\n+            // 权限型两面：激活门控与伤害后弃牌在 commit_damage/\n+            // commit_lose_hp 尾经 skill_by_name 查询（激活=SkillInstance\n+            // .enabled 直写，初始装配即未激活）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_ZHUE,\n+            // 权限型单面：global damageEnd 双摸在 commit_damage 尾经\n+            // skill_by_name 查询\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_FUTAI,\n+            // 准备阶段触发（判定阶段开始锚点，神智同口径）：全体受伤\n+            // 者按座位序各回 1（机器一步，无挂起；锁定=forced 无确认）\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::PhaseBegin,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: Vec::new(),\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(FutaiBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_YANDU,\n+            // 权限型两面：激活门控（commit_damage 尾，隐贼先例同构）与\n+            // 他人结束阶段获得牌（kernel Phase::End 臂）均经 skill_by_name\n+            // 查询；装配即未激活\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_TANYU,\n+            // 权限型两面：跳过弃牌阶段（kernel Phase::Discard 臂直查）\n+            // 与结束阶段全场最多手牌失 1 体（Phase::End 臂）均经\n+            // skill_by_name 查询\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_CANGMU,\n+            // 权限型单面：摸牌基数=存活角色数（kernel Draw 臂，无脏同位）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_JICAI,\n+            // 权限型两面：激活门控（commit_damage 尾，延妒并列）与回复\n+            // 后双摸（commit_recover 新臂）均经 skill_by_name 查询；装配\n+            // 即未激活\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_NITAI,\n+            // 权限型两面：回合内受伤防止与回合外火伤 +1 均在\n+            // commit_damage 内联经 skill_by_name 查询\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_LUANCHANG,\n+            // 两面：准备阶段（判定阶段开始锚点）视为用【南蛮入侵】（触\n+            // 发机一步 use_virtual_card）；结束阶段视为用【万箭齐发】\n+            // （kernel Phase::End 臂查询式）；激活门控同隐贼/延妒/积财\n+            // 先例（装配即未启用）\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::PhaseBegin,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: Vec::new(),\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(LuanChangBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_MINWAN,\n+            // 权限型三面：伤害后锁定集（commit_damage 尾）、每用牌摸 1\n+            //（commit_card_used 尾）、PlayCard 目标校验（engine 校验段）\n+            // 均经 skill_by_name 查询；锁定集=TurnState.minwan_targets\n+            //（回合级，更替自然清零）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_CUIDUI,\n+            // 权限型单面：伤害后授毒（commit_damage 尾经 skill_by_name\n+            // 查询）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_ZHONGDU,\n+            // 中毒（运行时授技）：回合开始判定（commit_phase Judge begin\n+            // 段内联 draw_judge_card，铁骑式确定性判定）——非红桃伤 1、\n+            // 非黑桃失去此技（实例移除）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_YAOSHOU,\n+            // 权限型单面：computed_distance 距离 -2（state 距离链，凶兽\n+            // 同款）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_JIUSHOU,\n+            // 权限型三面：手牌上限恒 9（state hand_limit）、跳过摸牌与\n+            // 出牌/结束补至 9（kernel 阶段臂）均经 skill_by_name 查询\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_DUQU,\n+            // 权限型单面：受击者给来源加蛇毒标记（commit_damage 尾经\n+            // skill_by_name 查询；PlayerState.shedu 承载）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_ECHOU,\n+            // 权限型两面：激活门控（commit_damage 尾延妒并列）与他人桃\n+            // /酒获标记（commit_card_used）均经 skill_by_name 查询；装配\n+            // 即未激活\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_SHEDU,\n+            // 蛇毒标记结算（运行时触发技）：Judge begin 持有标记>0 →\n+            // 「弃 X 张牌或失去 X 体力」（挂起选择；取消/空选=失 X）→\n+            // 标记-1；X=当前标记数\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::PhaseBegin,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: Vec::new(),\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(ShedUBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_BINGXIAN,\n+            // 权限型单面：他人回合未出杀 → 结束阶段虚拟杀（kernel\n+            // Phase::End 臂，乱常万箭同款 use_virtual_card）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_XUSHI,\n+            // 权限型两面：出牌阶段结束自翻面（commit_phase Play begin:\n+            // false 臂）与翻回正面全场伤 1（commit_turn_over_before 尾）\n+            // 均经 skill_by_name 查询；激活门控同隐贼先例（装配即未激活）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_JUYUAN,\n+            // 权限型两面：回合结束体力记录（kernel Phase::End 臂）与杀\n+            // 目标 mod（engine max_targets）均经 skill_by_name 查询；\n+            // juyuan_storage=PlayerState 跨回合持久字段\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_ZHAOHUO,\n+            // 两面：造成伤害视为火（DamageBefore 触发机一步直改 nature\n+            // ——相德同款窗口）；免疫火伤（commit_damage 入口直读——拟\n+            // 态回合内免伤同位）\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::DamageBefore,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: Vec::new(),\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(ZhaoHuoBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_HONGLIANX,\n+            // 权限型两面：红色不计上限+弃牌阶段红牌不可弃（hand_limit\n+            // 与 Discard 臂查询）；回合开始获红牌/对至多 3 名各 1 火伤\n+            // （Judge begin 段内联，确定性近似登记）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_YANYU,\n+            // 权限型两面：激活门控（commit_damage 尾第八并列臂）与判定\n+            // 红色火伤（kernel Judge begin 段内联，回合计数至多 3）均经\n+            // skill_by_name 查询；装配即未激活\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_FENGDONG,\n+            // 权限型两面：回合开始他人获封印（Judge begin 段内联，神智\n+            // 锚）与回合结束全清（Phase::End 臂）经 skill_by_name 查询；\n+            // PlayCard 手牌校验（engine 校验段）禁用封印者手牌\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_XUNYOU,\n+            // 权限型单面：他人回合开始获得座位序首名有手牌者一张手牌\n+            //（Judge begin 段内联，确定性近似；装备牌自动使用=直接装上）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_SIPU,\n+            // 权限型两面：激活门控（commit_damage 尾第九并列臂；装配即\n+            // 未激活）与响应/救禁（respond_shan、dying_save 选项排除）\n+            // 均经 skill_by_name 查询；使用面由回合模型天然承载；无懈等\n+            // 其余响应窗未纳入禁令（登记差异）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_SHENYI,\n+            // 查询型两面：翻面取消（commit_turn_over_before 臂——凶兽\n+            // 同位，仅正→背取消）与判定阶段延时锦囊无效化（apply_\n+            // judgement 逐臂条件）均经 skill_by_name 查询；洪荒之力禁\n+            // 用交互未落（登记差异）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_RELEIJI,\n+            // 查询型单面：杀/万箭闪消费位内联臂（releiji_on_shan）经\n+            // skill_by_name 查询；青木链见 BOSS_QINGMU2/2X（v292）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_KUANGXIAO,\n+            // 查询型两面：杀无距离（engine sha_range_free 链追加）与目\n+            // 标数无限（engine kuangxiao_inf 臂，天弦同构）均经 skill_\n+            // by_name 查询；友方禁指面登记差异（关系网边界）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_FENTIAN,\n+            // 火改写面=ZhaoHuoBehavior 同构复用（数据less nature 改写，\n+            // 快照变体共用 BossZhaohuo——机器不携带技能身份，恢复路径按\n+            // 技能表重挂）；其余为查询面（engine 红牌免次数/免距离、\n+            // kernel 红杀跳八卦）；wuxie 禁面登记差异未挂钩\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::DamageBefore,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: Vec::new(),\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(ZhaoHuoBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_LINGQU,\n+            // 查询型两面：受击摸 1+计数（commit_damage damageEnd 段）与\n+            // 大于 1 点伤害归零（commit_damage 入口臂）均经 skill_by_name\n+            // 查询；手牌上限 +X（hand_limit 查询+PlayerState.lingqu_count\n+            // 新字段）；玄麟=关卡流程面登记不落\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_SHENEN,\n+            // 全局光环查询型三面：engine sha/顺手距离链 boss 方豁免、\n+            // hand_limit 挑战者 +1（state）、Draw 臂挑战者 +1（kernel）\n+            // 均经 skill_by_name 查询+is_boss_side 判定；光环激活=场上\n+            // 存在持有者\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_XINGQIU,\n+            // 查询型单面：Play begin 臂（交替开关+横置敌方，direct 直写\n+            // linked+日志，索链甲同款）；授 boss_jiding 面登记差异未入库\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_BUCHUN,\n+            // 主动技两线（ActivateSkill 直调 activate——复活线/恢复线按\n+            // 场面分派；间隔门控读 buchun_used_round）；快照变体\n+            // BossBuchun（archive tag 66/机哈希 67）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(BuchunBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_HUIHUO,\n+            // 查询型两面：杀上限 +1（engine 限次臂 once_used 额度，元宝\n+            // 肉同款）与死亡反噬（kernel 死亡结算移除前捕获+PlayerDied\n+            // 后敌方 3 点火伤）均经 skill_by_name 查询\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_FURAN,\n+            // 查询型单面：濒死救援选项扩展（is_tao_like 臂——敌方红色\n+            // 牌可当桃救焰灵）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_XINGXIA,\n+            // 主动技（ActivateSkill 直调 activate——损焰灵线/追击线按\n+            // 挂起阶段推进；间隔门控读 xingxia_used_round）；快照变体\n+            // BossXingxia（archive tag 67/机哈希 68）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(XingxiaBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_JUEHONG,\n+            // 查询型单面：准备阶段臂（Judge begin 段——封冻同位；装备全\n+            // 弃撤技能+入弃堆，随机弃→首张确定性近似登记）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_QINGZHU,\n+            // 查询型两面：跳弃牌（Discard 臂——贪欲同位）+杀禁用（engine\n+            // 校验臂——获急叮解除）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_JIAZU,\n+            // 查询型单面：准备阶段臂（相邻敌方坐骑全弃）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_JIDING,\n+            // 查询型单面：damageEnd 臂（友方受伤→对敌方来源虚拟雷杀，\n+            // LeiSha kind 载体；蓐收加成尾面登记差异）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_ZAOYI,\n+            // 查询型三面：死亡触发（DeathMachine 移除后捕获+授技）、\n+            // targetEnabled 双门控（engine 校验）、造异异变授予（运行时\n+            // skills.insert，中毒/蛇毒先例）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_ZAOYI_HP,\n+            // 查询型单面（运行时授予）：回合开始敌方最低体力全体失去全\n+            // 部体力（Judge begin 臂）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_ZIRUN,\n+            // 查询型单面：准备阶段臂（Judge begin 段——全体摸牌：有装备\n+            // 2/无装备 1）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_NIANRUI,\n+            // 查询型单面：Draw 臂固定摸 2 后补摸 2（藏目同位）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_MENGTAI,\n+            // 查询型多面：准备置位/摸牌清位/出牌清位/结束补摸 3/弃牌闸门\n+            // （TurnState.mengtai_* 双旗标承载）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_NBIANSHEN,\n+            // 查询型单面：Judge begin 轮换臂（assembly 重挂+hp 保留；\n+            // versus 替补换将先例同构；确定性互斥轮转登记）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_RENXING,\n+            // 查询型双臂：damageEnd（commit_damage 段）+recoverEnd\n+            // （commit_recover_skills 头）——非当前回合摸 1\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_RUIZHI,\n+            // 查询型单面：准备阶段臂（global 修剪：其余角色保留 1 手+1\n+            // 装，弃其余——保留首张确定性近似登记）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_SHOUYI,\n+            // 查询型单面：sha_range_free 链+顺手距离链追加（全牌无距离，\n+            // 狂笑/神恩同位）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_DANSHU,\n+            // 查询型单面：CardsDiscarded 臂（失去手牌后非当前回合且已受\n+            // 伤判定红回 1）——夜叉批条目复用同名 def\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_JINGJUE,\n+            // 查询型单面：继承胆术（同内容共用 commit 臂按名双查）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_MODAO,\n+            // 查询型单面：Judge begin 臂自摸 2（藏目/年瑞同位）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_MOJIAN,\n+            // 查询型单面：Play begin 臂虚拟万箭（乱常 End 臂同款\n+            // use_virtual_card；异侧存活全目标）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_YUSHOU,\n+            // 查询型单面：Play begin 臂虚拟南蛮（魔剑同款 use_virtual_card）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_MOYANY,\n+            // 查询型单面：CardsDiscarded 臂（非当前回合判定红→2 火伤打\n+            // 座位序首个其他存活——确定性近似登记）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_BAOLIAN,\n+            // 查询型单面：End 臂摸 2\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_QIANGZHENG,\n+            // 查询型单面：End 臂——每名其他有手牌角色随机一张→首张确定\n+            // 性近似登记，获得至手牌\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_ZUIJIU,\n+            // 查询型单面：commit_damage 臂——source sha 伤害 +1\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_XIAOSHOU,\n+            // 查询型单面：End 臂——座位序首个 hp≥self 其他存活受 3 伤害\n+            // （目标自选可放弃→恒发动确定性近似登记）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_GUIJI,\n+            // 查询型单面：Judge begin 臂弃自己判定区首张（随机→首张近似）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_TAIPING,\n+            // 查询型单面：Draw 臂 +2（年瑞同位）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_SUOMING,\n+            // 查询型单面：End 臂——全部未链接异侧存活横置（链接机直写+\n+            // Linked 日志，[1,num] 自选→全部确定性近似登记）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_XIXING,\n+            // 查询型单面：Judge begin 臂——座位序首个已链接异侧受 1 雷伤\n+            // +持有者回 1（目标自选→首个已链接确定性近似登记）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_LIANYU,\n+            // 查询型单面：End 臂——全部其他存活各 1 火伤（无询问直伤）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_JUECE,\n+            // 查询型单面：CardsDiscarded 臂——自己回合内其他角色失去最后\n+            // 一手牌（弃后空手）→ 1 伤害（chooseBool AI→恒发动近似登记）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_JIUCHI,\n+            // 查询型单面：PlayCard kind 改写臂（黑桃手牌→酒，viewAs 转化\n+            // 武圣/奇袭同族）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_GUIMOU,\n+            // 查询型单面：End begin 臂——座位序首个其他未混乱存活角色\n+            // boss_mad 置位（其回合收束解除；随机→首个确定性近似登记）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_YUANCE,\n+            // 查询型单面：Damage commit 尾臂——来源≠受伤者且双方存活 →\n+            // 判定（选项一恒定：黑→受伤者失 1 / 红→来源失 1；chooseControl\n+            // AI 态度面→恒选项一确定性近似登记）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_QIZUO,\n+            // CardUsed AfterTriggers 触发：锦囊复用一步机（QizuoBehavior\n+            // 门=无懈/铁索排除+延时同名去重+原目标存活；载体槽守卫递归）\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::CardUsed,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: Vec::new(),\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(QizuoBehavior),\n+        },\n+        SkillDef {\n+            name: JUE_QING,\n+            // 查询型单面：commit_damage 入口直读臂（急冻前——上游\n+            // damageBefore 层）——来源伤害改为目标失去等量体力\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_WUXIN,\n+            // 查询型双面：commit_damage 入口直读臂（受伤→失 1）+\n+            // PlayCard 校验臂（乐/兵拒——延时禁指定他人）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_SHANGSHIX,\n+            // 查询型双面：四 commit 臂补牌（CardsDiscarded/Damage/LoseHp/\n+            // Recover——手牌<4 补至 4）+ End begin 臂（hp>1 全体各失 1）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_XIAOXIONG,\n+            // CardUsed AfterTriggers 触发：副本入手一步机（XiaoxiongBehavior\n+            // 门=他人使用+基本/锦囊白名单；End begin 臂=子技未用牌伤害）\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::CardUsed,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: Vec::new(),\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(XiaoxiongBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_ZHANGWU,\n+            // 查询型单面：Damage commit 尾臂（damageEnd 族）——持有者弃 1\n+            // 张+来源弃 1 张或受 1 伤害（双方恒弃首张确定性近似登记）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_LINGBO,\n+            // CardResponded+CardUsed 触发：打出/使用闪后摸 2 一步机\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::CardResponded,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: vec![EventKind::CardUsed],\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(LingboBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_JIAOXIA,\n+            // 查询型单面：CardUsed commit 臂——成为红色牌目标后摸 1\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_FANGHUA,\n+            // 查询型单面：End begin 臂——存在翻面角色则全部各失 1\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_TASHUI,\n+            // CardResponded+CardUsed 触发：打出/使用黑牌后翻面一步机\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::CardResponded,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: vec![EventKind::CardUsed],\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(TashuiBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_HUOSHEN,\n+            // 查询型单面：commit_damage 火伤分支直读臂（招祸同位扩展——\n+            // 免疫火伤+回复 1）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_ZYHONGLIAN,\n+            // 查询型单面：End begin 臂——摸 2+全部其他存活各 1 火伤\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_XIANYIN,\n+            // 查询型单面：CardsDiscarded 臂（非当前回合）——判定红→座位\n+            // 序首个其他存活失 1（chooseTarget AI→首个确定性近似登记）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_TIANDAO,\n+            // 查询型单面：改判机 rewriters 扩展（hes 任意牌改判+获得原判\n+            // 定牌）——JudgePhase 机器内联，无独立触发\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_ZJLEIJI,\n+            // CardResponded+CardUsed 触发：打出/使用【闪】后一步机（首个\n+            // 其他存活判定黑→1 雷伤+摸 1）\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::CardResponded,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: vec![EventKind::CardUsed],\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(ZjLeijiBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_JIDIAN,\n+            // 查询型单面：Damage commit 尾臂——距受伤者 ≤1 的首个其他存\n+            // 活判定黑→1 雷伤（链挡旗标不自我递归=登记差异）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_ZHIWANG,\n+            // 查询型单面：CardsMoved commit 臂——其他角色获得牌（非摸牌\n+            // 阶段摸牌，CardsDrawn 天然隔离）→其弃首张手牌\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_GONGZHENG,\n+            // 查询型单面：Judge begin 臂——判定区有牌则弃首张（鬼计同款）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_XUECHI,\n+            // 查询型单面：End begin 臂——座位序首个其他存活失 2（随机→\n+            // 首个确定性近似登记）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_HEISHENG,\n+            // Death 触发（死亡前置窗口=遗言面）：全体其他横置一步机\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::Death,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: Vec::new(),\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(HeishengBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_SHENGFU,\n+            // 查询型单面：End begin 臂——首个有坐骑的其他存活弃其一\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_LEIZHOU,\n+            // 查询型单面：Judge begin 臂——首个其他存活 1 雷伤\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_LEIFU,\n+            // 查询型单面：End begin 臂——首个其他存活横置态切换\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_LEIZHU,\n+            // Death 触发（遗言面，黑绳同位）：座位序逐发雷伤\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::Death,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: Vec::new(),\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(LeizhuBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_FUDU,\n+            // 查询型单面：CardUsed commit 臂——他人用桃随机其他失 1\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_KUJIU,\n+            // 查询型单面：Judge begin 臂（global 扫持有者）——其他角色\n+            // 准备阶段失 1+视为用酒\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_RENAO,\n+            // Death 触发（遗言面，雷诛同位）：首发其他 3 火伤\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::Death,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: Vec::new(),\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(RenaoBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_LUNHUI,\n+            // 查询型单面：Judge begin 臂——hp≤2 与首个 hp>2 其他交换体力\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_WANGSHENG,\n+            // 查询型单面：Play begin 臂——恒定虚拟南蛮（全部其他存活）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_ZLFANSHI,\n+            // 查询型单面：Damage commit 尾臂——terra 旗交替+反噬 1 伤\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_SHIYOU,\n+            // 查询型单面：弃牌机 Done 前臂——弃牌阶段弃牌花色互异获得\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_WANGHUN,\n+            // Death 触发（遗言面）：清往事旗+前两个其他各禁用首个技\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::Death,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: Vec::new(),\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(WanghunBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_WANGSHI,\n+            // 查询型单面：Judge begin global 臂（恒定禁基本牌）+\n+            // PlayCard 拒绝位+回合结束全清\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_TIEMIAN,\n+            // 查询型单面：sha 机仁王块扩展（防具槽空视为仁王盾）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_ZHADAO,\n+            // 查询型单面：sha 机青釭穿透链扩展（来源持有者即穿透）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_ZHUXIN,\n+            // Death 触发（遗言面）：最低体力其他存活受 2 伤一步机\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::Death,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: Vec::new(),\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(ZhuxinBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_SUOZU,\n+            // 查询型单面：Prepare begin 臂——全部其他存活横置\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_ABI,\n+            // 查询型单面：Damage commit 尾臂——来源受 1 火伤（恒定火）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_PINGDENG,\n+            // Death 触发（遗言面）：最高体力两波火伤（2+1）两步机\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::Death,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: Vec::new(),\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(PingdengBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_REMEN,\n+            // 查询型单面：PlayCard 拒绝位（plain 杀）+AOE 机窗口前跳过\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_ZHIFEN,\n+            // 查询型单面：Prepare begin 臂——获得座位序首个其他首张手\n+            // 牌+其受 1 火伤（无来源）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_HUOXING,\n+            // Death 触发（遗言面）：全部其他存活逐座火伤机\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::Death,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: Vec::new(),\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(HuoxingBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_BUFO,\n+            // 查询型单面×2：伤害入口减 1（终值>1）+准备阶段距离 1 火伤\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_WULIANG,\n+            // 查询型单面×2：结束阶段摸 2+准备阶段体力<3 回复至 3\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_DITING,\n+            // 查询型单面：computed_distance 双向链（from -1 / to +1）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_WEIMU,\n+            // 查询型单面：黑锦囊 PlayCard 拒绝位+黑色 AOE 窗口前跳过\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_BINGFENG,\n+            // Death 触发（遗言面）：翻面来源一步机\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::Death,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: Vec::new(),\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(BingfengBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_PANGUAN,\n+            // 查询型单面：延时锦囊 PlayCard 拒绝位\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_JUHUN,\n+            // 查询型单面：End begin 臂——座位序首个其他翻面（恒定翻面）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_WANGXIANG,\n+            // Death 触发（遗言面）：全场装备全弃一步机\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::Death,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: Vec::new(),\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(WangxiangBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_TIANYU,\n+            // 查询型单面：End begin 臂——自横置先解除+全场未横置横置\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_QIWU,\n+            // 查询型单面：CardUsed commit 臂——梅花牌使用后受伤回复 1\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+    ];\n+    skills.extend(boss_host::skills());\n+    skills\n+}"},{"sha":"2d6dde0d939842e9c305c042443b85b8e5f9957a","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20-v3/baseline-changed/crates/engine-native-kernel/src/archive/damage.rs","status":"added","additions":73,"deletions":0,"changes":73,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Farchive%2Fdamage.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Farchive%2Fdamage.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Farchive%2Fdamage.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1,73 @@\n+//! Private106 damage settlement codec; old machine field layouts are unchanged.\n+use super::*;\n+use crate::event::{DamageOutcome as O, DamageProgress as P, DamageSettlement};\n+pub(super) fn enc_settlement(w: &mut W, s: &DamageSettlement) {\n+    enc_opt_u32(w, s.committed_damage);\n+    w.u32(s.hp_loss);\n+    w.u8(match s.outcome {\n+        O::Running => 0,\n+        O::Cancelled => 1,\n+        O::ReplacedByLoseHp => 2,\n+        O::Zero => 3,\n+        O::Completed => 4,\n+    });\n+    w.boolean(s.notrigger);\n+    let (tag, remaining) = match &s.progress {\n+        P::Before => (0, None),\n+        P::HpCommitted => (1, None),\n+        P::TargetDamage => (2, None),\n+        P::DyingPending => (3, None),\n+        P::DyingDone => (4, None),\n+        P::Source => (5, None),\n+        P::End => (6, None),\n+        P::After => (7, None),\n+        P::Chain { remaining } => (8, Some(remaining)),\n+        P::Done => (9, None),\n+        P::ZeroPending => (10, None),\n+        P::Stopped => (11, None),\n+    };\n+    w.u8(tag);\n+    if let Some(remaining) = remaining {\n+        w.len(remaining.len());\n+        for p in remaining {\n+            w.u8(*p);\n+        }\n+    }\n+}\n+pub(super) fn dec_settlement(r: &mut R<'_>) -> Result<DamageSettlement, ArchiveError> {\n+    let committed_damage = dec_opt_u32(r)?;\n+    let hp_loss = r.u32()?;\n+    let outcome = match r.u8()? {\n+        0 => O::Running,\n+        1 => O::Cancelled,\n+        2 => O::ReplacedByLoseHp,\n+        3 => O::Zero,\n+        4 => O::Completed,\n+        t => return Err(ArchiveError::BadTag(\"damage_outcome\", t)),\n+    };\n+    let notrigger = r.boolean()?;\n+    let progress = match r.u8()? {\n+        0 => P::Before,\n+        1 => P::HpCommitted,\n+        2 => P::TargetDamage,\n+        3 => P::DyingPending,\n+        4 => P::DyingDone,\n+        5 => P::Source,\n+        6 => P::End,\n+        7 => P::After,\n+        8 => P::Chain {\n+            remaining: r.vec(|r| r.u8())?,\n+        },\n+        9 => P::Done,\n+        10 => P::ZeroPending,\n+        11 => P::Stopped,\n+        t => return Err(ArchiveError::BadTag(\"damage_progress\", t)),\n+    };\n+    Ok(DamageSettlement {\n+        committed_damage,\n+        hp_loss,\n+        outcome,\n+        notrigger,\n+        progress,\n+    })\n+}"},{"sha":"52bf9d02af23304293f8d306b3a66c96117db9ba","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20-v3/baseline-changed/crates/engine-native-kernel/src/archive/values.rs","status":"added","additions":277,"deletions":0,"changes":277,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Farchive%2Fvalues.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Farchive%2Fvalues.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Farchive%2Fvalues.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1,277 @@\n+use super::*;\n+\n+// ---- 基础类型编码 ----\n+\n+pub(super) fn enc_opt_u32(w: &mut W, v: Option<u32>) {\n+    match v {\n+        Some(x) => {\n+            w.u8(1);\n+            w.u32(x);\n+        }\n+        None => w.u8(0),\n+    }\n+}\n+\n+pub(super) fn dec_opt_u32(r: &mut R<'_>) -> Result<Option<u32>, ArchiveError> {\n+    match r.u8()? {\n+        0 => Ok(None),\n+        1 => Ok(Some(r.u32()?)),\n+        t => Err(ArchiveError::BadTag(\"opt_u32\", t)),\n+    }\n+}\n+\n+/// PlayerId = u8。\n+pub(super) fn enc_pid(w: &mut W, v: &PlayerId) {\n+    w.u8(*v);\n+}\n+\n+pub(super) fn dec_pid(r: &mut R<'_>) -> Result<PlayerId, ArchiveError> {\n+    Ok(r.u8()?)\n+}\n+\n+/// Option<PlayerId>。\n+pub(super) fn enc_opt_pid(w: &mut W, v: &Option<PlayerId>) {\n+    match v {\n+        Some(x) => {\n+            w.u8(1);\n+            w.u8(*x);\n+        }\n+        None => w.u8(0),\n+    }\n+}\n+\n+pub(super) fn dec_opt_pid(r: &mut R<'_>) -> Result<Option<PlayerId>, ArchiveError> {\n+    match r.u8()? {\n+        0 => Ok(None),\n+        1 => Ok(Some(r.u8()?)),\n+        t => Err(ArchiveError::BadTag(\"opt_pid\", t)),\n+    }\n+}\n+\n+/// Vec<PlayerId>。\n+pub(super) fn enc_pids(w: &mut W, v: &[PlayerId]) {\n+    w.len(v.len());\n+    for p in v {\n+        w.u8(*p);\n+    }\n+}\n+\n+pub(super) fn dec_pids(r: &mut R<'_>) -> Result<Vec<PlayerId>, ArchiveError> {\n+    r.vec(|r| r.u8())\n+}\n+\n+/// SkillDefId = u16。\n+pub(super) fn enc_skill(w: &mut W, v: &SkillDefId) {\n+    w.u16(*v);\n+}\n+\n+pub(super) fn dec_skill(r: &mut R<'_>) -> Result<SkillDefId, ArchiveError> {\n+    Ok(r.u16()?)\n+}\n+\n+pub(super) fn enc_damage_nature(w: &mut W, v: &DamageNature) {\n+    w.u8(match v {\n+        DamageNature::Normal => 0,\n+        DamageNature::Fire => 1,\n+        DamageNature::Thunder => 2,\n+    });\n+}\n+\n+pub(super) fn dec_damage_nature(r: &mut R<'_>) -> Result<DamageNature, ArchiveError> {\n+    Ok(match r.u8()? {\n+        0 => DamageNature::Normal,\n+        1 => DamageNature::Fire,\n+        2 => DamageNature::Thunder,\n+        t => return Err(ArchiveError::BadTag(\"damage_nature\", t)),\n+    })\n+}\n+\n+pub(super) fn enc_phase(w: &mut W, v: &Phase) {\n+    w.u8(match v {\n+        Phase::Judge => 0,\n+        Phase::Draw => 1,\n+        Phase::Play => 2,\n+        Phase::Discard => 3,\n+        Phase::End => 4,\n+    });\n+}\n+\n+pub(super) fn dec_phase(r: &mut R<'_>) -> Result<Phase, ArchiveError> {\n+    Ok(match r.u8()? {\n+        0 => Phase::Judge,\n+        1 => Phase::Draw,\n+        2 => Phase::Play,\n+        3 => Phase::Discard,\n+        4 => Phase::End,\n+        t => return Err(ArchiveError::BadTag(\"phase\", t)),\n+    })\n+}\n+\n+pub(super) fn enc_event_kind(w: &mut W, v: &EventKind) {\n+    use EventKind::*;\n+    let t = match v {\n+        DamageBefore => 0u8,\n+        Damage => 1,\n+        Recover => 2,\n+        CardsDrawn => 3,\n+        CardsMoved => 4,\n+        CardUsed => 5,\n+        CardResponded => 6,\n+        Dying => 7,\n+        Death => 8,\n+        PhaseBegin => 9,\n+        PhaseEnd => 10,\n+        TurnEnded => 11,\n+        SkillToggled => 12,\n+        Equipped => 13,\n+        Linked => 14,\n+        CardsDiscarded => 15,\n+        TurnOverBefore => 16,\n+        TurnOvered => 17,\n+        LoseHp => 18,\n+        DyingSaved => 19,\n+        CardsLost => 20,\n+        ShaDodged => 21,\n+        CardsGiven => 22,\n+        DamageSource => 23, DamageEnd => 24, DamageAfter => 25, DamageZero => 26, DamageCancelled => 27,\n+    };\n+    w.u8(t);\n+}\n+\n+pub(super) fn dec_event_kind(r: &mut R<'_>) -> Result<EventKind, ArchiveError> {\n+    use EventKind::*;\n+    Ok(match r.u8()? {\n+        0 => DamageBefore,\n+        1 => Damage,\n+        2 => Recover,\n+        3 => CardsDrawn,\n+        4 => CardsMoved,\n+        5 => CardUsed,\n+        6 => CardResponded,\n+        7 => Dying,\n+        8 => Death,\n+        9 => PhaseBegin,\n+        10 => PhaseEnd,\n+        11 => TurnEnded,\n+        12 => SkillToggled,\n+        13 => Equipped,\n+        14 => Linked,\n+        15 => CardsDiscarded,\n+        16 => TurnOverBefore,\n+        17 => TurnOvered,\n+        18 => LoseHp,\n+        19 => DyingSaved,\n+        20 => CardsLost,\n+        21 => ShaDodged,\n+        22 => CardsGiven,\n+        23 => DamageSource,24 => DamageEnd,25 => DamageAfter,26 => DamageZero,27 => DamageCancelled,\n+        t => return Err(ArchiveError::BadTag(\"event_kind\", t)),\n+    })\n+}\n+\n+pub(super) fn enc_stage(w: &mut W, v: &Stage) {\n+    w.u8(match v {\n+        Stage::BeforeTriggers => 0,\n+        Stage::Commit => 1,\n+        Stage::AfterTriggers => 2,\n+        Stage::Intrinsic => 3,\n+        Stage::Done => 4,\n+    });\n+}\n+\n+pub(super) fn dec_stage(r: &mut R<'_>) -> Result<Stage, ArchiveError> {\n+    Ok(match r.u8()? {\n+        0 => Stage::BeforeTriggers,\n+        1 => Stage::Commit,\n+        2 => Stage::AfterTriggers,\n+        3 => Stage::Intrinsic,\n+        4 => Stage::Done,\n+        t => return Err(ArchiveError::BadTag(\"stage\", t)),\n+    })\n+}\n+\n+pub(super) fn enc_role(w: &mut W, v: &Role) {\n+    w.u8(match v {\n+        Role::Lord => 0,\n+        Role::Loyalist => 1,\n+        Role::Rebel => 2,\n+        Role::Traitor => 3,\n+    });\n+}\n+\n+pub(super) fn dec_role(r: &mut R<'_>) -> Result<Role, ArchiveError> {\n+    Ok(match r.u8()? {\n+        0 => Role::Lord,\n+        1 => Role::Loyalist,\n+        2 => Role::Rebel,\n+        3 => Role::Traitor,\n+        t => return Err(ArchiveError::BadTag(\"role\", t)),\n+    })\n+}\n+\n+pub(super) fn enc_faction(w: &mut W, f: &crate::catalog::Faction) {\n+    w.u8(match f {\n+        crate::catalog::Faction::Wei => 0,\n+        crate::catalog::Faction::Shu => 1,\n+        crate::catalog::Faction::Wu => 2,\n+        crate::catalog::Faction::Qun => 3,\n+    });\n+}\n+\n+pub(super) fn dec_faction(r: &mut R<'_>) -> Result<crate::catalog::Faction, ArchiveError> {\n+    Ok(match r.u8()? {\n+        0 => crate::catalog::Faction::Wei,\n+        1 => crate::catalog::Faction::Shu,\n+        2 => crate::catalog::Faction::Wu,\n+        3 => crate::catalog::Faction::Qun,\n+        t => return Err(ArchiveError::BadTag(\"faction\", t)),\n+    })\n+}\n+\n+pub(super) fn enc_winner(w: &mut W, v: &Winner) {\n+    match v {\n+        Winner::Player(p) => {\n+            w.u8(0);\n+            w.u8(*p);\n+        }\n+        Winner::LordSide => w.u8(1),\n+        Winner::Rebels => w.u8(2),\n+        Winner::Traitor => w.u8(3),\n+        // P0 解码加固：势力编码走显式表（与 dec_faction 同源），避免\n+        // `*f as u8` 依赖枚举声明顺序——重排/增删势力不再静默错位。\n+        Winner::Faction(f) => {\n+            w.u8(4);\n+            enc_faction(w, f);\n+        }\n+        Winner::Versus(t) => {\n+            w.u8(5);\n+            w.u8(*t as u8);\n+        }\n+        Winner::Doudizhu { lord_won } => {\n+            w.u8(6);\n+            w.boolean(*lord_won);\n+        }\n+        Winner::Boss { boss_won } => {\n+            w.u8(7);\n+            w.boolean(*boss_won);\n+        }\n+    }\n+}\n+\n+pub(super) fn dec_winner(r: &mut R<'_>) -> Result<Winner, ArchiveError> {\n+    Ok(match r.u8()? {\n+        0 => Winner::Player(r.u8()?),\n+        1 => Winner::LordSide,\n+        2 => Winner::Rebels,\n+        3 => Winner::Traitor,\n+        4 => Winner::Faction(dec_faction(r)?),\n+        5 => Winner::Versus(r.u8()? as usize),\n+        6 => Winner::Doudizhu {\n+            lord_won: r.boolean()?,\n+        },\n+        7 => Winner::Boss {\n+            boss_won: r.boolean()?,\n+        },\n+        t => return Err(ArchiveError::BadTag(\"winner\", t)),\n+    })\n+}"},{"sha":"64ca5bcd8bf76d05e9e0289af0202b5a1c2106d9","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20-v3/baseline-changed/crates/engine-native-kernel/src/event.rs","status":"added","additions":379,"deletions":0,"changes":379,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fevent.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fevent.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fevent.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1,379 @@\n+//! 事件模型：显式事件栈的帧。\n+//!\n+//! 与旧实现的差别：事件嵌套是一棵真实的栈（父/子/返回值都在帧上），\n+//! 不再是「单槽恢复 + 三个延迟队列」；帧载荷是类型化的 `EventData`，\n+//! 技能可以在结算窗口内改写帧载荷（如伤害转移）。\n+\n+use crate::ids::{CardId, EventId, PlayerId, SkillDefId};\n+mod damage;\n+pub use damage::*;\n+\n+/// 触发唤醒用的事件类别。\n+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash)]\n+pub enum EventKind {\n+    DamageBefore,\n+    Damage,\n+    Recover,\n+    CardsDrawn,\n+    CardsMoved,\n+    CardUsed,\n+    CardResponded,\n+    Dying,\n+    Death,\n+    PhaseBegin,\n+    PhaseEnd,\n+    TurnEnded,\n+    SkillToggled,\n+    Equipped,\n+    Linked,\n+    CardsDiscarded,\n+    TurnOverBefore,\n+    TurnOvered,\n+    LoseHp,\n+    /// 濒死救回（U05 xianjian 焚逝挂点，规则 v157）：固有救援机在\n+    /// 体力>0 且脱离濒死时发射（上游 dyingAfter 时序等价）。\n+    DyingSaved,\n+    /// 失去牌（swd 批 125，规则 v312）：手牌被弃置/交出或装备被取走时\n+    /// 发射（上游 `loseEnd` 触发窗；装备替换过程不发——上游 `equiping`\n+    /// 期过滤同口径）。\n+    CardsLost,\n+    /// 杀被闪避（swd 批 141，规则 v316 同批）：目标成功闪避【杀】时发射\n+    /// （上游 `shaMiss` 触发窗；用于李香龙等「杀被闪后反击」类技能）。\n+    ShaDodged,\n+    /// 手牌直接给予另一角色（NC04 未映射事件批）：`give_hand_card` 共享\n+    /// 原语发射；DSL `cards_given` 触发窗（旧线 EventKind 同名同义）。\n+    CardsGiven,\n+    DamageSource,\n+    DamageEnd,\n+    DamageAfter,\n+    DamageZero,\n+    DamageCancelled,\n+}\n+\n+/// 失去牌的来源区（`CardsLost` 载荷；上游 `card.original`）。\n+#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n+pub enum LostOrigin {\n+    Hand,\n+    Equip,\n+    Judge,\n+}\n+\n+/// 伤害属性：普通 / 火 / 雷。属性伤害触发铁索连环传导。\n+#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n+pub enum DamageNature {\n+    Normal,\n+    Fire,\n+    Thunder,\n+}\n+\n+/// 伤害事件载荷：结算窗口内可被技能改写（转移/防止）。\n+#[derive(Debug, Clone, PartialEq, Eq)]\n+pub struct DamageData {\n+    pub source: Option<PlayerId>,\n+    /// 当前承受者——转移技能改写此字段。\n+    pub target: PlayerId,\n+    pub amount: i32,\n+    /// One canonical submission and continuation authority.\n+    pub settlement: DamageSettlement,\n+    pub nature: DamageNature,\n+    /// 防止类技能改写此字段；提交阶段读到 true 则不扣血。\n+    pub prevented: bool,\n+    /// 转移链记录：原始承受者 -> …… -> 最终承受者。\n+    pub redirect_chain: Vec<PlayerId>,\n+    /// 造成伤害的牌（奸雄/遗计类技能依赖；非牌类伤害为 None）。\n+    pub card: Option<CardId>,\n+    /// 铁索连环传导伤害（ow 源氏飞刃 notLink 过滤依赖；主伤害为\n+    /// false——上游 event.notLink() 同口径，规则 v129）。\n+    pub from_chain: bool,\n+}\n+\n+#[derive(Debug, Clone, PartialEq, Eq)]\n+pub struct CardUseData {\n+    pub card: CardId,\n+    pub player: PlayerId,\n+    pub targets: Vec<PlayerId>,\n+    /// 杀的属性（仅 Sha/FireSha 有意义）。\n+    pub nature: DamageNature,\n+    /// view-as 转化声明（武圣/龙胆）：以此牌种结算而非目录牌种。\n+    pub use_as: Option<crate::catalog::CardKind>,\n+    /// E03 使用前取消（猴子偷桃）：确认后由窗口机器执行夺桃并把本位\n+    /// 置真；提交阶段读到真值即跳过结算。不入 canonical_hash（取消的\n+    /// 最终状态——牌的位置与体力——已可观测）。\n+    pub cancelled: bool,\n+}\n+\n+/// 类型化事件载荷。\n+#[derive(Debug, Clone, PartialEq, Eq)]\n+pub enum EventData {\n+    /// E03 翻面前置窗口（漩涡面具等锁定技可取消）。\n+    TurnOverBefore {\n+        player: PlayerId,\n+        cancelled: bool,\n+    },\n+    /// E03 翻面完成。\n+    TurnOvered {\n+        player: PlayerId,\n+        face_down: bool,\n+    },\n+    Damage(DamageData),\n+    /// A real child window referencing its canonical damage ancestor.\n+    DamageWindow { root: EventId, window: DamageWindowKind },\n+    Recover {\n+        player: PlayerId,\n+        amount: u32,\n+        by_card: Option<CardId>,\n+    },\n+    CardsDrawn {\n+        player: PlayerId,\n+        cards: Vec<CardId>,\n+    },\n+    CardsMoved {\n+        cards: Vec<CardId>,\n+        from: PlayerId,\n+        to: PlayerId,\n+    },\n+    CardUsed(CardUseData),\n+    CardResponded {\n+        card: CardId,\n+        player: PlayerId,\n+    },\n+    Dying {\n+        player: PlayerId,\n+        source: Option<PlayerId>,\n+    },\n+    Death {\n+        player: PlayerId,\n+        killer: Option<PlayerId>,\n+    },\n+    Phase {\n+        player: PlayerId,\n+        phase: Phase,\n+        begin: bool,\n+    },\n+    TurnEnded {\n+        player: PlayerId,\n+    },\n+    SkillToggled {\n+        player: PlayerId,\n+        skill: SkillDefId,\n+        enabled: bool,\n+        /// 是否临时获得、回合结束移除。\n+        temporary: bool,\n+    },\n+    /// 装备一张装备牌；同栏旧牌被替换入弃牌堆。\n+    Equipped {\n+        player: PlayerId,\n+        card: CardId,\n+        /// 同栏被替换下的旧牌（若有）。\n+        replaced: Option<CardId>,\n+    },\n+    /// 连环状态切换（铁索连环横置/重置）。\n+    Linked {\n+        player: PlayerId,\n+        linked: bool,\n+    },\n+    /// 弃牌（弃牌阶段批量弃置等；供连营类「失去手牌」触发）。\n+    CardsDiscarded {\n+        player: PlayerId,\n+        cards: Vec<CardId>,\n+    },\n+    /// 失去牌（swd 批 125）：`origins` 与 `cards` 等长，标出每张的来源区\n+    /// （上游 `card.original`——'h'/'e'/'j'）。\n+    CardsLost {\n+        player: PlayerId,\n+        cards: Vec<CardId>,\n+        origins: Vec<LostOrigin>,\n+    },\n+    /// 杀被闪避（swd 批 141）：`card` = 被闪的【杀】，`source` = 使用者，\n+    /// `target` = 闪避者（上游 `shaMiss` 的 trigger.card/player）。\n+    ShaDodged {\n+        card: CardId,\n+        source: PlayerId,\n+        target: PlayerId,\n+    },\n+    /// 手牌直接给予（NC04 未映射事件批）：`giver` 交出、`recipient` 收入，\n+    /// 与旧线 `DomainEvent::CardsGiven` 同形（giver≠recipient 且非空才发）。\n+    /// 触发上下文：事件主玩家=recipient、来源=giver、amount=张数（旧线\n+    /// dispatch 同口径）。**每次给牌动作一帧、携带全部牌**（规则 v326，\n+    /// `give_hand_cards` 批量原语）；CardsLost/CardsMoved 仍逐张。\n+    CardsGiven {\n+        giver: PlayerId,\n+        recipient: PlayerId,\n+        cards: Vec<CardId>,\n+    },\n+    /// 失去体力（逐技对照批三 v77）：直接扣减体力——不经护甲、不触发\n+    /// 伤害类窗口/铁索/伤害来源技；体力 ≤0 进入濒死（上游 loseHp）。\n+    LoseHp {\n+        player: PlayerId,\n+        amount: u32,\n+    },\n+    /// 濒死救回（dyingAfter 等价，见 EventKind::DyingSaved）。\n+    DyingSaved {\n+        player: PlayerId,\n+        source: Option<PlayerId>,\n+    },\n+}\n+\n+impl EventData {\n+    pub fn kind(&self) -> EventKind {\n+        match self {\n+            EventData::Damage(_) => EventKind::Damage,\n+            EventData::DamageWindow { window, .. } => window.event_kind(),\n+            EventData::Recover { .. } => EventKind::Recover,\n+            EventData::CardsDrawn { .. } => EventKind::CardsDrawn,\n+            EventData::CardsMoved { .. } => EventKind::CardsMoved,\n+            EventData::CardUsed(_) => EventKind::CardUsed,\n+            EventData::CardResponded { .. } => EventKind::CardResponded,\n+            EventData::Dying { .. } => EventKind::Dying,\n+            EventData::Death { .. } => EventKind::Death,\n+            EventData::Phase { begin: true, .. } => EventKind::PhaseBegin,\n+            EventData::Phase { begin: false, .. } => EventKind::PhaseEnd,\n+            EventData::TurnEnded { .. } => EventKind::TurnEnded,\n+            EventData::SkillToggled { .. } => EventKind::SkillToggled,\n+            EventData::Equipped { .. } => EventKind::Equipped,\n+            EventData::Linked { .. } => EventKind::Linked,\n+            EventData::CardsDiscarded { .. } => EventKind::CardsDiscarded,\n+            EventData::CardsLost { .. } => EventKind::CardsLost,\n+            EventData::ShaDodged { .. } => EventKind::ShaDodged,\n+            EventData::CardsGiven { .. } => EventKind::CardsGiven,\n+            EventData::TurnOverBefore { .. } => EventKind::TurnOverBefore,\n+            EventData::TurnOvered { .. } => EventKind::TurnOvered,\n+            EventData::LoseHp { .. } => EventKind::LoseHp,\n+            EventData::DyingSaved { .. } => EventKind::DyingSaved,\n+        }\n+    }\n+\n+    /// DamageBefore 与 Damage 共用 Damage 载荷。\n+    pub fn trigger_kind(&self, before: bool) -> EventKind {\n+        match self {\n+            EventData::Damage(_) if before => EventKind::DamageBefore,\n+            other => other.kind(),\n+        }\n+    }\n+}\n+\n+/// 回合阶段。\n+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]\n+pub enum Phase {\n+    Judge,\n+    Draw,\n+    Play,\n+    Discard,\n+    End,\n+}\n+\n+impl Phase {\n+    pub const ALL: [Phase; 5] = [\n+        Phase::Judge,\n+        Phase::Draw,\n+        Phase::Play,\n+        Phase::Discard,\n+        Phase::End,\n+    ];\n+\n+    pub fn next(self) -> Option<Phase> {\n+        Some(match self {\n+            Phase::Judge => Phase::Draw,\n+            Phase::Draw => Phase::Play,\n+            Phase::Play => Phase::Discard,\n+            Phase::Discard => Phase::End,\n+            Phase::End => return None,\n+        })\n+    }\n+\n+    pub fn name(&self) -> &'static str {\n+        match self {\n+            Phase::Judge => \"judge\",\n+            Phase::Draw => \"draw\",\n+            Phase::Play => \"play\",\n+            Phase::Discard => \"discard\",\n+            Phase::End => \"end\",\n+        }\n+    }\n+}\n+\n+/// 触发时机带（镜像非官方 first/normal/last 三段）。\n+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]\n+pub enum Timing {\n+    First,\n+    Normal,\n+    Last,\n+}\n+\n+/// 已入队待运行的触发项。\n+#[derive(Debug, Clone, PartialEq, Eq)]\n+pub struct QueuedTrigger {\n+    pub def: SkillDefId,\n+    pub owner: PlayerId,\n+    /// Canonical timing / effective priority / reserved zero / relative seat / definition.\n+    pub order: (u8, i32, u8, u8, u16),\n+}\n+\n+/// 帧所处的管线阶段。\n+#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n+pub enum Stage {\n+    /// 伤害前置触发窗口。\n+    BeforeTriggers,\n+    /// 内核提交动作（扣血/摸牌/移牌等）。\n+    Commit,\n+    /// 提交后触发窗口。\n+    AfterTriggers,\n+    /// 内核固有流程机器（濒死救援/出牌结算/弃牌选择等）。\n+    Intrinsic,\n+    /// 已完成，待弹栈。\n+    Done,\n+}\n+\n+/// 事件栈上的一帧。\n+#[derive(Debug, Clone, PartialEq, Eq)]\n+pub struct Frame {\n+    pub id: EventId,\n+    pub parent: Option<EventId>,\n+    pub kind: EventKind,\n+    pub data: EventData,\n+    pub stage: Stage,\n+    pub queue: Vec<QueuedTrigger>,\n+    /// 当前阶段的触发队列是否已收集。\n+    pub planned: bool,\n+    pub intrinsic_done: bool,\n+}\n+\n+impl Frame {\n+    pub fn damage(&self) -> &DamageData {\n+        match &self.data {\n+            EventData::Damage(d) => d,\n+            other => panic!(\"frame {:?} is not damage: {other:?}\", self.kind),\n+        }\n+    }\n+\n+    pub fn damage_mut(&mut self) -> &mut DamageData {\n+        match &mut self.data {\n+            EventData::Damage(d) => d,\n+            other => panic!(\"frame {other:?} is not damage\"),\n+        }\n+    }\n+\n+    /// TurnOverBefore 帧载荷可变访问（漩涡面具取消写回）。\n+    pub fn turn_over_before_mut(&mut self) -> (&mut PlayerId, &mut bool) {\n+        match &mut self.data {\n+            EventData::TurnOverBefore { player, cancelled } => (player, cancelled),\n+            other => panic!(\"frame {other:?} is not turn_over_before\"),\n+        }\n+    }\n+\n+    /// CardUsed 帧载荷可变访问（猴子偷桃取消写回）。\n+    pub fn card_use_mut(&mut self) -> &mut CardUseData {\n+        match &mut self.data {\n+            EventData::CardUsed(u) => u,\n+            other => panic!(\"frame {other:?} is not card_use\"),\n+        }\n+    }\n+\n+    /// CardUsed 帧载荷只读访问（同疾读目标；非 CardUsed 帧返回 None）。\n+    pub fn card_use(&self) -> Option<&CardUseData> {\n+        match &self.data {\n+            EventData::CardUsed(u) => Some(u),\n+            _ => None,\n+        }\n+    }\n+}"},{"sha":"64053a3bd7d16a1f11d04b33b25c6ece73319ea7","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20-v3/baseline-changed/crates/engine-native-kernel/src/event/damage.rs","status":"added","additions":124,"deletions":0,"changes":124,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fevent%2Fdamage.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fevent%2Fdamage.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fevent%2Fdamage.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1,124 @@\n+//! Canonical damage quantity, submission receipt and sole continuation progress.\n+use super::*;\n+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]\n+pub enum DamageOutcome {\n+    #[default]\n+    Running,\n+    Cancelled,\n+    ReplacedByLoseHp,\n+    Zero,\n+    Completed,\n+}\n+#[derive(Debug, Clone, PartialEq, Eq, Default)]\n+pub enum DamageProgress {\n+    #[default]\n+    Before,\n+    HpCommitted,\n+    TargetDamage,\n+    DyingPending,\n+    DyingDone,\n+    Source,\n+    End,\n+    After,\n+    Chain {\n+        remaining: Vec<PlayerId>,\n+    },\n+    Done,\n+    ZeroPending,\n+    Stopped,\n+}\n+#[derive(Debug, Clone, PartialEq, Eq, Default)]\n+pub struct DamageSettlement {\n+    pub committed_damage: Option<u32>,\n+    pub hp_loss: u32,\n+    pub outcome: DamageOutcome,\n+    pub notrigger: bool,\n+    pub progress: DamageProgress,\n+}\n+#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n+pub enum DamageWindowKind {\n+    Source,\n+    End,\n+    After,\n+    Zero,\n+    Cancelled,\n+}\n+impl DamageWindowKind {\n+    pub fn event_kind(self) -> EventKind {\n+        match self {\n+            Self::Source => EventKind::DamageSource,\n+            Self::End => EventKind::DamageEnd,\n+            Self::After => EventKind::DamageAfter,\n+            Self::Zero => EventKind::DamageZero,\n+            Self::Cancelled => EventKind::DamageCancelled,\n+        }\n+    }\n+    pub fn tag(self) -> u8 {\n+        match self {\n+            Self::Source => 0,\n+            Self::End => 1,\n+            Self::After => 2,\n+            Self::Zero => 3,\n+            Self::Cancelled => 4,\n+        }\n+    }\n+    pub fn from_tag(tag: u8) -> Option<Self> {\n+        Some(match tag {\n+            0 => Self::Source,\n+            1 => Self::End,\n+            2 => Self::After,\n+            3 => Self::Zero,\n+            4 => Self::Cancelled,\n+            _ => return None,\n+        })\n+    }\n+}\n+impl DamageSettlement {\n+    pub fn canonical_bytes(&self) -> Vec<u8> {\n+        let mut out = b\"native-damage-settlement/1\".to_vec();\n+        out.push(u8::from(self.committed_damage.is_some()));\n+        out.extend_from_slice(&self.committed_damage.unwrap_or(0).to_le_bytes());\n+        out.extend_from_slice(&self.hp_loss.to_le_bytes());\n+        out.push(match self.outcome {\n+            DamageOutcome::Running => 0,\n+            DamageOutcome::Cancelled => 1,\n+            DamageOutcome::ReplacedByLoseHp => 2,\n+            DamageOutcome::Zero => 3,\n+            DamageOutcome::Completed => 4,\n+        });\n+        out.push(u8::from(self.notrigger));\n+        let (tag, remaining) = match &self.progress {\n+            DamageProgress::Before => (0, None),\n+            DamageProgress::HpCommitted => (1, None),\n+            DamageProgress::TargetDamage => (2, None),\n+            DamageProgress::DyingPending => (3, None),\n+            DamageProgress::DyingDone => (4, None),\n+            DamageProgress::Source => (5, None),\n+            DamageProgress::End => (6, None),\n+            DamageProgress::After => (7, None),\n+            DamageProgress::Chain { remaining } => (8, Some(remaining)),\n+            DamageProgress::Done => (9, None),\n+            DamageProgress::ZeroPending => (10, None),\n+            DamageProgress::Stopped => (11, None),\n+        };\n+        out.push(tag);\n+        if let Some(xs) = remaining {\n+            out.extend_from_slice(&(xs.len() as u32).to_le_bytes());\n+            out.extend_from_slice(xs);\n+        }\n+        out\n+    }\n+}\n+\n+/// A window carries only its checked ancestor identity; filters read the live canonical root.\n+pub fn damage_event<'a>(frames: &'a [Frame], frame: &'a Frame) -> &'a EventData {\n+    if let EventData::DamageWindow { root, .. } = frame.data {\n+        &frames\n+            .iter()\n+            .find(|f| f.id == root)\n+            .expect(\"checked damage ancestor\")\n+            .data\n+    } else {\n+        &frame.data\n+    }\n+}"},{"sha":"ddfffcae9975f2b1c735f94bd3d1ce7b6adf64f4","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20-v3/baseline-changed/crates/engine-native-kernel/src/kernel.rs","status":"added","additions":85,"deletions":0,"changes":85,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fkernel.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fkernel.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fkernel.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1,85 @@\n+//! 内核固有机制：帧提交动作与内核流程机器。\n+//!\n+//! 原则：移动牌、扣血、摸牌、事件推进、濒死/死亡/出牌结算等**规则机制**\n+//! 归内核；具体技能的条件与流程归内容模块（`content`），两者通过同一套\n+//! 事件帧 + 机器接口协作。\n+\n+use crate::catalog::{CardKind, SkillMachine};\n+use crate::choice::{ChoiceKind, ChoiceOption, ChoiceSpec};\n+use crate::event::{EventData, Phase};\n+use crate::ids::EventId;\n+use crate::ids::PlayerId;\n+use crate::machine::{damage_data, damage_data_with, Ctx, Flow, LogEvent};\n+\n+/// 帧提交阶段的一次性内核动作。\n+pub fn commit_frame(ctx: &mut Ctx<'_>, frame_id: EventId) {\n+    let (kind, data) = {\n+        let f = ctx.res.frame(frame_id).expect(\"commit frame\");\n+        (f.kind, f.data.clone())\n+    };\n+    record_vm_history(ctx, &data);\n+    match data {\n+        EventData::Damage(d) => { if d.settlement.committed_damage.is_none() { commit_damage(ctx, frame_id, d); } },\n+        EventData::DamageWindow { root, window: crate::event::DamageWindowKind::End } => {\n+            let d=ctx.res.frame(root).expect(\"damage root\").damage().clone();\n+            if d.amount>0 && !d.prevented && !d.settlement.notrigger {post_damage(ctx,d);}\n+        },\n+        EventData::LoseHp { player, amount } => commit_lose_hp(ctx, player, amount),\n+        EventData::CardUsed(u) => commit_card_used(ctx, u),\n+        EventData::Equipped { player, card, .. } => commit_equip(ctx, frame_id, player, card),\n+        EventData::Linked { player, .. } => commit_linked(ctx, frame_id, player),\n+        EventData::Phase {\n+            player,\n+            phase,\n+            begin,\n+        } => commit_phase(ctx, player, phase, begin),\n+        EventData::TurnEnded { player } => commit_turn_ended(ctx, player),\n+        EventData::TurnOverBefore { player, cancelled } => {\n+            commit_turn_over_before(ctx, player, cancelled)\n+        }\n+        EventData::CardsDiscarded { player, .. } => commit_cards_discarded(ctx, player),\n+        EventData::CardsMoved { to, .. } => commit_cards_moved(ctx, to),\n+        EventData::Recover { player, .. } => commit_recover_skills(ctx, player),\n+        // CardsDrawn/Recover/CardsMoved 等在构造时已由助手完成区移动作。\n+        _ => {\n+            let _ = kind;\n+        }\n+    }\n+}\n+\n+mod damage;\n+mod damage_flow;\n+pub use damage_flow::DamageFlow;\n+use damage::*;\n+mod events;\n+use events::*;\n+mod equipment;\n+pub use equipment::{grant_equip_skills, revoke_equip_skills};\n+use equipment::commit_equip;\n+mod intrinsic;\n+pub use intrinsic::*;\n+mod combat_rules;\n+pub(crate) use combat_rules::*;\n+pub use combat_rules::tao_futai2_banned;\n+mod sha;\n+pub use sha::*;\n+mod dying;\n+pub use dying::*;\n+mod duel;\n+pub use duel::*;\n+mod tricks;\n+pub use tricks::*;\n+mod nullify;\n+pub use nullify::*;\n+mod judge;\n+pub use judge::*;\n+mod aoe;\n+pub use aoe::*;\n+mod discard;\n+pub use discard::*;\n+mod death;\n+pub use death::*;\n+mod monkey;\n+pub use monkey::*;\n+mod phase;\n+use phase::*;"},{"sha":"a4877dc07745c7370d3305b788e3c54edbb3d4cc","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20-v3/baseline-changed/crates/engine-native-kernel/src/kernel/damage.rs","status":"added","additions":1119,"deletions":0,"changes":1119,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fkernel%2Fdamage.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fkernel%2Fdamage.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fkernel%2Fdamage.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1,1119 @@\n+use super::*;\n+\n+/// Submit one canonical source amount; DamageFlow owns later callbacks and Dying.\n+pub(super) fn commit_damage(ctx: &mut Ctx<'_>, frame_id: EventId, mut d: crate::event::DamageData) {\n+    if d.prevented {\n+        ctx.log(LogEvent::DamagePrevented { target: d.target });\n+        finish_damage(ctx, frame_id, d, crate::event::DamageOutcome::Cancelled);\n+        return;\n+    }\n+    if d.amount <= 0 {\n+        finish_damage(ctx, frame_id, d, crate::event::DamageOutcome::Zero);\n+        return;\n+    }\n+    // 绝情（Boss 张春华，规则 v260；一将包旧绝情）：锁定——你造成的伤害\n+    // 改为目标失去等量体力（上游 source damageBefore cancel+loseHp(num)\n+    // 同口径；num=增幅前原始值=d.amount；取消后伤害事件不再结算=受击/\n+    // 加成类不触发；置于急冻前——上游 damageBefore 同层内容序）\n+    if let Some(jqdef) = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::names::JUE_QING)\n+    {\n+        if let Some(src) = d.source {\n+            if src != d.target && ctx.core.player(src).alive && ctx.core.has_skill(src, jqdef) {\n+                ctx.emit(EventData::LoseHp {\n+                    player: d.target,\n+                    amount: d.amount as u32,\n+                });\n+                finish_damage(ctx, frame_id, d, crate::event::DamageOutcome::ReplacedByLoseHp);\n+        return;\n+            }\n+        }\n+    }\n+    // 无心（Boss 张春华，规则 v260）伤害半：锁定——你受到的伤害改为失去\n+    // 1 点体力（上游 damageBefore priority 10 cancel+loseHp() 无参=1 同\n+    // 口径；置于绝情后=同层 priority 序）\n+    if let Some(wxdef) = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::names::BOSS_WUXIN)\n+    {\n+        if ctx.core.has_skill(d.target, wxdef) && ctx.core.player(d.target).alive {\n+            ctx.emit(EventData::LoseHp {\n+                player: d.target,\n+                amount: 1,\n+            });\n+            finish_damage(ctx, frame_id, d, crate::event::DamageOutcome::ReplacedByLoseHp);\n+        return;\n+        }\n+    }\n+    // 急冻冰封（U05 ow 美，规则 v127）：锁定——冰封目标受所有伤害无\n+    // 效（上游 jidong2 damageBefore trigger.cancel() 同口径；铁索传导\n+    // 的独立事件同门控）。置于各伤害增幅钩前：伤害已整体取消，\n+    // damageBegin 类增幅同上游一样不再结算。\n+    if ctx.core.player(d.target).jidong_active {\n+        ctx.log(LogEvent::DamagePrevented { target: d.target });\n+        finish_damage(ctx, frame_id, d, crate::event::DamageOutcome::Cancelled);\n+        return;\n+    }\n+    // 诚信免伤（U05 xianjian 明绣，规则 v164）：锁定——免伤状态目标受\n+    // 所有伤害无效（上游 chengxin2 damageBefore trigger.cancel 同口径）\n+    if ctx.core.player(d.target).chengxin_active {\n+        ctx.log(LogEvent::DamagePrevented { target: d.target });\n+        finish_damage(ctx, frame_id, d, crate::event::DamageOutcome::Cancelled);\n+        return;\n+    }\n+    // 招祸（Boss 毕方，规则 v227）：锁定——你免疫所有火属性伤害（上游\n+    // boss_zhaohuo damageBegin4 trigger.cancel 的火伤分支同口径；诚信免\n+    // 伤同位）\n+    if d.nature == crate::event::DamageNature::Fire {\n+        if let Some(zdef) = ctx\n+            .catalog\n+            .skill_by_name(crate::vocabulary::names::BOSS_ZHAOHUO)\n+        {\n+            if ctx.core.has_skill(d.target, zdef) {\n+                ctx.log(LogEvent::DamagePrevented { target: d.target });\n+                finish_damage(ctx, frame_id, d, crate::event::DamageOutcome::Cancelled);\n+        return;\n+            }\n+        }\n+    }\n+    // 火神（Boss 周瑜，规则 v263）：锁定——火属性伤害对你无效，你回复\n+    // 1 点体力（上游 damageBegin1 cancel+recover() 无参=1 同口径；置于\n+    // 招祸同位=damageBegin 层，取消后增幅不结算）\n+    if d.nature == crate::event::DamageNature::Fire {\n+        if let Some(hsdef) = ctx\n+            .catalog\n+            .skill_by_name(crate::vocabulary::names::BOSS_HUOSHEN)\n+        {\n+            if ctx.core.player(d.target).alive && ctx.core.has_skill(d.target, hsdef) {\n+                ctx.log(LogEvent::DamagePrevented { target: d.target });\n+                ctx.recover(d.target, 1, None);\n+                finish_damage(ctx, frame_id, d, crate::event::DamageOutcome::Cancelled);\n+        return;\n+            }\n+        }\n+    }\n+    // 拟态（Boss 梼杌，规则 v217）：锁定——防止你于回合内受到的伤害\n+    //（上游 boss_nitai_in damageBegin4 trigger.cancel 同口径：当前回合\n+    // =持有者）\n+    if let Some(ndef) = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::names::BOSS_NITAI)\n+    {\n+        if ctx.core.has_skill(d.target, ndef) && ctx.core.turn.current == d.target {\n+            ctx.log(LogEvent::DamagePrevented { target: d.target });\n+            finish_damage(ctx, frame_id, d, crate::event::DamageOutcome::Cancelled);\n+        return;\n+        }\n+    }\n+    let mut amount = i64::from(d.amount);\n+    // 拟态（Boss 梼杌，规则 v217）：锁定——你于回合外受到的火属性伤害\n+    // +1（上游 boss_nitai_out damageBegin1 num++ 同口径）\n+    if d.nature == crate::event::DamageNature::Fire {\n+        if let Some(ndef) = ctx\n+            .catalog\n+            .skill_by_name(crate::vocabulary::names::BOSS_NITAI)\n+        {\n+            if ctx.core.has_skill(d.target, ndef) && ctx.core.turn.current != d.target {\n+                amount += 1;\n+            }\n+        }\n+    }\n+    // 赤龙牙（U05 swd 第四批，规则 v88）：锁定——来源装备赤龙牙时\n+    // 火属性伤害 +1（上游 damageBegin num++；非铁索传导照常）\n+    if d.nature == crate::event::DamageNature::Fire {\n+        if let Some(src) = d.source {\n+            if ctx.core.player(src).alive\n+                && ctx\n+                    .core\n+                    .player(src)\n+                    .equips\n+                    .iter()\n+                    .any(|c| ctx.catalog.card_kind(*c) == CardKind::Chilongya)\n+            {\n+                amount += 1;\n+            }\n+        }\n+    }\n+    // 星君眼（U05 swd 第九批，规则 v93）：锁定——你的【杀】伤害 +1\n+    //（上游 damageBegin num++；card==sha 同口径；铁索传导为独立事件\n+    // 照常 +1）\n+    if d.card\n+        .map(|c| ctx.catalog.card_kind(c) == CardKind::Sha)\n+        .unwrap_or(false)\n+    {\n+        if let Some(src) = d.source {\n+            if ctx.core.player(src).alive\n+                && ctx\n+                    .core\n+                    .player(src)\n+                    .equips\n+                    .iter()\n+                    .any(|c| ctx.catalog.card_kind(*c) == CardKind::Xingjunyan)\n+            {\n+                amount += 1;\n+            }\n+        }\n+    }\n+    // 链钩（U05 ow 路霸，规则 v128）：本回合被钩者首次受伤害 +1\n+    //（上游 liangou2 damageBegin trigger.num++ usable:1 同口径；来源\n+    // 不限=上游无 source 条件；仅路霸出牌阶段可钩住，换回合解除）\n+    if let Some(t) = ctx.core.turn.liangou_hook {\n+        if d.target == t && !ctx.core.turn.liangou_bonus_used {\n+            amount += 1;\n+            ctx.core.turn.liangou_bonus_used = true;\n+        }\n+    }\n+    // 飞刃（U05 ow 源氏，规则 v129）：锁定——你的黑桃杀伤害 +1（非\n+    // 铁索传导；上游 damageBegin trigger.num++ notLink 同口径；花色按\n+    // 实体牌——火/雷杀为黑桃时同样命中）\n+    if d.card\n+        .map(|c| {\n+            ctx.catalog.card_kind(c).is_sha_like()\n+                && ctx.catalog.cards[c as usize].suit == crate::catalog::Suit::Spade\n+        })\n+        .unwrap_or(false)\n+        && !d.from_chain\n+    {\n+        if let Some(src) = d.source {\n+            let has_feiren = ctx\n+                .catalog\n+                .skill_by_name(crate::vocabulary::host::WUDIAN_FEIREN_KEY)\n+                .map(|def| ctx.core.has_skill(src, def))\n+                .unwrap_or(false);\n+            if has_feiren && ctx.core.player(src).alive {\n+                amount += 1;\n+            }\n+        }\n+    }\n+    // 刺猬（U07 玩点论杀韩龙，规则 v111）：锁定——你的杀对满血目标伤\n+    // 害 +1；加后 ≥ 目标体力则目标获本回合濒死即死标记（上游\n+    // addTempSkill(\"ciqiu_dying\")）且本技能移除（一次性）\n+    if d.card\n+        .map(|c| ctx.catalog.card_kind(c) == CardKind::Sha)\n+        .unwrap_or(false)\n+    {\n+        if let Some(src) = d.source {\n+            if ctx.core.player(d.target).alive\n+                && ctx.core.player(d.target).hp == ctx.core.player(d.target).max_hp as i32\n+            {\n+                if let Some(def) = ctx\n+                    .catalog\n+                    .skill_by_name(crate::vocabulary::host::WUDIAN_CIQIU_KEY)\n+                {\n+                    if ctx.core.has_skill(src, def) {\n+                        amount += 1;\n+                        if amount >= i64::from(ctx.core.player(d.target).hp) {\n+                            ctx.core.turn.ciqiu_dying.push(d.target);\n+                            ctx.core.skills.remove(&(src, def));\n+                        }\n+                    }\n+                }\n+            }\n+        }\n+    }\n+    // 毒瘟（U07 ow，规则 v122）：锁定——造成伤害时若你手牌数与受伤害\n+    // 角色相等，伤害 +1（上游 duwen damageBegin num++ 同口径；铁索传\n+    // 导为独立事件照常判定）\n+    if let Some(src) = d.source {\n+        if ctx.core.player(src).alive\n+            && ctx.core.player(src).hand.len() == ctx.core.player(d.target).hand.len()\n+        {\n+            if let Some(def) = ctx\n+                .catalog\n+                .skill_by_name(crate::vocabulary::host::WUDIAN_DUWEN_KEY)\n+            {\n+                if ctx.core.has_skill(src, def) {\n+                    amount += 1;\n+                }\n+            }\n+        }\n+    }\n+    // 回合伤害统计（U05 xianjian 明绣，规则 v160 灵火门控）：来源本回\n+    // 合已造成伤害 +实际量（护甲/机甲吸收后；上游 getStat(\"damage\") 按\n+    // 醉酒（Boss 白无常，规则 v255）：你使用的【杀】造成的伤害 +1（上\n+    // 游 damageBegin1 sha+shaParent 同口径；火杀/雷杀同属 sha 族）\n+    if d.card\n+        .map(|c| {\n+            matches!(\n+                ctx.catalog.card_kind(c),\n+                CardKind::Sha | CardKind::FireSha | CardKind::LeiSha\n+            )\n+        })\n+        .unwrap_or(false)\n+    {\n+        if let Some(zjdef) = ctx\n+            .catalog\n+            .skill_by_name(crate::vocabulary::names::BOSS_ZUIJIU)\n+        {\n+            if let Some(src) = d.source {\n+                if ctx.core.has_skill(src, zjdef) {\n+                    amount += 1;\n+                }\n+            }\n+        }\n+    }\n+    // 灵渠（Boss 玄武，规则 v237）：受到的大于 1 点伤害视为 0 点（上游\n+    // 不佛（Boss 地藏王，规则 v274）：受到大于 1 点的伤害时改为其中 1\n+    // 点（上游 boss_bufo damageBegin4 num>1→num-1 同口径；置于灵渠归零\n+    // 检查前——灵渠读调整后终值；两技同持为不同武将不共存，序未登记）\n+    if amount > 1 {\n+        if let Some(bfdef) = ctx\n+            .catalog\n+            .skill_by_name(crate::vocabulary::names::BOSS_BUFO)\n+        {\n+            if ctx.core.has_skill(d.target, bfdef) {\n+                amount -= 1;\n+            }\n+        }\n+    }\n+    // boss_lingqu cancel damageBegin4 num>1 → num=0 同口径；置于增幅后\n+    // 统计前——终值>1 才归零；0 点伤害仍完成事件→受击摸 1/计数照常）\n+    if amount > 1 {\n+        if let Some(ldef) = ctx\n+            .catalog\n+            .skill_by_name(crate::vocabulary::names::BOSS_LINGQU)\n+        {\n+            if ctx.core.has_skill(d.target, ldef) {\n+                amount = 0;\n+            }\n+        }\n+    }\n+    // 脉轮（swd 批 137，规则 v316）：3=首次造成/受到伤害 -1、4=+1（各自\n+    // 一次性；上游 mailun31/32/41/42 damageBegin 用后移除同口径）\n+    {\n+        if let Some(src) = d.source {\n+            let mode = ctx.core.player(src).mailun_mode;\n+            if (mode == 3 || mode == 4) && !ctx.core.player(src).mailun_out_used {\n+                amount = if mode == 3 {\n+                    amount.saturating_sub(1)\n+                } else {\n+                    amount.saturating_add(1)\n+                };\n+                ctx.core.player_mut(src).mailun_out_used = true;\n+            }\n+        }\n+        let mode = ctx.core.player(d.target).mailun_mode;\n+        if (mode == 3 || mode == 4) && !ctx.core.player(d.target).mailun_in_used {\n+            amount = if mode == 3 {\n+                amount.saturating_sub(1)\n+            } else {\n+                amount.saturating_add(1)\n+            };\n+            ctx.core.player_mut(d.target).mailun_in_used = true;\n+        }\n+    }\n+    // 护天护体（swd 批 131，规则 v314）：目标寄存护天牌时伤害以「体力降至\n+    // 寄存数」为上限（上游 hutian2 damageBegin priority -55 `trigger.num =\n+    // hp - storage.hutian2.length` 同口径）\n+    {\n+        let hold = ctx.core.player(d.target).hutian_hold.len() as i32;\n+        if hold > 0 {\n+            let hp = ctx.core.player(d.target).hp;\n+            let cap = hp - hold;\n+            if i64::from(cap) < amount {\n+                amount = i64::from(cap.max(0));\n+            }\n+        }\n+    }\n+    let Ok(amount)=i32::try_from(amount) else {\n+        ctx.res.fault=Some(crate::machine::VmFault{skill:\"intrinsic_damage\".into(),owner:d.target,event:\"Damage\".into(),kind:\"DamageAmountOverflow\".into(),detail:\"canonical source amount exceeds i32\".into()});return;\n+    };\n+    d.amount = amount;\n+    if amount <= 0 { finish_damage(ctx, frame_id, d, crate::event::DamageOutcome::Zero); return; }\n+    let submitted = amount as u32;\n+    d.settlement.committed_damage = Some(submitted);\n+    d.settlement.progress = crate::event::DamageProgress::HpCommitted;\n+    // Source counters and logs consume canonical submitted event.num, never armor HP loss.\n+    // damageEnd num 同口径）\n+    if let Some(src) = d.source {\n+        if src != d.target {\n+            let p = ctx.core.player_mut(src);\n+            p.turn_damage = p.turn_damage.saturating_add(amount.clamp(0,255) as u8);\n+        }\n+    }\n+    // 还侠跟踪（swd 屈娴，批 27）：还侠转化杀造成真实伤害 → 置位（上\n+    // 游 expire 子技 source damageAfter 同口径；牌 id 匹配最后提交者）\n+    if let Some(dcard) = d.card {\n+        if let Some((card, caused)) = ctx.core.turn.huanxia_track.last_mut() {\n+            if *card == dcard {\n+                *caused = true;\n+            }\n+        }\n+    }\n+    // 鼠槌（swd 卡牌面窗口机批）：多杀循环链武装中，任一杀造成真实伤害\n+    // → 置位（上游 shuchui2 charlotte source damageEnd filter card=sha\n+    // 同口径；武装=当前回合玩家=链主）\n+    if ctx.core.turn.shuchui_armed\n+        && d.source == Some(ctx.core.turn.current)\n+        && d.card\n+            .map(|c| ctx.catalog.card_kind(c).is_sha_like())\n+            .unwrap_or(false)\n+    {\n+        ctx.core.turn.shuchui_hit = true;\n+    }\n+    let mut hp_loss = submitted;\n+    // 护甲（G1 扩展）：1:1 抵扣伤害，先于体力扣减\n+    let hujia = ctx.core.player(d.target).hujia;\n+    if hujia > 0 {\n+        let absorbed = (hujia as u32).min(hp_loss);\n+        ctx.core.player_mut(d.target).hujia = hujia - absorbed as u8;\n+        hp_loss -= absorbed;\n+        ctx.log(LogEvent::HujiaAbsorbed {\n+            player: d.target,\n+            amount: absorbed,\n+        });\n+    }\n+    // 机甲血（U05 ow D.Va，规则 v141）：1:1 抵扣伤害（体力不损）——\n+    // 上游 changeHp 拦截（体力回补+机甲血同扣）观察等价；归零后照常\n+    // 扣体力（chongzhuang 重装累计登记暂缓）。\n+    let has_jijia = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::host::WUDIAN_JIJIA_KEY)\n+        .map(|def| ctx.core.has_skill(d.target, def))\n+        .unwrap_or(false);\n+    if has_jijia {\n+        let j = ctx.core.player(d.target).jijia_hp;\n+        if j > 0 {\n+            let absorbed = (j as u32).min(hp_loss);\n+            ctx.core.player_mut(d.target).jijia_hp = j - absorbed as u8;\n+            hp_loss -= absorbed;\n+            ctx.log(LogEvent::HujiaAbsorbed {\n+                player: d.target,\n+                amount: absorbed,\n+            });\n+        }\n+    }\n+    let receipt = format!(\"vm_damage_receipt:{frame_id}\");\n+    for ((_, key), value) in &mut ctx.core.vm_aux.flags {\n+        if key == &receipt {\n+            *value = d.target as u32 + 1;\n+        }\n+    }\n+    let p = ctx.core.player_mut(d.target);\n+    // 无限体力（上游 Infinity）：伤害照常结算与记录，但不改变体力\n+    //（hp 保持 == max_hp，故「已受伤」类判据恒假——与上游一致）。\n+    if !p.infinite_hp() {\n+        let Some(hp)=p.hp.checked_sub(hp_loss as i32) else {\n+            ctx.res.fault=Some(crate::machine::VmFault{skill:\"intrinsic_damage\".into(),owner:d.target,event:\"Damage\".into(),kind:\"DamageHpOverflow\".into(),detail:\"HP subtraction exceeds i32\".into()});return;\n+        };\n+        p.hp = hp;\n+    }\n+    d.settlement.hp_loss = if p.infinite_hp() { 0 } else { hp_loss };\n+    ctx.res.frame_mut(frame_id).expect(\"damage root\").data = EventData::Damage(d.clone());\n+    hlss_light_refill(ctx, d.target);\n+    ctx.log(LogEvent::DamageDealt {\n+        source: d.source,\n+        target: d.target,\n+        amount: d.amount.max(0) as u32,\n+        redirected_from: d.redirect_chain.clone(),\n+        card: d.card,\n+    });\n+}\n+\n+pub(super) fn post_damage(ctx: &mut Ctx<'_>, d: crate::event::DamageData) {\n+    // 炮台降级（U05 ow，规则 v123）：炮台持有者受伤 1 点降 1 级（上游\n+    // paotai3 damageEnd forced：storage -= trigger.num；下限 0）\n+    if ctx.core.player(d.target).paotai_lv > 0 && d.amount > 0 && !d.prevented {\n+        let lv = ctx.core.player(d.target).paotai_lv;\n+        ctx.core.player_mut(d.target).paotai_lv = lv.saturating_sub(d.amount as u8);\n+    }\n+    // 吸血鬼指环（U05 swd 第六批，规则 v90）：锁定——你的【杀】造成\n+    // 伤害后，若你已受伤，回复等量体力（上游 xixue：damageEnd sha &&\n+    // hp<maxHp → recover(num)）\n+    if let Some(src) = d.source {\n+        if src != d.target\n+            && ctx.core.player(src).alive\n+            && ctx.core.player(src).hp < ctx.core.player(src).max_hp as i32\n+            && d.card\n+                .map(|c| ctx.catalog.card_kind(c) == CardKind::Sha)\n+                .unwrap_or(false)\n+            && ctx\n+                .core\n+                .player(src)\n+                .equips\n+                .iter()\n+                .any(|c| ctx.catalog.card_kind(*c) == CardKind::Xixueguizhihuan)\n+        {\n+            ctx.recover(src, d.amount.max(0) as u32, None);\n+        }\n+    }\n+    // 青龙令珠（U05 swd 第九批，规则 v93）：你对其他角色造成属性伤害\n+    // 后（目标存活），获得其一张牌（上游 damageEnd hasNature + alive →\n+    // gainPlayerCard he；RNG 口径同批四代抽）\n+    if d.nature != crate::event::DamageNature::Normal {\n+        if let Some(src) = d.source {\n+            let t = d.target;\n+            if src != t\n+                && ctx.core.player(src).alive\n+                && ctx.core.player(t).alive\n+                && ctx\n+                    .core\n+                    .player(src)\n+                    .equips\n+                    .iter()\n+                    .any(|c| ctx.catalog.card_kind(*c) == CardKind::Qinglonglingzhu)\n+            {\n+                let he_len = ctx.core.player(t).hand.len() + ctx.core.player(t).equips.len();\n+                if he_len > 0 {\n+                    let pick = ctx.core.rng.gen_range(he_len as u32) as usize;\n+                    let hand_n = ctx.core.player(t).hand.len();\n+                    let c = if pick < hand_n {\n+                        ctx.core.player(t).hand[pick]\n+                    } else {\n+                        ctx.core.player(t).equips[pick - hand_n]\n+                    };\n+                    if ctx.core.player(t).hand.contains(&c) {\n+                        ctx.core.player_mut(t).hand.retain(|x| *x != c);\n+                    } else {\n+                        ctx.core.player_mut(t).equips.retain(|x| *x != c);\n+                        crate::kernel::revoke_equip_skills(ctx.core, ctx.catalog, t, c);\n+                    }\n+                    ctx.core.player_mut(src).hand.push(c);\n+                    ctx.log(LogEvent::CardsGiven {\n+                        from: t,\n+                        to: src,\n+                        cards: vec![c],\n+                    });\n+                }\n+            }\n+        }\n+    }\n+    // 隐贼（Boss 混沌，规则 v210）双臂：①激活门控——体力首次减至一半\n+    // 或更少时启用（SkillInstance.enabled 直写+SkillToggled；上游\n+    // boss_yinzei_switch changeHp enableSkill 同口径）；②伤害后弃牌——\n+    // 已激活且持有者无手牌 → 来源弃置一张手牌（确定性取首张；上游\n+    // damageEnd randomDiscard 随机改首张登记差异）\n+    if let Some(ydef) = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::names::BOSS_YINZEI)\n+    {\n+        let holder = d.target;\n+        let has_yinzei = ctx.core.has_skill_any_state(holder, ydef);\n+        if has_yinzei {\n+            let p = ctx.core.player(holder);\n+            if p.hp > 0 && p.hp <= p.max_hp as i32 / 2 {\n+                let was_enabled = ctx.core.has_skill(holder, ydef);\n+                if !was_enabled {\n+                    if let Some(inst) = ctx.core.skills.get_mut(&(holder, ydef)) {\n+                        inst.enabled = true;\n+                    }\n+                    ctx.log(LogEvent::SkillToggled {\n+                        player: holder,\n+                        skill: ctx.catalog.skill_name(ydef),\n+                        enabled: true,\n+                    });\n+                }\n+            }\n+            // 伤害后弃牌（激活态）\n+            if ctx.core.has_skill(holder, ydef)\n+                && ctx.core.player(holder).hand.is_empty()\n+                && ctx.core.player(holder).hp > 0\n+            {\n+                if let Some(src) = d.source {\n+                    if src != holder\n+                        && ctx.core.player(src).alive\n+                        && !ctx.core.player(src).hand.is_empty()\n+                    {\n+                        let c = ctx.core.player(src).hand[0];\n+                        ctx.discard_from_hand(src, c);\n+                    }\n+                }\n+            }\n+        }\n+    }\n+    // 伤逝（规则 v260）：体力变化（受伤扣血）后补牌\n+    shangshix_draw(ctx, d.target);\n+    // 章武（Boss 刘备，规则 v261）：你受到伤害后（来源存活且非自己）——\n+    // 你弃置一张牌，来源弃置一张牌，或来源受到 1 点伤害（上游 [1,∞] 自\n+    // 选+来源 chooseToDiscard/取消双 AI 态度面→双方恒弃首张确定性近似\n+    // 登记；num=刘备弃牌数可多张登记；弃牌面=手牌首张，两手皆空跳过）\n+    if let Some(zwdef) = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::names::BOSS_ZHANGWU)\n+    {\n+        if ctx.core.has_skill(d.target, zwdef) && ctx.core.player(d.target).alive {\n+            if let Some(src) = d.source {\n+                if src != d.target && ctx.core.player(src).alive {\n+                    let hold = ctx.core.player(d.target).hand.first().copied();\n+                    if let Some(c) = hold {\n+                        ctx.discard_from_hand(d.target, c);\n+                    }\n+                    let src_card = ctx.core.player(src).hand.first().copied();\n+                    if let Some(c) = src_card {\n+                        ctx.discard_from_hand(src, c);\n+                    } else {\n+                        // 来源无牌可弃 → 受 1 点伤害（上游取消分支同口径；\n+                        // 来源亦空手牌时装备面不弃登记差异）\n+                        ctx.emit(EventData::Damage(crate::machine::damage_data(\n+                            Some(d.target),\n+                            src,\n+                            1,\n+                        )));\n+                    }\n+                }\n+            }\n+        }\n+    }\n+    // 极点（Boss 张角，规则 v263）：你造成伤害后——距离受伤者 1 以内的\n+    // 一名其他角色判定：黑则其受到 1 点雷伤（上游 source damageAfter\n+    // chooseTarget get.distance(trigger.player,target)<=1 + judge 黑 →\n+    // damage(\"thunder\") 同口径；chooseTarget AI→座位序首个确定性近似；\n+    // 链挡旗标=极点雷伤不自我递归，登记差异：上游 damageAfter 真递归；\n+    // 判定为内联确定性口径，无改判窗）\n+    if let Some(jddef) = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::names::BOSS_JIDIAN)\n+    {\n+        if let Some(src) = d.source {\n+            if ctx.core.player(src).alive && ctx.core.has_skill(src, jddef) {\n+                // 链挡：极点造成的雷伤不再触发极点\n+                if !ctx.core.turn.jidian_chain {\n+                    let seats = ctx.core.players.len() as PlayerId;\n+                    if let Some(t) = (0..seats).find(|&t| {\n+                        t != d.target\n+                            && ctx.core.player(t).alive\n+                            && ctx.core.computed_distance(ctx.catalog, d.target, t) <= 1\n+                    }) {\n+                        // 置链挡后 emit：嵌套 Damage 帧的极点臂见旗标清除\n+                        // 并跳过（挡恰一层=极点雷伤不链式，登记差异）\n+                        ctx.core.turn.jidian_chain = true;\n+                        let judged = ctx.draw_judge_card();\n+                        let black = matches!(\n+                            ctx.catalog.cards[judged as usize].suit,\n+                            crate::catalog::Suit::Spade | crate::catalog::Suit::Club\n+                        );\n+                        ctx.to_discard(judged);\n+                        if black {\n+                            ctx.emit(EventData::Damage(crate::machine::damage_data_with(\n+                                Some(src),\n+                                t,\n+                                1,\n+                                crate::event::DamageNature::Thunder,\n+                                None,\n+                            )));\n+                        }\n+                    }\n+                } else {\n+                    // 嵌套极点雷伤到达：清链挡（仅挡一层）\n+                    ctx.core.turn.jidian_chain = false;\n+                }\n+            }\n+        }\n+    }\n+    // 反噬（十殿阎罗转轮王，规则 v269）：每回合第一次受伤后置 terra 旗，\n+    // 同回合再次受伤 → 随机一名其他角色受 1 点伤害（上游 boss_zlfanshi\n+    // damageEnd addTempSkill boss_zlfanshi_terra 交替同口径；随机→座位序\n+    // 首个确定性近似登记；旗清零=回合结束全清，封印解除同位）\n+    if let Some(fsdef) = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::names::BOSS_ZLFANSHI)\n+    {\n+        if ctx.core.has_skill(d.target, fsdef) && ctx.core.player(d.target).alive {\n+            if ctx.core.player(d.target).zlfanshi_terra {\n+                ctx.core.player_mut(d.target).zlfanshi_terra = false;\n+                let seats = ctx.core.players.len() as PlayerId;\n+                if let Some(t) = (0..seats).find(|&t| t != d.target && ctx.core.player(t).alive) {\n+                    ctx.emit(EventData::Damage(crate::machine::damage_data(\n+                        Some(d.target),\n+                        t,\n+                        1,\n+                    )));\n+                }\n+            } else {\n+                ctx.core.player_mut(d.target).zlfanshi_terra = true;\n+            }\n+        }\n+    }\n+    // 逐厄（Boss 穷奇，规则 v211）：global damageEnd——任何人受到伤害\n+    // 后（来源存活且非穷奇），穷奇与来源各摸一张（上游 boss_zhue\n+    // asyncDraw([player, source]) 同口径）\n+    if let Some(zdef) = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::names::BOSS_ZHUE)\n+    {\n+        // 任一存活穷奇持有者（单 boss 场景恰一）\n+        let holders: Vec<PlayerId> = ctx\n+            .core\n+            .skills\n+            .iter()\n+            .filter(|((_, dd), i)| *dd == zdef && i.enabled)\n+            .map(|((o, _), _)| *o)\n+            .collect();\n+        for holder in holders {\n+            if !ctx.core.player(holder).alive {\n+                continue;\n+            }\n+            if let Some(src) = d.source {\n+                if src != holder && ctx.core.player(src).alive {\n+                    ctx.draw_cards(holder, 1);\n+                    ctx.draw_cards(src, 1);\n+                }\n+            }\n+        }\n+    }\n+    // 阿鼻（Boss 平等王，规则 v272）：受到有来源的伤害后——来源受 1\n+    // 点火焰伤害（上游 randomGet fire/thunder→恒定火确定性近似登记；\n+    // 无来源伤害不触发；新伤害无来源→天然无递归）\n+    if let Some(abdef) = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::names::BOSS_ABI)\n+    {\n+        if let Some(src) = d.source {\n+            if ctx.core.has_skill(d.target, abdef)\n+                && ctx.core.player(d.target).alive\n+                && ctx.core.player(src).alive\n+            {\n+                ctx.emit(EventData::Damage(crate::machine::damage_data_with(\n+                    None,\n+                    src,\n+                    1,\n+                    crate::event::DamageNature::Fire,\n+                    None,\n+                )));\n+            }\n+        }\n+    }\n+    // 远策（Boss 郭嘉，规则 v259）：global damageEnd——其他角色对另一\n+    // 其他角色造成伤害后（双方存活），判定：黑→受伤角色失 1 体力 / 红→\n+    // 来源失 1 体力（chooseControl 选项一恒定确定性近似登记——上游 AI\n+    // 态度选面+rejudge stop 检查+判定修正回调不落；hp>0 门=濒死未决者\n+    // 跳过登记差异）\n+    if let Some(ycdef) = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::names::BOSS_YUANCE)\n+    {\n+        let holders: Vec<PlayerId> = ctx\n+            .core\n+            .skills\n+            .iter()\n+            .filter(|((_, dd), i)| *dd == ycdef && i.enabled)\n+            .map(|((o, _), _)| *o)\n+            .collect();\n+        if let Some(holder) = holders.first() {\n+            if let Some(src) = d.source {\n+                if ctx.core.player(*holder).alive\n+                    && src != d.target\n+                    && ctx.core.player(src).alive\n+                    && ctx.core.player(d.target).alive\n+                    && ctx.core.player(src).hp > 0\n+                    && ctx.core.player(d.target).hp > 0\n+                {\n+                    let judged = ctx.draw_judge_card();\n+                    let black = matches!(\n+                        ctx.catalog.cards[judged as usize].suit,\n+                        crate::catalog::Suit::Spade | crate::catalog::Suit::Club\n+                    );\n+                    ctx.to_discard(judged);\n+                    let loser = if black { d.target } else { src };\n+                    ctx.emit(EventData::LoseHp {\n+                        player: loser,\n+                        amount: 1,\n+                    });\n+                }\n+            }\n+        }\n+    }\n+    // 灵渠（Boss 玄武，规则 v237）：每次受到伤害后摸 1 张牌且受击计数\n+    // +1（上游 boss_lingqu damageEnd draw+storage++ 同口径；0 点伤害照常；\n+    // 计数=PlayerState.lingqu_count 跨回合持久，手牌上限 +X）\n+    if let Some(ldef) = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::names::BOSS_LINGQU)\n+    {\n+        if ctx.core.has_skill(d.target, ldef) && ctx.core.player(d.target).alive {\n+            ctx.draw_cards(d.target, 1);\n+            let p = ctx.core.player_mut(d.target);\n+            p.lingqu_count = p.lingqu_count.saturating_add(1);\n+        }\n+    }\n+    // 急叮（Boss 明星，规则 v245）：global damageEnd——友方（同侧非己）\n+    // 受敌方来源伤害后，对来源用虚拟雷杀（LeiSha kind 载体——机器直发不\n+    // 经 PlayCard 校验；蓐收加成尾面登记差异未建模）\n+    if let Some(jddef) = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::names::BOSS_JIDING)\n+    {\n+        let holders: Vec<PlayerId> = ctx\n+            .core\n+            .skills\n+            .iter()\n+            .filter(|((_, dd), i)| *dd == jddef && i.enabled)\n+            .map(|((o, _), _)| *o)\n+            .filter(|o| {\n+                ctx.core.player(*o).alive\n+                    && *o != d.target\n+                    && ctx.core.is_boss_side(*o) == ctx.core.is_boss_side(d.target)\n+            })\n+            .collect();\n+        if let Some(holder) = holders.first() {\n+            if let Some(src) = d.source {\n+                if src != *holder\n+                    && ctx.core.player(src).alive\n+                    && ctx.core.is_boss_side(src) != ctx.core.is_boss_side(*holder)\n+                {\n+                    ctx.use_virtual_card(*holder, CardKind::LeiSha, vec![src]);\n+                }\n+            }\n+        }\n+    }\n+    // 忍性（年兽形态，规则 v249）：global damageEnd——持有者非当前回\n+    // 合角色时，任意角色受到伤害后其摸 1（上游 boss_renxing damageEnd\n+    // global `_status.currentPhase != player` 同口径）\n+    if let Some(rxdef) = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::names::BOSS_RENXING)\n+    {\n+        let holders: Vec<PlayerId> = ctx\n+            .core\n+            .skills\n+            .iter()\n+            .filter(|((_, dd), i)| *dd == rxdef && i.enabled)\n+            .map(|((o, _), _)| *o)\n+            .filter(|o| ctx.core.player(*o).alive && ctx.core.turn.current != *o)\n+            .collect();\n+        for holder in holders {\n+            ctx.draw_cards(holder, 1);\n+        }\n+    }\n+    // 延妒门控（Boss 穷奇，规则 v213）：体力首次≤一半激活（隐贼同款\n+    // enable 直写；穷奇持延妒——与隐贼块并列， holder 独立判定）\n+    if let Some(dudef) = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::names::BOSS_YANDU)\n+    {\n+        let holder = d.target;\n+        if ctx.core.has_skill_any_state(holder, dudef) && !ctx.core.has_skill(holder, dudef) {\n+            let p = ctx.core.player(holder);\n+            if p.hp > 0 && p.hp <= p.max_hp as i32 / 2 {\n+                if let Some(inst) = ctx.core.skills.get_mut(&(holder, dudef)) {\n+                    inst.enabled = true;\n+                }\n+                ctx.log(LogEvent::SkillToggled {\n+                    player: holder,\n+                    skill: ctx.catalog.skill_name(dudef),\n+                    enabled: true,\n+                });\n+            }\n+        }\n+    }\n+    // 积财门控（Boss 饕餮，规则 v216）：体力首次≤一半激活（隐贼/延妒\n+    // 同款 enable 直写）\n+    if let Some(jdef) = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::names::BOSS_JICAI)\n+    {\n+        let holder = d.target;\n+        if ctx.core.has_skill_any_state(holder, jdef) && !ctx.core.has_skill(holder, jdef) {\n+            let p = ctx.core.player(holder);\n+            if p.hp > 0 && p.hp <= p.max_hp as i32 / 2 {\n+                if let Some(inst) = ctx.core.skills.get_mut(&(holder, jdef)) {\n+                    inst.enabled = true;\n+                }\n+                ctx.log(LogEvent::SkillToggled {\n+                    player: holder,\n+                    skill: ctx.catalog.skill_name(jdef),\n+                    enabled: true,\n+                });\n+            }\n+        }\n+    }\n+    // 催毒（Boss 书精，规则 v220）：来源持催毒且目标非己、无中毒 →\n+    // 目标授中毒实例（运行时授技=skills.insert；木神勾芒不在目录跳过\n+    // 联动摸牌；上游 boss_cuidui damageEnd addSkill 同口径）\n+    if let Some(cdef) = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::names::BOSS_CUIDUI)\n+    {\n+        let zdef = ctx\n+            .catalog\n+            .skill_by_name(crate::vocabulary::names::BOSS_ZHONGDU);\n+        if let (Some(src), Some(zd)) = (d.source, zdef) {\n+            if src != d.target\n+                && ctx.core.has_skill(src, cdef)\n+                && ctx.core.player(src).alive\n+                && ctx.core.player(d.target).alive\n+                && !ctx.core.has_skill_any_state(d.target, zd)\n+            {\n+                // 中毒标记技+蛇毒结算触发技一并授（上游 temp boss_zhongdu\n+                // +global boss_shedu 组合同批生效）\n+                for skdef in [\n+                    zd,\n+                    ctx.catalog\n+                        .skill_by_name(crate::vocabulary::names::BOSS_SHEDU)\n+                        .expect(\"蛇毒 def\"),\n+                ] {\n+                    ctx.core.skills.insert(\n+                        (d.target, skdef),\n+                        crate::state::SkillInstance {\n+                            owner: d.target,\n+                            enabled: true,\n+                            once_used: false,\n+                            expires_end_of_turn: false,\n+                            rounds: 0,\n+                        },\n+                    );\n+                    ctx.log(LogEvent::SkillToggled {\n+                        player: d.target,\n+                        skill: ctx.catalog.skill_name(skdef),\n+                        enabled: true,\n+                    });\n+                }\n+            }\n+        }\n+    }\n+    // 毒妒（Boss 相柳，规则 v223）：你受到伤害时来源获 1 蛇毒标记（自\n+    // 身不获；上游 boss_duqu damageEnd storage++ 同口径）\n+    if let Some(dddef) = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::names::BOSS_DUQU)\n+    {\n+        if ctx.core.has_skill(d.target, dddef) {\n+            if let Some(src) = d.source {\n+                if src != d.target && ctx.core.player(src).alive {\n+                    let p = ctx.core.player_mut(src);\n+                    p.shedu = p.shedu.saturating_add(1);\n+                }\n+            }\n+        }\n+    }\n+    // 邪酬门控（Boss 相柳，规则 v223）：体力首次≤一半激活（隐贼/延妒/\n+    // 积财/乱常同款 enable 直写）\n+    if let Some(edef) = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::names::BOSS_ECHOU)\n+    {\n+        let holder = d.target;\n+        if ctx.core.has_skill_any_state(holder, edef) && !ctx.core.has_skill(holder, edef) {\n+            let p = ctx.core.player(holder);\n+            if p.hp > 0 && p.hp <= p.max_hp as i32 / 2 {\n+                if let Some(inst) = ctx.core.skills.get_mut(&(holder, edef)) {\n+                    inst.enabled = true;\n+                }\n+                ctx.log(LogEvent::SkillToggled {\n+                    player: holder,\n+                    skill: ctx.catalog.skill_name(edef),\n+                    enabled: true,\n+                });\n+            }\n+        }\n+    }\n+    // 乱常门控（Boss 梼杌，规则 v218）：体力首次≤一半激活（隐贼/延妒/\n+    // 积财同款 enable 直写）\n+    if let Some(ldef) = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::names::BOSS_LUANCHANG)\n+    {\n+        let holder = d.target;\n+        if ctx.core.has_skill_any_state(holder, ldef) && !ctx.core.has_skill(holder, ldef) {\n+            let p = ctx.core.player(holder);\n+            if p.hp > 0 && p.hp <= p.max_hp as i32 / 2 {\n+                if let Some(inst) = ctx.core.skills.get_mut(&(holder, ldef)) {\n+                    inst.enabled = true;\n+                }\n+                ctx.log(LogEvent::SkillToggled {\n+                    player: holder,\n+                    skill: ctx.catalog.skill_name(ldef),\n+                    enabled: true,\n+                });\n+            }\n+        }\n+    }\n+    // 虚失门控（Boss 朱厌，规则 v225）：体力首次≤一半激活（隐贼/延妒/\n+    // 积财/乱常同款 enable 直写）\n+    if let Some(sdef) = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::names::BOSS_SIPU)\n+    {\n+        let holder = d.target;\n+        if ctx.core.has_skill_any_state(holder, sdef) && !ctx.core.has_skill(holder, sdef) {\n+            let p = ctx.core.player(holder);\n+            if p.hp > 0 && p.hp <= p.max_hp as i32 / 2 {\n+                if let Some(inst) = ctx.core.skills.get_mut(&(holder, sdef)) {\n+                    inst.enabled = true;\n+                }\n+                ctx.log(LogEvent::SkillToggled {\n+                    player: holder,\n+                    skill: ctx.catalog.skill_name(sdef),\n+                    enabled: true,\n+                });\n+            }\n+        }\n+    }\n+    if let Some(xdef) = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::names::BOSS_XUSHI)\n+    {\n+        let holder = d.target;\n+        if ctx.core.has_skill_any_state(holder, xdef) && !ctx.core.has_skill(holder, xdef) {\n+            let p = ctx.core.player(holder);\n+            if p.hp > 0 && p.hp <= p.max_hp as i32 / 2 {\n+                if let Some(inst) = ctx.core.skills.get_mut(&(holder, xdef)) {\n+                    inst.enabled = true;\n+                }\n+                ctx.log(LogEvent::SkillToggled {\n+                    player: holder,\n+                    skill: ctx.catalog.skill_name(xdef),\n+                    enabled: true,\n+                });\n+            }\n+        }\n+    }\n+    // 炎狱门控（Boss 毕方，规则 v229）：体力首次≤一半激活（隐贼/延妒/\n+    // 积财/乱常/虚失同款 enable 直写）\n+    if let Some(ydef) = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::names::BOSS_YANYU)\n+    {\n+        let holder = d.target;\n+        if ctx.core.has_skill_any_state(holder, ydef) && !ctx.core.has_skill(holder, ydef) {\n+            let p = ctx.core.player(holder);\n+            if p.hp > 0 && p.hp <= p.max_hp as i32 / 2 {\n+                if let Some(inst) = ctx.core.skills.get_mut(&(holder, ydef)) {\n+                    inst.enabled = true;\n+                }\n+                ctx.log(LogEvent::SkillToggled {\n+                    player: holder,\n+                    skill: ctx.catalog.skill_name(ydef),\n+                    enabled: true,\n+                });\n+            }\n+        }\n+    }\n+    // 冥顽锁定集（Boss 梼杌，规则 v219）：回合内自己使用牌对其他角色\n+    // 造成伤害后，受伤者入锁定集（首次同时记自己——上游 storage\n+    // boss_minwan=[player]+add(target) 同口径；回合更替自然清零）\n+    if let Some(mdef) = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::names::BOSS_MINWAN)\n+    {\n+        if let Some(src) = d.source {\n+            if src != d.target\n+                && ctx.core.turn.current == src\n+                && ctx.core.has_skill(src, mdef)\n+                && ctx.core.player(src).alive\n+            {\n+                let turn = &mut ctx.core.turn;\n+                if turn.minwan_targets.is_empty() {\n+                    turn.minwan_targets.push(src);\n+                }\n+                if !turn.minwan_targets.contains(&d.target) {\n+                    turn.minwan_targets.push(d.target);\n+                }\n+            }\n+        }\n+    }\n+\n+}\n+\n+/// 禳星·光（T11 Boss 诸葛亮族批 115，规则 v303）：持有「禳星」且星未\n+/// 归零（技能实例启用）时，任意体力变化后回满体力（上游 `hlss_xiangxing_hp`\n+/// 子技 changeHp/loseMaxHp/gainMaxHp → `hp = maxHp` 同口径；在伤害/失去\n+/// 体力提交点、濒死判定前调用，故星未耗尽者不会进入濒死）。\n+pub(crate) fn hlss_light_refill(ctx: &mut Ctx<'_>, player: PlayerId) {\n+    let Some(def) = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::host::HLSS_XIANGXING_KEY)\n+    else {\n+        return;\n+    };\n+    let p = ctx.core.player_mut(player);\n+    if !p.alive || p.hp >= p.max_hp as i32 {\n+        return;\n+    }\n+    let enabled = ctx\n+        .core\n+        .skills\n+        .get(&(player, def))\n+        .map(|i| i.enabled)\n+        .unwrap_or(false);\n+    if !enabled {\n+        return;\n+    }\n+    let max = ctx.core.player(player).max_hp as i32;\n+    ctx.core.player_mut(player).hp = max;\n+}\n+\n+/// 护天归还（swd 批 131，规则 v314）：把持有者寄存于目标处的牌归还目标，\n+/// 清理双方寄存状态（上游 `hutian3` 收束同口径）。\n+pub(crate) fn hutian_return_deposit(ctx: &mut Ctx<'_>, owner: PlayerId) {\n+    let Some(target) = ctx.core.player_mut(owner).hutian_deposit.take() else {\n+        return;\n+    };\n+    let cards = std::mem::take(&mut ctx.core.player_mut(target).hutian_hold);\n+    ctx.core.player_mut(target).hutian_owner = None;\n+    if !cards.is_empty() {\n+        for c in cards.iter().copied() {\n+            ctx.core.player_mut(target).hand.push(c);\n+        }\n+        ctx.log(LogEvent::CardsGiven {\n+            from: owner,\n+            to: target,\n+            cards,\n+        });\n+    }\n+    ctx.core.player_mut(owner).hutian_just_given = false;\n+}\n+\n+/// 失去体力提交（逐技对照批三 v77）：直接扣减体力——不经护甲抵扣、\n+/// 无伤害前置窗口/铁索传导/伤害来源触发技（LoseHp 是独立事件种）；\n+/// 体力 ≤0 与伤害同口径进入濒死（上游 loseHp 语义）。\n+pub(crate) fn commit_lose_hp(ctx: &mut Ctx<'_>, player: PlayerId, mut amount: u32) {\n+    if amount == 0 {\n+        return;\n+    }\n+    // 护天护体（swd 批 131，规则 v314）：失去体力同样以「体力降至寄存数」\n+    // 为上限（上游 hutian2 loseHpBegin 同口径）\n+    {\n+        let hold = ctx.core.player(player).hutian_hold.len() as i32;\n+        if hold > 0 {\n+            let hp = ctx.core.player(player).hp;\n+            let cap = hp - hold;\n+            if cap < amount as i32 {\n+                amount = cap.max(0) as u32;\n+            }\n+        }\n+    }\n+    if amount == 0 {\n+        ctx.log(LogEvent::HpLost { player, amount: 0 });\n+        return;\n+    }\n+    let p = ctx.core.player_mut(player);\n+    if !p.infinite_hp() {\n+        p.hp -= amount as i32;\n+    }\n+    hlss_light_refill(ctx, player);\n+    ctx.log(LogEvent::HpLost { player, amount });\n+    let entering = ctx.core.player(player).hp <= 0 && !ctx.core.player(player).dying;\n+    if entering {\n+        ctx.core.player_mut(player).dying = true;\n+        ctx.log(LogEvent::DyingEntered { player });\n+        ctx.emit(EventData::Dying {\n+            player,\n+            source: None,\n+        });\n+    }\n+    // 伤逝（规则 v260）：体力变化（失去）后补牌\n+    shangshix_draw(ctx, player);\n+}\n+\n+/// 伤逝（Boss 张春华，规则 v260）补牌半：\n+pub(super) fn shangshix_draw(ctx: &mut Ctx<'_>, player: PlayerId) {\n+    if let Some(ssdef) = ctx\n+        .catalog\n+        .skill_by_name(crate::vocabulary::names::BOSS_SHANGSHIX)\n+    {\n+        if ctx.core.player(player).alive && ctx.core.has_skill(player, ssdef) {\n+            let n = ctx.core.player(player).hand.len();\n+            if n < 4 {\n+                ctx.draw_cards(player, 4 - n);\n+            }\n+        }\n+    }\n+}\n+\n+fn finish_damage(ctx: &mut Ctx<'_>, root: EventId, mut d: crate::event::DamageData, outcome: crate::event::DamageOutcome) {\n+    d.settlement.outcome = outcome;\n+    d.settlement.progress = if outcome == crate::event::DamageOutcome::Zero { crate::event::DamageProgress::ZeroPending } else { crate::event::DamageProgress::Stopped };\n+    ctx.res.frame_mut(root).expect(\"damage root\").data = EventData::Damage(d);\n+}"},{"sha":"e69de29bb2d1d6434b8b29ae775ad8c2e48c5391","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20-v3/baseline-changed/crates/engine-native-kernel/src/kernel/damage_after.rs","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fkernel%2Fdamage_after.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fkernel%2Fdamage_after.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fkernel%2Fdamage_after.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8"},{"sha":"e69de29bb2d1d6434b8b29ae775ad8c2e48c5391","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20-v3/baseline-changed/crates/engine-native-kernel/src/kernel/damage_change_hp.rs","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fkernel%2Fdamage_change_hp.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fkernel%2Fdamage_change_hp.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fkernel%2Fdamage_change_hp.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8"},{"sha":"07a94cb13bc9ae4c078b43971d433efa4d26619b","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20-v3/baseline-changed/crates/engine-native-kernel/src/kernel/damage_flow.rs","status":"added","additions":145,"deletions":0,"changes":145,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fkernel%2Fdamage_flow.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fkernel%2Fdamage_flow.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fkernel%2Fdamage_flow.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1,145 @@\n+//! One intrinsic damage continuation; settlement/progress belongs only to its root.\n+use super::*;\n+use crate::event::{DamageOutcome as O, DamageProgress as P, DamageWindowKind as W};\n+\n+#[derive(Clone)]\n+pub struct DamageFlow {\n+    pub root: EventId,\n+}\n+impl crate::catalog::SkillMachine for DamageFlow {\n+    fn fork(&self) -> Box<dyn crate::catalog::SkillMachine> {\n+        Box::new(self.clone())\n+    }\n+    fn snapshot(&self) -> crate::snap::MachineSnapshot {\n+        crate::snap::MachineSnapshot::DamageFlow { root: self.root }\n+    }\n+    fn step(&mut self, ctx: &mut Ctx<'_>) -> Flow {\n+        let Some(frame) = ctx.res.frame(self.root) else {\n+            return Flow::Done;\n+        };\n+        let EventData::Damage(mut d) = frame.data.clone() else {\n+            return Flow::Done;\n+        };\n+        if d.source.is_some_and(|s| !ctx.core.player(s).alive) {\n+            d.source = None;\n+        }\n+        if d.prevented && d.settlement.outcome == O::Running {\n+            d.settlement.outcome = O::Cancelled;\n+            d.settlement.progress = P::Stopped;\n+        }\n+        if d.amount <= 0 && d.settlement.outcome == O::Running {\n+            d.settlement.outcome = O::Zero;\n+            d.settlement.progress = P::ZeroPending;\n+        }\n+        let mut child = None;\n+        match d.settlement.progress.clone() {\n+            P::Before => {\n+                d.settlement.progress = P::Stopped;\n+            }\n+            P::ZeroPending => {\n+                d.settlement.progress = P::Stopped;\n+                child = Some(EventData::DamageWindow {\n+                    root: self.root,\n+                    window: W::Zero,\n+                });\n+            }\n+            P::Stopped => {\n+                ctx.res.frame_mut(self.root).unwrap().data = EventData::Damage(d);\n+                return Flow::Done;\n+            }\n+            P::HpCommitted | P::TargetDamage => {\n+                d.settlement.progress = P::DyingPending;\n+                if ctx.core.player(d.target).alive\n+                    && ctx.core.player(d.target).hp <= 0\n+                    && !ctx.core.player(d.target).dying\n+                {\n+                    ctx.core.player_mut(d.target).dying = true;\n+                    ctx.log(LogEvent::DyingEntered { player: d.target });\n+                    child = Some(EventData::Dying {\n+                        player: d.target,\n+                        source: d.source,\n+                    });\n+                }\n+            }\n+            P::DyingPending => {\n+                d.settlement.progress = P::DyingDone;\n+            }\n+            P::DyingDone => {\n+                d.settlement.progress = P::Source;\n+                if !d.settlement.notrigger {\n+                    child = Some(EventData::DamageWindow {\n+                        root: self.root,\n+                        window: W::Source,\n+                    });\n+                }\n+            }\n+            P::Source => {\n+                d.settlement.progress = P::End;\n+                if !d.settlement.notrigger {\n+                    child = Some(EventData::DamageWindow {\n+                        root: self.root,\n+                        window: W::End,\n+                    });\n+                }\n+            }\n+            P::End => {\n+                d.settlement.progress = P::After;\n+                if !d.settlement.notrigger {\n+                    child = Some(EventData::DamageWindow {\n+                        root: self.root,\n+                        window: W::After,\n+                    });\n+                }\n+            }\n+            P::After => {\n+                let mut remaining = Vec::new();\n+                if d.nature != crate::event::DamageNature::Normal\n+                    && !d.from_chain\n+                    && ctx.core.player(d.target).linked\n+                {\n+                    remaining = ctx\n+                        .core\n+                        .seat_order_from(d.target)\n+                        .into_iter()\n+                        .filter(|p| *p != d.target && ctx.core.player(*p).linked)\n+                        .collect();\n+                    for p in ctx\n+                        .core\n+                        .alive_players()\n+                        .filter(|p| ctx.core.player(*p).linked)\n+                        .collect::<Vec<_>>()\n+                    {\n+                        ctx.core.player_mut(p).linked = false;\n+                        ctx.log(LogEvent::Linked {\n+                            player: p,\n+                            linked: false,\n+                        });\n+                    }\n+                }\n+                d.settlement.progress = P::Chain { remaining };\n+            }\n+            P::Chain { mut remaining } => {\n+                if remaining.is_empty() {\n+                    d.settlement.progress = P::Done;\n+                    d.settlement.outcome = O::Completed;\n+                } else {\n+                    let target = remaining.remove(0);\n+                    d.settlement.progress = P::Chain { remaining };\n+                    let mut chained =\n+                        damage_data_with(d.source, target, d.amount, d.nature, d.card);\n+                    chained.from_chain = true;\n+                    child = Some(EventData::Damage(chained));\n+                }\n+            }\n+            P::Done => {\n+                ctx.res.frame_mut(self.root).unwrap().data = EventData::Damage(d);\n+                return Flow::Done;\n+            }\n+        }\n+        ctx.res.frame_mut(self.root).unwrap().data = EventData::Damage(d);\n+        if let Some(child) = child {\n+            ctx.emit(child);\n+        }\n+        Flow::Yield\n+    }\n+}"},{"sha":"e69de29bb2d1d6434b8b29ae775ad8c2e48c5391","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20-v3/baseline-changed/crates/engine-native-kernel/src/kernel/damage_windows.rs","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fkernel%2Fdamage_windows.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fkernel%2Fdamage_windows.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fkernel%2Fdamage_windows.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8"},{"sha":"2eb80a6b4a462c218cabccbb1e400c826a74cd79","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20-v3/baseline-changed/crates/engine-native-kernel/src/machine.rs","status":"added","additions":879,"deletions":0,"changes":879,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fmachine.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fmachine.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fmachine.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1,879 @@\n+//! 技能机器运行上下文与流控。\n+//!\n+//! `Ctx` 是机器推进时的唯一可变入口：核心状态、执行位置、目录与宿主\n+//! 日志各自独立借用。机器通过 `ctx.emit` 压入子事件（自身自动挂起，\n+//! 子事件全部弹栈后继续），通过返回 `Flow::WaitChoice` 请求选择\n+//! （引擎校验应答后恢复，机器从 `ctx.answer` 读取）。\n+\n+use crate::catalog::{CardKind, Catalog, QueryCtx};\n+use crate::choice::{ChoiceOption, ChoiceSpec, Selection};\n+use crate::event::{CardUseData, DamageData, DamageNature, EventData, Phase};\n+use crate::ids::{CardId, PlayerId, SkillDefId};\n+use crate::resolution::Resolution;\n+use crate::state::GameStateCore;\n+\n+/// 宿主展示/录像日志：引擎侧数据，不进状态、不进哈希。\n+#[derive(Debug, Clone, PartialEq, Eq)]\n+pub enum LogEvent {\n+    DamageDealt {\n+        source: Option<PlayerId>,\n+        target: PlayerId,\n+        amount: u32,\n+        redirected_from: Vec<PlayerId>,\n+        /// 造成伤害的牌（无牌伤害为 None）。\n+        card: Option<CardId>,\n+    },\n+    DamagePrevented {\n+        target: PlayerId,\n+    },\n+    CardsDrawn {\n+        player: PlayerId,\n+        cards: Vec<CardId>,\n+    },\n+    CardPlayed {\n+        card: CardId,\n+        player: PlayerId,\n+        targets: Vec<PlayerId>,\n+    },\n+    CardResponded {\n+        card: CardId,\n+        player: PlayerId,\n+    },\n+    /// 体力上限减少（蝉缘类——max_hp 减面，运筹武将面批 9 起承载）。\n+    MaxHpLost {\n+        player: PlayerId,\n+        amount: u32,\n+    },\n+    CardDiscarded {\n+        player: PlayerId,\n+        cards: Vec<CardId>,\n+    },\n+    CardsGiven {\n+        from: PlayerId,\n+        to: PlayerId,\n+        cards: Vec<CardId>,\n+    },\n+    HpRecovered {\n+        player: PlayerId,\n+        amount: u32,\n+    },\n+    /// 护甲抵扣伤害（G1 扩展）。\n+    HujiaAbsorbed {\n+        player: PlayerId,\n+        amount: u32,\n+    },\n+    /// 失去体力（逐技对照批三 v77；非伤害——无来源/无属性）。\n+    HpLost {\n+        player: PlayerId,\n+        amount: u32,\n+    },\n+    /// Boss 重整 tick（逐技对照批三-a v82）：死亡玩家回合计数/回血。\n+    BossChongzhengTick {\n+        player: PlayerId,\n+        count: u8,\n+    },\n+    /// Boss 重整复活（计数达阈值）。\n+    BossRevived {\n+        player: PlayerId,\n+    },\n+    DyingEntered {\n+        player: PlayerId,\n+    },\n+    DyingSaved {\n+        player: PlayerId,\n+        by_card: CardId,\n+    },\n+    PlayerDied {\n+        player: PlayerId,\n+        killer: Option<PlayerId>,\n+    },\n+    ChoiceOpened {\n+        id: u64,\n+        observer: PlayerId,\n+        prompt: &'static str,\n+    },\n+    ChoiceAnswered {\n+        id: u64,\n+        options: Vec<String>,\n+    },\n+    SkillTriggered {\n+        skill: &'static str,\n+        owner: PlayerId,\n+    },\n+    SkillToggled {\n+        player: PlayerId,\n+        skill: &'static str,\n+        enabled: bool,\n+    },\n+    PhaseChanged {\n+        player: PlayerId,\n+        phase: Phase,\n+        begin: bool,\n+    },\n+    TurnEnded {\n+        player: PlayerId,\n+    },\n+    DeckReshuffled,\n+    Equipped {\n+        player: PlayerId,\n+        card: CardId,\n+        replaced: Option<CardId>,\n+    },\n+    Linked {\n+        player: PlayerId,\n+        linked: bool,\n+    },\n+    /// 锦囊被无懈抵消（窗口关闭时的最终状态）。\n+    CardNullified {\n+        card: CardId,\n+        player: PlayerId,\n+    },\n+    /// 判定：翻开一张判定牌。\n+    Judged {\n+        player: PlayerId,\n+        card: CardId,\n+    },\n+    /// 鬼道改判：`player` 打出 `card` 代替判定牌，被替换的 `replaced` 归其所有。\n+    JudgementRewritten {\n+        player: PlayerId,\n+        card: CardId,\n+        replaced: CardId,\n+    },\n+    /// 判定牌确定（改判询问全部结束后、效果生效前）。\n+    JudgementFinalized {\n+        player: PlayerId,\n+        card: CardId,\n+    },\n+    /// 天妒：`player` 将最终判定牌 `card` 收入手牌。\n+    JudgementGained {\n+        player: PlayerId,\n+        card: CardId,\n+    },\n+    /// 八卦阵防具判定：success=红桃（视为已出闪，伤害免除）。\n+    ArmorJudged {\n+        player: PlayerId,\n+        card: CardId,\n+        success: bool,\n+    },\n+    /// VM 亮牌：牌不移动，只进入权威日志（表现层不重复展示牌面）。\n+    CardsRevealed {\n+        cards: Vec<CardId>,\n+        to: Vec<PlayerId>,\n+    },\n+}\n+\n+/// 机器单步结果。\n+pub enum Flow {\n+    /// 本机器完结。\n+    Done,\n+    /// 已 emit 子事件或被调度器挂起，等栈回到自身深度后继续。\n+    Yield,\n+    /// 请求一次选择；引擎校验应答后恢复。\n+    WaitChoice {\n+        observer: PlayerId,\n+        spec: ChoiceSpec,\n+    },\n+}\n+\n+/// VM 执行故障（NC04）：可定位的错误类型与来源，供命令结果与日志使用。\n+///\n+/// 故障发生时该段必须整体回滚（排队效果丢弃、段状态不提交），命令以\n+/// `RejectReason::VmFault` 拒绝——不得以 `Flow::Done` 吞掉故障后按正常\n+/// 规则继续。\n+#[derive(Debug, Clone, PartialEq, Eq)]\n+pub struct VmFault {\n+    /// 触发故障的 VM 技能名。\n+    pub skill: String,\n+    /// 技能持有者座位。\n+    pub owner: crate::ids::PlayerId,\n+    /// 触发事件类别（如 `PhaseEnd`/`Damage`）。\n+    pub event: String,\n+    /// 错误类别（`VmError` 变体名）。\n+    pub kind: String,\n+    /// 错误详情（`VmError` 的显示文本）。\n+    pub detail: String,\n+}\n+\n+/// 机器推进上下文。\n+pub struct Ctx<'a> {\n+    pub core: &'a mut GameStateCore,\n+    pub res: &'a mut Resolution,\n+    pub catalog: &'a Catalog,\n+    pub out: &'a mut Vec<LogEvent>,\n+}\n+\n+impl<'a> Ctx<'a> {\n+    /// 只读视图（传给目录中的过滤器）。\n+    pub fn query(&self) -> QueryCtx<'_> {\n+        QueryCtx {\n+            state: self.core,\n+            catalog: self.catalog,\n+        }\n+    }\n+\n+    // ---- 事件栈 ----\n+\n+    /// 当前事件帧号：机器只在自己的恢复深度上运行，栈顶即触发帧；但机器\n+    /// 在一步内可能发射**失去牌子帧**（`CardsLost`——仅用于触发失去牌类\n+    /// 技能，不改变调用方正在处理的事件），此访问器跳过它，保证「我正处理\n+    /// 的那个事件」语义稳定。需要裸栈顶时用 `top_frame_id`。\n+    pub fn current_frame_id(&self) -> crate::ids::EventId {\n+        self.res\n+            .stack\n+            .iter()\n+            .rev()\n+            .find(|f| f.kind != crate::event::EventKind::CardsLost)\n+            .or_else(|| self.res.stack.last())\n+            .expect(\"machine runs with a frame on stack\")\n+            .id\n+    }\n+\n+    /// 裸栈顶帧号（含失去牌子帧）。\n+    pub fn top_frame_id(&self) -> crate::ids::EventId {\n+        self.res\n+            .stack\n+            .last()\n+            .expect(\"machine runs with a frame on stack\")\n+            .id\n+    }\n+\n+    /// 当前帧的 CardUsed 载荷只读访问（同疾读目标等）。\n+    pub fn current_card_use(&self) -> Result<&CardUseData, ()> {\n+        let id = self.current_frame_id();\n+        self.res\n+            .frame(id)\n+            .ok_or(())\n+            .and_then(|f| f.card_use().ok_or(()))\n+    }\n+\n+    /// 当前帧的 CardUsed 载荷可变访问（猴子偷桃等使用前取消写回）。\n+    pub fn current_card_use_mut(&mut self) -> &mut CardUseData {\n+        let id = self.current_frame_id();\n+        self.res\n+            .frame_mut(id)\n+            .expect(\"current frame exists\")\n+            .card_use_mut()\n+    }\n+\n+    /// 当前帧的 TurnOverBefore 载荷可变访问（面具取消写回）。\n+    pub fn current_turn_over_before_mut(&mut self) -> (&mut PlayerId, &mut bool) {\n+        let id = self.current_frame_id();\n+        self.res\n+            .frame_mut(id)\n+            .expect(\"current frame exists\")\n+            .turn_over_before_mut()\n+    }\n+\n+    /// 当前帧的伤害载荷只读访问（hlss 隐月记录/禳星计数等；非伤害帧 Err）。\n+    pub fn current_damage(&self) -> Result<&DamageData, ()> {\n+        let id = self.current_frame_id();\n+        let root=match self.res.frame(id).map(|f|&f.data) {Some(EventData::DamageWindow{root,..})=>*root,_=>id};\n+        match self.res.frame(root).map(|f| &f.data) {\n+            Some(crate::event::EventData::Damage(d)) => Ok(d),\n+            _ => Err(()),\n+        }\n+    }\n+\n+    /// 当前帧的失去体力载荷（hlss 禳星计数；非 LoseHp 帧 Err）。\n+    pub fn current_lose_hp(&self) -> Result<u32, ()> {\n+        let id = self.current_frame_id();\n+        match self.res.frame(id).map(|f| &f.data) {\n+            Some(crate::event::EventData::LoseHp { amount, .. }) => Ok(*amount),\n+            _ => Err(()),\n+        }\n+    }\n+\n+    pub fn current_damage_mut(&mut self) -> &mut DamageData {\n+        let id = self.current_frame_id();\n+        let id=match self.res.frame(id).map(|f|&f.data) {Some(EventData::DamageWindow{root,..})=>*root,_=>id};\n+        self.res\n+            .frame_mut(id)\n+            .expect(\"current frame exists\")\n+            .damage_mut()\n+    }\n+\n+    /// Reject signed source-quantity overflow through the existing atomic command fault path.\n+    pub fn fail_damage_amount(&mut self) {\n+        self.res.fault=Some(VmFault{skill:\"native_damage_modifier\".into(),owner:0,event:\"Damage\".into(),kind:\"DamageAmountOverflow\".into(),detail:\"canonical source amount exceeds i32\".into()});\n+    }\n+    pub fn modify_damage_amount(&mut self, delta:i32)->bool {\n+        let Ok(d)=self.current_damage() else{return false};\n+        let Some(amount)=d.amount.checked_add(delta) else{self.fail_damage_amount();return false};\n+        self.current_damage_mut().amount=amount;true\n+    }\n+\n+    /// Request a durable result for one emitted damage frame; nested damage has a different id.\n+    pub fn damage_with_receipt(\n+        &mut self,\n+        observer: PlayerId,\n+        damage: DamageData,\n+    ) -> crate::ids::EventId {\n+        let id = self.res.next_event_id;\n+        self.core\n+            .vm_aux\n+            .flags\n+            .insert((observer, format!(\"vm_damage_receipt:{id}\")), 0);\n+        self.emit(EventData::Damage(damage));\n+        id\n+    }\n+\n+    pub fn record_phase_skipped(&mut self, player: PlayerId) {\n+        if self.catalog.vm_card_history {\n+            *self\n+                .core\n+                .vm_aux\n+                .flags\n+                .entry((player, \"vm_skipped_phase_count\".to_string()))\n+                .or_default() += 1;\n+        }\n+    }\n+\n+    /// 压入子事件帧；调用方随后应返回 `Flow::Yield`。\n+    /// 机器挂起深度在启动时已记录，子事件弹栈后自动恢复。\n+    /// 伤害帧以「前置触发窗口」为初始阶段，其余帧先提交。\n+    pub fn emit(&mut self, data: EventData) {\n+        let id = self.res.next_event_id;\n+        self.res.next_event_id += 1;\n+        let parent = self.res.stack.last().map(|f| f.id);\n+        let kind = data.kind();\n+        let stage = match kind {\n+            // 伤害与翻面带前置窗口（伤害前置 / 翻面前置取消），机器发射的\n+            // 子事件同样必须从 BeforeTriggers 起步——否则取消写回发生在\n+            // Commit 之后（E03 帧生命周期缺陷根因）。\n+            crate::event::EventKind::Damage\n+            | crate::event::EventKind::TurnOverBefore\n+            | crate::event::EventKind::Death\n+            | crate::event::EventKind::PhaseBegin => {\n+                // 死亡前置窗口（规则 v170）：机器发射的 Death 同样从\n+                // BeforeTriggers 起步（遗言/拦截技在 DeathMachine 前）。\n+                // PhaseBegin 前置窗口（PA12 批⑤-2，§2 K）：阶段开始类\n+                // 技能（奋励 skip 系）须在入场行为 begin_* 之前执行。\n+                crate::event::Stage::BeforeTriggers\n+            }\n+            _ => crate::event::Stage::Commit,\n+        };\n+        self.res.stack.push(crate::event::Frame {\n+            id,\n+            parent,\n+            kind,\n+            data,\n+            stage,\n+            queue: Vec::new(),\n+            planned: false,\n+            intrinsic_done: false,\n+        });\n+    }\n+\n+    // ---- 选择 ----\n+\n+    /// 机器读取已校验的应答。只在 `Flow::WaitChoice` 恢复后存在。\n+    pub fn answer(&self) -> &Selection {\n+        self.res.answer.as_ref().expect(\"answer present on resume\")\n+    }\n+\n+    pub fn answer_first(&self) -> ChoiceOption {\n+        *self.answer().first().expect(\"non-empty selection\")\n+    }\n+\n+    // ---- 牌区操作 ----\n+\n+    /// 摸 n 张；牌库不足时先以弃牌堆洗回（规则随机流）。\n+    pub fn draw_cards(&mut self, player: PlayerId, n: usize) -> Vec<CardId> {\n+        let mut drawn = Vec::with_capacity(n);\n+        for _ in 0..n {\n+            if self.core.deck.is_empty() {\n+                if self.core.discard.is_empty() {\n+                    break;\n+                }\n+                let mut cards = std::mem::take(&mut self.core.discard);\n+                self.core.rng.shuffle(&mut cards);\n+                self.core.deck = cards;\n+                self.out.push(LogEvent::DeckReshuffled);\n+            }\n+            let card = self.core.deck.pop().expect(\"deck non-empty\");\n+            self.core.player_mut(player).hand.push(card);\n+            drawn.push(card);\n+        }\n+        if !drawn.is_empty() {\n+            self.emit(EventData::CardsDrawn {\n+                player,\n+                cards: drawn.clone(),\n+            });\n+            self.out.push(LogEvent::CardsDrawn {\n+                player,\n+                cards: drawn.clone(),\n+            });\n+        }\n+        drawn\n+    }\n+\n+    /// 翻判定牌：牌库顶；牌库不足时先洗回弃牌堆。不进入任何玩家手牌。\n+    pub fn draw_judge_card(&mut self) -> CardId {\n+        if self.core.deck.is_empty() {\n+            let mut cards = std::mem::take(&mut self.core.discard);\n+            self.core.rng.shuffle(&mut cards);\n+            self.core.deck = cards;\n+            self.out.push(LogEvent::DeckReshuffled);\n+        }\n+        self.core\n+            .deck\n+            .pop()\n+            .expect(\"judge draw: deck or discard non-empty\")\n+    }\n+\n+    /// 从手牌或装备区移除一张（鬼道改判用：装备区黑牌可打出）。\n+    /// 不存在则 panic：调用方先验证。\n+    pub fn take_owned_card(&mut self, player: PlayerId, card: CardId) {\n+        let is_equip = self.catalog.card_kind(card).is_equip();\n+        let in_hand = self\n+            .core\n+            .player(player)\n+            .hand\n+            .iter()\n+            .position(|c| *c == card);\n+        if let Some(pos) = in_hand {\n+            self.core.player_mut(player).hand.remove(pos);\n+            self.note_cards_lost(player, &[card]);\n+            self.emit(EventData::CardsLost {\n+                player,\n+                cards: vec![card],\n+                origins: vec![crate::event::LostOrigin::Hand],\n+            });\n+            return;\n+        }\n+        let in_equips = self\n+            .core\n+            .player(player)\n+            .equips\n+            .iter()\n+            .position(|c| *c == card);\n+        if let Some(pos) = in_equips {\n+            self.core.player_mut(player).equips.remove(pos);\n+            if is_equip {\n+                crate::kernel::revoke_equip_skills(self.core, self.catalog, player, card);\n+            }\n+            self.note_cards_lost(player, &[card]);\n+            self.emit(EventData::CardsLost {\n+                player,\n+                cards: vec![card],\n+                origins: vec![crate::event::LostOrigin::Equip],\n+            });\n+            return;\n+        }\n+        panic!(\"card {card} not in hand or equips of {player}\");\n+    }\n+\n+    /// 从手牌移除一张（不存在则 panic：调用方先验证）。\n+    pub fn take_hand_card(&mut self, player: PlayerId, card: CardId) {\n+        let hand = &mut self.core.player_mut(player).hand;\n+        let pos = hand\n+            .iter()\n+            .position(|c| *c == card)\n+            .unwrap_or_else(|| panic!(\"card {card} not in hand of {player}\"));\n+        hand.remove(pos);\n+    }\n+\n+    /// 入弃牌堆（**牌区唯一性**：同一张牌不得同时属于两个区域）。\n+    ///\n+    /// NC07 修正（NC12 基线 §5.1 缺陷根因）：旧实现是无条件 `push`，当技能在\n+    /// 一张牌「正在被使用/结算」期间把它换出（如 swd 玉蝉换形）或某条路径重复\n+    /// 入堆时，同一张牌会在弃牌堆出现两次——引擎允许的活状态随即被自己的所有权\n+    /// 校验（`card_in_multiple_zones`）判非法，读档 30/30 被拒。现在：\n+    /// - 已在弃牌堆 → 幂等返回（不重复入堆）；\n+    /// - 从其它区域移出仍由调用方负责（`discard_from_hand`/`take_hand_card` 等），\n+    ///   本原语只保证**不重复入堆**——不改变既有调用方的区域语义。\n+    pub fn to_discard(&mut self, card: CardId) {\n+        if self.core.discard.contains(&card) {\n+            return;\n+        }\n+        self.core.discard.push(card);\n+    }\n+\n+    pub fn discard_from_hand(&mut self, player: PlayerId, card: CardId) {\n+        self.take_hand_card(player, card);\n+        self.to_discard(card);\n+        self.note_cards_lost(player, &[card]);\n+        self.emit(EventData::CardsLost {\n+            player,\n+            cards: vec![card],\n+            origins: vec![crate::event::LostOrigin::Hand],\n+        });\n+        self.out.push(LogEvent::CardDiscarded {\n+            player,\n+            cards: vec![card],\n+        });\n+    }\n+\n+    /// 义山记录（swd 批 123，规则 v310）：持有者失去牌时登记（上游\n+    /// `yishan2` loseEnd `storage.yishan.unshift` 同口径，新在前）。\n+    /// 覆盖原生三类丢失路径：弃置/交出/装备离场（登记差异：其余丢失路径\n+    /// 如移出游戏不记）。\n+    pub fn note_cards_lost(&mut self, player: PlayerId, cards: &[CardId]) {\n+        note_cards_lost(self.core, self.catalog, player, cards);\n+    }\n+\n+    /// 手牌置武将牌上（离场区，规则 v162 基建）：实体牌守恒——离开全部\n+    /// 正常区、随所有者存放（死亡清理由 DeathMachine leftover 之外的\n+    /// off_court 消费技自理，此处不做）。\n+    pub fn hand_to_off_court(&mut self, player: PlayerId, card: CardId) {\n+        self.take_hand_card(player, card);\n+        self.core.player_mut(player).off_court.push(card);\n+    }\n+\n+    /// 离场区牌弃置（消费技用）：出区入弃堆。\n+    pub fn off_court_discard(&mut self, player: PlayerId, card: CardId) {\n+        self.core\n+            .player_mut(player)\n+            .off_court\n+            .retain(|x| *x != card);\n+        self.to_discard(card);\n+    }\n+\n+    /// 虚拟用牌原语（规则 v169 基建，上游 game.useCard({name}) 同族）：\n+    /// 以牌堆底一张实体为载体、use_as 声明牌种发起一次完整使用管线\n+    /// （响应/伤害/弃置全走 use_as 分派）。载体经使用者手牌通道取出、\n+    /// 结算后入弃堆（登记差异：上游凭空造牌无实体不入弃堆）。返回载体。\n+    pub fn use_virtual_card(\n+        &mut self,\n+        source: PlayerId,\n+        as_kind: crate::catalog::CardKind,\n+        targets: Vec<PlayerId>,\n+    ) -> CardId {\n+        let carrier = self\n+            .core\n+            .deck\n+            .first()\n+            .copied()\n+            .expect(\"virtual use: deck empty\");\n+        self.core.deck.remove(0);\n+        self.core.player_mut(source).hand.push(carrier);\n+        self.emit(EventData::CardUsed(crate::event::CardUseData {\n+            card: carrier,\n+            player: source,\n+            targets,\n+            nature: crate::event::DamageNature::Normal,\n+            use_as: Some(as_kind),\n+            cancelled: false,\n+        }));\n+        carrier\n+    }\n+\n+    /// 手牌直接给予另一玩家（不进弃牌堆）——单张便捷形式，见 `give_hand_cards`。\n+    pub fn give_hand_card(&mut self, from: PlayerId, to: PlayerId, card: CardId) {\n+        self.give_hand_cards(from, to, &[card]);\n+    }\n+\n+    /// 一次给牌动作：`cards` 全部由 `from` 交给 `to`（不进弃牌堆）。\n+    ///\n+    /// `CardsLost`／`CardsMoved` 仍逐张发帧（既有口径；连营等失去牌监听不变）。\n+    /// `CardsGiven` 触发帧（DSL `cards_given`）**每次给牌动作只发一个**并携带\n+    /// 全部牌（规则 v326，裁决第 10 项）：事件主玩家=recipient、来源=giver、\n+    /// amount=张数，与旧线 `give_cards` 单事件同口径。一次给出多张的技能\n+    /// （仁德、蝶舞）须调用本方法，而不是按张循环 `give_hand_card`。\n+    pub fn give_hand_cards(&mut self, from: PlayerId, to: PlayerId, cards: &[CardId]) {\n+        if cards.is_empty() {\n+            return;\n+        }\n+        for &card in cards {\n+            self.take_hand_card(from, card);\n+            self.note_cards_lost(from, &[card]);\n+            self.emit(EventData::CardsLost {\n+                player: from,\n+                cards: vec![card],\n+                origins: vec![crate::event::LostOrigin::Hand],\n+            });\n+            self.core.player_mut(to).hand.push(card);\n+            self.emit(EventData::CardsMoved {\n+                cards: vec![card],\n+                from,\n+                to,\n+            });\n+        }\n+        self.emit(EventData::CardsGiven {\n+            giver: from,\n+            recipient: to,\n+            cards: cards.to_vec(),\n+        });\n+        self.out.push(LogEvent::CardsGiven {\n+            from,\n+            to,\n+            cards: cards.to_vec(),\n+        });\n+    }\n+\n+    // ---- 生命周期 ----\n+\n+    /// 回复体力（封顶 max_hp）。返回实际回复量。\n+    /// 护甲增减（G1 扩展）：下限 0；正数获得、负数失去。\n+    /// 海岛地图效果（mtg 第二批，规则 v101）：锁定、全局（上游\n+    /// addGlobalSkill 同口径）——current_land 为海岛时，目标获得护甲\n+    /// 若已受伤改为回复等量体力（失去护甲不触发）。海岛自身受伤分支\n+    /// 的取消路线为上游 _temp 标记口径（路径级抑制），由调用方绕过。\n+    pub fn change_hujia(&mut self, player: PlayerId, delta: i32) -> u8 {\n+        let p = self.core.player(player);\n+        if delta > 0\n+            && self.core.current_land == Some(crate::catalog::CardKind::Haidao)\n+            && p.alive\n+            && p.hp < p.max_hp as i32\n+        {\n+            self.recover(player, delta as u32, None);\n+            return self.core.player(player).hujia;\n+        }\n+        let cur = self.core.player(player).hujia as i32;\n+        let next = (cur + delta).max(0) as u8;\n+        self.core.player_mut(player).hujia = next;\n+        next\n+    }\n+\n+    /// 体力上限减少（max_hp 减面，运筹武将面批 9）：上限 -n 并钳体力\n+    ///（hp>max 时收齐）；不入 Recover 事件流（无 MaxHpChanged 事件种\n+    /// ——新事件种九处接线成本，无消费者，登记边界）。\n+    pub fn lose_max_hp(&mut self, player: PlayerId, amount: u32) {\n+        let p = self.core.player_mut(player);\n+        // 无限体力（上游 Infinity）：体力上限不减（Infinity - n = Infinity）。\n+        if p.infinite_hp() {\n+            self.out.push(LogEvent::MaxHpLost { player, amount: 0 });\n+            return;\n+        }\n+        let cut = (p.max_hp.min(amount)) as i32;\n+        p.max_hp -= cut as u32;\n+        if p.hp > p.max_hp as i32 {\n+            p.hp = p.max_hp as i32;\n+        }\n+        self.out.push(LogEvent::MaxHpLost {\n+            player,\n+            amount: cut as u32,\n+        });\n+    }\n+\n+    pub fn recover(&mut self, player: PlayerId, amount: u32, by_card: Option<CardId>) -> u32 {\n+        let p = self.core.player_mut(player);\n+        if !p.alive {\n+            return 0;\n+        }\n+        let before = p.hp;\n+        // 无限体力（上游 Infinity）：回复不改变体力（Infinity + n = Infinity）。\n+        if !p.infinite_hp() {\n+            p.hp = before.saturating_add(amount as i32).min(p.max_hp as i32);\n+        }\n+        let gained = (p.hp - before).max(0) as u32;\n+        if p.hp > 0 {\n+            p.dying = false;\n+        }\n+        if gained > 0 {\n+            self.emit(EventData::Recover {\n+                player,\n+                amount: gained,\n+                by_card,\n+            });\n+            self.out.push(LogEvent::HpRecovered {\n+                player,\n+                amount: gained,\n+            });\n+        }\n+        gained\n+    }\n+\n+    // ---- 技能实例 ----\n+\n+    /// Preserve native instance overwrite semantics and register a genuinely new subscription.\n+    pub fn insert_skill(&mut self, key: (PlayerId, crate::ids::SkillDefId), instance: crate::state::SkillInstance) -> Option<crate::state::SkillInstance> {\n+        let old = self.core.skills.insert(key, instance);\n+        if old.is_none() { crate::resolution::register_added(self.core, self.res, self.catalog, key.0, key.1); }\n+        old\n+    }\n+\n+    /// Insert only if absent; existing instances retain their limits and lifetime.\n+    pub fn ensure_skill(&mut self, key: (PlayerId, crate::ids::SkillDefId), instance: crate::state::SkillInstance) {\n+        if !self.core.skills.contains_key(&key) { self.insert_skill(key, instance); }\n+    }\n+\n+    pub fn skill_enabled(&self, owner: PlayerId, def: SkillDefId) -> bool {\n+        self.core.has_skill(owner, def)\n+    }\n+\n+    pub fn set_skill_enabled(&mut self, owner: PlayerId, def: SkillDefId, enabled: bool) {\n+        let key = (owner, def);\n+        if let Some(inst) = self.core.skills.get_mut(&key) {\n+            if inst.enabled != enabled {\n+                inst.enabled = enabled;\n+                let name = self.catalog.skill_name(def);\n+                self.emit(EventData::SkillToggled {\n+                    player: owner,\n+                    skill: def,\n+                    enabled,\n+                    temporary: false,\n+                });\n+                self.out.push(LogEvent::SkillToggled {\n+                    player: owner,\n+                    skill: name,\n+                    enabled,\n+                });\n+            }\n+        }\n+    }\n+\n+    /// 动态获得技能，至拥有者回合结束移除。\n+    pub fn add_skill_until_turn_end(&mut self, owner: PlayerId, def: SkillDefId) {\n+        let key = (owner, def);\n+        if let Some(inst) = self.core.skills.get_mut(&key) {\n+            inst.enabled = true;\n+            inst.expires_end_of_turn = true;\n+        } else {\n+            self.insert_skill(\n+                key,\n+                crate::state::SkillInstance {\n+                    owner,\n+                    enabled: true,\n+                    once_used: false,\n+                    expires_end_of_turn: true,\n+                    rounds: 0,\n+                },\n+            );\n+        }\n+        let name = self.catalog.skill_name(def);\n+        self.emit(EventData::SkillToggled {\n+            player: owner,\n+            skill: def,\n+            enabled: true,\n+            temporary: true,\n+        });\n+        self.out.push(LogEvent::SkillToggled {\n+            player: owner,\n+            skill: name,\n+            enabled: true,\n+        });\n+    }\n+\n+    /// 移除到期临时技能（回合结束提交时调用）。\n+    pub fn expire_temporary_skills(&mut self, owner: PlayerId) {\n+        let expired: Vec<SkillDefId> = self\n+            .core\n+            .skills\n+            .iter()\n+            .filter(|((o, _), i)| *o == owner && i.enabled && i.expires_end_of_turn)\n+            .map(|((_, d), _)| *d)\n+            .collect();\n+        for def in expired {\n+            if let Some(inst) = self.core.skills.get_mut(&(owner, def)) {\n+                inst.enabled = false;\n+                inst.expires_end_of_turn = false;\n+            }\n+            let name = self.catalog.skill_name(def);\n+            self.emit(EventData::SkillToggled {\n+                player: owner,\n+                skill: def,\n+                enabled: false,\n+                temporary: true,\n+            });\n+            self.out.push(LogEvent::SkillToggled {\n+                player: owner,\n+                skill: name,\n+                enabled: false,\n+            });\n+        }\n+    }\n+\n+    /// 重置 once_per_turn 标记（拥有者回合开始时调用）。\n+    pub fn reset_turn_limits(&mut self, owner: PlayerId) {\n+        for ((o, _), inst) in self.core.skills.iter_mut() {\n+            if *o == owner {\n+                inst.once_used = false;\n+            }\n+        }\n+    }\n+\n+    // ---- 日志 ----\n+\n+    pub fn log(&mut self, event: LogEvent) {\n+        self.out.push(event);\n+    }\n+}\n+\n+/// 便捷构造：普通伤害载荷。\n+pub fn damage_data(source: Option<PlayerId>, target: PlayerId, amount: i32) -> DamageData {\n+    damage_data_with(source, target, amount, DamageNature::Normal, None)\n+}\n+\n+/// 便捷构造：显式属性伤害载荷。\n+pub fn damage_data_with(\n+    source: Option<PlayerId>,\n+    target: PlayerId,\n+    amount: i32,\n+    nature: DamageNature,\n+    card: Option<CardId>,\n+) -> DamageData {\n+    DamageData {\n+                    settlement: Default::default(),\n+        source,\n+        target,\n+        amount,\n+        nature,\n+        prevented: false,\n+        redirect_chain: Vec::new(),\n+        card,\n+        from_chain: false,\n+    }\n+}\n+\n+/// 卡牌使用载荷构造（普通属性）。\n+pub fn card_use(card: CardId, player: PlayerId, targets: Vec<PlayerId>) -> CardUseData {\n+    card_use_as(card, player, targets, None)\n+}\n+\n+/// 带 view-as 声明的构造（转化使用时 `as_kind` = 声明牌种）。\n+pub fn card_use_as(\n+    card: CardId,\n+    player: PlayerId,\n+    targets: Vec<PlayerId>,\n+    as_kind: Option<CardKind>,\n+) -> CardUseData {\n+    CardUseData {\n+        card,\n+        player,\n+        targets,\n+        nature: DamageNature::Normal,\n+        use_as: as_kind,\n+        cancelled: false,\n+    }\n+}\n+\n+/// 卡牌使用载荷构造（显式属性，火杀用）。\n+pub fn card_use_with_nature(\n+    card: CardId,\n+    player: PlayerId,\n+    targets: Vec<PlayerId>,\n+    nature: DamageNature,\n+    use_as: Option<CardKind>,\n+) -> CardUseData {\n+    CardUseData {\n+        card,\n+        player,\n+        targets,\n+        nature,\n+        use_as,\n+        cancelled: false,\n+    }\n+}\n+\n+/// 义山记录（swd 批 123，规则 v310）自由函数：Ctx 与测试工具共用。\n+pub fn note_cards_lost(\n+    core: &mut GameStateCore,\n+    catalog: &crate::catalog::Catalog,\n+    player: PlayerId,\n+    cards: &[CardId],\n+) {\n+    let Some(def) = catalog.skill_by_name(\"yishan\") else {\n+        return;\n+    };\n+    if !core.has_skill(player, def) {\n+        return;\n+    }\n+    let list = &mut core.player_mut(player).yishan_lost;\n+    for c in cards {\n+        list.insert(0, *c);\n+    }\n+    if list.len() > 16 {\n+        list.truncate(16);\n+    }\n+}"},{"sha":"a02579ad0a0d865324ec5579fd5d3691386aae7b","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20-v3/baseline-changed/crates/engine-native-kernel/src/resolution.rs","status":"added","additions":667,"deletions":0,"changes":667,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fresolution.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fresolution.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fresolution.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1,667 @@\n+//! 显式事件栈调度器。\n+//!\n+//! 帧的推进是一条均匀状态机：\n+//! `BeforeTriggers -> Commit -> AfterTriggers (-> Intrinsic) -> Done -> 弹栈`；\n+//! 各阶段进入时收集触发队列（`planned` 门闩），队列按全序键逐个运行。\n+//! 机器可随时 emit 子帧并挂起（`parks` 按恢复深度唤醒），可请求选择\n+//! （`open_choice` + 应答校验后恢复）。预算耗尽时停止并让上层回滚。\n+\n+use crate::catalog::{QueryCtx, SkillMachine};\n+use crate::choice::{ChoiceOption, OpenChoice, Selection};\n+use crate::event::{EventData, EventKind, Frame, QueuedTrigger, Stage, Timing};\n+use crate::ids::{EventId, PlayerId, SkillDefId};\n+use crate::kernel;\n+use crate::machine::{Ctx, Flow, LogEvent};\n+use crate::state::GameStateCore;\n+mod trigger_order;\n+pub(crate) use trigger_order::event_kind as trigger_window_kind;\n+pub use trigger_order::{\n+    refresh_order_choice, register_added, sync_trigger_owners, validate_trigger_bindings,\n+    TriggerOrder,\n+};\n+\n+/// 挂起的机器与其归属槽位。\n+/// 无帧哨兵（N11 主动技等会话级挂起）：槽不关联任何栈帧时使用，\n+/// 恢复校验对其豁免帧存在性检查（真实帧 id 从事件号单调递增，不会撞上）。\n+pub const NO_FRAME: u32 = u32::MAX;\n+\n+pub struct Park {\n+    /// 栈深回到该值时恢复。\n+    pub resume_depth: usize,\n+    pub slot: Slot,\n+    pub machine: Box<dyn SkillMachine>,\n+}\n+\n+impl Clone for Park {\n+    fn clone(&self) -> Self {\n+        Self {\n+            resume_depth: self.resume_depth,\n+            slot: self.slot,\n+            machine: self.machine.fork(),\n+        }\n+    }\n+}\n+\n+/// The formal ready consumer: effect/admission parks precede their suspended order park.\n+/// This read-only selection conveys neither answer nor execution authority.\n+pub fn ready_park_index(res: &Resolution) -> Option<usize> {\n+    res.parks.iter().position(|park| {\n+        park.resume_depth == res.stack.len() && park.machine.trigger_order().is_none()\n+    }).or_else(|| res.parks.iter().position(|park| park.resume_depth == res.stack.len()))\n+}\n+\n+/// 机器归属：帧固有流程，或某帧上的一次触发。\n+#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n+pub enum Slot {\n+    Intrinsic { frame: EventId },\n+    Trigger { frame: EventId },\n+}\n+\n+/// 执行位置：事件栈 + 挂起机器 + 开放选择。\n+#[derive(Clone)]\n+pub struct Resolution {\n+    pub next_event_id: EventId,\n+    pub next_choice_id: u64,\n+    pub stack: Vec<Frame>,\n+    pub parks: Vec<Park>,\n+    pub open_choice: Option<OpenChoice>,\n+    /// 已校验、待机器读取的应答。\n+    pub answer: Option<Selection>,\n+    pub budget: u32,\n+    /// VM 执行故障（NC04，瞬态：命令结束时清空，不入快照/哈希）。\n+    pub fault: Option<crate::machine::VmFault>,\n+}\n+\n+impl Resolution {\n+    pub fn new(budget: u32) -> Self {\n+        Self {\n+            next_event_id: 1,\n+            next_choice_id: 1,\n+            stack: Vec::new(),\n+            parks: Vec::new(),\n+            open_choice: None,\n+            answer: None,\n+            budget,\n+            fault: None,\n+        }\n+    }\n+\n+    pub fn frame(&self, id: EventId) -> Option<&Frame> {\n+        self.stack.iter().find(|f| f.id == id)\n+    }\n+\n+    pub fn frame_mut(&mut self, id: EventId) -> Option<&mut Frame> {\n+        self.stack.iter_mut().find(|f| f.id == id)\n+    }\n+}\n+\n+impl std::fmt::Debug for Resolution {\n+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n+        f.debug_struct(\"Resolution\")\n+            .field(\"next_event_id\", &self.next_event_id)\n+            .field(\"next_choice_id\", &self.next_choice_id)\n+            .field(\"stack\", &self.stack)\n+            .field(\"parks\", &self.parks.len())\n+            .field(\"open_choice\", &self.open_choice)\n+            .field(\"budget\", &self.budget)\n+            .finish()\n+    }\n+}\n+\n+/// 压入事件帧（命令处理器与机器共用的入栈路径）。\n+pub fn push_frame(res: &mut Resolution, data: crate::event::EventData) -> EventId {\n+    let id = res.next_event_id;\n+    res.next_event_id += 1;\n+    let parent = res.stack.last().map(|f| f.id);\n+    let kind = data.kind();\n+    let stage = match kind {\n+        EventKind::Damage => Stage::BeforeTriggers,\n+        // E03 翻面：前置取消窗口（漩涡面具等锁定技在 Commit 前派发）\n+        EventKind::TurnOverBefore => Stage::BeforeTriggers,\n+        // 装备前置窗口（swd 批 143 改造，规则 v318）：BeforeTriggers 派发\n+        // useCardToBegin 类技（改造改写装备栏后再入槽）\n+        EventKind::Equipped => Stage::BeforeTriggers,\n+        // 死亡前置窗口（规则 v170）：BeforeTriggers 收集 dieBegin 类遗\n+        // 言/拦截技（changan 氏），Intrinsic 仍为 DeathMachine。\n+        EventKind::Death => Stage::BeforeTriggers,\n+        // 阶段开始前置窗口（PA12 批⑤-2，计划 §2 K）：PhaseBegin 触发的\n+        // 技能（VM/宿主）须在阶段入场行为（commit_phase→begin_*：摸牌等）\n+        // **之前**执行——「阶段开始时可跳过/改写本阶段」类技能（奋励\n+        // skip_current_phase）依赖此前置窗；此前起步 Commit 段导致 VM 机\n+        // 器在摸牌后才跑（批⑤首步实测：确认门打开时已摸 2）。\n+        EventKind::PhaseBegin => Stage::BeforeTriggers,\n+        _ => Stage::Commit,\n+    };\n+    res.stack.push(Frame {\n+        id,\n+        parent,\n+        kind,\n+        data,\n+        stage,\n+        queue: Vec::new(),\n+        planned: false,\n+        intrinsic_done: false,\n+    });\n+    id\n+}\n+\n+/// 单次 `run` 的结果。\n+#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n+pub enum StepOutcome {\n+    /// 栈空且无挂起：本段结算完成。\n+    Done,\n+    /// 等待选择应答。\n+    Pending,\n+    /// 预算耗尽（上层应回滚）。\n+    BudgetExhausted,\n+    /// 宿主时间片耗尽：状态在当前步边界一致，可在续行时无损接续\n+    /// （与硬性预算上限不同——不回滚，见 ADR 0707）。\n+    Yielded,\n+    /// VM 执行故障（NC04）：上层必须整段回滚并以 `RejectReason::VmFault`\n+    /// 拒绝命令，不得按正常规则继续。\n+    Fault,\n+}\n+\n+/// 阶段推进表。\n+fn next_stage(kind: EventKind, cur: Stage) -> Stage {\n+    match (kind, cur) {\n+        (EventKind::Damage, Stage::BeforeTriggers) => Stage::Commit,\n+        (EventKind::Damage, Stage::Commit) => Stage::AfterTriggers,\n+        (EventKind::Damage, Stage::AfterTriggers) => Stage::Intrinsic,\n+        (EventKind::Damage, Stage::Intrinsic) => Stage::Done,\n+        // E03 翻面：BeforeTriggers 派发前置取消（漩涡面具写回 cancelled）\n+        // → AfterTriggers 静默（无 after 触发）→ Commit 执行翻转。\n+        (EventKind::TurnOverBefore, Stage::BeforeTriggers) => Stage::AfterTriggers,\n+        (EventKind::TurnOverBefore, Stage::AfterTriggers) => Stage::Commit,\n+        (EventKind::TurnOverBefore, Stage::Commit) => Stage::Done,\n+        (EventKind::Equipped, Stage::BeforeTriggers) => Stage::Commit,\n+        (EventKind::CardUsed, Stage::Commit) => Stage::AfterTriggers,\n+        (EventKind::CardUsed, Stage::AfterTriggers) => Stage::Intrinsic,\n+        (EventKind::CardUsed, Stage::Intrinsic) => Stage::Done,\n+        (EventKind::Dying, Stage::Commit) => Stage::AfterTriggers,\n+        (EventKind::Dying, Stage::AfterTriggers) => Stage::Intrinsic,\n+        (EventKind::Dying, Stage::Intrinsic) => Stage::Done,\n+        (EventKind::Death, Stage::BeforeTriggers) => Stage::AfterTriggers,\n+        (EventKind::Death, Stage::AfterTriggers) => Stage::Intrinsic,\n+        (EventKind::Death, Stage::Intrinsic) => Stage::Done,\n+        // PA12 批⑤-2：PhaseBegin 前置窗（技能跑位）→ Commit（入场行为\n+        // begin_*）→ AfterTriggers → Intrinsic → Done。\n+        (EventKind::PhaseBegin, Stage::BeforeTriggers) => Stage::Commit,\n+        (EventKind::PhaseBegin, Stage::Commit) => Stage::AfterTriggers,\n+        (EventKind::PhaseBegin, Stage::AfterTriggers) => Stage::Intrinsic,\n+        (EventKind::PhaseBegin, Stage::Intrinsic) => Stage::Done,\n+        (EventKind::PhaseEnd, Stage::AfterTriggers) => Stage::Intrinsic,\n+        (EventKind::PhaseEnd, Stage::Intrinsic) => Stage::Done,\n+        (_, Stage::Commit) => Stage::AfterTriggers,\n+        (_, Stage::AfterTriggers) => Stage::Done,\n+        (_, cur) => cur,\n+    }\n+}\n+\n+/// 可选触发的确认闸门：确认后才启动真正的技能机器。\n+pub struct OptionalGate {\n+    owner: PlayerId,\n+    def: SkillDefId,\n+    /// 计划时的事件载荷（触发语义以进入时为准）。\n+    event: crate::event::EventData,\n+    asked: bool,\n+    inner: Option<Box<dyn SkillMachine>>,\n+}\n+\n+impl OptionalGate {\n+    /// 运行时构造（触发入队时）与快照恢复共用。\n+    pub(crate) fn new(\n+        owner: PlayerId,\n+        def: SkillDefId,\n+        event: crate::event::EventData,\n+        asked: bool,\n+        inner: Option<Box<dyn SkillMachine>>,\n+    ) -> Self {\n+        Self {\n+            owner,\n+            def,\n+            event,\n+            asked,\n+            inner,\n+        }\n+    }\n+}\n+\n+impl SkillMachine for OptionalGate {\n+    fn fork(&self) -> Box<dyn SkillMachine> {\n+        Box::new(Self {\n+            owner: self.owner,\n+            def: self.def,\n+            event: self.event.clone(),\n+            asked: self.asked,\n+            inner: self.inner.as_ref().map(|m| m.fork()),\n+        })\n+    }\n+\n+    fn snapshot(&self) -> crate::snap::MachineSnapshot {\n+        crate::snap::MachineSnapshot::OptionalGate {\n+            owner: self.owner,\n+            def: self.def,\n+            event: self.event.clone(),\n+            asked: self.asked,\n+            inner: self.inner.as_ref().map(|m| Box::new(m.snapshot())),\n+        }\n+    }\n+\n+    fn step(&mut self, ctx: &mut Ctx<'_>) -> Flow {\n+        // 内层机器存在即全权委托（其后续选择由内层自行发起）\n+        if let Some(inner) = self.inner.as_mut() {\n+            let flow = inner.step(ctx);\n+            if matches!(flow, Flow::Done) {\n+                self.inner = None;\n+                return Flow::Done;\n+            }\n+            return flow;\n+        }\n+        let Some(frame) = ctx.res.stack.last() else {\n+            return Flow::Done;\n+        };\n+        let qt = QueuedTrigger {\n+            owner: self.owner,\n+            def: self.def,\n+            order: (0, 0, 0, 0, self.def),\n+        };\n+        if !trigger_order::eligible(\n+            ctx.core,\n+            ctx.catalog,\n+            &qt,\n+            crate::event::damage_event(&ctx.res.stack,frame),\n+            trigger_order::event_kind(frame),\n+        ) {\n+            return Flow::Done;\n+        }\n+        let kind = trigger_order::event_kind(frame);\n+        self.event = frame.data.clone();\n+        if !self.asked {\n+            self.asked = true;\n+            return Flow::WaitChoice {\n+                observer: self.owner,\n+                spec: crate::choice::ChoiceSpec::confirm(\"trigger_confirm\"),\n+            };\n+        }\n+        if !ctx.answer().contains(&ChoiceOption::Confirm) {\n+            return Flow::Done;\n+        }\n+        {\n+            let def = &ctx.catalog.skills[self.def as usize];\n+            if def.limits.once_per_turn {\n+                if let Some(inst) = ctx.core.skills.get_mut(&(self.owner, self.def)) {\n+                    if inst.once_used {\n+                        return Flow::Done;\n+                    }\n+                    inst.once_used = true;\n+                }\n+            }\n+            ctx.log(LogEvent::SkillTriggered {\n+                skill: def.name,\n+                owner: self.owner,\n+            });\n+            let event=crate::event::damage_event(&ctx.res.stack,ctx.res.stack.last().expect(\"frame\")).clone();\n+            self.inner = Some(def.behavior.start_in_window(&ctx.query(), self.owner, &event, kind));\n+        }\n+        let flow = self.inner.as_mut().expect(\"inner started\").step(ctx);\n+        if matches!(flow, Flow::Done) {\n+            self.inner = None;\n+            Flow::Done\n+        } else {\n+            flow\n+        }\n+    }\n+}\n+\n+/// 收集当前阶段的触发队列。\n+fn plan_triggers(\n+    core: &mut GameStateCore,\n+    res: &mut Resolution,\n+    catalog: &crate::catalog::Catalog,\n+    frame_id: EventId,\n+    before: bool,\n+) {\n+    let kind = {\n+        let f = res.frame(frame_id).expect(\"frame\");\n+        // before 阶段：伤害帧查 DamageBefore（伤害前置窗口）；翻面帧查\n+        // TurnOverBefore（E03 翻面前置取消窗口，漩涡面具等锁定技）；\n+        // 其余帧无前置窗口。\n+        // 翻面帧的 after 窗口静默：目录无「翻面后」触发种类，且 after\n+        // 再查 TurnOverBefore 会让取消技重复入队重复写回。\n+        if !before\n+            && (matches!(f.data, EventData::TurnOverBefore { .. })\n+                || matches!(f.data, EventData::Death { .. }))\n+        {\n+            // E03 翻面 / 死亡前置窗口（规则 v170）：目录无「翻面后/死亡\n+            // 后」触发种类，且 after 再查会令取消/遗言技重复入队。\n+            let f = res.frame_mut(frame_id).expect(\"frame\");\n+            f.queue = Vec::new();\n+            f.planned = true;\n+            return;\n+        }\n+        let before_kind = match &f.data {\n+            EventData::TurnOverBefore { .. } => EventKind::TurnOverBefore,\n+            EventData::Death { .. } => EventKind::Death,\n+            // PA12 批⑤-2（§2 K）：PhaseBegin 前置窗按帧自身 kind 查——\n+            // 阶段开始类技能（奋励 skip 系）在入场行为之前派发；after 段\n+            // 静默（上方列表）防同技重复入队。宿主 PhaseBegin 技能的执行\n+            // 点随此前移到 begin_* 之前（上游 phaseBegin 语义），全量回归\n+            // 把关、规则基准登记。\n+            EventData::Phase { begin: true, .. } => EventKind::PhaseBegin,\n+            _ => EventKind::DamageBefore,\n+        };\n+        if before {\n+            before_kind\n+        } else {\n+            f.kind\n+        }\n+    };\n+    if let EventData::Damage(d) = &res.frame(frame_id).expect(\"frame\").data {\n+        if !before && (d.settlement.committed_damage.is_none() || d.settlement.outcome != crate::event::DamageOutcome::Running || d.settlement.notrigger || d.amount <= 0) {\n+            let f=res.frame_mut(frame_id).unwrap();f.queue.clear();f.planned=true;return;\n+        }\n+    }\n+    let mut entries: Vec<QueuedTrigger> = Vec::new();\n+    let turn_current = core.turn.current;\n+    // PA01 活跃触发索引：候选遍历的代价与本局是否持有无关（目录 6215 技能\n+    // 档曾令 8 座提交 p50 ×3.3），改为从实例侧单遍出发，直接比对定义的\n+    // 触发元数据——dispatch 列表即由 event/extra_events 构建，成员关系\n+    // 严格等价。入队集合不变；最终顺序由下方含 def_id 的全序键决定，\n+    // 与遍历序无关。\n+    for ((owner, def_id), _) in core.skills.range(..) {\n+        let def = &catalog.skills[*def_id as usize];\n+        let Some(meta) = def.trigger.as_ref() else {\n+            continue;\n+        };\n+        if meta.event != kind && !meta.extra_events.contains(&kind) {\n+            continue;\n+        }\n+        // PA12 批⑤-2：PhaseBegin 前置窗只前移 VM 技能——宿主技保持在\n+        // 入场行为之后的原执行点（61 个宿主 PhaseBegin 技能与 golden 的\n+        // 行为不变；全量回归实测：不过滤时 16 个宿主技能/golden 失败）。\n+        // 前置窗（before=true）：PhaseBegin 只前移 VM 技能（宿主技保持\n+        // 原执行点——61 个宿主 PhaseBegin 技能与 golden 行为不变；全量实测\n+        // 不过滤时 16 项失败）；after 段（before=false）：VM 技能已在前置\n+        // 窗跑过，跳过防重复入队，宿主技照常派发。\n+        if kind == EventKind::PhaseBegin && def.behavior.is_vm_skill() != before {\n+            continue;\n+        }\n+        // NC01：触发结算顺序按**顺座次序**（不是最短距离）\n+        let seat_rel = core.seat_steps_from(turn_current, *owner);\n+        entries.push(QueuedTrigger {\n+            def: *def_id,\n+            owner: *owner,\n+            order: (\n+                match meta.timing {\n+                    Timing::First => 0,\n+                    Timing::Normal => 1,\n+                    Timing::Last => 2,\n+                },\n+                meta.priority,\n+                0,\n+                seat_rel,\n+                *def_id,\n+            ),\n+        });\n+    }\n+    entries.sort_by(trigger_order::compare);\n+    let f = res.frame_mut(frame_id).expect(\"frame\");\n+    f.queue = entries;\n+    f.planned = true;\n+}\n+\n+/// 调度主循环。`slice` 为宿主时间片（None = 不限）：每完成一个调度步\n+/// 计一次数，片内步数用尽即在步边界返回 `Yielded`——状态此时自洽，\n+/// 续行（重新调用 run）与不分片连续运行产出完全相同的轨迹（ADR 0707）。\n+/// `budget` 是段内硬上限：耗尽返回 `BudgetExhausted` 由上层回滚。\n+pub fn run(\n+    core: &mut GameStateCore,\n+    res: &mut Resolution,\n+    catalog: &crate::catalog::Catalog,\n+    out: &mut Vec<LogEvent>,\n+    slice: Option<u32>,\n+) -> StepOutcome {\n+    let mut steps: u32 = 0;\n+    loop {\n+        if let Some(fault) = res.fault.take() {\n+            res.fault = Some(fault);\n+            return StepOutcome::Fault;\n+        }\n+        if res.budget == 0 {\n+            return StepOutcome::BudgetExhausted;\n+        }\n+        if let Some(limit) = slice {\n+            if steps >= limit {\n+                return StepOutcome::Yielded;\n+            }\n+        }\n+        steps += 1;\n+        res.budget -= 1;\n+\n+        // Canonical source liveness is refreshed before every collector/choice/confirmation/start.\n+        for frame in &mut res.stack {\n+            if let EventData::Damage(d)=&mut frame.data {\n+                if d.source.is_some_and(|source|!core.player(source).alive) {d.source=None;}\n+            }\n+        }\n+\n+        // A) 恢复深度匹配的挂起机器\n+        if res.open_choice.is_none() {\n+            if let Some(idx) = ready_park_index(res) {\n+                let mut park = res.parks.remove(idx);\n+                let prior_skills: std::collections::BTreeSet<_> =\n+                    core.skills.keys().copied().collect();\n+                let flow = {\n+                    let mut ctx = Ctx {\n+                        core,\n+                        res,\n+                        catalog,\n+                        out,\n+                    };\n+                    park.machine.step(&mut ctx)\n+                };\n+                notify_new_skills(core, res, catalog, &prior_skills);\n+                res.answer = None; // 应答只消费一次\n+                match flow {\n+                    Flow::Done => finish_slot(res, park.slot),\n+                    Flow::Yield => {\n+                        if park.machine.trigger_order().is_some() {\n+                            res.parks.insert(0, park);\n+                        } else {\n+                            res.parks.push(park);\n+                        }\n+                    }\n+                    Flow::WaitChoice { observer, spec } => {\n+                        let id = res.next_choice_id;\n+                        res.next_choice_id += 1;\n+                        out.push(LogEvent::ChoiceOpened {\n+                            id,\n+                            observer,\n+                            prompt: spec.prompt,\n+                        });\n+                        res.open_choice = Some(OpenChoice { id, observer, spec });\n+                        // 应答恢复点＝**开窗时刻**的栈深。机器可能在挂起期间\n+                        // 发射过子帧（如 AOE 逐目标派发：前一目标的伤害帧\n+                        // 尚未结算就为下一目标开响应窗），此时沿用创建时的\n+                        // 旧深度会与其它挂起机器错配——应答被深度恰好相等\n+                        // 的**别的**机器消费（AOE→昏迷应答错配：目标机器\n+                        // 恢复时 answer 已空，panic 实证）。开窗后对局暂停\n+                        // （open_choice 存在时不推进栈），故开窗时刻的栈深\n+                        // 即恢复点。\n+                        park.resume_depth = res.stack.len();\n+                        res.parks.push(park);\n+                        return StepOutcome::Pending;\n+                    }\n+                }\n+                continue;\n+            }\n+        }\n+\n+        // B) 栈顶帧推进\n+        let Some(top) = res.stack.last().map(|f| f.id) else {\n+            return StepOutcome::Done;\n+        };\n+        let (stage, queue_len, planned, intrinsic_done) = {\n+            let f = res.frame(top).expect(\"top frame\");\n+            (f.stage, f.queue.len(), f.planned, f.intrinsic_done)\n+        };\n+        match stage {\n+            Stage::BeforeTriggers | Stage::AfterTriggers => {\n+                if !planned {\n+                    plan_triggers(core, res, catalog, top, stage == Stage::BeforeTriggers);\n+                    res.parks.push(Park {\n+                        resume_depth: res.stack.len(),\n+                        slot: Slot::Trigger { frame: top },\n+                        machine: Box::new(TriggerOrder::new(top, core)),\n+                    });\n+                    continue;\n+                }\n+                assert_eq!(queue_len, 0, \"window machine drains its frame queue\");\n+                let kind = res.frame(top).expect(\"frame\").kind;\n+                let next = next_stage(kind, stage);\n+                let f = res.frame_mut(top).expect(\"frame\");\n+                f.stage = next;\n+                f.planned = false;\n+            }\n+            Stage::Commit => {\n+                let prior_skills: std::collections::BTreeSet<_> =\n+                    core.skills.keys().copied().collect();\n+                {\n+                    let mut ctx = Ctx {\n+                        core,\n+                        res,\n+                        catalog,\n+                        out,\n+                    };\n+                    kernel::commit_frame(&mut ctx, top);\n+                }\n+                notify_new_skills(core, res, catalog, &prior_skills);\n+                let kind = res.frame(top).expect(\"frame\").kind;\n+                let next = next_stage(kind, Stage::Commit);\n+                let f = res.frame_mut(top).expect(\"frame\");\n+                f.stage = next;\n+                f.planned = false;\n+            }\n+            Stage::Intrinsic => {\n+                if intrinsic_done {\n+                    let kind = res.frame(top).expect(\"frame\").kind;\n+                    let next = next_stage(kind, Stage::Intrinsic);\n+                    res.frame_mut(top).expect(\"frame\").stage = next;\n+                    continue;\n+                }\n+                let machine = {\n+                    let mut ctx = Ctx {\n+                        core,\n+                        res,\n+                        catalog,\n+                        out,\n+                    };\n+                    kernel::intrinsic_machine(&mut ctx, top)\n+                };\n+                match machine {\n+                    Some(m) => res.parks.push(Park {\n+                        resume_depth: res.stack.len(),\n+                        slot: Slot::Intrinsic { frame: top },\n+                        machine: m,\n+                    }),\n+                    None => res.frame_mut(top).expect(\"frame\").intrinsic_done = true,\n+                }\n+            }\n+            Stage::Done => {\n+                res.stack.pop();\n+            }\n+        }\n+    }\n+}\n+\n+fn start_queued_trigger(\n+    core: &mut GameStateCore,\n+    res: &mut Resolution,\n+    catalog: &crate::catalog::Catalog,\n+    out: &mut Vec<LogEvent>,\n+    frame_id: EventId,\n+    def_id: SkillDefId,\n+    owner: PlayerId,\n+) {\n+    let Some(index) = res.frame(frame_id).and_then(|f| {\n+        f.queue\n+            .iter()\n+            .position(|q| q.def == def_id && q.owner == owner)\n+    }) else {\n+        return;\n+    };\n+    let qt = res.frame_mut(frame_id).expect(\"frame\").queue.remove(index);\n+    let event = res.frame(frame_id).expect(\"frame\").data.clone();\n+    let actual_event=crate::event::damage_event(&res.stack,res.frame(frame_id).expect(\"frame\")).clone();\n+    if !trigger_order::eligible(\n+        core,\n+        catalog,\n+        &qt,\n+        &actual_event,\n+        trigger_order::event_kind(res.frame(frame_id).expect(\"frame\")),\n+    ) {\n+        return;\n+    }\n+    let def = &catalog.skills[qt.def as usize];\n+    let meta = def.trigger.as_ref().expect(\"eligible meta\");\n+    let machine: Box<dyn SkillMachine> = if meta.optional {\n+        Box::new(OptionalGate {\n+            owner: qt.owner,\n+            def: qt.def,\n+            event,\n+            asked: false,\n+            inner: None,\n+        })\n+    } else {\n+        if def.limits.once_per_turn {\n+            let inst = core.skills.get_mut(&(qt.owner, qt.def)).expect(\"instance\");\n+            if inst.once_used {\n+                return;\n+            }\n+            inst.once_used = true;\n+        }\n+        out.push(LogEvent::SkillTriggered {\n+            skill: def.name,\n+            owner: qt.owner,\n+        });\n+        def.behavior.start_in_window(\n+            &QueryCtx {\n+                state: core,\n+                catalog,\n+            },\n+            qt.owner,\n+            &actual_event,\n+            trigger_order::event_kind(res.frame(frame_id).expect(\"frame\")),\n+        )\n+    };\n+    res.parks.push(Park {\n+        resume_depth: res.stack.len(),\n+        slot: Slot::Trigger { frame: frame_id },\n+        machine,\n+    });\n+}\n+\n+fn finish_slot(res: &mut Resolution, slot: Slot) {\n+    if let Slot::Intrinsic { frame } = slot {\n+        if frame == NO_FRAME {\n+            return; // 会话级挂起槽无关联帧\n+        }\n+        if let Some(f) = res.frame_mut(frame) {\n+            f.intrinsic_done = true;\n+        }\n+    }\n+}\n+\n+// Core equipment/general assembly has no Resolution dependency; observe new keys at its step boundary.\n+fn notify_new_skills(\n+    core: &GameStateCore,\n+    res: &mut Resolution,\n+    catalog: &crate::catalog::Catalog,\n+    prior: &std::collections::BTreeSet<(PlayerId, SkillDefId)>,\n+) {\n+    sync_trigger_owners(core, res);\n+    for &(owner, def) in core.skills.keys().filter(|key| !prior.contains(key)) {\n+        register_added(core, res, catalog, owner, def);\n+    }\n+}"},{"sha":"b636ecc79093cf70e425d95f5eb0f5848b4f15cc","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20-v3/baseline-changed/crates/engine-native-kernel/src/resolution/trigger_order.rs","status":"added","additions":700,"deletions":0,"changes":700,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fresolution%2Ftrigger_order.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fresolution%2Ftrigger_order.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fresolution%2Ftrigger_order.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1,700 @@\n+//! One recoverable window over Frame.queue, including automatic and interactive dispatch.\n+use super::*;\n+use crate::catalog::Catalog;\n+use crate::choice::{ChoiceKind, ChoiceSpec};\n+use crate::snap::{MachineSnapshot, ResolutionSnapshot, SnapshotError};\n+use std::cmp::Ordering;\n+\n+pub(super) fn compare(a: &QueuedTrigger, b: &QueuedTrigger) -> Ordering {\n+    a.order\n+        .0\n+        .cmp(&b.order.0)\n+        .then_with(|| {\n+            if a.order.0 == 1 {\n+                a.order\n+                    .3\n+                    .cmp(&b.order.3)\n+                    .then_with(|| b.order.1.cmp(&a.order.1))\n+            } else {\n+                b.order\n+                    .1\n+                    .cmp(&a.order.1)\n+                    .then_with(|| a.order.3.cmp(&b.order.3))\n+            }\n+        })\n+        .then_with(|| a.def.cmp(&b.def))\n+}\n+fn bucket(q: &QueuedTrigger, seats: usize) -> u16 {\n+    match q.order.0 {\n+        0 => 0,\n+        1 => u16::from(q.order.3) + 1,\n+        _ => seats as u16 + 1,\n+    }\n+}\n+pub(crate) fn event_kind(frame: &Frame) -> EventKind {\n+    if frame.stage == Stage::BeforeTriggers && frame.kind == EventKind::Damage {\n+        EventKind::DamageBefore\n+    } else {\n+        frame.kind\n+    }\n+}\n+fn subscribes(catalog: &Catalog, def: SkillDefId, frame: &Frame) -> bool {\n+    let Some(def) = catalog.skills.get(def as usize) else {\n+        return false;\n+    };\n+    let Some(meta) = &def.trigger else {\n+        return false;\n+    };\n+    let kind = event_kind(frame);\n+    (meta.event == kind || meta.extra_events.contains(&kind))\n+        && (kind != EventKind::PhaseBegin\n+            || def.behavior.is_vm_skill() == (frame.stage == Stage::BeforeTriggers))\n+}\n+pub(super) fn eligible(\n+    core: &GameStateCore,\n+    catalog: &Catalog,\n+    q: &QueuedTrigger,\n+    event: &EventData,\n+    kind: EventKind,\n+) -> bool {\n+    if let EventData::Damage(d)=event {\n+        let terminal=matches!((kind,d.settlement.outcome),(EventKind::DamageZero,crate::event::DamageOutcome::Zero)|(EventKind::DamageCancelled,crate::event::DamageOutcome::Cancelled));\n+        if !terminal && (d.amount<=0 || d.prevented || d.settlement.notrigger || d.settlement.outcome!=crate::event::DamageOutcome::Running) {return false;}\n+    }\n+    if matches!(event, EventData::Death { player, .. } if core.player(*player).death_cancelled) {\n+        return false;\n+    }\n+    let Some(inst) = core.skills.get(&(q.owner, q.def)) else {\n+        return false;\n+    };\n+    let Some(def) = catalog.skills.get(q.def as usize) else {\n+        return false;\n+    };\n+    let Some(meta) = &def.trigger else {\n+        return false;\n+    };\n+    inst.enabled\n+        && core.player(q.owner).alive\n+        && (!def.limits.once_per_turn || !inst.once_used)\n+        && (meta.event == kind || meta.extra_events.contains(&kind))\n+        && def.behavior.filter_in_window(\n+            &QueryCtx {\n+                state: core,\n+                catalog,\n+            },\n+            q.owner,\n+            event,\n+            kind,\n+        )\n+}\n+fn group(\n+    core: &GameStateCore,\n+    frames: &[Frame],\n+    frame: &Frame,\n+    catalog: &Catalog,\n+    cursor: u16,\n+    seats: usize,\n+) -> Vec<QueuedTrigger> {\n+    let mut available = frame.queue.iter().filter(|q| {\n+        bucket(q, seats) == cursor && eligible(core, catalog, q, crate::event::damage_event(frames,frame), event_kind(frame))\n+    });\n+    let Some(first) = available.next().cloned() else {\n+        return Vec::new();\n+    };\n+    let mut result = vec![first.clone()];\n+    if first.order.0 == 1 {\n+        result.extend(available.filter(|q| q.order.1 == first.order.1).cloned());\n+        result.sort_by_key(|q| q.def);\n+    }\n+    result\n+}\n+\n+pub struct TriggerOrder {\n+    pub frame: EventId,\n+    pub owner: PlayerId,\n+    pub candidates: Vec<SkillDefId>,\n+    pub asked: bool,\n+    pub cursor: u16,\n+    pub done: Vec<(PlayerId, SkillDefId)>,\n+    pub owners: Vec<PlayerId>,\n+    pub normal_owners: u16,\n+}\n+impl TriggerOrder {\n+    pub(super) fn new(frame: EventId, core: &GameStateCore) -> Self {\n+        let mut owners: Vec<_> = (0..core.players.len() as PlayerId).collect();\n+        owners.sort_by_key(|owner| core.seat_steps_from(core.turn.current, *owner));\n+        Self {\n+            frame,\n+            owner: 0,\n+            candidates: Vec::new(),\n+            asked: false,\n+            cursor: 0,\n+            done: Vec::new(),\n+            normal_owners: owners.len() as u16,\n+            owners,\n+        }\n+    }\n+    fn start(&mut self, ctx: &mut Ctx<'_>, selected: &QueuedTrigger) {\n+        self.done.push((selected.owner, selected.def));\n+        start_queued_trigger(\n+            ctx.core,\n+            ctx.res,\n+            ctx.catalog,\n+            ctx.out,\n+            self.frame,\n+            selected.def,\n+            selected.owner,\n+        );\n+    }\n+}\n+impl SkillMachine for TriggerOrder {\n+    fn trigger_order(&self) -> Option<&TriggerOrder> {\n+        Some(self)\n+    }\n+    fn trigger_order_mut(&mut self) -> Option<&mut TriggerOrder> {\n+        Some(self)\n+    }\n+    fn fork(&self) -> Box<dyn SkillMachine> {\n+        Box::new(Self {\n+            frame: self.frame,\n+            owner: self.owner,\n+            candidates: self.candidates.clone(),\n+            asked: self.asked,\n+            cursor: self.cursor,\n+            done: self.done.clone(),\n+            owners: self.owners.clone(),\n+            normal_owners: self.normal_owners,\n+        })\n+    }\n+    fn snapshot(&self) -> MachineSnapshot {\n+        MachineSnapshot::TriggerOrder {\n+            frame: self.frame,\n+            owner: self.owner,\n+            candidates: self.candidates.clone(),\n+            asked: self.asked,\n+            cursor: self.cursor,\n+            done: self.done.clone(),\n+            owners: self.owners.clone(),\n+            normal_owners: self.normal_owners,\n+        }\n+    }\n+    fn step(&mut self, ctx: &mut Ctx<'_>) -> Flow {\n+        let Some(frame) = ctx.res.frame(self.frame) else {\n+            return Flow::Done;\n+        };\n+        let mut current = group(\n+            ctx.core,\n+            &ctx.res.stack,\n+            frame,\n+            ctx.catalog,\n+            self.cursor,\n+            self.normal_owners as usize,\n+        );\n+        if self.asked {\n+            let selected = match ctx.answer().first() {\n+                Some(ChoiceOption::Skill(def)) if self.candidates.contains(def) => current\n+                    .iter()\n+                    .find(|q| q.def == *def && q.owner == self.owner)\n+                    .cloned(),\n+                _ => None,\n+            };\n+            self.asked = false;\n+            self.candidates.clear();\n+            self.owner = 0;\n+            if let Some(selected) = selected.filter(|_| {\n+                current.iter().all(|q| {\n+                    ctx.catalog.skills[q.def as usize]\n+                        .trigger\n+                        .as_ref()\n+                        .expect(\"meta\")\n+                        .order_selectable\n+                })\n+            }) {\n+                self.start(ctx, &selected);\n+                return Flow::Yield;\n+            }\n+        }\n+        while current.is_empty() {\n+            let seats = self.normal_owners as usize;\n+            ctx.res\n+                .frame_mut(self.frame)\n+                .expect(\"frame\")\n+                .queue\n+                .retain(|q| bucket(q, seats) > self.cursor);\n+            self.cursor += 1;\n+            if self.cursor > seats as u16 + 1 {\n+                let frame = ctx.res.frame_mut(self.frame).expect(\"frame\");\n+                frame.stage = next_stage(frame.kind, frame.stage);\n+                frame.planned = false;\n+                return Flow::Done;\n+            }\n+            current = group(\n+                ctx.core,\n+                &ctx.res.stack,\n+                ctx.res.frame(self.frame).expect(\"frame\"),\n+                ctx.catalog,\n+                self.cursor,\n+                self.normal_owners as usize,\n+            );\n+        }\n+        let first = &current[0];\n+        // Retain temporarily false peers, but discard higher unavailable priorities once passed.\n+        ctx.res\n+            .frame_mut(self.frame)\n+            .expect(\"frame\")\n+            .queue\n+            .retain(|q| {\n+                bucket(q, self.normal_owners as usize) != self.cursor || q.order.1 <= first.order.1\n+            });\n+        let automatic = if first.order.0 != 1 {\n+            Some(first.clone())\n+        } else {\n+            current\n+                .iter()\n+                .find(|q| {\n+                    !ctx.catalog.skills[q.def as usize]\n+                        .trigger\n+                        .as_ref()\n+                        .expect(\"meta\")\n+                        .order_selectable\n+                })\n+                .cloned()\n+        };\n+        if let Some(selected) = automatic.or_else(|| (current.len() == 1).then(|| first.clone())) {\n+            self.start(ctx, &selected);\n+            return Flow::Yield;\n+        }\n+        self.owner = first.owner;\n+        self.candidates = current.iter().map(|q| q.def).collect();\n+        self.asked = true;\n+        Flow::WaitChoice {\n+            observer: self.owner,\n+            spec: ChoiceSpec {\n+                kind: ChoiceKind::PickTag,\n+                prompt: \"trigger_order\",\n+                options: self\n+                    .candidates\n+                    .iter()\n+                    .copied()\n+                    .map(ChoiceOption::Skill)\n+                    .collect(),\n+                min: 1,\n+                max: 1,\n+                allow_cancel: false,\n+            },\n+        }\n+    }\n+}\n+\n+/// New seats are inventory only: upstream addTrigger cannot create an absent Normal map.\n+pub fn sync_trigger_owners(core: &GameStateCore, res: &mut Resolution) {\n+    for park in &mut res.parks {\n+        if let Some(window) = park.machine.trigger_order_mut() {\n+            window\n+                .owners\n+                .extend((window.owners.len()..core.players.len()).map(|p| p as PlayerId));\n+        }\n+    }\n+}\n+\n+/// Register a genuinely new instance in each still-open ancestor window, as upstream addTrigger does.\n+pub fn register_added(\n+    core: &GameStateCore,\n+    res: &mut Resolution,\n+    catalog: &Catalog,\n+    owner: PlayerId,\n+    def: SkillDefId,\n+) {\n+    sync_trigger_owners(core, res);\n+    let Some(meta) = catalog\n+        .skills\n+        .get(def as usize)\n+        .and_then(|d| d.trigger.as_ref())\n+    else {\n+        return;\n+    };\n+    let additions: Vec<_> = res\n+        .parks\n+        .iter()\n+        .filter_map(|p| p.machine.trigger_order())\n+        .filter_map(|m| {\n+            let seat = m.owners.iter().position(|p| *p == owner)? as u8;\n+            if meta.timing == Timing::Normal && usize::from(seat) >= m.normal_owners as usize {\n+                return None;\n+            }\n+            let q = QueuedTrigger {\n+                owner,\n+                def,\n+                order: (\n+                    match meta.timing {\n+                        Timing::First => 0,\n+                        Timing::Normal => 1,\n+                        Timing::Last => 2,\n+                    },\n+                    meta.priority,\n+                    0,\n+                    seat,\n+                    def,\n+                ),\n+            };\n+            (bucket(&q, m.normal_owners as usize) >= m.cursor && !m.done.contains(&(owner, def)))\n+                .then_some((m.frame, q))\n+        })\n+        .collect();\n+    for (frame, q) in additions {\n+        let Some(f) = res.frame_mut(frame) else {\n+            continue;\n+        };\n+        if !subscribes(catalog, def, f)\n+            || f.queue\n+                .iter()\n+                .any(|old| old.owner == owner && old.def == def)\n+        {\n+            continue;\n+        }\n+        f.queue.push(q);\n+        f.queue.sort_by(compare);\n+    }\n+}\n+\n+/// Parallel authoritative changes invalidate an outdated order ask before republishing a new id.\n+pub fn refresh_order_choice(core: &GameStateCore, res: &mut Resolution, catalog: &Catalog) {\n+    if !res\n+        .open_choice\n+        .as_ref()\n+        .is_some_and(|c| c.spec.prompt == \"trigger_order\")\n+    {\n+        return;\n+    }\n+    let Some(index) = res\n+        .parks\n+        .iter()\n+        .position(|p| p.machine.trigger_order().is_some_and(|m| m.asked))\n+    else {\n+        return;\n+    };\n+    let machine = res.parks[index].machine.trigger_order().expect(\"window\");\n+    let current = res\n+        .frame(machine.frame)\n+        .map(|f| {\n+            group(\n+                core,\n+                &res.stack,\n+                f,\n+                catalog,\n+                machine.cursor,\n+                machine.normal_owners as usize,\n+            )\n+        })\n+        .unwrap_or_default();\n+    if current\n+        .iter()\n+        .map(|q| q.def)\n+        .eq(machine.candidates.iter().copied())\n+        && current.iter().all(|q| {\n+            q.owner == machine.owner\n+                && catalog.skills[q.def as usize]\n+                    .trigger\n+                    .as_ref()\n+                    .is_some_and(|m| m.order_selectable)\n+        })\n+    {\n+        return;\n+    }\n+    let machine = res.parks[index]\n+        .machine\n+        .trigger_order_mut()\n+        .expect(\"window\");\n+    machine.asked = false;\n+    machine.candidates.clear();\n+    machine.owner = 0;\n+    res.open_choice = None;\n+}\n+\n+/// Check window, queue, and choice bindings against the same frozen catalog, including checkpoints.\n+pub fn validate_trigger_bindings(\n+    res: &ResolutionSnapshot,\n+    core: &GameStateCore,\n+    catalog: &Catalog,\n+) -> Result<(), SnapshotError> {\n+    let bad = || SnapshotError::BadTag(\"trigger_order_binding\", 0);\n+    for (depth, frame) in res.stack.iter().enumerate() {\n+        let windows: Vec<_> = res\n+            .parks\n+            .iter()\n+            .filter_map(|park| match &park.machine {\n+                MachineSnapshot::TriggerOrder {\n+                    frame: id, owners, ..\n+                } if *id == frame.id => Some((park, owners)),\n+                _ => None,\n+            })\n+            .collect();\n+        let needs_window =\n+            frame.planned && matches!(frame.stage, Stage::BeforeTriggers | Stage::AfterTriggers);\n+        if windows.len() != usize::from(needs_window) {\n+            return Err(bad());\n+        }\n+        if windows\n+            .first()\n+            .is_some_and(|(park, _)| park.resume_depth != depth + 1)\n+        {\n+            return Err(bad());\n+        }\n+        let mut seen = std::collections::BTreeSet::new();\n+        for q in &frame.queue {\n+            let meta = catalog\n+                .skills\n+                .get(q.def as usize)\n+                .and_then(|d| d.trigger.as_ref())\n+                .ok_or_else(bad)?;\n+            let expected = (\n+                match meta.timing {\n+                    Timing::First => 0,\n+                    Timing::Normal => 1,\n+                    Timing::Last => 2,\n+                },\n+                meta.priority,\n+                0,\n+                windows\n+                    .first()\n+                    .and_then(|(_, owners)| owners.iter().position(|p| *p == q.owner))\n+                    .ok_or_else(bad)? as u8,\n+                q.def,\n+            );\n+            if windows.first().is_some_and(|(park, _)| matches!(&park.machine, MachineSnapshot::TriggerOrder { normal_owners, .. } if q.order.0 == 1 && u16::from(q.order.3) >= *normal_owners))\n+                || q.order != expected\n+                || !seen.insert((q.owner, q.def))\n+                || !subscribes(catalog, q.def, frame)\n+            {\n+                return Err(bad());\n+            }\n+        }\n+        if frame\n+            .queue\n+            .windows(2)\n+            .any(|qs| compare(&qs[0], &qs[1]) == Ordering::Greater)\n+        {\n+            return Err(bad());\n+        }\n+    }\n+    for park in &res.parks {\n+        if requires_trigger_frame(&park.machine, catalog) {\n+            let Slot::Trigger { frame } = park.slot else {\n+                return Err(bad());\n+            };\n+            let (depth, frame) = res\n+                .stack\n+                .iter()\n+                .enumerate()\n+                .find(|(_, f)| f.id == frame && frame != NO_FRAME)\n+                .ok_or_else(bad)?;\n+            if park.resume_depth != depth + 1 {\n+                return Err(bad());\n+            }\n+            validate_vm_window(&park.machine, frame, catalog)?;\n+        } else if let Slot::Trigger { frame } = park.slot {\n+            if frame != NO_FRAME {\n+                let frame = res.stack.iter().find(|f| f.id == frame).ok_or_else(bad)?;\n+                validate_vm_window(&park.machine, frame, catalog)?;\n+            }\n+        }\n+        if !matches!(park.machine, MachineSnapshot::TriggerOrder { .. })\n+            && contains_window(&park.machine)\n+        {\n+            return Err(bad());\n+        }\n+        if let MachineSnapshot::OptionalGate {\n+            owner,\n+            def,\n+            event,\n+            inner: None,\n+            ..\n+        } = &park.machine\n+        {\n+            let id = match park.slot {\n+                Slot::Trigger { frame } => frame,\n+                _ => return Err(bad()),\n+            };\n+            let frame = if id == NO_FRAME {\n+                park.resume_depth\n+                    .checked_sub(1)\n+                    .and_then(|i| res.stack.get(i))\n+            } else {\n+                res.stack.iter().find(|f| f.id == id)\n+            }\n+            .ok_or_else(bad)?;\n+            let q = QueuedTrigger {\n+                owner: *owner,\n+                def: *def,\n+                order: (0, 0, 0, 0, *def),\n+            };\n+            if *event != frame.data || !eligible(core, catalog, &q, crate::event::damage_event(&res.stack,frame), event_kind(frame)) {\n+                return Err(bad());\n+            }\n+        }\n+        if let MachineSnapshot::TriggerOrder {\n+            frame,\n+            owner,\n+            candidates,\n+            asked,\n+            cursor,\n+            done,\n+            owners,\n+            normal_owners,\n+        } = &park.machine\n+        {\n+            let f = res.stack.iter().find(|f| f.id == *frame).ok_or_else(bad)?;\n+            let mut seen = std::collections::BTreeSet::new();\n+            let mut player_ids = std::collections::BTreeSet::new();\n+            if owners.len() != core.players.len()\n+                || *normal_owners == 0\n+                || *normal_owners as usize > owners.len()\n+                || owners[..*normal_owners as usize]\n+                    .iter()\n+                    .any(|pid| u16::from(*pid) >= *normal_owners)\n+                || !owners[*normal_owners as usize..]\n+                    .iter()\n+                    .copied()\n+                    .eq((*normal_owners as usize..core.players.len()).map(|p| p as PlayerId))\n+                || owners\n+                    .iter()\n+                    .any(|pid| *pid as usize >= core.players.len() || !player_ids.insert(*pid))\n+            {\n+                return Err(bad());\n+            }\n+            if park.slot != (Slot::Trigger { frame: *frame })\n+                || !f.planned\n+                || !matches!(f.stage, Stage::BeforeTriggers | Stage::AfterTriggers)\n+                || *cursor > *normal_owners + 1\n+                || done\n+                    .iter()\n+                    .any(|key| !seen.insert(*key) || !subscribes(catalog, key.1, f))\n+                || f.queue.iter().any(|q| {\n+                    bucket(q, *normal_owners as usize) < *cursor || seen.contains(&(q.owner, q.def))\n+                })\n+            {\n+                return Err(bad());\n+            }\n+            if *asked {\n+                let qs = group(core, &res.stack, f, catalog, *cursor, *normal_owners as usize);\n+                let Some(open) = &res.open_choice else {\n+                    return Err(bad());\n+                };\n+                if park.resume_depth != res.stack.len()\n+                    || res.stack.last().map(|f| f.id) != Some(*frame)\n+                    || qs.len() < 2\n+                    || qs.iter().any(|q| {\n+                        q.owner != *owner\n+                            || q.order.0 != 1\n+                            || !catalog.skills[q.def as usize]\n+                                .trigger\n+                                .as_ref()\n+                                .expect(\"meta\")\n+                                .order_selectable\n+                    })\n+                    || *candidates != qs.iter().map(|q| q.def).collect::<Vec<_>>()\n+                    || open.observer != *owner\n+                    || open.spec.prompt != \"trigger_order\"\n+                    || open.spec.kind != ChoiceKind::PickTag\n+                    || open.spec.min != 1\n+                    || open.spec.max != 1\n+                    || open.spec.allow_cancel\n+                    || open.spec.options\n+                        != candidates\n+                            .iter()\n+                            .copied()\n+                            .map(ChoiceOption::Skill)\n+                            .collect::<Vec<_>>()\n+                {\n+                    return Err(bad());\n+                }\n+            } else if !candidates.is_empty() || *owner != 0 {\n+                return Err(bad());\n+            }\n+        }\n+    }\n+    Ok(())\n+}\n+\n+fn contains_window(machine: &MachineSnapshot) -> bool {\n+    match machine {\n+        MachineSnapshot::TriggerOrder { .. } => true,\n+        MachineSnapshot::OptionalGate { inner, .. }\n+        | MachineSnapshot::Aoe { inner, .. }\n+        | MachineSnapshot::Chain { inner, .. }\n+        | MachineSnapshot::Jijiang { inner, .. }\n+        | MachineSnapshot::LiJian { inner, .. }\n+        | MachineSnapshot::NullifyWindow { effect: inner, .. } => {\n+            inner.as_deref().is_some_and(contains_window)\n+        }\n+        MachineSnapshot::Rvm { following, .. } => following.iter().any(contains_window),\n+        _ => false,\n+    }\n+}\n+\n+// A module already identifies a handler; only the owning frame decides its before/after window.\n+fn validate_vm_window(\n+    machine: &MachineSnapshot,\n+    frame: &Frame,\n+    catalog: &Catalog,\n+) -> Result<(), SnapshotError> {\n+    match machine {\n+        MachineSnapshot::Rvm {\n+            module,\n+            skill_name,\n+            event,\n+            following,\n+            ..\n+        } => {\n+            let def = catalog\n+                .skill_by_name(skill_name)\n+                .ok_or(SnapshotError::UnknownMachine)?;\n+            let behavior = &catalog.skills[def as usize].behavior;\n+            if event.kind() != frame.data.kind()\n+                || !behavior.vm_trigger_window_is_authorized(module, event_kind(frame))\n+            {\n+                return Err(SnapshotError::UnknownMachine);\n+            }\n+            for next in following {\n+                validate_vm_window(next, frame, catalog)?;\n+            }\n+        }\n+        MachineSnapshot::OptionalGate { inner, .. }\n+        | MachineSnapshot::Aoe { inner, .. }\n+        | MachineSnapshot::Chain { inner, .. }\n+        | MachineSnapshot::Jijiang { inner, .. }\n+        | MachineSnapshot::LiJian { inner, .. }\n+        | MachineSnapshot::NullifyWindow { effect: inner, .. } => {\n+            if let Some(inner) = inner {\n+                validate_vm_window(inner, frame, catalog)?;\n+            }\n+        }\n+        _ => {}\n+    }\n+    Ok(())\n+}\n+\n+fn requires_trigger_frame(machine: &MachineSnapshot, catalog: &Catalog) -> bool {\n+    match machine {\n+        MachineSnapshot::Rvm {\n+            module,\n+            skill_name,\n+            following,\n+            ..\n+        } => {\n+            catalog.skill_by_name(skill_name).is_some_and(|def| {\n+                let def = &catalog.skills[def as usize];\n+                def.trigger.is_some() && def.behavior.vm_module_requires_trigger_frame(module)\n+            }) || following.iter().any(|m| requires_trigger_frame(m, catalog))\n+        }\n+        MachineSnapshot::OptionalGate { inner, .. }\n+        | MachineSnapshot::Aoe { inner, .. }\n+        | MachineSnapshot::Chain { inner, .. }\n+        | MachineSnapshot::Jijiang { inner, .. }\n+        | MachineSnapshot::LiJian { inner, .. }\n+        | MachineSnapshot::NullifyWindow { effect: inner, .. } => inner\n+            .as_deref()\n+            .is_some_and(|m| requires_trigger_frame(m, catalog)),\n+        _ => false,\n+    }\n+}"},{"sha":"1e63f57fcb18a59809477ffdc9539ffafd798388","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20-v3/baseline-changed/crates/engine-native-kernel/src/snap.rs","status":"added","additions":34,"deletions":0,"changes":34,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fsnap.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fsnap.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fsnap.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1,34 @@\n+//! 快照与恢复：状态规范形态 + 信任边界校验 + 开放选择承接派生。\n+//!\n+//! 三分职责（N04/N05，ADR 0774）：\n+//! - **规范快照类型**：`StateSnapshot` = 核心状态 + 执行位置 + 段数据；\n+//!   挂起机器以 `MachineSnapshot` 全字段导出（字节存档与规范摘要共用）；\n+//! - **恢复期校验**：`validate_core` / `validate_card_ownership` /\n+//!   `validate_resolution` 在任何恢复路径上拒绝越界 ID、破损帧链、\n+//!   牌归属不闭合与承接关系不一致的快照（恶意快照不得产出引擎）；\n+//! - **承接派生**：`active_ask` 从挂起机器的 stage/asked 状态派生\n+//!   「当前应有的开放选择询问」，与快照内的 `open_choice` 逐字段核对\n+//!   （N04-e）——机器字段篡改即失去承接。\n+\n+use crate::catalog::{CardKind, Catalog, SkillMachine};\n+use crate::choice::{ChoiceKind, ChoiceOption, OpenChoice, Selection};\n+use crate::vocabulary::host::GJ_FOOD_MIZHLIANOU_KEY;\n+use crate::vocabulary::host::HostBehavior;\n+use crate::vocabulary::generals::{general_gender, Gender};\n+use crate::vocabulary::names::{GUI_CAI, JI_JIU, LONG_DAN, QING_GUO};\n+use crate::event::{DamageNature, EventData, Frame};\n+use crate::ids::{CardId, PlayerId, SkillDefId};\n+use crate::resolution::{Slot, NO_FRAME};\n+use crate::state::{GameMode, GameStateCore, Outcome, Winner};\n+\n+mod types;\n+pub use types::*;\n+mod ownership;\n+pub use ownership::*;\n+mod validation;\n+pub use validation::*;\n+mod machine_validation;\n+use machine_validation::*;\n+mod asks;\n+pub use asks::*;\n+mod restore;"},{"sha":"e69de29bb2d1d6434b8b29ae775ad8c2e48c5391","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20-v3/baseline-changed/crates/engine-native-kernel/src/snap/damage_validation.rs","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fsnap%2Fdamage_validation.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fsnap%2Fdamage_validation.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fsnap%2Fdamage_validation.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8"},{"sha":"c57285ea806024b20b07e9940f41a7ef3406162a","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20-v3/baseline-changed/crates/engine-native-kernel/src/snap/validation.rs","status":"added","additions":515,"deletions":0,"changes":515,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fsnap%2Fvalidation.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fsnap%2Fvalidation.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fsnap%2Fvalidation.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1,515 @@\n+use super::*;\n+use crate::event::Stage;\n+\n+/// 由目录与座位数导出恢复边界。\n+pub fn bounds_from(catalog: &Catalog, seats: usize) -> RestoreBounds {\n+    RestoreBounds {\n+        vm_validate: catalog.hooks.vm_validate,\n+        seats,\n+        cards: catalog.cards.len(),\n+        skills: catalog.skills.len(),\n+        generals: catalog.general_count(),\n+        ruleset_version: catalog.ruleset_version,\n+    }\n+}\n+\n+pub(super) fn oob(what: &'static str, got: u64) -> SnapshotError {\n+    SnapshotError::IdOutOfBounds { what, got }\n+}\n+\n+pub(super) fn check_pid(p: PlayerId, b: &RestoreBounds) -> Result<(), SnapshotError> {\n+    if p as usize >= b.seats {\n+        return Err(oob(\"player\", p as u64));\n+    }\n+    Ok(())\n+}\n+\n+pub(super) fn check_card(c: CardId, b: &RestoreBounds) -> Result<(), SnapshotError> {\n+    if c as usize >= b.cards {\n+        return Err(oob(\"card\", c as u64));\n+    }\n+    Ok(())\n+}\n+\n+pub(super) fn check_def(d: SkillDefId, b: &RestoreBounds) -> Result<(), SnapshotError> {\n+    if d as usize >= b.skills {\n+        return Err(oob(\"skill_def\", d as u64));\n+    }\n+    Ok(())\n+}\n+\n+pub(super) fn check_opt_pid(p: Option<PlayerId>, b: &RestoreBounds) -> Result<(), SnapshotError> {\n+    if let Some(p) = p {\n+        check_pid(p, b)?;\n+    }\n+    Ok(())\n+}\n+\n+pub(super) fn check_opt_card(c: Option<CardId>, b: &RestoreBounds) -> Result<(), SnapshotError> {\n+    if let Some(c) = c {\n+        check_card(c, b)?;\n+    }\n+    Ok(())\n+}\n+\n+pub(super) fn check_pids(ps: &[PlayerId], b: &RestoreBounds) -> Result<(), SnapshotError> {\n+    for p in ps {\n+        check_pid(*p, b)?;\n+    }\n+    Ok(())\n+}\n+\n+pub(super) fn check_cards(cs: &[CardId], b: &RestoreBounds) -> Result<(), SnapshotError> {\n+    for c in cs {\n+        check_card(*c, b)?;\n+    }\n+    Ok(())\n+}\n+\n+pub(super) fn check_event_data(data: &EventData, b: &RestoreBounds) -> Result<(), SnapshotError> {\n+    match data {\n+        EventData::DamageWindow { .. } => {},\n+        EventData::Damage(d) => {\n+            if d.settlement.committed_damage == Some(0) || d.settlement.hp_loss > d.settlement.committed_damage.unwrap_or(0) { return Err(SnapshotError::BadTag(\"damage_settlement\",0)); }\n+            use crate::event::{DamageOutcome as O,DamageProgress as P};\n+            if d.settlement.committed_damage.is_none() && !matches!(d.settlement.progress,P::Before|P::ZeroPending|P::Stopped) {return Err(SnapshotError::BadTag(\"damage_uncommitted_progress\",0));}\n+            if matches!(d.settlement.outcome,O::Cancelled|O::ReplacedByLoseHp) && !matches!(d.settlement.progress,P::Stopped) {return Err(SnapshotError::BadTag(\"damage_stopped_progress\",0));}\n+            if let P::Chain{remaining}=&d.settlement.progress {\n+                check_pids(remaining,b)?;\n+                let unique:std::collections::BTreeSet<_>=remaining.iter().collect();\n+                if unique.len()!=remaining.len() || remaining.contains(&d.target) {return Err(SnapshotError::BadTag(\"damage_chain_targets\",0));}\n+            }\n+            check_opt_pid(d.source, b)?;\n+            check_pid(d.target, b)?;\n+            check_pids(&d.redirect_chain, b)?;\n+            check_opt_card(d.card, b)?;\n+        }\n+        EventData::ShaDodged {\n+            card,\n+            source,\n+            target,\n+        } => {\n+            check_card(*card, b)?;\n+            check_pid(*source, b)?;\n+            check_pid(*target, b)?;\n+        }\n+        EventData::CardsGiven {\n+            giver,\n+            recipient,\n+            cards,\n+        } => {\n+            check_pid(*giver, b)?;\n+            check_pid(*recipient, b)?;\n+            check_cards(cards, b)?;\n+        }\n+        EventData::CardsLost {\n+            player,\n+            cards,\n+            origins,\n+        } => {\n+            check_pid(*player, b)?;\n+            check_cards(cards, b)?;\n+            if cards.len() != origins.len() {\n+                return Err(SnapshotError::IdOutOfBounds {\n+                    what: \"cards_lost_origins\",\n+                    got: origins.len() as u64,\n+                });\n+            }\n+        }\n+        EventData::LoseHp { player, .. } => {\n+            check_pid(*player, b)?;\n+        }\n+        EventData::Recover {\n+            player, by_card, ..\n+        } => {\n+            check_pid(*player, b)?;\n+            check_opt_card(*by_card, b)?;\n+        }\n+        EventData::CardsDrawn { player, cards } => {\n+            check_pid(*player, b)?;\n+            check_cards(cards, b)?;\n+        }\n+        EventData::CardsMoved { cards, from, to } => {\n+            check_cards(cards, b)?;\n+            check_pid(*from, b)?;\n+            check_pid(*to, b)?;\n+        }\n+        EventData::CardUsed(u) => {\n+            check_card(u.card, b)?;\n+            check_pid(u.player, b)?;\n+            check_pids(&u.targets, b)?;\n+        }\n+        EventData::CardResponded { card, player } => {\n+            check_card(*card, b)?;\n+            check_pid(*player, b)?;\n+        }\n+        EventData::Dying { player, source } => {\n+            check_pid(*player, b)?;\n+            check_opt_pid(*source, b)?;\n+        }\n+        EventData::DyingSaved { player, source } => {\n+            check_pid(*player, b)?;\n+            check_opt_pid(*source, b)?;\n+        }\n+        EventData::Death { player, killer } => {\n+            check_pid(*player, b)?;\n+            check_opt_pid(*killer, b)?;\n+        }\n+        EventData::Phase { player, .. } => check_pid(*player, b)?,\n+        EventData::TurnEnded { player } => check_pid(*player, b)?,\n+        EventData::SkillToggled { player, skill, .. } => {\n+            check_pid(*player, b)?;\n+            check_def(*skill, b)?;\n+        }\n+        EventData::Equipped {\n+            player,\n+            card,\n+            replaced,\n+        } => {\n+            check_pid(*player, b)?;\n+            check_card(*card, b)?;\n+            check_opt_card(*replaced, b)?;\n+        }\n+        EventData::Linked { player, .. } => check_pid(*player, b)?,\n+        EventData::CardsDiscarded { player, cards } => {\n+            check_pid(*player, b)?;\n+            check_cards(cards, b)?;\n+        }\n+        EventData::TurnOverBefore { player, .. } => {\n+            check_pid(*player, b)?;\n+        }\n+        EventData::TurnOvered { player, .. } => {\n+            check_pid(*player, b)?;\n+        }\n+    }\n+    Ok(())\n+}\n+\n+pub(super) fn check_options(opts: &[ChoiceOption], b: &RestoreBounds) -> Result<(), SnapshotError> {\n+    for o in opts {\n+        match o {\n+            ChoiceOption::Card(c) => check_card(*c, b)?,\n+            ChoiceOption::Skill(d) => check_def(*d, b)?,\n+            ChoiceOption::Player(p) => check_pid(*p, b)?,\n+            _ => {}\n+        }\n+    }\n+    Ok(())\n+}\n+\n+/// 核心状态校验：规则版本绑定、牌区/技能实例 ID 界、身份局结构、\n+/// 武将槽界、胜负与模式一致性。\n+pub fn validate_core(core: &GameStateCore, b: &RestoreBounds) -> Result<(), SnapshotError> {\n+    // 规则版本（核心副本与目录绑定；顶层一致不豁免核心篡改）\n+    if core.ruleset_version != b.ruleset_version {\n+        return Err(SnapshotError::RuleVersionMismatch {\n+            snapshot: core.ruleset_version,\n+            catalog: b.ruleset_version,\n+        });\n+    }\n+    // NC07：座位环引用校验（长度须与玩家数一致，取值须为合法座位且构成排列）\n+    if !core.seat_ring.is_empty() {\n+        if core.seat_ring.len() != core.players.len() {\n+            return Err(oob(\"seat_ring_len\", core.seat_ring.len() as u64));\n+        }\n+        let mut seen = vec![false; core.players.len()];\n+        for seat in &core.seat_ring {\n+            if *seat as usize >= core.players.len() {\n+                return Err(oob(\"seat_ring_seat\", *seat as u64));\n+            }\n+            if seen[*seat as usize] {\n+                return Err(oob(\"seat_ring_duplicate\", *seat as u64));\n+            }\n+            seen[*seat as usize] = true;\n+        }\n+    }\n+\n+    // 牌区 ID 界、国战武将槽界、五行属性界\n+    for p in &core.players {\n+        check_cards(&p.hand, b)?;\n+        check_cards(&p.equips, b)?;\n+        check_cards(&p.judge, b)?;\n+        check_cards(&p.off_court, b)?;\n+        for g in p.general_slots.iter().flatten() {\n+            if *g as usize >= b.generals {\n+                return Err(oob(\"general_slot_index\", *g as u64));\n+            }\n+        }\n+        // 明置必须引用已配置的武将槽\n+        for slot in 0..2 {\n+            if p.revealed_generals[slot] && p.general_slots[slot].is_none() {\n+                return Err(oob(\"reveal_without_general\", 0));\n+            }\n+        }\n+        if let Some(n) = p.wunature {\n+            if n > 4 {\n+                return Err(oob(\"wunature\", n as u64));\n+            }\n+        }\n+    }\n+    // 回合当前玩家在界\n+    if core.turn.current as usize >= core.players.len() {\n+        return Err(oob(\"player\", core.turn.current as u64));\n+    }\n+    // 技能实例：键在界、值 owner 与键一致\n+    for ((owner, def), inst) in &core.skills {\n+        check_pid(*owner, b)?;\n+        check_def(*def, b)?;\n+        if inst.owner != *owner {\n+            return Err(oob(\"skill_instance_owner\", inst.owner as u64));\n+        }\n+    }\n+    // 对决模式结构：两队互斥、并集覆盖全部座位\n+    if let GameMode::Versus { teams, substitutes } = &core.mode {\n+        if teams.len() != 2 {\n+            return Err(oob(\"versus_team_count\", teams.len() as u64));\n+        }\n+        let mut seen = vec![false; b.seats];\n+        for t in teams {\n+            for p in t {\n+                if (*p as usize) >= b.seats || seen[*p as usize] {\n+                    return Err(oob(\"versus_team_member\", *p as u64));\n+                }\n+                seen[*p as usize] = true;\n+            }\n+        }\n+        if seen.iter().any(|s| !s) {\n+            return Err(oob(\"versus_team_coverage\", 0));\n+        }\n+        // 替补池（v206）：武将 def 界校验（池数与队数一致，条目为目录将）\n+        if substitutes.len() != teams.len() {\n+            return Err(oob(\"versus_substitute_pools\", substitutes.len() as u64));\n+        }\n+        for pool in substitutes {\n+            for g in pool {\n+                check_def(*g, b)?;\n+            }\n+        }\n+    }\n+    // Boss 结构：boss/助战座位有效\n+    if let GameMode::Boss { boss, fellows, .. } = &core.mode {\n+        if (*boss as usize) >= b.seats {\n+            return Err(oob(\"boss_seat\", *boss as u64));\n+        }\n+        for f in fellows {\n+            if (*f as usize) >= b.seats {\n+                return Err(oob(\"boss_fellow_seat\", *f as u64));\n+            }\n+        }\n+    }\n+    // KOF 结构：2 人局（会话将池内容为 GENERAL 下标，越界由运行期授予校验）\n+    if let GameMode::Kof { .. } = &core.mode {\n+        if b.seats != 2 {\n+            return Err(oob(\"kof_seats\", b.seats as u64));\n+        }\n+    }\n+    // 斗地主结构：地主座位有效\n+    if let GameMode::Doudizhu { lord } = &core.mode {\n+        if (*lord as usize) >= b.seats {\n+            return Err(oob(\"doudizhu_lord\", *lord as u64));\n+        }\n+    }\n+    // 身份局结构\n+    if let GameMode::Identity { roles } = &core.mode {\n+        if roles.len() != b.seats {\n+            return Err(oob(\"roles_len\", roles.len() as u64));\n+        }\n+        if roles.first() != Some(&crate::state::Role::Lord) {\n+            return Err(oob(\"lord_seat\", 0));\n+        }\n+        if !roles.contains(&crate::state::Role::Traitor) {\n+            return Err(oob(\"roles_composition\", 0));\n+        }\n+        // 人数表：4–6 人局 1 忠，7–8 人局 2 忠\n+        let loyalists = if (4..=6).contains(&b.seats) { 1 } else { 2 };\n+        let got = roles\n+            .iter()\n+            .filter(|r| **r == crate::state::Role::Loyalist)\n+            .count();\n+        if got != loyalists {\n+            return Err(oob(\"roles_loyalist_count\", got as u64));\n+        }\n+    }\n+    // 胜负与模式一致性\n+    if let Some(Outcome { winner }) = &core.outcome {\n+        let ok = match (&core.mode, winner) {\n+            (GameMode::Prototype, Winner::Player(_)) => true,\n+            (GameMode::Identity { .. }, Winner::LordSide | Winner::Rebels | Winner::Traitor) => {\n+                true\n+            }\n+            (GameMode::Kingdoms, Winner::Faction(_)) => true,\n+            (GameMode::Versus { .. }, Winner::Versus(_)) => true,\n+            (GameMode::Doudizhu { .. }, Winner::Doudizhu { .. }) => true,\n+            (GameMode::Boss { .. }, Winner::Boss { .. }) => true,\n+            (GameMode::Kof { .. }, Winner::Player(_)) => true,\n+            _ => false,\n+        };\n+        if !ok {\n+            return Err(oob(\"outcome_mode_mismatch\", 0));\n+        }\n+    }\n+    Ok(())\n+}\n+\n+/// 机器持牌收集（N04-f：判定进行态/观星顶牌由机器持有，不在任何牌区）。\n+pub fn machine_held_cards(m: &MachineSnapshot, out: &mut Vec<CardId>) {\n+    match m {\n+        MachineSnapshot::JudgePhase { queue, current, .. } => {\n+            out.extend(queue.iter().copied());\n+            if let Some(c) = current {\n+                // finalized（效果已套用）后锦囊已离机，trick 仅为簿记\n+                if !c.finalized {\n+                    out.push(c.trick);\n+                }\n+                if c.judge_held {\n+                    if !c.finalized {\n+                        if let Some(cards) = &c.gaiming_cards {\n+                            out.extend(cards.iter().copied());\n+                            // Only the first candidate aliases judge_card; other duplicates remain errors.\n+                            if cards.first() != Some(&c.judge_card) {\n+                                out.push(c.judge_card);\n+                            }\n+                        } else {\n+                            out.push(c.judge_card);\n+                        }\n+                        if c.haotian_holder.is_some() {\n+                            out.extend(c.haotian_other);\n+                        }\n+                    } else {\n+                        out.push(c.judge_card);\n+                    }\n+                }\n+            }\n+        }\n+        MachineSnapshot::XunXun { stage: XunXunStageSnap::Arrange, top, .. } => {\n+            out.extend(top.iter().copied());\n+        }\n+        MachineSnapshot::JiJie { stage: JiJieStageSnap::Read, card, .. } => {\n+            out.extend(card);\n+        }\n+        MachineSnapshot::GuanXing { top, .. } => out.extend(top.iter().copied()),\n+        // 末焱展示牌已离开牌库，挂起期间只在宿主机器上。\n+        MachineSnapshot::Host {\n+            behavior, cards, ..\n+        } if *behavior == HostBehavior::D3Moyan.tag() => {\n+            out.extend(cards.iter().copied());\n+        }\n+        MachineSnapshot::OptionalGate { inner, .. }\n+        | MachineSnapshot::NullifyWindow { effect: inner, .. }\n+        | MachineSnapshot::Aoe { inner, .. }\n+        | MachineSnapshot::Jijiang { inner, .. }\n+        | MachineSnapshot::LiJian { inner, .. } => {\n+            if let Some(m) = inner {\n+                machine_held_cards(m, out);\n+            }\n+        }\n+        _ => {}\n+    }\n+}\n+\n+/// N04-f 牌归属多重集核算：目录全集 ⊆ 恰一牌区 ∪ 机器暂离。\n+/// 尾端缺失 / 中段缺失 / 全量缺失 / 重复归属一律拒绝。\n+pub fn validate_card_ownership(\n+    core: &GameStateCore,\n+    resolution: &ResolutionSnapshot,\n+    b: &RestoreBounds,\n+) -> Result<(), SnapshotError> {\n+    let mut seen = vec![false; b.cards];\n+    fn mark(seen: &mut [bool], b: &RestoreBounds, c: CardId) -> Result<(), SnapshotError> {\n+        check_card(c, b)?;\n+        if seen[c as usize] {\n+            return Err(oob(\"card_in_multiple_zones\", c as u64));\n+        }\n+        seen[c as usize] = true;\n+        Ok(())\n+    }\n+    let mut held = Vec::new();\n+    for park in &resolution.parks {\n+        machine_held_cards(&park.machine, &mut held);\n+    }\n+    for card in physical_cards(core, &held) {\n+        mark(&mut seen, b, card.id)?;\n+    }\n+    for (id, ok) in seen.iter().enumerate() {\n+        if !ok {\n+            return Err(oob(\"card_missing_from_all_zones\", id as u64));\n+        }\n+    }\n+    Ok(())\n+}\n+\n+/// 执行位置校验：帧父子链 / 帧号水位与去重 / 挂起深度与槽位帧引用 /\n+/// 选择应答 ID 水位 / 机器树 ID 界。\n+pub fn validate_resolution(\n+    resolution: &ResolutionSnapshot,\n+    b: &RestoreBounds,\n+    core: &GameStateCore,\n+) -> Result<(), SnapshotError> {\n+    // 栈帧：唯一性、水位、父子链（父必须存在且是更早的帧）\n+    let mut ids: std::collections::BTreeMap<u32, usize> = Default::default();\n+    for (i, f) in resolution.stack.iter().enumerate() {\n+        if f.id as u64 >= resolution.next_event_id as u64 {\n+            return Err(oob(\"event_id\", f.id as u64));\n+        }\n+        if ids.insert(f.id, i).is_some() {\n+            return Err(oob(\"event_id_dup\", f.id as u64));\n+        }\n+        if let Some(p) = f.parent {\n+            match ids.get(&p) {\n+                Some(&pi) if pi < i => {}\n+                _ => return Err(oob(\"frame_parent\", p as u64)),\n+            }\n+        }\n+        check_event_data(&f.data, b)?;\n+        if matches!(f.data,EventData::Damage(_) | EventData::DamageWindow{..}) && f.kind != f.data.kind() {return Err(SnapshotError::BadTag(\"damage_frame_kind\",0));}\n+        if let EventData::DamageWindow { root, window } = &f.data {\n+            let parent=resolution.stack.iter().find(|parent|parent.id==*root).ok_or(SnapshotError::BadTag(\"damage_window_root\",*root as u64))?;\n+            if f.parent != Some(*root) || !matches!(parent.data, EventData::Damage(_)) || *root==f.id { return Err(SnapshotError::BadTag(\"damage_window_ancestry\",*root as u64)); }\n+            let d=parent.damage();\n+            let valid=matches!((window,&d.settlement.progress),(crate::event::DamageWindowKind::Source,crate::event::DamageProgress::Source)|(crate::event::DamageWindowKind::End,crate::event::DamageProgress::End)|(crate::event::DamageWindowKind::After,crate::event::DamageProgress::After)|(crate::event::DamageWindowKind::Zero,crate::event::DamageProgress::Stopped));\n+            if !valid {return Err(SnapshotError::BadTag(\"damage_window_progress\",0));}\n+        }\n+        if let EventData::Damage(d)=&f.data {\n+            if matches!(f.stage,Stage::AfterTriggers|Stage::Intrinsic|Stage::Done) && d.settlement.progress==crate::event::DamageProgress::Before {return Err(SnapshotError::BadTag(\"damage_missing_submission_progress\",0));}\n+            if matches!(f.stage, Stage::BeforeTriggers | Stage::Commit) && d.settlement.progress != crate::event::DamageProgress::Before {return Err(SnapshotError::BadTag(\"damage_duplicate_commit\",0));}\n+        }\n+        for q in &f.queue {\n+            check_def(q.def, b)?;\n+            check_pid(q.owner, b)?;\n+        }\n+    }\n+    // 挂起：深度与槽位帧引用、机器树 ID 界\n+    for p in &resolution.parks {\n+        if p.resume_depth > resolution.stack.len() {\n+            return Err(oob(\"resume_depth\", p.resume_depth as u64));\n+        }\n+        let frame = match p.slot {\n+            Slot::Intrinsic { frame } => frame,\n+            Slot::Trigger { frame } => frame,\n+        };\n+        // 会话级挂起槽（NO_FRAME 哨兵）豁免帧存在性检查\n+        if frame != NO_FRAME && !ids.contains_key(&frame) {\n+            return Err(oob(\"park_frame\", frame as u64));\n+        }\n+        check_machine(&p.machine, b, core)?;\n+        if let MachineSnapshot::DamageFlow { root } = p.machine {\n+            if !matches!(p.slot,Slot::Intrinsic{frame}if frame==root) || !resolution.stack.iter().any(|f|f.id==root && f.stage==Stage::Intrinsic && matches!(f.data,EventData::Damage(_))) {return Err(SnapshotError::BadTag(\"damage_flow_binding\",root as u64));}\n+        }\n+    }\n+    // 应答选项 ID 界\n+    if let Some(ans) = &resolution.answer {\n+        check_options(ans, b)?;\n+    }\n+    // 开放选择：观察者/选项在界、ID 水位、必须有承接机器\n+    if let Some(open) = &resolution.open_choice {\n+        check_pid(open.observer, b)?;\n+        check_options(&open.spec.options, b)?;\n+        if open.id == 0 || open.id >= resolution.next_choice_id {\n+            return Err(oob(\"choice_id\", open.id));\n+        }\n+        if resolution.parks.is_empty() {\n+            return Err(oob(\"choice_without_machine\", 0));\n+        }\n+    }\n+    Ok(())\n+}"},{"sha":"44cf2a4f7e13fb10d3169c2a98fec10460a9a94d","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20-v3/baseline-changed/crates/engine-native/tests/a0_tag_registry.rs","status":"added","additions":762,"deletions":0,"changes":762,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native%2Ftests%2Fa0_tag_registry.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native%2Ftests%2Fa0_tag_registry.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native%2Ftests%2Fa0_tag_registry.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1,762 @@\n+//! A0 注册表不变量检查（演进提案 §3.A0 第 1/4 点，挂靠主稿 P0 N11）。\n+//!\n+//! 1. `MachineSnapshot` 每个变体构造样例，字节编码后机器 tag 互不相同，\n+//!    且编码→解码往返相等。变体清单经 `variant_index` 的 match 穷尽性\n+//!    锁定：新增变体而漏登记样例时编译失败；tag 冲突/漏 tag 时本测试\n+//!    失败（历史实例：tag 29 曾同时分配给 Dismantle 与 XiaoJi，枭姬分支\n+//!    不可达，2026-09-24 修复为 XiaoJi=43）。\n+//! 2. `HostBehavior::tag()` 全变体唯一（标签与键一一对应）。\n+//! 3. `CardKind` 编码双射（archive.rs 的 `card_kind_to_num`/`num_to_card_kind`\n+//!    为私有函数，双射以本文件同轮的静态核查记录进证据，不在此重复）。\n+//! 4. 扩展包数据键表（ADR 0778）：`CardKind::key`、`HostBehavior::key` 双射，\n+//!    牌种伴随技能表键唯一且覆盖固有装备技。\n+\n+use std::collections::BTreeMap;\n+\n+use engine_native::archive::{decode_archive, encode_archive};\n+use engine_native::content::host::HostBehavior;\n+use engine_native::event::{DamageData, DamageNature, EventData};\n+use engine_native::resolution::Slot;\n+use engine_native::snap::{\n+    FanJianStageSnap, GuanXingStageSnap, JiJiStageSnap, JieYinStageSnap, JijiangStageSnap,\n+    JudgementProgressSnap, KuRouStageSnap, LiJianStageSnap, MachineSnapshot, ParkSnapshot,\n+    QingNangStageSnap, RendeStageSnap, SanCaiStageSnap, StateSnapshot, TuXiStageSnap,\n+    YiShangStageSnap, ZhiHengStageSnap,\n+};\n+use engine_native::{Engine, SkillDefId};\n+\n+/// 每变体一个样例（名称仅用于报错）。字段取最小合法值，嵌套 inner 用\n+/// `Some(Box::new(Noop))` 验证嵌套编码；OptionalGate 的事件载荷用伤害。\n+fn all_samples() -> Vec<(&'static str, MachineSnapshot)> {\n+    let damage = EventData::Damage(DamageData {\n+                    settlement: Default::default(),\n+        source: Some(1),\n+        target: 0,\n+        amount: 1,\n+        nature: DamageNature::Normal,\n+        prevented: false,\n+        redirect_chain: Vec::new(),\n+        card: None,\n+        from_chain: false,\n+    });\n+    vec![(\"DamageFlow\",MachineSnapshot::DamageFlow{root:1}),\n+        (\n+            \"Sha\",\n+            MachineSnapshot::Sha {\n+                card: 1,\n+                source: 0,\n+                target: 1,\n+                nature: DamageNature::Normal,\n+                asked: true,\n+                armor_judged: false,\n+                dodges_used: 1,\n+                tieji_red: Some(true),\n+                liuli_done: true,\n+                liuli_stage: 2,\n+                liuli_card: None,\n+                hujia_queue: Some(vec![2]),\n+                hujia_holder: Some(2),\n+                jiu_bonus: true,\n+                asking_xiandan: false,\n+                xiandan_done: false,\n+                xiandan_bonus: false,\n+                asking_lueying: false,\n+                lueying_victim: None,\n+                lueying_declined: false,\n+                asking_fuchou: false,\n+                fuchou_card: None,\n+                asking_sadeng: true,\n+                asking_sadeng_shan: false,\n+                shoulie_direct: false,\n+                asking_qilin: false,\n+                qilin_horse: None,\n+                asking_hanbing: false,\n+                asking_fengxueren: false,\n+                asking_guanshi: false,\n+                guanshi_cards: Vec::new(),\n+                asking_qinglong: false,\n+                asking_cixiong: false,\n+                cixiong_done: false,\n+                extra_targets: Vec::new(),\n+                hanbing_pending: 2,\n+            },\n+        ),\n+        (\n+            \"DyingSave\",\n+            MachineSnapshot::DyingSave {\n+                dying: 0,\n+                source: Some(1),\n+                responders: vec![1, 2],\n+                asked: true,\n+                round_used: false,\n+                guihan_asked: false,\n+            },\n+        ),\n+        (\n+            \"Duel\",\n+            MachineSnapshot::Duel {\n+                card: 1,\n+                source: 0,\n+                target: 1,\n+                on_target: true,\n+                asked: true,\n+                second_pending: false,\n+            },\n+        ),\n+        (\n+            \"NullifyWindow\",\n+            MachineSnapshot::NullifyWindow {\n+                card: 1,\n+                source: 0,\n+                nullified: false,\n+                queue: vec![1],\n+                asked: true,\n+                window_open: true,\n+                owns_disposal: true,\n+                effect: Some(Box::new(MachineSnapshot::Noop)),\n+            },\n+        ),\n+        (\n+            \"JudgePhase\",\n+            MachineSnapshot::JudgePhase {\n+                owner: 0,\n+                queue: vec![1],\n+                current: Some(Box::new(JudgementProgressSnap {\n+                    trick: 1,\n+                    judge_card: 2,\n+                    rewriters: vec![1],\n+                    asked: true,\n+                    tian_du: vec![2],\n+                    gained: false,\n+                    finalized: true,\n+                    in_rewrite: false,\n+                    judge_held: false,\n+                    haotian_holder: Some(1),\n+                    haotian_other: Some(3),\n+                    gaiming_cards: None,\n+                })),\n+            },\n+        ),\n+        (\"Noop\", MachineSnapshot::Noop),\n+        (\n+            \"PlaceDelayed\",\n+            MachineSnapshot::PlaceDelayed {\n+                card: 1,\n+                target: 1,\n+                placed: true,\n+            },\n+        ),\n+        (\n+            \"Aoe\",\n+            MachineSnapshot::Aoe {\n+                card: 1,\n+                source: 0,\n+                need: engine_native::CardKind::SavageAttack,\n+                targets: vec![1],\n+                idx: 0,\n+                inner: Some(Box::new(MachineSnapshot::Noop)),\n+                nature: engine_native::event::DamageNature::Normal,\n+            },\n+        ),\n+        (\n+            \"AoeTarget\",\n+            MachineSnapshot::AoeTarget {\n+                source: 0,\n+                target: 1,\n+                need: engine_native::CardKind::ArcheryAttack,\n+                asked: true,\n+                card: 1,\n+                nature: engine_native::event::DamageNature::Normal,\n+            },\n+        ),\n+        (\n+            \"Chain\",\n+            MachineSnapshot::Chain {\n+                card: 1,\n+                source: 0,\n+                targets: vec![1, 2],\n+                idx: 1,\n+                inner: Some(Box::new(MachineSnapshot::Noop)),\n+                dispatcher: true,\n+            },\n+        ),\n+        (\n+            \"DiscardToLimit\",\n+            MachineSnapshot::DiscardToLimit {\n+                player: 0,\n+                need: 1,\n+                asked: true,\n+            },\n+        ),\n+        (\n+            \"Death\",\n+            MachineSnapshot::Death {\n+                player: 1,\n+                killer: Some(0),\n+            },\n+        ),\n+        (\n+            \"OptionalGate\",\n+            MachineSnapshot::OptionalGate {\n+                owner: 0,\n+                def: SkillDefId::MAX,\n+                event: damage,\n+                asked: true,\n+                inner: Some(Box::new(MachineSnapshot::Noop)),\n+            },\n+        ),\n+        (\n+            \"SanCai\",\n+            MachineSnapshot::SanCai {\n+                owner: 0,\n+                stage: SanCaiStageSnap::Draw,\n+                target: Some(1),\n+            },\n+        ),\n+        (\n+            \"YiShang\",\n+            MachineSnapshot::YiShang {\n+                owner: 0,\n+                stage: YiShangStageSnap::Target,\n+            },\n+        ),\n+        (\"SuiDun\", MachineSnapshot::SuiDun),\n+        (\"SuQing\", MachineSnapshot::SuQing { target: 1 }),\n+        (\"ShouYi\", MachineSnapshot::ShouYi { owner: 0 }),\n+        (\n+            \"FanKui\",\n+            MachineSnapshot::FanKui {\n+                owner: 0,\n+                source: Some(1),\n+                asked: true,\n+            },\n+        ),\n+        (\n+            \"JianXiong\",\n+            MachineSnapshot::JianXiong {\n+                owner: 0,\n+                card: 1,\n+                asked: true,\n+            },\n+        ),\n+        (\"BiYue\", MachineSnapshot::BiYue { owner: 0 }),\n+        (\"JiZhi\", MachineSnapshot::JiZhi { owner: 0 }),\n+        (\n+            \"ZhiHeng\",\n+            MachineSnapshot::ZhiHeng {\n+                owner: 0,\n+                stage: ZhiHengStageSnap::Select,\n+            },\n+        ),\n+        (\n+            \"KuRou\",\n+            MachineSnapshot::KuRou {\n+                owner: 0,\n+                stage: KuRouStageSnap::Lose,\n+            },\n+        ),\n+        (\"LuoShen\", MachineSnapshot::LuoShen { owner: 0 }),\n+        (\"YingZi\", MachineSnapshot::YingZi { owner: 0 }),\n+        (\n+            \"Dismantle\",\n+            MachineSnapshot::Dismantle {\n+                card: 1,\n+                source: 0,\n+                target: 1,\n+                asked: true,\n+            },\n+        ),\n+        (\n+            \"MonkeySteal\",\n+            MachineSnapshot::MonkeySteal {\n+                card: 1,\n+                user: 0,\n+                holders: vec![1],\n+                asked: true,\n+            },\n+        ),\n+        (\"XiaoJi\", MachineSnapshot::XiaoJi { owner: 0 }),\n+        (\n+            \"QingNang\",\n+            MachineSnapshot::QingNang {\n+                owner: 0,\n+                stage: QingNangStageSnap::TargetAsk,\n+                healed: Some(1),\n+            },\n+        ),\n+        (\n+            \"JiJi\",\n+            MachineSnapshot::JiJi {\n+                owner: 0,\n+                stage: JiJiStageSnap::Draw,\n+                target: Some(1),\n+                given: 1,\n+            },\n+        ),\n+        (\n+            \"GangLie\",\n+            MachineSnapshot::GangLie {\n+                owner: 0,\n+                source: 1,\n+                asked: true,\n+            },\n+        ),\n+        (\n+            \"TuXi\",\n+            MachineSnapshot::TuXi {\n+                owner: 0,\n+                stage: TuXiStageSnap::Ask,\n+            },\n+        ),\n+        (\"LuoYi\", MachineSnapshot::LuoYi { owner: 0 }),\n+        (\n+            \"GuanXing\",\n+            MachineSnapshot::GuanXing {\n+                owner: 0,\n+                stage: GuanXingStageSnap::Arrange,\n+                top: vec![1, 2],\n+            },\n+        ),\n+        (\"LianYing\", MachineSnapshot::LianYing { owner: 0 }),\n+        (\n+            \"Rende\",\n+            MachineSnapshot::Rende {\n+                owner: 0,\n+                stage: RendeStageSnap::SelectCardsAsk,\n+                cards: vec![1],\n+            },\n+        ),\n+        (\n+            \"Jijiang\",\n+            MachineSnapshot::Jijiang {\n+                owner: 0,\n+                stage: JijiangStageSnap::HelperAsk,\n+                queue: Some(vec![1]),\n+                helper: Some(1),\n+                sha: Some(1),\n+                inner: Some(Box::new(MachineSnapshot::Noop)),\n+            },\n+        ),\n+        (\n+            \"Snatch\",\n+            MachineSnapshot::Snatch {\n+                card: 1,\n+                source: 0,\n+                target: 1,\n+                asked: true,\n+            },\n+        ),\n+        (\n+            \"JieYin\",\n+            MachineSnapshot::JieYin {\n+                owner: 0,\n+                stage: JieYinStageSnap::CardsAsk,\n+                cards: vec![1],\n+            },\n+        ),\n+        (\n+            \"FanJian\",\n+            MachineSnapshot::FanJian {\n+                owner: 0,\n+                stage: FanJianStageSnap::TargetAsk,\n+                target: Some(1),\n+                chosen_suit: None,\n+            },\n+        ),\n+        (\n+            \"LiJian\",\n+            MachineSnapshot::LiJian {\n+                owner: 0,\n+                stage: LiJianStageSnap::DiscardAsk,\n+                card: Some(1),\n+                inner: Some(Box::new(MachineSnapshot::Noop)),\n+            },\n+        ),\n+        (\n+            \"Host\",\n+            MachineSnapshot::Host {\n+                def_key: String::from(\"t:demo\"),\n+                behavior: 1,\n+                stage: 0,\n+                owner: 0,\n+                target: Some(1),\n+                card: Some(1),\n+                cards: Vec::new(),\n+                targets: Vec::new(),\n+            },\n+        ),\n+        (\n+            \"XiaoGuo\",\n+            MachineSnapshot::XiaoGuo {\n+                owner: 0,\n+                target: 1,\n+                stage: engine_native::snap::XiaoGuoStageSnap::Read,\n+            },\n+        ),\n+        (\n+            \"KuangFu\",\n+            MachineSnapshot::KuangFu {\n+                owner: 0,\n+                target: 1,\n+            },\n+        ),\n+        (\n+            \"YaoWu\",\n+            MachineSnapshot::YaoWu {\n+                owner: 0,\n+                source: 1,\n+                stage: engine_native::snap::YaoWuStageSnap::Ask,\n+            },\n+        ),\n+        (\n+            \"ShuShen\",\n+            MachineSnapshot::ShuShen {\n+                owner: 0,\n+                target: Some(1),\n+                stage: engine_native::snap::ShuShenStageSnap::Read,\n+            },\n+        ),\n+        (\"ShenZhi\", MachineSnapshot::ShenZhi { owner: 0 }),\n+        (\n+            \"XunXun\",\n+            MachineSnapshot::XunXun {\n+                owner: 0,\n+                stage: engine_native::snap::XunXunStageSnap::Arrange,\n+                top: vec![1, 2],\n+            },\n+        ),\n+        (\"WangXi\", MachineSnapshot::WangXi { owner: 0, other: 1 }),\n+        (\n+            \"JiJie\",\n+            MachineSnapshot::JiJie {\n+                owner: 0,\n+                card: Some(1),\n+                stage: engine_native::snap::JiJieStageSnap::Read,\n+            },\n+        ),\n+        (\"JiYuan\", MachineSnapshot::JiYuan { owner: 0 }),\n+        (\n+            \"WangZun\",\n+            MachineSnapshot::WangZun {\n+                owner: 0,\n+                target: 1,\n+            },\n+        ),\n+        (\n+            \"TongJi\",\n+            MachineSnapshot::TongJi {\n+                owner: 0,\n+                stage: engine_native::snap::TongJiStageSnap::Ask,\n+            },\n+        ),\n+        (\"Wuzhong\", MachineSnapshot::Wuzhong { owner: 0 }),\n+        (\"Taoyuan\", MachineSnapshot::Taoyuan { owner: 0 }),\n+        (\n+            \"Wugu\",\n+            MachineSnapshot::Wugu {\n+                owner: 0,\n+                cards: vec![1, 2],\n+                pickers: vec![0, 1],\n+            },\n+        ),\n+        (\n+            \"Jiedao\",\n+            MachineSnapshot::Jiedao {\n+                owner: 0,\n+                holder: 1,\n+                victim: 2,\n+                stage: engine_native::snap::JiedaoStageSnap::Ask,\n+            },\n+        ),\n+        (\n+            \"Zhangba\",\n+            MachineSnapshot::Zhangba {\n+                owner: 0,\n+                cards: vec![1],\n+                stage: engine_native::snap::ZhangbaStageSnap::Cards,\n+            },\n+        ),\n+        (\"BossXiangde\", MachineSnapshot::BossXiangde { owner: 0 }),\n+        (\"BossFutai\", MachineSnapshot::BossFutai { owner: 0 }),\n+        (\"BossLuanchang\", MachineSnapshot::BossLuanchang { owner: 0 }),\n+        (\"BossZhaohuo\", MachineSnapshot::BossZhaohuo { owner: 0 }),\n+        (\"Shedu\", MachineSnapshot::Shedu { owner: 0 }),\n+        (\n+            \"BossBuchun\",\n+            MachineSnapshot::BossBuchun {\n+                owner: 0,\n+                stage: 2,\n+                targets: vec![1, 2],\n+            },\n+        ),\n+        (\n+            \"BossXingxia\",\n+            MachineSnapshot::BossXingxia {\n+                owner: 0,\n+                stage: 1,\n+                actor: 2,\n+            },\n+        ),\n+        (\"BossQizuo\", MachineSnapshot::BossQizuo { owner: 0 }),\n+        (\"BossXiaoxiong\", MachineSnapshot::BossXiaoxiong { owner: 0 }),\n+        (\"BossLingbo\", MachineSnapshot::BossLingbo { owner: 0 }),\n+        (\"BossTashui\", MachineSnapshot::BossTashui { owner: 0 }),\n+        (\"BossZjLeiji\", MachineSnapshot::BossZjLeiji { owner: 0 }),\n+        (\"BossHeisheng\", MachineSnapshot::BossHeisheng { owner: 0 }),\n+        (\n+            \"BossLeizhu\",\n+            MachineSnapshot::BossLeizhu {\n+                owner: 0,\n+                emitted: 2,\n+            },\n+        ),\n+        (\n+            \"BossRenao\",\n+            MachineSnapshot::BossRenao {\n+                owner: 0,\n+                emitted: 1,\n+            },\n+        ),\n+        (\"BossWanghun\", MachineSnapshot::BossWanghun { owner: 0 }),\n+        (\n+            \"BossZhuxin\",\n+            MachineSnapshot::BossZhuxin {\n+                owner: 0,\n+                emitted: 1,\n+            },\n+        ),\n+        (\n+            \"BossPingdeng\",\n+            MachineSnapshot::BossPingdeng {\n+                owner: 0,\n+                emitted: 1,\n+            },\n+        ),\n+        (\n+            \"BossHuoxing\",\n+            MachineSnapshot::BossHuoxing {\n+                owner: 0,\n+                emitted: 1,\n+            },\n+        ),\n+        (\"BossBingfeng\", MachineSnapshot::BossBingfeng { owner: 0 }),\n+        (\"BossWangxiang\", MachineSnapshot::BossWangxiang { owner: 0 }),\n+        (\n+            \"Rvm\",\n+            MachineSnapshot::Rvm {\n+                owner: 0,\n+                module: Vec::new(),\n+                paused: None,\n+                skill_name: \"a0_rvm\".to_string(),\n+                event: engine_native::EventData::Phase {\n+                    player: 0,\n+                    phase: engine_native::Phase::End,\n+                    begin: true,\n+                },\n+                consume: Vec::new(),\n+                count_hits: false,\n+                commit_pending: Vec::new(),\n+                commit_pick: None,\n+                following: Vec::new(),\n+                commit_state: Vec::new(),\n+                committing: false,\n+            },\n+        ),\n+        (\n+            \"TriggerOrder\",\n+            MachineSnapshot::TriggerOrder {\n+                frame: 1,\n+                owner: 0,\n+                candidates: vec![1, 2],\n+                asked: true,\n+                cursor: 1,\n+                done: vec![(1, 3)],\n+                owners: vec![0, 1],\n+                normal_owners: 2,\n+            },\n+        ),\n+    ]\n+}\n+\n+/// match 穷尽性守卫：新增 `MachineSnapshot` 变体而未登记样例时编译失败。\n+fn variant_index(m: &MachineSnapshot) -> u32 {\n+    use MachineSnapshot as M;\n+    match m {\n+        M::Sha { .. } => 0,\n+        M::DyingSave { .. } => 1,\n+        M::Duel { .. } => 2,\n+        M::NullifyWindow { .. } => 3,\n+        M::JudgePhase { .. } => 4,\n+        M::Noop => 5,\n+        M::PlaceDelayed { .. } => 6,\n+        M::Aoe { .. } => 7,\n+        M::AoeTarget { .. } => 8,\n+        M::Chain { .. } => 9,\n+        M::DiscardToLimit { .. } => 10,\n+        M::Death { .. } => 11,\n+        M::OptionalGate { .. } => 12,\n+        M::SanCai { .. } => 13,\n+        M::YiShang { .. } => 14,\n+        M::SuiDun => 15,\n+        M::SuQing { .. } => 16,\n+        M::ShouYi { .. } => 17,\n+        M::FanKui { .. } => 18,\n+        M::JianXiong { .. } => 19,\n+        M::BiYue { .. } => 20,\n+        M::JiZhi { .. } => 21,\n+        M::ZhiHeng { .. } => 22,\n+        M::KuRou { .. } => 23,\n+        M::LuoShen { .. } => 24,\n+        M::YingZi { .. } => 25,\n+        M::Dismantle { .. } => 26,\n+        M::MonkeySteal { .. } => 27,\n+        M::XiaoJi { .. } => 28,\n+        M::QingNang { .. } => 29,\n+        M::JiJi { .. } => 30,\n+        M::GangLie { .. } => 31,\n+        M::TuXi { .. } => 32,\n+        M::LuoYi { .. } => 33,\n+        M::GuanXing { .. } => 34,\n+        M::LianYing { .. } => 35,\n+        M::Rende { .. } => 36,\n+        M::Jijiang { .. } => 37,\n+        M::Snatch { .. } => 38,\n+        M::JieYin { .. } => 39,\n+        M::FanJian { .. } => 40,\n+        M::LiJian { .. } => 41,\n+        M::Host { .. } => 42,\n+        M::XiaoGuo { .. } => 43,\n+        M::KuangFu { .. } => 44,\n+        M::YaoWu { .. } => 45,\n+        M::ShuShen { .. } => 46,\n+        M::ShenZhi { .. } => 47,\n+        M::XunXun { .. } => 48,\n+        M::WangXi { .. } => 49,\n+        M::JiJie { .. } => 50,\n+        M::JiYuan { .. } => 51,\n+        M::WangZun { .. } => 52,\n+        M::TongJi { .. } => 53,\n+        M::Wuzhong { .. } => 54,\n+        M::Taoyuan { .. } => 55,\n+        M::Wugu { .. } => 56,\n+        M::Jiedao { .. } => 57,\n+        M::Zhangba { .. } => 58,\n+        M::BossXiangde { .. } => 59,\n+        M::BossFutai { .. } => 60,\n+        M::BossLuanchang { .. } => 61,\n+        M::BossZhaohuo { .. } => 62,\n+        M::Shedu { .. } => 63,\n+        M::BossBuchun { .. } => 64,\n+        M::BossXingxia { .. } => 65,\n+        M::BossQizuo { .. } => 66,\n+        M::BossXiaoxiong { .. } => 67,\n+        M::BossLingbo { .. } => 68,\n+        M::BossTashui { .. } => 69,\n+        M::BossZjLeiji { .. } => 70,\n+        M::BossHeisheng { .. } => 71,\n+        M::BossLeizhu { .. } => 72,\n+        M::BossRenao { .. } => 73,\n+        M::BossWanghun { .. } => 74,\n+        M::BossZhuxin { .. } => 75,\n+        M::BossPingdeng { .. } => 76,\n+        M::BossHuoxing { .. } => 77,\n+        M::BossBingfeng { .. } => 78,\n+        M::BossWangxiang { .. } => 79,\n+        M::Rvm { .. } => 80,\n+        M::TriggerOrder { .. } => 81,\n+        M::DamageFlow { .. } => 82,\n+    }\n+}\n+\n+/// 单挂起机器的最小快照：真实建局后清空 parks 只留一个目标机器。\n+fn single_park_snapshot(machine: MachineSnapshot) -> StateSnapshot {\n+    let mut snap = Engine::new(7, 2).save();\n+    snap.resolution.parks = vec![ParkSnapshot {\n+        resume_depth: 0,\n+        slot: Slot::Intrinsic { frame: 0 },\n+        machine,\n+    }];\n+    snap\n+}\n+\n+/// 机器 tag 在编码字节流中的位置：剥离外层帧（22 字节头 + 32 字节\n+/// blake3 校验和）后在 payload 内用两个已知不同 tag 的机器做最长公共\n+/// 前缀校准（布局变化时校准断言失败提示修正，不静默错位）。\n+fn calibrate_machine_tag_pos() -> (Vec<Vec<u8>>, usize) {\n+    let samples = all_samples();\n+    let by_name =\n+        |n: &str| single_park_snapshot(samples.iter().find(|(k, _)| *k == n).unwrap().1.clone());\n+    fn payload(data: &[u8]) -> &[u8] {\n+        &data[22..data.len() - 32]\n+    }\n+    let noop_enc = encode_archive(&by_name(\"Noop\"));\n+    let death_enc = encode_archive(&by_name(\"Death\"));\n+    let (noop, death) = (payload(&noop_enc), payload(&death_enc));\n+    let pos = noop\n+        .iter()\n+        .zip(death.iter())\n+        .position(|(a, b)| a != b)\n+        .expect(\"Noop 与 Death 编码必须不同\");\n+    // 自检：校准位置恰是机器 tag 字节（Noop=5、Death=11，源码 tag 表）。\n+    assert_eq!(noop[pos], 5, \"机器 tag 定位失准（Noop）\");\n+    assert_eq!(death[pos], 11, \"机器 tag 定位失准（Death）\");\n+    let all = samples\n+        .into_iter()\n+        .map(|(_, m)| encode_archive(&single_park_snapshot(m)))\n+        .collect();\n+    (all, pos)\n+}\n+\n+#[test]\n+fn machine_snapshot_tags_unique_and_roundtrip() {\n+    // 剥离外层帧（22 字节头 + 32 字节 blake3 校验和）后的载荷。\n+    fn payload(data: &[u8]) -> &[u8] {\n+        &data[22..data.len() - 32]\n+    }\n+    let samples = all_samples();\n+    let (all_data, tag_pos) = calibrate_machine_tag_pos();\n+    assert_eq!(all_data.len(), samples.len(), \"样例数与编码数不一致\");\n+    assert_eq!(\n+        samples.len(),\n+        variant_index(&samples[samples.len() - 1].1) as usize + 1,\n+        \"变体清单不完整\"\n+    );\n+\n+    let mut tags: BTreeMap<u8, Vec<&str>> = BTreeMap::new();\n+    for ((name, machine), data) in samples.iter().zip(all_data.iter()) {\n+        let snap = single_park_snapshot(machine.clone());\n+        let decoded = decode_archive(data).unwrap_or_else(|e| panic!(\"{name} 往返解码失败: {e:?}\"));\n+        assert_eq!(&decoded, &snap, \"{name} 编码→解码往返不等\");\n+        tags.entry(payload(data)[tag_pos]).or_default().push(name);\n+    }\n+    let dups: Vec<String> = tags\n+        .iter()\n+        .filter(|(_, v)| v.len() > 1)\n+        .map(|(t, v)| format!(\"tag {t}: {v:?}\"))\n+        .collect();\n+    assert!(\n+        dups.is_empty(),\n+        \"MachineSnapshot 编码 tag 冲突（解码分支不可达）：\\n{}\",\n+        dups.join(\"\\n\")\n+    );\n+}\n+\n+#[test]\n+fn host_behavior_tags_unique() {\n+    // tag() 本身是 host.rs 内的穷尽 match（新增变体漏登记即编译失败）；这里校验\n+    // ALL 全变体 tag 唯一、from_tag 往返，且 from_tag 可达变体数恰为 ALL（ALL 漏列也失败）。\n+    let mut seen = std::collections::BTreeMap::new();\n+    for b in HostBehavior::ALL {\n+        let t = b.tag();\n+        if let Some(prev) = seen.insert(t, b) {\n+            panic!(\"HostBehavior tag {t} 冲突：{prev:?} 与 {b:?}\");\n+        }\n+        assert_eq!(HostBehavior::from_tag(t), Some(b), \"tag {t} 往返失败\");\n+    }\n+    let reachable = (0..=u16::MAX).filter_map(HostBehavior::from_tag).count();\n+    assert_eq!(\n+        reachable,\n+        HostBehavior::ALL.len(),\n+        \"from_tag 可达变体数与 ALL 不符\"\n+    );\n+}"},{"sha":"4675812c15c7a4776bcb0961b0548f0106a728bb","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20-v3/baseline-changed/crates/engine-native/tests/c331_canonical_damage.rs","status":"added","additions":355,"deletions":0,"changes":355,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native%2Ftests%2Fc331_canonical_damage.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native%2Ftests%2Fc331_canonical_damage.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native%2Ftests%2Fc331_canonical_damage.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1,355 @@\n+use engine_native::content::extension::{ExtensionDef, ExtensionPack, InitHook};\n+use engine_native::event::DamageNature;\n+use engine_native::{Engine, Phase};\n+fn pack(body: &str) -> ExtensionPack {\n+    let source =\n+        format!(\"skill c9_target(99109001) {{ trigger damage owner_is_target {{ {body} }} }}\");\n+    let p = content_compiler::compile_source_named(\"c9-damage\", &source).unwrap();\n+    ExtensionPack {\n+        def: ExtensionDef {\n+            name: \"c9-damage\",\n+            version: 1,\n+            description: \"real VM damage window\",\n+        },\n+        generals: vec![],\n+        cards: vec![],\n+        host_skills: vec![],\n+        vm_skills: content_native_loader::bridge_vm_skill_decls(&p)\n+            .unwrap()\n+            .decls,\n+        init_hook: InitHook::None,\n+        enabled: true,\n+    }\n+}\n+fn engine(p: &ExtensionPack) -> Engine {\n+    let mut e = Engine::new_with_extensions(11901, 3, &[p]).unwrap();\n+    e.debug_set_turn(0, Phase::Play, 1);\n+    e.debug_grant(1, \"c9_target\");\n+    e\n+}\n+#[test]\n+fn c9_cancelled_root_does_not_dispatch_target_damage() {\n+    let p = pack(\"effect draw_cards(self,1);\");\n+    let mut e = engine(&p);\n+    e.state_core_mut().player_mut(1).jidong_active = true;\n+    let hand = e.state_core().player(1).hand.len();\n+    e.debug_deal_damage(Some(0), 1, 1, DamageNature::Normal);\n+    assert_eq!(\n+        e.state_core().player(1).hand.len(),\n+        hand,\n+        \"cancelled damage has no target damage window\"\n+    );\n+}\n+#[test]\n+fn c9_target_damage_runs_before_dying_subtree() {\n+    let p = pack(\"effect recover_hp(self,1);\");\n+    let mut e = engine(&p);\n+    e.debug_set_hp(1, 1);\n+    e.debug_deal_damage(Some(0), 1, 1, DamageNature::Normal);\n+    assert_eq!(\n+        e.debug_hp(1),\n+        1,\n+        \"target damage skill recovers before dying collection\"\n+    );\n+    assert!(e.open_choice().is_none(), \"no premature rescue choice\");\n+}\n+#[test]\n+fn c9_chain_child_does_not_overtake_parent_dying() {\n+    let mut e = Engine::new(11902, 3);\n+    e.debug_set_turn(0, Phase::Play, 1);\n+    e.debug_set_hp(1, 1);\n+    e.debug_move_named_card_to_hand(0, \"tao\");\n+    e.state_core_mut().player_mut(1).linked = true;\n+    e.state_core_mut().player_mut(2).linked = true;\n+    e.debug_deal_damage(Some(0), 1, 1, DamageNature::Fire);\n+    assert!(e.open_choice().is_some(), \"parent rescue is pending\");\n+    assert_eq!(\n+        e.debug_hp(2),\n+        4,\n+        \"chain child waits for complete parent dying subtree\"\n+    );\n+}\n+fn optional_pack() -> ExtensionPack {\n+    let p=content_compiler::compile_source_named(\"c9-optional\",\"skill c9_pause(99109002) { trigger damage owner_is_target optional { effect draw_cards(self,1); } }\").unwrap();\n+    ExtensionPack {\n+        def: ExtensionDef {\n+            name: \"c9-optional\",\n+            version: 1,\n+            description: \"real target optional pause\",\n+        },\n+        generals: vec![],\n+        cards: vec![],\n+        host_skills: vec![],\n+        vm_skills: content_native_loader::bridge_vm_skill_decls(&p)\n+            .unwrap()\n+            .decls,\n+        init_hook: InitHook::None,\n+        enabled: true,\n+    }\n+}\n+#[test]\n+fn c9_full_armor_retains_source_quantity_positive_receipt_and_zero_hp_loss() {\n+    let p = optional_pack();\n+    let mut e = Engine::new_with_extensions(11903, 3, &[&p]).unwrap();\n+    e.debug_grant(1, \"c9_pause\");\n+    e.debug_set_hujia(1, 3);\n+    e.debug_deal_damage(Some(0), 1, 2, DamageNature::Normal);\n+    assert!(e.open_choice().is_some());\n+    let s = e.save();\n+    let d = s\n+        .resolution\n+        .stack\n+        .iter()\n+        .find_map(|f| {\n+            if let engine_native::event::EventData::Damage(d) = &f.data {\n+                Some(d)\n+            } else {\n+                None\n+            }\n+        })\n+        .unwrap();\n+    assert_eq!(d.amount, 2);\n+    assert_eq!(d.settlement.committed_damage, Some(2));\n+    assert_eq!(d.settlement.hp_loss, 0);\n+    assert_eq!(e.debug_hp(1), 4);\n+    assert_eq!(e.state_core().player(1).hujia, 1);\n+    let bytes = engine_native::archive::encode_archive(&s);\n+    let decoded = engine_native::archive::decode_archive(&bytes).unwrap();\n+    assert_eq!(decoded, s);\n+    let restored = Engine::restore_with_extensions(&decoded, &[&p]).unwrap();\n+    let mut after = restored.save();\n+    after.auth_generation = s.auth_generation;\n+    assert_eq!(after, s);\n+    assert_eq!(e.state_hash(), restored.state_hash());\n+}\n+#[test]\n+fn c9_changed_root_amount_matches_damage_log_and_later_vm_context() {\n+    let source=\"skill c9_modify(99109003) { trigger damage_before owner_is_target { effect modify_current_damage(self,1); } } skill c9_pause(99109002) { trigger damage owner_is_target optional { effect draw_cards(self,1); } }\";\n+    let p = content_compiler::compile_source_named(\"c9-modify\", source).unwrap();\n+    let p = ExtensionPack {\n+        def: ExtensionDef {\n+            name: \"c9-modify\",\n+            version: 1,\n+            description: \"actual VM before and target windows\",\n+        },\n+        generals: vec![],\n+        cards: vec![],\n+        host_skills: vec![],\n+        vm_skills: content_native_loader::bridge_vm_skill_decls(&p)\n+            .unwrap()\n+            .decls,\n+        init_hook: InitHook::None,\n+        enabled: true,\n+    };\n+    let mut e = Engine::new_with_extensions(11904, 3, &[&p]).unwrap();\n+    e.debug_grant(1, \"c9_modify\");\n+    e.debug_grant(1, \"c9_pause\");\n+    e.debug_deal_damage(Some(0), 1, 1, DamageNature::Normal);\n+    assert_eq!(e.debug_hp(1), 2);\n+    let s = e.save();\n+    let d = s\n+        .resolution\n+        .stack\n+        .iter()\n+        .find_map(|f| match &f.data {\n+            engine_native::event::EventData::Damage(d) => Some(d),\n+            _ => None,\n+        })\n+        .unwrap();\n+    assert_eq!(d.amount, 2);\n+    assert_eq!(d.settlement.committed_damage, Some(2));\n+    assert!(e.log().iter().any(|x| matches!(\n+        x,\n+        engine_native::machine::LogEvent::DamageDealt { amount: 2, .. }\n+    )));\n+    let mut forged = s.clone();\n+    let f = forged\n+        .resolution\n+        .stack\n+        .iter_mut()\n+        .find(|f| matches!(f.data, engine_native::event::EventData::Damage(_)))\n+        .unwrap();\n+    f.stage = engine_native::event::Stage::Commit;\n+    assert!(Engine::restore_with_extensions(&forged, &[&p]).is_err());\n+}\n+#[test]\n+fn c9_real_vm_source_window_uses_qualified_root_and_byte_restore() {\n+    let raw=content_compiler::compile_source_named(\"c9-source\",\"skill c9_source(99109005) { trigger damage owner_is_source optional { effect draw_cards(self,event_amount); } }\").unwrap();\n+    let mut decls = content_native_loader::bridge_vm_skill_decls(&raw)\n+        .unwrap()\n+        .decls;\n+    decls[0].trigger.event = engine_native::event::EventKind::DamageSource;\n+    let p = ExtensionPack {\n+        def: ExtensionDef {\n+            name: \"c9-source\",\n+            version: 1,\n+            description: \"real declared VM source binding\",\n+        },\n+        generals: vec![],\n+        cards: vec![],\n+        host_skills: vec![],\n+        vm_skills: decls,\n+        init_hook: InitHook::None,\n+        enabled: true,\n+    };\n+    let mut e = Engine::new_with_extensions(11905, 3, &[&p]).unwrap();\n+    e.debug_grant(0, \"c9_source\");\n+    let hand = e.state_core().player(0).hand.len();\n+    e.debug_deal_damage(Some(0), 1, 2, DamageNature::Normal);\n+    assert_eq!(e.open_choice().unwrap().spec.prompt, \"trigger_confirm\");\n+    let s = e.save();\n+    let window = s\n+        .resolution\n+        .stack\n+        .iter()\n+        .find(|f| matches!(f.data, engine_native::event::EventData::DamageWindow { .. }))\n+        .unwrap();\n+    assert_eq!(window.kind, engine_native::event::EventKind::DamageSource);\n+    let decoded =\n+        engine_native::archive::decode_archive(&engine_native::archive::encode_archive(&s))\n+            .unwrap();\n+    let mut r = Engine::restore_with_extensions(&decoded, &[&p]).unwrap();\n+    let mut normalized = r.save();\n+    normalized.auth_generation = s.auth_generation;\n+    assert_eq!(normalized, s);\n+    let mut forged = s.clone();\n+    let frame = forged\n+        .resolution\n+        .stack\n+        .iter_mut()\n+        .find(|f| matches!(f.data, engine_native::event::EventData::DamageWindow { .. }))\n+        .unwrap();\n+    if let engine_native::event::EventData::DamageWindow { root, .. } = &mut frame.data {\n+        *root = frame.id;\n+    }\n+    assert!(Engine::restore_with_extensions(&forged, &[&p]).is_err());\n+    for game in [&mut e, &mut r] {\n+        let choice = game.open_choice().unwrap().clone();\n+        let out = game.submit(engine_native::GameCommand {\n+            actor: choice.observer,\n+            expected_revision: game.revision(),\n+            dedup_id: game.revision() + 1,\n+            action: engine_native::GameAction::Answer {\n+                choice_id: choice.id,\n+                selection: vec![engine_native::ChoiceOption::Confirm],\n+            },\n+        });\n+        assert!(!matches!(out, engine_native::CommandOutcome::Rejected(_)));\n+    }\n+    assert_eq!(e.state_core().player(0).hand.len(), hand + 2);\n+    assert_eq!(e.state_hash(), r.state_hash());\n+    let mut a = e.save();\n+    let mut b = r.save();\n+    a.auth_generation = 0;\n+    b.auth_generation = 0;\n+    assert_eq!(a, b);\n+}\n+#[test]\n+fn c9_zero_window_runs_once_and_signed_overflow_is_atomic() {\n+    let raw = content_compiler::compile_source_named(\n+        \"c9-zero\",\n+        \"skill c9_zero(99109006) { trigger damage owner_is_target { effect draw_cards(self,1); } }\",\n+    )\n+    .unwrap();\n+    let mut decls = content_native_loader::bridge_vm_skill_decls(&raw)\n+        .unwrap()\n+        .decls;\n+    decls[0].trigger.event = engine_native::event::EventKind::DamageZero;\n+    let p = ExtensionPack {\n+        def: ExtensionDef {\n+            name: \"c9-zero\",\n+            version: 1,\n+            description: \"genuine zero window handler\",\n+        },\n+        generals: vec![],\n+        cards: vec![],\n+        host_skills: vec![],\n+        vm_skills: decls,\n+        init_hook: InitHook::None,\n+        enabled: true,\n+    };\n+    let mut e = Engine::new_with_extensions(11906, 3, &[&p]).unwrap();\n+    e.debug_grant(1, \"c9_zero\");\n+    let hand = e.state_core().player(1).hand.len();\n+    e.debug_deal_damage(Some(0), 1, 0, DamageNature::Normal);\n+    assert_eq!(e.state_core().player(1).hand.len(), hand + 1);\n+    assert_eq!(e.debug_hp(1), 4);\n+    let p=content_compiler::compile_source_named(\"c9-overflow\",\"skill c9_overflow(99109007) { trigger damage_before owner_is_target { effect modify_current_damage(self,1); } }\").unwrap();\n+    let p = ExtensionPack {\n+        def: ExtensionDef {\n+            name: \"c9-overflow\",\n+            version: 1,\n+            description: \"checked signed boundary\",\n+        },\n+        generals: vec![],\n+        cards: vec![],\n+        host_skills: vec![],\n+        vm_skills: content_native_loader::bridge_vm_skill_decls(&p)\n+            .unwrap()\n+            .decls,\n+        init_hook: InitHook::None,\n+        enabled: true,\n+    };\n+    let mut e = Engine::new_with_extensions(11907, 3, &[&p]).unwrap();\n+    e.debug_grant(1, \"c9_overflow\");\n+    let before = e.save();\n+    assert!(matches!(\n+        e.debug_deal_damage(Some(0), 1, i32::MAX as u32, DamageNature::Normal),\n+        engine_native::CommandOutcome::Rejected(_)\n+    ));\n+    assert_eq!(e.save(), before);\n+}\n+#[test]\n+fn c9_infinite_hp_keeps_positive_source_receipt() {\n+    let p = optional_pack();\n+    let mut e = Engine::new_with_extensions(11908, 3, &[&p]).unwrap();\n+    e.debug_grant(1, \"c9_pause\");\n+    e.debug_set_max_hp(1, i32::MAX as u32);\n+    e.debug_set_hp(1, i32::MAX);\n+    e.debug_deal_damage(Some(0), 1, 3, DamageNature::Normal);\n+    assert!(e.open_choice().is_some());\n+    let s = e.save();\n+    let d = s\n+        .resolution\n+        .stack\n+        .iter()\n+        .find_map(|f| match &f.data {\n+            engine_native::event::EventData::Damage(d) => Some(d),\n+            _ => None,\n+        })\n+        .unwrap();\n+    assert_eq!(d.amount, 3);\n+    assert_eq!(d.settlement.committed_damage, Some(3));\n+    assert_eq!(d.settlement.hp_loss, 0);\n+    assert_eq!(e.debug_hp(1), i32::MAX);\n+}\n+#[test]\n+fn c9_lose_hp_replacement_has_no_damage_receipt_or_target_trigger() {\n+    let p = pack(\"effect draw_cards(self,1);\");\n+    let mut e = engine(&p);\n+    e.debug_grant(0, \"绝情\");\n+    e.debug_set_hp(1, 1);\n+    e.debug_move_named_card_to_hand(0, \"tao\");\n+    let hand = e.state_core().player(1).hand.len();\n+    e.debug_deal_damage(Some(0), 1, 1, DamageNature::Normal);\n+    let s = e.save();\n+    let d = s\n+        .resolution\n+        .stack\n+        .iter()\n+        .find_map(|f| match &f.data {\n+            engine_native::event::EventData::Damage(d) => Some(d),\n+            _ => None,\n+        })\n+        .unwrap();\n+    assert_eq!(\n+        d.settlement.outcome,\n+        engine_native::event::DamageOutcome::ReplacedByLoseHp\n+    );\n+    assert_eq!(d.settlement.committed_damage, None);\n+    assert_eq!(e.state_core().player(1).hand.len(), hand);\n+    assert!(!e\n+        .log()\n+        .iter()\n+        .any(|x| matches!(x, engine_native::machine::LogEvent::DamageDealt { .. })));\n+}"},{"sha":"e69de29bb2d1d6434b8b29ae775ad8c2e48c5391","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20-v3/baseline-changed/crates/engine-native/tests/c331_prehp_damage.rs","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native%2Ftests%2Fc331_prehp_damage.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native%2Ftests%2Fc331_prehp_damage.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native%2Ftests%2Fc331_prehp_damage.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8"},{"sha":"115286d520ef4cb14558506f19ea793a0870fc5b","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20-v3/baseline-changed/crates/engine-native/tests/g1_shahai_swd/xielv.rs","status":"added","additions":278,"deletions":0,"changes":278,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native%2Ftests%2Fg1_shahai_swd%2Fxielv.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native%2Ftests%2Fg1_shahai_swd%2Fxielv.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native%2Ftests%2Fg1_shahai_swd%2Fxielv.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1,278 @@\n+use super::*;\n+\n+/// T12 swd 武将面批 25：双技部分转正——协律（壶中仙 tag 284：弃牌阶段\n+/// 结束[End 帧入场]手牌≥2 同色，可选回复 1 并弃置场上全部判定牌）；朱\n+/// 羽（芝茵 tag 285：横置角色受到非传导伤害，可选弃红牌使伤害+1 且改\n+/// 火属性）。\n+#[test]\n+fn swd_generals_b25_xielv_zhuyu() {\n+    use engine_native::catalog::Suit;\n+    let root =\n+        std::path::PathBuf::from(env!(\"CARGO_MANIFEST_DIR\")).join(\"../../packages/extensions\");\n+    let dir = tempfile::tempdir().unwrap();\n+    let store = PackageStore::open(dir.path().join(\"store\")).unwrap();\n+    let report = import_extensions(&store, &root, &options()).expect(\"import\");\n+    let meta = report\n+        .installed\n+        .iter()\n+        .find(|m| m.package_id == \"shahai-swd\")\n+        .expect(\"swd 安装\")\n+        .clone();\n+    let json = std::fs::read_to_string(\n+        std::path::PathBuf::from(meta.extension_root.as_ref().unwrap()).join(\"assets/cards.json\"),\n+    )\n+    .unwrap();\n+    let pack = bridge(&json);\n+    let mut e = Engine::new_with_extensions(62008, 4, &[&pack]).expect(\"建局\");\n+    let confirm = |e: &mut Engine, want_obs: u8| {\n+        let (cid, obs) = e.open_choice().map(|c| (c.id, c.observer)).expect(\"确认窗\");\n+        assert_eq!(obs, want_obs, \"确认窗归属\");\n+        let conf: Vec<ChoiceOption> = {\n+            let ch = e.open_choice().expect(\"still open\");\n+            ch.spec\n+                .options\n+                .iter()\n+                .filter(|o| matches!(o, ChoiceOption::Confirm))\n+                .cloned()\n+                .collect()\n+        };\n+        assert_eq!(conf.len(), 1);\n+        submit(\n+            e,\n+            obs,\n+            GameAction::Answer {\n+                choice_id: cid,\n+                selection: conf,\n+            },\n+        );\n+    };\n+    let pick_red = |e: &mut Engine| {\n+        let (cid, obs) = e\n+            .open_choice()\n+            .map(|c| (c.id, c.observer))\n+            .expect(\"朱羽选牌窗\");\n+        let sel: Vec<ChoiceOption> = {\n+            let ch = e.open_choice().expect(\"still open\");\n+            ch.spec\n+                .options\n+                .iter()\n+                .filter(|o| matches!(o, ChoiceOption::Card(c) if matches!(e.catalog().cards[*c as usize].suit, Suit::Heart | Suit::Diamond)))\n+                .cloned()\n+                .take(1)\n+                .collect()\n+        };\n+        assert_eq!(sel.len(), 1, \"朱羽红牌面\");\n+        submit(\n+            e,\n+            obs,\n+            GameAction::Answer {\n+                choice_id: cid,\n+                selection: sel,\n+            },\n+        );\n+    };\n+\n+    // ① 协律：p0 手 2 红（桃+红杀），受伤断言回 1；p1 判定区有乐 → 被清\n+    e.debug_grant(0, \"xielv\");\n+    advance_to_play(&mut e, 0);\n+    for p in 0..4 {\n+        e.debug_clear_hand(p);\n+    }\n+    let _t1 = e.debug_place(0, \"tao\");\n+    {\n+        let id = e.debug_set_deck_top_by(|d| {\n+            d.kind.is_sha_like() && matches!(d.suit, Suit::Heart | Suit::Diamond)\n+        });\n+        let core = e.state_core_mut();\n+        core.deck.retain(|x| *x != id);\n+        core.players[0].hand.push(id);\n+    }\n+    let _le = e.debug_place_judge(1, \"le\");\n+    assert_eq!(\n+        e.state_core().player(1).judge.len(),\n+        1,\n+        \"布阵：p1 判定区 1 张\"\n+    );\n+    e.debug_set_hp(0, 3);\n+    submit(&mut e, 0, GameAction::NextPhase); // Play→Discard（手 2 ≤ 上限无弃牌窗）\n+    submit(&mut e, 0, GameAction::NextPhase); // Discard→End，End 入场触发\n+    confirm(&mut e, 0);\n+    settle_optional_confirm(&mut e);\n+    assert_eq!(e.debug_hp(0), 4, \"协律：回 1（3→4）\");\n+    assert!(\n+        e.state_core().player(1).judge.is_empty(),\n+        \"协律：判定牌全清\"\n+    );\n+\n+    // 反例 ①b：手牌异色 → 下一回合 End 入场无窗\n+    advance_to_play(&mut e, 0);\n+    for p in 0..4 {\n+        e.debug_clear_hand(p);\n+    }\n+    let _t2 = e.debug_place(0, \"tao\");\n+    {\n+        let id = e.debug_set_deck_top_by(|d| {\n+            d.kind.is_sha_like() && matches!(d.suit, Suit::Spade | Suit::Club)\n+        });\n+        let core = e.state_core_mut();\n+        core.deck.retain(|x| *x != id);\n+        core.players[0].hand.push(id);\n+    }\n+    e.debug_set_hp(0, 3);\n+    submit(&mut e, 0, GameAction::NextPhase);\n+    submit(&mut e, 0, GameAction::NextPhase);\n+    assert!(e.open_choice().is_none(), \"协律反例：异色不触发\");\n+\n+    // 反例 ①c：手牌不足 2 张 → 无窗\n+    advance_to_play(&mut e, 0);\n+    for p in 0..4 {\n+        e.debug_clear_hand(p);\n+    }\n+    let _t3 = e.debug_place(0, \"tao\");\n+    submit(&mut e, 0, GameAction::NextPhase);\n+    submit(&mut e, 0, GameAction::NextPhase);\n+    assert!(e.open_choice().is_none(), \"协律反例：单张不触发\");\n+    {\n+        let def_xl = e.catalog().skill_by_name(\"xielv\").expect(\"协律 def\");\n+        let mut snap = e.save();\n+        snap.core.skills.remove(&(0, def_xl));\n+        e = Engine::restore_with_extensions(&snap, &[&pack]).expect(\"撤销协律\");\n+    }\n+\n+    // ② 朱羽：撤销协律后 p0 持朱羽，p1 横置，p2 杀 p1 → 确认+弃红 → 2 伤\n+    e.debug_grant(0, \"zhuyu\");\n+    advance_to_play(&mut e, 2);\n+    for p in 0..4 {\n+        e.debug_clear_hand(p);\n+    }\n+    {\n+        let core = e.state_core_mut();\n+        core.players[1].linked = true;\n+    }\n+    let _red = {\n+        let id = e.debug_set_deck_top_by(|d| {\n+            d.kind.is_sha_like() && matches!(d.suit, Suit::Heart | Suit::Diamond)\n+        });\n+        let core = e.state_core_mut();\n+        core.deck.retain(|x| *x != id);\n+        core.players[0].hand.push(id);\n+        id\n+    };\n+    let sha_z = e.debug_place(2, \"sha\");\n+    e.debug_set_hp(1, 8);\n+    submit(\n+        &mut e,\n+        2,\n+        GameAction::PlayCard {\n+            card: sha_z,\n+            targets: vec![1],\n+        },\n+    );\n+    confirm(&mut e, 0);\n+    pick_red(&mut e);\n+    settle_optional_confirm(&mut e);\n+    assert_eq!(e.debug_hp(1), 6, \"朱羽：横置目标伤害 +1（8-2）\");\n+    assert_eq!(hand_len_w(&e, 0), 0, \"朱羽：红牌已弃\");\n+\n+    // 反例 ②b：取消 → 1 伤\n+    {\n+        let mut snap = e.save();\n+        snap.core.turn.sha_used_play_phase = false;\n+        e = Engine::restore_with_extensions(&snap, &[&pack]).expect(\"重置\");\n+    }\n+    for p in 0..4 {\n+        e.debug_clear_hand(p);\n+    }\n+    let _red2 = {\n+        let id = e.debug_set_deck_top_by(|d| {\n+            d.kind.is_sha_like() && matches!(d.suit, Suit::Heart | Suit::Diamond)\n+        });\n+        let core = e.state_core_mut();\n+        core.deck.retain(|x| *x != id);\n+        core.players[0].hand.push(id);\n+        id\n+    };\n+    let sha_z2 = e.debug_place(2, \"sha\");\n+    e.debug_set_hp(1, 8);\n+    submit(\n+        &mut e,\n+        2,\n+        GameAction::PlayCard {\n+            card: sha_z2,\n+            targets: vec![1],\n+        },\n+    );\n+    let (cid, obs) = e\n+        .open_choice()\n+        .map(|c| (c.id, c.observer))\n+        .expect(\"朱羽取消窗\");\n+    submit(\n+        &mut e,\n+        obs,\n+        GameAction::Answer {\n+            choice_id: cid,\n+            selection: vec![],\n+        },\n+    );\n+    settle_optional_confirm(&mut e);\n+    assert_eq!(e.debug_hp(1), 7, \"朱羽反例：取消 → 1 伤\");\n+\n+    // 反例 ②c：目标未横置 → 无窗\n+    {\n+        let mut snap = e.save();\n+        snap.core.turn.sha_used_play_phase = false;\n+        e = Engine::restore_with_extensions(&snap, &[&pack]).expect(\"重置\");\n+    }\n+    for p in 0..4 {\n+        e.debug_clear_hand(p);\n+    }\n+    {\n+        let core = e.state_core_mut();\n+        core.players[1].linked = false;\n+    }\n+    let _red3 = {\n+        let id = e.debug_set_deck_top_by(|d| {\n+            d.kind.is_sha_like() && matches!(d.suit, Suit::Heart | Suit::Diamond)\n+        });\n+        let core = e.state_core_mut();\n+        core.deck.retain(|x| *x != id);\n+        core.players[0].hand.push(id);\n+        id\n+    };\n+    let sha_z3 = e.debug_place(2, \"sha\");\n+    e.debug_set_hp(1, 8);\n+    submit(\n+        &mut e,\n+        2,\n+        GameAction::PlayCard {\n+            card: sha_z3,\n+            targets: vec![1],\n+        },\n+    );\n+    assert!(e.open_choice().is_none(), \"朱羽反例：未横置不触发\");\n+\n+    // 反例 ②d：持有者无红牌 → 无窗\n+    {\n+        let mut snap = e.save();\n+        snap.core.turn.sha_used_play_phase = false;\n+        e = Engine::restore_with_extensions(&snap, &[&pack]).expect(\"重置\");\n+    }\n+    for p in 0..4 {\n+        e.debug_clear_hand(p);\n+    }\n+    {\n+        let core = e.state_core_mut();\n+        core.players[1].linked = true;\n+    }\n+    let sha_z4 = e.debug_place(2, \"sha\");\n+    e.debug_set_hp(1, 8);\n+    submit(\n+        &mut e,\n+        2,\n+        GameAction::PlayCard {\n+            card: sha_z4,\n+            targets: vec![1],\n+        },\n+    );\n+    assert!(e.open_choice().is_none(), \"朱羽反例：无红牌不触发\");\n+}"},{"sha":"d46513f411edb3ad5167dc608ab5989dce69bc85","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20-v3/baseline-changed/crates/engine-native/tests/g1_wudian/yuanshi.rs","status":"added","additions":252,"deletions":0,"changes":252,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native%2Ftests%2Fg1_wudian%2Fyuanshi.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native%2Ftests%2Fg1_wudian%2Fyuanshi.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native%2Ftests%2Fg1_wudian%2Fyuanshi.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1,252 @@\n+use super::*;\n+\n+/// 飞刃：黑桃杀 +1（4→2）；杀无视距离（距离 2 可达）；梅花杀双目标\n+/// 可达（非梅花杀双目标仍拒）。\n+#[test]\n+fn yuanshi_feiren_bonus_range_and_club_extra_target() {\n+    let root = repo_extensions_root();\n+    let discovered = discover_extensions(&root).expect(\"discover\");\n+    let dir = tempfile::tempdir().unwrap();\n+    let store = PackageStore::open(dir.path().join(\"store\")).unwrap();\n+    let _ = import_extensions(&store, &root, &options()).expect(\"import\");\n+    let disc = discovered\n+        .into_iter()\n+        .find(|d| d.name == \"shaai-ow-upstream-noname\")\n+        .expect(\"ow 可发现\");\n+    let json = std::fs::read_to_string(disc.root.join(\"assets/cards.json\")).unwrap();\n+    let pack = bridge(&json);\n+\n+    let mut e = Engine::new_with_extensions(9931, 5, &[&pack]).expect(\"建局\");\n+    advance_loop(&mut e, 0);\n+    for p in 0..5 {\n+        e.debug_clear_hand(p);\n+    }\n+    e.debug_grant(0, \"feiren\");\n+    // 诸葛连弩：出杀不限次（飞刃无次数豁免，测试需连出多杀）\n+    let zhuge = e.debug_place(0, \"zhuge\");\n+    let out = submit(\n+        &mut e,\n+        0,\n+        GameAction::PlayCard {\n+            card: zhuge,\n+            targets: vec![],\n+        },\n+    );\n+    assert!(\n+        matches!(out, CommandOutcome::Accepted { .. }),\n+        \"装备连弩: {out:?}\"\n+    );\n+    // 多放几张杀保证三种花色齐备\n+    for _ in 0..8 {\n+        e.debug_place(0, \"sha\");\n+    }\n+    let spade = pick_suit(&e, engine_native::catalog::Suit::Spade).expect(\"应有黑桃杀\");\n+    let club = pick_suit(&e, engine_native::catalog::Suit::Club).expect(\"应有梅花杀\");\n+    let red = pick_suit(&e, engine_native::catalog::Suit::Heart)\n+        .or_else(|| pick_suit(&e, engine_native::catalog::Suit::Diamond))\n+        .expect(\"应有红杀\");\n+    e.debug_set_hp(1, 4);\n+    e.debug_set_hp(2, 4);\n+\n+    // ① 黑桃杀 +1（距离 1）\n+    let out = submit(\n+        &mut e,\n+        0,\n+        GameAction::PlayCard {\n+            card: spade,\n+            targets: vec![1],\n+        },\n+    );\n+    assert!(\n+        matches!(\n+            out,\n+            CommandOutcome::Accepted { .. } | CommandOutcome::Pending { .. }\n+        ),\n+        \"{out:?}\"\n+    );\n+    while let Some(c) = e.open_choice() {\n+        let (cid, obs) = (c.id, c.observer);\n+        submit(\n+            &mut e,\n+            obs,\n+            GameAction::Answer {\n+                choice_id: cid,\n+                selection: vec![ChoiceOption::Pass],\n+            },\n+        );\n+    }\n+    assert_eq!(e.debug_hp(1), 2, \"黑桃杀 +1（4→2）\");\n+\n+    // ② 杀无视距离：距离 2 的 2 号可达（红杀无加成 4→3）\n+    let out = submit(\n+        &mut e,\n+        0,\n+        GameAction::PlayCard {\n+            card: red,\n+            targets: vec![2],\n+        },\n+    );\n+    assert!(\n+        matches!(\n+            out,\n+            CommandOutcome::Accepted { .. } | CommandOutcome::Pending { .. }\n+        ),\n+        \"飞刃杀无视距离：{out:?}\"\n+    );\n+    while let Some(c) = e.open_choice() {\n+        let (cid, obs) = (c.id, c.observer);\n+        submit(\n+            &mut e,\n+            obs,\n+            GameAction::Answer {\n+                choice_id: cid,\n+                selection: vec![ChoiceOption::Pass],\n+            },\n+        );\n+    }\n+    assert_eq!(e.debug_hp(2), 3, \"红杀无加成（4→3）\");\n+\n+    // ③ 梅花杀双目标（feiren_extra=1）；红杀双目标仍拒\n+    let out = submit(\n+        &mut e,\n+        0,\n+        GameAction::PlayCard {\n+            card: club,\n+            targets: vec![1, 2],\n+        },\n+    );\n+    assert!(\n+        matches!(\n+            out,\n+            CommandOutcome::Accepted { .. } | CommandOutcome::Pending { .. }\n+        ),\n+        \"梅花杀双目标：{out:?}\"\n+    );\n+    while let Some(c) = e.open_choice() {\n+        let (cid, obs) = (c.id, c.observer);\n+        submit(\n+            &mut e,\n+            obs,\n+            GameAction::Answer {\n+                choice_id: cid,\n+                selection: vec![ChoiceOption::Pass],\n+            },\n+        );\n+    }\n+    // 1/2 各再受 1（梅花无黑桃加成）\n+    assert_eq!(e.debug_hp(1), 1, \"梅花杀无黑桃加成（2→1）\");\n+    assert_eq!(e.debug_hp(2), 2, \"梅花杀（3→2）\");\n+\n+    let red2 = pick_suit(&e, engine_native::catalog::Suit::Heart)\n+        .or_else(|| pick_suit(&e, engine_native::catalog::Suit::Diamond));\n+    if let Some(r2) = red2 {\n+        let out = submit(\n+            &mut e,\n+            0,\n+            GameAction::PlayCard {\n+                card: r2,\n+                targets: vec![1, 2],\n+            },\n+        );\n+        assert!(\n+            matches!(\n+                &out,\n+                CommandOutcome::Rejected(engine_native::RejectReason::IllegalTargets)\n+            ),\n+            \"非梅花杀双目标应拒：{out:?}\"\n+        );\n+    }\n+}\n+\n+/// 飞刃 notLink：黑桃火杀经铁索传导——主伤害 +1、传导伤害不加成\n+///（DamageData.from_chain 新字段）。\n+#[test]\n+fn yuanshi_feiren_chain_damage_not_bonused() {\n+    let root = repo_extensions_root();\n+    let discovered = discover_extensions(&root).expect(\"discover\");\n+    let dir = tempfile::tempdir().unwrap();\n+    let store = PackageStore::open(dir.path().join(\"store\")).unwrap();\n+    let _ = import_extensions(&store, &root, &options()).expect(\"import\");\n+    let disc = discovered\n+        .into_iter()\n+        .find(|d| d.name == \"shaai-ow-upstream-noname\")\n+        .expect(\"ow 可发现\");\n+    let json = std::fs::read_to_string(disc.root.join(\"assets/cards.json\")).unwrap();\n+    let pack = bridge(&json);\n+\n+    let mut e = Engine::new_with_extensions(9932, 5, &[&pack]).expect(\"建局\");\n+    advance_loop(&mut e, 0);\n+    for p in 0..5 {\n+        e.debug_clear_hand(p);\n+    }\n+    e.debug_grant(0, \"feiren\");\n+    // 铁索连环连接 1、2\n+    let chain = e.debug_place(0, \"chain\");\n+    let out = submit(\n+        &mut e,\n+        0,\n+        GameAction::PlayCard {\n+            card: chain,\n+            targets: vec![1, 2],\n+        },\n+    );\n+    assert!(\n+        matches!(\n+            out,\n+            CommandOutcome::Accepted { .. } | CommandOutcome::Pending { .. }\n+        ),\n+        \"{out:?}\"\n+    );\n+    while let Some(c) = e.open_choice() {\n+        let (cid, obs) = (c.id, c.observer);\n+        submit(\n+            &mut e,\n+            obs,\n+            GameAction::Answer {\n+                choice_id: cid,\n+                selection: vec![ChoiceOption::Pass],\n+            },\n+        );\n+    }\n+    // 黑桃火杀打 1：主伤害 1+1=2，传导给 2 为 1（不加成）\n+    let mut fire_spade = None;\n+    for _ in 0..8 {\n+        e.debug_place(0, \"fire_sha\");\n+        if let Some(c) = pick_suit(&e, engine_native::catalog::Suit::Spade) {\n+            // 排除普通杀误选（手牌里只有 fire_sha）\n+            fire_spade = Some(c);\n+            break;\n+        }\n+    }\n+    let fsha = fire_spade.expect(\"应有黑桃火杀\");\n+    e.debug_set_hp(1, 4);\n+    e.debug_set_hp(2, 4);\n+    let out = submit(\n+        &mut e,\n+        0,\n+        GameAction::PlayCard {\n+            card: fsha,\n+            targets: vec![1],\n+        },\n+    );\n+    assert!(\n+        matches!(\n+            out,\n+            CommandOutcome::Accepted { .. } | CommandOutcome::Pending { .. }\n+        ),\n+        \"{out:?}\"\n+    );\n+    while let Some(c) = e.open_choice() {\n+        let (cid, obs) = (c.id, c.observer);\n+        submit(\n+            &mut e,\n+            obs,\n+            GameAction::Answer {\n+                choice_id: cid,\n+                selection: vec![ChoiceOption::Pass],\n+            },\n+        );\n+    }\n+    assert_eq!(e.debug_hp(1), 2, \"主伤害 +1（4→2）\");\n+    assert_eq!(e.debug_hp(2), 3, \"传导伤害不加成（4→3）\");\n+}"},{"sha":"49b222e5de464bd708f81f8b7490b6b340901574","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20-v3/baseline-changed/crates/engine-native/tests/groups/nc_rounds.rs","status":"added","additions":113,"deletions":0,"changes":113,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native%2Ftests%2Fgroups%2Fnc_rounds.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native%2Ftests%2Fgroups%2Fnc_rounds.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native%2Ftests%2Fgroups%2Fnc_rounds.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1,113 @@\n+//! engine-native 集成测试分组 `nc_rounds`：NC 各轮（`nc<编号>_*`，NC08 除外）。\n+//! 登记规则与守卫见 `test_registry.rs`；本文件只登记模块，测试全名为 `<原文件名>::<函数名>`。\n+\n+#[path = \"../nc01_seat_semantics.rs\"]\n+mod nc01_seat_semantics;\n+\n+#[path = \"../nc03_ai_consistency.rs\"]\n+mod nc03_ai_consistency;\n+\n+#[path = \"../nc03_legal_actions.rs\"]\n+mod nc03_legal_actions;\n+\n+#[path = \"../nc04_cards_given_event.rs\"]\n+mod nc04_cards_given_event;\n+\n+#[path = \"../nc04_vm_fault.rs\"]\n+mod nc04_vm_fault;\n+\n+#[path = \"../nc04_vm_resume.rs\"]\n+mod nc04_vm_resume;\n+\n+#[path = \"../nc05_general_select.rs\"]\n+mod nc05_general_select;\n+\n+#[path = \"../nc06_generic_content_state.rs\"]\n+mod nc06_generic_content_state;\n+\n+#[path = \"../nc06_zhucheng_restore.rs\"]\n+mod nc06_zhucheng_restore;\n+\n+#[path = \"../nc07_archive_hash_fields.rs\"]\n+mod nc07_archive_hash_fields;\n+\n+#[path = \"../nc07_archive_hash_guard.rs\"]\n+mod nc07_archive_hash_guard;\n+\n+#[path = \"../nc07_discard_duplicate_probe.rs\"]\n+mod nc07_discard_duplicate_probe;\n+\n+#[path = \"../nc07_lianyaohu_hash.rs\"]\n+mod nc07_lianyaohu_hash;\n+\n+#[path = \"../nc07_state_same_source.rs\"]\n+mod nc07_state_same_source;\n+\n+#[path = \"../nc09_identity_end_to_end.rs\"]\n+mod nc09_identity_end_to_end;\n+\n+#[path = \"../nc09_projection_and_errors.rs\"]\n+mod nc09_projection_and_errors;\n+\n+#[path = \"../nc10_ai_boundary_and_cancel.rs\"]\n+mod nc10_ai_boundary_and_cancel;\n+\n+#[path = \"../nc10_ai_bounds.rs\"]\n+mod nc10_ai_bounds;\n+\n+#[path = \"../nc10_ai_information_boundary.rs\"]\n+mod nc10_ai_information_boundary;\n+\n+#[path = \"../nc10_duel_nullify_privacy.rs\"]\n+mod nc10_duel_nullify_privacy;\n+\n+#[path = \"../nc10_multiple_hidden_traps.rs\"]\n+mod nc10_multiple_hidden_traps;\n+\n+#[path = \"../nc10_pending_duel_privacy.rs\"]\n+mod nc10_pending_duel_privacy;\n+\n+#[path = \"../nc10_planner_pool.rs\"]\n+mod nc10_planner_pool;\n+\n+#[path = \"../nc10_single_hidden_trap.rs\"]\n+mod nc10_single_hidden_trap;\n+\n+#[path = \"../nc10_skill_pile_conservation.rs\"]\n+mod nc10_skill_pile_conservation;\n+\n+#[path = \"../nc12_ai_strength_baseline.rs\"]\n+mod nc12_ai_strength_baseline;\n+\n+#[path = \"../nc12_dangling_reference_probe.rs\"]\n+mod nc12_dangling_reference_probe;\n+\n+#[path = \"../nc12_dangling_reference_repro.rs\"]\n+mod nc12_dangling_reference_repro;\n+\n+#[path = \"../nc12_swd_authoritative_stability.rs\"]\n+mod nc12_swd_authoritative_stability;\n+\n+#[path = \"../nc10_live_hidden_cards.rs\"]\n+mod nc10_live_hidden_cards;\n+\n+#[path = \"../nc10_opaque_vm_privacy.rs\"]\n+mod nc10_opaque_vm_privacy;\n+\n+#[path = \"../nc10_redaction_helper_contract.rs\"]\n+mod nc10_redaction_helper_contract;\n+\n+#[path = \"../nc10_j2_vm_privacy.rs\"]\n+mod nc10_j2_vm_privacy;\n+\n+#[path = \"../nc10_source_provenance.rs\"]\n+mod nc10_source_provenance;\n+\n+#[path = \"../c331_source33_integration.rs\"]\n+mod c331_source33_integration;\n+\n+#[path = \"../c331_schema5_datachain.rs\"]\n+mod c331_schema5_datachain;\n+\n+#[path = \"../c331_canonical_damage.rs\"]\n+mod c331_canonical_damage;"},{"sha":"80393cd651e7203edc8f53f1173ad0d96d3f657c","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20-v3/baseline-changed/crates/engine-native/tests/native_kernel/boss_chujiangwang.rs","status":"added","additions":174,"deletions":0,"changes":174,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native%2Ftests%2Fnative_kernel%2Fboss_chujiangwang.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native%2Ftests%2Fnative_kernel%2Fboss_chujiangwang.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native%2Ftests%2Fnative_kernel%2Fboss_chujiangwang.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1,174 @@\n+use super::*;\n+\n+/// 帷幕：黑色顺手牵羊目标被拒、红色拆桥可指定；黑色南蛮 AOE 跳过持有\n+/// 者。\n+#[test]\n+fn boss_chujiangwang_weimu_black_trick_block() {\n+    let mut e = engine_native::Engine::new_boss_stage(87058, 4, 0, 3, 6, 4, 0);\n+    let cjw_def = chujiangwang_def_of(&e);\n+    e.debug_set_general_def(1, cjw_def);\n+    e.debug_set_hp(1, 4);\n+    assert_eq!(\n+        e.catalog().general_meta(cjw_def).map(|g| g.0),\n+        Some(\"楚江王\"),\n+        \"楚江王入目录\"\n+    );\n+    for sk in [\"帷幕\", \"反馈\", \"冰封\"] {\n+        let d = e\n+            .catalog()\n+            .skill_by_name(sk)\n+            .unwrap_or_else(|| panic!(\"{sk} 入目录\"));\n+        assert!(e.state_core().skills.contains_key(&(1, d)), \"{sk} 实例\");\n+    }\n+    advance_to_play(&mut e, 0);\n+    // 黑色顺手 → 拒\n+    let black_snatch = {\n+        let core = e.state_core();\n+        core.deck\n+            .iter()\n+            .copied()\n+            .find(|&c| {\n+                let d = &e.catalog().cards[c as usize];\n+                d.kind == CardKind::Snatch\n+                    && matches!(\n+                        d.suit,\n+                        engine_native::catalog::Suit::Spade | engine_native::catalog::Suit::Club\n+                    )\n+            })\n+            .expect(\"牌堆中无黑顺手\")\n+    };\n+    {\n+        let core = e.state_core_mut();\n+        core.deck.retain(|&x| x != black_snatch);\n+        core.player_mut(0).hand.push(black_snatch);\n+    }\n+    assert!(\n+        matches!(\n+            play(&mut e, black_snatch, vec![1]),\n+            CommandOutcome::Rejected(RejectReason::IllegalTargets)\n+        ),\n+        \"帷幕：黑色锦囊目标被拒\"\n+    );\n+    // 红色拆桥 → 可指定\n+    let red_dismantle = {\n+        let core = e.state_core();\n+        core.deck\n+            .iter()\n+            .copied()\n+            .find(|&c| {\n+                let d = &e.catalog().cards[c as usize];\n+                d.kind == CardKind::Dismantle\n+                    && matches!(\n+                        d.suit,\n+                        engine_native::catalog::Suit::Heart | engine_native::catalog::Suit::Diamond\n+                    )\n+            })\n+            .expect(\"牌堆中无红拆桥\")\n+    };\n+    {\n+        let core = e.state_core_mut();\n+        core.deck.retain(|&x| x != red_dismantle);\n+        core.player_mut(0).hand.push(red_dismantle);\n+    }\n+    let out = play(&mut e, red_dismantle, vec![1]);\n+    assert!(\n+        matches!(\n+            out,\n+            CommandOutcome::Accepted { .. } | CommandOutcome::Pending { .. }\n+        ),\n+        \"帷幕：红色锦囊可指定（{out:?}）\"\n+    );\n+    drain_choices(&mut e);\n+    // 黑色南蛮 AOE：1 号跳过，2/3 照常 Pass 受 1\n+    let (n1, n2, n3) = (hp(&e, 1), hp(&e, 2), hp(&e, 3));\n+    let savage = e.debug_place(0, \"savage\");\n+    assert!(matches!(\n+        play(&mut e, savage, vec![]),\n+        CommandOutcome::Pending { .. } | CommandOutcome::Accepted { .. }\n+    ));\n+    let mut asked: Vec<(u8, &'static str)> = Vec::new();\n+    for _ in 0..24 {\n+        match e.open_choice() {\n+            Some(c) => {\n+                asked.push((c.observer, c.spec.prompt));\n+                let (cid, obs) = (c.id, c.observer);\n+                submit_cmd(\n+                    &mut e,\n+                    obs,\n+                    GameAction::Answer {\n+                        choice_id: cid,\n+                        selection: vec![ChoiceOption::Pass],\n+                    },\n+                );\n+            }\n+            None => break,\n+        }\n+    }\n+    assert!(\n+        !asked.iter().any(|&(o, p)| o == 1 && p == \"aoe_response\"),\n+        \"帷幕：1 号不被黑色南蛮询问（{asked:?}）\"\n+    );\n+    assert_eq!(hp(&e, 1), n1, \"帷幕：1 号不受黑色南蛮伤害\");\n+    assert_eq!(hp(&e, 2), n2 - 1, \"南蛮：2 号 Pass 受 1\");\n+    assert_eq!(hp(&e, 3), n3 - 1, \"南蛮：3 号 Pass 受 1\");\n+}\n+\n+/// 反馈（标准 FAN_KUI 复用=界反馈语义）：受伤后获得来源首张手牌。\n+#[test]\n+fn boss_chujiangwang_fankui_reuse_gain() {\n+    let mut e = engine_native::Engine::new_boss_stage(87059, 4, 0, 0, 6, 4, 0);\n+    let cjw_def = chujiangwang_def_of(&e);\n+    e.debug_set_general_def(1, cjw_def);\n+    e.debug_set_hp(1, 4);\n+    advance_to_play(&mut e, 0);\n+    let n0 = hp(&e, 0);\n+    let out = e.debug_deal_damage(Some(0), 1, 1, DamageNature::Normal);\n+    let _ = out;\n+    assert_eq!(hp(&e, 1), 3);\n+    // 可选触发确认 → 获得来源首张手牌\n+    assert_eq!(prompt_of(&e), \"trigger_confirm\");\n+    assert!(matches!(answer(&mut e, ChoiceOption::Confirm), _));\n+    drain_choices(&mut e);\n+    assert_eq!(hp(&e, 0), n0, \"反馈：来源不失血\");\n+    assert!(\n+        count_log(&e, |l| matches!(\n+            l,\n+            LogEvent::CardsGiven { from: 0, to: 1, .. }\n+        )) >= 1,\n+        \"反馈：获得日志\"\n+    );\n+}\n+\n+/// 冰封：楚江王被翻面状态来源击杀 → 来源被翻面；已翻面来源不重复翻。\n+#[test]\n+fn boss_chujiangwang_bingfeng_death_flip_source() {\n+    let mut e = engine_native::Engine::new_boss_stage(87060, 4, 0, 0, 6, 4, 0);\n+    let cjw_def = chujiangwang_def_of(&e);\n+    e.debug_set_general_def(1, cjw_def);\n+    e.debug_set_hp(1, 4);\n+    advance_to_play(&mut e, 0);\n+    let out = e.debug_deal_damage(Some(0), 1, 10, DamageNature::Normal);\n+    let _ = out;\n+    for _ in 0..3 {\n+        match e.open_choice() {\n+            Some(c) if c.spec.prompt == \"dying_save\" => {\n+                let (cid, obs) = (c.id, c.observer);\n+                submit_cmd(\n+                    &mut e,\n+                    obs,\n+                    GameAction::Answer {\n+                        choice_id: cid,\n+                        selection: vec![ChoiceOption::Pass],\n+                    },\n+                );\n+            }\n+            _ => break,\n+        }\n+    }\n+    assert!(!e.state_core().player(1).alive, \"楚江王已死亡\");\n+    assert!(e.debug_face_down(0), \"冰封：来源 0 号被翻面\");\n+    let snap = e.save();\n+    let r = engine_native::Engine::restore(&snap).expect(\"往返\");\n+    assert_zone_conservation(&r);\n+    assert!(r.debug_face_down(0), \"往返保留翻面\");\n+}"},{"sha":"e57a0295752fdea3d1e8b7ea15c6577337564e79","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20-v3/baseline-changed/crates/engine-native/tests/native_kernel/boss_xuanwu.rs","status":"added","additions":62,"deletions":0,"changes":62,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native%2Ftests%2Fnative_kernel%2Fboss_xuanwu.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native%2Ftests%2Fnative_kernel%2Fboss_xuanwu.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native%2Ftests%2Fnative_kernel%2Fboss_xuanwu.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1,62 @@\n+use super::*;\n+\n+/// 四象系玄武首片（规则 v237/存档 v54）：灵渠——①受伤>1 点归零（终值\n+/// 口径：1+凶兽=2 亦归零）；②每次受伤摸 1+受击计数（0 点伤害照常）；\n+/// ③手牌上限+计数。玄武条目（群目录近似/hp4/[神裔,灵渠]；boss_xuanlin2\n+/// 玄麟=关卡流程面登记不落内核）。\n+#[test]\n+fn boss_xuanwu_lingqu_damage_counter() {\n+    let mut e = Engine::new_boss_stage(57001, 4, 1, 3, 6, 4, 0);\n+    let xuanwu_def = (e.catalog().general_count()\n+        - engine_native::content::standard::BOSS_GENERALS.len()\n+        + 13) as u16; // BOSS_GENERALS[13] 玄武\n+    e.debug_set_general_def(1, xuanwu_def);\n+    e.debug_set_hp(1, 4);\n+    assert_eq!(\n+        e.catalog().general_meta(xuanwu_def).map(|g| g.0),\n+        Some(\"玄武\"),\n+        \"玄武入目录\"\n+    );\n+    let ldef = e.catalog().skill_by_name(\"灵渠\").expect(\"灵渠入目录\");\n+    let sdef = e.catalog().skill_by_name(\"神裔\").expect(\"神裔入目录\");\n+    assert!(e.state_core().skills.contains_key(&(1, ldef)));\n+    assert!(e.state_core().skills.contains_key(&(1, sdef)), \"神裔共用\");\n+\n+    // ① 大于 1 点伤害归零：3 点直伤 → hp 不变；摸 1+计数 1（0 点照常）\n+    e.debug_clear_hand(1);\n+    let h1 = e.debug_hand(1).len();\n+    e.debug_deal_damage(Some(0), 1, 3, DamageNature::Normal);\n+    drain_choices(&mut e);\n+    assert_eq!(e.debug_hp(1), 4, \"灵渠：3 点伤害归零\");\n+    assert_eq!(e.state_core().player(1).lingqu_count, 1, \"0 点伤害仍计数\");\n+    assert_eq!(e.debug_hand(1).len(), h1 + 1, \"0 点伤害仍摸 1\");\n+\n+    // ② 1 点伤害照常：hp-1、再摸 1、计数 2\n+    e.debug_deal_damage(Some(0), 1, 1, DamageNature::Normal);\n+    drain_choices(&mut e);\n+    assert_eq!(e.debug_hp(1), 3, \"1 点伤害照常结算\");\n+    assert_eq!(e.state_core().player(1).lingqu_count, 2);\n+    assert_eq!(e.debug_hand(1).len(), h1 + 2);\n+\n+    // ③ 增幅终值口径：1 点基础+赤龙牙类增幅终值>1 → 归零（借火杀+焚天\n+    //    不可得，直接 2 点直伤验证终值门槛）\n+    e.debug_deal_damage(Some(0), 1, 2, DamageNature::Normal);\n+    drain_choices(&mut e);\n+    assert_eq!(e.debug_hp(1), 3, \"2 点伤害归零\");\n+    assert_eq!(e.state_core().player(1).lingqu_count, 3);\n+\n+    // ④ 手牌上限+计数：hp3 基数 3 + 计数 3 = 6\n+    let lim = e.state_core().hand_limit(e.catalog(), 1);\n+    assert_eq!(lim, 6, \"手牌上限 = hp 3 + 灵渠计数 3\");\n+\n+    // ⑤ 存档 v54 往返：计数跨存档\n+    let snap = e.save();\n+    let r = Engine::restore(&snap).expect(\"往返\");\n+    assert_eq!(r.state_core().player(1).lingqu_count, 3, \"灵渠计数入存档\");\n+    assert!(\n+        r.state_core().skills.contains_key(&(1, ldef)),\n+        \"灵渠实例往返\"\n+    );\n+    assert_zone_conservation(&r);\n+    assert_zone_conservation(&e);\n+}"},{"sha":"ac43f659455fc8cb2ea615ac8ba6e34ec464c9ee","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20-v3/baseline-changed/crates/engine-native/tests/native_kernel/combat.rs","status":"added","additions":239,"deletions":0,"changes":239,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native%2Ftests%2Fnative_kernel%2Fcombat.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native%2Ftests%2Fnative_kernel%2Fcombat.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native%2Ftests%2Fnative_kernel%2Fcombat.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1,239 @@\n+use super::*;\n+\n+/// 杀的完整链路：闪响应免伤、放弃则扣血；出牌阶段限一次杀；距离限制。\n+#[test]\n+fn sha_dodge_damage_limit_and_range() {\n+    // 场景一：目标出闪\n+    let mut e = Engine::new(11, 4);\n+    advance_to_play(&mut e, 0);\n+    e.debug_clear_hand(0);\n+    let sha = e.debug_place(0, \"sha\");\n+    e.debug_clear_hand(1); // 目标在自己回合摸的牌清掉，只留闪\n+    let shan = e.debug_place(1, \"shan\");\n+    assert!(matches!(\n+        play(&mut e, sha, vec![1]),\n+        CommandOutcome::Pending { .. }\n+    ));\n+    assert_eq!(prompt_of(&e), \"respond_shan\");\n+    assert!(matches!(\n+        answer(&mut e, ChoiceOption::Card(shan)),\n+        CommandOutcome::Accepted { .. }\n+    ));\n+    assert_eq!(hp(&e, 1), 4);\n+\n+    // 场景二：目标无闪直接扣血；同阶段第二张杀被拒（限一次）\n+    let mut e = Engine::new(11, 4);\n+    let sha1 = e.debug_place(0, \"sha\");\n+    let _sha2 = e.debug_place(0, \"sha\");\n+    advance_to_play(&mut e, 0);\n+    e.debug_clear_hand(1); // 推进后清空，避免摸牌干扰\n+    assert!(matches!(\n+        play(&mut e, sha1, vec![1]),\n+        CommandOutcome::Accepted { .. }\n+    ));\n+    assert_eq!(hp(&e, 1), 3);\n+    let sha2 = e\n+        .debug_hand(0)\n+        .iter()\n+        .copied()\n+        .find(|c| e.catalog().card_kind(*c) == engine_native::catalog::CardKind::Sha)\n+        .expect(\"仍持有一张杀\");\n+    match play(&mut e, sha2, vec![1]) {\n+        CommandOutcome::Rejected(RejectReason::ShaLimit) => {}\n+        other => panic!(\"expected ShaLimit, got {other:?}\"),\n+    }\n+\n+    // 场景三：距离 2 的目标不合法（4 人座，0 -> 2）\n+    let mut e = Engine::new(11, 4);\n+    e.debug_clear_hand(0);\n+    let sha = e.debug_place(0, \"sha\");\n+    advance_to_play(&mut e, 0);\n+    match play(&mut e, sha, vec![2]) {\n+        CommandOutcome::Rejected(RejectReason::IllegalTargets) => {}\n+        other => panic!(\"expected IllegalTargets, got {other:?}\"),\n+    }\n+}\n+\n+/// 火杀经铁索传导：同属性同点数、传导后全员解链。\n+#[test]\n+fn fire_sha_propagates_through_chain() {\n+    let mut e = Engine::new(113, 4);\n+    advance_to_play(&mut e, 0);\n+    for p in 0..4 {\n+        e.debug_clear_hand(p);\n+    }\n+    let chain = e.debug_place(0, \"chain\");\n+    play(&mut e, chain, vec![1, 2]);\n+    // 火杀打 1（1 无闪）\n+    let fsha = e.debug_place(0, \"fire_sha\");\n+    assert!(matches!(\n+        play(&mut e, fsha, vec![1]),\n+        CommandOutcome::Accepted { .. }\n+    ));\n+    // 目标 1 与传导目标 2 各 -1；3 号（未链）不受影响\n+    assert_eq!(hp(&e, 1), 3);\n+    assert_eq!(hp(&e, 2), 3);\n+    assert_eq!(hp(&e, 3), 4);\n+    // 全员解链\n+    assert!(!e.debug_linked(1) && !e.debug_linked(2));\n+    // 两段同属性伤害都在日志\n+    assert_eq!(\n+        count_log(&e, |l| matches!(\n+            l,\n+            LE::DamageDealt { target: 1, .. } | LE::DamageDealt { target: 2, .. }\n+        )),\n+        2\n+    );\n+}\n+\n+/// 普通伤害不传导、不解链。\n+#[test]\n+fn normal_damage_does_not_propagate() {\n+    let mut e = Engine::new(115, 4);\n+    advance_to_play(&mut e, 0);\n+    for p in 0..4 {\n+        e.debug_clear_hand(p);\n+    }\n+    let chain = e.debug_place(0, \"chain\");\n+    play(&mut e, chain, vec![1, 2]);\n+    let sha = e.debug_place(0, \"sha\");\n+    assert!(matches!(\n+        play(&mut e, sha, vec![1]),\n+        CommandOutcome::Accepted { .. }\n+    ));\n+    assert_eq!(hp(&e, 1), 3);\n+    assert_eq!(hp(&e, 2), 4, \"普通伤害不传导\");\n+    assert!(e.debug_linked(1) && e.debug_linked(2), \"普通伤害不解链\");\n+}\n+\n+/// 雷属性伤害传导（debug 入口 = 后续技能造成属性伤害的内核路径）。\n+#[test]\n+fn thunder_damage_propagates_and_unlinks_all() {\n+    let mut e = Engine::new(117, 4);\n+    advance_to_play(&mut e, 0);\n+    for p in 0..4 {\n+        e.debug_clear_hand(p);\n+    }\n+    let chain1 = e.debug_place(0, \"chain\");\n+    play(&mut e, chain1, vec![0, 1]);\n+    let chain2 = e.debug_place(0, \"chain\");\n+    play(&mut e, chain2, vec![2]);\n+    // 三人被链\n+    assert!(e.debug_linked(0) && e.debug_linked(1) && e.debug_linked(2));\n+    // 雷伤打 0：传导给 1、2（座位顺序），全员解链\n+    assert!(matches!(\n+        e.debug_deal_damage(None, 0, 1, DamageNature::Thunder),\n+        CommandOutcome::Accepted { .. }\n+    ));\n+    assert_eq!(hp(&e, 0), 3);\n+    assert_eq!(hp(&e, 1), 3);\n+    assert_eq!(hp(&e, 2), 3);\n+    assert!(!e.debug_linked(0) && !e.debug_linked(1) && !e.debug_linked(2));\n+    // 已解链后再打 → 无传导\n+    assert!(matches!(\n+        e.debug_deal_damage(None, 1, 1, DamageNature::Thunder),\n+        CommandOutcome::Accepted { .. }\n+    ));\n+    assert_eq!(hp(&e, 1), 2);\n+    assert_eq!(hp(&e, 0), 3);\n+    assert_eq!(hp(&e, 2), 3);\n+}\n+\n+/// 传导伤害是完全的伤害结算：可被移伤转移（火杀传导 → 移伤改写目标）。\n+#[test]\n+fn propagated_damage_is_full_resolution() {\n+    let mut e = Engine::new(119, 4);\n+    e.debug_grant(1, \"移伤\");\n+    advance_to_play(&mut e, 0);\n+    e.debug_clear_hand(0);\n+    e.debug_clear_hand(1);\n+    e.debug_clear_hand(2);\n+    let chain = e.debug_place(0, \"chain\");\n+    play(&mut e, chain, vec![1, 2]);\n+    // 牌堆构成变更（v62）后发牌位移：3 号起手可能摸到无懈——链子的\n+    // 无懈窗口会挂起（火杀提交将因此被拒），先排空（放弃）。\n+    for _ in 0..8 {\n+        match e.open_choice() {\n+            Some(c) if c.spec.prompt == \"nullify_window\" => {\n+                let (id2, obs2) = (c.id, c.observer);\n+                submit_cmd(\n+                    &mut e,\n+                    obs2,\n+                    GameAction::Answer {\n+                        choice_id: id2,\n+                        selection: vec![ChoiceOption::Pass],\n+                    },\n+                );\n+            }\n+            _ => break,\n+        }\n+    }\n+    let fsha = e.debug_place(0, \"fire_sha\");\n+    play(&mut e, fsha, vec![1]);\n+    // 火杀的无懈窗口同理排空（放弃），随后等移伤确认。\n+    for _ in 0..8 {\n+        match e.open_choice() {\n+            Some(c) if c.spec.prompt == \"nullify_window\" => {\n+                let (id2, obs2) = (c.id, c.observer);\n+                submit_cmd(\n+                    &mut e,\n+                    obs2,\n+                    GameAction::Answer {\n+                        choice_id: id2,\n+                        selection: vec![ChoiceOption::Pass],\n+                    },\n+                );\n+            }\n+            _ => break,\n+        }\n+    }\n+    // 火杀先在 1 处结算 → 移伤确认 → 转移给 3\n+    assert_eq!(prompt_of(&e), \"trigger_confirm\");\n+    answer(&mut e, ChoiceOption::Confirm);\n+    assert_eq!(prompt_of(&e), \"yishang_target\");\n+    answer(&mut e, ChoiceOption::Player(3));\n+    // 转移后的 1 不掉血；传导以 3 为中心 → 2（仍链）掉血\n+    assert_eq!(hp(&e, 1), 4);\n+    assert_eq!(hp(&e, 3), 3);\n+    assert_eq!(hp(&e, 2), 3);\n+}\n+\n+/// 火杀与普通杀共享出牌阶段限一次。\n+#[test]\n+fn fire_sha_shares_sha_limit() {\n+    let mut e = Engine::new(121, 4);\n+    advance_to_play(&mut e, 0);\n+    e.debug_clear_hand(0);\n+    e.debug_clear_hand(1);\n+    let fsha = e.debug_place(0, \"fire_sha\");\n+    assert!(matches!(\n+        play(&mut e, fsha, vec![1]),\n+        CommandOutcome::Accepted { .. }\n+    ));\n+    assert_eq!(hp(&e, 1), 3);\n+    let sha = e.debug_place(0, \"sha\");\n+    match play(&mut e, sha, vec![1]) {\n+        CommandOutcome::Rejected(RejectReason::ShaLimit) => {}\n+        other => panic!(\"{other:?}\"),\n+    }\n+    assert_eq!(e.catalog().card_kind(0), CardKind::Sha);\n+}\n+\n+// ---------------------------------------------------------------------------\n+// N08 前置：DamageData 携牌信息（ADR 0737）\n+// ---------------------------------------------------------------------------\n+\n+/// 杀造成的伤害携带牌信息：DamageDealt 日志的 card = 该杀。\n+#[test]\n+fn sha_damage_dealt_carries_card() {\n+    let mut e = Engine::new(451, 4);\n+    advance_to_play(&mut e, 0);\n+    for p in 0..4 {\n+        e.debug_clear_hand(p);\n+    }\n+    let sha = e.debug_place(0, \"sha\");\n+    play(&mut e, sha, vec![1]); // 1 无闪 → 伤害结算\n+    assert!(log_has(&e, |l| matches!(l,\n+        LE::DamageDealt { target: 1, amount: 1, card: Some(c), .. } if *c == sha)));\n+    assert_eq!(hp(&e, 1), 3);\n+}"},{"sha":"e3430245cd88595046e15f571ac259bf80663fe8","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20-v3/baseline-changed/crates/engine-native/tests/native_kernel/dying.rs","status":"added","additions":104,"deletions":0,"changes":104,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native%2Ftests%2Fnative_kernel%2Fdying.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native%2Ftests%2Fnative_kernel%2Fdying.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fbaseline-changed%2Fcrates%2Fengine-native%2Ftests%2Fnative_kernel%2Fdying.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1,104 @@\n+use super::*;\n+\n+// ---------------------------------------------------------------------------\n+// 濒死救援：座位顺序持桃询问 / 自救 / 无人救则死亡\n+// ---------------------------------------------------------------------------\n+\n+#[test]\n+fn dying_rescue_and_death() {\n+    // 自救：1/2/3 无桃自动跳过，0 用桃自救\n+    let mut e = Engine::new(41, 4);\n+    e.debug_set_hp(0, 1);\n+    advance_to_play(&mut e, 1);\n+    e.debug_clear_hand(0);\n+    let tao = e.debug_place(0, \"tao\");\n+    e.debug_clear_hand(1);\n+    let sha = e.debug_place(1, \"sha\");\n+    for p in 2..4 {\n+        e.debug_clear_hand(p);\n+    }\n+    play(&mut e, sha, vec![0]);\n+    assert_eq!(prompt_of(&e), \"dying_save\");\n+    let out = answer(&mut e, ChoiceOption::Card(tao));\n+    assert!(matches!(out, CommandOutcome::Accepted { .. }), \"{out:?}\");\n+    assert_eq!(hp(&e, 0), 1);\n+    assert!(e.debug_alive(0));\n+    assert!(log_has(&e, |l| matches!(\n+        l,\n+        LogEvent::DyingSaved { player: 0, .. }\n+    )));\n+\n+    // 他人救援：1 持桃先放弃，2 无桃跳过，3 用桃救\n+    let mut e = Engine::new(43, 4);\n+    e.debug_set_hp(0, 1);\n+    advance_to_play(&mut e, 1);\n+    for p in 0..4 {\n+        e.debug_clear_hand(p);\n+    }\n+    let sha = e.debug_place(1, \"sha\");\n+    e.debug_place(1, \"tao\");\n+    let tao3 = e.debug_place(3, \"tao\");\n+    play(&mut e, sha, vec![0]);\n+    assert_eq!(prompt_of(&e), \"dying_save\");\n+    // 1 放弃后立即轮到下一位持桃者：仍处挂起（Pending）\n+    let out = answer(&mut e, ChoiceOption::Pass);\n+    assert!(\n+        matches!(out, CommandOutcome::Pending { .. }),\n+        \"pass should chain to next responder: {out:?}\"\n+    );\n+    // 2 无桃 → 自动跳过；3 有桃 → 被询问\n+    assert_eq!(prompt_of(&e), \"dying_save\");\n+    let out = answer(&mut e, ChoiceOption::Card(tao3));\n+    assert!(matches!(out, CommandOutcome::Accepted { .. }), \"{out:?}\");\n+    assert!(e.debug_alive(0));\n+\n+    // 无人救 → 死亡：手牌进弃牌堆、技能移除、存活数下降\n+    let mut e = Engine::new(45, 4);\n+    e.debug_set_hp(0, 1);\n+    e.debug_grant(0, \"散财\"); // 死亡时应被移除（防止型技能会干扰致死，故选被动型）\n+    advance_to_play(&mut e, 1);\n+    for p in 0..4 {\n+        e.debug_clear_hand(p);\n+    }\n+    let sha = e.debug_place(1, \"sha\");\n+    let discard_before = e.debug_discard_len();\n+    let dead_hand = e.debug_hand(0).len();\n+    play(&mut e, sha, vec![0]);\n+    // 无人持桃：全部跳过询问，直接死亡\n+    assert!(!e.debug_alive(0));\n+    assert!(!e.debug_has_skill(0, \"散财\"));\n+    assert_eq!(\n+        e.debug_discard_len(),\n+        discard_before + dead_hand + 1,\n+        \"致死的杀应随结算入弃牌堆（手牌已清空）\"\n+    );\n+    assert!(log_has(&e, |l| matches!(\n+        l,\n+        LogEvent::PlayerDied { player: 0, .. }\n+    )));\n+    // 场上仍 3 人，未终局\n+    assert!(e.outcome().is_none());\n+}\n+\n+/// 濒死酒选项的恢复派生：手牌只有酒时挂起濒死询问，字节往返后仍\n+/// 推导出相同选项（含酒）。\n+#[test]\n+fn dying_save_with_jiu_derivation_restores() {\n+    use engine_native::archive::{decode_archive, encode_archive};\n+    let mut e = Engine::new(3004, 3);\n+    advance_to_play(&mut e, 0);\n+    for p in 0..3 {\n+        e.debug_clear_hand(p);\n+    }\n+    e.debug_set_hp(1, 1);\n+    let jiu = e.debug_place(1, \"jiu\");\n+    let sha = e.debug_place(0, \"sha\");\n+    play(&mut e, sha, vec![1]);\n+    let bytes = encode_archive(&e.save());\n+    let restored = Engine::restore(&decode_archive(&bytes).expect(\"decode\")).expect(\"恢复\");\n+    let c = restored.open_choice().expect(\"恢复件仍挂起濒死询问\");\n+    assert!(\n+        c.spec.options.contains(&ChoiceOption::Card(jiu)),\n+        \"恢复派生应含酒\"\n+    );\n+}"},{"sha":"02028df820ba56a445fff64634a19f43fa62b872","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20-v3/changed-source.tar.gz","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fchanged-source.tar.gz","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fchanged-source.tar.gz","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fchanged-source.tar.gz?ref=34e83f0550bb70ef4af6083697428de7be2f02f8"},{"sha":"6a0b6c89a7a57058d176cb153501c7ca8c4a9e8a","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20-v3/source-manifest.json","status":"added","additions":145,"deletions":0,"changes":145,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fsource-manifest.json","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fsource-manifest.json","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fsource-manifest.json?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1,145 @@\n+{\n+  \"utc\": \"2026-10-31T12:38:31.226406+00:00\",\n+  \"base_c8_repair_manifest_sha256\": \"b1571db999a8795e4ff4687eb2b14a10a2772c4ba8b85dd974a89e3f459c4c4f\",\n+  \"files\": [\n+    {\n+      \"path\": \"crates/engine-native-content/src/content/standard/boss_skills.rs\",\n+      \"baseline_c9_sha256\": \"feb5ddf4fc17dc6929c8729c8a890274c8901ab8076576e011ddae436823bbc5\",\n+      \"sha256\": \"9021ad8d3205e5263dd4dd738ee3590f7901ede02f807df646464ae4285cac9e\"\n+    },\n+    {\n+      \"path\": \"crates/engine-native-kernel/src/archive/damage.rs\",\n+      \"baseline_c9_sha256\": \"1d78d6723896261829733046a8ce0d3df34813e57db6407865d72221bafd27ba\",\n+      \"sha256\": \"fda5378dbbc959c0ab9cdf45d2379f8bebfe210924e26a7935a5589b65614187\"\n+    },\n+    {\n+      \"path\": \"crates/engine-native-kernel/src/archive/values.rs\",\n+      \"baseline_c9_sha256\": \"610f40aa4d18171735b42dab1f2db0da731729eb84f131b0fd59edb3696bf017\",\n+      \"sha256\": \"1bc6664505aebb591195f66b49a34018119279be8d6506ea36a8d6ba532871be\"\n+    },\n+    {\n+      \"path\": \"crates/engine-native-kernel/src/event.rs\",\n+      \"baseline_c9_sha256\": \"2f8bbd559fa050dd11b8c76da3a448be47acc3d327598208bfcf4d71d216e48d\",\n+      \"sha256\": \"f60e4dc4ddb2217614cf3b4327b349fd41466d808b6b9676247f3182e7e86850\"\n+    },\n+    {\n+      \"path\": \"crates/engine-native-kernel/src/event/damage.rs\",\n+      \"baseline_c9_sha256\": \"074f47152ca0cc9ba60d5fa1e46846d2c66069163347883be9b04fb1b3905e61\",\n+      \"sha256\": \"c7937cef28feb13886790f91e582745ce0995deb182660e9e22fd6fa47d68150\"\n+    },\n+    {\n+      \"path\": \"crates/engine-native-kernel/src/kernel.rs\",\n+      \"baseline_c9_sha256\": \"46a46af5516fc0dd02f26efd7810bb592aeb76375badf38bb2f643b607420c67\",\n+      \"sha256\": \"1207a3fd5eb09120077dce6fb5cec19ca948a4f6e462363529d98ecd9ea823c2\"\n+    },\n+    {\n+      \"path\": \"crates/engine-native-kernel/src/kernel/damage.rs\",\n+      \"baseline_c9_sha256\": \"271052b3f5a677c2add3b83bf5c2ac477e2e5a3789f647ffae7876b9104e2084\",\n+      \"sha256\": \"083faf2f1faadb432442e4b35760db3bcd9eda09cf21e45aa3b035219e69f936\"\n+    },\n+    {\n+      \"path\": \"crates/engine-native-kernel/src/kernel/damage_after.rs\",\n+      \"baseline_c9_sha256\": null,\n+      \"sha256\": \"829eb15c660c3e87716ccf79ab240ac1fb53281c26e5b48ac597c7a22be996c9\"\n+    },\n+    {\n+      \"path\": \"crates/engine-native-kernel/src/kernel/damage_change_hp.rs\",\n+      \"baseline_c9_sha256\": null,\n+      \"sha256\": \"be74e1708d5c52831a2915bd648e0ae2148e84d4f4372b1b1fa902a006ab2d25\"\n+    },\n+    {\n+      \"path\": \"crates/engine-native-kernel/src/kernel/damage_flow.rs\",\n+      \"baseline_c9_sha256\": \"9da3ebff258fe4f58f04af5c03fc31e156e013fddd0de3d905f90d13b575f7f3\",\n+      \"sha256\": \"dc4c5b9fe19d25e2a2473d5f2fb9a32bde1d795ce8902616cc50621cbb364ac4\"\n+    },\n+    {\n+      \"path\": \"crates/engine-native-kernel/src/kernel/damage_windows.rs\",\n+      \"baseline_c9_sha256\": null,\n+      \"sha256\": \"ae1d4a1a788332b51e7a82c8999fcbf4e401629e513d86211e77328b8bd0d215\"\n+    },\n+    {\n+      \"path\": \"crates/engine-native-kernel/src/machine.rs\",\n+      \"baseline_c9_sha256\": \"274766c04474a5c0e60105f14062fa45977512efe8ebe19a9e4f8142517a25b3\",\n+      \"sha256\": \"a361bff4bf04a868b0bc501b482587f0c7de62144fdb330985d3bb8dbc41819f\"\n+    },\n+    {\n+      \"path\": \"crates/engine-native-kernel/src/resolution.rs\",\n+      \"baseline_c9_sha256\": \"bea744ef2730605080f2aac9e22917a637b5543d09ebbfd66c390227da04a338\",\n+      \"sha256\": \"436b2d71c1303fdf72066749009266e45f6cf7bfc898f0e349d207f62c0fc55c\"\n+    },\n+    {\n+      \"path\": \"crates/engine-native-kernel/src/resolution/trigger_order.rs\",\n+      \"baseline_c9_sha256\": \"985ccdbf50639ea7e1d9fc5e7166493849d213ede5a766424652fdaac30b0472\",\n+      \"sha256\": \"89e5c36601a26ba11a58705f61aa4abbfc2f31614278d3b8dbb966b2401588f9\"\n+    },\n+    {\n+      \"path\": \"crates/engine-native-kernel/src/snap.rs\",\n+      \"baseline_c9_sha256\": \"debf1b270261d93fed7b4bba5c171e1d13eeecdc72f7d5c239bf903c42692f09\",\n+      \"sha256\": \"68cf46d79d1073f03d2fa2f5c423ad128dd7a920a946ce3bed5880e123a52686\"\n+    },\n+    {\n+      \"path\": \"crates/engine-native-kernel/src/snap/damage_validation.rs\",\n+      \"baseline_c9_sha256\": null,\n+      \"sha256\": \"96a326f0f71343295099a525e934459f52522d1e1652ed6c6d01fd452b8ec2f8\"\n+    },\n+    {\n+      \"path\": \"crates/engine-native-kernel/src/snap/validation.rs\",\n+      \"baseline_c9_sha256\": \"7eb708608a2be1402b0f891e41941308ac179565a6133b0dd2f9dc782aee69df\",\n+      \"sha256\": \"5ecc569749027e3b05961f5064a6a8d159d0e481f1a2104afa9548750632b328\"\n+    },\n+    {\n+      \"path\": \"crates/engine-native/tests/a0_tag_registry.rs\",\n+      \"baseline_c9_sha256\": \"9a467133df58a5d01619475e8f5b20c0f8406203fd83fe040d9c729000b6783c\",\n+      \"sha256\": \"72be2c1c38c9d681b569f1787f25d5d688c8c7e601a98b878a3779267fdb85f5\"\n+    },\n+    {\n+      \"path\": \"crates/engine-native/tests/c331_canonical_damage.rs\",\n+      \"baseline_c9_sha256\": \"5fcfc643d90a23850e129a105d8e1e6e8214cb57fd3917c0d295e51fd114a21e\",\n+      \"sha256\": \"f70b77c50330e11cfc19efc41c9456f7a9604d94f49375a879d631fc218791aa\"\n+    },\n+    {\n+      \"path\": \"crates/engine-native/tests/c331_prehp_damage.rs\",\n+      \"baseline_c9_sha256\": null,\n+      \"sha256\": \"f48f7605aff2161d2388e0425408eb17e051bc2254a35eb7945f5df2025c3537\"\n+    },\n+    {\n+      \"path\": \"crates/engine-native/tests/g1_shahai_swd/xielv.rs\",\n+      \"baseline_c9_sha256\": \"fb132c61711f2d693fc9c6c6544ffd5c89eadad45a442f89e42a107d02094166\",\n+      \"sha256\": \"6ce314b7934ec30a282b50309de6cfb7b40493754aee64e6d40509e20079de2e\"\n+    },\n+    {\n+      \"path\": \"crates/engine-native/tests/g1_wudian/yuanshi.rs\",\n+      \"baseline_c9_sha256\": \"7a4c9bea4aaebba655c3d865da0bfac914643cdd5f6fca58cd4f51929d1f8202\",\n+      \"sha256\": \"a45a83ad7d2f642dee787c5fc7bf16315992f3197de8154ff2e29e7b33bbd132\"\n+    },\n+    {\n+      \"path\": \"crates/engine-native/tests/groups/nc_rounds.rs\",\n+      \"baseline_c9_sha256\": \"253f674ff1b1e24dc7efbc569abbbd5404371562bd3a10a129536a5405b585ce\",\n+      \"sha256\": \"df2db332f6be7b0848189f981d93203aa9ee56e8e2a929bbd650549905690c6a\"\n+    },\n+    {\n+      \"path\": \"crates/engine-native/tests/native_kernel/boss_chujiangwang.rs\",\n+      \"baseline_c9_sha256\": \"7fdc5339077a0101bb94b2dc845393143c66873e786f45547761a68a87e30753\",\n+      \"sha256\": \"5a4c687dbad8effd38452339ee35fffb0d739417ff48cf6feb1b0cdd66dcc6b0\"\n+    },\n+    {\n+      \"path\": \"crates/engine-native/tests/native_kernel/boss_xuanwu.rs\",\n+      \"baseline_c9_sha256\": \"e1d71ba10aab7738e739fa45f9fdaf8b656721d2707033975ca2fe6e5f9dcfe2\",\n+      \"sha256\": \"462a1fca809813fd6adf29cd99bdbad627fb6cb6ee73b9f437ace78d10c0e781\"\n+    },\n+    {\n+      \"path\": \"crates/engine-native/tests/native_kernel/combat.rs\",\n+      \"baseline_c9_sha256\": \"e35fd32c865e7e75470bbd67ff2fac7603a8c1121b6629d7541bc383ed0655af\",\n+      \"sha256\": \"0f3360fafa484a8179d3ebb7ab7258dfe72c84f77aa3f7397518b52e0413a450\"\n+    },\n+    {\n+      \"path\": \"crates/engine-native/tests/native_kernel/dying.rs\",\n+      \"baseline_c9_sha256\": \"14b6c0ebb2588680a06cab7a73cf61bd0ff1f5e958b41f2ec43337e9e8451bb0\",\n+      \"sha256\": \"e8b33fd64f8de7ab239db6fbcc78c40c3f05c850f01c2b9790882158d4c27763\"\n+    }\n+  ],\n+  \"scope\": \"C9b preHP driver checkpoint; validation results and remaining source branches reported separately\",\n+  \"whole_c331\": \"BLOCK\",\n+  \"source_proof\": \"262/290,remaining28,+0\",\n+  \"no_staged_files\": true\n+}"},{"sha":"fffc9f822d12d199de88bbc7ee284a7712e620a5","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20-v3/vs-c9.patch","status":"added","additions":2602,"deletions":0,"changes":2602,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fvs-c9.patch","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fvs-c9.patch","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20-v3%2Fvs-c9.patch?ref=34e83f0550bb70ef4af6083697428de7be2f02f8"},{"sha":"3825e0ead69750b405be9891a2572e34b9debe2a","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20/baseline-changed/crates/engine-native-content/src/content/standard/boss_skills.rs","status":"added","additions":1128,"deletions":0,"changes":1128,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20%2Fbaseline-changed%2Fcrates%2Fengine-native-content%2Fsrc%2Fcontent%2Fstandard%2Fboss_skills.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20%2Fbaseline-changed%2Fcrates%2Fengine-native-content%2Fsrc%2Fcontent%2Fstandard%2Fboss_skills.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20%2Fbaseline-changed%2Fcrates%2Fengine-native-content%2Fsrc%2Fcontent%2Fstandard%2Fboss_skills.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1,1128 @@\n+use super::*;\n+mod boss_host;\n+\n+pub(super) fn skills() -> Vec<SkillDef> {\n+    let mut skills = vec![\n+        SkillDef {\n+            name: BOSS_XIONGSHOU,\n+            // 权限型能力三面：杀伤条件臂（kernel emit_sha_damage）、\n+            // computed_distance 距离 -1（state）、翻面取消（commit 入口\n+            // 直读跳过——死亡取消型同款），均经 skill_by_name 查询\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_WUZANG,\n+            // 权限型能力两面：摸牌阶段额外量与手牌上限基数归零，均在\n+            // kernel 阶段臂经 skill_by_name 查询\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_XIANGDE,\n+            // 伤害前置触发：来源有武器对持有者伤害 +1（机器一步直改\n+            // 载荷，YiShang 同款窗口）\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::DamageBefore,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: Vec::new(),\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(XiangDeBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_YINZEI,\n+            // 权限型两面：激活门控与伤害后弃牌在 commit_damage/\n+            // commit_lose_hp 尾经 skill_by_name 查询（激活=SkillInstance\n+            // .enabled 直写，初始装配即未激活）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_ZHUE,\n+            // 权限型单面：global damageEnd 双摸在 commit_damage 尾经\n+            // skill_by_name 查询\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_FUTAI,\n+            // 准备阶段触发（判定阶段开始锚点，神智同口径）：全体受伤\n+            // 者按座位序各回 1（机器一步，无挂起；锁定=forced 无确认）\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::PhaseBegin,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: Vec::new(),\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(FutaiBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_YANDU,\n+            // 权限型两面：激活门控（commit_damage 尾，隐贼先例同构）与\n+            // 他人结束阶段获得牌（kernel Phase::End 臂）均经 skill_by_name\n+            // 查询；装配即未激活\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_TANYU,\n+            // 权限型两面：跳过弃牌阶段（kernel Phase::Discard 臂直查）\n+            // 与结束阶段全场最多手牌失 1 体（Phase::End 臂）均经\n+            // skill_by_name 查询\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_CANGMU,\n+            // 权限型单面：摸牌基数=存活角色数（kernel Draw 臂，无脏同位）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_JICAI,\n+            // 权限型两面：激活门控（commit_damage 尾，延妒并列）与回复\n+            // 后双摸（commit_recover 新臂）均经 skill_by_name 查询；装配\n+            // 即未激活\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_NITAI,\n+            // 权限型两面：回合内受伤防止与回合外火伤 +1 均在\n+            // commit_damage 内联经 skill_by_name 查询\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_LUANCHANG,\n+            // 两面：准备阶段（判定阶段开始锚点）视为用【南蛮入侵】（触\n+            // 发机一步 use_virtual_card）；结束阶段视为用【万箭齐发】\n+            // （kernel Phase::End 臂查询式）；激活门控同隐贼/延妒/积财\n+            // 先例（装配即未启用）\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::PhaseBegin,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: Vec::new(),\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(LuanChangBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_MINWAN,\n+            // 权限型三面：伤害后锁定集（commit_damage 尾）、每用牌摸 1\n+            //（commit_card_used 尾）、PlayCard 目标校验（engine 校验段）\n+            // 均经 skill_by_name 查询；锁定集=TurnState.minwan_targets\n+            //（回合级，更替自然清零）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_CUIDUI,\n+            // 权限型单面：伤害后授毒（commit_damage 尾经 skill_by_name\n+            // 查询）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_ZHONGDU,\n+            // 中毒（运行时授技）：回合开始判定（commit_phase Judge begin\n+            // 段内联 draw_judge_card，铁骑式确定性判定）——非红桃伤 1、\n+            // 非黑桃失去此技（实例移除）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_YAOSHOU,\n+            // 权限型单面：computed_distance 距离 -2（state 距离链，凶兽\n+            // 同款）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_JIUSHOU,\n+            // 权限型三面：手牌上限恒 9（state hand_limit）、跳过摸牌与\n+            // 出牌/结束补至 9（kernel 阶段臂）均经 skill_by_name 查询\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_DUQU,\n+            // 权限型单面：受击者给来源加蛇毒标记（commit_damage 尾经\n+            // skill_by_name 查询；PlayerState.shedu 承载）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_ECHOU,\n+            // 权限型两面：激活门控（commit_damage 尾延妒并列）与他人桃\n+            // /酒获标记（commit_card_used）均经 skill_by_name 查询；装配\n+            // 即未激活\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_SHEDU,\n+            // 蛇毒标记结算（运行时触发技）：Judge begin 持有标记>0 →\n+            // 「弃 X 张牌或失去 X 体力」（挂起选择；取消/空选=失 X）→\n+            // 标记-1；X=当前标记数\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::PhaseBegin,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: Vec::new(),\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(ShedUBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_BINGXIAN,\n+            // 权限型单面：他人回合未出杀 → 结束阶段虚拟杀（kernel\n+            // Phase::End 臂，乱常万箭同款 use_virtual_card）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_XUSHI,\n+            // 权限型两面：出牌阶段结束自翻面（commit_phase Play begin:\n+            // false 臂）与翻回正面全场伤 1（commit_turn_over_before 尾）\n+            // 均经 skill_by_name 查询；激活门控同隐贼先例（装配即未激活）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_JUYUAN,\n+            // 权限型两面：回合结束体力记录（kernel Phase::End 臂）与杀\n+            // 目标 mod（engine max_targets）均经 skill_by_name 查询；\n+            // juyuan_storage=PlayerState 跨回合持久字段\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_ZHAOHUO,\n+            // 两面：造成伤害视为火（DamageBefore 触发机一步直改 nature\n+            // ——相德同款窗口）；免疫火伤（commit_damage 入口直读——拟\n+            // 态回合内免伤同位）\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::DamageBefore,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: Vec::new(),\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(ZhaoHuoBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_HONGLIANX,\n+            // 权限型两面：红色不计上限+弃牌阶段红牌不可弃（hand_limit\n+            // 与 Discard 臂查询）；回合开始获红牌/对至多 3 名各 1 火伤\n+            // （Judge begin 段内联，确定性近似登记）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_YANYU,\n+            // 权限型两面：激活门控（commit_damage 尾第八并列臂）与判定\n+            // 红色火伤（kernel Judge begin 段内联，回合计数至多 3）均经\n+            // skill_by_name 查询；装配即未激活\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_FENGDONG,\n+            // 权限型两面：回合开始他人获封印（Judge begin 段内联，神智\n+            // 锚）与回合结束全清（Phase::End 臂）经 skill_by_name 查询；\n+            // PlayCard 手牌校验（engine 校验段）禁用封印者手牌\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_XUNYOU,\n+            // 权限型单面：他人回合开始获得座位序首名有手牌者一张手牌\n+            //（Judge begin 段内联，确定性近似；装备牌自动使用=直接装上）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_SIPU,\n+            // 权限型两面：激活门控（commit_damage 尾第九并列臂；装配即\n+            // 未激活）与响应/救禁（respond_shan、dying_save 选项排除）\n+            // 均经 skill_by_name 查询；使用面由回合模型天然承载；无懈等\n+            // 其余响应窗未纳入禁令（登记差异）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_SHENYI,\n+            // 查询型两面：翻面取消（commit_turn_over_before 臂——凶兽\n+            // 同位，仅正→背取消）与判定阶段延时锦囊无效化（apply_\n+            // judgement 逐臂条件）均经 skill_by_name 查询；洪荒之力禁\n+            // 用交互未落（登记差异）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_RELEIJI,\n+            // 查询型单面：杀/万箭闪消费位内联臂（releiji_on_shan）经\n+            // skill_by_name 查询；青木链见 BOSS_QINGMU2/2X（v292）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_KUANGXIAO,\n+            // 查询型两面：杀无距离（engine sha_range_free 链追加）与目\n+            // 标数无限（engine kuangxiao_inf 臂，天弦同构）均经 skill_\n+            // by_name 查询；友方禁指面登记差异（关系网边界）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_FENTIAN,\n+            // 火改写面=ZhaoHuoBehavior 同构复用（数据less nature 改写，\n+            // 快照变体共用 BossZhaohuo——机器不携带技能身份，恢复路径按\n+            // 技能表重挂）；其余为查询面（engine 红牌免次数/免距离、\n+            // kernel 红杀跳八卦）；wuxie 禁面登记差异未挂钩\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::DamageBefore,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: Vec::new(),\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(ZhaoHuoBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_LINGQU,\n+            // 查询型两面：受击摸 1+计数（commit_damage damageEnd 段）与\n+            // 大于 1 点伤害归零（commit_damage 入口臂）均经 skill_by_name\n+            // 查询；手牌上限 +X（hand_limit 查询+PlayerState.lingqu_count\n+            // 新字段）；玄麟=关卡流程面登记不落\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_SHENEN,\n+            // 全局光环查询型三面：engine sha/顺手距离链 boss 方豁免、\n+            // hand_limit 挑战者 +1（state）、Draw 臂挑战者 +1（kernel）\n+            // 均经 skill_by_name 查询+is_boss_side 判定；光环激活=场上\n+            // 存在持有者\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_XINGQIU,\n+            // 查询型单面：Play begin 臂（交替开关+横置敌方，direct 直写\n+            // linked+日志，索链甲同款）；授 boss_jiding 面登记差异未入库\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_BUCHUN,\n+            // 主动技两线（ActivateSkill 直调 activate——复活线/恢复线按\n+            // 场面分派；间隔门控读 buchun_used_round）；快照变体\n+            // BossBuchun（archive tag 66/机哈希 67）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(BuchunBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_HUIHUO,\n+            // 查询型两面：杀上限 +1（engine 限次臂 once_used 额度，元宝\n+            // 肉同款）与死亡反噬（kernel 死亡结算移除前捕获+PlayerDied\n+            // 后敌方 3 点火伤）均经 skill_by_name 查询\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_FURAN,\n+            // 查询型单面：濒死救援选项扩展（is_tao_like 臂——敌方红色\n+            // 牌可当桃救焰灵）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_XINGXIA,\n+            // 主动技（ActivateSkill 直调 activate——损焰灵线/追击线按\n+            // 挂起阶段推进；间隔门控读 xingxia_used_round）；快照变体\n+            // BossXingxia（archive tag 67/机哈希 68）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(XingxiaBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_JUEHONG,\n+            // 查询型单面：准备阶段臂（Judge begin 段——封冻同位；装备全\n+            // 弃撤技能+入弃堆，随机弃→首张确定性近似登记）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_QINGZHU,\n+            // 查询型两面：跳弃牌（Discard 臂——贪欲同位）+杀禁用（engine\n+            // 校验臂——获急叮解除）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_JIAZU,\n+            // 查询型单面：准备阶段臂（相邻敌方坐骑全弃）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_JIDING,\n+            // 查询型单面：damageEnd 臂（友方受伤→对敌方来源虚拟雷杀，\n+            // LeiSha kind 载体；蓐收加成尾面登记差异）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_ZAOYI,\n+            // 查询型三面：死亡触发（DeathMachine 移除后捕获+授技）、\n+            // targetEnabled 双门控（engine 校验）、造异异变授予（运行时\n+            // skills.insert，中毒/蛇毒先例）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_ZAOYI_HP,\n+            // 查询型单面（运行时授予）：回合开始敌方最低体力全体失去全\n+            // 部体力（Judge begin 臂）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_ZIRUN,\n+            // 查询型单面：准备阶段臂（Judge begin 段——全体摸牌：有装备\n+            // 2/无装备 1）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_NIANRUI,\n+            // 查询型单面：Draw 臂固定摸 2 后补摸 2（藏目同位）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_MENGTAI,\n+            // 查询型多面：准备置位/摸牌清位/出牌清位/结束补摸 3/弃牌闸门\n+            // （TurnState.mengtai_* 双旗标承载）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_NBIANSHEN,\n+            // 查询型单面：Judge begin 轮换臂（assembly 重挂+hp 保留；\n+            // versus 替补换将先例同构；确定性互斥轮转登记）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_RENXING,\n+            // 查询型双臂：damageEnd（commit_damage 段）+recoverEnd\n+            // （commit_recover_skills 头）——非当前回合摸 1\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_RUIZHI,\n+            // 查询型单面：准备阶段臂（global 修剪：其余角色保留 1 手+1\n+            // 装，弃其余——保留首张确定性近似登记）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_SHOUYI,\n+            // 查询型单面：sha_range_free 链+顺手距离链追加（全牌无距离，\n+            // 狂笑/神恩同位）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_DANSHU,\n+            // 查询型单面：CardsDiscarded 臂（失去手牌后非当前回合且已受\n+            // 伤判定红回 1）——夜叉批条目复用同名 def\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_JINGJUE,\n+            // 查询型单面：继承胆术（同内容共用 commit 臂按名双查）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_MODAO,\n+            // 查询型单面：Judge begin 臂自摸 2（藏目/年瑞同位）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_MOJIAN,\n+            // 查询型单面：Play begin 臂虚拟万箭（乱常 End 臂同款\n+            // use_virtual_card；异侧存活全目标）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_YUSHOU,\n+            // 查询型单面：Play begin 臂虚拟南蛮（魔剑同款 use_virtual_card）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_MOYANY,\n+            // 查询型单面：CardsDiscarded 臂（非当前回合判定红→2 火伤打\n+            // 座位序首个其他存活——确定性近似登记）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_BAOLIAN,\n+            // 查询型单面：End 臂摸 2\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_QIANGZHENG,\n+            // 查询型单面：End 臂——每名其他有手牌角色随机一张→首张确定\n+            // 性近似登记，获得至手牌\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_ZUIJIU,\n+            // 查询型单面：commit_damage 臂——source sha 伤害 +1\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_XIAOSHOU,\n+            // 查询型单面：End 臂——座位序首个 hp≥self 其他存活受 3 伤害\n+            // （目标自选可放弃→恒发动确定性近似登记）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_GUIJI,\n+            // 查询型单面：Judge begin 臂弃自己判定区首张（随机→首张近似）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_TAIPING,\n+            // 查询型单面：Draw 臂 +2（年瑞同位）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_SUOMING,\n+            // 查询型单面：End 臂——全部未链接异侧存活横置（链接机直写+\n+            // Linked 日志，[1,num] 自选→全部确定性近似登记）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_XIXING,\n+            // 查询型单面：Judge begin 臂——座位序首个已链接异侧受 1 雷伤\n+            // +持有者回 1（目标自选→首个已链接确定性近似登记）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_LIANYU,\n+            // 查询型单面：End 臂——全部其他存活各 1 火伤（无询问直伤）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_JUECE,\n+            // 查询型单面：CardsDiscarded 臂——自己回合内其他角色失去最后\n+            // 一手牌（弃后空手）→ 1 伤害（chooseBool AI→恒发动近似登记）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_JIUCHI,\n+            // 查询型单面：PlayCard kind 改写臂（黑桃手牌→酒，viewAs 转化\n+            // 武圣/奇袭同族）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_GUIMOU,\n+            // 查询型单面：End begin 臂——座位序首个其他未混乱存活角色\n+            // boss_mad 置位（其回合收束解除；随机→首个确定性近似登记）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_YUANCE,\n+            // 查询型单面：Damage commit 尾臂——来源≠受伤者且双方存活 →\n+            // 判定（选项一恒定：黑→受伤者失 1 / 红→来源失 1；chooseControl\n+            // AI 态度面→恒选项一确定性近似登记）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_QIZUO,\n+            // CardUsed AfterTriggers 触发：锦囊复用一步机（QizuoBehavior\n+            // 门=无懈/铁索排除+延时同名去重+原目标存活；载体槽守卫递归）\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::CardUsed,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: Vec::new(),\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(QizuoBehavior),\n+        },\n+        SkillDef {\n+            name: JUE_QING,\n+            // 查询型单面：commit_damage 入口直读臂（急冻前——上游\n+            // damageBefore 层）——来源伤害改为目标失去等量体力\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_WUXIN,\n+            // 查询型双面：commit_damage 入口直读臂（受伤→失 1）+\n+            // PlayCard 校验臂（乐/兵拒——延时禁指定他人）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_SHANGSHIX,\n+            // 查询型双面：四 commit 臂补牌（CardsDiscarded/Damage/LoseHp/\n+            // Recover——手牌<4 补至 4）+ End begin 臂（hp>1 全体各失 1）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_XIAOXIONG,\n+            // CardUsed AfterTriggers 触发：副本入手一步机（XiaoxiongBehavior\n+            // 门=他人使用+基本/锦囊白名单；End begin 臂=子技未用牌伤害）\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::CardUsed,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: Vec::new(),\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(XiaoxiongBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_ZHANGWU,\n+            // 查询型单面：Damage commit 尾臂（damageEnd 族）——持有者弃 1\n+            // 张+来源弃 1 张或受 1 伤害（双方恒弃首张确定性近似登记）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_LINGBO,\n+            // CardResponded+CardUsed 触发：打出/使用闪后摸 2 一步机\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::CardResponded,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: vec![EventKind::CardUsed],\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(LingboBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_JIAOXIA,\n+            // 查询型单面：CardUsed commit 臂——成为红色牌目标后摸 1\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_FANGHUA,\n+            // 查询型单面：End begin 臂——存在翻面角色则全部各失 1\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_TASHUI,\n+            // CardResponded+CardUsed 触发：打出/使用黑牌后翻面一步机\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::CardResponded,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: vec![EventKind::CardUsed],\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(TashuiBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_HUOSHEN,\n+            // 查询型单面：commit_damage 火伤分支直读臂（招祸同位扩展——\n+            // 免疫火伤+回复 1）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_ZYHONGLIAN,\n+            // 查询型单面：End begin 臂——摸 2+全部其他存活各 1 火伤\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_XIANYIN,\n+            // 查询型单面：CardsDiscarded 臂（非当前回合）——判定红→座位\n+            // 序首个其他存活失 1（chooseTarget AI→首个确定性近似登记）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_TIANDAO,\n+            // 查询型单面：改判机 rewriters 扩展（hes 任意牌改判+获得原判\n+            // 定牌）——JudgePhase 机器内联，无独立触发\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+      