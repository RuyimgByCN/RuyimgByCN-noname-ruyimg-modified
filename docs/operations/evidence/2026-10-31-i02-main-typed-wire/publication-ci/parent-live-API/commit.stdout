  \"value\": \"repo \"\n+      }\n+    ]\n+  },\n+  {\n+    \"name\": \"repository_whitespace_control_2005\",\n+    \"changes\": [\n+      {\n+        \"pointer\": \"/occurrences/0/event/voice/role/owner/repository\",\n+        \"value\": \"repo \"\n+      }\n+    ]\n+  },\n+  {\n+    \"name\": \"repository_whitespace_control_2006\",\n+    \"changes\": [\n+      {\n+        \"pointer\": \"/occurrences/0/event/voice/role/owner/repository\",\n+        \"value\": \"repo \"\n+      }\n+    ]\n+  },\n+  {\n+    \"name\": \"repository_whitespace_control_2007\",\n+    \"changes\": [\n+      {\n+        \"pointer\": \"/occurrences/0/event/voice/role/owner/repository\",\n+        \"value\": \"repo \"\n+      }\n+    ]\n+  },\n+  {\n+    \"name\": \"repository_whitespace_control_2008\",\n+    \"changes\": [\n+      {\n+        \"pointer\": \"/occurrences/0/event/voice/role/owner/repository\",\n+        \"value\": \"repo \"\n+      }\n+    ]\n+  },\n+  {\n+    \"name\": \"repository_whitespace_control_2009\",\n+    \"changes\": [\n+      {\n+        \"pointer\": \"/occurrences/0/event/voice/role/owner/repository\",\n+        \"value\": \"repo \"\n+      }\n+    ]\n+  },\n+  {\n+    \"name\": \"repository_whitespace_control_200a\",\n+    \"changes\": [\n+      {\n+        \"pointer\": \"/occurrences/0/event/voice/role/owner/repository\",\n+        \"value\": \"repo \"\n+      }\n+    ]\n+  },\n+  {\n+    \"name\": \"repository_whitespace_control_2028\",\n+    \"changes\": [\n+      {\n+        \"pointer\": \"/occurrences/0/event/voice/role/owner/repository\",\n+        \"value\": \"repo \"\n+      }\n+    ]\n+  },\n+  {\n+    \"name\": \"repository_whitespace_control_2029\",\n+    \"changes\": [\n+      {\n+        \"pointer\": \"/occurrences/0/event/voice/role/owner/repository\",\n+        \"value\": \"repo \"\n+      }\n+    ]\n+  },\n+  {\n+    \"name\": \"repository_whitespace_control_202f\",\n+    \"changes\": [\n+      {\n+        \"pointer\": \"/occurrences/0/event/voice/role/owner/repository\",\n+        \"value\": \"repo \"\n+      }\n+    ]\n+  },\n+  {\n+    \"name\": \"repository_whitespace_control_205f\",\n+    \"changes\": [\n+      {\n+        \"pointer\": \"/occurrences/0/event/voice/role/owner/repository\",\n+        \"value\": \"repo \"\n+      }\n+    ]\n+  },\n+  {\n+    \"name\": \"repository_whitespace_control_3000\",\n+    \"changes\": [\n+      {\n+        \"pointer\": \"/occurrences/0/event/voice/role/owner/repository\",\n+        \"value\": \"repo　\"\n+      }\n+    ]\n+  }\n+]"},{"sha":"8d110a7639c4bcaf616801d287b2c4572a6285a0","filename":"crates/engine-protocol/tests/fixtures/i02-presentation-surrogates.json","status":"added","additions":32,"deletions":0,"changes":32,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/crates%2Fengine-protocol%2Ftests%2Ffixtures%2Fi02-presentation-surrogates.json","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/crates%2Fengine-protocol%2Ftests%2Ffixtures%2Fi02-presentation-surrogates.json","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/crates%2Fengine-protocol%2Ftests%2Ffixtures%2Fi02-presentation-surrogates.json?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1,32 @@\n+[\n+  {\n+    \"name\": \"repository_lone_high\",\n+    \"pointer\": \"/occurrences/0/event/voice/role/owner/repository\",\n+    \"raw_json_value\": \"\\\"repo\\\\ud800\\\"\"\n+  },\n+  {\n+    \"name\": \"repository_lone_low\",\n+    \"pointer\": \"/occurrences/0/event/voice/role/owner/repository\",\n+    \"raw_json_value\": \"\\\"repo\\\\udfff\\\"\"\n+  },\n+  {\n+    \"name\": \"token_lone_high\",\n+    \"pointer\": \"/occurrences/0/event/effective/key\",\n+    \"raw_json_value\": \"\\\"sha\\\\ud800\\\"\"\n+  },\n+  {\n+    \"name\": \"token_lone_low\",\n+    \"pointer\": \"/occurrences/0/event/effective