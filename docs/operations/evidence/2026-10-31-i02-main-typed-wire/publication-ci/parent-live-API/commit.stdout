  // 查询型单面：Judge begin global 臂（恒定禁基本牌）+\n+            // PlayCard 拒绝位+回合结束全清\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_TIEMIAN,\n+            // 查询型单面：sha 机仁王块扩展（防具槽空视为仁王盾）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_ZHADAO,\n+            // 查询型单面：sha 机青釭穿透链扩展（来源持有者即穿透）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_ZHUXIN,\n+            // Death 触发（遗言面）：最低体力其他存活受 2 伤一步机\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::Death,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: Vec::new(),\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(ZhuxinBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_SUOZU,\n+            // 查询型单面：Prepare begin 臂——全部其他存活横置\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_ABI,\n+            // 查询型单面：Damage commit 尾臂——来源受 1 火伤（恒定火）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_PINGDENG,\n+            // Death 触发（遗言面）：最高体力两波火伤（2+1）两步机\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::Death,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: Vec::new(),\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(PingdengBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_REMEN,\n+            // 查询型单面：PlayCard 拒绝位（plain 杀）+AOE 机窗口前跳过\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_ZHIFEN,\n+            // 查询型单面：Prepare begin 臂——获得座位序首个其他首张手\n+            // 牌+其受 1 火伤（无来源）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_HUOXING,\n+            // Death 触发（遗言面）：全部其他存活逐座火伤机\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::Death,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: Vec::new(),\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(HuoxingBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_BUFO,\n+            // 查询型单面×2：伤害入口减 1（终值>1）+准备阶段距离 1 火伤\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_WULIANG,\n+            // 查询型单面×2：结束阶段摸 2+准备阶段体力<3 回复至 3\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_DITING,\n+            // 查询型单面：computed_distance 双向链（from -1 / to +1）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_WEIMU,\n+            // 查询型单面：黑锦囊 PlayCard 拒绝位+黑色 AOE 窗口前跳过\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_BINGFENG,\n+            // Death 触发（遗言面）：翻面来源一步机\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::Death,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: Vec::new(),\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(BingfengBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_PANGUAN,\n+            // 查询型单面：延时锦囊 PlayCard 拒绝位\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_JUHUN,\n+            // 查询型单面：End begin 臂——座位序首个其他翻面（恒定翻面）\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_WANGXIANG,\n+            // Death 触发（遗言面）：全场装备全弃一步机\n+            trigger: Some(TriggerMeta {\n+                event: EventKind::Death,\n+                timing: Timing::Normal,\n+                priority: 0,\n+                order_selectable: true,\n+                optional: false,\n+                extra_events: Vec::new(),\n+            }),\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(WangxiangBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_TIANYU,\n+            // 查询型单面：End begin 臂——自横置先解除+全场未横置横置\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+        SkillDef {\n+            name: BOSS_QIWU,\n+            // 查询型单面：CardUsed commit 臂——梅花牌使用后受伤回复 1\n+            trigger: None,\n+            limits: SkillLimits::default(),\n+            behavior: Box::new(NoopBehavior),\n+        },\n+    ];\n+    skills.extend(boss_host::skills());\n+    skills\n+}"},{"sha":"2d6dde0d939842e9c305c042443b85b8e5f9957a","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20/baseline-changed/crates/engine-native-kernel/src/archive/damage.rs","status":"added","additions":73,"deletions":0,"changes":73,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Farchive%2Fdamage.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Farchive%2Fdamage.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Farchive%2Fdamage.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1,73 @@\n+//! Private106 damage settlement codec; old machine field layouts are unchanged.\n+use super::*;\n+use crate::event::{DamageOutcome as O, DamageProgress as P, DamageSettlement};\n+pub(super) fn enc_settlement(w: &mut W, s: &DamageSettlement) {\n+    enc_opt_u32(w, s.committed_damage);\n+    w.u32(s.hp_loss);\n+    w.u8(match s.outcome {\n+        O::Running => 0,\n+        O::Cancelled => 1,\n+        O::ReplacedByLoseHp => 2,\n+        O::Zero => 3,\n+        O::Completed => 4,\n+    });\n+    w.boolean(s.notrigger);\n+    let (tag, remaining) = match &s.progress {\n+        P::Before => (0, None),\n+        P::HpCommitted => (1, None),\n+        P::TargetDamage => (2, None),\n+        P::DyingPending => (3, None),\n+        P::DyingDone => (4, None),\n+        P::Source => (5, None),\n+        P::End => (6, None),\n+        P::After => (7, None),\n+        P::Chain { remaining } => (8, Some(remaining)),\n+        P::Done => (9, None),\n+        P::ZeroPending => (10, None),\n+        P::Stopped => (11, None),\n+    };\n+    w.u8(tag);\n+    if let Some(remaining) = remaining {\n+        w.len(remaining.len());\n+        for p in remaining {\n+            w.u8(*p);\n+        }\n+    }\n+}\n+pub(super) fn dec_settlement(r: &mut R<'_>) -> Result<DamageSettlement, ArchiveError> {\n+    let committed_damage = dec_opt_u32(r)?;\n+    let hp_loss = r.u32()?;\n+    let outcome = match r.u8()? {\n+        0 => O::Running,\n+        1 => O::Cancelled,\n+        2 => O::ReplacedByLoseHp,\n+        3 => O::Zero,\n+        4 => O::Completed,\n+        t => return Err(ArchiveError::BadTag(\"damage_outcome\", t)),\n+    };\n+    let notrigger = r.boolean()?;\n+    let progress = match r.u8()? {\n+        0 => P::Before,\n+        1 => P::HpCommitted,\n+        2 => P::TargetDamage,\n+        3 => P::DyingPending,\n+        4 => P::DyingDone,\n+        5 => P::Source,\n+        6 => P::End,\n+        7 => P::After,\n+        8 => P::Chain {\n+            remaining: r.vec(|r| r.u8())?,\n+        },\n+        9 => P::Done,\n+        10 => P::ZeroPending,\n+        11 => P::Stopped,\n+        t => return Err(ArchiveError::BadTag(\"damage_progress\", t)),\n+    };\n+    Ok(DamageSettlement {\n+        committed_damage,\n+        hp_loss,\n+        outcome,\n+        notrigger,\n+        progress,\n+    })\n+}"},{"sha":"52bf9d02af23304293f8d306b3a66c96117db9ba","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20/baseline-changed/crates/engine-native-kernel/src/archive/values.rs","status":"added","additions":277,"deletions":0,"changes":277,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Farchive%2Fvalues.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Farchive%2Fvalues.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Farchive%2Fvalues.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1,277 @@\n+use super::*;\n+\n+// ---- 基础类型编码 ----\n+\n+pub(super) fn enc_opt_u32(w: &mut W, v: Option<u32>) {\n+    match v {\n+        Some(x) => {\n+            w.u8(1);\n+            w.u32(x);\n+        }\n+        None => w.u8(0),\n+    }\n+}\n+\n+pub(super) fn dec_opt_u32(r: &mut R<'_>) -> Result<Option<u32>, ArchiveError> {\n+    match r.u8()? {\n+        0 => Ok(None),\n+        1 => Ok(Some(r.u32()?)),\n+        t => Err(ArchiveError::BadTag(\"opt_u32\", t)),\n+    }\n+}\n+\n+/// PlayerId = u8。\n+pub(super) fn enc_pid(w: &mut W, v: &PlayerId) {\n+    w.u8(*v);\n+}\n+\n+pub(super) fn dec_pid(r: &mut R<'_>) -> Result<PlayerId, ArchiveError> {\n+    Ok(r.u8()?)\n+}\n+\n+/// Option<PlayerId>。\n+pub(super) fn enc_opt_pid(w: &mut W, v: &Option<PlayerId>) {\n+    match v {\n+        Some(x) => {\n+            w.u8(1);\n+            w.u8(*x);\n+        }\n+        None => w.u8(0),\n+    }\n+}\n+\n+pub(super) fn dec_opt_pid(r: &mut R<'_>) -> Result<Option<PlayerId>, ArchiveError> {\n+    match r.u8()? {\n+        0 => Ok(None),\n+        1 => Ok(Some(r.u8()?)),\n+        t => Err(ArchiveError::BadTag(\"opt_pid\", t)),\n+    }\n+}\n+\n+/// Vec<PlayerId>。\n+pub(super) fn enc_pids(w: &mut W, v: &[PlayerId]) {\n+    w.len(v.len());\n+    for p in v {\n+        w.u8(*p);\n+    }\n+}\n+\n+pub(super) fn dec_pids(r: &mut R<'_>) -> Result<Vec<PlayerId>, ArchiveError> {\n+    r.vec(|r| r.u8())\n+}\n+\n+/// SkillDefId = u16。\n+pub(super) fn enc_skill(w: &mut W, v: &SkillDefId) {\n+    w.u16(*v);\n+}\n+\n+pub(super) fn dec_skill(r: &mut R<'_>) -> Result<SkillDefId, ArchiveError> {\n+    Ok(r.u16()?)\n+}\n+\n+pub(super) fn enc_damage_nature(w: &mut W, v: &DamageNature) {\n+    w.u8(match v {\n+        DamageNature::Normal => 0,\n+        DamageNature::Fire => 1,\n+        DamageNature::Thunder => 2,\n+    });\n+}\n+\n+pub(super) fn dec_damage_nature(r: &mut R<'_>) -> Result<DamageNature, ArchiveError> {\n+    Ok(match r.u8()? {\n+        0 => DamageNature::Normal,\n+        1 => DamageNature::Fire,\n+        2 => DamageNature::Thunder,\n+        t => return Err(ArchiveError::BadTag(\"damage_nature\", t)),\n+    })\n+}\n+\n+pub(super) fn enc_phase(w: &mut W, v: &Phase) {\n+    w.u8(match v {\n+        Phase::Judge => 0,\n+        Phase::Draw => 1,\n+        Phase::Play => 2,\n+        Phase::Discard => 3,\n+        Phase::End => 4,\n+    });\n+}\n+\n+pub(super) fn dec_phase(r: &mut R<'_>) -> Result<Phase, ArchiveError> {\n+    Ok(match r.u8()? {\n+        0 => Phase::Judge,\n+        1 => Phase::Draw,\n+        2 => Phase::Play,\n+        3 => Phase::Discard,\n+        4 => Phase::End,\n+        t => return Err(ArchiveError::BadTag(\"phase\", t)),\n+    })\n+}\n+\n+pub(super) fn enc_event_kind(w: &mut W, v: &EventKind) {\n+    use EventKind::*;\n+    let t = match v {\n+        DamageBefore => 0u8,\n+        Damage => 1,\n+        Recover => 2,\n+        CardsDrawn => 3,\n+        CardsMoved => 4,\n+        CardUsed => 5,\n+        CardResponded => 6,\n+        Dying => 7,\n+        Death => 8,\n+        PhaseBegin => 9,\n+        PhaseEnd => 10,\n+        TurnEnded => 11,\n+        SkillToggled => 12,\n+        Equipped => 13,\n+        Linked => 14,\n+        CardsDiscarded => 15,\n+        TurnOverBefore => 16,\n+        TurnOvered => 17,\n+        LoseHp => 18,\n+        DyingSaved => 19,\n+        CardsLost => 20,\n+        ShaDodged => 21,\n+        CardsGiven => 22,\n+        DamageSource => 23, DamageEnd => 24, DamageAfter => 25, DamageZero => 26, DamageCancelled => 27,\n+    };\n+    w.u8(t);\n+}\n+\n+pub(super) fn dec_event_kind(r: &mut R<'_>) -> Result<EventKind, ArchiveError> {\n+    use EventKind::*;\n+    Ok(match r.u8()? {\n+        0 => DamageBefore,\n+        1 => Damage,\n+        2 => Recover,\n+        3 => CardsDrawn,\n+        4 => CardsMoved,\n+        5 => CardUsed,\n+        6 => CardResponded,\n+        7 => Dying,\n+        8 => Death,\n+        9 => PhaseBegin,\n+        10 => PhaseEnd,\n+        11 => TurnEnded,\n+        12 => SkillToggled,\n+        13 => Equipped,\n+        14 => Linked,\n+        15 => CardsDiscarded,\n+        16 => TurnOverBefore,\n+        17 => TurnOvered,\n+        18 => LoseHp,\n+        19 => DyingSaved,\n+        20 => CardsLost,\n+        21 => ShaDodged,\n+        22 => CardsGiven,\n+        23 => DamageSource,24 => DamageEnd,25 => DamageAfter,26 => DamageZero,27 => DamageCancelled,\n+        t => return Err(ArchiveError::BadTag(\"event_kind\", t)),\n+    })\n+}\n+\n+pub(super) fn enc_stage(w: &mut W, v: &Stage) {\n+    w.u8(match v {\n+        Stage::BeforeTriggers => 0,\n+        Stage::Commit => 1,\n+        Stage::AfterTriggers => 2,\n+        Stage::Intrinsic => 3,\n+        Stage::Done => 4,\n+    });\n+}\n+\n+pub(super) fn dec_stage(r: &mut R<'_>) -> Result<Stage, ArchiveError> {\n+    Ok(match r.u8()? {\n+        0 => Stage::BeforeTriggers,\n+        1 => Stage::Commit,\n+        2 => Stage::AfterTriggers,\n+        3 => Stage::Intrinsic,\n+        4 => Stage::Done,\n+        t => return Err(ArchiveError::BadTag(\"stage\", t)),\n+    })\n+}\n+\n+pub(super) fn enc_role(w: &mut W, v: &Role) {\n+    w.u8(match v {\n+        Role::Lord => 0,\n+        Role::Loyalist => 1,\n+        Role::Rebel => 2,\n+        Role::Traitor => 3,\n+    });\n+}\n+\n+pub(super) fn dec_role(r: &mut R<'_>) -> Result<Role, ArchiveError> {\n+    Ok(match r.u8()? {\n+        0 => Role::Lord,\n+        1 => Role::Loyalist,\n+        2 => Role::Rebel,\n+        3 => Role::Traitor,\n+        t => return Err(ArchiveError::BadTag(\"role\", t)),\n+    })\n+}\n+\n+pub(super) fn enc_faction(w: &mut W, f: &crate::catalog::Faction) {\n+    w.u8(match f {\n+        crate::catalog::Faction::Wei => 0,\n+        crate::catalog::Faction::Shu => 1,\n+        crate::catalog::Faction::Wu => 2,\n+        crate::catalog::Faction::Qun => 3,\n+    });\n+}\n+\n+pub(super) fn dec_faction(r: &mut R<'_>) -> Result<crate::catalog::Faction, ArchiveError> {\n+    Ok(match r.u8()? {\n+        0 => crate::catalog::Faction::Wei,\n+        1 => crate::catalog::Faction::Shu,\n+        2 => crate::catalog::Faction::Wu,\n+        3 => crate::catalog::Faction::Qun,\n+        t => return Err(ArchiveError::BadTag(\"faction\", t)),\n+    })\n+}\n+\n+pub(super) fn enc_winner(w: &mut W, v: &Winner) {\n+    match v {\n+        Winner::Player(p) => {\n+            w.u8(0);\n+            w.u8(*p);\n+        }\n+        Winner::LordSide => w.u8(1),\n+        Winner::Rebels => w.u8(2),\n+        Winner::Traitor => w.u8(3),\n+        // P0 解码加固：势力编码走显式表（与 dec_faction 同源），避免\n+        // `*f as u8` 依赖枚举声明顺序——重排/增删势力不再静默错位。\n+        Winner::Faction(f) => {\n+            w.u8(4);\n+            enc_faction(w, f);\n+        }\n+        Winner::Versus(t) => {\n+            w.u8(5);\n+            w.u8(*t as u8);\n+        }\n+        Winner::Doudizhu { lord_won } => {\n+            w.u8(6);\n+            w.boolean(*lord_won);\n+        }\n+        Winner::Boss { boss_won } => {\n+            w.u8(7);\n+            w.boolean(*boss_won);\n+        }\n+    }\n+}\n+\n+pub(super) fn dec_winner(r: &mut R<'_>) -> Result<Winner, ArchiveError> {\n+    Ok(match r.u8()? {\n+        0 => Winner::Player(r.u8()?),\n+        1 => Winner::LordSide,\n+        2 => Winner::Rebels,\n+        3 => Winner::Traitor,\n+        4 => Winner::Faction(dec_faction(r)?),\n+        5 => Winner::Versus(r.u8()? as usize),\n+        6 => Winner::Doudizhu {\n+            lord_won: r.boolean()?,\n+        },\n+        7 => Winner::Boss {\n+            boss_won: r.boolean()?,\n+        },\n+        t => return Err(ArchiveError::BadTag(\"winner\", t)),\n+    })\n+}"},{"sha":"64ca5bcd8bf76d05e9e0289af0202b5a1c2106d9","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20/baseline-changed/crates/engine-native-kernel/src/event.rs","status":"added","additions":379,"deletions":0,"changes":379,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fevent.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fevent.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fevent.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1,379 @@\n+//! 事件模型：显式事件栈的帧。\n+//!\n+//! 与旧实现的差别：事件嵌套是一棵真实的栈（父/子/返回值都在帧上），\n+//! 不再是「单槽恢复 + 三个延迟队列」；帧载荷是类型化的 `EventData`，\n+//! 技能可以在结算窗口内改写帧载荷（如伤害转移）。\n+\n+use crate::ids::{CardId, EventId, PlayerId, SkillDefId};\n+mod damage;\n+pub use damage::*;\n+\n+/// 触发唤醒用的事件类别。\n+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash)]\n+pub enum EventKind {\n+    DamageBefore,\n+    Damage,\n+    Recover,\n+    CardsDrawn,\n+    CardsMoved,\n+    CardUsed,\n+    CardResponded,\n+    Dying,\n+    Death,\n+    PhaseBegin,\n+    PhaseEnd,\n+    TurnEnded,\n+    SkillToggled,\n+    Equipped,\n+    Linked,\n+    CardsDiscarded,\n+    TurnOverBefore,\n+    TurnOvered,\n+    LoseHp,\n+    /// 濒死救回（U05 xianjian 焚逝挂点，规则 v157）：固有救援机在\n+    /// 体力>0 且脱离濒死时发射（上游 dyingAfter 时序等价）。\n+    DyingSaved,\n+    /// 失去牌（swd 批 125，规则 v312）：手牌被弃置/交出或装备被取走时\n+    /// 发射（上游 `loseEnd` 触发窗；装备替换过程不发——上游 `equiping`\n+    /// 期过滤同口径）。\n+    CardsLost,\n+    /// 杀被闪避（swd 批 141，规则 v316 同批）：目标成功闪避【杀】时发射\n+    /// （上游 `shaMiss` 触发窗；用于李香龙等「杀被闪后反击」类技能）。\n+    ShaDodged,\n+    /// 手牌直接给予另一角色（NC04 未映射事件批）：`give_hand_card` 共享\n+    /// 原语发射；DSL `cards_given` 触发窗（旧线 EventKind 同名同义）。\n+    CardsGiven,\n+    DamageSource,\n+    DamageEnd,\n+    DamageAfter,\n+    DamageZero,\n+    DamageCancelled,\n+}\n+\n+/// 失去牌的来源区（`CardsLost` 载荷；上游 `card.original`）。\n+#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n+pub enum LostOrigin {\n+    Hand,\n+    Equip,\n+    Judge,\n+}\n+\n+/// 伤害属性：普通 / 火 / 雷。属性伤害触发铁索连环传导。\n+#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n+pub enum DamageNature {\n+    Normal,\n+    Fire,\n+    Thunder,\n+}\n+\n+/// 伤害事件载荷：结算窗口内可被技能改写（转移/防止）。\n+#[derive(Debug, Clone, PartialEq, Eq)]\n+pub struct DamageData {\n+    pub source: Option<PlayerId>,\n+    /// 当前承受者——转移技能改写此字段。\n+    pub target: PlayerId,\n+    pub amount: i32,\n+    /// One canonical submission and continuation authority.\n+    pub settlement: DamageSettlement,\n+    pub nature: DamageNature,\n+    /// 防止类技能改写此字段；提交阶段读到 true 则不扣血。\n+    pub prevented: bool,\n+    /// 转移链记录：原始承受者 -> …… -> 最终承受者。\n+    pub redirect_chain: Vec<PlayerId>,\n+    /// 造成伤害的牌（奸雄/遗计类技能依赖；非牌类伤害为 None）。\n+    pub card: Option<CardId>,\n+    /// 铁索连环传导伤害（ow 源氏飞刃 notLink 过滤依赖；主伤害为\n+    /// false——上游 event.notLink() 同口径，规则 v129）。\n+    pub from_chain: bool,\n+}\n+\n+#[derive(Debug, Clone, PartialEq, Eq)]\n+pub struct CardUseData {\n+    pub card: CardId,\n+    pub player: PlayerId,\n+    pub targets: Vec<PlayerId>,\n+    /// 杀的属性（仅 Sha/FireSha 有意义）。\n+    pub nature: DamageNature,\n+    /// view-as 转化声明（武圣/龙胆）：以此牌种结算而非目录牌种。\n+    pub use_as: Option<crate::catalog::CardKind>,\n+    /// E03 使用前取消（猴子偷桃）：确认后由窗口机器执行夺桃并把本位\n+    /// 置真；提交阶段读到真值即跳过结算。不入 canonical_hash（取消的\n+    /// 最终状态——牌的位置与体力——已可观测）。\n+    pub cancelled: bool,\n+}\n+\n+/// 类型化事件载荷。\n+#[derive(Debug, Clone, PartialEq, Eq)]\n+pub enum EventData {\n+    /// E03 翻面前置窗口（漩涡面具等锁定技可取消）。\n+    TurnOverBefore {\n+        player: PlayerId,\n+        cancelled: bool,\n+    },\n+    /// E03 翻面完成。\n+    TurnOvered {\n+        player: PlayerId,\n+        face_down: bool,\n+    },\n+    Damage(DamageData),\n+    /// A real child window referencing its canonical damage ancestor.\n+    DamageWindow { root: EventId, window: DamageWindowKind },\n+    Recover {\n+        player: PlayerId,\n+        amount: u32,\n+        by_card: Option<CardId>,\n+    },\n+    CardsDrawn {\n+        player: PlayerId,\n+        cards: Vec<CardId>,\n+    },\n+    CardsMoved {\n+        cards: Vec<CardId>,\n+        from: PlayerId,\n+        to: PlayerId,\n+    },\n+    CardUsed(CardUseData),\n+    CardResponded {\n+        card: CardId,\n+        player: PlayerId,\n+    },\n+    Dying {\n+        player: PlayerId,\n+        source: Option<PlayerId>,\n+    },\n+    Death {\n+        player: PlayerId,\n+        killer: Option<PlayerId>,\n+    },\n+    Phase {\n+        player: PlayerId,\n+        phase: Phase,\n+        begin: bool,\n+    },\n+    TurnEnded {\n+        player: PlayerId,\n+    },\n+    SkillToggled {\n+        player: PlayerId,\n+        skill: SkillDefId,\n+        enabled: bool,\n+        /// 是否临时获得、回合结束移除。\n+        temporary: bool,\n+    },\n+    /// 装备一张装备牌；同栏旧牌被替换入弃牌堆。\n+    Equipped {\n+        player: PlayerId,\n+        card: CardId,\n+        /// 同栏被替换下的旧牌（若有）。\n+        replaced: Option<CardId>,\n+    },\n+    /// 连环状态切换（铁索连环横置/重置）。\n+    Linked {\n+        player: PlayerId,\n+        linked: bool,\n+    },\n+    /// 弃牌（弃牌阶段批量弃置等；供连营类「失去手牌」触发）。\n+    CardsDiscarded {\n+        player: PlayerId,\n+        cards: Vec<CardId>,\n+    },\n+    /// 失去牌（swd 批 125）：`origins` 与 `cards` 等长，标出每张的来源区\n+    /// （上游 `card.original`——'h'/'e'/'j'）。\n+    CardsLost {\n+        player: PlayerId,\n+        cards: Vec<CardId>,\n+        origins: Vec<LostOrigin>,\n+    },\n+    /// 杀被闪避（swd 批 141）：`card` = 被闪的【杀】，`source` = 使用者，\n+    /// `target` = 闪避者（上游 `shaMiss` 的 trigger.card/player）。\n+    ShaDodged {\n+        card: CardId,\n+        source: PlayerId,\n+        target: PlayerId,\n+    },\n+    /// 手牌直接给予（NC04 未映射事件批）：`giver` 交出、`recipient` 收入，\n+    /// 与旧线 `DomainEvent::CardsGiven` 同形（giver≠recipient 且非空才发）。\n+    /// 触发上下文：事件主玩家=recipient、来源=giver、amount=张数（旧线\n+    /// dispatch 同口径）。**每次给牌动作一帧、携带全部牌**（规则 v326，\n+    /// `give_hand_cards` 批量原语）；CardsLost/CardsMoved 仍逐张。\n+    CardsGiven {\n+        giver: PlayerId,\n+        recipient: PlayerId,\n+        cards: Vec<CardId>,\n+    },\n+    /// 失去体力（逐技对照批三 v77）：直接扣减体力——不经护甲、不触发\n+    /// 伤害类窗口/铁索/伤害来源技；体力 ≤0 进入濒死（上游 loseHp）。\n+    LoseHp {\n+        player: PlayerId,\n+        amount: u32,\n+    },\n+    /// 濒死救回（dyingAfter 等价，见 EventKind::DyingSaved）。\n+    DyingSaved {\n+        player: PlayerId,\n+        source: Option<PlayerId>,\n+    },\n+}\n+\n+impl EventData {\n+    pub fn kind(&self) -> EventKind {\n+        match self {\n+            EventData::Damage(_) => EventKind::Damage,\n+            EventData::DamageWindow { window, .. } => window.event_kind(),\n+            EventData::Recover { .. } => EventKind::Recover,\n+            EventData::CardsDrawn { .. } => EventKind::CardsDrawn,\n+            EventData::CardsMoved { .. } => EventKind::CardsMoved,\n+            EventData::CardUsed(_) => EventKind::CardUsed,\n+            EventData::CardResponded { .. } => EventKind::CardResponded,\n+            EventData::Dying { .. } => EventKind::Dying,\n+            EventData::Death { .. } => EventKind::Death,\n+            EventData::Phase { begin: true, .. } => EventKind::PhaseBegin,\n+            EventData::Phase { begin: false, .. } => EventKind::PhaseEnd,\n+            EventData::TurnEnded { .. } => EventKind::TurnEnded,\n+            EventData::SkillToggled { .. } => EventKind::SkillToggled,\n+            EventData::Equipped { .. } => EventKind::Equipped,\n+            EventData::Linked { .. } => EventKind::Linked,\n+            EventData::CardsDiscarded { .. } => EventKind::CardsDiscarded,\n+            EventData::CardsLost { .. } => EventKind::CardsLost,\n+            EventData::ShaDodged { .. } => EventKind::ShaDodged,\n+            EventData::CardsGiven { .. } => EventKind::CardsGiven,\n+            EventData::TurnOverBefore { .. } => EventKind::TurnOverBefore,\n+            EventData::TurnOvered { .. } => EventKind::TurnOvered,\n+            EventData::LoseHp { .. } => EventKind::LoseHp,\n+            EventData::DyingSaved { .. } => EventKind::DyingSaved,\n+        }\n+    }\n+\n+    /// DamageBefore 与 Damage 共用 Damage 载荷。\n+    pub fn trigger_kind(&self, before: bool) -> EventKind {\n+        match self {\n+            EventData::Damage(_) if before => EventKind::DamageBefore,\n+            other => other.kind(),\n+        }\n+    }\n+}\n+\n+/// 回合阶段。\n+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]\n+pub enum Phase {\n+    Judge,\n+    Draw,\n+    Play,\n+    Discard,\n+    End,\n+}\n+\n+impl Phase {\n+    pub const ALL: [Phase; 5] = [\n+        Phase::Judge,\n+        Phase::Draw,\n+        Phase::Play,\n+        Phase::Discard,\n+        Phase::End,\n+    ];\n+\n+    pub fn next(self) -> Option<Phase> {\n+        Some(match self {\n+            Phase::Judge => Phase::Draw,\n+            Phase::Draw => Phase::Play,\n+            Phase::Play => Phase::Discard,\n+            Phase::Discard => Phase::End,\n+            Phase::End => return None,\n+        })\n+    }\n+\n+    pub fn name(&self) -> &'static str {\n+        match self {\n+            Phase::Judge => \"judge\",\n+            Phase::Draw => \"draw\",\n+            Phase::Play => \"play\",\n+            Phase::Discard => \"discard\",\n+            Phase::End => \"end\",\n+        }\n+    }\n+}\n+\n+/// 触发时机带（镜像非官方 first/normal/last 三段）。\n+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]\n+pub enum Timing {\n+    First,\n+    Normal,\n+    Last,\n+}\n+\n+/// 已入队待运行的触发项。\n+#[derive(Debug, Clone, PartialEq, Eq)]\n+pub struct QueuedTrigger {\n+    pub def: SkillDefId,\n+    pub owner: PlayerId,\n+    /// Canonical timing / effective priority / reserved zero / relative seat / definition.\n+    pub order: (u8, i32, u8, u8, u16),\n+}\n+\n+/// 帧所处的管线阶段。\n+#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n+pub enum Stage {\n+    /// 伤害前置触发窗口。\n+    BeforeTriggers,\n+    /// 内核提交动作（扣血/摸牌/移牌等）。\n+    Commit,\n+    /// 提交后触发窗口。\n+    AfterTriggers,\n+    /// 内核固有流程机器（濒死救援/出牌结算/弃牌选择等）。\n+    Intrinsic,\n+    /// 已完成，待弹栈。\n+    Done,\n+}\n+\n+/// 事件栈上的一帧。\n+#[derive(Debug, Clone, PartialEq, Eq)]\n+pub struct Frame {\n+    pub id: EventId,\n+    pub parent: Option<EventId>,\n+    pub kind: EventKind,\n+    pub data: EventData,\n+    pub stage: Stage,\n+    pub queue: Vec<QueuedTrigger>,\n+    /// 当前阶段的触发队列是否已收集。\n+    pub planned: bool,\n+    pub intrinsic_done: bool,\n+}\n+\n+impl Frame {\n+    pub fn damage(&self) -> &DamageData {\n+        match &self.data {\n+            EventData::Damage(d) => d,\n+            other => panic!(\"frame {:?} is not damage: {other:?}\", self.kind),\n+        }\n+    }\n+\n+    pub fn damage_mut(&mut self) -> &mut DamageData {\n+        match &mut self.data {\n+            EventData::Damage(d) => d,\n+            other => panic!(\"frame {other:?} is not damage\"),\n+        }\n+    }\n+\n+    /// TurnOverBefore 帧载荷可变访问（漩涡面具取消写回）。\n+    pub fn turn_over_before_mut(&mut self) -> (&mut PlayerId, &mut bool) {\n+        match &mut self.data {\n+            EventData::TurnOverBefore { player, cancelled } => (player, cancelled),\n+            other => panic!(\"frame {other:?} is not turn_over_before\"),\n+        }\n+    }\n+\n+    /// CardUsed 帧载荷可变访问（猴子偷桃取消写回）。\n+    pub fn card_use_mut(&mut self) -> &mut CardUseData {\n+        match &mut self.data {\n+            EventData::CardUsed(u) => u,\n+            other => panic!(\"frame {other:?} is not card_use\"),\n+        }\n+    }\n+\n+    /// CardUsed 帧载荷只读访问（同疾读目标；非 CardUsed 帧返回 None）。\n+    pub fn card_use(&self) -> Option<&CardUseData> {\n+        match &self.data {\n+            EventData::CardUsed(u) => Some(u),\n+            _ => None,\n+        }\n+    }\n+}"},{"sha":"64053a3bd7d16a1f11d04b33b25c6ece73319ea7","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20/baseline-changed/crates/engine-native-kernel/src/event/damage.rs","status":"added","additions":124,"deletions":0,"changes":124,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fevent%2Fdamage.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fevent%2Fdamage.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fevent%2Fdamage.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1,124 @@\n+//! Canonical damage quantity, submission receipt and sole continuation progress.\n+use super::*;\n+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]\n+pub enum DamageOutcome {\n+    #[default]\n+    Running,\n+    Cancelled,\n+    ReplacedByLoseHp,\n+    Zero,\n+    Completed,\n+}\n+#[derive(Debug, Clone, PartialEq, Eq, Default)]\n+pub enum DamageProgress {\n+    #[default]\n+    Before,\n+    HpCommitted,\n+    TargetDamage,\n+    DyingPending,\n+    DyingDone,\n+    Source,\n+    End,\n+    After,\n+    Chain {\n+        remaining: Vec<PlayerId>,\n+    },\n+    Done,\n+    ZeroPending,\n+    Stopped,\n+}\n+#[derive(Debug, Clone, PartialEq, Eq, Default)]\n+pub struct DamageSettlement {\n+    pub committed_damage: Option<u32>,\n+    pub hp_loss: u32,\n+    pub outcome: DamageOutcome,\n+    pub notrigger: bool,\n+    pub progress: DamageProgress,\n+}\n+#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n+pub enum DamageWindowKind {\n+    Source,\n+    End,\n+    After,\n+    Zero,\n+    Cancelled,\n+}\n+impl DamageWindowKind {\n+    pub fn event_kind(self) -> EventKind {\n+        match self {\n+            Self::Source => EventKind::DamageSource,\n+            Self::End => EventKind::DamageEnd,\n+            Self::After => EventKind::DamageAfter,\n+            Self::Zero => EventKind::DamageZero,\n+            Self::Cancelled => EventKind::DamageCancelled,\n+        }\n+    }\n+    pub fn tag(self) -> u8 {\n+        match self {\n+            Self::Source => 0,\n+            Self::End => 1,\n+            Self::After => 2,\n+            Self::Zero => 3,\n+            Self::Cancelled => 4,\n+        }\n+    }\n+    pub fn from_tag(tag: u8) -> Option<Self> {\n+        Some(match tag {\n+            0 => Self::Source,\n+            1 => Self::End,\n+            2 => Self::After,\n+            3 => Self::Zero,\n+            4 => Self::Cancelled,\n+            _ => return None,\n+        })\n+    }\n+}\n+impl DamageSettlement {\n+    pub fn canonical_bytes(&self) -> Vec<u8> {\n+        let mut out = b\"native-damage-settlement/1\".to_vec();\n+        out.push(u8::from(self.committed_damage.is_some()));\n+        out.extend_from_slice(&self.committed_damage.unwrap_or(0).to_le_bytes());\n+        out.extend_from_slice(&self.hp_loss.to_le_bytes());\n+        out.push(match self.outcome {\n+            DamageOutcome::Running => 0,\n+            DamageOutcome::Cancelled => 1,\n+            DamageOutcome::ReplacedByLoseHp => 2,\n+            DamageOutcome::Zero => 3,\n+            DamageOutcome::Completed => 4,\n+        });\n+        out.push(u8::from(self.notrigger));\n+        let (tag, remaining) = match &self.progress {\n+            DamageProgress::Before => (0, None),\n+            DamageProgress::HpCommitted => (1, None),\n+            DamageProgress::TargetDamage => (2, None),\n+            DamageProgress::DyingPending => (3, None),\n+            DamageProgress::DyingDone => (4, None),\n+            DamageProgress::Source => (5, None),\n+            DamageProgress::End => (6, None),\n+            DamageProgress::After => (7, None),\n+            DamageProgress::Chain { remaining } => (8, Some(remaining)),\n+            DamageProgress::Done => (9, None),\n+            DamageProgress::ZeroPending => (10, None),\n+            DamageProgress::Stopped => (11, None),\n+        };\n+        out.push(tag);\n+        if let Some(xs) = remaining {\n+            out.extend_from_slice(&(xs.len() as u32).to_le_bytes());\n+            out.extend_from_slice(xs);\n+        }\n+        out\n+    }\n+}\n+\n+/// A window carries only its checked ancestor identity; filters read the live canonical root.\n+pub fn damage_event<'a>(frames: &'a [Frame], frame: &'a Frame) -> &'a EventData {\n+    if let EventData::DamageWindow { root, .. } = frame.data {\n+        &frames\n+            .iter()\n+            .find(|f| f.id == root)\n+            .expect(\"checked damage ancestor\")\n+            .data\n+    } else {\n+        &frame.data\n+    }\n+}"},{"sha":"ddfffcae9975f2b1c735f94bd3d1ce7b6adf64f4","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20/baseline-changed/crates/engine-native-kernel/src/kernel.rs","status":"added","additions":85,"deletions":0,"changes":85,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fkernel.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fkernel.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fkernel.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1,85 @@\n+//! 内核固有机制：帧提交动作与内核流程机器。\n+//!\n+//! 原则：移动牌、扣血、摸牌、事件推进、濒死/死亡/出牌结算等**规则机制**\n+//! 归内核；具体技能的条件与流程归内容模块（`content`），两者通过同一套\n+//! 事件帧 + 机器接口协作。\n+\n+use crate::catalog::{CardKind, SkillMachine};\n+use crate::choice::{ChoiceKind, ChoiceOption, ChoiceSpec};\n+use crate::event::{EventData, Phase};\n+use crate::ids::EventId;\n+use crate::ids::PlayerId;\n+use crate::machine::{damage_data, damage_data_with, Ctx, Flow, LogEvent};\n+\n+/// 帧提交阶段的一次性内核动作。\n+pub fn commit_frame(ctx: &mut Ctx<'_>, frame_id: EventId) {\n+    let (kind, data) = {\n+        let f = ctx.res.frame(frame_id).expect(\"commit frame\");\n+        (f.kind, f.data.clone())\n+    };\n+    record_vm_history(ctx, &data);\n+    match data {\n+        EventData::Damage(d) => { if d.settlement.committed_damage.is_none() { commit_damage(ctx, frame_id, d); } },\n+        EventData::DamageWindow { root, window: crate::event::DamageWindowKind::End } => {\n+            let d=ctx.res.frame(root).expect(\"damage root\").damage().clone();\n+            if d.amount>0 && !d.prevented && !d.settlement.notrigger {post_damage(ctx,d);}\n+        },\n+        EventData::LoseHp { player, amount } => commit_lose_hp(ctx, player, amount),\n+        EventData::CardUsed(u) => commit_card_used(ctx, u),\n+        EventData::Equipped { player, card, .. } => commit_equip(ctx, frame_id, player, card),\n+        EventData::Linked { player, .. } => commit_linked(ctx, frame_id, player),\n+        EventData::Phase {\n+            player,\n+            phase,\n+            begin,\n+        } => commit_phase(ctx, player, phase, begin),\n+        EventData::TurnEnded { player } => commit_turn_ended(ctx, player),\n+        EventData::TurnOverBefore { player, cancelled } => {\n+            commit_turn_over_before(ctx, player, cancelled)\n+        }\n+        EventData::CardsDiscarded { player, .. } => commit_cards_discarded(ctx, player),\n+        EventData::CardsMoved { to, .. } => commit_cards_moved(ctx, to),\n+        EventData::Recover { player, .. } => commit_recover_skills(ctx, player),\n+        // CardsDrawn/Recover/CardsMoved 等在构造时已由助手完成区移动作。\n+        _ => {\n+            let _ = kind;\n+        }\n+    }\n+}\n+\n+mod damage;\n+mod damage_flow;\n+pub use damage_flow::DamageFlow;\n+use damage::*;\n+mod events;\n+use events::*;\n+mod equipment;\n+pub use equipment::{grant_equip_skills, revoke_equip_skills};\n+use equipment::commit_equip;\n+mod intrinsic;\n+pub use intrinsic::*;\n+mod combat_rules;\n+pub(crate) use combat_rules::*;\n+pub use combat_rules::tao_futai2_banned;\n+mod sha;\n+pub use sha::*;\n+mod dying;\n+pub use dying::*;\n+mod duel;\n+pub use duel::*;\n+mod tricks;\n+pub use tricks::*;\n+mod nullify;\n+pub use nullify::*;\n+mod judge;\n+pub use judge::*;\n+mod aoe;\n+pub use aoe::*;\n+mod discard;\n+pub use discard::*;\n+mod death;\n+pub use death::*;\n+mod monkey;\n+pub use monkey::*;\n+mod phase;\n+use phase::*;"},{"sha":"a4877dc07745c7370d3305b788e3c54edbb3d4cc","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20/baseline-changed/crates/engine-native-kernel/src/kernel/damage.rs","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fkernel%2Fdamage.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fkernel%2Fdamage.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fkernel%2Fdamage.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8"},{"sha":"e69de29bb2d1d6434b8b29ae775ad8c2e48c5391","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20/baseline-changed/crates/engine-native-kernel/src/kernel/damage_after.rs","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fkernel%2Fdamage_after.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fkernel%2Fdamage_after.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fkernel%2Fdamage_after.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8"},{"sha":"e69de29bb2d1d6434b8b29ae775ad8c2e48c5391","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20/baseline-changed/crates/engine-native-kernel/src/kernel/damage_change_hp.rs","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fkernel%2Fdamage_change_hp.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fkernel%2Fdamage_change_hp.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fkernel%2Fdamage_change_hp.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8"},{"sha":"07a94cb13bc9ae4c078b43971d433efa4d26619b","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20/baseline-changed/crates/engine-native-kernel/src/kernel/damage_flow.rs","status":"added","additions":145,"deletions":0,"changes":145,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fkernel%2Fdamage_flow.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fkernel%2Fdamage_flow.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fkernel%2Fdamage_flow.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8"},{"sha":"e69de29bb2d1d6434b8b29ae775ad8c2e48c5391","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20/baseline-changed/crates/engine-native-kernel/src/kernel/damage_windows.rs","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fkernel%2Fdamage_windows.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fkernel%2Fdamage_windows.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/docs%2Foperations%2Fevidence%2F2026-10-31-c331-phase9b-prehp%2Foriginal%2Fcheckpoint20%2Fbaseline-changed%2Fcrates%2Fengine-native-kernel%2Fsrc%2Fkernel%2Fdamage_windows.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8"},{"sha":"2eb80a6b4a462c218cabccbb1e400c826a74cd79","filename":"docs/operations/evidence/2026-10-31-c331-phase9b-prehp/original/checkpoint20/baseline-changed/crates/engine-native-kernel/src/machine.rs","status":