{"sha":"34e83f0550bb70ef4af6083697428de7be2f02f8","node_id":"C_kwDOS6pZOtoAKDM0ZTgzZjA1NTBiYjcwZWY0YWY2MDgzNjk3NDI4ZGU3YmUyZjAyZjg","commit":{"author":{"name":"ruyimg","email":"2689302609@qq.com","date":"2026-10-31T14:50:26Z"},"committer":{"name":"ruyimg","email":"2689302609@qq.com","date":"2026-10-31T15:14:33Z"},"message":"feat(i02): validate optional presentation metadata before ingress\n\nAdd the reviewed typed DTO and omission-compatible server/client wire foundation. Validate metadata before settlement and bound retained network intents to eight, including Unicode and compound-invalid ingress cases.\n\nApply command-local Windows longpaths settings to the two checkout matrices. Preserve d07's actual 8/2 CI failure, source-bound Main acceptance, additive provenance correction, and blocked private Damage results.\n\nCorrect the publication set after the initial unpublished leaf accidentally tracked a dedicated test browser profile. The withdrawn leaf is retained by a local protective ref; all profile/schema/product originals remain local and excluded. Published d07 ancestry remains intact.\n\nEvidence: docs/operations/evidence/2026-10-31-i02-main-typed-wire/\nScope: consumer foundation only; production constructors remain None. Rules330/NGSA105/ABI758/WS6 and desktop WASM default are unchanged.","tree":{"sha":"22e6eab72d104baf7a658d5ff2d832128ac32e4a","url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/git/trees/22e6eab72d104baf7a658d5ff2d832128ac32e4a"},"url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/git/commits/34e83f0550bb70ef4af6083697428de7be2f02f8","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/commits/34e83f0550bb70ef4af6083697428de7be2f02f8","html_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/commit/34e83f0550bb70ef4af6083697428de7be2f02f8","comments_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/commits/34e83f0550bb70ef4af6083697428de7be2f02f8/comments","author":{"login":"RuyimgByCN","id":45452808,"node_id":"MDQ6VXNlcjQ1NDUyODA4","avatar_url":"https://avatars.githubusercontent.com/u/45452808?v=4","gravatar_id":"","url":"https://api.github.com/users/RuyimgByCN","html_url":"https://github.com/RuyimgByCN","followers_url":"https://api.github.com/users/RuyimgByCN/followers","following_url":"https://api.github.com/users/RuyimgByCN/following{/other_user}","gists_url":"https://api.github.com/users/RuyimgByCN/gists{/gist_id}","starred_url":"https://api.github.com/users/RuyimgByCN/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/RuyimgByCN/subscriptions","organizations_url":"https://api.github.com/users/RuyimgByCN/orgs","repos_url":"https://api.github.com/users/RuyimgByCN/repos","events_url":"https://api.github.com/users/RuyimgByCN/events{/privacy}","received_events_url":"https://api.github.com/users/RuyimgByCN/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"RuyimgByCN","id":45452808,"node_id":"MDQ6VXNlcjQ1NDUyODA4","avatar_url":"https://avatars.githubusercontent.com/u/45452808?v=4","gravatar_id":"","url":"https://api.github.com/users/RuyimgByCN","html_url":"https://github.com/RuyimgByCN","followers_url":"https://api.github.com/users/RuyimgByCN/followers","following_url":"https://api.github.com/users/RuyimgByCN/following{/other_user}","gists_url":"https://api.github.com/users/RuyimgByCN/gists{/gist_id}","starred_url":"https://api.github.com/users/RuyimgByCN/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/RuyimgByCN/subscriptions","organizations_url":"https://api.github.com/users/RuyimgByCN/orgs","repos_url":"https://api.github.com/users/RuyimgByCN/repos","events_url":"https://api.github.com/users/RuyimgByCN/events{/privacy}","received_events_url":"https://api.github.com/users/RuyimgByCN/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"d07b35f94a42b282222dda4ab7bbc5c39ab8fddb","url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/commits/d07b35f94a42b282222dda4ab7bbc5c39ab8fddb","html_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/commit/d07b35f94a42b282222dda4ab7bbc5c39ab8fddb"}],"stats":{"total":1103798,"additions":1103773,"deletions":25},"files":[{"sha":"0cfcbb9ccfba57ea0d5d7e756e1a8c6ce40143be","filename":".github/workflows/ci.yml","status":"modified","additions":10,"deletions":0,"changes":10,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/.github%2Fworkflows%2Fci.yml","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/.github%2Fworkflows%2Fci.yml","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/.github%2Fworkflows%2Fci.yml?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -27,6 +27,11 @@ jobs:\n     runs-on: ${{ matrix.os }}\n     steps:\n       - uses: actions/checkout@v4\n+        # Windows Git needs long-path support before checking out deep evidence paths.\n+        env:\n+          GIT_CONFIG_COUNT: ${{ runner.os == 'Windows' && '1' || '0' }}\n+          GIT_CONFIG_KEY_0: core.longpaths\n+          GIT_CONFIG_VALUE_0: \"true\"\n         with:\n           path: noname-next\n       - uses: dtolnay/rust-toolchain@stable\n@@ -140,6 +145,11 @@ jobs:\n     runs-on: ${{ matrix.os }}\n     steps:\n       - uses: actions/checkout@v4\n+        # Windows Git needs long-path support before checking out deep evidence paths.\n+        env:\n+          GIT_CONFIG_COUNT: ${{ runner.os == 'Windows' && '1' || '0' }}\n+          GIT_CONFIG_KEY_0: core.longpaths\n+          GIT_CONFIG_VALUE_0: \"true\"\n         with:\n           path: noname-next\n       - uses: dtolnay/rust-toolchain@stable"},{"sha":"806c56c4e8f3996d00a3092d6c9120207372c146","filename":"apps/game-server/src/room.rs","status":"modified","additions":4,"deletions":0,"changes":4,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/apps%2Fgame-server%2Fsrc%2Froom.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/apps%2Fgame-server%2Fsrc%2Froom.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/apps%2Fgame-server%2Fsrc%2Froom.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -395,6 +395,7 @@ async fn room_loop(\n                             legal_actions: legal_for(&engine, member.role, member.player_id),\n                             choice: choice_for(&engine, member.role, member.player_id),\n                             public_event_codes: vec![],\n+                            presentation: None,\n                         };\n                         let _ = reply.send(Ok(msg));\n                         continue;\n@@ -448,6 +449,7 @@ async fn room_loop(\n                             legal_actions: legal_for(&engine, member.role, member.player_id),\n                             choice,\n                             public_event_codes: public_codes(engine.last_events()),\n+                            presentation: None,\n                         }));\n                     }\n                     CommandResult::Rejected { .. } => {\n@@ -465,6 +467,7 @@ async fn room_loop(\n                             legal_actions: legal_for(&engine, member.role, member.player_id),\n                             choice: choice_for(&engine, member.role, member.player_id),\n                             public_event_codes: vec![],\n+                            presentation: None,\n                         }));\n                     }\n                 }\n@@ -604,6 +607,7 @@ async fn fanout_after_command(\n             legal_actions: legal_for(engine, m.role, m.player_id),\n             choice,\n             public_event_codes: public_codes(engine.last_events()),\n+            presentation: None,\n         };\n         let _ = out.send(&msg).await;\n     }"},{"sha":"40dd0c65963fbc7b19433ced445fc8ffb2bd48d8","filename":"apps/game-server/src/room_native_actor.rs","status":"modified","additions":4,"deletions":0,"changes":4,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/apps%2Fgame-server%2Fsrc%2Froom_native_actor.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/apps%2Fgame-server%2Fsrc%2Froom_native_actor.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/apps%2Fgame-server%2Fsrc%2Froom_native_actor.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -79,6 +79,7 @@ fn legacy_replay_rejection(\n         legal_actions: legal_actions_for(session.engine(), player_id),\n         choice: session.choice_for(RoomRole::Player, Some(player_id)),\n         public_event_codes: vec![],\n+        presentation: None,\n     })\n }\n \n@@ -479,6 +480,7 @@ async fn native_room_loop(\n                             legal_actions: legal_actions_for(session.engine(), m.player_id),\n                             choice: session.choice_for(m.role.into(), Some(m.player_id)),\n                             public_event_codes: vec![],\n+                            presentation: None,\n                         }));\n                         continue;\n                     }\n@@ -568,6 +570,7 @@ async fn native_room_loop(\n                     legal_actions: legal,\n                     choice,\n                     public_event_codes: public_event_codes.clone(),\n+                    presentation: None,\n                 }));\n                 // 命令后**个性化推送**：其余成员各收自己的视图/动作/选择（提交者走 oneshot）。\n                 // 发送必须有界：慢客户端的队列满时立即标记/移出广播，绝不 await。\n@@ -601,6 +604,7 @@ async fn native_room_loop(\n                         },\n                         choice: session.choice_for(role, seat),\n                         public_event_codes: public_event_codes.clone(),\n+                        presentation: None,\n                     };\n                     if out.try_send(&msg) == SendStatus::Full {\n                         stalled.push(other.connection_id);"},{"sha":"9e087594155ad171ce36213e3f5f4c860a74dc9b","filename":"apps/game-server/src/room_native_actor/timeout.rs","status":"modified","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/apps%2Fgame-server%2Fsrc%2Froom_native_actor%2Ftimeout.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/apps%2Fgame-server%2Fsrc%2Froom_native_actor%2Ftimeout.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/apps%2Fgame-server%2Fsrc%2Froom_native_actor%2Ftimeout.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -36,6 +36,7 @@ pub(super) async fn automatic_step(\n                         .map(|p| legal_actions_for(session.engine(), p))\n                         .unwrap_or_default(),\n                     public_event_codes: public_event_codes.clone(),\n+                    presentation: None,\n                 };\n                 if out.try_send(&message) == SendStatus::Full {\n                     stalled.push(member.connection_id);"},{"sha":"4ce3cf7abf83f454b6d953cfa99f775a8f6438d4","filename":"apps/web-client/scripts/fixtures/i02-main5fc/desktopEngineTransport.ts","status":"added","additions":97,"deletions":0,"changes":97,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/apps%2Fweb-client%2Fscripts%2Ffixtures%2Fi02-main5fc%2FdesktopEngineTransport.ts","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/apps%2Fweb-client%2Fscripts%2Ffixtures%2Fi02-main5fc%2FdesktopEngineTransport.ts","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/apps%2Fweb-client%2Fscripts%2Ffixtures%2Fi02-main5fc%2FdesktopEngineTransport.ts?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1,97 @@\n+import { invoke } from \"@tauri-apps/api/core\";\n+import { urlParam } from \"./autoDrive\";\n+import { validateObserverMetadata } from \"./observerMetadata\";\n+import { normalizeNativeOutcome } from \"./nativeOutcome\";\n+import type { ChooseGeneralPayload, EngineEnvelope, WorkerRequest, WorkerResponse } from \"../types/engine\";\n+\n+/** The messaging seam shared by a Worker and the desktop IPC adapter. */\n+export interface EngineTransport {\n+  onmessage: ((event: MessageEvent<WorkerResponse>) => void) | null;\n+  onerror: ((event: ErrorEvent) => void) | null;\n+  postMessage(request: WorkerRequest): void;\n+  terminate(): void;\n+  addEventListener(type: \"messageerror\", listener: () => void): void;\n+}\n+\n+type Invoke = <T>(command: string, args?: Record<string, unknown>) => Promise<T>;\n+export const DESKTOP_ENGINE_KEY = \"noname-next-desktop-engine\";\n+export type DesktopEngineChoice = \"wasm\" | \"native\";\n+// Match the native queue capacity, conservatively including active/opening requests.\n+const MAX_DESKTOP_OUTSTANDING = 8;\n+\n+/** Wasm stays the default until all six PA09 conditions have evidence. */\n+export function desktopEngineChoice(): DesktopEngineChoice {\n+  const override = typeof location === \"undefined\" ? null : urlParam(\"engineTransport\");\n+  if (override === \"native\" || override === \"wasm\") return override;\n+  try { return localStorage.getItem(DESKTOP_ENGINE_KEY) === \"native\" ? \"native\" : \"wasm\"; }\n+  catch { return \"wasm\"; }\n+}\n+\n+function normalizeEnvelope(envelope: EngineEnvelope): EngineEnvelope {\n+  validateObserverMetadata(envelope.view, envelope.choice);\n+  return { ...envelope, view: { ...envelope.view, outcome: normalizeNativeOutcome(envelope.view.outcome) } };\n+}\n+\n+/** Normalize only the two existing local response locations; network envelopes never enter here. */\n+function normalizeResponse(response: WorkerResponse, request: WorkerRequest): WorkerResponse {\n+  if (!response.ok || !response.data || typeof response.data !== \"object\") return response;\n+  if (request.type === \"chooseGeneral\") {\n+    const data = response.data as ChooseGeneralPayload;\n+    if (data.envelope?.view) return { ...response, data: { ...data, envelope: normalizeEnvelope(data.envelope) } };\n+  } else {\n+    const data = response.data as EngineEnvelope;\n+    if (data.view) return { ...response, data: normalizeEnvelope(data) };\n+  }\n+  return response;\n+}\n+\n+/** Serial invoke calls carry the same WorkerRequest/WorkerResponse, including controlled errors. */\n+export class DesktopEngineTransport implements EngineTransport {\n+  onmessage: EngineTransport[\"onmessage\"] = null;\n+  onerror: EngineTransport[\"onerror\"] = null;\n+  private closed = false;\n+  private outstanding = 0;\n+  private tail: Promise<void> = Promise.resolve();\n+  private resource: Promise<number> | null = null;\n+\n+  constructor(private call: Invoke = invoke) {}\n+\n+  postMessage(request: WorkerRequest): void {\n+    if (this.closed) throw new Error(\"Desktop engine transport closed\");\n+    if (this.outstanding >= MAX_DESKTOP_OUTSTANDING) {\n+      throw new Error(\"Desktop engine busy; request was not submitted（未提交）\");\n+    }\n+    this.outstanding++;\n+    this.tail = this.tail.then(async () => {\n+      try {\n+        if (this.closed) return;\n+        let response: WorkerResponse;\n+        try {\n+          this.resource ??= this.call<number>(\"native_engine_open\");\n+          const resourceId = await this.resource;\n+          if (this.closed) return;\n+          response = await this.call<WorkerResponse>(\"native_engine_request\", { resourceId, request });\n+          response = normalizeResponse(response, request);\n+          if (response.id !== request.id || typeof response.ok !== \"boolean\") {\n+            throw new Error(\"invalid IPC response\");\n+          }\n+        } catch (error) {\n+          response = { id: request.id, ok: false, error: `Desktop IPC: ${String(error)}; 操作结果可能未知，请先确认当前局面` };\n+        }\n+        if (!this.closed) this.onmessage?.({ data: response } as MessageEvent<WorkerResponse>);\n+      } finally {\n+        if (!this.closed) this.outstanding--;\n+      }\n+    }).catch((error) => console.error(\"Desktop engine response listener failed\", error));\n+  }\n+\n+  terminate(): void {\n+    if (this.closed) return;\n+    this.closed = true;\n+    this.outstanding = 0;\n+    void this.resource?.then((resourceId) => this.call(\"native_engine_close\", { resourceId }))\n+      .catch((error) => console.error(\"Desktop engine resource close failed\", error));\n+  }\n+  // invoke returns structured JSON; decoding failures reject its promise.\n+  addEventListener(_type: \"messageerror\", _listener: () => void): void {}\n+}"},{"sha":"f1867b3104c8669db46c54e8354564c45a137195","filename":"apps/web-client/scripts/fixtures/i02-main5fc/networkClient.ts","status":"added","additions":815,"deletions":0,"changes":815,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/apps%2Fweb-client%2Fscripts%2Ffixtures%2Fi02-main5fc%2FnetworkClient.ts","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/apps%2Fweb-client%2Fscripts%2Ffixtures%2Fi02-main5fc%2FnetworkClient.ts","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/apps%2Fweb-client%2Fscripts%2Ffixtures%2Fi02-main5fc%2FnetworkClient.ts?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1,815 @@\n+import { validateObserverMetadata } from \"./observerMetadata\";\n+import { publicEventLabel } from \"./publicEvents\";\n+import type {\n+  ChoiceRequest,\n+  EngineEnvelope,\n+  LegalAction,\n+  ObserverSnapshot,\n+} from \"../types/engine\";\n+\n+const NETWORK_PROTOCOL_VERSION = 6;\n+\n+type CommandKind =\n+  | \"EndPhase\"\n+  | \"Surrender\"\n+  | { PlayCard: { card: number; targets: number[]; card_targets: number[] } }\n+  | { ActivateSkill: { skill: number; targets: number[]; card_targets: number[] } }\n+  | {\n+      UseSkillCard: {\n+        skill: number;\n+        card_kind: number;\n+        targets: number[];\n+        equip_slot: number;\n+      };\n+    }\n+  | {\n+      ResolveChoice: {\n+        choice_id: number;\n+        selections: number[];\n+        cancelled: boolean;\n+      };\n+    };\n+\n+interface MessageHeader {\n+  protocol_version: number;\n+  room_id: number;\n+  conn_seq: number;\n+  revision: number;\n+}\n+\n+export interface RoomRoster {\n+  room_id: number;\n+  seats: {\n+    seat: number;\n+    player_id: number;\n+    display_name: string;\n+    connected: boolean;\n+    managed: boolean;\n+  }[];\n+  choice_timeout_secs: number | null;\n+  started: boolean;\n+  finished: boolean;\n+}\n+\n+const PENDING_STORAGE_KEY = \"noname-next.pending-command\";\n+/** 刷新后仍重放 pending 的最长时间；过期视为陈旧意图，避免隔天误重放。 */\n+const PENDING_TTL_MS = 10 * 60 * 1000;\n+\n+type PersistedPending = {\n+  roomId: number;\n+  key: number;\n+  kind: CommandKind;\n+  createdAt: number;\n+};\n+\n+function loadPersistedPending(): PersistedPending | null {\n+  try {\n+    if (typeof sessionStorage === \"undefined\") return null;\n+    const raw = sessionStorage.getItem(PENDING_STORAGE_KEY);\n+    if (!raw) return null;\n+    const parsed = JSON.parse(raw) as Partial<PersistedPending>;\n+    if (\n+      !parsed ||\n+      typeof parsed.roomId !== \"number\" ||\n+      typeof parsed.key !== \"number\" ||\n+      typeof parsed.createdAt !== \"number\" ||\n+      !parsed.kind\n+    ) {\n+      return null;\n+    }\n+    if (Date.now() - parsed.createdAt > PENDING_TTL_MS) return null;\n+    return {\n+      roomId: parsed.roomId,\n+      key: parsed.key,\n+      kind: parsed.kind as CommandKind,\n+      createdAt: parsed.createdAt,\n+    };\n+  } catch {\n+    return null;\n+  }\n+}\n+\n+function storePending(kind: CommandKind, key: number, roomId: number): void {\n+  try {\n+    if (typeof sessionStorage === \"undefined\" || !roomId) return;\n+    sessionStorage.setItem(\n+      PENDING_STORAGE_KEY,\n+      JSON.stringify({ roomId, key, kind, createdAt: Date.now() }),\n+    );\n+  } catch {\n+    /* 存储不可用时保持原有同实例重连语义 */\n+  }\n+}\n+\n+function clearPendingStorage(key: number): void {\n+  try {\n+    if (typeof sessionStorage === \"undefined\") return;\n+    const raw = sessionStorage.getItem(PENDING_STORAGE_KEY);\n+    if (!raw) return;\n+    const parsed = JSON.parse(raw) as Partial<PersistedPending>;\n+    if (parsed.key === key) sessionStorage.removeItem(PENDING_STORAGE_KEY);\n+  } catch {\n+    /* ignore */\n+  }\n+}\n+\n+export interface OnlineSession {\n+  roomId: number;\n+  playerId: number;\n+  seat: number;\n+  role: \"Player\" | \"Spectator\" | \"Referee\";\n+  reconnectToken: string;\n+  view: ObserverSnapshot;\n+  envelope: EngineEnvelope;\n+}\n+\n+type PendingCommand = {\n+  /** 原命令内容；重连后必须用**同一 key 与同一命令**重放，不能换 key 重做。 */\n+  kind: CommandKind;\n+  key: number;\n+  resolve: (value: EngineEnvelope) => void;\n+  reject: (reason: Error) => void;\n+};\n+\n+type JoinWaiter = {\n+  resolve: (value: OnlineSession) => void;\n+  reject: (reason: Error) => void;\n+};\n+\n+/**\n+ * Browser transport for the authoritative game-server WebSocket protocol.\n+ * It only submits normalized commands and consumes observer projections.\n+ */\n+export class NetworkEngineClient {\n+  private socket: WebSocket | null = null;\n+  private connectionId = 0;\n+  private roomId = 0;\n+  private playerId = 0;\n+  private revision = 0;\n+  private connSeq = 0;\n+  private idemSeq = 1;\n+  private choice: ChoiceRequest | null = null;\n+  private session: OnlineSession | null = null;\n+  private roomPassword = \"\";\n+  private welcomeWaiter: { resolve: () => void; reject: (e: Error) => void } | null = null;\n+  private joinWaiter: JoinWaiter | null = null;\n+  private pending = new Map<number, PendingCommand>();\n+  private persistedPending: PersistedPending | null = loadPersistedPending();\n+  private snapshotWaiters = new Map<\n+    number,\n+    { resolve: (view: ObserverSnapshot) => void; reject: (e: Error) => void }\n+  >();\n+  private envelopeListeners = new Set<(envelope: EngineEnvelope) => void>();\n+  private rosterListeners = new Set<(roster: RoomRoster) => void>();\n+  private closeListeners = new Set<() => void>();\n+  private heartbeat: number | null = null;\n+  private clockProbe: { connSeq: number; roomId: number; sentAt: number } | null = null;\n+  private serverTimeAnchor: { unixMs: number; monotonicMs: number } | null = null;\n+  private disposed = false;\n+  /// NC09 自动重连：最近一次连接参数（断开后按退避重试）\n+  private lastUrl: string | null = null;\n+  private lastName = \"\";\n+  private reconnectTimer: number | null = null;\n+  private reconnectAttempts = 0;\n+  private reconnectListeners = new Set<(state: \"reconnecting\" | \"reconnected\" | \"failed\") => void>();\n+\n+  async connect(url: string, displayName: string): Promise<void> {\n+    if (this.socket?.readyState === WebSocket.OPEN) return;\n+    this.disposed = false;\n+    this.clockProbe = null;\n+    this.serverTimeAnchor = null;\n+    this.lastUrl = url;\n+    this.lastName = displayName;\n+\n+    const welcome = new Promise<void>((resolve, reject) => {\n+      this.welcomeWaiter = { resolve, reject };\n+    });\n+    const opened = new Promise<void>((resolve, reject) => {\n+      const socket = new WebSocket(normalizeWsUrl(url));\n+      this.socket = socket;\n+      socket.onopen = () => {\n+        if (this.socket !== socket) {\n+          reject(new Error(\"WebSocket 连接已替换\"));\n+          return;\n+        }\n+        this.connSeq = 0;\n+        this.idemSeq = 1;\n+        resolve();\n+      };\n+      socket.onerror = () => reject(new Error(\"WebSocket 连接失败\"));\n+      socket.onmessage = (event) => {\n+        if (this.socket === socket) this.handleMessage(String(event.data));\n+      };\n+      socket.onclose = () => {\n+        reject(new Error(\"WebSocket 连接已关闭\"));\n+        if (this.socket === socket) this.handleClose();\n+      };\n+    });\n+\n+    // NC09：`opened` 失败时 `welcome` 仍会在稍后 reject——必须预先挂一个 no-op catch，\n+    // 否则控制台出现 `Uncaught (in promise)`（UI 已显示「WebSocket 连接失败」但仍有未处理拒绝）。\n+    void welcome.catch(() => undefined);\n+    await opened;\n+    await welcome;\n+    this.send({\n+      type: \"Hello\",\n+      payload: {\n+        versions: {\n+          engine_api: 1,\n+          rule_vm_abi: 167,\n+          content_schema: 3,\n+          network_protocol: NETWORK_PROTOCOL_VERSION,\n+          replay_schema: 1,\n+          snapshot_schema: 1,\n+          package_format: 1,\n+          engine_build_id: \"noname-next-web\",\n+        },\n+        display_name: displayName,\n+      },\n+    });\n+    this.sendHeartbeat();\n+  }\n+\n+  /** Display estimate only; server deadlines remain authoritative. */\n+  secondsUntilServerDeadline(deadline: number | undefined): number | null {\n+    if (deadline == null || !this.serverTimeAnchor) return null;\n+    const elapsed = performance.now() - this.serverTimeAnchor.monotonicMs;\n+    return Math.max(0, Math.ceil((deadline - this.serverTimeAnchor.unixMs - elapsed) / 1000));\n+  }\n+\n+  createRoom(players: number, seed: number, password = \"\", choiceTimeoutSecs = 30): Promise<OnlineSession> {\n+    return this.joinRequest({ type: \"CreateRoom\", payload: { players, seed, password, choice_timeout_secs: choiceTimeoutSecs } }, password);\n+  }\n+\n+  joinRoom(\n+    roomId: number,\n+    password = \"\",\n+    reconnectToken: string | null = null\n+  ): Promise<OnlineSession> {\n+    this.roomId = roomId;\n+    return this.joinRequest({\n+      type: \"JoinRoom\",\n+      payload: {\n+        room_id: roomId,\n+        password,\n+        preferred_seat: null,\n+        reconnect_token: reconnectToken,\n+      },\n+    }, password);\n+  }\n+\n+  spectate(roomId: number): Promise<OnlineSession> {\n+    this.roomId = roomId;\n+    return this.joinRequest({ type: \"Spectate\", payload: { room_id: roomId } }, \"\");\n+  }\n+\n+  rejoinRoom(): Promise<OnlineSession> {\n+    const session = this.session;\n+    if (!session) return Promise.reject(new Error(\"尚未加入房间\"));\n+    return session.role === \"Spectator\"\n+      ? this.spectate(session.roomId)\n+      : this.joinRoom(session.roomId, this.roomPassword, session.reconnectToken);\n+  }\n+\n+  onEnvelope(listener: (envelope: EngineEnvelope) => void): () => void {\n+    this.envelopeListeners.add(listener);\n+    return () => this.envelopeListeners.delete(listener);\n+  }\n+\n+  /// 断线通知（NC09）：注册后返回取消函数。\n+  onClose(listener: () => void): () => void {\n+    this.closeListeners.add(listener);\n+    return () => this.closeListeners.delete(listener);\n+  }\n+\n+  onRoster(listener: (roster: RoomRoster) => void): () => void {\n+    this.rosterListeners.add(listener);\n+    return () => this.rosterListeners.delete(listener);\n+  }\n+\n+  /// 取消所有尚未确认的命令（UI 取消入口）：拒绝等待者并清除刷新持久化，\n+  /// 避免下一次入房继续重放。服务端是否已提交需另行查询/接受不确定语义。\n+  cancelPendingCommands(reason = \"已取消待确认命令\"): void {\n+    for (const pending of this.pending.values()) {\n+      clearPendingStorage(pending.key);\n+      pending.reject(new Error(reason));\n+    }\n+    this.pending.clear();\n+    if (this.persistedPending) {\n+      clearPendingStorage(this.persistedPending.key);\n+      this.persistedPending = null;\n+    }\n+  }\n+\n+  endPhase(_actor = 0): Promise<EngineEnvelope> {\n+    return this.submit(\"EndPhase\");\n+  }\n+\n+  playCard(\n+    _actor: number,\n+    card: number,\n+    targets: number[]\n+  ): Promise<EngineEnvelope> {\n+    return this.submit({ PlayCard: { card, targets, card_targets: [] } });\n+  }\n+\n+  activateSkill(\n+    _actor: number,\n+    skill: number,\n+    targets: number[],\n+    cardTargets: number[]\n+  ): Promise<EngineEnvelope> {\n+    return this.submit({\n+      ActivateSkill: { skill, targets, card_targets: cardTargets },\n+    });\n+  }\n+\n+  useSkillCard(\n+    _actor: number,\n+    skill: number,\n+    cardKind: number,\n+    targets: number[],\n+    equipSlot: number\n+  ): Promise<EngineEnvelope> {\n+    return this.submit({\n+      UseSkillCard: {\n+        skill,\n+        card_kind: cardKind,\n+        targets,\n+        equip_slot: equipSlot,\n+      },\n+    });\n+  }\n+\n+  resolveChoice(\n+    _actor: number,\n+    choiceId: number,\n+    selections: number[],\n+    cancelled = false\n+  ): Promise<EngineEnvelope> {\n+    return this.submit({\n+      ResolveChoice: {\n+        choice_id: choiceId,\n+        selections,\n+        cancelled,\n+      },\n+    });\n+  }\n+\n+  surrender(): Promise<EngineEnvelope> {\n+    return this.submit(\"Surrender\");\n+  }\n+\n+  requestSnapshot(): Promise<ObserverSnapshot> {\n+    const header = this.nextHeader();\n+    return new Promise<ObserverSnapshot>((resolve, reject) => {\n+      this.snapshotWaiters.set(header.conn_seq, { resolve, reject });\n+      try {\n+        this.send({\n+          type: \"RequestSnapshot\",\n+          payload: { header, last_revision: this.revision },\n+        });\n+      } catch (error) {\n+        this.snapshotWaiters.delete(header.conn_seq);\n+        reject(error);\n+      }\n+    });\n+  }\n+\n+  dispose(): void {\n+    this.disposed = true;\n+    if (this.reconnectTimer != null) {\n+      window.clearTimeout(this.reconnectTimer);\n+      this.reconnectTimer = null;\n+    }\n+    this.reconnectAttempts = 0;\n+    if (this.heartbeat != null && typeof window !== \"undefined\") {\n+      window.clearInterval(this.heartbeat);\n+    }\n+    this.heartbeat = null;\n+    this.clockProbe = null;\n+    this.serverTimeAnchor = null;\n+    const socket = this.socket;\n+    this.socket = null;\n+    socket?.close(1000, \"client dispose\");\n+    this.session = null;\n+    this.roomPassword = \"\";\n+    this.playerId = 0;\n+    this.rejectOutstanding(new Error(\"连接已关闭\"));\n+    this.envelopeListeners.clear();\n+    this.rosterListeners.clear();\n+    this.closeListeners.clear();\n+    this.reconnectListeners.clear();\n+  }\n+\n+  private async joinRequest(message: unknown, password: string): Promise<OnlineSession> {\n+    const joined = this.waitForJoin();\n+    try {\n+      this.send(message);\n+      this.roomPassword = password;\n+    } catch (error) {\n+      this.joinWaiter?.reject(error instanceof Error ? error : new Error(String(error)));\n+      this.joinWaiter = null;\n+    }\n+    return joined;\n+  }\n+\n+  private waitForJoin(): Promise<OnlineSession> {\n+    if (this.joinWaiter) throw new Error(\"已有入房请求\");\n+    return new Promise((resolve, reject) => {\n+      this.joinWaiter = { resolve, reject };\n+    });\n+  }\n+\n+  private submit(kind: CommandKind): Promise<EngineEnvelope> {\n+    if (!this.roomId || !this.playerId) {\n+      return Promise.reject(new Error(\"当前不是已入座玩家\"));\n+    }\n+    const key = this.connectionId * 1_000_000 + this.idemSeq++;\n+    let intent!: PendingCommand;\n+    const promise = new Promise<EngineEnvelope>((resolve, reject) => {\n+      intent = { kind, key, resolve, reject };\n+      this.pending.set(key, intent);\n+    });\n+    try {\n+      this.sendSubmit(intent);\n+      this.persistedPending = { roomId: this.roomId, key, kind, createdAt: Date.now() };\n+      storePending(kind, key, this.roomId);\n+    } catch (error) {\n+      this.pending.delete(key);\n+      clearPendingStorage(key);\n+      return Promise.reject(error);\n+    }\n+    return promise;\n+  }\n+\n+  /// 用命令自己的 key/内容提交。重连重放与新命令共用这一条路径，\n+  /// 确保重放绝不会分配新 key 或改变命令内容。\n+  private sendSubmit(intent: PendingCommand, replay = false): void {\n+    this.send({\n+      type: \"SubmitCommand\",\n+      payload: {\n+        header: this.nextHeader(),\n+        command: {\n+          actor: this.playerId,\n+          expected_revision: this.revision,\n+          idempotency_key: intent.key,\n+          kind: intent.kind,\n+        },\n+        idempotency_key: intent.key,\n+        replay,\n+      },\n+    });\n+  }\n+\n+  /// 断线前已发出但未确认的命令在重新入房后**先用原 key 重放**。\n+  /// WebSocket 保序，因此 UI 在 JoinOk 之后产生的新提交一定排在这些\n+  /// 重放之后；服务端按 reconnect token + key 返回原 Accepted 或只执行一次。\n+  private replayPending(): void {\n+    const persisted =\n+      this.persistedPending && this.persistedPending.roomId === this.roomId\n+        ? this.persistedPending\n+        : null;\n+    if (persisted && !this.pending.has(persisted.key)) {\n+      // 页面刷新后的新实例没有旧 Promise；用占位 pending 承接服务端回执，\n+      // 并通过 envelope 监听者把权威结果交回界面。\n+      const intent: PendingCommand = {\n+        kind: persisted.kind,\n+        key: persisted.key,\n+        resolve: (envelope) => {\n+          for (const listener of this.envelopeListeners) listener(envelope);\n+        },\n+        reject: () => undefined,\n+      };\n+      this.pending.set(intent.key, intent);\n+    }\n+    if (!this.pending.size) return;\n+    for (const intent of [...this.pending.values()]) {\n+      try {\n+        this.sendSubmit(intent, true);\n+      } catch {\n+        // 连接再次断开：保留意图，下次 JoinOk 继续用原 key 结算。\n+        return;\n+      }\n+    }\n+  }\n+\n+  private nextHeader(): MessageHeader {\n+    return {\n+      protocol_version: NETWORK_PROTOCOL_VERSION,\n+      room_id: this.roomId,\n+      conn_seq: ++this.connSeq,\n+      revision: this.revision,\n+    };\n+  }\n+\n+  private send(message: unknown): void {\n+    if (this.socket?.readyState !== WebSocket.OPEN) {\n+      throw new Error(\"WebSocket 未连接\");\n+    }\n+    this.socket.send(JSON.stringify(message));\n+  }\n+\n+  private handleMessage(json: string): void {\n+    let message: { type?: string; payload?: Record<string, unknown> };\n+    try {\n+      message = JSON.parse(json) as typeof message;\n+    } catch {\n+      this.rejectOutstanding(new Error(\"服务端返回了无效 JSON\"));\n+      return;\n+    }\n+    const payload = message.payload ?? {};\n+    if (payload.view) {\n+      try { validateObserverMetadata(payload.view as ObserverSnapshot, (payload.choice as ChoiceRequest | null) ?? null); }\n+      catch (error) { this.rejectOutstanding(new Error(`服务端元数据无效：${String(error)}`)); return; }\n+    }\n+\n+    switch (message.type) {\n+      case \"Welcome\":\n+        if (payload.protocol_version !== NETWORK_PROTOCOL_VERSION || (payload.versions as { network_protocol?: number } | undefined)?.network_protocol !== NETWORK_PROTOCOL_VERSION) {\n+          this.rejectOutstanding(new Error(\"服务端协议版本不兼容：需要 WS6\"));\n+          this.socket?.close();\n+          return;\n+        }\n+        this.connectionId = Number(payload.connection_id ?? 0);\n+        this.welcomeWaiter?.resolve();\n+        this.welcomeWaiter = null;\n+        break;\n+      case \"RoomCreated\":\n+        this.roomId = Number(payload.room_id ?? 0);\n+        break;\n+      case \"JoinOk\": {\n+        this.roomId = Number(payload.room_id ?? this.roomId);\n+        this.playerId = Number(payload.player_id ?? 0);\n+        const view = payload.view as unknown as ObserverSnapshot;\n+        this.choice = (payload.choice as ChoiceRequest | null | undefined) ?? null;\n+        this.revision = view.revision;\n+        const session: OnlineSession = {\n+          roomId: this.roomId,\n+          playerId: this.playerId,\n+          seat: Number(payload.seat ?? 255),\n+          role: String(payload.role ?? \"Spectator\") as OnlineSession[\"role\"],\n+          reconnectToken: String(payload.reconnect_token ?? \"\"),\n+          view,\n+          envelope: envelopeFromView(\n+            view,\n+            this.choice,\n+            [],\n+            (payload.legal_actions as LegalAction[] | undefined) ?? [],\n+            null\n+          ),\n+        };\n+        this.session = session;\n+        // 先同步发出同 key 重放，再 resolve 入房；UI 在 JoinOk 后的新提交\n+        // 因此一定排在重放之后（WebSocket 保序）。\n+        this.replayPending();\n+        this.joinWaiter?.resolve(session);\n+        this.joinWaiter = null;\n+        this.startHeartbeat();\n+        break;\n+      }\n+      case \"RoomRoster\": {\n+        const roster = payload as unknown as RoomRoster;\n+        if ((roster.choice_timeout_secs !== null && ![10, 15, 30, 60, 90].includes(roster.choice_timeout_secs)) || !Array.isArray(roster.seats) || roster.seats.some((seat) => typeof seat.managed !== \"boolean\")) {\n+          this.rejectOutstanding(new Error(\"服务端房间超时配置无效\")); return;\n+        }\n+        for (const listener of this.rosterListeners) listener(roster);\n+        break;\n+      }\n+      case \"CommandOutcome\":\n+        this.handleOutcome(payload);\n+        break;\n+      case \"Snapshot\": {\n+        const header = payload.header as unknown as MessageHeader;\n+        const view = payload.view as unknown as ObserverSnapshot;\n+        this.choice = (payload.choice as ChoiceRequest | null | undefined) ?? null;\n+        this.revision = view.revision;\n+        const waiter = this.snapshotWaiters.get(header.conn_seq);\n+        if (waiter) {\n+          this.snapshotWaiters.delete(header.conn_seq);\n+          waiter.resolve(view);\n+        }\n+        const envelope = envelopeFromView(\n+          view,\n+          this.choice,\n+          [],\n+          (payload.legal_actions as LegalAction[] | undefined) ?? [],\n+          null\n+        );\n+        for (const listener of this.envelopeListeners) listener(envelope);\n+        break;\n+      }\n+      case \"Pong\": {\n+        const header = payload.header as MessageHeader | undefined;\n+        const probe = this.clockProbe;\n+        const receivedAt = performance.now();\n+        const serverTime = payload.server_time_ms;\n+        if (probe && header?.protocol_version === NETWORK_PROTOCOL_VERSION &&\n+            header.conn_seq === probe.connSeq && header.room_id === probe.roomId &&\n+            typeof serverTime === \"number\" && Number.isSafeInteger(serverTime) && serverTime > 0 &&\n+            receivedAt >= probe.sentAt) {\n+          this.serverTimeAnchor = { unixMs: serverTime + (receivedAt - probe.sentAt) / 2, monotonicMs: receivedAt };\n+          this.clockProbe = null;\n+        }\n+        break;\n+      }\n+      case \"Error\": {\n+        const error = new Error(String(payload.message ?? \"服务端错误\"));\n+        if (this.joinWaiter) {\n+          this.joinWaiter.reject(error);\n+          this.joinWaiter = null;\n+        } else {\n+          this.rejectOutstanding(error);\n+        }\n+        break;\n+      }\n+    }\n+  }\n+\n+  private handleOutcome(payload: Record<string, unknown>): void {\n+    const view = payload.view as unknown as ObserverSnapshot;\n+    const previousRevision = this.revision;\n+    this.revision = view.revision;\n+    this.choice = (payload.choice as ChoiceRequest | null | undefined) ?? null;\n+    const eventCodes = (payload.public_event_codes as number[] | undefined) ?? [];\n+    const envelope = envelopeFromView(\n+      view,\n+      this.choice,\n+      eventCodes,\n+      (payload.legal_actions as LegalAction[] | undefined) ?? [],\n+      payload.result ?? null\n+    );\n+    const key = Number(payload.idempotency_key ?? 0);\n+    clearPendingStorage(key);\n+    if (this.persistedPending?.key === key) this.persistedPending = null;\n+    const pending = this.pending.get(key);\n+    if (pending) {\n+      this.pending.delete(key);\n+      const rejection = commandRejection(payload.result);\n+      if (rejection) {\n+        for (const listener of this.envelopeListeners) listener(envelope);\n+        pending.reject(new Error(rejection));\n+      } else pending.resolve(envelope);\n+    } else {\n+      for (const listener of this.envelopeListeners) listener(envelope);\n+    }\n+\n+    if (previousRevision > 0 && view.revision > previousRevision + 1) {\n+      void this.requestSnapshot().catch(() => undefined);\n+    }\n+  }\n+\n+  private startHeartbeat(): void {\n+    if (this.heartbeat != null) window.clearInterval(this.heartbeat);\n+    this.heartbeat = window.setInterval(() => {\n+      if (this.socket?.readyState !== WebSocket.OPEN) return;\n+      this.sendHeartbeat();\n+    }, 15_000);\n+  }\n+\n+  private sendHeartbeat(): void {\n+    const header = this.nextHeader();\n+    this.clockProbe = { connSeq: header.conn_seq, roomId: header.room_id, sentAt: performance.now() };\n+    this.send({ type: \"Heartbeat\", payload: { header } });\n+  }\n+\n+  private handleClose(): void {\n+    this.clockProbe = null;\n+    this.serverTimeAnchor = null;\n+    if (this.heartbeat != null) window.clearInterval(this.heartbeat);\n+    // NC09：断线必须**可见**——此前服务端中途崩溃时界面保持旧状态、无任何提示。\n+    // 这里向监听者广播一次「已断开」，由界面写入状态行与日志。\n+    for (const listener of this.closeListeners) {\n+      try {\n+        listener();\n+      } catch {\n+        /* 监听者异常不得影响其它监听者 */\n+      }\n+    }\n+    this.heartbeat = null;\n+    this.socket = null;\n+    this.playerId = 0;\n+    if (!this.disposed) {\n+      // 待确认命令必须跨重连保留：ACK 可能已丢，服务端也许已提交。\n+      // 入房/欢迎/快照 waiter 无法跨连接，明确失败；pending 留到 JoinOk 重放。\n+      this.suspendOutstanding(new Error(\"与服务端的连接已断开\"));\n+      this.scheduleReconnect();\n+    }\n+  }\n+\n+  /// 断线自动重连（指数退避，最多 5 次；成功/失败均广播状态）。\n+  private scheduleReconnect(): void {\n+    if (this.reconnectTimer != null) return;\n+    if (!this.lastUrl) return;\n+    if (this.reconnectAttempts >= 5) {\n+      this.failPendingUncertain();\n+      for (const l of this.reconnectListeners) l(\"failed\");\n+      return;\n+    }\n+    const delay = Math.min(1000 * 2 ** this.reconnectAttempts, 8000);\n+    this.reconnectAttempts += 1;\n+    for (const l of this.reconnectListeners) l(\"reconnecting\");\n+    this.reconnectTimer = window.setTimeout(() => {\n+      this.reconnectTimer = null;\n+      const url = this.lastUrl;\n+      if (!url || this.disposed) return;\n+      void this.connect(url, this.lastName)\n+        .then(() => {\n+          this.reconnectAttempts = 0;\n+          for (const l of this.reconnectListeners) l(\"reconnected\");\n+        })\n+        .catch(() => {\n+          this.scheduleReconnect();\n+        });\n+    }, delay);\n+  }\n+\n+  /// 自动重连状态通知（NC09）。\n+  onReconnect(listener: (state: \"reconnecting\" | \"reconnected\" | \"failed\") => void): () => void {\n+    this.reconnectListeners.add(listener);\n+    return () => this.reconnectListeners.delete(listener);\n+  }\n+\n+  /// 连接级 waiter 跨不过断线；命令意图 `pending` 有意保留。\n+  private suspendOutstanding(error: Error): void {\n+    this.welcomeWaiter?.reject(error);\n+    this.welcomeWaiter = null;\n+    this.joinWaiter?.reject(error);\n+    this.joinWaiter = null;\n+    for (const pending of this.snapshotWaiters.values()) pending.reject(error);\n+    this.snapshotWaiters.clear();\n+  }\n+\n+  /// 自动重连彻底失败：不能把未确认提交说成已撤销或已拒绝。\n+  private failPendingUncertain(): void {\n+    if (!this.pending.size) return;\n+    for (const pending of this.pending.values()) {\n+      pending.reject(\n+        new Error(\"提交结果不确定：连接已断开且自动重连失败，请重新进入房间后再操作\")\n+      );\n+    }\n+    this.pending.clear();\n+  }\n+\n+  private rejectOutstanding(error: Error): void {\n+    this.suspendOutstanding(error);\n+    for (const pending of this.pending.values()) pending.reject(error);\n+    this.pending.clear();\n+  }\n+}\n+\n+function normalizeWsUrl(url: string): string {\n+  const trimmed = url.trim();\n+  if (trimmed.startsWith(\"http://\")) return `ws://${trimmed.slice(7)}`;\n+  if (trimmed.startsWith(\"https://\")) return `wss://${trimmed.slice(8)}`;\n+  return trimmed;\n+}\n+\n+export function onlineReconnectKey(wsUrl: string, roomId: number): string {\n+  const origin = new URL(normalizeWsUrl(wsUrl)).origin;\n+  return `noname-next.reconnect.${encodeURIComponent(origin)}.${roomId}`;\n+}\n+\n+function envelopeFromView(\n+  view: ObserverSnapshot,\n+  choice: ChoiceRequest | null,\n+  publicEventCodes: number[],\n+  legalActions: LegalAction[],\n+  result: unknown\n+): EngineEnvelope {\n+  return {\n+    result,\n+    events: publicEventCodes.map((code) => ({\n+      PublicEvent: { code, label: publicEventLabel(code) },\n+    })),\n+    choice,\n+    view,\n+    legal_actions: legalActions,\n+    hash_hex: hashHex(view.state_hash),\n+    revision: view.revision,\n+    finished: isFinished(view.outcome),\n+  };\n+}\n+\n+function hashHex(hash: ObserverSnapshot[\"state_hash\"]): string {\n+  if (typeof hash === \"string\") return hash;\n+  return hash.map((byte) => byte.toString(16).padStart(2, \"0\")).join(\"\");\n+}\n+\n+function isFinished(outcome: unknown): boolean {\n+  if (outcome == null || outcome === \"InProgress\") return false;\n+  return !(typeof outcome === \"object\" && \"InProgress\" in (outcome as object));\n+}\n+\n+function commandRejection(result: unknown): string | null {\n+  if (!result || typeof result !== \"object\" || !(\"Rejected\" in result)) return null;\n+  const rejected = (result as { Rejected: unknown }).Rejected;\n+  const code =\n+    rejected && typeof rejected === \"object\" && \"IllegalAction\" in rejected\n+      ? (rejected as { IllegalAction?: { code?: unknown } }).IllegalAction?.code\n+      : undefined;\n+  if (code === \"legacy_replay_no_receipt\") {\n+    return \"提交结果不确定：旧房间没有可核对的回执，已停止重放；请以房间当前状态为准\";\n+  }\n+  return `命令被拒绝：${JSON.stringify(rejected)}`;\n+}"},{"sha":"8ded2ebd3584b2a58d8d318129398f2563e46e05","filename":"apps/web-client/scripts/nc03-worker-clone.test.mjs","status":"modified","additions":3,"deletions":2,"changes":5,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/apps%2Fweb-client%2Fscripts%2Fnc03-worker-clone.test.mjs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/apps%2Fweb-client%2Fscripts%2Fnc03-worker-clone.test.mjs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/apps%2Fweb-client%2Fscripts%2Fnc03-worker-clone.test.mjs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -1,3 +1,4 @@\n+import { MAX_ENGINE_OUTSTANDING } from \"../src/engine/desktopEngineTransport.ts\";\n import assert from \"node:assert/strict\";\n import { readFileSync } from \"node:fs\";\n import { test } from \"node:test\";\n@@ -19,8 +20,8 @@ function fixture() {\n     .outputText.replace(/\\nexport\\s*\\{\\};?\\s*$/, \"\");\n   const sent = [];\n   const failed = [];\n-  const EngineClient = new Function(\"perfRequestSent\", \"perfRequestFailed\", js + \"\\nreturn EngineClient;\")(\n-    () => {}, (id) => failed.push(id),\n+  const EngineClient = new Function(\"perfRequestSent\", \"perfRequestFailed\", \"MAX_ENGINE_OUTSTANDING\", js + \"\\nreturn EngineClient;\")(\n+    () => {}, (id) => failed.push(id), MAX_ENGINE_OUTSTANDING,\n   );\n   const client = new EngineClient();\n   const worker = {"},{"sha":"9315a3765b19d89c3b356f248e77eaa110221b59","filename":"apps/web-client/scripts/nc04-worker-failure.test.mjs","status":"modified","additions":134,"deletions":9,"changes":143,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/apps%2Fweb-client%2Fscripts%2Fnc04-worker-failure.test.mjs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/apps%2Fweb-client%2Fscripts%2Fnc04-worker-failure.test.mjs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/apps%2Fweb-client%2Fscripts%2Fnc04-worker-failure.test.mjs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -2,7 +2,9 @@ import assert from \"node:assert/strict\";\n import { readFileSync } from \"node:fs\";\n import { test } from \"node:test\";\n import ts from \"typescript\";\n-import { DesktopEngineTransport } from \"../src/engine/desktopEngineTransport.ts\";\n+import { invalidPresentationBatches, presentationEnvelope } from \"./presentation-fixtures.mjs\";\n+import { validatePresentationResponse } from \"../src/engine/presentationMetadata.ts\";\n+import { DesktopEngineTransport, MAX_ENGINE_OUTSTANDING } from \"../src/engine/desktopEngineTransport.ts\";\n \n async function settles(promise) {\n   let timer;\n@@ -18,7 +20,7 @@ async function settles(promise) {\n \n // Use the production client class with a controllable Worker; the browser test\n // additionally exercises actual browser event dispatch and a native Worker.\n-function fixture({ autoInit = true, desktopNative = false, invoke } = {}) {\n+function fixture({ autoInit = true, desktopNative = false, invoke, sab = false } = {}) {\n   const source = readFileSync(new URL(\"../src/engine/client.ts\", import.meta.url), \"utf8\");\n   const ast = ts.createSourceFile(\"client.ts\", source, ts.ScriptTarget.Latest, true);\n   const declaration = ast.statements.find((node) => ts.isClassDeclaration(node) && node.name?.text === \"EngineClient\");\n@@ -49,12 +51,12 @@ function fixture({ autoInit = true, desktopNative = false, invoke } = {}) {\n   const EngineClient = new Function(\n     \"NativeEngineWorker\", \"LegacyEngineWorker\", \"isTauriShell\", \"perfRequestSent\",\n     \"perfRequestFailed\", \"perfResponseReceived\", \"perfWorkerTimings\", \"startPerfProbe\",\n-    \"urlParam\", \"console\", \"desktopEngineChoice\", \"DesktopEngineTransport\", js + \"\\nreturn EngineClient;\",\n+    \"urlParam\", \"console\", \"desktopEngineChoice\", \"DesktopEngineTransport\", \"validatePresentationResponse\", \"MAX_ENGINE_OUTSTANDING\", js + \"\\nreturn EngineClient;\",\n   )(FakeWorker, FakeWorker, () => desktopNative, (id) => sent.push(id), (id) => failed.push(id),\n-    (id) => received.push(id), () => {}, () => false, () => null, { error: () => {} },\n+    (id) => received.push(id), () => {}, () => false, () => sab ? \"sab\" : null, { error: () => {} },\n     () => desktopNative ? \"native\" : \"wasm\", class extends DesktopEngineTransport {\n       constructor() { super(invoke); }\n-    });\n+    }, validatePresentationResponse, MAX_ENGINE_OUTSTANDING);\n   return { client: new EngineClient(), workers, failed, sent, received };\n }\n \n@@ -217,19 +219,19 @@ test(\"desktop burst keeps production EngineClient pending and unresolved promise\n       (value) => { settled.push({ ok: true, value }); },\n       (error) => { settled.push({ ok: false, error }); },\n     ));\n-    assert.ok(f.client.pending.size <= 8, \"synchronous rejection must immediately delete pending\");\n+    assert.ok(f.client.pending.size <= 8, \"excess requests must not insert pending\");\n     if (i === 0) await new Promise((resolve) => setImmediate(resolve));\n   }\n   await new Promise((resolve) => setImmediate(resolve));\n   assert.equal(f.client.pending.size, 8);\n   assert.deepEqual([...f.client.pending.keys()], [2, 3, 4, 5, 6, 7, 8, 9]);\n   assert.equal(settled.length, 120, \"only eight caller promises may remain unresolved\");\n-  assert.equal(wakes, 129);\n+  assert.equal(wakes, 9);\n   assert.equal(settlements, 1, \"rejected excess requests must not settle accepted shared waits\");\n-  assert.equal(f.sent.length, 129);\n+  assert.equal(f.sent.length, 9);\n   assert.deepEqual(f.received, [1]);\n   assert.ok(settled.every((result) => !result.ok && /not submitted|未提交/.test(result.error.message) && !/未知|unknown/.test(result.error.message)));\n-  assert.deepEqual(f.failed, Array.from({ length: 120 }, (_, i) => i + 10));\n+  assert.deepEqual(f.failed, [], \"capacity rejection precedes perf submission\");\n   assert.deepEqual(calls.filter((call) => call.command === \"native_engine_request\").map((call) => call.args.request.id), [1, 2]);\n   release();\n   await settles(Promise.all(promises));\n@@ -276,3 +278,126 @@ test(\"disposing eight accepted desktop requests retires the old resource and rec\n   await new Promise((resolve) => setImmediate(resolve));\n   assert.deepEqual(calls.filter((call) => call.command === \"native_engine_close\").map((call) => call.args.resourceId), [61, 62]);\n });\n+\n+// Actual Worker and SAB settlement must validate before removing/acknowledging a pending call.\n+for (const {name,batch} of invalidPresentationBatches()) {\n+  test(`Worker bad present ${name} preserves pending until dispose`, async () => {\n+    const f=fixture();await f.client.connect();const worker=f.workers[0];\n+    const promise=f.client.autoStep();const id=worker.sent.at(-1).id;\n+    const pending=[...f.client.pending];const received=f.received.length;\n+    worker.reply(id,presentationEnvelope(batch));\n+    await assert.rejects(promise,/协议错误，操作结果未确认/);\n+    assert.deepEqual([...f.client.pending],pending);assert.equal(f.received.length,received);\n+    f.client.dispose();assert.equal(f.client.pending.size,0);\n+  });\n+}\n+\n+for (const {name,batch} of invalidPresentationBatches()) {\n+  test(`actual IPC to EngineClient bad present ${name} preserves pending`, async () => {\n+    const f=fixture({desktopNative:true,invoke:async (command,args)=>command===\"native_engine_open\"?1:\n+      command===\"native_engine_request\"?{id:args.request.id,ok:true,data:args.request.type===\"init\"?\"ready\":presentationEnvelope(batch)}:undefined});\n+    await f.client.connect();const promise=f.client.autoStep();const pending=[...f.client.pending];\n+    const received=f.received.length;await assert.rejects(promise,/协议错误，操作结果未确认/);\n+    assert.deepEqual([...f.client.pending],pending);assert.equal(f.received.length,received);\n+    f.client.dispose();assert.equal(f.client.pending.size,0);\n+  });\n+}\n+\n+test(\"actual SAB poll rejects malformed presentation before settling or deleting pending\", async t => {\n+  const old={document:globalThis.document,crossOriginIsolated:globalThis.crossOriginIsolated,requestAnimationFrame:globalThis.requestAnimationFrame};\n+  const frames=[];globalThis.document={createElement:()=>({style:{}}),head:{appendChild(){}},body:{appendChild(){}}};\n+  globalThis.crossOriginIsolated=true;globalThis.requestAnimationFrame=fn=>{frames.push(fn);return frames.length;};\n+  t.after(()=>{Object.assign(globalThis,old);});\n+  const f=fixture({sab:true});await f.client.connect();const worker=f.workers[0];\n+  const promise=f.client.autoStep();const id=worker.sent.at(-1).id;\n+  const pending=[...f.client.pending];const received=f.received.length;\n+  const sab=worker.sent[0].latencySab;assert.ok(sab instanceof SharedArrayBuffer);\n+  const raw=new TextEncoder().encode(JSON.stringify({id,ok:true,data:presentationEnvelope(null)}));\n+  new Uint8Array(sab,8,raw.length).set(raw);const ints=new Int32Array(sab,0,2);Atomics.store(ints,1,raw.length);Atomics.store(ints,0,1);\n+  frames.shift()();await assert.rejects(promise,/协议错误，操作结果未确认/);\n+  assert.deepEqual([...f.client.pending],pending);assert.equal(f.received.length,received);assert.ok(frames.length>0);\n+  f.client.dispose();assert.equal(f.client.pending.size,0);\n+});\n+\n+test(\"actual Worker and IPC nested chooseGeneral preserve mapping on bad presentation\", async () => {\n+  for (const desktopNative of [false,true]) {\n+    const bad={assignment:{seat:0,name:\"liubei\",revision:2,state_hash:\"00\"},envelope:presentationEnvelope(null)};\n+    const f=fixture({desktopNative,invoke:async (command,args)=>command===\"native_engine_open\"?1:\n+      command===\"native_engine_request\"?{id:args.request.id,ok:true,data:args.request.type===\"init\"?\"ready\":bad}:undefined});\n+    await f.client.connect();const promise=f.client.chooseGeneral(0,\"liubei\");const pending=[...f.client.pending];const received=f.received.length;\n+    if (!desktopNative) f.workers[0].reply(f.workers[0].sent.at(-1).id,bad);\n+    await assert.rejects(promise,/协议错误，操作结果未确认/);assert.deepEqual([...f.client.pending],pending);assert.equal(f.received.length,received);\n+    f.client.dispose();assert.equal(f.client.pending.size,0);\n+  }\n+});\n+\n+test(\"shared Worker request guard sends eight and rejects ninth before map/postMessage\", async () => {\n+  const f=fixture();await f.client.connect();const worker=f.workers[0];\n+  const calls=Array.from({length:8},()=>f.client.autoStep());const pending=[...f.client.pending];const sent=worker.sent.length;\n+  await assert.rejects(f.client.autoStep(),/未提交/);assert.deepEqual([...f.client.pending],pending);assert.equal(worker.sent.length,sent);\n+  for (const request of worker.sent.slice(-8)) worker.reply(request.id,{kind:\"plan\",outcome:'{\"outcome\":\"accepted\"}'});\n+  await Promise.all(calls);assert.equal(f.client.pending.size,0);\n+  const next=f.client.autoStep();worker.reply(worker.sent.at(-1).id,{outcome:\"accepted\"});await next;f.client.dispose();\n+});\n+\n+test(\"eight retained malformed responses keep capacity until explicit dispose\", async () => {\n+  for (const desktopNative of [false,true]) {\n+    const f=fixture({desktopNative,invoke:async (command,args)=>command===\"native_engine_open\"?1:\n+      command===\"native_engine_request\"?{id:args.request.id,ok:true,data:args.request.type===\"init\"?\"ready\":presentationEnvelope(null)}:undefined});\n+    await f.client.connect();const calls=Array.from({length:8},()=>f.client.autoStep());\n+    const results=Promise.all(calls.map(p=>assert.rejects(p,/结果未确认/)));\n+    if (!desktopNative) for (const request of f.workers[0].sent.slice(-8)) f.workers[0].reply(request.id,presentationEnvelope(null));\n+    await results;const pending=[...f.client.pending];assert.equal(pending.length,8);\n+    await assert.rejects(f.client.autoStep(),/未提交/);assert.deepEqual([...f.client.pending],pending);\n+    f.client.dispose();assert.equal(f.client.pending.size,0);\n+  }\n+});\n+\n+// Independent review repro: Source27 must not convert compound-invalid success into ordinary cleanup.\n+for (const nested of [false, true]) {\n+  test(`compound-invalid IPC ${nested ? \"chooseGeneral\" : \"autoStep\"} preserves uncertain pending before observer normalization`, async () => {\n+    const envelope=presentationEnvelope(null);envelope.view.seats[0].generals=[];\n+    const data=nested?{assignment:{seat:0,name:\"liubei\",revision:2,state_hash:\"00\"},envelope}:envelope;\n+    const f=fixture({desktopNative:true,invoke:async (command,args)=>command===\"native_engine_open\"?1:\n+      command===\"native_engine_request\"?{id:args.request.id,ok:true,data:args.request.type===\"init\"?\"ready\":data}:undefined});\n+    await f.client.connect();const promise=nested?f.client.chooseGeneral(0,\"liubei\"):f.client.autoStep();\n+    const pending=[...f.client.pending];const received=f.received.length;\n+    await assert.rejects(promise,/协议错误，操作结果未确认/);\n+    assert.deepEqual([...f.client.pending],pending);assert.equal(f.received.length,received);\n+    f.client.dispose();assert.equal(f.client.pending.size,0);\n+  });\n+}\n+\n+test(\"compound IPC valid presentation keeps Source27 diagnostic and ordinary cleanup\", async () => {\n+  for(const presentation of [\"absent\",\"valid\"]) for(const nested of [false,true]) {\n+    const envelope=presentationEnvelope();if(presentation===\"absent\") delete envelope.presentation;\n+    envelope.view.seats[0].generals=[];\n+    const data=nested?{assignment:{seat:0,name:\"liubei\",revision:2,state_hash:\"00\"},envelope}:envelope;\n+    const f=fixture({desktopNative:true,invoke:async(command,args)=>command===\"native_engine_open\"?1:\n+      command===\"native_engine_request\"?{id:args.request.id,ok:true,data:args.request.type===\"init\"?\"ready\":data}:undefined});\n+    await f.client.connect();const received=f.received.length;\n+    const promise=nested?f.client.chooseGeneral(0,\"liubei\"):f.client.autoStep();\n+    await assert.rejects(promise,/generals metadata invalid/);\n+    assert.equal(f.client.pending.size,0);assert.equal(f.received.length,received+1);\n+    f.client.dispose();\n+  }\n+});\n+\n+test(\"IPC precheck preserves all malformed presentation before bad Source27, including missing view/context\", async () => {\n+  const malformed=[...invalidPresentationBatches().map(v=>({name:v.name,value:v.batch})),{name:\"null\",value:null},{name:\"undefined\",value:undefined},{name:\"unknown_object\",value:{unexpected:true}}];\n+  for(const {name,value} of malformed) for(const nested of [false,true]) {\n+    const envelope=presentationEnvelope(value);if(name===\"undefined\") envelope.presentation=undefined;\n+    envelope.view.seats[0].generals=[];\n+    const data=nested?{assignment:{seat:0,name:\"liubei\",revision:2,state_hash:\"00\"},envelope}:envelope;\n+    const f=fixture({desktopNative:true,invoke:async(command,args)=>command===\"native_engine_open\"?1:\n+      command===\"native_engine_request\"?{id:args.request.id,ok:true,data:args.request.type===\"init\"?\"ready\":data}:undefined});\n+    await f.client.connect();const promise=nested?f.client.chooseGeneral(0,\"liubei\"):f.client.autoStep();const pending=[...f.client.pending];const received=f.received.length;\n+    await assert.rejects(promise,/协议错误，操作结果未确认/,name);assert.deepEqual([...f.client.pending],pending,name);assert.equal(f.received.length,received,name);f.client.dispose();\n+  }\n+  for(const shape of [{presentation:null},{presentation:{},view:null},{presentation:{},view:{seats:[]}}]) {\n+    const f=fixture({desktopNative:true,invoke:async(command,args)=>command===\"native_engine_open\"?1:\n+      command===\"native_engine_request\"?{id:args.request.id,ok:true,data:args.request.type===\"init\"?\"ready\":shape}:undefined});\n+    await f.client.connect();const promise=f.client.autoStep();const pending=[...f.client.pending];\n+    await assert.rejects(promise,/结果未确认/);assert.deepEqual([...f.client.pending],pending);f.client.dispose();\n+  }\n+});"},{"sha":"df318c6fc9aa5256faa4e414fe47d058caa900aa","filename":"apps/web-client/scripts/presentation-fixtures.mjs","status":"added","additions":29,"deletions":0,"changes":29,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/apps%2Fweb-client%2Fscripts%2Fpresentation-fixtures.mjs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/apps%2Fweb-client%2Fscripts%2Fpresentation-fixtures.mjs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/apps%2Fweb-client%2Fscripts%2Fpresentation-fixtures.mjs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1,29 @@\n+import { readFileSync } from \"node:fs\";\n+\n+const fixtureRoot = new URL(\"../../../crates/engine-protocol/tests/fixtures/\", import.meta.url);\n+export const presentationBatch = () => JSON.parse(readFileSync(new URL(\"i02-presentation.json\", fixtureRoot), \"utf8\"));\n+const invalidRegularBatches = () => JSON.parse(readFileSync(new URL(\"i02-presentation-invalid.json\", fixtureRoot), \"utf8\")).map(({name, changes}) => {\n+  const batch = presentationBatch();\n+  for (const change of changes) {\n+    const parts = change.pointer.slice(1).split(\"/\");\n+    const key = parts.pop();\n+    const parent = parts.reduce((value, part) => value[part], batch);\n+    if (change.remove) delete parent[key]; else parent[key] = change.value;\n+  }\n+  return { name, batch };\n+});\n+export const surrogatePresentationBatches = () => JSON.parse(readFileSync(new URL(\"i02-presentation-surrogates.json\", fixtureRoot), \"utf8\")).map(({name,pointer,raw_json_value}) => {\n+  const batch=presentationBatch();const parts=pointer.slice(1).split(\"/\");const key=parts.pop();\n+  const parent=parts.reduce((value,part)=>value[part],batch);parent[key]=JSON.parse(raw_json_value);\n+  return {name,batch};\n+});\n+export const invalidPresentationBatches = () => [...invalidRegularBatches(),...surrogatePresentationBatches()];\n+export function presentationView(revision = 2) {\n+  return { revision, state_hash: Array(32).fill(0), observer: \"Spectator\", round: 1, current_player: 1,\n+    phase: \"Play\", seats: [1, 2].map(player => ({player, seat: player - 1, hp: 4, max_hp: 4, alive: true, hand_count: 0, identity: null, skills: []})),\n+    known_cards: [], outcome: \"InProgress\" };\n+}\n+export function presentationEnvelope(batch = presentationBatch()) {\n+  return { result: {outcome: \"accepted\"}, events: [], presentation: batch, view: presentationView(),\n+    choice: null, legal_actions: [], hash_hex: \"00\".repeat(32), revision: 2, finished: false };\n+}"},{"sha":"9f95455d2522f877cbd74ae85a0128325156a521","filename":"apps/web-client/scripts/presentation-metadata.test.mjs","status":"added","additions":205,"deletions":0,"changes":205,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/apps%2Fweb-client%2Fscripts%2Fpresentation-metadata.test.mjs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/apps%2Fweb-client%2Fscripts%2Fpresentation-metadata.test.mjs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/apps%2Fweb-client%2Fscripts%2Fpresentation-metadata.test.mjs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1,205 @@\n+import assert from \"node:assert/strict\";\n+import { readFileSync } from \"node:fs\";\n+import { test } from \"node:test\";\n+import ts from \"typescript\";\n+import { presentationMetadata, validatePresentationResponse } from \"../src/engine/presentationMetadata.ts\";\n+import { NetworkEngineClient } from \"../src/engine/networkClient.ts\";\n+import { DesktopEngineTransport } from \"../src/engine/desktopEngineTransport.ts\";\n+import { applyEnvelope, createViewStore } from \"../src/engine/viewStore.ts\";\n+import { presentationBatch, invalidPresentationBatches, surrogatePresentationBatches, presentationView, presentationEnvelope } from \"./presentation-fixtures.mjs\";\n+\n+async function frozenReader(name) {\n+  const source = readFileSync(new URL(`./fixtures/i02-main5fc/${name}.ts`, import.meta.url), \"utf8\");\n+  const relocated = source.replace(/from \"(\\.\\.?\\/[^\"\\n]+)\"/g, (_, path) => `from \"${new URL(path + \".ts\", new URL(\"../src/engine/\", import.meta.url)).href}\"`);\n+  const resolved = relocated.replace('from \"@tauri-apps/api/core\"', `from \"${import.meta.resolve(\"@tauri-apps/api/core\")}\"`);\n+  const js = ts.transpileModule(resolved, {compilerOptions:{module:ts.ModuleKind.ESNext,target:ts.ScriptTarget.ES2022}}).outputText;\n+  return import(`data:text/javascript;base64,${Buffer.from(js).toString(\"base64\")}`);\n+}\n+\n+function network(t, Client = NetworkEngineClient) {\n+  const previousWindow = globalThis.window;\n+  const previousStorage = globalThis.sessionStorage;\n+  const storage = new Map();\n+  globalThis.sessionStorage = {getItem:key=>storage.get(key) ?? null,setItem:(key,value)=>storage.set(key,value),removeItem:key=>storage.delete(key)};\n+  globalThis.window = { clearTimeout(){}, clearInterval(){}, setInterval(){return 1;} };\n+  const client = new Client();\n+  t.after(() => { client.dispose(); globalThis.window = previousWindow; globalThis.sessionStorage = previousStorage; });\n+  client.revision = 1; client.roomId = 7;\n+  const envelopes = []; client.onEnvelope(e => envelopes.push(e));\n+  return {client, envelopes, storage};\n+}\n+function outcome(batch, key = 9) {\n+  return JSON.stringify({type:\"CommandOutcome\",payload:{header:{protocol_version:6,room_id:7,conn_seq:9,revision:2}, idempotency_key:key,\n+    result:{Accepted:{new_revision:2,state_hash:Array(32).fill(0)}},view:presentationView(),choice:null,legal_actions:[],public_event_codes:[3],presentation:batch}});\n+}\n+\n+test(\"actual frozen Main5fc TS network and desktop readers accept the optional response\", async t => {\n+  const {NetworkEngineClient: OldClient} = await frozenReader(\"networkClient\");\n+  const f=network(t,OldClient); f.client.handleMessage(outcome(presentationBatch()));\n+  assert.equal(f.envelopes.length,1); assert.equal(f.envelopes[0].presentation,undefined);\n+  const {DesktopEngineTransport: OldDesktop} = await frozenReader(\"desktopEngineTransport\");\n+  const old = new OldDesktop(async command => command === \"native_engine_open\" ? 1 : {id:1,ok:true,data:presentationEnvelope()});\n+  const response = await new Promise(resolve => {old.onmessage=({data})=>resolve(data);old.postMessage({id:1,type:\"autoStep\"});});\n+  assert.equal(response.ok,true); assert.deepEqual(response.data.presentation,presentationBatch());old.terminate();\n+});\n+\n+test(\"new parser accepts all seven events and legacy absence without altering autoStep strings\", t => {\n+  assert.equal(presentationMetadata(undefined,2,2),undefined);\n+  assert.deepEqual(presentationMetadata(presentationBatch(),2,2),presentationBatch());\n+  const f=network(t);f.client.handleMessage(outcome(presentationBatch()));\n+  assert.deepEqual(f.envelopes[0].presentation,presentationBatch());\n+  const env=presentationEnvelope();env.result={kind:\"answer\",outcome:'{\"outcome\":\"accepted\",\"revision\":2}'};\n+  const before=JSON.stringify(env.result);validatePresentationResponse(env);assert.equal(JSON.stringify(env.result),before);\n+  delete env.presentation;validatePresentationResponse(env);assert.equal(Object.hasOwn(env,\"presentation\"),false);\n+});\n+\n+for (const {name,batch} of invalidPresentationBatches()) {\n+  test(`bad present ${name} is atomic in actual network/store ingress and IPC pass-through`, async t => {\n+    const f=network(t); const errors=[]; const unrelated=[];\n+    const pending={resolve(){throw new Error(\"must not ACK\");},reject:e=>errors.push(e)};\n+    const other={resolve(){},reject:e=>unrelated.push(e)};\n+    f.client.pending.set(9,pending); f.client.pending.set(10,other);\n+    const persisted={roomId:7,key:9,kind:\"EndPhase\",createdAt:1}; f.client.persistedPending=persisted;\n+    const beforePending=[...f.client.pending];const beforeChoice=f.client.choice;\n+    f.storage.set(\"noname-next.pending-command\",JSON.stringify(persisted));const beforeStorage=[...f.storage];\n+    f.client.handleMessage(outcome(batch));\n+    assert.equal(f.client.revision,1);assert.equal(f.client.choice,beforeChoice);assert.deepEqual([...f.client.pending],beforePending);\n+    assert.deepEqual([...f.storage],beforeStorage);assert.equal(f.client.persistedPending,persisted);assert.equal(f.envelopes.length,0);assert.equal(errors.length,1);assert.equal(unrelated.length,0);\n+    assert.match(errors[0].message,/结果未确认/);\n+    const store=createViewStore();const before=JSON.stringify(store);\n+    assert.throws(()=>applyEnvelope(store,presentationEnvelope(batch)),/presentation metadata invalid/);assert.equal(JSON.stringify(store),before);\n+    for (const nested of [false,true]) {\n+      const envelope=presentationEnvelope(batch);\n+      const data=nested?{assignment:{seat:0,name:\"liubei\",revision:2,state_hash:\"00\"},envelope}:envelope;\n+      const desktop=new DesktopEngineTransport(async command=>command===\"native_engine_open\"?1:{id:1,ok:true,data});\n+      const reply=await new Promise(resolve=>{desktop.onmessage=({data})=>resolve(data);desktop.postMessage({id:1,type:nested?\"chooseGeneral\":\"autoStep\",seat:0,name:\"liubei\"});});\n+      assert.equal(reply.ok,true);\n+      assert.throws(()=>validatePresentationResponse(reply.data),/presentation metadata invalid/);\n+      desktop.terminate();\n+    }\n+    f.client.dispose();assert.equal(f.client.pending.size,0);\n+  });\n+}\n+\n+test(\"unmatched malformed broadcast does not reject another call or mutate receipt storage\", t => {\n+  const f=network(t);let rejected=0;f.client.pending.set(10,{resolve(){},reject(){rejected++;}});\n+  const old=console.error;const reports=[];console.error=e=>reports.push(e);t.after(()=>{console.error=old;});\n+  f.client.handleMessage(outcome(null,0));assert.equal(rejected,0);assert.equal(f.client.pending.size,1);assert.equal(f.client.revision,1);assert.equal(reports.length,1);\n+});\n+\n+test(\"bounds reject null, >1024 occurrences, >64KiB and typed binding mismatches\", () => {\n+  assert.throws(()=>presentationMetadata(null,2,2));\n+  const b=presentationBatch();b.occurrences=Array.from({length:1025},(_,ordinal)=>({ordinal,event:{kind:\"hp_recovered\",actor:1,amount:1}}));assert.throws(()=>presentationMetadata(b,2,2));\n+  const big=presentationBatch();const voice=big.occurrences[0].event.voice;big.occurrences=Array.from({length:90},(_,ordinal)=>({ordinal,event:{kind:\"player_died\",actor:1,killer:null,voice}}));assert.throws(()=>presentationMetadata(big,2,2));\n+  const p=presentationBatch();const role=p.occurrences[0].event.voice.role;\n+  const owner={kind:\"package\",namespace:\"author\",package_id:\"voice\",version:\"1.0.0\",logic_hash:\"4\".repeat(64),content_hash:\"5\".repeat(64)};\n+  role.owner=owner;role.local_id=42;presentationMetadata(p,2,2);\n+  role.local_id={pack:\"standard\",raw_symbol:\"liubei\"};assert.throws(()=>presentationMetadata(p,2,2));\n+});\n+\n+test(\"new metadata keeps the existing WS256KiB limit before receipt mutation\", t => {\n+  const f=network(t);const errors=[];const pending={resolve(){},reject:e=>errors.push(e)};f.client.pending.set(9,pending);\n+  const message=JSON.parse(outcome(presentationBatch()));message.payload.padding=\"x\".repeat(256*1024);\n+  f.client.handleMessage(JSON.stringify(message));assert.equal(errors.length,1);assert.equal(f.client.pending.get(9),pending);assert.equal(f.client.revision,1);assert.equal(f.envelopes.length,0);\n+});\n+\n+test(\"compat m4a and zero SDK general/skill ids retain concrete leaf semantics\", () => {\n+  const b=presentationBatch();const a=b.occurrences[0].event.voice.assets[0];\n+  a.reference={kind:\"original\",path:\"audio-declared/key/role/die/mugyu.m4a\",source_category:\"compat\",source_path:\"audio/skill/mugyu.m4a\"};\n+  presentationMetadata(b,2,2);\n+  const role=b.occurrences[0].event.voice.role;role.owner={kind:\"package\",namespace:\"author\",package_id:\"voice\",version:\"1\",logic_hash:\"1\".repeat(64),content_hash:\"2\".repeat(64)};role.local_id=0;\n+  presentationMetadata(b,2,2);\n+  const reversed=Object.fromEntries(Object.entries(a).reverse());b.occurrences[0].event.voice.assets.push(reversed);\n+  assert.throws(()=>presentationMetadata(b,2,2));\n+});\n+\n+test(\"malformed conn_seq0 broadcast with a colliding key cannot reject a pending call\", t => {\n+  const f=network(t);let rejected=0;f.client.pending.set(9,{resolve(){},reject(){rejected++;}});\n+  const message=JSON.parse(outcome(null,9));message.payload.header.conn_seq=0;\n+  const old=console.error;console.error=()=>{};t.after(()=>{console.error=old;});\n+  f.client.handleMessage(JSON.stringify(message));assert.equal(rejected,0);assert.equal(f.client.pending.size,1);assert.equal(f.client.revision,1);\n+});\n+\n+test(\"network sequential malformed outcomes retain at most eight original intents and replay no fresh keys\", async t => {\n+  const f=network(t);f.client.playerId=1;f.client.connectionId=4;\n+  const sent=[];f.client.send=message=>sent.push(message);\n+  for(let i=0;i<8;i++) {\n+    const promise=f.client.endPhase();const request=sent.at(-1);\n+    const rejected=assert.rejects(promise,/结果未确认/);\n+    f.client.handleMessage(outcome(null,request.payload.idempotency_key));await rejected;\n+  }\n+  const pending=[...f.client.pending];const storage=[...f.storage];const idem=f.client.idemSeq;const seq=f.client.connSeq;\n+  const ninth=f.client.endPhase();const rejected=assert.rejects(ninth,/not submitted|未提交/);\n+  if (sent.length>8) { // Bound the old broken implementation's otherwise unresolved promise for red evidence.\n+    const request=sent.at(-1);f.client.handleMessage(outcome(null,request.payload.idempotency_key));\n+  }\n+  await rejected;\n+  assert.deepEqual([...f.client.pending],pending);assert.deepEqual([...f.storage],storage);\n+  assert.equal(f.client.idemSeq,idem);assert.equal(f.client.connSeq,seq);assert.equal(sent.length,8);\n+  const keys=pending.map(([key])=>key);f.client.replayPending();\n+  assert.equal(f.client.pending.size,8);assert.deepEqual(sent.slice(8).map(m=>m.payload.idempotency_key),keys);\n+  assert.ok(sent.slice(8).every(m=>m.payload.replay));assert.equal(f.client.idemSeq,idem);\n+  f.client.dispose();assert.equal(f.client.pending.size,0);\n+});\n+\n+test(\"network full retained map cannot admit a missing persisted recovery entry\", t => {\n+  const f=network(t);f.client.playerId=1;const sent=[];f.client.send=message=>sent.push(message);\n+  for(let i=1;i<=8;i++) f.client.pending.set(i,{key:i,kind:\"EndPhase\",resolve(){},reject(){}});\n+  const persisted={roomId:7,key:99,kind:\"EndPhase\",createdAt:1};f.client.persistedPending=persisted;\n+  f.storage.set(\"noname-next.pending-command\",JSON.stringify(persisted));const storage=[...f.storage];\n+  f.client.replayPending();assert.equal(f.client.pending.size,8);\n+  assert.deepEqual(sent.map(m=>m.payload.idempotency_key),[1,2,3,4,5,6,7,8]);\n+  assert.deepEqual([...f.storage],storage);assert.equal(f.client.persistedPending,persisted);\n+});\n+\n+test(\"network legacy successful absence releases capacity and creation does not allocate an intent\", async t => {\n+  const f=network(t);f.client.playerId=1;f.client.connectionId=5;const sent=[];f.client.send=m=>sent.push(m);\n+  const calls=Array.from({length:8},()=>f.client.endPhase());\n+  calls.forEach(p=>p.catch(()=>{})); // Observe earlier calls even if the capacity assertion fails.\n+  const rejected=assert.rejects(f.client.endPhase(),/未提交/);\n+  if(sent.length>8) {const m=sent.at(-1);f.client.handleMessage(outcome(null,m.payload.idempotency_key));}\n+  await rejected;\n+  for(const request of sent.slice(0,8)) {const message=JSON.parse(outcome(undefined,request.payload.idempotency_key));delete message.payload.presentation;f.client.handleMessage(JSON.stringify(message));}\n+  await Promise.all(calls);assert.equal(f.client.pending.size,0);\n+  const idem=f.client.idemSeq;const joined=f.client.createRoom(2,1);assert.equal(f.client.pending.size,0);assert.equal(f.client.idemSeq,idem);\n+  assert.equal(sent.at(-1).type,\"CreateRoom\");f.client.joinWaiter.resolve({roomId:7});f.client.joinWaiter=null;await joined;\n+});\n+\n+test(\"every network product command refuses ninth admission without allocating, sending or replacing storage\", async t => {\n+  const f=network(t);f.client.playerId=1;const sent=[];f.client.send=m=>sent.push(m);\n+  for(let i=1;i<=8;i++) f.client.pending.set(i,{key:i,kind:\"EndPhase\",resolve(){},reject(){}});\n+  const before=[...f.client.pending];const storage=[...f.storage];const idem=f.client.idemSeq;const seq=f.client.connSeq;\n+  const calls=[()=>f.client.endPhase(),()=>f.client.playCard(1,2,[2]),()=>f.client.activateSkill(1,2,[2],[]),\n+    ()=>f.client.useSkillCard(1,2,3,[2],0),()=>f.client.resolveChoice(1,2,[0]),()=>f.client.surrender()];\n+  for(const call of calls) await assert.rejects(call(),error=>/未提交/.test(error.message)&&!/未知|未确认/.test(error.message));\n+  assert.deepEqual([...f.client.pending],before);assert.deepEqual([...f.storage],storage);assert.equal(f.client.idemSeq,idem);assert.equal(f.client.connSeq,seq);assert.equal(sent.length,0);\n+});\n+\n+test(\"network rejoin replays exactly eight retained keys and legacy replies clear them\", async t => {\n+  const f=network(t);f.client.playerId=1;f.client.connectionId=4;const sent=[];f.client.send=m=>sent.push(m);\n+  for(let i=0;i<8;i++) {const p=f.client.endPhase();const request=sent.at(-1);const rejection=assert.rejects(p,/未确认/);f.client.handleMessage(outcome(null,request.payload.idempotency_key));await rejection;}\n+  const keys=[...f.client.pending.keys()];const idem=f.client.idemSeq;\n+  f.client.session={role:\"Player\",roomId:7,reconnectToken:\"token\"};\n+  const joined=f.client.rejoinRoom();assert.equal(sent.at(-1).type,\"JoinRoom\");const offset=sent.length;\n+  f.client.handleMessage(JSON.stringify({type:\"JoinOk\",payload:{room_id:7,player_id:1,seat:0,role:\"Player\",reconnect_token:\"token\",view:presentationView(1),choice:null,legal_actions:[]}}));\n+  await joined;\n+  assert.deepEqual(sent.slice(offset).filter(m=>m.type===\"SubmitCommand\").map(m=>m.payload.idempotency_key),keys);\n+  assert.equal(f.client.pending.size,8);assert.equal(f.client.idemSeq,idem);\n+  for(const key of keys) {const message=JSON.parse(outcome(undefined,key));delete message.payload.presentation;f.client.handleMessage(JSON.stringify(message));}\n+  assert.equal(f.client.pending.size,0);assert.equal(f.client.persistedPending,null);assert.equal(f.storage.size,0);\n+});\n+\n+test(\"network malformed broadcast and wrong-room reply leave retained call unchanged\", t => {\n+  const f=network(t);let rejected=0;const intent={key:9,kind:\"EndPhase\",resolve(){},reject(){rejected++;}};f.client.pending.set(9,intent);\n+  const old=console.error;const reports=[];console.error=e=>reports.push(e);t.after(()=>{console.error=old;});\n+  for(const room of [8,0]) {const message=JSON.parse(outcome(null,9));message.payload.header.room_id=room;f.client.handleMessage(JSON.stringify(message));}\n+  const broadcast=JSON.parse(outcome(null,9));broadcast.payload.header.conn_seq=0;f.client.handleMessage(JSON.stringify(broadcast));\n+  assert.equal(rejected,0);assert.equal(f.client.pending.get(9),intent);assert.equal(f.client.revision,1);assert.equal(reports.length,3);\n+});\n+\n+test(\"raw escaped surrogate cases reject at the actual TS leaf boundary while valid astral pairs pass\", () => {\n+  const good=presentationBatch();good.occurrences[0].event.voice.role.owner.repository=\"repo🐉\";\n+  good.occurrences[0].event.effective.key=\"sha🐉\";good.occurrences[0].event.voice.assets[0].reference.path=\"audio/die/role🐉.mp3\";\n+  assert.deepEqual(presentationMetadata(good,2,2),good);\n+  for(const {name,batch} of surrogatePresentationBatches()) assert.throws(()=>presentationMetadata(batch,2,2),/presentation metadata invalid/,name);\n+});"},{"sha":"a8af7ebcfcc85239e71e059f60f3c3a0fb12bd10","filename":"apps/web-client/src/engine/client.ts","status":"modified","additions":11,"deletions":1,"changes":12,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/apps%2Fweb-client%2Fsrc%2Fengine%2Fclient.ts","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/apps%2Fweb-client%2Fsrc%2Fengine%2Fclient.ts","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/apps%2Fweb-client%2Fsrc%2Fengine%2Fclient.ts?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -1,3 +1,4 @@\n+import { validatePresentationResponse } from \"./presentationMetadata\";\n import type {\n   ChooseGeneralPayload,\n   EngineEnvelope,\n@@ -11,7 +12,7 @@ import type {\n   WorkerResponse,\n } from \"../types/engine\";\n import { desktopContentBundle, isTauriShell } from \"./desktopHost\";\n-import { DesktopEngineTransport, desktopEngineChoice, type EngineTransport } from \"./desktopEngineTransport\";\n+import { DesktopEngineTransport, desktopEngineChoice, MAX_ENGINE_OUTSTANDING, type EngineTransport } from \"./desktopEngineTransport\";\n import {\n   perfRequestSent,\n   perfRequestFailed,\n@@ -102,6 +103,10 @@ export class EngineClient {\n       const p = this.pending.get(msg.id);\n       // SAB 提前应用后 pending 已删除——此时跳过计时与重复应用\n       if (!p) return;\n+      if (msg.ok) {\n+        try { validatePresentationResponse(msg.data); }\n+        catch (error) { p.reject(new Error(`Worker 协议错误，操作结果未确认: ${String(error)}`)); return; }\n+      }\n       perfResponseReceived(msg.id);\n       this.pending.delete(msg.id);\n       (globalThis as unknown as { __latencySabDebug?: { settle?: () => void } })\n@@ -186,6 +191,10 @@ export class EngineClient {\n             };\n             const p = this.pending.get(resp.id);\n             if (p) {\n+              if (resp.ok) {\n+                try { validatePresentationResponse(resp.data); }\n+                catch (error) { p.reject(new Error(`Worker 协议错误，操作结果未确认: ${String(error)}`)); throw error; }\n+              }\n               perfResponseReceived(resp.id);\n               this.pending.delete(resp.id);\n               settle();\n@@ -251,6 +260,7 @@ export class EngineClient {\n \n   private request(body: WorkerRequest): Promise<unknown> {\n     if (!this.worker) return Promise.reject(new Error(\"worker not connected\"));\n+    if (this.pending.size >= MAX_ENGINE_OUTSTANDING) return Promise.reject(new Error(\"Engine busy; request was not submitted（未提交）\"));\n     return new Promise((resolve, reject) => {\n       this.pending.set(body.id, { resolve, reject });\n       perfRequestSent(body.id, body.type);"},{"sha":"683ccc8c5a5817ca06c68e11f644c4eefd1ae688","filename":"apps/web-client/src/engine/desktopEngineTransport.ts","status":"modified","additions":6,"deletions":2,"changes":8,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/apps%2Fweb-client%2Fsrc%2Fengine%2FdesktopEngineTransport.ts","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/apps%2Fweb-client%2Fsrc%2Fengine%2FdesktopEngineTransport.ts","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/apps%2Fweb-client%2Fsrc%2Fengine%2FdesktopEngineTransport.ts?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -1,3 +1,4 @@\n+import { validatePresentationResponse } from \"./presentationMetadata\";\n import { invoke } from \"@tauri-apps/api/core\";\n import { urlParam } from \"./autoDrive\";\n import { validateObserverMetadata } from \"./observerMetadata\";\n@@ -17,7 +18,7 @@ type Invoke = <T>(command: string, args?: Record<string, unknown>) => Promise<T>\n export const DESKTOP_ENGINE_KEY = \"noname-next-desktop-engine\";\n export type DesktopEngineChoice = \"wasm\" | \"native\";\n // Match the native queue capacity, conservatively including active/opening requests.\n-const MAX_DESKTOP_OUTSTANDING = 8;\n+export const MAX_ENGINE_OUTSTANDING = 8;\n \n /** Wasm stays the default until all six PA09 conditions have evidence. */\n export function desktopEngineChoice(): DesktopEngineChoice {\n@@ -35,6 +36,9 @@ function normalizeEnvelope(envelope: EngineEnvelope): EngineEnvelope {\n /** Normalize only the two existing local response locations; network envelopes never enter here. */\n function normalizeResponse(response: WorkerResponse, request: WorkerRequest): WorkerResponse {\n   if (!response.ok || !response.data || typeof response.data !== \"object\") return response;\n+  // Preserve malformed presentation for EngineClient before observer normalization can turn it into ordinary cleanup.\n+  try { validatePresentationResponse(response.data); }\n+  catch { return response; }\n   if (request.type === \"chooseGeneral\") {\n     const data = response.data as ChooseGeneralPayload;\n     if (data.envelope?.view) return { ...response, data: { ...data, envelope: normalizeEnvelope(data.envelope) } };\n@@ -58,7 +62,7 @@ export class DesktopEngineTransport implements EngineTransport {\n \n   postMessage(request: WorkerRequest): void {\n     if (this.closed) throw new Error(\"Desktop engine transport closed\");\n-    if (this.outstanding >= MAX_DESKTOP_OUTSTANDING) {\n+    if (this.outstanding >= MAX_ENGINE_OUTSTANDING) {\n       throw new Error(\"Desktop engine busy; request was not submitted（未提交）\");\n     }\n     this.outstanding++;"},{"sha":"ffd48d8971fc5af8c5669f668599c620dab6186c","filename":"apps/web-client/src/engine/networkClient.ts","status":"modified","additions":22,"deletions":1,"changes":23,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/apps%2Fweb-client%2Fsrc%2Fengine%2FnetworkClient.ts","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/apps%2Fweb-client%2Fsrc%2Fengine%2FnetworkClient.ts","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/apps%2Fweb-client%2Fsrc%2Fengine%2FnetworkClient.ts?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -1,3 +1,5 @@\n+import { MAX_ENGINE_OUTSTANDING } from \"./desktopEngineTransport\";\n+import { presentationMetadata } from \"./presentationMetadata\";\n import { validateObserverMetadata } from \"./observerMetadata\";\n import { publicEventLabel } from \"./publicEvents\";\n import type {\n@@ -425,6 +427,7 @@ export class NetworkEngineClient {\n     if (!this.roomId || !this.playerId) {\n       return Promise.reject(new Error(\"当前不是已入座玩家\"));\n     }\n+    if (this.pending.size >= MAX_ENGINE_OUTSTANDING) return Promise.reject(new Error(\"Engine busy; request was not submitted（未提交）\"));\n     const key = this.connectionId * 1_000_000 + this.idemSeq++;\n     let intent!: PendingCommand;\n     const promise = new Promise<EngineEnvelope>((resolve, reject) => {\n@@ -470,7 +473,7 @@ export class NetworkEngineClient {\n       this.persistedPending && this.persistedPending.roomId === this.roomId\n         ? this.persistedPending\n         : null;\n-    if (persisted && !this.pending.has(persisted.key)) {\n+    if (persisted && !this.pending.has(persisted.key) && this.pending.size < MAX_ENGINE_OUTSTANDING) {\n       // 页面刷新后的新实例没有旧 Promise；用占位 pending 承接服务端回执，\n       // 并通过 envelope 监听者把权威结果交回界面。\n       const intent: PendingCommand = {\n@@ -519,6 +522,23 @@ export class NetworkEngineClient {\n       return;\n     }\n     const payload = message.payload ?? {};\n+    if (Object.hasOwn(payload, \"presentation\")) {\n+      try {\n+        if (new TextEncoder().encode(json).length > 256 * 1024) throw new Error(\"presentation envelope exceeds 256KiB\");\n+        if (message.type !== \"CommandOutcome\" || !payload.view) throw new Error(\"unexpected presentation location\");\n+        const view = payload.view as ObserverSnapshot;\n+        presentationMetadata(payload.presentation, view.revision, view.seats.length);\n+      } catch (error) {\n+        const failure = new Error(`服务端呈现元数据无效，操作结果未确认: ${String(error)}`);\n+        const key = payload.idempotency_key;\n+        const header = payload.header as Partial<MessageHeader> | undefined;\n+        const matchingReply = header?.room_id === this.roomId && typeof header.conn_seq === \"number\" && Number.isSafeInteger(header.conn_seq) && header.conn_seq > 0;\n+        const call = matchingReply && typeof key === \"number\" && Number.isSafeInteger(key) && key > 0 ? this.pending.get(key) : undefined;\n+        if (call) call.reject(failure);\n+        else console.error(failure.message);\n+        return;\n+      }\n+    }\n     if (payload.view) {\n       try { validateObserverMetadata(payload.view as ObserverSnapshot, (payload.choice as ChoiceRequest | null) ?? null); }\n       catch (error) { this.rejectOutstanding(new Error(`服务端元数据无效：${String(error)}`)); return; }\n@@ -639,6 +659,7 @@ export class NetworkEngineClient {\n       (payload.legal_actions as LegalAction[] | undefined) ?? [],\n       payload.result ?? null\n     );\n+    if (Object.hasOwn(payload, \"presentation\")) envelope.presentation = presentationMetadata(payload.presentation, view.revision, view.seats.length);\n     const key = Number(payload.idempotency_key ?? 0);\n     clearPendingStorage(key);\n     if (this.persistedPending?.key === key) this.persistedPending = null;"},{"sha":"e0b7b7d3727832fdacb68edcba73bce5f1012869","filename":"apps/web-client/src/engine/presentationMetadata.ts","status":"added","additions":107,"deletions":0,"changes":107,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/apps%2Fweb-client%2Fsrc%2Fengine%2FpresentationMetadata.ts","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/apps%2Fweb-client%2Fsrc%2Fengine%2FpresentationMetadata.ts","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/apps%2Fweb-client%2Fsrc%2Fengine%2FpresentationMetadata.ts?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1,107 @@\n+import type { PublicPresentationBatch } from \"../types/presentation\";\n+\n+function check(ok: unknown): asserts ok { if (!ok) throw new Error(\"native: public presentation metadata invalid\"); }\n+function object(v: unknown, keys: string[]): Record<string, any> {\n+  check(v && typeof v === \"object\" && !Array.isArray(v));\n+  const o = v as Record<string, any>;\n+  check(Object.keys(o).length === keys.length && keys.every(k => Object.hasOwn(o, k)));\n+  return o;\n+}\n+function integer(v: unknown, max = 0xffffffff, min = 0): v is number { return typeof v === \"number\" && Number.isSafeInteger(v) && v >= min && v <= max; }\n+// Unicode-mode surrogate ranges reject lone UTF-16 code units while preserving valid astral pairs.\n+function token(v: unknown): v is string { return typeof v === \"string\" && v.length > 0 && new TextEncoder().encode(v).length <= 256 && v !== \".\" && v !== \"..\" && !/[\\\\/%?#:\\^@-\\^_\\u007f-\\^_\\ud800-\\udfff]/u.test(v); }\n+function path(v: unknown): v is string { return typeof v === \"string\" && new TextEncoder().encode(v).length <= 256 && v.split(\"/\").every(token); }\n+function hex(v: unknown, n = 64): boolean { return typeof v === \"string\" && v.length === n && /^[a-f0-9]+$/.test(v); }\n+// Exact shared policy: C0/C1 controls, Unicode White_Space, BOM, and backslash.\n+function repository(v: unknown): boolean { return typeof v === \"string\" && v.length > 0 && new TextEncoder().encode(v).length <= 256 && !/[\\^@-\\u0020\\u007f-\\u00a0\\u1680\\u2000-\\u200a\\u2028-\\u2029\\u202f\\u205f\\u3000\\ufeff\\ud800-\\udfff\\\\]/u.test(v); }\n+function owner(v: unknown): void {\n+  const kind = (v as any)?.kind;\n+  if (kind === \"package\") {\n+    const o = object(v, [\"kind\", \"namespace\", \"package_id\", \"version\", \"logic_hash\", \"content_hash\"]);\n+    check(token(o.namespace) && token(o.package_id) && token(o.version) && hex(o.logic_hash) && hex(o.content_hash));\n+  } else {\n+    const o = object(v, [\"kind\", \"repository\", \"adopted_revision\", \"catalog_sha256\", \"asset_manifest_sha256\"]);\n+    check(kind === \"original\" && repository(o.repository) && hex(o.adopted_revision, 40) && hex(o.catalog_sha256) && hex(o.asset_manifest_sha256));\n+  }\n+}\n+function definition(v: unknown, kind: string): void {\n+  const o = object(v, [\"owner\", \"kind\", \"local_id\"]); owner(o.owner); check(o.kind === kind);\n+  if (o.owner.kind === \"package\") check(integer(o.local_id, 0xffffffff, kind === \"card\" ? 1 : 0));\n+  else { const id = object(o.local_id, [\"pack\", \"raw_symbol\"]); check(token(id.pack) && token(id.raw_symbol)); }\n+}\n+function asset(v: unknown): void {\n+  const o = object(v, [\"source\", \"reference\", \"digest_algorithm\", \"digest\", \"size\"]); owner(o.source);\n+  check(hex(o.digest) && integer(o.size, Number.MAX_SAFE_INTEGER, 1));\n+  if (o.source.kind === \"package\") {\n+    const ref = object(o.reference, [\"kind\", \"namespace\", \"package_id\", \"asset_id\"]);\n+    check(ref.kind === \"package\" && ref.namespace === o.source.namespace && ref.package_id === o.source.package_id && token(ref.asset_id) && o.digest_algorithm === \"blake3\");\n+  } else {\n+    const ref = object(o.reference, [\"kind\", \"path\", \"source_category\", \"source_path\"]);\n+    check(ref.kind === \"original\" && path(ref.path) && (ref.path.startsWith(\"audio-declared/\") || ref.path.startsWith(\"audio/\") || ref.path.startsWith(\"audio-compat/\")) && path(ref.source_path) && ref.source_path.startsWith(\"audio/\") && [\"core\", \"compat\"].includes(ref.source_category) && o.digest_algorithm === \"sha256\");\n+  }\n+}\n+function voice(v: unknown): void {\n+  if (v === null) return;\n+  const o = object(v, [\"role\", \"form\", \"assets\"]); definition(o.role, \"general\");\n+  check(o.form === null || token(o.form));\n+  check(Array.isArray(o.assets) && o.assets.length > 0 && o.assets.length <= 1024);\n+  o.assets.forEach(asset);\n+  const keys = o.assets.map((a: any) => JSON.stringify([\n+    a.source.kind, a.source.namespace, a.source.package_id, a.source.version, a.source.logic_hash, a.source.content_hash,\n+    a.source.repository, a.source.adopted_revision, a.source.catalog_sha256, a.source.asset_manifest_sha256,\n+    a.reference.kind, a.reference.namespace, a.reference.package_id, a.reference.asset_id, a.reference.path,\n+    a.reference.source_category, a.reference.source_path, a.digest_algorithm, a.digest, a.size,\n+  ]));\n+  check(new Set(keys).size === o.assets.length);\n+}\n+const NATURES = [\"normal\", \"fire\", \"thunder\"];\n+function effective(v: unknown): void { const o = object(v, [\"kind\", \"key\", \"nature\"]); check(CARD_KINDS.includes(o.kind) && token(o.key) && NATURES.includes(o.nature)); }\n+function event(v: unknown, players: number): void {\n+  const kind = (v as any)?.kind;\n+  const fields: Record<string, string[]> = {\n+    card_used: [\"actor\", \"targets\", \"effective\", \"voice\"], card_responded: [\"actor\", \"effective\", \"voice\"],\n+    skill_activated: [\"actor\", \"skill\", \"targets\", \"voice\"], damage_dealt: [\"source\", \"target\", \"amount\", \"nature\"],\n+    damage_prevented: [\"source\", \"target\", \"nature\"], hp_recovered: [\"actor\", \"amount\"], player_died: [\"actor\", \"killer\", \"voice\"],\n+  };\n+  check(typeof kind === \"string\" && Object.hasOwn(fields, kind)); const o = object(v, [\"kind\", ...fields[kind]]);\n+  for (const key of [\"actor\", \"target\"]) if (Object.hasOwn(o, key)) check(integer(o[key], players, 1));\n+  for (const key of [\"source\", \"killer\"]) if (Object.hasOwn(o, key)) check(o[key] === null || integer(o[key], players, 1));\n+  if (Object.hasOwn(o, \"amount\")) check(integer(o.amount, 0xffffffff, 1));\n+  if (Object.hasOwn(o, \"nature\")) check(NATURES.includes(o.nature));\n+  if (Object.hasOwn(o, \"voice\")) voice(o.voice);\n+  if (Object.hasOwn(o, \"effective\")) effective(o.effective);\n+  if (Object.hasOwn(o, \"targets\") && o.targets !== null) check(Array.isArray(o.targets) && o.targets.length <= 16 && o.targets.every((p: unknown) => integer(p, players, 1)) && new Set(o.targets).size === o.targets.length);\n+  if (Object.hasOwn(o, \"skill\")) definition(object(o.skill, [\"definition\"]).definition, \"skill\");\n+}\n+\n+/** Absent is legacy compatible; present data is validated before any recipient mutation. */\n+export function presentationMetadata(value: unknown, revision: number, players: number): PublicPresentationBatch | undefined {\n+  if (value === undefined) return undefined;\n+  const o = object(value, [\"revision\", \"status\", \"unavailable\", \"occurrences\"]);\n+  check(integer(o.revision, Number.MAX_SAFE_INTEGER) && o.revision === revision && [\"complete\", \"incomplete\", \"overflow\"].includes(o.status));\n+  check(new TextEncoder().encode(JSON.stringify(value)).length <= 65536);\n+  check(Array.isArray(o.unavailable) && o.unavailable.length <= 28);\n+  for (const item of o.unavailable) {\n+    const scope = object(item, [\"domain\", \"reason\"]);\n+    check([\"card_use\", \"card_response\", \"skill_activation\", \"damage\", \"recovery\", \"death\", \"voice_identity\"].includes(scope.domain));\n+    check([\"source_no_audio_discriminator\", \"commit_boundary_unproved\", \"verified_binding_missing\", \"public_binding_unavailable\"].includes(scope.reason));\n+  }\n+  check(new Set(o.unavailable.map((v: any) => `${v.domain}:${v.reason}`)).size === o.unavailable.length);\n+  check(o.status !== \"complete\" || o.unavailable.length === 0);\n+  check(Array.isArray(o.occurrences) && o.occurrences.length <= 1024 && (o.status !== \"overflow\" || o.occurrences.length === 0));\n+  o.occurrences.forEach((item: unknown, index: number) => { const entry = object(item, [\"ordinal\", \"event\"]); check(entry.ordinal === index); event(entry.event, players); });\n+  return value as PublicPresentationBatch;\n+}\n+\n+/** Validate only actual envelope response locations, including nested chooseGeneral. */\n+export function validatePresentationResponse(value: unknown): void {\n+  if (!value || typeof value !== \"object\") return;\n+  const o = value as Record<string, any>;\n+  if (Object.hasOwn(o, \"presentation\")) {\n+    check(o.presentation !== undefined && o.view && Array.isArray(o.view.seats));\n+    check(o.revision === undefined || o.revision === o.view.revision);\n+    presentationMetadata(o.presentation, o.revision ?? o.view.revision, o.view.seats.length);\n+  }\n+  if (Object.hasOwn(o, \"envelope\")) validatePresentationResponse(o.envelope);\n+}\n+const CARD_KINDS: string[] = [\"sha\", \"shan\", \"tao\", \"horse_plus\", \"horse_minus\", \"weapon\", \"armor\", \"huosha\", \"tiesuo\", \"nanman\", \"wanjian\", \"juedou\", \"wuxie\", \"lebu\", \"bingliang\", \"shandian\", \"guohe\", \"shunshou\", \"jiu\", \"leisha\", \"shoulijian\", \"wuxingpan\", \"wangmeizhike\", \"sanjian\", \"shuigong\", \"fudichouxin\", \"chenhuodajie\", \"suolianjia\", \"hongshui\", \"toulianghuanzhu\", \"linghunzhihuo\", \"zhaomingdan\", \"jihuocard\", \"youdishenru\", \"geanguanhuo\", \"caochuanjiejian\", \"shezhanqunru\", \"shujinsan\", \"mianlijinzhen\", \"feibiao\", \"jinlianzhu\", \"tanhuadong\", \"yougeng\", \"qingtuan\", \"yuanbaorou\", \"gudonggeng\", \"mapodoufu\", \"chunbing\", \"liyutang\", \"molicha\", \"xiajiao\", \"mizhilianou\", \"luyugeng\", \"bingpotong\", \"qiankunbiao\", \"longxugou\", \"shenhuofeiya\", \"ziyangdan\", \"yunvyuanshen\", \"shihuifen\", \"liufengsan\", \"shatang\", \"heilonglinpian\", \"liutouge\", \"mutoumianju\", \"dinvxuanshuang\", \"gjyuheng\", \"dunpaigedang\", \"zhiliaobo\", \"yuansuhuimie\", \"xingjiegoutong\", \"chuansongmen\", \"tanshezhiren\", \"shijieshu\", \"yanziyaoshui\", \"aozuzhilei\", \"wenyi\", \"zhihuanjun\", \"baoxueyaoshui\", \"qinpendayu\", \"birinongwu\", \"ciguhanshuang\", \"kunenfayin\", \"shanbengshu\", \"poxiao\", \"zumoshoukao\", \"monkey\", \"xuelunyang\", \"mianju\", \"jiuwei\", \"wuzhong\", \"taoyuan\", \"wugu\", \"jiedao\", \"renwang\", \"qinggang\", \"xuanyuanjian\", \"qilin\", \"hanbing\", \"zhuge\", \"guanshi\", \"qinglong\", \"zhangba\", \"cixiong\", \"fangtian\", \"hufu\", \"liuxinghuoyu\", \"caoyao\", \"chilongya\", \"tianxianjiu\", \"xixueguizhihuan\", \"guiyoujie\", \"shentoumianju\", \"xingjunyan\", \"qinglonglingzhu\", \"zhufangshenshi\", \"fengxueren\", \"yufulu\", \"yangpijuan\", \"daihuofenglun\", \"xiayuncailing\", \"langeguaiyi\", \"longlushanfeng\", \"haidao\", \"shuimomuxue\", \"feixu\", \"yixialan\", \"shamolvzhou\", \"linzhongjianta\", \"bingheyaosai\", \"youlin\", \"lindixiliu\", \"dizaizhen\", \"jiguan\", \"xuejibingbao\", \"shenmiguo\", \"fengyinzhidan\", \"lianyaohu\", \"qiankundai\", \"shennongding\", \"nvwashi\", \"kunlunjingc\", \"donghuangzhong\", \"kongdongyin\", \"jingleishan\", \"chiyuxi\", \"guisheqi\", \"xianluhui\", \"guilingzhitao\", \"sifeizhenmian\", \"shuchui\", \"sadengjinhuan\", \"haotianta\", \"yuruyi\", \"yuchanqian\", \"yuchankun\", \"yuchanzhen\", \"yuchanxun\", \"yuchankan\", \"yuchanli\", \"yuchangen\", \"yuchandui\", \"shencaojie\", \"qinglongzhigui\", \"zhuquezhizhang\", \"baishouzhihu\", \"xuanwuzhihuang\", \"huanglinzhicong\", \"hslingjian\", \"tianfuzhen\", \"qixingzhen\", \"niaoxiangzhen\", \"changshezhen\", \"pozhenjue\"];"},{"sha":"ac05ca9e6abb7150febc3e168be19f79602e5665","filename":"apps/web-client/src/engine/viewStore.ts","status":"modified","additions":2,"deletions":0,"changes":2,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/apps%2Fweb-client%2Fsrc%2Fengine%2FviewStore.ts","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/apps%2Fweb-client%2Fsrc%2Fengine%2FviewStore.ts","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/apps%2Fweb-client%2Fsrc%2Fengine%2FviewStore.ts?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -1,3 +1,4 @@\n+import { validatePresentationResponse } from \"./presentationMetadata\";\n import { reactive } from \"vue\";\n import type { ChoiceRequest, EngineEnvelope, LegalAction, ObserverSnapshot } from \"../types/engine\";\n import { perfEnvelopeApplied, perfEnvelopeApplying } from \"./perfProbe\";\n@@ -68,6 +69,7 @@ export function createViewStore(): ViewState {\n let effectId = 1;\n \n export function applyEnvelope(store: ViewState, env: EngineEnvelope) {\n+  validatePresentationResponse(env);\n   // 表现层性能采样（默认关闭时立即返回）：记录应用信封、DOM 刷新与下一帧时刻。\n   perfEnvelopeApplying();\n   applyEnvelopeState(store, env);"},{"sha":"57802793813dd39d363fac06e91cdfb32fa39339","filename":"apps/web-client/src/types/engine.ts","status":"modified","additions":2,"deletions":0,"changes":2,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/apps%2Fweb-client%2Fsrc%2Ftypes%2Fengine.ts","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/apps%2Fweb-client%2Fsrc%2Ftypes%2Fengine.ts","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/apps%2Fweb-client%2Fsrc%2Ftypes%2Fengine.ts?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -1,4 +1,5 @@\n /** Shared engine / observer types (mirrors engine-api JSON). */\n+import type { PublicPresentationBatch } from \"./presentation\";\n \n export type PlayerId = number;\n export type CardId = number;\n@@ -104,6 +105,7 @@ export interface ChoiceRequest {\n export interface EngineEnvelope {\n   result: unknown;\n   events: unknown[];\n+  presentation?: PublicPresentationBatch;\n   choice: ChoiceRequest | null;\n   view: ObserverSnapshot;\n   legal_actions: LegalAction[];"},{"sha":"58d27f2cd1f0e0afaddc9d4283dca6501330df4e","filename":"apps/web-client/src/types/presentation.ts","status":"added","additions":30,"deletions":0,"changes":30,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/apps%2Fweb-client%2Fsrc%2Ftypes%2Fpresentation.ts","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/apps%2Fweb-client%2Fsrc%2Ftypes%2Fpresentation.ts","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/apps%2Fweb-client%2Fsrc%2Ftypes%2Fpresentation.ts?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1,30 @@\n+/** Frozen leaf data; producer disclosure and resource membership are separate responsibilities. */\n+export type FrozenOwnerKey =\n+  | { kind: \"package\"; namespace: string; package_id: string; version: string; logic_hash: string; content_hash: string }\n+  | { kind: \"original\"; repository: string; adopted_revision: string; catalog_sha256: string; asset_manifest_sha256: string };\n+export type QualifiedDefinitionKey =\n+  | { owner: Extract<FrozenOwnerKey, {kind: \"package\"}>; kind: \"general\" | \"skill\" | \"card\"; local_id: number }\n+  | { owner: Extract<FrozenOwnerKey, {kind: \"original\"}>; kind: \"general\" | \"skill\" | \"card\"; local_id: {pack: string; raw_symbol: string} };\n+export type BoundAudioAsset = {\n+  source: FrozenOwnerKey;\n+  reference: {kind: \"package\"; namespace: string; package_id: string; asset_id: string}\n+    | {kind: \"original\"; path: string; source_category: \"core\" | \"compat\"; source_path: string};\n+  digest_algorithm: \"sha256\" | \"blake3\"; digest: string; size: number;\n+};\n+export type PublicVoice = { role: QualifiedDefinitionKey; form: string | null; assets: BoundAudioAsset[] };\n+export type PresentationNature = \"normal\" | \"fire\" | \"thunder\";\n+export type EffectivePresentationCard = {kind: string; key: string; nature: PresentationNature};\n+export type PublicPresentationEvent =\n+  | {kind: \"card_used\"; actor: number; targets: number[] | null; effective: EffectivePresentationCard; voice: PublicVoice | null}\n+  | {kind: \"card_responded\"; actor: number; effective: EffectivePresentationCard; voice: PublicVoice | null}\n+  | {kind: \"skill_activated\"; actor: number; skill: {definition: QualifiedDefinitionKey}; targets: number[] | null; voice: PublicVoice | null}\n+  | {kind: \"damage_dealt\"; source: number | null; target: number; amount: number; nature: PresentationNature}\n+  | {kind: \"damage_prevented\"; source: number | null; target: number; nature: PresentationNature}\n+  | {kind: \"hp_recovered\"; actor: number; amount: number}\n+  | {kind: \"player_died\"; actor: number; killer: number | null; voice: PublicVoice | null};\n+export type PresentationDomain = \"card_use\" | \"card_response\" | \"skill_activation\" | \"damage\" | \"recovery\" | \"death\" | \"voice_identity\";\n+export type PublicPresentationBatch = {\n+  revision: number; status: \"complete\" | \"incomplete\" | \"overflow\";\n+  unavailable: {domain: PresentationDomain; reason: \"source_no_audio_discriminator\" | \"commit_boundary_unproved\" | \"verified_binding_missing\" | \"public_binding_unavailable\"}[];\n+  occurrences: {ordinal: number; event: PublicPresentationEvent}[];\n+};"},{"sha":"90873bbb780bfe8d4fe14d8b3ebe682a10e13990","filename":"crates/engine-api/src/lib.rs","status":"modified","additions":2,"deletions":0,"changes":2,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/crates%2Fengine-api%2Fsrc%2Flib.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/crates%2Fengine-api%2Fsrc%2Flib.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/crates%2Fengine-api%2Fsrc%2Flib.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -11,6 +11,7 @@ mod event;\n mod ids;\n mod manifest;\n mod outcome;\n+mod presentation;\n mod version;\n mod view;\n \n@@ -20,6 +21,7 @@ pub use event::*;\n pub use ids::*;\n pub use manifest::*;\n pub use outcome::*;\n+pub use presentation::*;\n pub use version::*;\n pub use view::*;\n "},{"sha":"83f7a99ee43ed3583558c43489cd0f999088e5ea","filename":"crates/engine-api/src/presentation.rs","status":"added","additions":382,"deletions":0,"changes":382,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/crates%2Fengine-api%2Fsrc%2Fpresentation.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/crates%2Fengine-api%2Fsrc%2Fpresentation.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/crates%2Fengine-api%2Fsrc%2Fpresentation.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1,382 @@\n+//! Optional public presentation data. Structure is not proof of producer disclosure authority.\n+use crate::PlayerId;\n+use serde::{Deserialize, Deserializer, Serialize};\n+\n+/// Maximum committed public occurrences in one batch.\n+pub const MAX_PRESENTATION_OCCURRENCES: usize = 1024;\n+/// Maximum encoded batch size at transport boundaries.\n+pub const MAX_PRESENTATION_BYTES: usize = 64 * 1024;\n+/// Largest integer exactly representable by every supported JSON consumer.\n+pub const MAX_PRESENTATION_REVISION: u64 = 9_007_199_254_740_991;\n+\n+/// An exact frozen resource owner, without granting runtime authority.\n+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\n+#[serde(tag = \"kind\", rename_all = \"snake_case\", deny_unknown_fields)]\n+pub enum FrozenOwnerKey {\n+    /// Existing LockedPackage identity fields.\n+    Package {\n+        /// Package namespace.\n+        namespace: String,\n+        /// Package slot.\n+        package_id: String,\n+        /// Exact installed version.\n+        version: String,\n+        /// BLAKE3 semantic hash.\n+        logic_hash: String,\n+        /// BLAKE3 original package byte hash.\n+        content_hash: String,\n+    },\n+    /// Pins for imported original presentation inputs.\n+    Original {\n+        /// Explicit repository identifier.\n+        repository: String,\n+        /// Adopted source commit.\n+        adopted_revision: String,\n+        /// SHA256 of the frozen catalog bytes.\n+        catalog_sha256: String,\n+        /// SHA256 of the frozen manifest bytes.\n+        asset_manifest_sha256: String,\n+    },\n+}\n+\n+/// Genuine definition category.\n+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]\n+#[serde(rename_all = \"snake_case\")]\n+pub enum PresentationDefinitionKind {\n+    /// General definition.\n+    General,\n+    /// Skill definition.\n+    Skill,\n+    /// Card definition.\n+    Card,\n+}\n+\n+/// An original source symbol, never a translated name.\n+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\n+#[serde(deny_unknown_fields)]\n+pub struct OriginalDefinitionKey {\n+    /// Source pack.\n+    pub pack: String,\n+    /// Raw source symbol.\n+    pub raw_symbol: String,\n+}\n+\n+/// Package-local numeric identity or explicit original source symbol.\n+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\n+#[serde(untagged)]\n+pub enum PresentationLocalId {\n+    /// Existing SDK definition id; zero rules follow the definition category.\n+    Package(u32),\n+    /// Exact imported symbol, valid only with an original owner.\n+    Original(OriginalDefinitionKey),\n+}\n+\n+/// Qualified definition identity; numeric runtime indexes are not resource bindings.\n+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\n+#[serde(deny_unknown_fields)]\n+pub struct QualifiedDefinitionKey {\n+    /// Frozen owner.\n+    pub owner: FrozenOwnerKey,\n+    /// Definition category.\n+    pub kind: PresentationDefinitionKind,\n+    /// Local id whose representation must match the owner.\n+    pub local_id: PresentationLocalId,\n+}\n+\n+/// Exact existing asset reference shape, selected by source category.\n+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\n+#[serde(tag = \"kind\", rename_all = \"snake_case\", deny_unknown_fields)]\n+pub enum PresentationAssetRef {\n+    /// Existing ActiveAssetRef fields.\n+    Package {\n+        /// Namespace owning the asset.\n+        namespace: String,\n+        /// Package owning the asset.\n+        package_id: String,\n+        /// Package-local asset id.\n+        asset_id: String,\n+    },\n+    /// Existing original alias/backing reference.\n+    Original {\n+        /// Canonical manifest path.\n+        path: String,\n+        /// Core or verified compatibility backing.\n+        source_category: OriginalAudioCategory,\n+        /// Source-relative backing path.\n+        source_path: String,\n+    },\n+}\n+\n+/// Existing original audio backing categories.\n+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]\n+#[serde(rename_all = \"snake_case\")]\n+pub enum OriginalAudioCategory {\n+    /// Canonical original payload.\n+    Core,\n+    /// Verified compatibility derivative.\n+    Compat,\n+}\n+\n+/// Payload digest algorithm, not the aggregate asset hash.\n+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]\n+#[serde(rename_all = \"lowercase\")]\n+pub enum PresentationDigestAlgorithm {\n+    /// Original payload digest.\n+    Sha256,\n+    /// Package manifest payload digest.\n+    Blake3,\n+}\n+\n+/// A frozen audio payload; membership is checked by the future verified resolver.\n+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\n+#[serde(deny_unknown_fields)]\n+pub struct BoundAudioAsset {\n+    /// Explicit frozen source (including dependency assets).\n+    pub source: FrozenOwnerKey,\n+    /// Exact resource reference.\n+    pub reference: PresentationAssetRef,\n+    /// Payload hash algorithm.\n+    pub digest_algorithm: PresentationDigestAlgorithm,\n+    /// Lowercase hexadecimal payload digest.\n+    pub digest: String,\n+    /// Positive payload byte length.\n+    pub size: u64,\n+}\n+\n+/// Public occurrence-time speaker declaration, not a cryptographic certificate.\n+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\n+#[serde(deny_unknown_fields)]\n+pub struct PublicVoice {\n+    /// Qualified genuine general definition.\n+    pub role: QualifiedDefinitionKey,\n+    /// Public form, or explicit null for the base role.\n+    #[serde(deserialize_with = \"required_nullable\")]\n+    pub form: Option<String>,\n+    /// Ordered payload candidates.\n+    pub assets: Vec<BoundAudioAsset>,\n+}\n+\n+/// Actual effective card identity after validation and view-as conversion.\n+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\n+#[serde(deny_unknown_fields)]\n+pub struct EffectivePresentationCard {\n+    /// Existing CardKind key, distinct from physical name and audio basename.\n+    pub kind: String,\n+    /// Committed public use name.\n+    pub key: String,\n+    /// Actual damage nature.\n+    pub nature: PresentationNature,\n+}\n+\n+/// Public modeled card/damage natures.\n+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]\n+#[serde(rename_all = \"snake_case\")]\n+pub enum PresentationNature {\n+    /// Normal.\n+    Normal,\n+    /// Fire.\n+    Fire,\n+    /// Thunder.\n+    Thunder,\n+}\n+\n+/// Committed skill identity, without a prompt/source_skill shortcut.\n+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\n+#[serde(deny_unknown_fields)]\n+pub struct PublicPresentationSkill {\n+    /// Qualified skill definition.\n+    pub definition: QualifiedDefinitionKey,\n+}\n+\n+/// Seven public committed occurrence types; producers are not implemented by these DTOs.\n+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\n+#[serde(tag = \"kind\", rename_all = \"snake_case\", deny_unknown_fields)]\n+pub enum PublicPresentationEvent {\n+    /// An effective card was used.\n+    CardUsed {\n+        /// API player id (one based).\n+        actor: PlayerId,\n+        /// Public targets, or explicit null when unavailable.\n+        #[serde(deserialize_with = \"required_nullable\")]\n+        targets: Option<Vec<PlayerId>>,\n+        /// Effective card.\n+        effective: EffectivePresentationCard,\n+        /// Public speaker or explicit null.\n+        #[serde(deserialize_with = \"required_nullable\")]\n+        voice: Option<PublicVoice>,\n+    },\n+    /// An effective card was responded.\n+    CardResponded {\n+        /// API player id.\n+        actor: PlayerId,\n+        /// Effective response.\n+        effective: EffectivePresentationCard,\n+        /// Public speaker or explicit null.\n+        #[serde(deserialize_with = \"required_nullable\")]\n+        voice: Option<PublicVoice>,\n+    },\n+    /// A genuine skill activation committed.\n+    SkillActivated {\n+        /// API player id.\n+        actor: PlayerId,\n+        /// Genuine qualified skill.\n+        skill: PublicPresentationSkill,\n+        /// Public targets or explicit null.\n+        #[serde(deserialize_with = \"required_nullable\")]\n+        targets: Option<Vec<PlayerId>>,\n+        /// Public speaker or explicit null.\n+        #[serde(deserialize_with = \"required_nullable\")]\n+        voice: Option<PublicVoice>,\n+    },\n+    /// Actual positive damage dealt.\n+    DamageDealt {\n+        /// Public source or explicit null.\n+        #[serde(deserialize_with = \"required_nullable\")]\n+        source: Option<PlayerId>,\n+        /// API target id.\n+        target: PlayerId,\n+        /// Actual positive amount.\n+        amount: u32,\n+        /// Final nature.\n+        nature: PresentationNature,\n+    },\n+    /// Damage was prevented.\n+    DamagePrevented {\n+        /// Public source or explicit null.\n+        #[serde(deserialize_with = \"required_nullable\")]\n+        source: Option<PlayerId>,\n+        /// API target id.\n+        target: PlayerId,\n+        /// Final nature.\n+        nature: PresentationNature,\n+    },\n+    /// Actual positive HP recovered.\n+    HpRecovered {\n+        /// API player id.\n+        actor: PlayerId,\n+        /// Actual positive amount.\n+        amount: u32,\n+    },\n+    /// A genuine death committed.\n+    PlayerDied {\n+        /// API player id.\n+        actor: PlayerId,\n+        /// Public killer or explicit null.\n+        #[serde(deserialize_with = \"required_nullable\")]\n+        killer: Option<PlayerId>,\n+        /// Public speaker or explicit null.\n+        #[serde(deserialize_with = \"required_nullable\")]\n+        voice: Option<PublicVoice>,\n+    },\n+}\n+\n+/// Stable public ordinal within a committed revision.\n+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\n+#[serde(deny_unknown_fields)]\n+pub struct PublicOccurrence {\n+    /// Zero-based contiguous ordinal; never a private log offset.\n+    pub ordinal: u32,\n+    /// Typed public occurrence.\n+    pub event: PublicPresentationEvent,\n+}\n+\n+/// Public static capability domain.\n+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]\n+#[serde(rename_all = \"snake_case\")]\n+pub enum PresentationDomain {\n+    /// Card use.\n+    CardUse,\n+    /// Response.\n+    CardResponse,\n+    /// Genuine activation.\n+    SkillActivation,\n+    /// Damage.\n+    Damage,\n+    /// Recovery.\n+    Recovery,\n+    /// Death.\n+    Death,\n+    /// Voice binding.\n+    VoiceIdentity,\n+}\n+\n+/// Static public capability gap, never derived from a hidden occurrence.\n+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]\n+#[serde(rename_all = \"snake_case\")]\n+pub enum PresentationUnavailableReason {\n+    /// Source has no proven discriminator.\n+    SourceNoAudioDiscriminator,\n+    /// True commitment boundary is unproved.\n+    CommitBoundaryUnproved,\n+    /// Verified qualified binding is absent.\n+    VerifiedBindingMissing,\n+    /// Public binding support is absent.\n+    PublicBindingUnavailable,\n+}\n+\n+/// A public static capability gap.\n+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\n+#[serde(deny_unknown_fields)]\n+pub struct UnavailablePresentationScope {\n+    /// Capability domain.\n+    pub domain: PresentationDomain,\n+    /// Public static reason.\n+    pub reason: PresentationUnavailableReason,\n+}\n+\n+/// Completeness of public presentation metadata.\n+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]\n+#[serde(rename_all = \"snake_case\")]\n+pub enum PresentationStatus {\n+    /// All supported public occurrences included.\n+    Complete,\n+    /// Public static capability/history gap.\n+    Incomplete,\n+    /// Public metadata overflow, with no partial occurrences.\n+    Overflow,\n+}\n+\n+/// Optional metadata, validated atomically before transport state changes.\n+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\n+#[serde(try_from = \"RawPublicPresentationBatch\")]\n+pub struct PublicPresentationBatch {\n+    /// Existing committed revision.\n+    pub revision: u64,\n+    /// Public completeness status.\n+    pub status: PresentationStatus,\n+    /// Public static capability gaps.\n+    pub unavailable: Vec<UnavailablePresentationScope>,\n+    /// Ordered public occurrences.\n+    pub occurrences: Vec<PublicOccurrence>,\n+}\n+\n+#[derive(Deserialize)]\n+#[serde(deny_unknown_fields)]\n+struct RawPublicPresentationBatch {\n+    revision: u64,\n+    status: PresentationStatus,\n+    unavailable: Vec<UnavailablePresentationScope>,\n+    occurrences: Vec<PublicOccurrence>,\n+}\n+\n+fn required_nullable<'de, D: Deserializer<'de>, T: Deserialize<'de>>(\n+    d: D,\n+) -> Result<Option<T>, D::Error> {\n+    Option::<T>::deserialize(d)\n+}\n+\n+impl TryFrom<RawPublicPresentationBatch> for PublicPresentationBatch {\n+    type Error = String;\n+    fn try_from(raw: RawPublicPresentationBatch) -> Result<Self, Self::Error> {\n+        let batch = Self {\n+            revision: raw.revision,\n+            status: raw.status,\n+            unavailable: raw.unavailable,\n+            occurrences: raw.occurrences,\n+        };\n+        batch.validate()?;\n+        Ok(batch)\n+    }\n+}\n+\n+mod validation;"},{"sha":"080767615e9ebc2f29e1b45b395558178796bf8e","filename":"crates/engine-api/src/presentation/validation.rs","status":"added","additions":394,"deletions":0,"changes":394,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/crates%2Fengine-api%2Fsrc%2Fpresentation%2Fvalidation.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/crates%2Fengine-api%2Fsrc%2Fpresentation%2Fvalidation.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/crates%2Fengine-api%2Fsrc%2Fpresentation%2Fvalidation.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1,394 @@\n+use super::*;\n+\n+fn require(ok: bool) -> Result<(), String> {\n+    ok.then_some(())\n+        .ok_or_else(|| \"invalid public presentation metadata\".into())\n+}\n+fn token(s: &str) -> bool {\n+    !s.is_empty()\n+        && s.len() <= 256\n+        && s != \".\"\n+        && s != \"..\"\n+        && !s.chars().any(|c| c.is_control() || \"/\\\\%?#:\".contains(c))\n+}\n+fn path(s: &str) -> bool {\n+    !s.is_empty() && s.len() <= 256 && s.split('/').all(token)\n+}\n+fn hex(s: &str, len: usize) -> bool {\n+    s.len() == len\n+        && s.bytes()\n+            .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))\n+}\n+fn repository(s: &str) -> bool {\n+    !s.is_empty()\n+        && s.len() <= 256\n+        // Exact shared policy: C0/C1 controls, Unicode White_Space, BOM, and backslash.\n+        && !s.chars().any(|c| matches!(c,\n+            '\\u{0000}'..='\\u{0020}' | '\\u{007f}'..='\\u{00a0}' | '\\u{1680}' |\n+            '\\u{2000}'..='\\u{200a}' | '\\u{2028}'..='\\u{2029}' | '\\u{202f}' |\n+            '\\u{205f}' | '\\u{3000}' | '\\u{feff}' | '\\\\'))\n+}\n+fn owner(v: &FrozenOwnerKey) -> bool {\n+    match v {\n+        FrozenOwnerKey::Package {\n+            namespace,\n+            package_id,\n+            version,\n+            logic_hash,\n+            content_hash,\n+        } => {\n+            token(namespace)\n+                && token(package_id)\n+                && token(version)\n+                && hex(logic_hash, 64)\n+                && hex(content_hash, 64)\n+        }\n+        FrozenOwnerKey::Original {\n+            repository,\n+            adopted_revision,\n+            catalog_sha256,\n+            asset_manifest_sha256,\n+        } => {\n+            self::repository(repository)\n+                && hex(adopted_revision, 40)\n+                && hex(catalog_sha256, 64)\n+                && hex(asset_manifest_sha256, 64)\n+        }\n+    }\n+}\n+fn definition(v: &QualifiedDefinitionKey, kind: PresentationDefinitionKind) -> bool {\n+    owner(&v.owner)\n+        && v.kind == kind\n+        && match (&v.owner, &v.local_id) {\n+            (FrozenOwnerKey::Package { .. }, PresentationLocalId::Package(id)) => {\n+                kind != PresentationDefinitionKind::Card || *id > 0\n+            }\n+            (FrozenOwnerKey::Original { .. }, PresentationLocalId::Original(id)) => {\n+                token(&id.pack) && token(&id.raw_symbol)\n+            }\n+            _ => false,\n+        }\n+}\n+fn asset(v: &BoundAudioAsset) -> bool {\n+    owner(&v.source)\n+        && hex(&v.digest, 64)\n+        && v.size > 0\n+        && v.size <= MAX_PRESENTATION_REVISION\n+        && match (&v.source, &v.reference) {\n+            (\n+                FrozenOwnerKey::Package {\n+                    namespace: ns,\n+                    package_id: pid,\n+                    ..\n+                },\n+                PresentationAssetRef::Package {\n+                    namespace,\n+                    package_id,\n+                    asset_id,\n+                },\n+            ) => {\n+                ns == namespace\n+                    && pid == package_id\n+                    && token(asset_id)\n+                    && v.digest_algorithm == PresentationDigestAlgorithm::Blake3\n+            }\n+            (\n+                FrozenOwnerKey::Original { .. },\n+                PresentationAssetRef::Original {\n+                    path: p,\n+                    source_path,\n+                    ..\n+                },\n+            ) => {\n+                path(p)\n+                    && path(source_path)\n+                    && (p.starts_with(\"audio-declared/\")\n+                        || p.starts_with(\"audio/\")\n+                        || p.starts_with(\"audio-compat/\"))\n+                    && source_path.starts_with(\"audio/\")\n+                    && v.digest_algorithm == PresentationDigestAlgorithm::Sha256\n+            }\n+            _ => false,\n+        }\n+}\n+fn voice(v: &Option<PublicVoice>) -> bool {\n+    v.as_ref().is_none_or(|v| {\n+        definition(&v.role, PresentationDefinitionKind::General)\n+            && v.form.as_deref().is_none_or(token)\n+            && !v.assets.is_empty()\n+            && v.assets.len() <= 1024\n+            && v.assets.iter().all(asset)\n+            && v.assets\n+                .iter()\n+                .enumerate()\n+                .all(|(i, a)| !v.assets[..i].contains(a))\n+    })\n+}\n+fn player(p: PlayerId, players: u32) -> bool {\n+    p.raw() > 0 && p.raw() <= players\n+}\n+fn targets(v: &Option<Vec<PlayerId>>, players: u32) -> bool {\n+    v.as_ref().is_none_or(|v| {\n+        v.len() <= 16\n+            && v.iter().all(|p| player(*p, players))\n+            && v.iter().enumerate().all(|(i, p)| !v[..i].contains(p))\n+    })\n+}\n+fn effective(v: &EffectivePresentationCard) -> bool {\n+    // These are the existing CardKind::key values; no kernel dependency belongs in this leaf crate.\n+    CARD_KINDS.contains(&v.kind.as_str()) && token(&v.key)\n+}\n+\n+impl PublicPresentationBatch {\n+    /// Validate leaf constraints. This does not authorize public disclosure or resolve resources.\n+    pub fn validate(&self) -> Result<(), String> {\n+        require(\n+            self.revision <= MAX_PRESENTATION_REVISION\n+                && self.occurrences.len() <= MAX_PRESENTATION_OCCURRENCES\n+                && self.unavailable.len() <= 28\n+                && self\n+                    .unavailable\n+                    .iter()\n+                    .enumerate()\n+                    .all(|(i, v)| !self.unavailable[..i].contains(v))\n+                && (self.status != PresentationStatus::Complete || self.unavailable.is_empty())\n+                && (self.status != PresentationStatus::Overflow || self.occurrences.is_empty()),\n+        )?;\n+        for (index, v) in self.occurrences.iter().enumerate() {\n+            require(v.ordinal as usize == index)?;\n+        }\n+        self.validate_players(u32::MAX)\n+    }\n+\n+    /// Validate API one-based player references against the accompanying observer seat count.\n+    pub fn validate_players(&self, players: u32) -> Result<(), String> {\n+        for v in &self.occurrences {\n+            let ok = match &v.event {\n+                PublicPresentationEvent::CardUsed {\n+                    actor,\n+                    targets: ts,\n+                    effective: e,\n+                    voice: v,\n+                } => player(*actor, players) && targets(ts, players) && effective(e) && voice(v),\n+                PublicPresentationEvent::CardResponded {\n+                    actor,\n+                    effective: e,\n+                    voice: v,\n+                } => player(*actor, players) && effective(e) && voice(v),\n+                PublicPresentationEvent::SkillActivated {\n+                    actor,\n+                    skill,\n+                    targets: ts,\n+                    voice: v,\n+                } => {\n+                    player(*actor, players)\n+                        && definition(&skill.definition, PresentationDefinitionKind::Skill)\n+                        && targets(ts, players)\n+                        && voice(v)\n+                }\n+                PublicPresentationEvent::DamageDealt {\n+                    source,\n+                    target,\n+                    amount,\n+                    ..\n+                } => {\n+                    source.is_none_or(|p| player(p, players))\n+                        && player(*target, players)\n+                        && *amount > 0\n+                }\n+                PublicPresentationEvent::DamagePrevented { source, target, .. } => {\n+                    source.is_none_or(|p| player(p, players)) && player(*target, players)\n+                }\n+                PublicPresentationEvent::HpRecovered { actor, amount } => {\n+                    player(*actor, players) && *amount > 0\n+                }\n+                PublicPresentationEvent::PlayerDied {\n+                    actor,\n+                    killer,\n+                    voice: v,\n+                } => {\n+                    player(*actor, players) && killer.is_none_or(|p| player(p, players)) && voice(v)\n+                }\n+            };\n+            require(ok)?;\n+        }\n+        Ok(())\n+    }\n+}\n+\n+const CARD_KINDS: &[&str] = &[\n+    \"sha\",\n+    \"shan\",\n+    \"tao\",\n+    \"horse_plus\",\n+    \"horse_minus\",\n+    \"weapon\",\n+    \"armor\",\n+    \"huosha\",\n+    \"tiesuo\",\n+    \"nanman\",\n+    \"wanjian\",\n+    \"juedou\",\n+    \"wuxie\",\n+    \"lebu\",\n+    \"bingliang\",\n+    \"shandian\",\n+    \"guohe\",\n+    \"shunshou\",\n+    \"jiu\",\n+    \"leisha\",\n+    \"shoulijian\",\n+    \"wuxingpan\",\n+    \"wangmeizhike\",\n+    \"sanjian\",\n+    \"shuigong\",\n+    \"fudichouxin\",\n+    \"chenhuodajie\",\n+    \"suolianjia\",\n+    \"hongshui\",\n+    \"toulianghuanzhu\",\n+    \"linghunzhihuo\",\n+    \"zhaomingdan\",\n+    \"jihuocard\",\n+    \"youdishenru\",\n+    \"geanguanhuo\",\n+    \"caochuanjiejian\",\n+    \"shezhanqunru\",\n+    \"shujinsan\",\n+    \"mianlijinzhen\",\n+    \"feibiao\",\n+    \"jinlianzhu\",\n+    \"tanhuadong\",\n+    \"yougeng\",\n+    \"qingtuan\",\n+    \"yuanbaorou\",\n+    \"gudonggeng\",\n+    \"mapodoufu\",\n+    \"chunbing\",\n+    \"liyutang\",\n+    \"molicha\",\n+    \"xiajiao\",\n+    \"mizhilianou\",\n+    \"luyugeng\",\n+    \"bingpotong\",\n+    \"qiankunbiao\",\n+    \"longxugou\",\n+    \"shenhuofeiya\",\n+    \"ziyangdan\",\n+    \"yunvyuanshen\",\n+    \"shihuifen\",\n+    \"liufengsan\",\n+    \"shatang\",\n+    \"heilonglinpian\",\n+    \"liutouge\",\n+    \"mutoumianju\",\n+    \"dinvxuanshuang\",\n+    \"gjyuheng\",\n+    \"dunpaigedang\",\n+    \"zhiliaobo\",\n+    \"yuansuhuimie\",\n+    \"xingjiegoutong\",\n+    \"chuansongmen\",\n+    \"tanshezhiren\",\n+    \"shijieshu\",\n+    \"yanziyaoshui\",\n+    \"aozuzhilei\",\n+    \"wenyi\",\n+    \"zhihuanjun\",\n+    \"baoxueyaoshui\",\n+    \"qinpendayu\",\n+    \"birinongwu\",\n+    \"ciguhanshuang\",\n+    \"kunenfayin\",\n+    \"shanbengshu\",\n+    \"poxiao\",\n+    \"zumoshoukao\",\n+    \"monkey\",\n+    \"xuelunyang\",\n+    \"mianju\",\n+    \"jiuwei\",\n+    \"wuzhong\",\n+    \"taoyuan\",\n+    \"wugu\",\n+    \"jiedao\",\n+    \"renwang\",\n+    \"qinggang\",\n+    \"xuanyuanjian\",\n+    \"qilin\",\n+    \"hanbing\",\n+    \"zhuge\",\n+    \"guanshi\",\n+    \"qinglong\",\n+    \"zhangba\",\n+    \"cixiong\",\n+    \"fangtian\",\n+    \"hufu\",\n+    \"liuxinghuoyu\",\n+    \"caoyao\",\n+    \"chilongya\",\n+    \"tianxianjiu\",\n+    \"xixueguizhihuan\",\n+    \"guiyoujie\",\n+    \"shentoumianju\",\n+    \"xingjunyan\",\n+    \"qinglonglingzhu\",\n+    \"zhufangshenshi\",\n+    \"fengxueren\",\n+    \"yufulu\",\n+    \"yangpijuan\",\n+    \"daihuofenglun\",\n+    \"xiayuncailing\",\n+    \"langeguaiyi\",\n+    \"longlushanfeng\",\n+    \"haidao\",\n+    \"shuimomuxue\",\n+    \"feixu\",\n+    \"yixialan\",\n+    \"shamolvzhou\",\n+    \"linzhongjianta\",\n+    \"bingheyaosai\",\n+    \"youlin\",\n+    \"lindixiliu\",\n+    \"dizaizhen\",\n+    \"jiguan\",\n+    \"xuejibingbao\",\n+    \"shenmiguo\",\n+    \"fengyinzhidan\",\n+    \"lianyaohu\",\n+    \"qiankundai\",\n+    \"shennongding\",\n+    \"nvwashi\",\n+    \"kunlunjingc\",\n+    \"donghuangzhong\",\n+    \"kongdongyin\",\n+    \"jingleishan\",\n+    \"chiyuxi\",\n+    \"guisheqi\",\n+    \"xianluhui\",\n+    \"guilingzhitao\",\n+    \"sifeizhenmian\",\n+    \"shuchui\",\n+    \"sadengjinhuan\",\n+    \"haotianta\",\n+    \"yuruyi\",\n+    \"yuchanqian\",\n+    \"yuchankun\",\n+    \"yuchanzhen\",\n+    \"yuchanxun\",\n+    \"yuchankan\",\n+    \"yuchanli\",\n+    \"yuchangen\",\n+    \"yuchandui\",\n+    \"shencaojie\",\n+    \"qinglongzhigui\",\n+    \"zhuquezhizhang\",\n+    \"baishouzhihu\",\n+    \"xuanwuzhihuang\",\n+    \"huanglinzhicong\",\n+    \"hslingjian\",\n+    \"tianfuzhen\",\n+    \"qixingzhen\",\n+    \"niaoxiangzhen\",\n+    \"changshezhen\",\n+    \"pozhenjue\",\n+];"},{"sha":"ac256aca0ad28c60e90dde8bdf783d8f5ad5d412","filename":"crates/engine-protocol/src/lib.rs","status":"modified","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/crates%2Fengine-protocol%2Fsrc%2Flib.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/crates%2Fengine-protocol%2Fsrc%2Flib.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/crates%2Fengine-protocol%2Fsrc%2Flib.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -8,6 +8,7 @@\n #![deny(missing_docs)]\n \n mod messages;\n+mod presentation;\n mod wire;\n \n pub use messages::*;"},{"sha":"58973fb91f880a4959479b0d71fb5cbe0d64c606","filename":"crates/engine-protocol/src/messages.rs","status":"modified","additions":3,"deletions":0,"changes":3,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/crates%2Fengine-protocol%2Fsrc%2Fmessages.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/crates%2Fengine-protocol%2Fsrc%2Fmessages.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/crates%2Fengine-protocol%2Fsrc%2Fmessages.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -159,6 +159,9 @@ pub enum ServerMessage {\n         choice: Option<ChoiceRequest>,\n         /// Public event codes only (optional sanitized list).\n         public_event_codes: Vec<u32>,\n+        /// Optional typed public presentation; current producers omit it.\n+        #[serde(default, skip_serializing_if = \"Option::is_none\", deserialize_with = \"crate::presentation::deserialize_optional\")]\n+        presentation: Option<engine_api::PublicPresentationBatch>,\n     },\n     /// Room public roster update.\n     RoomRoster {"},{"sha":"1242654e90e4789e1ad70c7f664fec5972bfc874","filename":"crates/engine-protocol/src/presentation.rs","status":"added","additions":40,"deletions":0,"changes":40,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/crates%2Fengine-protocol%2Fsrc%2Fpresentation.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/crates%2Fengine-protocol%2Fsrc%2Fpresentation.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/crates%2Fengine-protocol%2Fsrc%2Fpresentation.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1,40 @@\n+use engine_api::{PublicPresentationBatch, MAX_PRESENTATION_BYTES};\n+use serde::{Deserialize, Deserializer};\n+\n+pub(crate) fn deserialize_optional<'de, D: Deserializer<'de>>(\n+    d: D,\n+) -> Result<Option<PublicPresentationBatch>, D::Error> {\n+    let batch = PublicPresentationBatch::deserialize(d)?;\n+    let bytes = serde_json::to_vec(&batch).map_err(serde::de::Error::custom)?;\n+    if bytes.len() > MAX_PRESENTATION_BYTES {\n+        return Err(serde::de::Error::custom(\n+            \"public presentation batch exceeds 64KiB\",\n+        ));\n+    }\n+    Ok(Some(batch))\n+}\n+\n+pub(crate) fn validate(message: &crate::ServerMessage) -> Result<(), crate::wire::WireError> {\n+    if let crate::ServerMessage::CommandOutcome {\n+        view,\n+        presentation: Some(batch),\n+        ..\n+    } = message\n+    {\n+        batch.validate().map_err(crate::wire::WireError::Json)?;\n+        batch\n+            .validate_players(view.seats.len() as u32)\n+            .map_err(crate::wire::WireError::Json)?;\n+        if batch.revision != view.revision\n+            || serde_json::to_vec(batch)\n+                .map_err(|e| crate::wire::WireError::Json(e.to_string()))?\n+                .len()\n+                > MAX_PRESENTATION_BYTES\n+        {\n+            return Err(crate::wire::WireError::Json(\n+                \"invalid public presentation revision or size\".into(),\n+            ));\n+        }\n+    }\n+    Ok(())\n+}"},{"sha":"99d7aeddf0e8644213df1a54bd35df486824cafb","filename":"crates/engine-protocol/src/wire.rs","status":"modified","additions":4,"deletions":1,"changes":5,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/crates%2Fengine-protocol%2Fsrc%2Fwire.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/crates%2Fengine-protocol%2Fsrc%2Fwire.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/crates%2Fengine-protocol%2Fsrc%2Fwire.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -34,6 +34,7 @@ pub fn decode_c2s(text: &str) -> Result<ClientMessage, WireError> {\n \n /// Encode server message.\n pub fn encode_s2c(msg: &ServerMessage) -> Result<String, WireError> {\n+    crate::presentation::validate(msg)?;\n     let s = serde_json::to_string(msg).map_err(|e| WireError::Json(e.to_string()))?;\n     if s.len() > MAX_MESSAGE_BYTES {\n         return Err(WireError::TooLarge(s.len()));\n@@ -46,7 +47,9 @@ pub fn decode_s2c(text: &str) -> Result<ServerMessage, WireError> {\n     if text.len() > MAX_MESSAGE_BYTES {\n         return Err(WireError::TooLarge(text.len()));\n     }\n-    serde_json::from_str(text).map_err(|e| WireError::Json(e.to_string()))\n+    let message = serde_json::from_str(text).map_err(|e| WireError::Json(e.to_string()))?;\n+    crate::presentation::validate(&message)?;\n+    Ok(message)\n }\n \n #[cfg(test)]"},{"sha":"c49365ea7c8d9b476a73b75542c542f27694da2a","filename":"crates/engine-protocol/tests/fixtures/i02-main5fc/messages.rs","status":"added","additions":273,"deletions":0,"changes":273,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/crates%2Fengine-protocol%2Ftests%2Ffixtures%2Fi02-main5fc%2Fmessages.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/crates%2Fengine-protocol%2Ftests%2Ffixtures%2Fi02-main5fc%2Fmessages.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/crates%2Fengine-protocol%2Ftests%2Ffixtures%2Fi02-main5fc%2Fmessages.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1,273 @@\n+//! Typed client/server messages.\n+\n+use engine_api::{\n+    ChoiceRequest, Command, CommandResult, IdempotencyKey, LegalAction, ObserverSnapshot, PlayerId,\n+    VersionBundle,\n+};\n+use serde::{Deserialize, Serialize};\n+\n+use crate::NETWORK_PROTOCOL_VERSION;\n+\n+/// Envelope header common to room-scoped messages.\n+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\n+pub struct MessageHeader {\n+    /// Protocol version.\n+    pub protocol_version: u32,\n+    /// Room id (0 if not in room).\n+    pub room_id: u64,\n+    /// Per-connection monotonic sequence (client→server).\n+    pub conn_seq: u64,\n+    /// Associated authority revision when applicable.\n+    pub revision: u64,\n+}\n+\n+impl MessageHeader {\n+    /// New header.\n+    pub fn new(room_id: u64, conn_seq: u64, revision: u64) -> Self {\n+        Self {\n+            protocol_version: NETWORK_PROTOCOL_VERSION,\n+            room_id,\n+            conn_seq,\n+            revision,\n+        }\n+    }\n+}\n+\n+/// Client → Server.\n+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\n+#[serde(tag = \"type\", content = \"payload\", deny_unknown_fields)]\n+pub enum ClientMessage {\n+    /// Capability / version hello.\n+    Hello {\n+        /// Client-reported versions.\n+        versions: VersionBundle,\n+        /// Display name (not trusted for auth).\n+        display_name: String,\n+    },\n+    /// Create a new identity room.\n+    CreateRoom {\n+        /// Native choice window, default 30 seconds.\n+        #[serde(default)]\n+        choice_timeout_secs: Option<u8>,\n+        /// Seat count 2..=8.\n+        players: u8,\n+        /// Rule RNG seed.\n+        seed: u64,\n+        /// Optional soft password (Phase 7 toy auth).\n+        password: String,\n+    },\n+    /// Join existing room.\n+    JoinRoom {\n+        /// Room id.\n+        room_id: u64,\n+        /// Password if required.\n+        password: String,\n+        /// Preferred seat (0-based); server may reassign.\n+        preferred_seat: Option<u8>,\n+        /// Reconnect token from prior JoinOk.\n+        reconnect_token: Option<String>,\n+    },\n+    /// Spectate (public projection only).\n+    Spectate {\n+        /// Room id.\n+        room_id: u64,\n+    },\n+    /// Submit a normalized command.\n+    SubmitCommand {\n+        /// Header with room + conn_seq + expected revision.\n+        header: MessageHeader,\n+        /// Command body.\n+        command: Command,\n+        /// Idempotency key (required for network).\n+        idempotency_key: IdempotencyKey,\n+        /// True when this is a reconnect replay. A legacy room without a saved\n+        /// receipt must reject it instead of executing a possibly-duplicate command.\n+        #[serde(default)]\n+        replay: bool,\n+    },\n+    /// Request full observer snapshot (after gap or reconnect).\n+    RequestSnapshot {\n+        /// Header.\n+        header: MessageHeader,\n+        /// Last revision client has (0 if none).\n+        last_revision: u64,\n+    },\n+    /// Heartbeat / keepalive.\n+    Heartbeat {\n+        /// Header.\n+        header: MessageHeader,\n+    },\n+    /// Leave room gracefully.\n+    LeaveRoom {\n+        /// Room id.\n+        room_id: u64,\n+    },\n+}\n+\n+/// Server → Client.\n+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\n+#[serde(tag = \"type\", content = \"payload\")]\n+pub enum ServerMessage {\n+    /// Server hello / welcome.\n+    Welcome {\n+        /// Assigned connection id.\n+        connection_id: u64,\n+        /// Protocol version.\n+        protocol_version: u32,\n+        /// Server version bundle.\n+        versions: VersionBundle,\n+    },\n+    /// Room created.\n+    RoomCreated {\n+        /// Room id.\n+        room_id: u64,\n+        /// Host seat player id once seated.\n+        host_hint: String,\n+    },\n+    /// Join accepted.\n+    JoinOk {\n+        /// Room id.\n+        room_id: u64,\n+        /// Assigned player id (0 for spectator).\n+        player_id: u32,\n+        /// Seat index.\n+        seat: u8,\n+        /// Role.\n+        role: ClientRole,\n+        /// Token for reconnect.\n+        reconnect_token: String,\n+        /// Initial observer view.\n+        view: ObserverSnapshot,\n+        /// Current personalized choice barrier, if any.\n+        choice: Option<ChoiceRequest>,\n+        /// Personalized actions currently legal for this client.\n+        legal_actions: Vec<LegalAction>,\n+    },\n+    /// Command accepted or rejected (no hidden info in reject messages).\n+    CommandOutcome {\n+        /// Header echo.\n+        header: MessageHeader,\n+        /// Idempotency key echo.\n+        idempotency_key: IdempotencyKey,\n+        /// Result.\n+        result: CommandResult,\n+        /// Observer view for *this* client only.\n+        view: ObserverSnapshot,\n+        /// Personalized actions legal after applying (or rejecting) the command.\n+        legal_actions: Vec<LegalAction>,\n+        /// Pending choice if any (already filtered to this observer when personal).\n+        choice: Option<ChoiceRequest>,\n+        /// Public event codes only (optional sanitized list).\n+        public_event_codes: Vec<u32>,\n+    },\n+    /// Room public roster update.\n+    RoomRoster {\n+        /// Native room window; legacy rooms have no choice timer.\n+        choice_timeout_secs: Option<u8>,\n+        /// Room id.\n+        room_id: u64,\n+        /// Seats filled.\n+        seats: Vec<SeatPresence>,\n+        /// Match started?\n+        started: bool,\n+        /// Finished?\n+        finished: bool,\n+    },\n+    /// Snapshot response.\n+    Snapshot {\n+        /// Header.\n+        header: MessageHeader,\n+        /// Full observer view for this client.\n+        view: ObserverSnapshot,\n+        /// Current personalized choice barrier, if any.\n+        choice: Option<ChoiceRequest>,\n+        /// Personalized actions legal at the snapshot revision.\n+        legal_actions: Vec<LegalAction>,\n+    },\n+    /// Heartbeat reply.\n+    Pong {\n+        /// Header.\n+        header: MessageHeader,\n+        /// Server Unix milliseconds (not used by rules).\n+        server_time_ms: u64,\n+    },\n+    /// Error that is safe to show (never includes hidden cards/identity of others).\n+    Error {\n+        /// Machine code.\n+        code: ErrorCode,\n+        /// Safe message.\n+        message: String,\n+        /// Optional room.\n+        room_id: Option<u64>,\n+    },\n+}\n+\n+/// Client role in a room.\n+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]\n+pub enum ClientRole {\n+    /// Seated player.\n+    Player,\n+    /// Public spectator.\n+    Spectator,\n+    /// Referee (debug; full view) — not granted by default join.\n+    Referee,\n+}\n+\n+/// Presence of a seat (public).\n+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\n+pub struct SeatPresence {\n+    /// Seat index.\n+    pub seat: u8,\n+    /// Player id if seated.\n+    pub player_id: u32,\n+    /// Display name (sanitized).\n+    pub display_name: String,\n+    /// Connected now.\n+    pub connected: bool,\n+    /// Server-controlled seat takeover.\n+    pub managed: bool,\n+}\n+\n+/// Safe error codes (no hidden-state leakage).\n+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]\n+pub enum ErrorCode {\n+    /// Protocol / parse.\n+    BadMessage,\n+    /// Auth / password.\n+    Unauthorized,\n+    /// Room missing.\n+    RoomNotFound,\n+    /// Room full.\n+    RoomFull,\n+    /// Not in room.\n+    NotInRoom,\n+    /// Rate limited.\n+    RateLimited,\n+    /// Internal.\n+    Internal,\n+    /// Version mismatch.\n+    VersionMismatch,\n+    /// Duplicate / stale handled as command result usually.\n+    Conflict,\n+}\n+\n+/// Helper: sanitize error for wire (strip anything that might look like state dumps).\n+pub fn public_error(code: ErrorCode, message: impl Into<String>) -> ServerMessage {\n+    let message = message.into();\n+    // Hard cap length; never attach dumps.\n+    let message = if message.len() > 200 {\n+        message.chars().take(200).collect()\n+    } else {\n+        message\n+    };\n+    ServerMessage::Error {\n+        code,\n+        message,\n+        room_id: None,\n+    }\n+}\n+\n+/// Map player id for JSON (engine uses PlayerId).\n+pub fn player_raw(p: PlayerId) -> u32 {\n+    p.raw()\n+}"},{"sha":"fa86dcf216e3c687976dbf26a8442e07429b36ec","filename":"crates/engine-protocol/tests/fixtures/i02-main5fc/wire.rs","status":"added","additions":68,"deletions":0,"changes":68,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af6083697428de7be2f02f8/crates%2Fengine-protocol%2Ftests%2Ffixtures%2Fi02-main5fc%2Fwire.rs","raw_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/raw/34e83f0550bb70ef4af6083697428de7be2f02f8/crates%2Fengine-protocol%2Ftests%2Ffixtures%2Fi02-main5fc%2Fwire.rs","contents_url":"https://api.github.com/repos/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/contents/crates%2Fengine-protocol%2Ftests%2Ffixtures%2Fi02-main5fc%2Fwire.rs?ref=34e83f0550bb70ef4af6083697428de7be2f02f8","patch":"@@ -0,0 +1,68 @@\n+//! JSON encode/decode with size limits.\n+\n+use crate::messages::{ClientMessage, ServerMessage};\n+use crate::MAX_MESSAGE_BYTES;\n+use thiserror::Error;\n+\n+/// Wire codec error.\n+#[derive(Debug, Error, Clone, PartialEq, Eq)]\n+pub enum WireError {\n+    /// Message too large.\n+    #[error(\"message too large: {0} bytes\")]\n+    TooLarge(usize),\n+    /// JSON error.\n+    #[error(\"json: {0}\")]\n+    Json(String),\n+}\n+\n+/// Encode client message.\n+pub fn encode_c2s(msg: &ClientMessage) -> Result<String, WireError> {\n+    let s = serde_json::to_string(msg).map_err(|e| WireError::Json(e.to_string()))?;\n+    if s.len() > MAX_MESSAGE_BYTES {\n+        return Err(WireError::TooLarge(s.len()));\n+    }\n+    Ok(s)\n+}\n+\n+/// Decode client message.\n+pub fn decode_c2s(text: &str) -> Result<ClientMessage, WireError> {\n+    if text.len() > MAX_MESSAGE_BYTES {\n+        return Err(WireError::TooLarge(text.len()));\n+    }\n+    serde_json::from_str(text).map_err(|e| WireError::Json(e.to_string()))\n+}\n+\n+/// Encode server message.\n+pub fn encode_s2c(msg: &ServerMessage) -> Result<String, WireError> {\n+    let s = serde_json::to_string(msg).map_err(|e| WireError::Json(e.to_string()))?;\n+    if s.len() > MAX_MESSAGE_BYTES {\n+        return Err(WireError::TooLarge(s.len()));\n+    }\n+    Ok(s)\n+}\n+\n+/// Decode server message (clients / tests).\n+pub fn decode_s2c(text: &str) -> Result<ServerMessage, WireError> {\n+    if text.len() > MAX_MESSAGE_BYTES {\n+        return Err(WireError::TooLarge(text.len()));\n+    }\n+    serde_json::from_str(text).map_err(|e| WireError::Json(e.to_string()))\n+}\n+\n+#[cfg(test)]\n+mod tests {\n+    use super::*;\n+    use crate::messages::ClientMessage;\n+    use engine_api::VersionBundle;\n+\n+    #[test]\n+    fn roundtrip_hello() {\n+        let m = ClientMessage::Hello {\n+            versions: VersionBundle::current(),\n+            display_name: \"tester\".into(),\n+        };\n+        let s = encode_c2s(&m).unwrap();\n+        let d = decode_c2s(&s).unwrap();\n+        assert_eq!(m, d);\n+    }\n+}"},{"sha":"2080d327b5b121af1dfb27c12e34f32dcaa96505","filename":"crates/engine-protocol/tests/fixtures/i02-presentation-invalid.json","status":"added","additions":712,"deletions":0,"changes":712,"blob_url":"https://github.com/RuyimgByCN/RuyimgByCN-noname-ruyimg-modified/blob/34e83f0550bb70ef4af