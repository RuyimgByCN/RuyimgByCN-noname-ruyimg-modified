+fn activate(e: &mut Engine, name: &str) {
+    let skill = e.catalog().skill_by_name(name).unwrap();
+    let out = submit(e, 0, GameAction::ActivateSkill { skill });
+    assert!(matches!(out, CommandOutcome::Pending { .. }), "{out:?}");
+}
