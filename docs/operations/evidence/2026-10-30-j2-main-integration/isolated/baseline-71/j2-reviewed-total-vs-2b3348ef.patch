+//! Validate active declarations before joining them to their trigger handlers.
+use super::*;
+use engine_native::rvm_bridge::{
+    VmActiveLimits, VmFilterPolicy, VmHandlerSet, VmSkillProgram, VmTriggerProgram,
+};
+use std::sync::Arc;
+
+pub(super) fn bridge_active_entries(
+    pkg: &content_schema::ContentPackage,
+    decls: &mut Vec<engine_native::content::extension::VmSkillDecl>,
+) -> Result<(), BridgeError> {
+    let mut seen = BTreeSet::new();
+    for active in &pkg.active_index {
+        if !seen.insert(active.skill_def_id) {
+            return Err(invalid(
+                "active_index",
+                "multiple active entries for one skill are unsupported",
+            ));
+        }
+        let skill = pkg
+            .skill_index
+            .iter()
+            .find(|s| s.skill_def_id == active.skill_def_id)
+            .ok_or_else(|| invalid("active_index.skill_def_id", "missing logical skill"))?;
+        if skill.lord_only || skill.conversion || skill.non_gainable {
+            return Err(invalid(
+                "skill_index",
+                "active skill metadata is unsupported",
+            ));
+        }
+        if active.window != "play_phase"
+            || active.selection.is_some()
+            || active
+                .targets
+                .as_ref()
+                .is_some_and(|t| t.min != 0 || t.max != 0)
+            || active.uses_per_turn.is_some_and(|n| n != 1)
+            || active.uses_per_play_phase.is_some_and(|n| n != 1)
+            || active.uses_per_turn_source.is_some()
+            || active.owner_missing_skill.is_some()
+            || active.hand_limit_positive
+            || active.hand_missing_gaintag.is_some()
+            || active.once_per_game
+        {
+            return Err(invalid(
+                "active_index",
+                format!(
+                    "unsupported active declaration for {}: {active:?}",
+                    skill.name
+                ),
+            ));
+        }
+        // A zero-target contract must not silently discard additional predicates.
+        if let Some(targets) = &active.targets {
+            let mut plain = targets.clone();
+            plain.min = 0;
+            plain.max = 0;
+            plain.allow_self = targets.allow_self;
+            let expected: content_schema::PackageTargetSpec = serde_json::from_value(
+                serde_json::json!({"min":0,"max":0,"allow_self":targets.allow_self}),
+            )
+            .map_err(|e| invalid("active_index.targets", e.to_string()))?;
+            if plain != expected {
+                return Err(invalid(
+                    "active_index.targets",
+                    "unsupported target predicates",
+                ));
+            }
+        }
+        let module = pkg
+            .modules
+            .iter()
+            .find(|m| m.name == active.module)
+            .ok_or_else(|| invalid("active_index.module", "missing module"))?;
+        validate_entry(module, active.entry_pc, "active_index.entry_pc")?;
+        let program = Arc::new(
+            VmSkillProgram::new(module.clone(), skill.name.clone())
+                .map_err(|e| invalid("active_index.module", e.to_string()))?,
+        );
+        let mut triggers = Vec::new();
+        let mut remove = Vec::new();
+        for trigger in pkg
+            .trigger_index
+            .iter()
+            .filter(|t| t.skill_def_id == active.skill_def_id)
+        {
+            let index = decls
+                .iter()
+                .position(|d| d.name == trigger.module)
+                .ok_or_else(|| invalid("trigger_index", "missing bridged handler"))?;
+            let decl = &decls[index];
+            if decl.trigger.event == engine_native::event::EventKind::DamageBefore {
+                return Err(invalid(
+                    "trigger_index.event",
+                    "active skill with damage_before handler is unsupported",
+                ));
+            }
+            if triggers
+                .first()
+                .is_some_and(|t: &VmTriggerProgram| t.meta.optional != decl.trigger.optional)
+            {
+                return Err(invalid(
+                    "trigger_index.optional",
+                    "mixed optional handlers are unsupported",
+                ));
+            }
+            triggers.push(VmTriggerProgram {
+                program: Arc::new(
+                    VmSkillProgram::new(decl.module.clone(), skill.name.clone())
+                        .map_err(|e| invalid("trigger_index.module", e.to_string()))?,
+                ),
+                meta: decl.trigger.clone(),
+                filter: decl.filter.clone(),
+            });
+            remove.push(index);
+        }
+        remove.sort_unstable();
+        for index in remove.into_iter().rev() {
+            decls.remove(index);
+        }
+        let mut meta = triggers.first().map(|t| t.meta.clone()).unwrap_or(
+            engine_native::catalog::TriggerMeta {
+                event: engine_native::event::EventKind::SkillToggled,
+                timing: engine_native::event::Timing::Normal,
+                priority: 0,
+                optional: false,
+                extra_events: Vec::new(),
+            },
+        );
+        for trigger in &triggers {
+            if trigger.meta.event != meta.event && !meta.extra_events.contains(&trigger.meta.event)
+            {
+                meta.extra_events.push(trigger.meta.event);
+            }
+        }
+        let limits = VmActiveLimits {
+            once_per_turn: active.uses_per_turn == Some(1),
+            once_per_play_phase: active.uses_per_play_phase == Some(1),
+            hand_nonempty: active.hand_nonempty,
+            equip_nonempty: active.equip_nonempty,
+            hand_gt_hp: active.hand_gt_hp,
+            hand_gt_max_hp: active.hand_gt_max_hp,
+            face_up: active.face_up,
+            owner_unlinked: active.owner_unlinked,
+            mark_at_least: active.mark_at_least,
+        };
+        decls.push(engine_native::content::extension::VmSkillDecl {
+            name: skill.name.clone(),
+            module: module.clone(),
+            trigger: meta,
+            filter: VmFilterPolicy::Handlers(Arc::new(VmHandlerSet {
+                skill_def_id: active.skill_def_id,
+                active: program,
+                limits,
+                triggers,
+            })),
+        });
+    }
+    Ok(())
+}
+
+pub(super) fn validate_entry(
+    module: &engine_native::rvm_bridge::BytecodeModule,
+    entry_pc: u32,
+    field: &'static str,
+) -> Result<(), BridgeError> {
+    if entry_pc != module.entry_pc {
+        return Err(invalid(field, "non-default module entries are unsupported"));
+    }
+    VmSkillProgram::new(module.clone(), module.name.clone())
+        .map_err(|e| invalid(field, e.to_string()))?;
+    Ok(())
+}
diff --git a/crates/engine-native-content/src/content/vm_effects.rs b/crates/engine-native-content/src/content/vm_effects.rs
new file mode 100644
index 00000000..fa07e922
--- /dev/null
+++ b/crates/engine-native-content/src/content/vm_effects.rs
@@ -0,0 +1,195 @@
+//! Content-owned VM commit machines. The kernel only stores and pumps their continuations.
+mod danshou;
+mod fenghe;
+mod pingkou;
+
+use crate::catalog::Catalog;
+use crate::choice::{ChoiceKind, ChoiceOption, ChoiceSpec};
+use crate::machine::{Ctx, Flow};
+use crate::snap::{ask, ExpectedAsk};
+use crate::state::GameStateCore;
+use rule_api::EffectRequest;
+
+pub(crate) fn step(
+    ctx: &mut Ctx<'_>,
+    skill: &str,
+    effect: &EffectRequest,
+    state: &mut Vec<u32>,
+) -> Option<Flow> {
+    match effect {
+        EffectRequest::ChooseGiveOrRecastOneHand {
+            player,
+            require_skill_def,
+            grant_skill_def,
+            grant_mark_def,
+            ..
+        } => {
+            let owner = seat(*player, ctx.core)?;
+            Some(fenghe::step(
+                ctx,
+                owner,
+                *require_skill_def,
+                *grant_skill_def,
+                *grant_mark_def,
+                state,
+            ))
+        }
+        EffectRequest::ChooseOtherTargetsBySkippedPhaseCountDamageDraw {
+            player, amount, ..
+        } => {
+            let owner = seat(*player, ctx.core)?;
+            Some(pingkou::step(ctx, owner, *amount, state))
+        }
+        EffectRequest::ResolveOlJieDanshou { player, .. } => {
+            let owner = seat(*player, ctx.core)?;
+            Some(danshou::step(ctx, skill, owner, state))
+        }
+        _ => None,
+    }
+}
+
+pub(crate) fn active_ask(
+    effect: &EffectRequest,
+    state: &[u32],
+    core: &GameStateCore,
+    catalog: &Catalog,
+) -> Option<ExpectedAsk> {
+    match effect {
+        EffectRequest::ChooseGiveOrRecastOneHand { player, .. } => {
+            fenghe::active_ask(core, catalog, seat(*player, core)?, state)
+        }
+        EffectRequest::ChooseOtherTargetsBySkippedPhaseCountDamageDraw { player, .. } => {
+            pingkou::active_ask(core, seat(*player, core)?, state)
+        }
+        EffectRequest::ResolveOlJieDanshou { player, skill } => {
+            let owner = seat(*player, core)?;
+            let name = catalog.skills.get(skill.raw() as usize)?.name;
+            danshou::active_ask(core, owner, name, state)
+        }
+        _ => None,
+    }
+}
+
+fn seat(player: rule_api::PlayerId, core: &GameStateCore) -> Option<u8> {
+    let seat = player.raw().checked_sub(1)?;
+    (seat < core.players.len() as u32).then_some(seat as u8)
+}
+
+fn cards(core: &GameStateCore, player: u8) -> Vec<ChoiceOption> {
+    core.player(player)
+        .hand
+        .iter()
+        .chain(&core.player(player).equips)
+        .map(|c| ChoiceOption::Card(*c))
+        .collect()
+}
+
+fn wait(ask: ExpectedAsk) -> Flow {
+    Flow::WaitChoice {
+        observer: ask.observer,
+        spec: ChoiceSpec {
+            kind: ask.kind,
+            prompt: ask.prompt,
+            options: ask.options,
+            min: ask.min,
+            max: ask.max,
+            allow_cancel: ask.allow_cancel,
+        },
+    }
+}
+
+fn discard(ctx: &mut Ctx<'_>, owner: u8, picked: &[u32]) {
+    for card in picked {
+        if ctx.core.player(owner).hand.contains(card) {
+            ctx.take_hand_card(owner, *card);
+        } else {
+            ctx.take_owned_card(owner, *card);
+        }
+    }
+    ctx.core.discard.extend_from_slice(picked);
+    ctx.out.push(crate::machine::LogEvent::CardDiscarded {
+        player: owner,
+        cards: picked.to_vec(),
+    });
+    ctx.emit(crate::event::EventData::CardsDiscarded {
+        player: owner,
+        cards: picked.to_vec(),
+    });
+}
+
+/// Validate content continuation shapes before any machine can resume them.
+pub(crate) fn validate(
+    effect: &EffectRequest,
+    state: &[u32],
+    core: &GameStateCore,
+    card_count: usize,
+) -> bool {
+    if state.is_empty() {
+        return true;
+    }
+    let seats = core.players.len();
+    match effect {
+        EffectRequest::ResolveOlJieDanshou { player, .. } => {
+            player.raw() > 0
+                && player.raw() as usize <= seats
+                && state.len() == 3
+                && (1..=7).contains(&state[0])
+                && (state[0] == 1 || (1..=4).contains(&state[1]))
+                && (state[0] <= 2 || (state[2] as usize) < seats)
+        }
+        EffectRequest::ChooseGiveOrRecastOneHand { player, .. } => {
+            player.raw() > 0
+                && player.raw() as usize <= seats
+                && state.len() == 3
+                && (1..=5).contains(&state[0])
+                && (state[0] == 1 || (state[1] as usize) < card_count)
+                && state[2] as usize <= seats
+                && (state[0] != 2
+                    || core
+                        .player((player.raw() - 1) as u8)
+                        .hand
+                        .contains(&state[1]))
+        }
+        EffectRequest::ChooseOtherTargetsBySkippedPhaseCountDamageDraw { player, .. } => {
+            player.raw() > 0
+                && player.raw() as usize <= seats
+                && state.len() >= 4
+                && state.len() <= seats + 4
+                && (1..=3).contains(&state[0])
+                && (state[1] as usize) <= state.len() - 4
+                && state[3] < (1 << seats)
+                && state[4..]
+                    .iter()
+                    .all(|target| (*target as usize) < seats && *target + 1 != player.raw())
+                && state[4..]
+                    .iter()
+                    .collect::<std::collections::BTreeSet<_>>()
+                    .len()
+                    == state.len() - 4
+        }
+        _ => false,
+    }
+}
+
+pub(crate) fn active_eligible(
+    module: &rule_vm::BytecodeModule,
+    skill: &str,
+    owner: u8,
+    core: &GameStateCore,
+) -> bool {
+    use rule_vm::bytecode::{effect_tag, op};
+    let tag = effect_tag::RESOLVE_OL_JIE_DANSHOU.to_le_bytes();
+    // Only a verified single-resolver body has the resolver's intrinsic activation precondition.
+    let single = [
+        op::HOST_SELF,
+        op::HOST_SKILL,
+        op::HOST_EFFECT_EXT,
+        tag[0],
+        tag[1],
+        op::HALT,
+    ];
+    if module.entry_pc == 0 && module.code == single {
+        return !danshou::options(core, owner, skill).is_empty();
+    }
+    true
+}
diff --git a/crates/engine-native-content/src/content/vm_effects/danshou.rs b/crates/engine-native-content/src/content/vm_effects/danshou.rs
new file mode 100644
index 00000000..e85e2c0a
--- /dev/null
+++ b/crates/engine-native-content/src/content/vm_effects/danshou.rs
@@ -0,0 +1,196 @@
+//! OL界胆守: choose an unused option, settle it completely, then discard its ordinal.
+use super::*;
+
+fn used(core: &GameStateCore, owner: u8, skill: &str, option: u32) -> bool {
+    core.vm_aux
+        .flags
+        .contains_key(&(owner, crate::rvm_ops::storage_key(skill, option)))
+}
+
+fn targets(core: &GameStateCore, owner: u8, option: u32) -> Vec<ChoiceOption> {
+    core.alive_players()
+        .filter(|target| match option {
+            1 => !cards(core, *target).is_empty(),
+            2 => *target != owner && !cards(core, *target).is_empty(),
+            _ => true,
+        })
+        .map(ChoiceOption::Player)
+        .collect()
+}
+
+pub(super) fn options(core: &GameStateCore, owner: u8, skill: &str) -> Vec<ChoiceOption> {
+    if cards(core, owner).is_empty() {
+        return Vec::new();
+    }
+    (1..=4)
+        .filter(|option| {
+            !used(core, owner, skill, *option) && !targets(core, owner, *option).is_empty()
+        })
+        .map(|option| ChoiceOption::Tag(option as u8))
+        .collect()
+}
+
+pub(super) fn active_ask(
+    core: &GameStateCore,
+    owner: u8,
+    skill: &str,
+    state: &[u32],
+) -> Option<ExpectedAsk> {
+    let [stage, option, target] = *state else {
+        return None;
+    };
+    Some(match stage {
+        1 => ask(
+            owner,
+            "rvm_danshou_option",
+            ChoiceKind::PickTag,
+            options(core, owner, skill),
+            1,
+            1,
+            true,
+        ),
+        2 => ask(
+            owner,
+            "rvm_danshou_target",
+            ChoiceKind::SelectPlayers,
+            targets(core, owner, option),
+            1,
+            1,
+            false,
+        ),
+        3 if (target as usize) < core.players.len() => ask(
+            owner,
+            "rvm_danshou_card",
+            ChoiceKind::SelectCards,
+            cards(core, target as u8),
+            1,
+            1,
+            false,
+        ),
+        5 => {
+            let cards = cards(core, owner);
+            let count = (option as usize).min(cards.len());
+            if count == 0 {
+                return None;
+            }
+            ask(
+                owner,
+                "rvm_danshou_discard",
+                ChoiceKind::SelectCards,
+                cards,
+                count,
+                count,
+                false,
+            )
+        }
+        _ => return None,
+    })
+}
+
+pub(super) fn step(ctx: &mut Ctx<'_>, skill: &str, owner: u8, state: &mut Vec<u32>) -> Flow {
+    if !ctx.core.player(owner).alive {
+        return Flow::Done;
+    }
+    if state.is_empty() {
+        if options(ctx.core, owner, skill).is_empty() {
+            return Flow::Done;
+        }
+        *state = vec![1, 0, 0];
+        return wait(active_ask(ctx.core, owner, skill, state).expect("option ask"));
+    }
+    if state.len() != 3 {
+        return Flow::Done;
+    }
+    match state[0] {
+        1 => {
+            let Some(ChoiceOption::Tag(option)) = ctx.answer().first() else {
+                return Flow::Done;
+            };
+            state[1] = *option as u32;
+            state[0] = 2;
+            wait(active_ask(ctx.core, owner, skill, state).expect("target ask"))
+        }
+        2 => {
+            let Some(ChoiceOption::Player(target)) = ctx.answer().first() else {
+                return Flow::Done;
+            };
+            let target = *target;
+            let option = state[1];
+            state[2] = target as u32;
+            ctx.core
+                .vm_aux
+                .flags
+                .insert((owner, crate::rvm_ops::storage_key(skill, option)), 1);
+            ctx.core
+                .vm_aux
+                .storage
+                .insert(format!("{skill}#{option}"), 1);
+            if option <= 2 {
+                state[0] = 3;
+                return wait(active_ask(ctx.core, owner, skill, state).expect("entity ask"));
+            }
+            state[0] = 4;
+            if option == 3 {
+                ctx.emit(crate::event::EventData::Damage(
+                    crate::machine::damage_data(Some(owner), target, 1),
+                ));
+            } else {
+                state[0] = 7;
+                ctx.draw_cards(owner, 2);
+            }
+            Flow::Yield
+        }
+        3 => {
+            let Some(ChoiceOption::Card(card)) = ctx.answer().first() else {
+                return Flow::Done;
+            };
+            let card = *card;
+            let target = state[2] as u8;
+            if state[1] == 1 {
+                discard(ctx, target, &[card]);
+            } else if ctx.core.player(target).hand.contains(&card) {
+                ctx.give_hand_card(target, owner, card);
+            } else {
+                ctx.take_owned_card(target, card);
+                ctx.core.player_mut(owner).hand.push(card);
+                ctx.emit(crate::event::EventData::CardsMoved {
+                    cards: vec![card],
+                    from: target,
+                    to: owner,
+                });
+            }
+            state[0] = 4;
+            Flow::Yield
+        }
+        7 => {
+            state[0] = 4;
+            let target = state[2] as u8;
+            if ctx.core.player(target).alive {
+                ctx.draw_cards(target, 2);
+                Flow::Yield
+            } else {
+                self::step(ctx, skill, owner, state)
+            }
+        }
+        4 => {
+            state[0] = 5;
+            active_ask(ctx.core, owner, skill, state)
+                .map(wait)
+                .unwrap_or(Flow::Done)
+        }
+        5 => {
+            let picked: Vec<_> = ctx
+                .answer()
+                .iter()
+                .filter_map(|c| match c {
+                    ChoiceOption::Card(c) => Some(*c),
+                    _ => None,
+                })
+                .collect();
+            discard(ctx, owner, &picked);
+            state[0] = 6;
+            Flow::Yield
+        }
+        _ => Flow::Done,
+    }
+}
diff --git a/crates/engine-native-content/src/content/vm_effects/fenghe.rs b/crates/engine-native-content/src/content/vm_effects/fenghe.rs
new file mode 100644
index 00000000..0d42ba49
