@@ -0,0 +1,155 @@
+//! 冯河: give a physical hand card or recast a recastable card; reward only an actual give.
+use super::*;
+
+fn owns(core: &GameStateCore, catalog: &Catalog, owner: u8, source_def: u32) -> bool {
+    source_def != 0
+        && core.skills.keys().any(|(seat, def)| {
+            *seat == owner
+                && catalog.skills[*def as usize].behavior.package_skill_id() == Some(source_def)
+        })
+}
+
+pub(super) fn active_ask(
+    core: &GameStateCore,
+    catalog: &Catalog,
+    owner: u8,
+    state: &[u32],
+) -> Option<ExpectedAsk> {
+    let [stage, card, _source] = *state else {
+        return None;
+    };
+    Some(match stage {
+        1 => ask(
+            owner,
+            "rvm_fenghe_card",
+            ChoiceKind::SelectCards,
+            core.player(owner)
+                .hand
+                .iter()
+                .map(|c| ChoiceOption::Card(*c))
+                .collect(),
+            1,
+            1,
+            false,
+        ),
+        2 if (card as usize) < catalog.cards.len() && core.player(owner).hand.contains(&card) => {
+            let mut targets: Vec<_> = core
+                .alive_players()
+                .filter(|p| *p != owner)
+                .map(ChoiceOption::Player)
+                .collect();
+            if catalog.card_kind(card) == crate::catalog::CardKind::Chain {
+                targets.push(ChoiceOption::Pass);
+            }
+            ask(
+                owner,
+                "rvm_fenghe_destination",
+                ChoiceKind::SelectPlayers,
+                targets,
+                1,
+                1,
+                false,
+            )
+        }
+        _ => return None,
+    })
+}
+
+pub(super) fn step(
+    ctx: &mut Ctx<'_>,
+    owner: u8,
+    required: u32,
+    grant_skill: u32,
+    grant_mark: u32,
+    state: &mut Vec<u32>,
+) -> Flow {
+    if !ctx.core.player(owner).alive {
+        return Flow::Done;
+    }
+    if state.is_empty() {
+        if ctx.core.player(owner).hand.is_empty() {
+            return Flow::Done;
+        }
+        let source = ctx
+            .current_damage()
+            .ok()
+            .and_then(|d| d.source)
+            .map(|s| s as u32 + 1)
+            .unwrap_or(0);
+        *state = vec![1, 0, source];
+        return wait(active_ask(ctx.core, ctx.catalog, owner, state).expect("card ask"));
+    }
+    if state.len() != 3 {
+        return Flow::Done;
+    }
+    match state[0] {
+        1 => {
+            let Some(ChoiceOption::Card(card)) = ctx.answer().first() else {
+                return Flow::Done;
+            };
+            state[1] = *card;
+            state[0] = 2;
+            wait(active_ask(ctx.core, ctx.catalog, owner, state).expect("destination ask"))
+        }
+        2 => {
+            let card = state[1];
+            if !ctx.core.player(owner).hand.contains(&card) {
+                return Flow::Done;
+            }
+            match ctx.answer().first() {
+                Some(ChoiceOption::Player(target)) => {
+                    let target = *target;
+                    ctx.give_hand_card(owner, target, card);
+                    state[0] = 3;
+                }
+                Some(ChoiceOption::Pass)
+                    if ctx.catalog.card_kind(card) == crate::catalog::CardKind::Chain =>
+                {
+                    discard(ctx, owner, &[card]);
+                    state[0] = 4;
+                }
+                _ => return Flow::Done,
+            }
+            Flow::Yield
+        }
+        3 => {
+            let Some(source) = state[2].checked_sub(1).map(|s| s as u8) else {
+                return Flow::Done;
+            };
+            if ctx.core.player(source).alive
+                && !ctx.core.player(source).dying
+                && owns(ctx.core, ctx.catalog, owner, required)
+            {
+                if grant_mark != 0 {
+                    *ctx.core
+                        .vm_aux
+                        .marks
+                        .entry((source, grant_mark))
+                        .or_default() += 1;
+                }
+                if grant_skill != 0 {
+                    for (def, entry) in ctx.catalog.skills.iter().enumerate() {
+                        if entry.behavior.package_skill_id() == Some(grant_skill) {
+                            ctx.core.skills.entry((source, def as u16)).or_insert(
+                                crate::state::SkillInstance {
+                                    owner: source,
+                                    enabled: true,
+                                    once_used: false,
+                                    expires_end_of_turn: false,
+                                    rounds: 0,
+                                },
+                            );
+                        }
+                    }
+                }
+            }
+            Flow::Done
+        }
+        4 => {
+            ctx.draw_cards(owner, 1);
+            state[0] = 5;
+            Flow::Yield
+        }
+        _ => Flow::Done,
+    }
+}
diff --git a/crates/engine-native-content/src/content/vm_effects/pingkou.rs b/crates/engine-native-content/src/content/vm_effects/pingkou.rs
new file mode 100644
index 00000000..d978bb05
--- /dev/null
+++ b/crates/engine-native-content/src/content/vm_effects/pingkou.rs
@@ -0,0 +1,102 @@
+//! 平寇: settle one complete damage frame at a time, and draw once per actual damaged player.
+use super::*;
+
+pub(super) fn active_ask(core: &GameStateCore, owner: u8, state: &[u32]) -> Option<ExpectedAsk> {
+    if state != [1, 0, 0, 0] {
+        return None;
+    }
+    let options: Vec<_> = core
+        .alive_players()
+        .filter(|p| *p != owner)
+        .map(ChoiceOption::Player)
+        .collect();
+    let skipped = core
+        .vm_aux
+        .flags
+        .get(&(owner, "vm_skipped_phase_count".to_string()))
+        .copied()
+        .unwrap_or(0) as usize;
+    let max = skipped.min(options.len());
+    if max == 0 {
+        return None;
+    }
+    Some(ask(
+        owner,
+        "rvm_pingkou_targets",
+        ChoiceKind::SelectPlayers,
+        options,
+        1,
+        max,
+        true,
+    ))
+}
+
+pub(super) fn step(ctx: &mut Ctx<'_>, owner: u8, amount: u32, state: &mut Vec<u32>) -> Flow {
+    if state.is_empty() {
+        *state = vec![1, 0, 0, 0];
+        return active_ask(ctx.core, owner, state)
+            .map(wait)
+            .unwrap_or(Flow::Done);
+    }
+    if state.len() < 4 {
+        return Flow::Done;
+    }
+    match state[0] {
+        1 => {
+            let mut targets: Vec<_> = ctx
+                .answer()
+                .iter()
+                .filter_map(|o| match o {
+                    ChoiceOption::Player(p) => Some(*p),
+                    _ => None,
+                })
+                .collect();
+            if targets.is_empty() {
+                return Flow::Done;
+            }
+            targets.sort_by_key(|p| ctx.core.seat_steps_from(owner, *p));
+            state.extend(targets.into_iter().map(u32::from));
+            state[0] = 2;
+            Flow::Yield
+        }
+        2 => {
+            if !ctx.core.player(owner).alive {
+                return Flow::Done;
+            }
+            while (state[1] as usize) < state.len() - 4 {
+                let target = state[4 + state[1] as usize] as u8;
+                state[1] += 1;
+                if !ctx.core.player(target).alive {
+                    continue;
+                }
+                state[2] = ctx.damage_with_receipt(
+                    owner,
+                    crate::machine::damage_data(Some(owner), target, amount),
+                );
+                state[0] = 3;
+                return Flow::Yield;
+            }
+            Flow::Done
+        }
+        3 => {
+            let damaged = ctx
+                .core
+                .vm_aux
+                .flags
+                .remove(&(owner, format!("vm_damage_receipt:{}", state[2])))
+                .unwrap_or(0);
+            state[0] = 2;
+            if damaged > 0 && damaged <= ctx.core.players.len() as u32 {
+                let bit = 1 << (damaged - 1);
+                if state[3] & bit == 0 {
+                    state[3] |= bit;
+                    if ctx.core.player(owner).alive {
+                        ctx.draw_cards(owner, 1);
+                    }
+                }
+            }
+            Flow::Yield
+        }
+        _ => Flow::Done,
+    }
+}
diff --git a/crates/engine-native-kernel/src/rvm_bridge/handlers.rs b/crates/engine-native-kernel/src/rvm_bridge/handlers.rs
new file mode 100644
index 00000000..80902937
--- /dev/null
+++ b/crates/engine-native-kernel/src/rvm_bridge/handlers.rs
@@ -0,0 +1,113 @@
+//! Package active entry constraints and trigger handlers sharing one logical skill.
+use super::*;
+use crate::catalog::TriggerMeta;
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct VmActiveLimits {
+    pub once_per_turn: bool,
+    pub once_per_play_phase: bool,
+    pub hand_nonempty: bool,
+    pub equip_nonempty: bool,
+    pub hand_gt_hp: bool,
+    pub hand_gt_max_hp: bool,
+    pub face_up: bool,
+    pub owner_unlinked: bool,
+    pub mark_at_least: Option<(u32, u32)>,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct VmTriggerProgram {
+    pub program: Arc<VmSkillProgram>,
+    pub meta: TriggerMeta,
+    pub filter: VmFilterPolicy,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct VmHandlerSet {
+    pub skill_def_id: u32,
+    pub active: Arc<VmSkillProgram>,
+    pub limits: VmActiveLimits,
+    pub triggers: Vec<VmTriggerProgram>,
+}
+
+impl VmHandlerSet {
+    pub(super) fn available(&self, ctx: &QueryCtx<'_>, owner: PlayerId) -> bool {
+        let p = ctx.state.player(owner);
+        let name = &self.active.skill_name;
+        p.alive
+            && ctx.state.turn.current == owner
+            && ctx.state.turn.phase == crate::event::Phase::Play
+            && (!self.limits.once_per_turn
+                || !ctx.state.vm_aux.once.contains(&(owner, name.clone(), 1)))
+            && (!self.limits.once_per_play_phase
+                || !ctx.state.vm_aux.once.contains(&(owner, name.clone(), 4)))
+            && (!self.limits.hand_nonempty || !p.hand.is_empty())
+            && (!self.limits.equip_nonempty || !p.equips.is_empty())
+            && (!self.limits.hand_gt_hp || p.hand.len() as i64 > p.hp as i64)
+            && (!self.limits.hand_gt_max_hp || p.hand.len() > p.max_hp as usize)
+            && (!self.limits.face_up || !p.face_down)
+            && (!self.limits.owner_unlinked || !p.linked)
+            && self.limits.mark_at_least.is_none_or(|(mark, count)| {
+                ctx.state
+                    .vm_aux
+                    .marks
+                    .get(&(owner, mark))
+                    .copied()
+                    .unwrap_or(0) as i64
+                    >= count as i64
+            })
+    }
+
+    pub(super) fn matching<'a>(
+        &'a self,
+        ctx: &QueryCtx<'_>,
+        owner: PlayerId,
+        event: &EventData,
+    ) -> Vec<&'a VmTriggerProgram> {
+        self.triggers
+            .iter()
+            .filter(|entry| {
+                entry.meta.event == event.kind()
+                    && VmSkillBehavior {
+                        program: entry.program.clone(),
+                        filter: entry.filter.clone(),
+                    }
+                    .filter(ctx, owner, event)
+            })
+            .collect()
+    }
+}
+
+pub(super) fn machine(
+    program: Arc<VmSkillProgram>,
+    filter: &VmFilterPolicy,
+    owner: PlayerId,
+    event: &EventData,
+) -> VmMachine {
+    fn named_meta(f: &VmFilterPolicy) -> (Vec<(String, u8)>, bool) {
+        match f {
+            VmFilterPolicy::Named(p) => (p.consume.clone(), p.count_hits),
+            VmFilterPolicy::AtPhase { inner, .. } | VmFilterPolicy::Declared { inner, .. } => {
+                named_meta(inner)
+            }
+            _ => (Vec::new(), false),
+        }
+    }
+    let (consume, count_hits) = named_meta(filter);
+    VmMachine {
+        owner,
+        program,
+        trig: trigger_ctx_of(event),
+        event: event.clone(),
+        pending_effects: Vec::new(),
+        paused: None,
+        asked: false,
+        settled: false,
+        consume,
+        count_hits,
+        commit_pause: None,
+        following: Vec::new(),
+        commit_state: Vec::new(),
+        committing: false,
+    }
+}
diff --git a/crates/engine-native-wasm/tests/adr0786_j2_cross_target.rs b/crates/engine-native-wasm/tests/adr0786_j2_cross_target.rs
new file mode 100644
index 00000000..46ccf9b0
--- /dev/null
+++ b/crates/engine-native-wasm/tests/adr0786_j2_cross_target.rs
@@ -0,0 +1,269 @@
+//! J2 formal author packages: native oracle and byte-complete wasm32 replay vectors.
+#[path = "adr0786_j2_cross_target/cases.rs"]
+mod cases;
+use engine_native::{ChoiceOption as O, CommandOutcome, Engine, GameAction, GameCommand};
+use engine_native_wasm::test_support::{engine_from_archive, engine_from_packs, hex_encode};
+use serde_json::{json, Value};
+
+fn package(source: &str, name: &str) -> String {
+    let mut package = content_compiler::compile_source_named(name, source).unwrap();
+    let declarations = content_native_loader::bridge_vm_skill_decls(&package).unwrap();
+    let generals = [("j2-cross-author",false),("j2-cross-watcher",true)].iter().map(|(name, watcher)| json!({"name":name,"hp":4,"gender":"male","faction":"qun","skills":declarations.decls.iter().filter(|d|d.name.starts_with("j2_watcher")==*watcher).map(|d|json!({"name":d.name})).collect::<Vec<_>>()})).collect::<Vec<_>>();
+    let characters = json!({"pack":{"name":name,"version":1},"generals":generals});
+    let character_bytes = serde_json::to_vec(&characters).unwrap();
+    package.asset_manifest = Some(serde_json::from_value(json!({"schema_version":1,"package_id":name,"total_compressed_size":0,"total_decoded_size":0,"entries":[{"asset_id":"j2:characters","source_hash":blake3::hash(&character_bytes).as_bytes(),"kind":"Data","image_variants":[],"audio_variants":[],"priority":"Lazy","depends_on":[],"platforms":[]}]})).unwrap());
+    package
+        .asset_paths
+        .insert("j2:characters".into(), "assets/character.json".into());
+    package.manifest.asset_hash = package.compute_asset_hash();
+    package.manifest.logic_hash = package.compute_logic_hash();
+    package.validate().unwrap();
+    let mut payload = serde_json::to_value(package).unwrap();
+    payload["characters"] = characters;
+    json!([payload]).to_string()
+}
+
+fn apply(engine: &mut Engine, command: &Value) -> CommandOutcome {
+    let actor = command["actor"].as_u64().unwrap() as u8;
+    let action = match command["type"].as_str().unwrap() {
+        "nextPhase" => GameAction::NextPhase,
+        "activateSkill" => GameAction::ActivateSkill {
+            skill: command["skill"].as_u64().unwrap() as u16,
+        },
+        "playCard" => GameAction::PlayCard {
+            card: command["card"].as_u64().unwrap() as u32,
+            targets: command["targets"]
+                .as_array()
+                .unwrap()
+                .iter()
+                .map(|n| n.as_u64().unwrap() as u8)
+                .collect(),
+        },
+        "answer" => {
+            let options = engine.open_choice().unwrap().spec.options.clone();
+            GameAction::Answer {
+                choice_id: command["choice_id"].as_u64().unwrap(),
+                selection: command["selections"]
+                    .as_array()
+                    .unwrap()
+                    .iter()
+                    .map(|n| options[n.as_u64().unwrap() as usize])
+                    .collect(),
+            }
+        }
+        other => panic!("unknown command {other}"),
+    };
+    let revision = engine.revision();
+    engine.submit(GameCommand {
+        actor,
+        expected_revision: revision,
+        dedup_id: revision.wrapping_mul(2).max(1),
+        action,
+    })
+}
+
+fn outcome(out: &CommandOutcome) -> &'static str {
+    match out {
+        CommandOutcome::Accepted { .. } => "accepted",
+        CommandOutcome::Pending { .. } => "pending",
+        CommandOutcome::Rejected(_) => "rejected",
+        CommandOutcome::Suspended => "suspended",
+    }
+}
+
+fn choice(engine: &Engine) -> Value {
+    let Some(c) = engine.open_choice() else {
+        return Value::Null;
+    };
+    let options: Vec<_> = c
+        .spec
+        .options
+        .iter()
+        .map(|o| match o {
+            O::Card(c) => json!({"card":c}),
+            O::Player(p) => json!({"player":p}),
+            O::Tag(t) => json!({"tag":t}),
+            O::Kind(k) => json!({"kind":k}),
+            O::Confirm => json!("confirm"),
+            O::Pass => json!("pass"),
+        })
+        .collect();
+    json!({"id":c.id,"observer":c.observer,"prompt":c.spec.prompt,"min":c.spec.min,"max":c.spec.max,"allowCancel":c.spec.allow_cancel,"options":options})
+}
+
+fn rejected_probes(engine: &mut Engine) {
+    let Some(c) = engine.open_choice().cloned() else {
+        return;
+    };
+    let snapshot = engine.save();
+    let log = engine.log().to_vec();
+    let dedup = engine.revision().wrapping_mul(2).max(1);
+    for (actor, id, selection) in [
+        ((c.observer + 1) % 4, c.id, vec![c.spec.options[0]]),
+        (c.observer, c.id + 1, vec![c.spec.options[0]]),
+        (c.observer, c.id, vec![O::Tag(255)]),
+    ] {
+        assert!(matches!(
+            engine.submit(GameCommand {
+                actor,
+                expected_revision: engine.revision(),
+                dedup_id: dedup,
+                action: GameAction::Answer {
+                    choice_id: id,
+                    selection
+                }
+            }),
+            CommandOutcome::Rejected(_)
+        ));
+        assert_eq!(engine.save(), snapshot);
+        assert_eq!(engine.log(), log);
+    }
+}
+
+struct Trace {
+    engine: Engine,
+    packs: String,
+    initial: String,
+    steps: Vec<Value>,
+    invalid_archives: Vec<String>,
+}
+impl Trace {
+    fn start(source: &str, name: &str) -> Self {
+        let packs = package(source, name);
+        let mut engine = engine_from_packs(4, 99107860, &packs).unwrap();
+        engine.assign_general_named(0, "j2-cross-author").unwrap();
+        Self {
+            engine,
+            packs,
+            initial: String::new(),
+            steps: vec![],
+            invalid_archives: vec![],
+        }
+    }
+    fn begin(&mut self) {
+        self.steps.clear();
+        self.initial = hex_encode(&engine_native::archive::encode_archive(&self.engine.save()));
+        self.engine = engine_from_archive(&self.initial, &self.packs).unwrap();
+    }
+    fn advance_to_play(&mut self, seat: u8) {
+        for _ in 0..40 {
+            if self.engine.turn().current == seat
+                && self.engine.turn().phase == engine_native::Phase::Play
+            {
+                return;
+            }
+            if self.engine.open_choice().is_some() {
+                self.default_answer();
+            } else {
+                self.step(json!({"type":"nextPhase","actor":self.engine.turn().current}));
+            }
+        }
+        panic!("did not reach Play");
+    }
+    fn step(&mut self, command: Value) {
+        let before_choice = choice(&self.engine);
+        let before = hex_encode(&engine_native::archive::encode_archive(&self.engine.save()));
+        let mut restored = engine_from_archive(&before, &self.packs).unwrap();
+        rejected_probes(&mut self.engine);
+        rejected_probes(&mut restored);
+        let cursor = self.engine.log().len();
+        let out = apply(&mut self.engine, &command);
+        let resumed = apply(&mut restored, &command);
+        assert_ne!(outcome(&out), "rejected", "{command}: {out:?}");
+        assert_eq!(outcome(&out), outcome(&resumed));
+        assert_eq!(self.engine.save().core, restored.save().core);
+        assert_eq!(self.engine.save().resolution, restored.save().resolution);
+        assert_eq!(&self.engine.log()[cursor..], restored.log());
+        let codes = self.engine.public_event_codes_from(cursor);
+        assert_eq!(codes, restored.public_event_codes_from(0));
+        let after = hex_encode(&engine_native::archive::encode_archive(&self.engine.save()));
+        if command["type"] == "answer" {
+            let snapshot = self.engine.save();
+            let log = self.engine.log().to_vec();
+            // The accepted command's original dedup key cannot settle the choice a second time.
+            let old_key = snapshot.last_dedup;
+            assert!(matches!(
+                self.engine.submit(GameCommand {
+                    actor: command["actor"].as_u64().unwrap() as u8,
+                    expected_revision: self.engine.revision(),
+                    dedup_id: old_key,
+                    action: GameAction::Answer {
+                        choice_id: command["choice_id"].as_u64().unwrap(),
+                        selection: vec![]
+                    }
+                }),
+                CommandOutcome::Rejected(_)
+            ));
+            assert_eq!(self.engine.save(), snapshot);
+            assert_eq!(self.engine.log(), log);
+        }
+        self.steps.push(json!({"command":command,"before_choice":before_choice,"outcome":outcome(&out),"choice":choice(&self.engine),"hash":hex_encode(&self.engine.state_hash()),"codes":codes,"archive":after,"resumed_archive":hex_encode(&engine_native::archive::encode_archive(&restored.save()))}));
+    }
+    fn activate(&mut self, name: &str) {
+        let skill = self.engine.catalog().skill_by_name(name).unwrap();
+        self.step(json!({"type":"activateSkill","actor":0,"skill":skill}));
+    }
+    fn answer(&mut self, selection: Vec<O>) {
+        let c = self.engine.open_choice().unwrap();
+        let indices: Vec<_> = selection
+            .iter()
+            .map(|o| {
+                c.spec
+                    .options
+                    .iter()
+                    .position(|option| option == o)
+                    .expect("legal choice")
+            })
+            .collect();
+        self.step(
+            json!({"type":"answer","actor":c.observer,"choice_id":c.id,"selections":indices}),
+        );
+    }
+    fn default_answer(&mut self) {
+        let c = self.engine.open_choice().unwrap();
+        let selected = if c.spec.options.contains(&O::Pass) {
+            vec![O::Pass]
+        } else if c.spec.prompt == "trigger_confirm" {
+            vec![O::Confirm]
+        } else if c.spec.allow_cancel {
+            vec![]
+        } else {
+            c.spec.options.iter().take(c.spec.min).copied().collect()
+        };
+        self.answer(selected);
+    }
+    fn drain(&mut self) {
+        for _ in 0..40 {
+            if self.engine.open_choice().is_none() {
+                return;
+            }
+            self.default_answer();
+        }
+        panic!("unbounded choices");
+    }
+    fn finish(self, name: &str) -> Value {
+        assert!(self.engine.open_choice().is_none());
+        json!({"name":name,"packs_json":self.packs,"initial":self.initial,"steps":self.steps,"invalid_archives":self.invalid_archives})
+    }
+}
+
+#[test]
+fn j2_author_primitives_native_and_every_checkpoint_replay_vectors() {
+    let scenarios = cases::scenarios();
+    assert!(scenarios.len() >= 16);
+    let steps: usize = scenarios
+        .iter()
+        .map(|s| s["steps"].as_array().unwrap().len())
+        .sum();
+    if let Some(path) = std::env::var_os("J2_CROSS_NATIVE_OUT") {
+        std::fs::write(
+            path,
+            serde_json::to_vec_pretty(&json!({"scenarios":scenarios,"steps":steps})).unwrap(),
+        )
+        .unwrap();
+    }
+    eprintln!(
+        "J2_NATIVE_MATRIX scenarios={} steps={steps}",
+        scenarios.len()
+    );
+}
diff --git a/crates/engine-native-wasm/tests/adr0786_j2_cross_target/cases.rs b/crates/engine-native-wasm/tests/adr0786_j2_cross_target/cases.rs
new file mode 100644
index 00000000..7bcec925
--- /dev/null
+++ b/crates/engine-native-wasm/tests/adr0786_j2_cross_target/cases.rs
@@ -0,0 +1,582 @@
+//! Scenario families share the formal bridge and command/checkpoint recorder in the parent test.
+use super::*;
+const DAN: &str = include_str!("../../../../content/original/ported/onlyOL/ol_jie_danshou.skill");
+const FENG: &str = include_str!("../../../../content/original/ported/shiji/pinghe.skill");
+const PING: &str = include_str!("../../../../content/original/ported/onlyOL/ol_pingkou.skill");
+const FEN: &str = include_str!("../../../../content/original/ported/onlyOL/ol_fenli.skill");
+const MARKERS: &str = r#"
+skill j2_yingba_identity(2187983153) { trigger phase_play owner_is_target { effect storage_set(self_skill, 9, 1); } }
+skill j2_pingding_identity(3219705664) locked { trigger phase_end owner_is_target { effect storage_set(self_skill, 9, 1); } }
+"#;
+
+fn fill(t: &mut Trace, owner: u8, count: usize) {
+    t.engine.debug_clear_hand(owner);
+    for _ in 0..count {
+        t.engine.debug_place(owner, "shan");
+    }
+}
+fn discard_choice(t: &mut Trace) {
+    let c = t.engine.open_choice().unwrap();
+    assert_eq!(c.spec.prompt, "rvm_danshou_discard");
+    let chosen = c
+        .spec
+        .options
+        .iter()
+        .rev()
+        .take(c.spec.min)
+        .copied()
+        .collect();
+    t.answer(chosen);
+}
+fn danshou_branch(t: &mut Trace, option: u8, target: u8) {
+    t.activate("ol_jie_danshou");
+    t.answer(vec![O::Tag(option)]);
+    t.answer(vec![O::Player(target)]);
+    if option <= 2 {
+        let card = t.engine.open_choice().unwrap().spec.options[0];
+        t.answer(vec![card]);
+    }
+}
+fn danshou(output: &mut Vec<Value>) {
+    for option in 1..=4 {
+        let name = format!("danshou-option-{option}");
+        let mut t = Trace::start(DAN, &name);
+        t.advance_to_play(0);
+        fill(&mut t, 0, 8);
+        fill(&mut t, 1, 2);
+        t.begin();
+        let before = t.engine.state_core().player(0).hand.len();
+        danshou_branch(&mut t, option, 1);
+        assert_eq!(t.engine.open_choice().unwrap().spec.min, option as usize);
+        if option == 3 {
+            assert_eq!(t.engine.debug_hp(1), 3);
+        }
+        discard_choice(&mut t);
+        let gain = if option == 2 {
+            1
+        } else if option == 4 {
+            2
+        } else {
+            0
+        };
+        assert_eq!(
+            t.engine.state_core().player(0).hand.len(),
+            before + gain - option as usize
+        );
+        t.activate("ol_jie_danshou");
+        assert!(!t
+            .engine
+            .open_choice()
+            .unwrap()
+            .spec
+            .options
+            .contains(&O::Tag(option)));
+        t.answer(vec![]);
+        output.push(t.finish(&name));
+    }
+    let mut t = Trace::start(DAN, "danshou-cancel");
+    t.advance_to_play(0);
+    t.begin();
+    let hand = t.engine.state_core().player(0).hand.clone();
+    t.activate("ol_jie_danshou");
+    t.answer(vec![]);
+    assert_eq!(t.engine.state_core().player(0).hand, hand);
+    output.push(t.finish("danshou-cancel"));
+    let mut t = Trace::start(DAN, "danshou-insufficient");
+    t.advance_to_play(0);
+    fill(&mut t, 0, 1);
+    t.begin();
+    danshou_branch(&mut t, 3, 1);
+    assert_eq!(t.engine.open_choice().unwrap().spec.min, 1);
+    discard_choice(&mut t);
+    assert!(t.engine.state_core().player(0).hand.is_empty());
+    output.push(t.finish("danshou-insufficient"));
+    let mut t = Trace::start(DAN, "danshou-self-draw");
+    t.advance_to_play(0);
+    fill(&mut t, 0, 8);
+    t.begin();
+    danshou_branch(&mut t, 4, 0);
+    discard_choice(&mut t);
+    assert_eq!(t.engine.state_core().player(0).hand.len(), 8);
+    output.push(t.finish("danshou-self-draw"));
+    for save in [false, true] {
+        let name = if save {
+            "danshou-dying-save"
+        } else {
+            "danshou-dying-death"
+        };
+        let mut t = Trace::start(DAN, name);
+        t.advance_to_play(0);
+        for seat in 0..4 {
+            fill(&mut t, seat, 0);
+        }
+        fill(&mut t, 0, 8);
+        let tao = save.then(|| t.engine.debug_place(0, "tao"));
+        t.engine.debug_set_hp(1, 1);
+        t.begin();
+        danshou_branch(&mut t, 3, 1);
+        while t
+            .engine
+            .open_choice()
+            .is_some_and(|c| c.spec.prompt == "dying_save")
+        {
+            let c = t.engine.open_choice().unwrap();
+            if c.observer == 0 && save {
+                t.answer(vec![O::Card(tao.unwrap())]);
+            } else {
+                t.answer(vec![O::Pass]);
+            }
+        }
+        assert_eq!(t.engine.state_core().player(1).alive, save);
+        discard_choice(&mut t);
+        output.push(t.finish(name));
+    }
+    let mut t = Trace::start(DAN, "danshou-four-options-and-reset");
+    t.advance_to_play(0);
+    fill(&mut t, 0, 16);
+    for seat in 1..4 {
+        fill(&mut t, seat, 2);
+    }
+    t.begin();
+    for option in 1..=4 {
+        danshou_branch(&mut t, option, 1);
+        discard_choice(&mut t);
+    }
+    let skill = t.engine.catalog().skill_by_name("ol_jie_danshou").unwrap();
+    assert!(!t
+        .engine
+        .legal_actions(0)
+        .iter()
+        .any(|action| matches!(action,GameAction::ActivateSkill {skill:s} if *s==skill)));
+    t.step(json!({"type":"nextPhase","actor":0}));
+    t.drain();
+    t.advance_to_play(1);
+    t.advance_to_play(0);
+    fill_assert(&t);
+    t.activate("ol_jie_danshou");
+    assert_eq!(t.engine.open_choice().unwrap().spec.options.len(), 4);
+    t.answer(vec![]);
+    output.push(t.finish("danshou-four-options-and-reset"));
+}
+fn fill_assert(t: &Trace) {
+    assert!(!t.engine.state_core().player(0).hand.is_empty());
+}
+
+fn fenghe(output: &mut Vec<Value>) {
+    for mode in 0..4 {
+        let names = [
+            "fenghe-give-owned-disabled-yingba",
+            "fenghe-give-no-yingba",
+            "fenghe-recast",
+            "fenghe-source-dies-during-give",
+        ];
+        let name = names[mode];
+        let mut source = format!("{FENG}\n{MARKERS}");
+        if mode == 3 {
+            source.push_str("skill j2_after_give(99107866) locked { trigger cards_given owner_alive_gave_cards_to_other_alive { effect kill_player(event_player, self); } }");
+        }
+        let mut t = Trace::start(&source, name);
+        t.advance_to_play(1);
+        let yingba = t
+            .engine
+            .catalog()
+            .skill_by_name("j2_yingba_identity_phase_play")
+            .unwrap();
+        if mode == 1 {
+            t.engine.state_core_mut().skills.remove(&(0, yingba));
+        } else {
+            t.engine
+                .state_core_mut()
+                .skills
+                .get_mut(&(0, yingba))
+                .unwrap()
+                .enabled = false;
+        }
+        fill(&mut t, 0, 0);
+        let card = t
+            .engine
+            .debug_place(0, if mode == 2 { "chain" } else { "shan" });
+        fill(&mut t, 1, 0);
+        let sha = t.engine.debug_place(1, "sha");
+        t.begin();
+        t.step(json!({"type":"playCard","actor":1,"card":sha,"targets":[0]}));
+        if t.engine
+            .open_choice()
+            .is_some_and(|c| c.spec.prompt == "respond_shan")
+        {
+            t.answer(vec![O::Pass]);
+        }
+        assert_eq!(
+            t.engine.open_choice().unwrap().spec.prompt,
+            "rvm_fenghe_card"
+        );
+        assert_eq!(t.engine.state_core().player(0).max_hp, 3);
+        assert_eq!(t.engine.debug_hp(0), 3);
+        t.answer(vec![O::Card(card)]);
+        if mode == 0 {
+            let mut forged = t.engine.save();
+            let wrong = t
+                .engine
+                .state_core()
+                .deck
+                .iter()
+                .copied()
+                .find(|c| {
+                    t.engine.catalog().card_kind(*c) != engine_native::catalog::CardKind::Chain
+                })
+                .unwrap();
+            for park in &mut forged.resolution.parks {
+                if let engine_native::MachineSnapshot::Rvm { commit_state, .. } = &mut park.machine
+                {
+                    if commit_state.first() == Some(&2) {
+                        commit_state[1] = wrong;
+                    }
+                }
+            }
+            let bytes = hex_encode(&engine_native::archive::encode_archive(&forged));
+            assert!(engine_from_archive(&bytes, &t.packs).is_err());
+            t.invalid_archives.push(bytes);
+        }
+        assert_eq!(
+            t.engine
+                .open_choice()
+                .unwrap()
+                .spec
+                .options
+                .contains(&O::Pass),
+            mode == 2
+        );
+        t.answer(vec![if mode == 2 { O::Pass } else { O::Player(1) }]);
+        t.drain();
+        assert_eq!(
+            t.engine
+                .state_core()
+                .vm_aux
+                .marks
+                .get(&(1, 3219705664))
+                .copied()
+                .unwrap_or(0),
+            if mode == 0 { 1 } else { 0 }
+        );
+        if mode == 3 {
+            assert!(!t.engine.state_core().player(1).alive);
+        }
+        output.push(t.finish(name));
+    }
+    for (name, source_expr, dead) in [
+        ("fenghe-self-source", "self", false),
+        ("fenghe-missing-source", "event_source", false),
+        ("fenghe-dead-source", "2", true),
+    ] {
+        let source=format!("{FENG}\nskill j2_damage_probe(99107867) {{ active play_phase targets 0 0 {{ effect deal_damage({source_expr},self,1); }} }}");
+        let mut t = Trace::start(&source, name);
+        t.advance_to_play(0);
+        fill(&mut t, 0, 4);
+        if dead {
+            t.engine.state_core_mut().player_mut(1).alive = false;
+        }
+        t.begin();
+        t.activate("j2_damage_probe");
+        t.drain();
+        assert_eq!(t.engine.state_core().player(0).max_hp, 4);
+        assert_eq!(t.engine.debug_hp(0), 3);
+        output.push(t.finish(name));
+    }
+    for empty in [false, true] {
+        let name = if empty {
+            "fenghe-empty-hand"
+        } else {
+            "fenghe-max-hp-one"
+        };
+        let mut t = Trace::start(FENG, name);
+        t.advance_to_play(1);
+        for seat in 0..4 {
+            fill(&mut t, seat, 0);
+        }
+        if !empty {
+            t.engine.debug_set_max_hp(0, 1);
+            t.engine.debug_set_hp(0, 1);
+            t.engine.debug_place(0, "shan");
+        }
+        let sha = t.engine.debug_place(1, "sha");
+        t.begin();
+        t.step(json!({"type":"playCard","actor":1,"card":sha,"targets":[0]}));
+        while let Some(c) = t.engine.open_choice() {
+            assert!(!c.spec.prompt.starts_with("rvm_fenghe"));
+            t.default_answer();
+        }
+        assert_eq!(
+            t.engine.state_core().player(0).max_hp,
+            if empty { 4 } else { 1 }
+        );
+        output.push(t.finish(name));
+    }
+}
+
+fn pingkou(output: &mut Vec<Value>) {
+    for mode in 0..5 {
+        let names = [
+            "pingkou-real-three-skips",
+            "pingkou-prevention-and-save",
+            "pingkou-prevention-and-death",
+            "pingkou-cancel",
+            "pingkou-next-target-dies-before-damage",
+        ];
+        let name = names[mode];
+        let mut source = format!("{FEN}\n{PING}");
+        if mode == 1 || mode == 2 {
+            source.push_str("skill j2_prevent(99107863) locked { trigger damage_before owner_is_target { effect prevent_current_damage(); } }");
+        }
+        if mode == 4 {
+            source.push_str("skill j2_kill_next(99107864) locked { trigger death owner_alive_not_target { if 0 < hp(3) { effect kill_player(3,self); } } }");
+        }
+        let mut t = Trace::start(&source, name);
+        if mode == 1 || mode == 2 {
+            t.engine.assign_general_named(1, "j2-cross-author").unwrap();
+        }
+        for seat in 0..4 {
+            fill(&mut t, seat, 0);
+        }
+        fill(&mut t, 0, 8);
+        let equipment_name = t
+            .engine
+            .catalog()
+            .cards
+            .iter()
+            .find(|card| card.kind.equip_slot().is_some())
+            .unwrap()
+            .name;
+        let equipment = t.engine.debug_place(0, equipment_name);
+        t.engine
+            .state_core_mut()
+            .player_mut(0)
+            .hand
+            .retain(|c| *c != equipment);
+        t.engine
+            .state_core_mut()
+            .player_mut(0)
+            .equips
+            .push(equipment);
+        let tao = (mode == 1).then(|| t.engine.debug_place(0, "tao"));
+        if mode == 1 || mode == 2 {
+            t.engine.debug_set_hp(2, 1);
+        }
+        if mode == 4 {
+            t.engine.debug_set_hp(1, 1);
+        }
+        t.begin();
+        for _ in 0..20 {
+            if t.engine
+                .open_choice()
+                .is_some_and(|c| c.spec.prompt == "rvm_pingkou_targets")
+            {
+                break;
+            }
+            if t.engine.open_choice().is_some() {
+                t.default_answer();
+            } else {
+                t.step(json!({"type":"nextPhase","actor":0}));
+            }
+        }
+        assert_eq!(
+            t.engine.open_choice().unwrap().spec.max,
+            3,
+            "all three actual skipped phases count"
+        );
+        let hand = t.engine.state_core().player(0).hand.len();
+        if mode == 3 {
+            t.answer(vec![]);
+            assert_eq!(t.engine.state_core().player(0).hand.len(), hand);
+            output.push(t.finish(name));
+            continue;
+        }
+        t.answer(vec![O::Player(3), O::Player(2), O::Player(1)]);
+        while let Some(c) = t.engine.open_choice() {
+            assert_eq!(c.spec.prompt, "dying_save");
+            if mode == 1 && c.observer == 0 {
+                t.answer(vec![O::Card(tao.unwrap())]);
+            } else {
+                t.answer(vec![O::Pass]);
+            }
+        }
+        let draws = if mode == 0 { 3 } else { 2 };
+        let saved_cost = usize::from(mode == 1);
+        assert_eq!(
+            t.engine.state_core().player(0).hand.len(),
+            hand + draws - saved_cost
+        );
+        if mode == 1 || mode == 2 {
+            assert_eq!(t.engine.debug_hp(1), 4);
+            assert_eq!(t.engine.state_core().player(2).alive, mode == 1);
+        }
+        if mode == 4 {
+            assert!(!t.engine.state_core().player(1).alive);
+            assert!(!t.engine.state_core().player(2).alive);
+            assert_eq!(t.engine.debug_hp(3), 3);
+        }
+        assert!(!t
+            .engine
+            .state_core()
+            .vm_aux
+            .flags
+            .keys()
+            .any(|(_, key)| key.starts_with("vm_damage_receipt:")));
+        output.push(t.finish(name));
+    }
+}
+
+fn reviewed_boundaries(output: &mut Vec<Value>) {
+    for kill in [false, true] {
+        let name = if kill {
+            "danshou-owner-draw-kills-target"
+        } else {
+            "danshou-owner-draw-nested-choice-order"
+        };
+        let body = if kill {
+            "effect kill_player(self,event_player);"
+        } else {
+            "effect discard_hand_equip_count(self,1);"
+        };
+        let source=format!("{DAN}\nskill j2_watcher(99107868) locked {{ trigger cards_drawn owner_alive {{ {body} }} }}");
+        let mut t = Trace::start(&source, name);
+        t.advance_to_play(0);
+        t.engine
+            .assign_general_named(1, "j2-cross-watcher")
+            .unwrap();
+        fill(&mut t, 0, 8);
+        fill(&mut t, 1, 3);
+        t.begin();
+        t.activate("ol_jie_danshou");
+        t.answer(vec![O::Tag(4)]);
+        t.answer(vec![O::Player(1)]);
+        if kill {
+            assert!(!t.engine.state_core().player(1).alive);
+        } else {
+            assert_eq!(
+                t.engine.open_choice().unwrap().spec.prompt,
+                "rvm_discard_pick"
+            );
+            assert_eq!(t.engine.state_core().player(1).hand.len(), 3);
+            let card = t.engine.open_choice().unwrap().spec.options[0];
+            t.answer(vec![card]);
+            assert_eq!(t.engine.state_core().player(1).hand.len(), 4);
+            let card = t.engine.open_choice().unwrap().spec.options[0];
+            t.answer(vec![card]);
+        }
+        discard_choice(&mut t);
+        assert_eq!(t.engine.state_core().player(0).hand.len(), 6);
+        output.push(t.finish(name));
+    }
+    for remove in [false, true] {
+        let name = if remove {
+            "grouped-handler-removed-after-choice"
+        } else {
+            "grouped-owner-dead-after-choice"
+        };
+        let effect = if remove {
+            "effect remove_skill(self_skill);"
+        } else {
+            "effect kill_player(self,self);"
+        };
+        let source=format!("skill j2_group(99107872) {{ trigger phase_play owner_is_target {{ effect discard_hand_equip_count(self,1); {effect} }} trigger phase_play owner_is_target {{ effect draw_cards(self,2); }} active play_phase targets 0 0 {{ effect draw_cards(self,1); }} }}");
+        let mut t = Trace::start(&source, name);
+        t.begin();
+        for _ in 0..10 {
+            if t.engine.open_choice().is_some() {
+                break;
+            }
+            t.step(json!({"type":"nextPhase","actor":0}));
+        }
+        assert_eq!(
+            t.engine.open_choice().unwrap().spec.prompt,
+            "rvm_discard_pick"
+        );
+        let card = t.engine.open_choice().unwrap().spec.options[0];
+        let hand = t.engine.state_core().player(0).hand.len();
+        t.answer(vec![card]);
+        assert_eq!(
+            t.engine.state_core().player(0).hand.len(),
+            if remove { hand - 1 } else { 0 }
+        );
+        output.push(t.finish(name));
+    }
+    let source="skill j2_disabled(99107874) { trigger phase_play owner_is_target { effect discard_hand_equip_count(self,1); effect draw_cards(self,1); } trigger phase_play owner_is_target { effect draw_cards(self,2); } active play_phase targets 0 0 { effect draw_cards(self,1); } }";
+    let mut t = Trace::start(source, "grouped-instance-disabled-at-checkpoint");
+    for _ in 0..10 {
+        if t.engine.open_choice().is_some() {
+            break;
+        }
+        t.step(json!({"type":"nextPhase","actor":0}));
+    }
+    let def = t.engine.catalog().skill_by_name("j2_disabled").unwrap();
+    t.engine
+        .state_core_mut()
+        .skills
+        .get_mut(&(0, def))
+        .unwrap()
+        .enabled = false;
+    t.begin();
+    let hand = t.engine.state_core().player(0).hand.len();
+    let card = t.engine.open_choice().unwrap().spec.options[0];
+    t.answer(vec![card]);
+    assert_eq!(t.engine.state_core().player(0).hand.len(), hand);
+    output.push(t.finish("grouped-instance-disabled-at-checkpoint"));
+    let source="skill j2_private(99107873) { trigger phase_play owner_is_target { effect storage_set(self_skill,1,self); } active play_phase targets 0 0 { if storage_has(self_skill,1) { if storage_get(self_skill,1)==self { effect draw_cards(self,1); } } } }";
+    for other in [false, true] {
+        let name = if other {
+            "storage-two-owner-no-mark-fallback"
+        } else {
+            "storage-trigger-active-owner-identity"
+        };
+        let mut t = Trace::start(source, name);
+        t.engine.assign_general_named(1, "j2-cross-author").unwrap();
+        t.advance_to_play(0);
+        if other {
+            t.engine.state_core_mut().vm_aux.marks.insert((0, 1), 2);
+            t.engine.state_core_mut().turn.current = 1;
+        }
+        t.begin();
+        let owner = u8::from(other);
+        let hand = t.engine.state_core().player(owner).hand.len();
+        let skill = t.engine.catalog().skill_by_name("j2_private").unwrap();
+        t.step(json!({"type":"activateSkill","actor":owner,"skill":skill}));
+        assert_eq!(
+            t.engine.state_core().player(owner).hand.len(),
+            hand + usize::from(!other)
+        );
+        output.push(t.finish(name));
+    }
+    for unreachable in [false, true] {
+        let name = if unreachable {
+            "active-unreachable-danshou"
+        } else {
+            "active-preceding-draw-danshou"
+        };
+        let body = if unreachable {
+            "if 0==1 { effect resolve_ol_jie_danshou(self); } else { effect draw_cards(self,1); }"
+        } else {
+            "effect draw_cards(self,1); effect resolve_ol_jie_danshou(self);"
+        };
+        let source =
+            format!("skill j2_prefix(99107875) {{ active play_phase targets 0 0 {{ {body} }} }}");
+        let mut t = Trace::start(&source, name);
+        t.advance_to_play(0);
+        fill(&mut t, 0, 0);
+        t.begin();
+        t.activate("j2_prefix");
+        assert_eq!(t.engine.state_core().player(0).hand.len(), 1);
+        if t.engine.open_choice().is_some() {
+            t.answer(vec![]);
+        }
+        output.push(t.finish(name));
+    }
+}
+
+pub(super) fn scenarios() -> Vec<Value> {
+    let mut output = vec![];
+    danshou(&mut output);
+    fenghe(&mut output);
+    pingkou(&mut output);
+    reviewed_boundaries(&mut output);
+    output
+}
