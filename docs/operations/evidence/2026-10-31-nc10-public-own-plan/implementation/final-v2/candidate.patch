+#[test]
+fn shared_public_selector_obeys_order_card_preference_and_bounds() {
+    use engine_native::ai::projected_choice_action;
+    use engine_native::{ChoiceKind, ChoiceSpec};
+    let cases = [
+        (
+            vec![ChoiceOption::Pass, ChoiceOption::Card(7)],
+            1,
+            1,
+            false,
+            vec![ChoiceOption::Card(7)],
+            true,
+        ),
+        (
+            vec![ChoiceOption::Confirm],
+            1,
+            1,
+            true,
+            vec![ChoiceOption::Confirm],
+            true,
+        ),
+        (
+            vec![ChoiceOption::Tag(1), ChoiceOption::Tag(0)],
+            1,
+            1,
+            false,
+            vec![ChoiceOption::Tag(1)],
+            true,
+        ),
+        (
+            vec![
+                ChoiceOption::Card(7),
+                ChoiceOption::Card(7),
+                ChoiceOption::Card(8),
+            ],
+            2,
+            2,
+            false,
+            vec![ChoiceOption::Card(7), ChoiceOption::Card(8)],
+            true,
+        ),
+        (vec![], 0, 0, false, vec![], true),
+        (
+            vec![ChoiceOption::Pass],
+            0,
+            1,
+            false,
+            vec![ChoiceOption::Pass],
+            true,
+        ),
+        (vec![], 1, 1, true, vec![], true),
+        (vec![], 1, 1, false, vec![], false),
+        (
+            vec![ChoiceOption::Player(2)],
+            2,
+            2,
+            true,
+            vec![],
+            true,
+        ),
+        (
+            vec![ChoiceOption::Player(2)],
+            2,
+            2,
+            false,
+            vec![ChoiceOption::Player(2)],
+            false,
+        ),
+        (
+            vec![ChoiceOption::Card(9)],
+            2,
+            1,
+            false,
+            vec![ChoiceOption::Card(9)],
+            false,
+        ),
+        (vec![ChoiceOption::Card(9)], 1, 0, true, vec![], true),
+    ];
+    for (options, min, max, allow_cancel, expected, accepted) in cases {
+        let spec = ChoiceSpec {
+            kind: ChoiceKind::SelectCards,
+            prompt: "public-selector",
+            options: options.clone(),
+            min,
+            max,
+            allow_cancel,
+        };
+        let choice = ChoiceView::Own {
+            id: 91,
+            kind: spec.kind,
+            prompt: spec.prompt,
+            options,
+            min,
+            max,
+            allow_cancel,
+            source_skill: None,
+        };
+        let action = projected_choice_action(choice).unwrap();
+        assert!(
+            matches!(action, GameAction::Answer { choice_id: 91, ref selection } if selection == &expected)
+        );
+        assert_eq!(spec.accepts(&expected), accepted);
+    }
+    assert!(projected_choice_action(ChoiceView::Other {
+        id: 91,
+        observer: 1,
+        prompt: "public-selector"
+    })
+    .is_none());
+}
