+#[test]
+fn changed_public_options_are_rejected_without_a_hidden_fallback() {
+    let [mut engine, _] = yiji_pair();
+    let mut saved = engine.save();
+    let open = saved.resolution.open_choice.as_mut().unwrap();
+    open.spec.min = 2;
+    open.spec.max = 2;
+    assert!(
+        Engine::restore(&saved).is_err(),
+        "native ask binding still rejects a mismatched archive"
+    );
+    let before = engine.save();
+    let mut plan = engine.plan_action(1, &BoundedPlanner::new(64));
+    let Some(ChoiceView::Own { id, .. }) = engine.ai_session(1).choice() else {
+        panic!("own choice")
+    };
+    plan.action = engine_native::ai::projected_choice_action(ChoiceView::Own {
+        id,
+        kind: engine_native::ChoiceKind::PickTag,
+        prompt: "mutated",
+        options: vec![ChoiceOption::Tag(0)],
+        min: 1,
+        max: 1,
+        allow_cancel: false,
+        source_skill: None,
+    })
+    .unwrap();
+    assert_eq!((plan.nodes_used, plan.sim_faults), (0, 0));
+    assert!(matches!(
+        engine.apply_plan(&plan).unwrap(),
+        CommandOutcome::Rejected(engine_native::RejectReason::InvalidChoice)
+    ));
+    assert_eq!(engine.save(), before);
+}
