+import {EngineClient} from "../src/engine/client";
+import {isTauriShell} from "../src/engine/desktopHost";
+import type {EngineEnvelope} from "../src/types/engine";
+const check=(value:unknown,message:string)=>{if(!value)throw new Error(message);};
+const wait=async(test:()=>boolean)=>{for(let i=0;i<300;i++){if(test())return;await new Promise(resolve=>setTimeout(resolve,20));}throw new Error("actual UI timed out");};
+const original=EngineClient.prototype.start;
+let actual:EngineEnvelope;let client:EngineClient;let ready:()=>void;
+let mode="native";let hex="";
+EngineClient.prototype.start=async function(){
+ client=this;await original.call(this,3,2306,1,"[]");actual=await this.restoreHex(hex,"[]");
+ check(actual.choice?.source_skill==="遗计","real Worker lost source_skill");
+ if(mode==="missing"&&actual.choice){actual={...actual,choice:{...actual.choice,source_skill:undefined}};}
+ if(mode==="null"&&actual.choice){actual={...actual,choice:{...actual.choice,source_skill:null}};}
+ if(mode==="escaped"&&actual.choice){actual={...actual,choice:{...actual.choice,source_skill:"<img src=x onerror=alert(1)>"}};}
+ ready();return actual;
+};
+const cases:unknown[]=[];
+try {
+ hex=await fetch("/actual-native-ask.hex").then(response=>response.text());
+ localStorage.setItem("noname-next-skip-anims","1");history.replaceState(null,"",isTauriShell()?"/?engineTransport=native":"/?engineTransport=wasm");
+ for(mode of ["native","missing","null","escaped"]){
+  const mounted=new Promise<void>(resolve=>{ready=resolve;});
+  const root=document.createElement("div");document.body.append(root);
+  const router=createRouter({history:createMemoryHistory(),routes:[{path:"/",component:BattleView}]});await router.push("/");await router.isReady();
+  const app=createApp(BattleView);app.use(router);app.mount(root);
+  try{
+   await mounted;
+   const expected=mode==="native"?"是否发动【遗计】？":mode==="escaped"?"是否发动【<img src=x onerror=alert(1)>】？":"是否发动技能？";
+   await wait(()=>root.querySelector(".choice h2")?.textContent===expected);
+   check(root.querySelector(".choice img[onerror]")===null,"source became executable markup");
+   check(client!.getTransportKind()===(isTauriShell()?"desktop-native":"wasm-worker"),"selected transport changed");
+   const before=await client!.saveHex();await client!.observer();check(await client!.saveHex()===before,"metadata changed archive");
+   if(mode==="native"){
+    const button=root.querySelector<HTMLButtonElement>(".choice button");check(button&&!button.disabled,"real confirm unavailable");button!.click();
+    await wait(()=>root.querySelector(".choice h2")?.textContent!==expected);
+    check(!root.textContent?.includes("WrongPlayer"),"wrong owner answered");
+   }
+   cases.push({mode,heading:expected,transport:client!.getTransportKind(),actualWorkerSource:"遗计",archiveUnchanged:true});
+  }finally{app.unmount();root.remove();client!.dispose();}
+ }
+ await fetch("/report",{method:"POST",body:JSON.stringify({passed:true,cases})});
+}catch(error){await fetch("/report",{method:"POST",body:JSON.stringify({passed:false,error:String(error),stack:error instanceof Error?error.stack:null})});}
+finally{EngineClient.prototype.start=original;}
diff --git a/apps/web-client/scripts/ws6-observer-metadata-before-source.ts b/apps/web-client/scripts/ws6-observer-metadata-before-source.ts
new file mode 100644
index 00000000..493d7ef1
--- /dev/null
+++ b/apps/web-client/scripts/ws6-observer-metadata-before-source.ts
@@ -0,0 +1,57 @@
+// Frozen 4dd0b286 metadata reader; only its type import path is redirected.
+import type { ChoiceRequest, GeneralSlotView, NativeChoiceKind, ObserverSnapshot } from "../src/types/engine";
+
+const CHOICE_KINDS: Record<NativeChoiceKind, string> = {
+  confirm: "Confirm", select_cards: "SelectCards", select_players: "SelectTargets",
+  respond_card: "Custom", pick_tag: "Custom",
+};
+
+/** JSON metadata is optional for old producers; malformed present values are errors. */
+export function generalSlots(value: unknown): [GeneralSlotView | null, GeneralSlotView | null] {
+  if (value === undefined) return [null, null];
+  if (!Array.isArray(value) || value.length !== 2 || !value.every((slot) => slot === null || (
+    typeof slot === "object" && !Array.isArray(slot) && Number.isInteger(slot.def) && slot.def >= 0 && slot.def <= 0xffffffff &&
+    typeof slot.name === "string" && typeof slot.faction === "string" && typeof slot.revealed === "boolean"
+  ))) throw new Error("native: generals metadata invalid");
+  return value as [GeneralSlotView | null, GeneralSlotView | null];
+}
+
+export function choiceMetadata(value: { prompt?: unknown; native_kind?: unknown; kind?: string }): Pick<ChoiceRequest, "prompt" | "native_kind" | "kind"> {
+  if (value.prompt != null && typeof value.prompt !== "string") throw new Error("native: prompt metadata invalid");
+  if (value.native_kind != null && (typeof value.native_kind !== "string" || !Object.hasOwn(CHOICE_KINDS, value.native_kind))) throw new Error("native: native_kind metadata invalid");
+  const native_kind = value.native_kind as NativeChoiceKind | undefined;
+  return { ...(value.prompt == null ? {} : {prompt: value.prompt as string}), ...(native_kind == null ? {} : {native_kind}), kind: native_kind ? CHOICE_KINDS[native_kind] : value.kind ?? "Custom" };
+}
+
+const KIND_LABELS: Record<string, string> = {
+  confirm: "确认", select_cards: "选择卡牌", select_players: "选择角色", respond_card: "响应出牌", pick_tag: "选择选项",
+  Confirm: "确认", SelectCards: "选择卡牌", SelectTargets: "选择角色", Custom: "选择选项", OrderTriggers: "排列技能", DiscardToLimit: "弃牌至手牌上限",
+};
+const PROMPTS: Record<string, string> = {
+  trigger_confirm: "是否发动技能？", respond_shan: "请打出闪", respond_sha: "请打出杀", aoe_response: "请响应群体锦囊",
+  dying_save: "请选择救援牌", discard_to_limit: "请弃牌至手牌上限",
+  tuxi_target: "突袭：选择获得手牌的角色", guanxing_arrange: "观星：排列牌堆顶的卡牌",
+  xunxun_arrange: "恂恂：选择获得的卡牌",
+  jijie_give_target: "机捷：选择获得此牌的角色",
+  gaiming_pick: "改命：选择判定牌", haotianta_pick: "昊天塔：选择判定牌", liaoyuan_discard: "燎原：选择弃置的卡牌",
+  fanjian_target: "反间：选择目标角色", fanjian_suit: "反间：选择花色", fanjian_pick: "反间：选择获得的手牌",
+};
+
+export function choiceKindLabel(choice: ChoiceRequest): string {
+  const kind = choice.native_kind ?? choice.kind ?? "Custom";
+  return Object.hasOwn(KIND_LABELS, kind) ? KIND_LABELS[kind] : "选择选项";
+}
+
+export function choicePromptLabel(choice: ChoiceRequest): string {
+  if (!choice.prompt) return choiceKindLabel(choice);
+  return Object.hasOwn(PROMPTS, choice.prompt) ? PROMPTS[choice.prompt] : choiceKindLabel(choice);
+}
+
+/** Check optional metadata before an IPC/network payload enters the view store. */
+export function validateObserverMetadata(view: ObserverSnapshot, choice: ChoiceRequest | null): void {
+  for (const seat of view.seats ?? []) generalSlots(seat.generals);
+  if (choice) {
+    choiceMetadata(choice);
+    if (choice.deadline_unix_ms != null && (!Number.isSafeInteger(choice.deadline_unix_ms) || choice.deadline_unix_ms <= 0)) throw new Error("native: choice deadline invalid");
+  }
+}
