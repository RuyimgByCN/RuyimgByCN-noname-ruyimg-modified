+/// Existing native declarations whose damage body is an atomic source unit.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum NativeDamageEffect {
+    Jueqing,
+    Wuxin,
+    Zuijiu,
+}
+impl NativeDamageEffect {
+    pub fn window(self) -> DamageWindowKind {
+        match self {
+            Self::Jueqing | Self::Wuxin => DamageWindowKind::Before,
+            Self::Zuijiu => DamageWindowKind::Begin1,
+        }
+    }
+    pub fn matches(
+        self,
+        owner: PlayerId,
+        d: &DamageData,
+        catalog: &crate::catalog::Catalog,
+    ) -> bool {
+        match self {
+            Self::Jueqing => d.source == Some(owner) && d.target != owner,
+            Self::Wuxin => d.target == owner,
+            Self::Zuijiu => {
+                d.source == Some(owner)
+                    && d.card.is_some_and(|c| catalog.card_kind(c).is_sha_like())
+            }
+        }
+    }
+}
