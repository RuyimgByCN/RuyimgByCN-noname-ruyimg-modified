import datetime
import gzip
import shutil
import zlib
import hashlib
import json
import os
from pathlib import Path
import signal
import subprocess
import time

OUT = Path(__file__).resolve().parent
REPO = 'RuyimgByCN/RuyimgByCN-noname-ruyimg-modified'
SHA = '9f4b74236f97b0b9dc72388b6e08d310d2f26f64'
RUN = 41227614131
BASE = 'repos/' + REPO
ENV = {k: v for k, v in os.environ.items() if not k.startswith('GIT_TRACE') and k not in ('GH_DEBUG', 'GIT_CURL_VERBOSE')}
ENV.update(GODEBUG='http2client=0')
STARTED = time.monotonic()
SCOPE = json.loads((OUT.parent / 'push-stage/scope.json').read_text())
SCOPE_TIME = datetime.datetime.fromisoformat(SCOPE['created_utc']).timestamp()
# Preserve one watch; supervisor direction is required if still live at deadline warning.
CHECKPOINT_AT = SCOPE_TIME + 17 * 60
WATCH_STOP_AT = SCOPE_TIME + 55 * 60
HARD_STOP_AT = SCOPE_TIME + 58 * 60
STATE = {'run_id': RUN, 'head_sha': SHA, 'run_url': 'https://github.com/' + REPO + '/actions/runs/' + str(RUN), 'started_utc': datetime.datetime.now(datetime.timezone.utc).isoformat(), 'commands': [], 'cleanup': 'no child running', 'deadline_basis': 'Initial checkpoint beforewatch; one timedcheckpoint scope+17min, then finitewait toscope+55min. No sleep/poll loop/signal/restart. Pendingwatchownership recorded ifbound.', 'checkpoint_at_utc': datetime.datetime.fromtimestamp(CHECKPOINT_AT, datetime.timezone.utc).isoformat(), 'watch_deadline_warning_at_utc': datetime.datetime.fromtimestamp(WATCH_STOP_AT, datetime.timezone.utc).isoformat()}

def save():
    STATE['elapsed_seconds'] = time.monotonic() - STARTED
    (OUT / 'observation-state.json').write_text(json.dumps(STATE, indent=2) + '\n')

def command(argv, name, env=ENV, timeout=60):
    entry = {'command': argv, 'name': name, 'http1': env.get('GODEBUG') == 'http2client=0'}
    STATE['commands'].append(entry)
    save()
    with (OUT / (name + '.stdout')).open('xb') as stdout, (OUT / (name + '.stderr')).open('xb') as stderr:
        try:
            p = subprocess.run(argv, cwd=OUT, env=env, stdout=stdout, stderr=stderr)
            entry['exit'] = p.returncode
        except subprocess.TimeoutExpired:
            entry['exit'] = 'timeout'
    save()
    return entry

def transport_error(name):
    text = (OUT / (name + '.stderr')).read_bytes().lower()
    return any(t in text for t in (b'eof', b'http2', b'http/2', b'502'))

def api(endpoint, name, raw=False):
    argv = ['gh', 'api', '--allow-escape-sequences', endpoint]
    entry = command(argv, name, env={**ENV, 'GODEBUG': 'http2client=0'})
    if entry['exit'] != 0 and transport_error(name):
        STATE.setdefault('transport_retries', []).append({'source': name, 'endpoint': endpoint, 'reason': (OUT/(name+'.stderr')).read_text(errors='replace'), 'policy': 'One repeated identical read-only GET after recorded EOF/http2/502; no watchrestart or CLI switch'})
        name += '-transport-read-retry'
        entry = command(argv, name, env={**ENV, 'GODEBUG': 'http2client=0'})
    if entry['exit'] != 0:
        raise RuntimeError(name + ': API failure; original logs preserved')
    if raw:
        original = OUT / (name + '.stdout')
        data = original.read_bytes()
        compressed = name + '.stdout.gz'
        with (OUT / compressed).open('xb') as f:
            f.write(gzip.compress(data, mtime=0))
        private = OUT.parent / 'private-raw-downloads'
        private.mkdir(exist_ok=True)
        shutil.move(str(original), str(private / original.name))
        assert gzip.decompress((OUT / compressed).read_bytes()) == data
        return compressed
    return json.loads((OUT / (name + '.stdout')).read_bytes())

def verify_run(run):
    assert run['id'] == RUN and run['head_sha'] == SHA and run['head_branch'] == 'native-convergence' and run['event'] == 'push' and run['run_attempt'] == 1


def checkpoint(prefix):
    STATE['checkpoint_initial']=checkpoint('initial')
    run = json.loads((OUT/'initial-run.stdout').read_bytes())
    initial_jobs = json.loads((OUT/'initial-jobs.stdout').read_bytes())
    STATE['initial_jobs'] = [{'id': j['id'], 'name': j['name'], 'status': j['status'], 'conclusion': j['conclusion']} for j in initial_jobs['jobs']]
    save()
    if run['status'] != 'completed':
        watched = watch('watch', ENV)
    final_run = api(BASE + '/actions/runs/' + str(RUN), 'run-final')
    verify_run(final_run)
    jobs = api(BASE + '/actions/runs/' + str(RUN) + '/jobs?per_page=100', 'jobs-final')
    artifacts = api(BASE + '/actions/runs/' + str(RUN) + '/artifacts?per_page=100', 'artifacts-final')
    STATE['run_status'] = final_run['status']
    STATE['run_conclusion'] = final_run['conclusion']
    STATE['jobs'] = []
    for job in jobs['jobs']:
        item = {k: job.get(k) for k in ('id', 'name', 'html_url', 'status', 'conclusion', 'started_at', 'completed_at', 'runner_name', 'runner_group_name', 'labels')}
        try:
            detail = api(BASE + '/actions/jobs/' + str(job['id']), 'job-' + str(job['id']) + '-detail')
            assert detail['id'] == job['id'] and detail['run_id'] == RUN and detail['head_sha'] == SHA
            item['detail'] = detail
        except Exception as exc:
            item['detail_error'] = str(exc)
            detail = job
        item['listed_steps'] = job.get('steps', [])
        item['failed_steps'] = [s for s in detail.get('steps', []) if s.get('conclusion') == 'failure']
        item['skipped_steps'] = [s for s in detail.get('steps', []) if s.get('conclusion') == 'skipped']
        item['steps'] = detail.get('steps', [])
        STATE['jobs'].append(item)
        if job['status'] == 'completed' and time.time() < HARD_STOP_AT:
            try:
                item['raw_log'] = api(BASE + '/actions/jobs/' + str(job['id']) + '/logs', 'job-' + str(job['id']) + '-raw-log', raw=True)
                logbytes = gzip.decompress((OUT / item['raw_log']).read_bytes())
                item['log_sha256'] = hashlib.sha256(logbytes).hexdigest()
                item['log_crc32'] = f'{zlib.crc32(logbytes) & 0xffffffff:08x}'
                item['log_bytes'] = len(logbytes)
                item['log_crlf_count'] = logbytes.count(b'\r\n')
            except Exception as exc:
                item['log_error'] = type(exc).__name__ + ': ' + str(exc)
        save()
    STATE['artifacts'] = artifacts
    STATE['pending_jobs'] = [{'id': j['id'], 'name': j['name'], 'status': j['status']} for j in STATE['jobs'] if j['status'] != 'completed']
    STATE['job_count'] = len(STATE['jobs'])
    STATE['completed'] = final_run['status'] == 'completed' and len(STATE['jobs']) == 10 and not STATE['pending_jobs']
    (OUT / 'job-analyzer.json').write_text(json.dumps({'run_id': RUN, 'head_sha': SHA, 'status': final_run['status'], 'conclusion': final_run['conclusion'], 'jobs': STATE['jobs'], 'artifacts': artifacts}, indent=2) + '\n')
except Exception as exc:
    STATE['error'] = type(exc).__name__ + ': ' + str(exc)
finally:
    STATE['finished_utc'] = datetime.datetime.now(datetime.timezone.utc).isoformat()
    save()
