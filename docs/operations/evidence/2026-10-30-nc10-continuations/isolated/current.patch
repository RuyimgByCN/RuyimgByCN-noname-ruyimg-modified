+/// Latency is diagnostic unless the host is otherwise idle. Percentiles use nearest rank.
+#[test]
+#[ignore = "manual fixed-seed quality and latency matrix"]
+fn nc10_quality_matrix() {
+    use engine_native::{CommandOutcome, Role, Winner};
+    use std::time::Instant;
+    fn percentile(values: &mut [u128], percentile: usize) -> u128 {
+        values.sort_unstable();
+        values[(values.len() * percentile).div_ceil(100).saturating_sub(1)]
+    }
+    let mut matrix_errors = 0;
+    for seats in [4, 8] {
+        for identity in [false, true] {
+            for skills in [false, true] {
+                for (variant, depth) in [(0, 1), (1, 1), (1, 2)] {
+                    let mut latencies = Vec::new();
+                    let (mut games, mut finished, mut wins, mut rejected, mut faults) = (0, 0, 0, 0, 0);
+                    let (mut nodes, mut exhausted, mut leaves, mut steps) = (0, 0, 0, 0);
+                    for seed in [45000, 45001] {
+                        for challenger in 0..seats {
+                            let mut e = if identity { Engine::new_identity(seed, seats) } else { Engine::new(seed, seats) };
+                            if skills {
+                                for seat in 0..seats {
+                                    e.assign_general_named(seat as u8, ["曹操", "刘备", "孙权", "赵云"][seat % 4]).unwrap();
+                                }
+                            }
+                            let role = e.roles().map(|r| r[challenger]);
+                            let probe_before = engine_native::engine::legal_actions::probe_faults();
+                            let baseline = BoundedPlanner::new(8).with_policy_variant(0);
+                            let candidate = BoundedPlanner::new(8).with_policy_variant(variant).with_lookahead(depth);
+                            let mut game_steps = 0;
+                            while e.outcome().is_none() && game_steps < 800 {
+                                let actor = e.open_choice().map(|c| c.observer).unwrap_or(e.turn().current);
+                                let planner = if actor as usize == challenger { &candidate } else { &baseline };
+                                let started = Instant::now();
+                                let plan = e.plan_action(actor, planner);
+                                latencies.push(started.elapsed().as_nanos());
+                                faults += plan.sim_faults as u64;
+                                if plan.sim_faults > 0 { eprintln!("QUALITY_FAULT seed={seed} challenger={challenger} step={game_steps} context={:?}", engine_native::ai::sim_fault_log()); engine_native::ai::clear_sim_fault_log(); }
+                                nodes += plan.nodes_used;
+                                exhausted += usize::from(plan.budget_exhausted);
+                                leaves += usize::from(plan.nodes_used == 0);
+                                let result = e.apply_plan(&plan).unwrap();
+                                rejected += usize::from(matches!(result, CommandOutcome::Rejected(_)));
+                                game_steps += 1;
+                                if matches!(result, CommandOutcome::Rejected(_)) { eprintln!("QUALITY_REJECT seats={seats} seed={seed} actor={actor} plan={plan:?} choice={:?} result={result:?}", e.open_choice()); break; }
+                            }
+                            faults += engine_native::engine::legal_actions::probe_faults() - probe_before;
+                            games += 1;
+                            steps += game_steps;
+                            if let Some(outcome) = e.outcome() {
+                                finished += 1;
+                                wins += usize::from(match outcome.winner {
+                                    Winner::Player(seat) => seat as usize == challenger,
+                                    Winner::LordSide => matches!(role, Some(Role::Lord | Role::Loyalist)),
+                                    Winner::Rebels => role == Some(Role::Rebel),
+                                    Winner::Traitor => role == Some(Role::Traitor),
+                                    _ => false,
+                                });
+                            }
+                            eprintln!("QUALITY_GAME seats={seats} identity={identity} skills={skills} variant={variant} depth={depth} seed={seed} challenger={challenger} role={role:?} steps={game_steps} winner={:?}", e.outcome());
+                        }
+                    }
+                    let p50 = percentile(&mut latencies, 50);
+                    let p95 = percentile(&mut latencies, 95);
+                    let p99 = percentile(&mut latencies, 99);
+                    eprintln!("QUALITY_SUMMARY seats={seats} identity={identity} skills={skills} variant={variant} depth={depth} games={games} finished={finished} challenger_wins={wins} steps={steps} samples={} rejected={rejected} faults={faults} nodes={nodes} exhausted={exhausted} zero_node={leaves} p50_ns={p50} p95_ns={p95} p99_ns={p99}", latencies.len());
+                    matrix_errors += rejected + faults as usize;
+                }
+            }
+        }
+    }
+    assert_eq!(matrix_errors, 0, "quality matrix rejected plans or simulation faults");
+}
