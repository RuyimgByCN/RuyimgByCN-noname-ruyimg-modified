-    if bytes.len() % 2 != 0 {
-        return Err(format!(
-            "restore: 非法十六进制：长度为奇数（{}）",
-            bytes.len()
-        ));
-    }
-    let mut out = Vec::with_capacity(bytes.len() / 2);
-    for (index, pair) in bytes.chunks_exact(2).enumerate() {
-        let hi = hex_nibble(pair[0]).ok_or_else(|| {
-            format!(
-                "restore: 非法十六进制字符 {:?}（字节 {}）",
-                pair[0] as char,
-                index * 2
-            )
-        })?;
-        let lo = hex_nibble(pair[1]).ok_or_else(|| {
-            format!(
-                "restore: 非法十六进制字符 {:?}（字节 {}）",
-                pair[1] as char,
-                index * 2 + 1
-            )
-        })?;
-        out.push((hi << 4) | lo);
-    }
-    Ok(out)
-}
