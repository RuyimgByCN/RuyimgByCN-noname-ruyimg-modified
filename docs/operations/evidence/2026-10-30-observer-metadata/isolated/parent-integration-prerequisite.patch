+
+fn card_options(engine: &Engine) -> Vec<u32> {
+    engine
+        .open_choice()
+        .unwrap()
+        .spec
+        .options
+        .iter()
+        .filter_map(|option| match option {
+            ChoiceOption::Card(id) => Some(*id),
+            _ => None,
+        })
+        .collect()
+}
