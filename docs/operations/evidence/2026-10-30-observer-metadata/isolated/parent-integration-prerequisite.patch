+use desktop_client::NativeEngineHost;
+use engine_native_wasm::{NativeEngine, NativeSession, MAX_ARCHIVE_HEX_CHARS};
+use serde_json::{json, Value};
+
+async fn request(host: &NativeEngineHost, mut body: Value) -> Value {
+    body["id"] = json!(1);
+    let response = host.request(body).await.unwrap();
+    assert_eq!(response["ok"], true, "{response}");
+    response["data"].clone()
+}
+
+#[tokio::test]
+async fn host_requests_initialize_and_reject_invalid_input_without_losing_state() {
+    let host = NativeEngineHost::new().unwrap();
+    let init = request(&host, json!({"type": "init"})).await;
+    assert_eq!(init, "native ready");
+    request(
+        &host,
+        json!({"type": "start", "players": 4, "seed": 42, "observer": 0}),
+    )
+    .await;
+    let saved = request(&host, json!({"type": "save"})).await;
+    for mut invalid in [
+        json!({"type": "playCard", "actor": 0, "card": -1, "targets": []}),
+        json!({"type": "playCard", "actor": 256, "card": 1, "targets": []}),
+        json!({"type": "playCard", "actor": 0, "card": 1.5, "targets": []}),
+        json!({"type": "playCard", "actor": 0, "card": 1, "targets": [256]}),
+        json!({"type": "activateSkill", "actor": 0, "skill": 65536, "targets": [], "cardTargets": []}),
+        json!({"type": "activateSkill", "actor": 0, "skill": 1, "targets": [1], "cardTargets": []}),
+        json!({"type": "resolveChoice", "actor": 0, "choiceId": 9007199254740992u64, "selections": [], "cancelled": false}),
+        json!({"type": "start", "players": 4, "seed": 42, "observer": 255}),
+        json!({"type": "start", "players": 0, "seed": 42, "observer": 0}),
+        json!({"type": "start", "players": 4, "seed": 9007199254740992u64, "observer": 0}),
+        json!({"type": "start", "players": 4, "seed": 42, "observer": 0, "packsJson": "{}"}),
+        json!({"type": "restore", "hex": "中"}),
+        json!({"type": "restore", "hex": "abc"}),
+        json!({"type": "restore", "hex": "zz"}),
+        json!({"type": "validatePackage", "packJson": "{}"}),
+        json!({"type": "chooseGeneral", "seat": 0, "name": "unknown-general"}),
+        json!({"type": "useSkillCard"}),
+        json!({"type": "loadReplay"}),
+        json!({"type": "seekReplay"}),
+        json!({"type": "unknown-request"}),
+    ] {
+        invalid["id"] = json!(2);
+        let rejected = host.request(invalid).await.unwrap();
+        assert_eq!(rejected["ok"], false, "{rejected}");
+        assert_eq!(saved, request(&host, json!({"type": "save"})).await);
+    }
+    for field in ["hex", "packsJson", "packJson"] {
+        let mut oversized = json!({"id": 3, "type": "restore"});
+        oversized[field] = json!("0".repeat(MAX_ARCHIVE_HEX_CHARS + 1));
+        assert!(host
+            .request(oversized)
+            .await
+            .unwrap_err()
+            .contains("exceeds"));
+        assert_eq!(saved, request(&host, json!({"type": "save"})).await);
+    }
+}
+
+#[tokio::test]
+async fn host_full_identity_trajectory_matches_session_and_existing_binding_and_cross_restores() {
+    let host = NativeEngineHost::new().unwrap();
+    request(&host, json!({"type": "init"})).await;
+    let mut native = NativeSession::new_identity(4, 42).unwrap();
+    let mut binding = NativeEngine::new_identity(4, 42).unwrap();
+    let start = request(
+        &host,
+        json!({"type": "start", "players": 4, "seed": 42, "observer": 0, "mode": "identity"}),
+    )
+    .await;
+    assert_eq!(start["hash_hex"], native.state_hash_hex());
+    let mut finished = false;
+    for step in 0..2000 {
+        let actual = request(&host, json!({"type": "autoStep"})).await;
+        let expected: Value = serde_json::from_str(&native.auto_step().unwrap()).unwrap();
+        assert_eq!(actual["result"], expected, "step {step}");
+        assert_eq!(
+            expected,
+            serde_json::from_str::<Value>(&binding.auto_step().unwrap()).unwrap()
+        );
+        assert_eq!(actual["hash_hex"], native.state_hash_hex(), "step {step}");
+        assert_eq!(native.state_hash_hex(), binding.state_hash_hex());
+        if step == 30 {
+            let save = request(&host, json!({"type": "save"})).await;
+            native.restore_hex(save["hex"].as_str().unwrap()).unwrap();
+            binding
+                .restore_hex_checked(save["hex"].as_str().unwrap())
+                .unwrap();
+            let restored =
+                request(&host, json!({"type": "restore", "hex": binding.save_hex()})).await;
+            assert_eq!(actual["hash_hex"], restored["hash_hex"]);
+        }
+        if native.is_finished() {
+            finished = true;
+            break;
+        }
+    }
+    assert!(finished, "seed 42 must reach its actual terminal outcome");
+    assert!(!request(&host, json!({"type": "observer"})).await["view"]["outcome"].is_null());
+}
+
+#[tokio::test]
+async fn host_projects_authority_candidates_and_observer_privacy() {
+    let host = NativeEngineHost::new().unwrap();
+    request(&host, json!({"type": "init"})).await;
+    let data = request(
+        &host,
+        json!({"type": "start", "players": 4, "seed": 42, "observer": 1, "mode": "identity"}),
+    )
+    .await;
+    let reference = NativeSession::new_identity(4, 42).unwrap();
+    let raw: Value = serde_json::from_str(&reference.view_json(1).unwrap()).unwrap();
+    let known = data["view"]["known_cards"].as_array().unwrap();
+    assert_eq!(
+        known.len(),
+        raw["players"][1]["hand"]["own"].as_array().unwrap().len()
+    );
+    assert!(known
+        .iter()
+        .all(|card| card["owner"] == 1 && card["def"].is_number()));
+    for seat in 0..4 {
+        assert_eq!(
+            data["view"]["seats"][seat]["identity"],
+            raw["players"][seat]["identity"]
+        );
+    }
+    let candidates = request(&host, json!({"type": "generalCandidates"})).await;
+    assert_eq!(
+        candidates,
+        serde_json::from_str::<Value>(&reference.general_candidates_json()).unwrap()
+    );
+    let name = candidates["candidates"][0]["name"].as_str().unwrap();
+    let selected = request(
+        &host,
+        json!({"type": "chooseGeneral", "seat": 1, "name": name}),
+    )
+    .await;
+    assert_eq!(selected["assignment"]["name"], name);
+    assert_eq!(
+        selected["assignment"]["state_hash"],
+        selected["envelope"]["hash_hex"]
+    );
+    assert_eq!(
+        request(&host, json!({"type": "status"})).await["revision"],
+        selected["envelope"]["revision"]
+    );
+    // Invalid restored observer must leave the original four-seat match intact.
+    let before = request(&host, json!({"type": "save"})).await;
+    let one_seat = NativeSession::new(1, 0).unwrap().save_hex();
+    let rejected = host
+        .request(json!({"id": 2, "type": "restore", "hex": one_seat}))
+        .await
+        .unwrap();
+    assert_eq!(rejected["ok"], false);
+    assert_eq!(before, request(&host, json!({"type": "save"})).await);
+}
+
+#[tokio::test]
+async fn host_owns_a_single_ordered_command_stream_and_is_send_sync() {
+    fn assert_send_sync<T: Send + Sync>() {}
+    assert_send_sync::<NativeEngineHost>();
+    let host = NativeEngineHost::new().unwrap();
+    request(&host, json!({"type": "init"})).await;
+    request(
+        &host,
+        json!({"type": "start", "players": 4, "seed": 42, "observer": 0}),
+    )
+    .await;
+    let (first, second) = tokio::join!(
+        host.request(json!({"id": 2, "type": "autoStep"})),
+        host.request(json!({"id": 3, "type": "autoStep"})),
+    );
+    let first = first.unwrap();
+    let second = second.unwrap();
+    assert_eq!(first["id"], 2);
+    assert_eq!(second["id"], 3);
+    assert_eq!(
+        first["data"]["revision"].as_u64().unwrap() + 1,
+        second["data"]["revision"].as_u64().unwrap()
+    );
+}
+
+#[tokio::test]
+async fn independent_clients_do_not_reset_each_others_sessions_and_close_is_controlled() {
+    let battle = NativeEngineHost::new().unwrap();
+    let validator = NativeEngineHost::new().unwrap();
+    request(&battle, json!({"type": "init"})).await;
+    request(
+        &battle,
+        json!({"type": "start", "players": 4, "seed": 42, "observer": 0}),
+    )
+    .await;
+    request(&battle, json!({"type": "autoStep"})).await;
+    let saved = request(&battle, json!({"type": "save"})).await;
+    request(&validator, json!({"type": "init"})).await;
+    assert_eq!(saved, request(&battle, json!({"type": "save"})).await);
+    validator.close();
+    validator.close();
+    assert!(validator
+        .request(json!({"id": 1, "type": "save"}))
+        .await
+        .unwrap_err()
+        .contains("closed"));
+    assert_eq!(saved, request(&battle, json!({"type": "save"})).await);
+}
+
+#[cfg(feature = "tauri-shell")]
+#[tokio::test]
+async fn tauri_resource_ids_isolate_clients_and_have_a_real_capacity_and_close_boundary() {
+    use desktop_client::{close_native_engine, open_native_engine};
+    let mut table = tauri::ResourceTable::default();
+    let mut ids = Vec::new();
+    for _ in 0..8 {
+        ids.push(open_native_engine(&mut table).unwrap());
+    }
+    assert!(open_native_engine(&mut table)
+        .unwrap_err()
+        .contains("limit"));
+    let first = table.get::<NativeEngineHost>(ids[0]).unwrap();
+    let second = table.get::<NativeEngineHost>(ids[1]).unwrap();
+    request(&first, json!({"type": "init"})).await;
+    request(&first, json!({"type": "autoStep"})).await;
+    let saved = request(&first, json!({"type": "save"})).await;
+    request(&second, json!({"type": "init"})).await;
+    assert_eq!(saved, request(&first, json!({"type": "save"})).await);
+    close_native_engine(&mut table, ids[0]).unwrap();
+    assert!(close_native_engine(&mut table, ids[0]).is_err());
+    assert!(table.get::<NativeEngineHost>(ids[0]).is_err());
+    assert!(first
+        .request(json!({"id": 1, "type": "save"}))
+        .await
+        .unwrap_err()
+        .contains("closed"));
+    for id in ids.into_iter().skip(1) {
+        close_native_engine(&mut table, id).unwrap();
+    }
+    let replacement = open_native_engine(&mut table).unwrap();
+    close_native_engine(&mut table, replacement).unwrap();
+}
+
+#[cfg(feature = "tauri-shell")]
+#[tokio::test]
+async fn document_cleanup_retires_only_native_hosts_and_preserves_unrelated_resources() {
+    use desktop_client::{close_native_engines, open_native_engine};
+    use std::sync::{
+        atomic::{AtomicBool, Ordering},
+        Arc,
+    };
+    struct UnrelatedResource(Arc<AtomicBool>);
+    impl tauri::Resource for UnrelatedResource {
+        fn name(&self) -> std::borrow::Cow<'_, str> {
+            // Matching a name is insufficient: only NativeEngineHost's concrete type may be closed.
+            std::any::type_name::<NativeEngineHost>().into()
+        }
+        fn close(self: Arc<Self>) {
+            self.0.store(true, Ordering::Release);
+        }
+    }
+    let mut table = tauri::ResourceTable::default();
+    let other_closed = Arc::new(AtomicBool::new(false));
+    let unrelated_id = table.add(UnrelatedResource(other_closed.clone()));
+    for _document in 0..20 {
+        let first = open_native_engine(&mut table).unwrap();
+        let second = open_native_engine(&mut table).unwrap();
+        let retained_old_handle = table.get::<NativeEngineHost>(first).unwrap();
+        request(&retained_old_handle, json!({"type": "init"})).await;
+        assert_eq!(close_native_engines(&mut table), 2);
+        assert_eq!(close_native_engines(&mut table), 0);
+        assert!(table.get::<NativeEngineHost>(first).is_err());
+        assert!(table.get::<NativeEngineHost>(second).is_err());
+        assert!(retained_old_handle
+            .request(json!({"id": 2, "type": "status"}))
+            .await
+            .unwrap_err()
+            .contains("closed"));
+        assert!(table.get::<UnrelatedResource>(unrelated_id).is_ok());
+        assert!(!other_closed.load(Ordering::Acquire));
+    }
+    table.close(unrelated_id).unwrap();
+    assert!(other_closed.load(Ordering::Acquire));
+}
diff --git a/apps/desktop-client/tests/native_planner_measurement.rs b/apps/desktop-client/tests/native_planner_measurement.rs
new file mode 100644
index 00000000..96bc2137
--- /dev/null
+++ b/apps/desktop-client/tests/native_planner_measurement.rs
@@ -0,0 +1,79 @@
+//! Native-only measurements for PA09; these are not WebView or PA08 acceptance results.
+use engine_native::ai::{BoundedPlanner, PlanPool};
+use engine_native::ai_pool::PlannerPool;
+use engine_native::{Engine, GameAction, GameCommand};
+use std::time::Instant;
+
+fn percentile(values: &mut [u128], percent: usize) -> u128 {
+    values.sort_unstable();
+    values[(values.len() * percent).div_ceil(100).saturating_sub(1)]
+}
+
+#[test]
+#[ignore = "native wall-clock measurement; run explicitly with --ignored --nocapture"]
+fn actual_single_seat_planning_compares_existing_pools_and_native_clock() {
+    let mut engine = Engine::new_identity(42, 4);
+    for _ in 0..2 {
+        engine.submit(GameCommand {
+            actor: 0,
+            expected_revision: engine.revision(),
+            dedup_id: engine.revision() + 1,
+            action: GameAction::NextPhase,
+        });
+    }
+    let planner = BoundedPlanner::new(64).with_deadline_ms(50);
+    let pool = PlanPool::new(4);
+    let persistent = PlannerPool::new(4, 8);
+    let expected = engine.plan_action(0, &planner);
+    let mut direct = Vec::new();
+    let mut scoped = Vec::new();
+    let mut pooled = Vec::new();
+    for _ in 0..100 {
+        let started = Instant::now();
+        let plan = engine.plan_action(0, &planner);
+        direct.push(started.elapsed().as_nanos());
+        assert_eq!(plan.action, expected.action);
+        let started = Instant::now();
+        let plans = pool.plan_seats(&engine, &[0], &planner);
+        scoped.push(started.elapsed().as_nanos());
+        assert_eq!(plans[0].action, expected.action);
+        let started = Instant::now();
+        let plans = pool.plan_seats_with_pool(&persistent, &engine, &[0], &planner);
+        pooled.push(started.elapsed().as_nanos());
+        assert_eq!(plans[0].action, expected.action);
+    }
+    persistent.shutdown();
+    println!(
+        "{}",
+        serde_json::json!({
+            "workload": "4-seat identity seed42, first play phase, current seat only, 64 nodes / 50ms",
+            "samples": 100, "direct_p50_ns": percentile(&mut direct, 50),
+            "scoped_p50_ns": percentile(&mut scoped, 50), "persistent_p50_ns": percentile(&mut pooled, 50),
+            "direct_p95_ns": percentile(&mut direct, 95), "scoped_p95_ns": percentile(&mut scoped, 95),
+            "persistent_p95_ns": percentile(&mut pooled, 95),
+        })
+    );
+    // Stress the same planner's native clock without changing its candidate policy.
+    let mut snapshot = engine.save();
+    let cards = std::mem::take(&mut snapshot.core.deck);
+    snapshot.core.players[0].hand.extend(cards);
+    engine = Engine::restore(&snapshot).unwrap();
+    let hand_count = engine.view_for(0).players[0].hand_count;
+    let clock = BoundedPlanner::new(usize::MAX).with_deadline_ms(1);
+    let started = Instant::now();
+    let bounded = engine.plan_action(0, &clock);
+    let elapsed = started.elapsed();
+    assert!(
+        bounded.timed_out,
+        "stress workload must actually reach the native deadline"
+    );
+    assert!(
+        elapsed.as_millis() < 1000,
+        "native planning did not return promptly"
+    );
+    println!(
+        "{}",
+        serde_json::json!({"workload": "native deadline stress: full deck in hand", "hand_count": hand_count, "deadline_ms": 1,
+        "elapsed_us": elapsed.as_micros(), "timed_out": bounded.timed_out, "nodes_used": bounded.nodes_used})
+    );
+}
diff --git a/apps/game-server/src/native_ws_e2e/referee.rs b/apps/game-server/src/native_ws_e2e/referee.rs
new file mode 100644
index 00000000..cb0bf74f
--- /dev/null
+++ b/apps/game-server/src/native_ws_e2e/referee.rs
@@ -0,0 +1,291 @@
+//! Trusted store membership controls visibility through the real WebSocket actor.
+use super::*;
+use crate::native_room_store::{NativeRoomStore, StoredRoom};
+use crate::native_view::{choice_for, observer_snapshot_for, RoomRole};
+use crate::room_native::NativeRoomSession;
+
+fn stored_pending(cfg: &ServerConfig) -> (u64, [String; 4], State) {
+    let mut engine = engine_native::Engine::new_identity(1515, 4);
+    engine.assign_general_named(1, "刘备").unwrap();
+    for _ in 0..3 {
+        let result = engine.submit(engine_native::GameCommand {
+            actor: 0,
+            expected_revision: engine.revision(),
+            dedup_id: engine.revision() + 1,
+            action: engine_native::GameAction::NextPhase,
+        });
+        assert!(!matches!(
+            result,
+            engine_native::CommandOutcome::Rejected(_)
+        ));
+    }
+    assert_eq!(engine.open_choice().unwrap().observer, 0);
+    let mut snapshot = engine.save();
+    snapshot.core.mode = engine_native::GameMode::Kingdoms;
+    snapshot.core.player_mut(1).revealed_generals = [false, false];
+    let removed = snapshot.core.deck.pop().unwrap();
+    snapshot.core.player_mut(1).off_court.push(removed);
+    let expansion = snapshot.core.deck.pop().unwrap();
+    snapshot.core.player_mut(2).lianyaohu_store.push(expansion);
+    let mut session = NativeRoomSession::new(engine_native::Engine::restore(&snapshot).unwrap(), 4);
+    let owner = session.join(1, Some(0), None).unwrap();
+    let other = session.join(2, Some(1), None).unwrap();
+    session.spectate(90);
+    session.spectate(91);
+    let mut state = session.export_state(&session.snapshot_hex());
+    state.next_dedup = snapshot.last_dedup + 1;
+    let referee = state
+        .members
+        .iter_mut()
+        .find(|m| m.connection_id == 90)
+        .unwrap();
+    referee.role = ClientRole::Referee;
+    referee.reconnect_token = uuid::Uuid::new_v4().to_string();
+    let referee_token = referee.reconnect_token.clone();
+    let spectator = state
+        .members
+        .iter_mut()
+        .find(|m| m.connection_id == 91)
+        .unwrap();
+    // A valid seat in a trusted record still cannot turn a Spectator into a Player.
+    spectator.player_id = PlayerId::new(1);
+    spectator.seat = 0;
+    spectator.reconnect_token = uuid::Uuid::new_v4().to_string();
+    let spectator_token = spectator.reconnect_token.clone();
+    let expected = State {
+        view: observer_snapshot_for(session.engine(), RoomRole::Referee, None),
+        choice: choice_for(session.engine(), RoomRole::Referee, None),
+        legal: vec![],
+    };
+    let room_id = 909;
+    NativeRoomStore::new(&cfg.native_room_store)
+        .save(&StoredRoom {
+            room_id,
+            password_hash: crate::native_room_store::password_hash(room_id, PASSWORD),
+            state,
+            checksum: String::new(),
+        })
+        .unwrap();
+    (
+        room_id,
+        [
+            owner.member.reconnect_token,
+            other.member.reconnect_token,
+            referee_token,
+            spectator_token,
+        ],
+        expected,
+    )
+}
+
+async fn reconnect_spectator_with_stored_seat(peer: &mut Peer, room: u64, token: &str) {
+    peer.send(ClientMessage::JoinRoom {
+        room_id: room,
+        password: PASSWORD.into(),
+        preferred_seat: Some(0),
+        reconnect_token: Some(token.into()),
+    })
+    .await;
+    let message = peer
+        .until(|message| matches!(message, ServerMessage::JoinOk { .. }))
+        .await;
+    let ServerMessage::JoinOk {
+        role,
+        player_id,
+        seat,
+        ..
+    } = &message
+    else {
+        unreachable!()
+    };
+    assert_eq!((*role, *player_id, *seat), (ClientRole::Spectator, 1, 0));
+    State::from_message(message).assert_spectator();
+    peer.room = room;
+    peer.player = PlayerId::new(1);
+    peer.token = token.into();
+}
+
+fn assert_referee(state: &State) {
+    assert_eq!(state.view.observer, ObserverKind::Referee);
+    assert!(
+        state.legal.is_empty(),
+        "visibility must not grant intervention"
+    );
+    let ids: std::collections::BTreeSet<_> =
+        state.view.known_cards.iter().map(|card| card.id).collect();
+    assert_eq!(state.view.known_cards.len(), 124);
+    assert_eq!(ids.len(), 124);
+    assert!(state
+        .view
+        .known_cards
+        .iter()
+        .all(|card| card.def.is_some() && card.suit.is_some() && card.rank.is_some()));
+    assert!(state
+        .view
+        .known_cards
+        .iter()
+        .any(|card| card.zone == engine_api::CardZoneTag::DrawPile));
+    assert!(state
+        .view
+        .known_cards
+        .iter()
+        .any(|card| card.zone == engine_api::CardZoneTag::Removed));
+    assert!(state
+        .view
+        .known_cards
+        .iter()
+        .any(|card| card.zone == engine_api::CardZoneTag::Expansion));
+    assert_ne!(
+        state.view.seats[1].character_def, 0,
+        "dark general remains authorized"
+    );
+}
+
+#[test]
+fn native_ws_referee_restore_reconnect_choice_fanout_and_restart() {
+    let directory = tempfile::tempdir().unwrap();
+    let cfg = config(directory.path());
+    let (room, tokens, expected) = stored_pending(&cfg);
+    let before_restart = runtime().block_on(async {
+        let server = Server::start(&cfg, 1).await;
+        let mut owner = Peer::connect(&server).await;
+        let initial = owner.join(room, 0, Some(tokens[0].clone())).await;
+        let mut other = Peer::connect(&server).await;
+        other
+            .join(room, 1, Some(tokens[1].clone()))
+            .await
+            .assert_player(PlayerId::new(2));
+        let mut referee = Peer::connect(&server).await;
+        let joined = referee.join(room, 0, Some(tokens[2].clone())).await;
+        assert_eq!(joined, expected);
+        assert_referee(&joined);
+        assert_eq!(referee.snapshot().await, expected);
+        assert_eq!(
+            joined.choice, initial.choice,
+            "referee sees the current owner's full choice"
+        );
+        let mut old_referee = referee;
+        let mut referee = Peer::connect(&server).await;
+        assert_eq!(
+            referee.join(room, 0, Some(tokens[2].clone())).await,
+            expected
+        );
+        old_referee
+            .send(ClientMessage::RequestSnapshot {
+                header: MessageHeader::new(room, 1, 0),
+                last_revision: 0,
+            })
+            .await;
+        let stale = old_referee
+            .until(|message| {
+                matches!(
+                    message,
+                    ServerMessage::Error { .. } | ServerMessage::Snapshot { .. }
+                )
+            })
+            .await;
+        assert!(
+            matches!(stale, ServerMessage::Error { .. }),
+            "old referee connection retained authority"
+        );
+        let mut spectator = Peer::connect(&server).await;
+        reconnect_spectator_with_stored_seat(&mut spectator, room, &tokens[3]).await;
+        spectator.snapshot().await.assert_spectator();
+        assert!(spectator.snapshot().await.view.seats[1].character_def == 0);
+        let mut newcomer = Peer::connect(&server).await;
+        newcomer.spectate(room).await.assert_spectator();
+        // A rejected player intent still fans out the unchanged pending private choice.
+        let (rejected, unchanged) = owner
+            .submit(
+                owner.player,
+                initial.view.revision,
+                8999,
+                CommandKind::EndPhase,
+            )
+            .await;
+        assert!(matches!(rejected, CommandResult::Rejected { .. }));
+        assert_eq!(unchanged, initial);
+        assert_eq!(referee.pushed(8999).await, expected);
+        spectator.pushed(8999).await.assert_spectator();
+        newcomer.pushed(8999).await.assert_spectator();
+        old_referee
+            .send(ClientMessage::RequestSnapshot {
+                header: MessageHeader::new(room, 2, 0),
+                last_revision: 0,
+            })
+            .await;
+        let stale_push = old_referee
+            .until(|message| {
+                matches!(
+                    message,
+                    ServerMessage::Error { .. } | ServerMessage::CommandOutcome { .. }
+                )
+            })
+            .await;
+        assert!(
+            matches!(stale_push, ServerMessage::Error { .. }),
+            "stale referee received private choice fanout"
+        );
+        // Seeing the full options cannot authorize a referee to answer them, including replay.
+        let answer = durability::answer(&initial, owner.player);
+        double_failure::submit_error(&mut referee, 9001, answer.clone()).await;
+        double_failure::submit_error(&mut spectator, 9001, answer.clone()).await;
+        referee.seq += 1;
+        referee
+            .send(ClientMessage::SubmitCommand {
+                header: MessageHeader::new(room, referee.seq, initial.view.revision),
+                command: Command {
+                    actor: owner.player,
+                    expected_revision: ExpectedRevision(initial.view.revision),
+                    idempotency_key: IdempotencyKey(9001),
+                    kind: answer.clone(),
+                },
+                idempotency_key: IdempotencyKey(9001),
+                replay: true,
+            })
+            .await;
+        let rejected = referee
+            .until(|message| {
+                matches!(
+                    message,
+                    ServerMessage::Error { .. } | ServerMessage::CommandOutcome { .. }
+                )
+            })
+            .await;
+        assert!(matches!(rejected, ServerMessage::Error { .. }));
+        assert_eq!(referee.snapshot().await, expected);
+        let (result, _) = owner
+            .submit(owner.player, initial.view.revision, 9002, answer)
+            .await;
+        assert!(
+            matches!(result, CommandResult::Accepted { .. }),
+            "{result:?}"
+        );
+        let pushed = referee.pushed(9002).await;
+        assert_referee(&pushed);
+        spectator.pushed(9002).await.assert_spectator();
+        newcomer.pushed(9002).await.assert_spectator();
+        let before_restart = referee.snapshot().await;
+        assert_eq!(pushed, before_restart);
+        owner.close().await;
+        other.close().await;
+        referee.close().await;
+        old_referee.close().await;
+        spectator.close().await;
+        newcomer.close().await;
+        server.stop().await;
+        before_restart
+    });
+    runtime().block_on(async {
+        let restarted = Server::start(&cfg, 1).await;
+        let mut referee = Peer::connect(&restarted).await;
+        assert_eq!(
+            referee.join(room, 0, Some(tokens[2].clone())).await,
+            before_restart
+        );
+        assert_eq!(referee.snapshot().await, before_restart);
+        let mut spectator = Peer::connect(&restarted).await;
+        reconnect_spectator_with_stored_seat(&mut spectator, room, &tokens[3]).await;
+        restarted.stop().await;
+    });
+}
diff --git a/apps/game-server/tests/nc09_machine_projection.rs b/apps/game-server/tests/nc09_machine_projection.rs
