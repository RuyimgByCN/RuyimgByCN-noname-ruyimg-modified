@@ -0,0 +1,199 @@
+//! NC09: authorized cards come from physical ownership, never catalog membership.
+#[path = "../src/native_view.rs"]
+mod native_view;
+
+use engine_api::{CardZoneTag, PlayerId};
+use engine_native::Engine;
+use native_view::{observer_snapshot_for, RoomRole};
+use std::collections::BTreeSet;
+
+#[test]
+fn referee_sees_all_physical_cards_faces_owners_and_deck_order_after_archive() {
+    let engine = Engine::new_identity(1515, 4);
+    let mut snapshot = engine.save();
+    for index in 0..6 {
+        let card = snapshot.core.deck.pop().unwrap();
+        let p = snapshot.core.player_mut(1);
+        match index {
+            0 => {
+                p.off_court.push(card);
+                p.yishan_lost.push(card);
+                p.jiguanyuan_cards.push(card);
+            }
+            1 => p.zhucheng.push(card),
+            2 => p.lianyaohu_store.push(card),
+            3 => p.sxianjing_traps.push(card),
+            4 => p.hutian_hold.push(card),
+            5 => {
+                snapshot
+                    .core
+                    .vm_aux
+                    .piles
+                    .insert((2, "test.pile".into()), vec![card]);
+            }
+            _ => unreachable!(),
+        }
+    }
+    let encoded = engine_native::archive::encode_archive(&snapshot);
+    let decoded = engine_native::archive::decode_archive(&encoded).unwrap();
+    assert_eq!(snapshot, decoded);
+    let engine = Engine::restore(&decoded).unwrap();
+    let before = engine.save();
+    let authority_bytes = engine_native::archive::encode_archive(&before);
+    let view = observer_snapshot_for(&engine, RoomRole::Referee, None);
+    assert_eq!(view.known_cards.len(), engine.catalog().cards.len());
+    let ids: BTreeSet<_> = view.known_cards.iter().map(|card| card.id.raw()).collect();
+    assert_eq!(
+        ids.len(),
+        view.known_cards.len(),
+        "references must not duplicate ownership"
+    );
+    assert_eq!(ids, (0..engine.catalog().cards.len() as u32).collect());
+    assert!(view.seats.iter().all(|seat| seat.identity.is_some()));
+    for card in &view.known_cards {
+        let def = &engine.catalog().cards[card.id.raw() as usize];
+        assert_eq!(card.def, Some(def.kind as u16 as u32));
+        assert!(card.suit.is_some());
+        assert_eq!(card.rank, Some(def.rank));
+        if card.zone == CardZoneTag::Hand {
+            let seat = card.owner.unwrap().raw() as usize - 1;
+            assert!(engine.state_core().players[seat]
+                .hand
+                .contains(&card.id.raw()));
+        }
+    }
+    assert_eq!(
+        view.known_cards
+            .iter()
+            .filter(|c| c.zone == CardZoneTag::DrawPile)
+            .map(|c| c.id.raw())
+            .collect::<Vec<_>>(),
+        snapshot.core.deck.iter().copied().collect::<Vec<_>>()
+    );
+    assert_eq!(
+        view.known_cards
+            .iter()
+            .filter(|c| c.zone == CardZoneTag::Removed)
+            .map(|c| (c.id.raw(), c.owner))
+            .collect::<Vec<_>>(),
+        vec![(snapshot.core.player(1).off_court[0], Some(PlayerId::new(2)))]
+    );
+    for id in snapshot
+        .core
+        .player(1)
+        .zhucheng
+        .iter()
+        .chain(&snapshot.core.player(1).lianyaohu_store)
+        .chain(&snapshot.core.player(1).sxianjing_traps)
+        .chain(&snapshot.core.player(1).hutian_hold)
+    {
+        let card = view.known_cards.iter().find(|c| c.id.raw() == *id).unwrap();
+        assert_eq!(
+            (card.zone, card.owner),
+            (CardZoneTag::Expansion, Some(PlayerId::new(2)))
+        );
+    }
+    let vm = view
+        .known_cards
+        .iter()
+        .find(|c| c.id.raw() == snapshot.core.vm_aux.piles[&(2, "test.pile".into())][0])
+        .unwrap();
+    assert_eq!(
+        (vm.zone, vm.owner),
+        (CardZoneTag::Expansion, Some(PlayerId::new(3)))
+    );
+    for role in [RoomRole::Spectator, RoomRole::Player] {
+        let ordinary = observer_snapshot_for(&engine, role, Some(PlayerId::new(1)));
+        assert!(ordinary
+            .known_cards
+            .iter()
+            .all(|c| c.zone == CardZoneTag::Hand && c.owner == Some(PlayerId::new(1))));
+        if role == RoomRole::Spectator {
+            assert!(ordinary.known_cards.is_empty());
+        }
+    }
+    assert_eq!(engine.save(), before);
+    assert_eq!(
+        engine_native::archive::encode_archive(&engine.save()),
+        authority_bytes
+    );
+}
+
+fn submit(engine: &mut Engine, action: engine_native::GameAction) {
+    let actor = engine
+        .open_choice()
+        .map_or(engine.turn().current, |c| c.observer);
+    let result = engine.submit(engine_native::GameCommand {
+        actor,
+        expected_revision: engine.revision(),
+        dedup_id: engine.revision() + 1,
+        action,
+    });
+    assert!(
+        !matches!(result, engine_native::CommandOutcome::Rejected(_)),
+        "{result:?}"
+    );
+}
+
+fn assert_choice_kind(engine: &Engine, kind: engine_api::ChoiceKind) {
+    let owner = PlayerId::new(engine.open_choice().unwrap().observer as u32 + 1);
+    let choice = native_view::choice_for(engine, RoomRole::Player, Some(owner)).unwrap();
+    assert_eq!(choice.kind, kind);
+    assert_eq!(
+        Some(choice.clone()),
+        native_view::choice_for(engine, RoomRole::Referee, None)
+    );
+    assert!(native_view::choice_for(engine, RoomRole::Spectator, Some(owner)).is_none());
+    let message = engine_protocol::ServerMessage::Snapshot {
+        header: engine_protocol::MessageHeader::new(909, 1, engine.revision()),
+        view: observer_snapshot_for(engine, RoomRole::Referee, None),
+        legal_actions: vec![],
+        choice: Some(choice.clone()),
+    };
+    let wire = engine_protocol::encode_s2c(&message).unwrap();
+    let engine_protocol::ServerMessage::Snapshot {
+        header,
+        choice: decoded,
+        ..
+    } = engine_protocol::decode_s2c(&wire).unwrap()
+    else {
+        panic!("snapshot")
+    };
+    assert_eq!(header.protocol_version, 5);
+    assert_eq!(decoded, Some(choice));
+}
+
+#[test]
+fn current_choices_preserve_all_expressible_existing_wire_kinds() {
+    let mut engine = Engine::new(804, 3);
+    engine.debug_grant(0, "突袭");
+    engine.state_core_mut().turn.phase = engine_native::Phase::Judge;
+    submit(&mut engine, engine_native::GameAction::NextPhase);
+    assert_eq!(
+        engine.open_choice().unwrap().spec.kind,
+        engine_native::ChoiceKind::Confirm
+    );
+    assert_choice_kind(&engine, engine_api::ChoiceKind::Confirm);
+    let id = engine.open_choice().unwrap().id;
+    submit(
+        &mut engine,
+        engine_native::GameAction::Answer {
+            choice_id: id,
+            selection: vec![engine_native::ChoiceOption::Confirm],
+        },
+    );
+    assert_eq!(
+        engine.open_choice().unwrap().spec.kind,
+        engine_native::ChoiceKind::SelectPlayers
+    );
+    assert_choice_kind(&engine, engine_api::ChoiceKind::SelectTargets);
+    let mut discard = Engine::new(1515, 4);
+    for _ in 0..3 {
+        submit(&mut discard, engine_native::GameAction::NextPhase);
+    }
+    assert_eq!(
+        discard.open_choice().unwrap().spec.kind,
+        engine_native::ChoiceKind::SelectCards
+    );
+    assert_choice_kind(&discard, engine_api::ChoiceKind::SelectCards);
+}
diff --git a/apps/web-client/scripts/pa09-desktop-transport.test.mjs b/apps/web-client/scripts/pa09-desktop-transport.test.mjs
new file mode 100644
index 00000000..ea29af45
--- /dev/null
+++ b/apps/web-client/scripts/pa09-desktop-transport.test.mjs
@@ -0,0 +1,138 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { DesktopEngineTransport, desktopEngineChoice, DESKTOP_ENGINE_KEY } from "../src/engine/desktopEngineTransport.ts";
+
+const tick = () => new Promise((resolve) => setImmediate(resolve));
+
+test("desktop IPC preserves request order, ids, errors and continues on the same engine", async () => {
+  const calls = [];
+  let release;
+  const first = new Promise((resolve) => { release = resolve; });
+  const transport = new DesktopEngineTransport(async (command, args) => {
+    if (command === "native_engine_open") return 17;
+    if (command === "native_engine_close") return;
+    calls.push({ command, ...args });
+    const request = args.request;
+    if (request.id === 1) return first;
+    if (request.id === 2) return { id: 2, ok: false, error: "native backend: useSkillCard 未映射" };
+    if (request.id === 3) throw new Error("bridge lost");
+    return { id: request.id, ok: true, data: { revision: 7 } };
+  });
+  const replies = [];
+  transport.onmessage = (event) => replies.push(event.data);
+  const start = { id: 1, type: "start", players: 4, seed: 42, observer: 0, mode: "identity", packsJson: "[]" };
+  transport.postMessage(start);
+  transport.postMessage({ id: 2, type: "useSkillCard", actor: 0, skill: 1, cardKind: 0, targets: [], equipSlot: 0 });
+  transport.postMessage({ id: 3, type: "autoStep" });
+  transport.postMessage({ id: 4, type: "observer" });
+  await tick();
+  assert.deepEqual(calls, [{ command: "native_engine_request", resourceId: 17, request: start }]);
+  release({ id: 1, ok: true, data: { revision: 6 } });
+  await tick();
+  assert.deepEqual(calls.map((call) => call.request.id), [1, 2, 3, 4]);
+  assert.deepEqual(replies[1], { id: 2, ok: false, error: "native backend: useSkillCard 未映射" });
+  assert.match(replies[2].error, /bridge lost.*结果可能未知/);
+  assert.deepEqual(replies[3], { id: 4, ok: true, data: { revision: 7 } });
+  transport.terminate();
+});
+
+test("dispose suppresses late IPC replies and never submits queued operations", async () => {
+  let release;
+  const sent = [];
+  const transport = new DesktopEngineTransport((command, args) => {
+    if (command === "native_engine_open") return Promise.resolve(19);
+    if (command === "native_engine_close") return Promise.resolve();
+    sent.push(args.request.id);
+    return new Promise((resolve) => { release = resolve; });
+  });
+  const replies = [];
+  transport.onmessage = (event) => replies.push(event.data);
+  transport.postMessage({ id: 1, type: "autoStep" });
+  transport.postMessage({ id: 2, type: "autoStep" });
+  await tick();
+  transport.terminate();
+  release({ id: 1, ok: true, data: "late" });
+  await tick();
+  assert.deepEqual(sent, [1]);
+  assert.deepEqual(replies, []);
+  assert.throws(() => transport.postMessage({ id: 3, type: "save" }), /closed/);
+});
+
+test("mismatched IPC response is an explicit unknown-result error, without retry", async () => {
+  let calls = 0;
+  const transport = new DesktopEngineTransport(async (command) => {
+    if (command === "native_engine_open") return 20;
+    if (command === "native_engine_close") return;
+    calls++; return { id: 99, ok: true, data: "wrong" };
+  });
+  const response = new Promise((resolve) => { transport.onmessage = (event) => resolve(event.data); });
+  transport.postMessage({ id: 1, type: "endPhase", actor: 0 });
+  assert.match((await response).error, /invalid IPC response.*结果可能未知/);
+  assert.equal(calls, 1);
+  transport.terminate();
+});
+
+test("Wasm is the default and an explicit persistent/URL fallback remains available", () => {
+  const originalStorage = globalThis.localStorage;
+  const originalLocation = globalThis.location;
+  const values = new Map();
+  globalThis.localStorage = { getItem: (key) => values.get(key) ?? null };
+  globalThis.location = { search: "", hash: "" };
+  try {
+    assert.equal(desktopEngineChoice(), "wasm");
+    values.set(DESKTOP_ENGINE_KEY, "native");
+    assert.equal(desktopEngineChoice(), "native");
+    globalThis.location.search = "?engineTransport=wasm";
+    assert.equal(desktopEngineChoice(), "wasm");
+    globalThis.location.search = "?engineTransport=native";
+    values.clear();
+    assert.equal(desktopEngineChoice(), "native");
+    globalThis.location.search = "";
+    globalThis.location.hash = "#/battle?engineTransport=wasm";
+    assert.equal(desktopEngineChoice(), "wasm");
+  } finally {
+    if (originalStorage === undefined) delete globalThis.localStorage; else globalThis.localStorage = originalStorage;
+    if (originalLocation === undefined) delete globalThis.location; else globalThis.location = originalLocation;
+  }
+});
+
+test("dispose during resource allocation closes it once and submits no request", async () => {
+  let opened;
+  const calls = [];
+  const transport = new DesktopEngineTransport((command, args) => {
+    calls.push({ command, args });
+    if (command === "native_engine_open") return new Promise((resolve) => { opened = resolve; });
+    return Promise.resolve();
+  });
+  transport.postMessage({ id: 1, type: "init" });
+  await tick();
+  transport.terminate();
+  transport.terminate();
+  opened(25);
+  await tick();
+  assert.deepEqual(calls.map((call) => call.command), ["native_engine_open", "native_engine_close"]);
+  assert.deepEqual(calls[1].args, { resourceId: 25 });
+});
+
+test("IPC and Worker convert native SingleWin seats exactly once without modifying raw projections", async () => {
+  const { nativeObserverToSnapshot } = await import("../src/worker/nativeBackend.ts");
+  for (const player of [1, 4]) {
+    const raw = { SingleWin: { player } };
+    const view = { seat: 0, players: [], discard: [], table: [], turn: 0, phase: "end", round: 1, outcome: raw };
+    const envelope = { result: null, events: [], choice: null, view: { outcome: raw }, legal_actions: [], hash_hex: "hash", revision: 1, finished: true };
+    const transport = new DesktopEngineTransport(async (command, args) => {
+      if (command === "native_engine_open") return 26;
+      if (command === "native_engine_close") return;
+      return { id: args.request.id, ok: true, data: args.request.type === "chooseGeneral" ? { assignment: {}, envelope } : envelope };
+    });
+    const pending = new Map();
+    transport.onmessage = (event) => pending.get(event.data.id)(event.data.data);
+    const send = (body) => new Promise((resolve) => { pending.set(body.id, resolve); transport.postMessage(body); });
+    assert.deepEqual(nativeObserverToSnapshot(view).outcome, { SingleWin: { player: player - 1 } });
+    assert.deepEqual((await send({ id: 1, type: "observer" })).view.outcome, { SingleWin: { player: player - 1 } });
+    assert.deepEqual((await send({ id: 2, type: "chooseGeneral", seat: 0, name: "曹操" })).envelope.view.outcome, { SingleWin: { player: player - 1 } });
+    assert.deepEqual(raw, { SingleWin: { player } });
+    assert.equal(envelope.view.outcome, raw);
+    transport.terminate();
+  }
+});
diff --git a/apps/web-client/scripts/pa09-desktop-webview.ts b/apps/web-client/scripts/pa09-desktop-webview.ts
new file mode 100644
index 00000000..16e35e69
--- /dev/null
+++ b/apps/web-client/scripts/pa09-desktop-webview.ts
@@ -0,0 +1,140 @@
+// Actual WKWebView acceptance entry, bundled with Vite and served by the external evidence runner.
+import { invoke } from "@tauri-apps/api/core";
+import { EngineClient } from "../src/engine/client";
+import { activateExtension, deactivateExtension, importExtensionPackageValidated, readExtensionStore, setMatchFrozen, uninstallExtension } from "../src/engine/extensionStore";
+import { prepareNativeMatchContent, restoreNativeMatchContent } from "../src/engine/nativeMatchContent";
+import type { EngineEnvelope } from "../src/types/engine";
+import v1 from "./fixtures/vm-trigger/package.npack.json";
+import chars1 from "./fixtures/vm-trigger/character.json";
+import v2 from "./fixtures/vm-trigger-v2/package.npack.json";
+import chars2 from "./fixtures/vm-trigger-v2/character.json";
+
+function check(condition: unknown, message: string): asserts condition {
+  if (!condition) throw new Error(message);
+}
+function equal(actual: unknown, expected: unknown, message: string) {
+  const canonical = (value: unknown): string => JSON.stringify(value, (_key, item) => {
+    if (item && typeof item === "object" && !Array.isArray(item)) return Object.fromEntries(Object.entries(item).sort(([a], [b]) => a.localeCompare(b)));
+    return item;
+  });
+  check(canonical(actual) === canonical(expected), message);
+}
+async function rejects(action: () => Promise<unknown>, message: string) {
+  let failed = false;
+  try { await action(); } catch { failed = true; }
+  check(failed, message);
+}
+const battle = new EngineClient();
+const validator = new EngineClient();
+const wasm = new EngineClient();
+const storage = new Map<string, string>();
+Object.defineProperty(window, "localStorage", { value: {
+  getItem: (key: string) => storage.get(key) ?? null,
+  setItem: (key: string, value: string) => storage.set(key, String(value)),
+  removeItem: (key: string) => storage.delete(key),
+} });
+
+async function run() {
+  history.replaceState(null, "", "/?engineTransport=native");
+  await battle.connect();
+  check(battle.getTransportKind() === "desktop-native", "battle did not select actual IPC");
+  let env = await battle.start(4, 42, 0, undefined, "identity");
+  const savedBeforeValidator = await battle.saveHex();
+  await validator.connect();
+  equal(await battle.saveHex(), savedBeforeValidator, "validator init reset battle resource");
+  history.replaceState(null, "", "/?engineTransport=wasm");
+  await wasm.connect();
+  check(wasm.getTransportKind() === "wasm-worker", "explicit Wasm fallback did not select Worker");
+  history.replaceState(null, "", "/?engineTransport=native");
+  equal(env, await wasm.start(4, 42, 0, undefined, "identity"), "initial IPC/Worker envelopes differ");
+  let steps = 0;
+  for (; steps < 2000 && !env.finished; steps++) {
+    env = await battle.autoStep();
+    equal(env, await wasm.autoStep(), `IPC/Worker trajectory diverged at ${steps}`);
+    if (steps === 30 || steps === 70) {
+      const hex = await battle.saveHex();
+      equal(hex, await wasm.saveHex(), "native/Wasm archive bytes differ");
+      equal(await battle.restoreHex(await wasm.saveHex()), await wasm.restoreHex(hex), "cross-restore differed");
+    }
+  }
+  check(env.finished, "identity workload did not reach its actual terminal outcome");
+  const terminal = { steps, hash: env.hash_hex, outcome: env.view.outcome };
+  const deep = (json: string) => validator.validatePackage(json);
+  await importExtensionPackageValidated(JSON.stringify({ ...v1, characters: chars1 }), deep);
+  const key = "official/vm-fixture";
+  activateExtension(key);
+  const frozen = prepareNativeMatchContent();
+  await battle.start(4, 42, 0, frozen.packsJson);
+  const candidates = await battle.generalCandidates();
+  check(candidates.candidates.some((row) => row.name === "vm_fixture"), "installed VM general missing from actual IPC candidates");
+  env = (await battle.chooseGeneral(0, "vm_fixture")).envelope;
+  async function phaseEnd(delta: number) {
+    for (let step = 0; step < 80; step++) {
+      const before: EngineEnvelope = env;
+      env = before.choice
+        ? await battle.resolveChoice(before.choice.observer, before.choice.choice_id,
+            (before.choice.options ?? []).slice(0, Math.max(1, before.choice.min_count ?? 0)).map((option) => option.token))
+        : await battle.endPhase(before.view.current_player);
+      if (before.view.phase === "Discard" && env.view.phase === "End") {
+        equal(env.view.seats[0].hand_count - before.view.seats[0].hand_count, delta, "actual IPC VM effect did not use expected package version");
+        return;
+      }
+    }
+    throw new Error("VM phase end was not reached");
+  }
+  await phaseEnd(1);
+  const save = { hex: await battle.saveHex(), ...frozen };
+  setMatchFrozen(true);
+  await rejects(() => importExtensionPackageValidated(JSON.stringify({ ...v2, characters: chars2 }), deep), "frozen install was accepted");
+  setMatchFrozen(false);
+  await importExtensionPackageValidated(JSON.stringify({ ...v2, characters: chars2 }), deep);
+  const upgraded = prepareNativeMatchContent();
+  check(upgraded.lockSeed !== frozen.lockSeed, "upgrade did not change content lock");
+  equal(await battle.observer(), env.view, "upgrade mutated the live match");
+  deactivateExtension(key);
+  check(prepareNativeMatchContent().packsJson === undefined, "disabled package remained active");
+  activateExtension(key);
+  equal(prepareNativeMatchContent().lockSeed, upgraded.lockSeed, "enable lost upgraded version");
+  deactivateExtension(key);
+  uninstallExtension(key);
+  equal(readExtensionStore().installed.length, 0, "uninstall did not remove installed slot");
+  const original = restoreNativeMatchContent(save);
+  const restored = await battle.restoreHex(save.hex, original.packsJson);
+  equal(restored.hash_hex, env.hash_hex, "frozen old package restore failed after uninstall");
+  const beforeRejectedRestore = await battle.saveHex();
+  await rejects(() => battle.restoreHex(save.hex, upgraded.packsJson), "wrong-version archive restore was accepted");
+  equal(await battle.saveHex(), beforeRejectedRestore, "rejected restore destroyed live archive");
+  await battle.start(4, 42, 0, upgraded.packsJson);
+  env = (await battle.chooseGeneral(0, "vm_fixture")).envelope;
+  await phaseEnd(2);
+  await battle.start(4, 42, 0);
+  env = (await battle.chooseGeneral(0, "黄盖")).envelope;
+  await battle.endPhase(0);
+  env = await battle.endPhase(0);
+  const active = env.legal_actions.find((action) => typeof action === "object" && "ActivateSkill" in action);
+  check(active && typeof active === "object" && "ActivateSkill" in active, "active skill candidate missing");
+  env = await battle.activateSkill(0, active.ActivateSkill.skill, [], []);
+  const play = env.legal_actions.find((action) => typeof action === "object" && "PlayCard" in action);
+  check(play && typeof play === "object" && "PlayCard" in play, "playable card candidate missing");
+  env = await battle.playCard(0, play.PlayCard.card, play.PlayCard.targets);
+  check((await battle.status()).revision === env.revision, "status revision differs");
+  await rejects(() => battle.useSkillCard(0, 1, 0, [], 0), "unsupported request falsely succeeded");
+  check(battle.getTransportKind() === "desktop-native", "unsupported request silently switched transport");
+  const resourceId = await invoke<number>("native_engine_open");
+  await invoke("native_engine_close", { resourceId });
+  await rejects(() => invoke("native_engine_close", { resourceId }), "duplicate resource close was uncontrolled");
+  await rejects(() => invoke("native_engine_request", { resourceId, request: { id: 1, type: "init" } }), "closed resource accepted a request");
+  return { passed: true, terminal, vm_lifecycle: "actual IPC passed", isolation: "validator init preserves battle", fallback: "actual Wasm Worker passed", resources: "close/duplicate-close/closed-request passed" };
+}
+
+try {
+  const result = await run();
+  document.body.textContent = JSON.stringify(result);
+  await fetch("/report", { method: "POST", body: JSON.stringify(result) });
+} catch (error) {
+  const result = { passed: false, error: String(error), stack: error instanceof Error ? error.stack : null };
+  document.body.textContent = JSON.stringify(result);
+  await fetch("/report", { method: "POST", body: JSON.stringify(result) });
+} finally {
+  battle.dispose(); validator.dispose(); wasm.dispose();
+}
diff --git a/apps/web-client/scripts/pa09-document-reload.ts b/apps/web-client/scripts/pa09-document-reload.ts
new file mode 100644
index 00000000..4d11f93d
--- /dev/null
+++ b/apps/web-client/scripts/pa09-document-reload.ts
@@ -0,0 +1,72 @@
+// Reload the same real WebView without Vue unmount or JS disposal; native lifecycle must own cleanup.
+import { invoke } from "@tauri-apps/api/core";
+import { Image } from "@tauri-apps/api/image";
+import { EngineClient } from "../src/engine/client";
+import v1 from "./fixtures/vm-trigger/package.npack.json";
+
+interface ReloadState {
+  ids: number[];
+  imageId?: number;
+  checks: Array<{ document: number; oldResourceRefused: boolean; unrelatedImageRetained: boolean; pendingRequests: number }>;
+}
+
+async function run() {
+  const state: ReloadState = await (await fetch("/state")).json();
+  const documentNumber = state.ids.length;
+  history.replaceState(null, "", `/?engineTransport=native&document=${documentNumber}`);
+  if (state.imageId === undefined) state.imageId = (await Image.new([11, 22, 33, 255], 1, 1)).rid;
+  const size = await new Image(state.imageId).size();
+  const unrelatedImageRetained = size.width === 1 && size.height === 1;
+  if (!unrelatedImageRetained) throw new Error("unrelated image resource lost during navigation");
+  let oldResourceRefused = documentNumber === 0;
+  if (documentNumber > 0) {
+    try {
+      await invoke("native_engine_request", { resourceId: state.ids.at(-1), request: { id: 99, type: "status" } });
+    } catch { oldResourceRefused = true; }
+  }
+  const validator = new EngineClient();
+  await validator.connect();
+  await validator.validatePackage(JSON.stringify(v1));
+  // SAFETY: this test reads the allocated resource promise from the production client's IPC transport without replacing either implementation.
+  const resourceId = await (validator as unknown as { worker: { resource: Promise<number> } }).worker.resource;
+  if (!Number.isInteger(resourceId)) throw new Error("validator did not allocate an actual native resource");
+  const spareResources: number[] = [];
+  try {
+    for (let slot = 0; slot < 7; slot++) spareResources.push(await invoke<number>("native_engine_open"));
+  } finally {
+    for (const resourceId of spareResources) await invoke("native_engine_close", { resourceId });
+  }
+  state.ids.push(resourceId);
+  // Send actual invoke requests before replacing the document. Their old renderer must not own a live host afterward.
+  const pendingRequests = documentNumber < 12 ? 8 : 0;
+  state.checks.push({ document: documentNumber, oldResourceRefused, unrelatedImageRetained, pendingRequests });
+  await fetch("/state", { method: "POST", body: JSON.stringify(state) });
+  if (documentNumber < 12) {
+    let settled = 0;
+    for (let id = 1; id <= pendingRequests; id++) {
+      void invoke("native_engine_request", { resourceId, request: { id: 100 + id, type: "autoStep" } })
+        .then(() => { settled++; }, () => { settled++; });
+    }
+    for (let allocation = 0; allocation < 2; allocation++) {
+      void invoke("native_engine_open").then(() => { settled++; }, () => { settled++; });
+    }
+    navigator.sendBeacon("/pending", JSON.stringify({ document: documentNumber, submitted: pendingRequests + 2, pendingRequests, pendingOpens: 2, settledAtNavigation: settled }));
+    location.reload();
+    return;
+  }
+  if (!state.checks.every((check) => check.oldResourceRefused)) throw new Error("old document resource survived navigation");
+  const nextClient = new EngineClient();
+  await nextClient.connect();
+  const status = await nextClient.status();
+  if (status.revision !== 0) throw new Error("new client after repeated reloads did not have an independent session");
+  nextClient.dispose();
+  validator.dispose();
+  await new Image(state.imageId).close();
+  const report = { passed: true, reloads: 12, documents: state.checks.length, nextClientConnected: status.revision === 0, checks: state.checks };
+  await fetch("/report", { method: "POST", body: JSON.stringify(report) });
+}
+
+try { await run(); }
+catch (error) {
+  await fetch("/report", { method: "POST", body: JSON.stringify({ passed: false, error: String(error), stack: error instanceof Error ? error.stack : null }) });
+}
