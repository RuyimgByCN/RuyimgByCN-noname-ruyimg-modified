+<script setup lang="ts">
+import { computed, ref, watch } from "vue";
+import {
+  characterDisplayName,
+  characterImageUrl,
+  characterPortraitUrl,
+  ensureAppearanceCharacter,
+  fallbackPortraitUrl,
+  selectedSkinId,
+  selectSkin,
