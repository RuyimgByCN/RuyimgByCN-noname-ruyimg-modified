+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { nativeEnvelope, nativeObserverToSnapshot } from '../src/worker/nativeBackend.ts';
+const general = { def: 0, name: '曹操', faction: 'wei', revealed: false };
+const view = { seat: 0, players: [{ seat: 0, characterDef: 0, generals: [general, null], hp: 4, maxHp: 4, alive: true, hand: { own: [] }, handCount: 0, equips: [], judge: [], skills: [] }], discard: [], table: [], phase: 'play', turn: 0, round: 1 };
+function envelope(choice) {
+ return nativeEnvelope({ observer: 0, engine: { view_json: () => JSON.stringify(view), open_choice_json: () => JSON.stringify(choice), revision: () => 7, is_finished: () => false, legal_actions_json: () => JSON.stringify({seat: 0, revision: 7, actions: []}), activate_skill() {} } });
+}
+test('two slots preserve def zero and defaults accept old payloads', () => {
+ assert.deepEqual(nativeObserverToSnapshot(view).seats[0].generals, [general, null]);
+ const old = structuredClone(view); delete old.players[0].generals;
+ assert.equal(nativeObserverToSnapshot(old).seats[0].generals, undefined);
+ assert.equal(nativeObserverToSnapshot(old).seats[0].character_def, 0);
+});
+test('canonical kinds and prompts reach real envelope conversion', () => {
+ for (const [native_kind, kind] of [['confirm','Confirm'], ['select_cards','SelectCards'], ['select_players','SelectTargets'], ['respond_card','Custom'], ['pick_tag','Custom']]) {
+  const result = envelope({id: 9, min: 1, max: 1, allowCancel: true, native_kind, kind, prompt: 'respond_shan', options: [{card:42}]});
+  assert.equal(result.choice.native_kind, native_kind); assert.equal(result.choice.kind, kind); assert.equal(result.choice.prompt, 'respond_shan');
+  assert.deepEqual(result.choice.options, [{token:0,label_key:'card:42'}]);
+ }
+ assert.equal(envelope({id:9, hidden:true}).choice, null);
+ assert.equal(envelope({id:9, options:[]}).choice.kind, 'Custom');
+});
+test('metadata wrong types refuse explicitly at local JSON boundary', () => {
+ for (const generals of [null, [], [general], [general,null,null], [{...general,def:-1},null], [{...general,def:'0'},null], [{...general,name:0},null], [{...general,revealed:0},null]]) {
+  assert.throws(() => nativeObserverToSnapshot({...view,players:[{...view.players[0],generals}]}), /generals/);
+ }
+ for (const metadata of [{prompt:3},{native_kind:'extension_new_kind'},{native_kind:3}]) assert.throws(() => envelope({id:9,options:[],...metadata}), /prompt|native_kind/);
+});
+
+test('old functional TypeScript reader ignores extra metadata', async () => {
+ const {nativeObserverToSnapshot: oldReader} = await import('./approved-b-old-reader.ts');
+ const previous=structuredClone(view);delete previous.players[0].generals;
+ assert.deepEqual(oldReader(view),oldReader(previous));
+});
+
+test('production prompt literals and extension keys have readable presentation without internal keys', async () => {
+ const {readFileSync,readdirSync} = await import('node:fs');
+ const {join} = await import('node:path');
+ const {fileURLToPath} = await import('node:url');
+ const {choicePromptLabel} = await import('../src/engine/observerMetadata.ts');
+ const source=readFileSync(new URL('../../../crates/engine-native-kernel/src/archive/resolution.rs',import.meta.url),'utf8');
+ const prompts=[...source.split('KNOWN_PROMPTS:')[1].split('];')[0].matchAll(/^    "([^"]+)",/gm)].map(match=>match[1]);
+ // Literal inventory is a presentation guard, not a reachability/restore proof.
+ const visit=directory=>readdirSync(directory,{withFileTypes:true}).flatMap(entry=>entry.isDirectory()?visit(join(directory,entry.name)):entry.name.endsWith('.rs')?[join(directory,entry.name)]:[]);
+ const files=['engine-native-kernel','engine-native-content','engine-native'].flatMap(crate=>visit(fileURLToPath(new URL(`../../../crates/${crate}/src`,import.meta.url))));
+ for(const file of files)for(const match of readFileSync(file,'utf8').matchAll(/prompt:\s*"([^"]+)"/g))prompts.push(match[1]);
+ for(const prompt of new Set(prompts))assert(!choicePromptLabel({prompt,native_kind:'select_cards'}).includes(prompt),prompt);
+ for(const key of ['<img src=x onerror=alert(1)>extension','__proto__','constructor','toString']) assert.equal(choicePromptLabel({prompt:key,native_kind:'respond_card'}),'响应出牌');
+});
diff --git a/apps/web-client/scripts/approved-b-old-reader.ts b/apps/web-client/scripts/approved-b-old-reader.ts
new file mode 100644
--- /dev/null
+++ b/apps/web-client/scripts/approved-b-old-reader.ts
@@ -0,0 +1,113 @@
+// Frozen functional pre-B TS reader, HEAD100489f5 plus reviewed PA09 overlay.
+import { normalizeNativeOutcome } from "../src/engine/nativeOutcome";
+import type { CardView, ObserverSnapshot } from "../src/types/engine";
+interface NativeView {
+  seat: number;
+  players: Array<{
+    seat: number;
+    characterDef?: number;
+    alive: boolean;
+    hp: number;
+    maxHp: number;
+    hand: { own?: number[]; hidden?: boolean };
+    handCount: number;
+    equips: number[];
+    judge: number[];
+    turnedOver: boolean;
+    skills: string[];
+    revealedGenerals: boolean[];
+    // NC03/NC09 裁决⑥：观察者过滤后的身份（本人/主公/已死亡可见，其余 null）。
+    identity?: "Lord" | "Loyalist" | "Rebel" | "Renegade" | null;
+  }>;
+  deckCount: number;
+  discard: number[];
+  table: number[];
+  // 裁决⑦：观察者可见牌的真实牌面（id → def/suit/rank/kind）；仅含
+  // 本人手牌与全场装备/判定/弃牌/处理区——他人手牌与牌堆不在其中。
+  cards?: Record<string, { def: number; suit: string | null; rank: number | null; kind: string }>;
+  turn: number;
+  phase: string;
+  round: number;
+  outcome: unknown;
+  rulesetVersion?: number;
+  ruleset_version?: number;
+}
+
+const PHASE_MAP: Record<string, ObserverSnapshot["phase"]> = {
+  judge: "Judge",
+  draw: "Draw",
+  play: "Play",
+  discard: "Discard",
+  end: "End",
+};
+
+type FaceJson = { def: number; suit: string | null; rank: number | null; kind: string };
+
+/** 可见牌 → CardView（复用已有字段：face 缺失时不虚构牌面，def 置 null 由
+ * 渲染门挡住——正常路径 WASM 对全部可见 id 都提供牌面）。 */
+function faceToCardView(
+  view: NativeView,
+  id: number,
+  owner: number | null,
+  zone: CardView["zone"],
+): CardView {
+  const face: FaceJson | undefined = view.cards?.[String(id)];
+  return {
+    id,
+    def: face?.def ?? null,
+    suit: (face?.suit as CardView["suit"]) ?? null,
+    rank: face?.rank ?? null,
+    owner,
+    zone,
+    kind: (face?.kind as CardView["kind"]) ?? "Other",
+  };
+}
+
+/** observer schema 适配：view_json → ObserverSnapshot。 */
+export function nativeObserverToSnapshot(view: NativeView): ObserverSnapshot {
+  const self = view.players.find((p) => p.seat === view.seat);
+  const ownHand = self?.hand?.own ?? [];
+  // 裁决⑦：可见牌面覆盖——本人手牌 + 全场装备/判定（公开）+ 弃牌堆 +
+  // 处理区；他人手牌 id 不进入 known_cards（WASM 侧本就不下发）。
+  const known_cards = [
+    ...ownHand.map((id) => faceToCardView(view, id, view.seat, "Hand")),
+    ...view.players.flatMap((p) => [
+      ...p.equips.map((id) => faceToCardView(view, id, p.seat, "Equip")),
+      ...p.judge.map((id) => faceToCardView(view, id, p.seat, "Judge")),
+    ]),
+    ...view.discard.map((id) => faceToCardView(view, id, null, "DiscardPile")),
+    ...view.table.map((id) => faceToCardView(view, id, null, "Processing")),
+  ];
+  return {
+    revision: view.rulesetVersion ?? view.ruleset_version ?? 0,
+    state_hash: "",
+    observer: view.seat,
+    round: view.round,
+    current_player: view.turn,
+    phase: PHASE_MAP[view.phase] ?? "Idle",
+    seats: view.players.map((p) => ({
+      player: p.seat,
+      character_def: p.characterDef ?? 0,
+      seat: p.seat,
+      hp: p.hp,
+      max_hp: p.maxHp,
+      alive: p.alive,
+      turned_over: !!p.turnedOver,
+      hand_count: p.handCount,
+      // 裁决⑥：复用 SeatView.identity——不再恒置 null。
+      identity: p.identity ?? null,
+      skills: (p.skills ?? []).map((name) => ({
+        id: 0,
+        def: 0,
+        enabled: true,
+        use_count: 0,
+        active: false,
+        view_as: false,
+        locked: false,
+        name,
+      })),
+    })),
+    known_cards,
+    outcome: normalizeNativeOutcome(view.outcome ?? null),
+  };
+}
diff --git a/apps/web-client/scripts/approved-b-parity.mjs b/apps/web-client/scripts/approved-b-parity.mjs
new file mode 100644
--- /dev/null
+++ b/apps/web-client/scripts/approved-b-parity.mjs
@@ -0,0 +1,57 @@
+// Actual generated WASM32/Worker converter, server expectations and native IPC host: same archives.
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import {spawn} from 'node:child_process';
+import {createInterface} from 'node:readline';
+import init, {NativeEngine} from '../src/worker/native-pkg/engine_native_wasm.js';
+import {nativeObserverToSnapshot, nativeEnvelope} from '../src/worker/nativeBackend.ts';
+import {nativeObserverToSnapshot as oldReader} from './approved-b-old-reader.ts';
+const [path,binary] = process.argv.slice(2);
+assert(path && binary,'fixture JSON and actual pa09_native_bridge binary required');
+const fixtures=JSON.parse(readFileSync(path,'utf8'));
+await init({module_or_path:readFileSync(new URL('../src/worker/native-pkg/engine_native_wasm_bg.wasm',import.meta.url))});
+const host=spawn(binary,[],{stdio:['pipe','pipe','inherit']});
+const lines=createInterface({input:host.stdout});const pending=[];let id=0;
+lines.on('line',line=>{const waiter=pending.shift();if(waiter) waiter(JSON.parse(line));});
+async function request(body){const response=await new Promise(resolve=>{pending.push(resolve);host.stdin.write(JSON.stringify({id:++id,...body})+'\n');});assert.equal(response.ok,true,JSON.stringify(response));return response.data;}
+const seatFields=env=>env.view.seats.map(({generals,character_def})=>({generals,character_def}));
+const choiceFields=(choice,server=false)=>choice===null?null:({choice_id:choice.choice_id,observer:choice.observer-(server?1:0),kind:choice.kind,prompt:choice.prompt,native_kind:choice.native_kind,min_count:choice.min_count,max_count:choice.max_count,allow_cancel:choice.allow_cancel,revision:choice.revision,options:choice.options.map(option=>({...option,label_key:server&&option.label_key.startsWith('player:')?`player:${Number(option.label_key.slice(7))-1}`:option.label_key}))});
+const kinds=new Set();const prompts=new Set();let comparisons=0;
+try{
+ await request({type:'init'});
+ for(const fixture of fixtures){
+  const engine=new NativeEngine(fixture.seats.length,0n);
+  try{
+   for(let seat=0;seat<fixture.seats.length;seat++){
+    await request({type:'start',players:fixture.seats.length,seed:0,observer:seat,packsJson:fixture.packsJson});
+    for(let restore=0;restore<2;restore++){
+     engine.restore_hex_with_packs_json(fixture.archiveHex,fixture.packsJson);
+     const restoredHex=engine.save_hex();
+     const ipc=await request({type:'restore',hex:fixture.archiveHex,packsJson:fixture.packsJson});
+     const raw=JSON.parse(engine.view_json(seat));
+     const current=nativeObserverToSnapshot(raw);const legacy=oldReader(raw);
+     const withoutMetadata={...current,seats:current.seats.map(({generals,...seat})=>seat)};
+     assert.deepEqual(legacy,withoutMetadata,`${fixture.name}/${seat}: functional old TS reader accepts actual new WASM payload`);
+     const worker=nativeEnvelope({engine,observer:seat,eventCursor:0});
+     const server=fixture.seats[seat];
+     assert.deepEqual(seatFields(worker),seatFields(server),`${fixture.name}/${seat}: server/Worker both slots`);
+     assert.deepEqual(seatFields(ipc),seatFields(worker),`${fixture.name}/${seat}: IPC/Worker both slots`);
+     assert.deepEqual(choiceFields(worker.choice),choiceFields(server.choice,true),`${fixture.name}/${seat}: server/Worker all choice fields`);
+     assert.deepEqual(choiceFields(ipc.choice),choiceFields(worker.choice),`${fixture.name}/${seat}: IPC/Worker all choice fields`);
+     assert.equal(engine.save_hex(),restoredHex,'WASM metadata read changed archive bytes');
+     assert.equal((await request({type:'save'})).hex,restoredHex,'IPC/Worker restored archives differ (both rotate auth generation once)');
+     if(worker.choice){kinds.add(worker.choice.native_kind);prompts.add(worker.choice.prompt);}
+     comparisons++;
+    }
+   }
+   assert.equal(fixture.spectator.choice,null);
+   for(const [index,publicSeat] of fixture.spectator.view.seats.entries())for(let slot=0;slot<2;slot++){
+    const general=publicSeat.generals[slot];
+    if(general)assert.deepEqual(general,fixture.referee.view.seats[index].generals[slot]);
+   }
+   console.log(`PASS ${fixture.name}: ${fixture.seats.length} seats, two restores, both slots/all choice fields, identical archive bytes`);
+  }finally{engine.free();}
+ }
+ assert.deepEqual([...kinds].sort(),['confirm','pick_tag','respond_card','select_cards','select_players']);
+ console.log(JSON.stringify({passed:true,fixtures:fixtures.length,comparisons,kinds:[...kinds].sort(),prompts:[...prompts].sort(),failed:0}));
+}finally{host.stdin.end();host.kill('SIGTERM');}
diff --git a/apps/web-client/scripts/approved-b-ui.ts b/apps/web-client/scripts/approved-b-ui.ts
new file mode 100644
