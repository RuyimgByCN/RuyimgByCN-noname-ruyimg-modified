+#[test]
+fn unexpected_worker_panic_drains_other_roots_without_retry_and_pool_survives() {
+    let _hooks = Hooks::new();
+    let engine = candidate_rich_engine();
+    let pool = PlannerPool::new(2, 2);
+    let counts = Arc::new(Mutex::new(vec![0; 256]));
+    let observed = counts.clone();
+    let drained = Arc::new(AtomicUsize::new(0));
+    let done = drained.clone();
+    *ROOT_HOOK.lock().unwrap() = Some(Arc::new(move |index| {
+        observed.lock().unwrap()[index] += 1;
+        if index == 0 {
+            panic!("unexpected candidate fault");
+        }
+        std::thread::sleep(Duration::from_millis(20));
+        done.fetch_add(1, Ordering::SeqCst);
+    }));
+    let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+        engine.plan_action_with_pool(0, &BoundedPlanner::new(64), &pool)
+    }));
+    assert!(result.is_err());
+    assert_eq!(drained.load(Ordering::SeqCst), 1);
+    let counts = counts.lock().unwrap();
+    assert_eq!(&counts[..2], &[1, 1]);
+    assert!(counts[2..].iter().all(|count| *count == 0));
+    drop(counts);
+    *ROOT_HOOK.lock().unwrap() = None;
+    let (tx, rx) = mpsc::channel();
+    pool.try_submit(move || tx.send(()).unwrap()).unwrap();
+    rx.recv_timeout(Duration::from_secs(2)).unwrap();
+}
