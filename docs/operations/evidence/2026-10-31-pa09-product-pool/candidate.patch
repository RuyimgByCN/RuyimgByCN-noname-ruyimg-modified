+#[test]
+fn timed_single_seat_overlaps_two_workers_and_stops_at_contiguous_prefix() {
+    let _hooks = Hooks::new();
+    let engine = candidate_rich_engine();
+    let pool = PlannerPool::new(2, 2);
+    let counts = Arc::new(Mutex::new(vec![0; 256]));
+    let threads = Arc::new(Mutex::new(std::collections::HashSet::new()));
+    let active = Arc::new(AtomicUsize::new(0));
+    let peak = Arc::new(AtomicUsize::new(0));
+    let observed = (
+        counts.clone(),
+        threads.clone(),
+        active.clone(),
+        peak.clone(),
+    );
+    *ROOT_HOOK.lock().unwrap() = Some(Arc::new(move |index| {
+        observed.0.lock().unwrap()[index] += 1;
+        observed
+            .1
+            .lock()
+            .unwrap()
+            .insert(std::thread::current().id());
+        let now = observed.2.fetch_add(1, Ordering::SeqCst) + 1;
+        observed.3.fetch_max(now, Ordering::SeqCst);
+        std::thread::sleep(Duration::from_millis(100));
+        observed.2.fetch_sub(1, Ordering::SeqCst);
+    }));
+    let started = Instant::now();
+    let plan =
+        engine.plan_action_with_pool(0, &BoundedPlanner::new(64).with_deadline_ms(50), &pool);
+    assert!(plan.timed_out);
+    assert_eq!(plan.nodes_used, 2);
+    assert_eq!(pool.submitted_jobs(), 2);
+    assert_eq!(peak.load(Ordering::SeqCst), 2);
+    let threads = threads.lock().unwrap();
+    assert_eq!(threads.len(), 2);
+    assert!(!threads.contains(&std::thread::current().id()));
+    let counts = counts.lock().unwrap();
+    assert_eq!(&counts[..2], &[1, 1]);
+    assert!(counts[2..].iter().all(|count| *count == 0));
+    assert_eq!(
+        active.load(Ordering::SeqCst),
+        0,
+        "accepted work was drained"
+    );
+    assert!(started.elapsed() < Duration::from_secs(2));
+}
