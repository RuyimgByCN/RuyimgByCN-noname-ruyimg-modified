+#[test]
+#[ignore = "same-process default native auto_step timing; run explicitly"]
+fn default_auto_step_serial_and_candidate_pool_measurement() {
+    for rich in [false, true] {
+        let mut source = NativeSession::new_identity(4, 42).unwrap();
+        source.next_phase(0).unwrap();
+        source.next_phase(0).unwrap();
+        let mut archive = None;
+        let mut checkpoint_step = 0;
+        for step in 0..500 {
+            let before_archive = source.save_hex();
+            let before_jobs = source.planner_jobs_submitted();
+            source.auto_step().unwrap();
+            if source.planner_jobs_submitted() - before_jobs > 1 {
+                archive = Some(before_archive);
+                checkpoint_step = step;
+                break;
+            }
+        }
+        let archive = archive.expect("a real default step with multiple root jobs");
+        source.restore_hex_with_packs_json(&archive, "[]").unwrap();
+        if rich {
+            let mut snapshot = source.inner.save();
+            let actor = snapshot.core.turn.current as usize;
+            let deck = std::mem::take(&mut snapshot.core.deck);
+            snapshot.core.players[actor].hand.extend(deck);
+            source.inner = Engine::restore(&snapshot).unwrap();
+        }
+        let archive = source.save_hex();
+        let mut serial = NativeSession::new_identity(4, 42).unwrap();
+        let mut parallel = NativeSession::new_identity(4, 42).unwrap();
+        let mut direct_ns = Vec::new();
+        let mut pooled_ns = Vec::new();
+        let mut jobs = 0;
+        for sample in 0..202 {
+            serial.restore_hex_with_packs_json(&archive, "[]").unwrap();
+            parallel
+                .restore_hex_with_packs_json(&archive, "[]")
+                .unwrap();
+            let before = parallel.planner_jobs_submitted();
+            let (serial_reply, parallel_reply, direct, pooled) = if sample % 2 == 0 {
+                let started = Instant::now();
+                let serial_reply = serial.serial_auto_step_for_measurement().unwrap();
+                let direct = started.elapsed().as_nanos();
+                let started = Instant::now();
+                let parallel_reply = parallel.auto_step().unwrap();
+                (
+                    serial_reply,
+                    parallel_reply,
+                    direct,
+                    started.elapsed().as_nanos(),
+                )
+            } else {
+                let started = Instant::now();
+                let parallel_reply = parallel.auto_step().unwrap();
+                let pooled = started.elapsed().as_nanos();
+                let started = Instant::now();
+                let serial_reply = serial.serial_auto_step_for_measurement().unwrap();
+                (
+                    serial_reply,
+                    parallel_reply,
+                    started.elapsed().as_nanos(),
+                    pooled,
+                )
+            };
+            assert_eq!(serial_reply, parallel_reply);
+            assert_eq!(serial.save_hex(), parallel.save_hex());
+            let accepted = parallel.planner_jobs_submitted() - before;
+            assert!(
+                accepted > 1,
+                "each measured step must submit distinct root jobs"
+            );
+            if sample >= 2 {
+                direct_ns.push(direct);
+                pooled_ns.push(pooled);
+                jobs += accepted;
+            }
+        }
+        println!(
+            "{}",
+            serde_json::json!({
+                "route": "NativeSession::auto_step", "seed":42,"players":4,
+                "nodes":64,"deadline_ms":50,"candidate_rich":rich,
+                "samples":200,"accepted_candidate_jobs":jobs,"checkpoint_after_steps":checkpoint_step,
+                "workers":parallel.planner_pool.as_ref().unwrap().workers(),
+                "serial_p50_ns":percentile(&mut direct_ns,50),
+                "serial_p95_ns":percentile(&mut direct_ns,95),
+                "pool_p50_ns":percentile(&mut pooled_ns,50),
+                "pool_p95_ns":percentile(&mut pooled_ns,95),
+                "controls":"AB/BA alternating; restore outside timing; 2 warmups; complete replies and archives equal; counters included; no test delay hooks"
+            })
+        );
+    }
+}
