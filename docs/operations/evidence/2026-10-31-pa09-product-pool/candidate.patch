+use super::*;
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::sync::{Mutex, MutexGuard};
+
+static TEST_LOCK: Mutex<()> = Mutex::new(());
+
+struct Hooks(MutexGuard<'static, ()>);
+impl Hooks {
+    fn new() -> Self {
+        Self(TEST_LOCK.lock().unwrap_or_else(|error| error.into_inner()))
+    }
+}
+impl Drop for Hooks {
+    fn drop(&mut self) {
+        *ROOT_HOOK.lock().unwrap() = None;
+        *evaluation::SUBMIT_HOOK.lock().unwrap() = None;
+        let _ = &self.0;
+    }
+}
+
+fn candidate_rich_engine() -> Engine {
+    let mut engine = Engine::new_identity(42, 4);
+    for _ in 0..2 {
+        engine.submit(GameCommand {
+            actor: 0,
+            expected_revision: engine.revision(),
+            dedup_id: engine.last_dedup + 1,
+            action: GameAction::NextPhase,
+        });
+    }
+    let mut snapshot = engine.save();
+    let deck = std::mem::take(&mut snapshot.core.deck);
+    snapshot.core.players[0].hand.extend(deck);
+    Engine::restore(&snapshot).unwrap()
+}
+
+fn assert_same_plan(left: &Plan, right: &Plan) {
+    assert_eq!(format!("{left:?}"), format!("{right:?}"));
+}
+
+#[test]
+fn untimed_full_plan_parity_for_budget_prefixes_and_authority() {
+    let _hooks = Hooks::new();
+    let pool = PlannerPool::new(2, 2);
+    let mut engine = candidate_rich_engine();
+    for step in 0..20 {
+        let seat = engine
+            .open_choice()
+            .map_or(engine.turn().current, |c| c.observer);
+        let before = crate::archive::encode_archive(&engine.save());
+        let hash = engine.state_hash();
+        let legals = engine.legal_actions(seat);
+        let mut sim = engine.clone_for_simulation();
+        redact_opponent_hands(&mut sim, seat);
+        let count = enumerate_candidates_variant(&sim, seat, 0).len();
+        for budget in [0, 1, 2, count.saturating_sub(1), count, count + 1] {
+            let planner = BoundedPlanner::new(budget);
+            let serial = engine.plan_action(seat, &planner);
+            let parallel = engine.plan_action_with_pool(seat, &planner, &pool);
+            assert_same_plan(&serial, &parallel);
+            assert_eq!(before, crate::archive::encode_archive(&engine.save()));
+            assert_eq!(hash, engine.state_hash());
+            assert_eq!(legals, engine.legal_actions(seat));
+        }
+        let plan = engine.plan_action(seat, &BoundedPlanner::new(16));
+        engine.apply_plan(&plan).unwrap();
+        if engine.outcome().is_some() {
+            break;
+        }
+        assert!(step < 20);
+    }
+    assert!(pool.submitted_jobs() > 0);
+}
