+#[test]
+fn lost_accepted_job_disconnects_without_recomputation_or_deadlock() {
+    let _hooks = Hooks::new();
+    let engine = candidate_rich_engine();
+    let pool = Arc::new(PlannerPool::new(1, 1));
+    let (started_tx, started_rx) = mpsc::channel();
+    let (release_tx, release_rx) = mpsc::channel();
+    pool.try_submit(move || {
+        started_tx.send(()).unwrap();
+        release_rx.recv().unwrap();
+        panic!("unrelated job kills worker before queued root executes");
+    })
+    .unwrap();
+    started_rx.recv_timeout(Duration::from_secs(2)).unwrap();
+    let observed = pool.clone();
+    let release = std::thread::spawn(move || {
+        let started = Instant::now();
+        while observed.submitted_jobs() < 2 && started.elapsed() < Duration::from_secs(2) {
+            std::thread::yield_now();
+        }
+        release_tx.send(()).unwrap();
+    });
+    let attempts = Arc::new(AtomicUsize::new(0));
+    let observed = attempts.clone();
+    *ROOT_HOOK.lock().unwrap() = Some(Arc::new(move |_| {
+        observed.fetch_add(1, Ordering::SeqCst);
+    }));
+    let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+        engine.plan_action_with_pool(0, &BoundedPlanner::new(8), &pool)
+    }));
+    release.join().unwrap();
+    assert!(result.is_err());
+    assert_eq!(pool.submitted_jobs(), 2);
+    assert_eq!(
+        attempts.load(Ordering::SeqCst),
+        0,
+        "lost accepted root must not be retried"
+    );
+}
