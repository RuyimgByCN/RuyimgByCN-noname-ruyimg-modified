+#[test]
+fn public_input_own_cards_and_hidden_permutations_keep_full_plan_and_root_legals() {
+    let _hooks = Hooks::new();
+    let pool = PlannerPool::new(2, 2);
+    for seed in [42, 42021, 42022] {
+        let mut base = Engine::new(seed, 4);
+        for _ in 0..2 {
+            base.submit(GameCommand {
+                actor: 0,
+                expected_revision: base.revision(),
+                dedup_id: base.last_dedup + 1,
+                action: GameAction::NextPhase,
+            });
+        }
+        let mut hidden = base.clone();
+        let core = hidden.state_core_mut();
+        let lens: Vec<_> = core.players.iter().skip(1).map(|p| p.hand.len()).collect();
+        let mut cards = std::mem::take(&mut core.deck);
+        for player in core.players.iter_mut().skip(1) {
+            cards.append(&mut player.hand);
+        }
+        cards.rotate_left(7);
+        let mut offset = 0;
+        for (player, count) in core.players.iter_mut().skip(1).zip(lens) {
+            player.hand = cards[offset..offset + count].to_vec();
+            offset += count;
+        }
+        core.deck = cards[offset..].to_vec();
+        assert_eq!(
+            format!("{:?}", base.ai_session(0).input()),
+            format!("{:?}", hidden.ai_session(0).input())
+        );
+        assert_eq!(base.legal_actions(0), hidden.legal_actions(0));
+        let planner = BoundedPlanner::new(64);
+        let expected = base.plan_action(0, &planner);
+        assert_same_plan(&expected, &base.plan_action_with_pool(0, &planner, &pool));
+        assert_same_plan(&expected, &hidden.plan_action_with_pool(0, &planner, &pool));
+        let mut own = base.clone();
+        let core = own.state_core_mut();
+        std::mem::swap(&mut core.players[0].hand[0], &mut core.deck[0]);
+        assert_ne!(
+            format!("{:?}", base.ai_session(0).input()),
+            format!("{:?}", own.ai_session(0).input()),
+            "own-card positive control"
+        );
+    }
+}
