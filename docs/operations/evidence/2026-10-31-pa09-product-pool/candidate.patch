+#[test]
+fn cancelled_and_expired_admission_submit_no_jobs() {
+    let _hooks = Hooks::new();
+    let engine = candidate_rich_engine();
+    let pool = PlannerPool::new(2, 2);
+    let cancelled = BoundedPlanner::new(64);
+    cancelled.cancel();
+    let plan = engine.plan_action_with_pool(0, &cancelled, &pool);
+    assert_same_plan(&engine.plan_action(0, &cancelled), &plan);
+    let expired =
+        engine.plan_action_with_pool(0, &BoundedPlanner::new(64).with_deadline_ms(0), &pool);
+    assert!(expired.timed_out);
+    assert_eq!(expired.nodes_used, 0);
+    assert_eq!(pool.submitted_jobs(), 0);
+}
