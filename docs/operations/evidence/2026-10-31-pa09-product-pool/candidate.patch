+#[test]
+fn distinct_equal_scores_choose_first_root_independent_of_completion_order() {
+    let _hooks = Hooks::new();
+    let engine = candidate_rich_engine();
+    let planner = BoundedPlanner::new(64);
+    let mut sim = engine.clone_for_simulation();
+    redact_opponent_hands(&mut sim, 0);
+    let baseline = sim.ai_session(0).view();
+    let mut first = None;
+    let mut pair = None;
+    for action in enumerate_candidates_variant(&sim, 0, 0) {
+        if let Ok(Some((_, score))) = evaluation::evaluate(&sim, &baseline, 0, &action, &planner) {
+            if let Some((old_score, old_action)) = &first {
+                if score == *old_score && action != *old_action {
+                    pair = Some(vec![old_action.clone(), action]);
+                    break;
+                }
+            } else {
+                first = Some((score, action));
+            }
+        }
+    }
+    let candidates = pair.expect("two distinct legal roots with equal scores");
+    let expected = candidates[0].clone();
+    *ROOT_HOOK.lock().unwrap() = Some(Arc::new(|index| {
+        if index == 0 {
+            std::thread::sleep(Duration::from_millis(20));
+        }
+    }));
+    let pool = PlannerPool::new(2, 2);
+    let actual = plan_candidates(
+        sim,
+        baseline,
+        candidates,
+        0,
+        engine.revision(),
+        &planner,
+        Instant::now(),
+        &pool,
+    );
+    assert_eq!(actual.action, expected);
+}
