new file mode 100644
index 00000000..0f3eb242
--- /dev/null
+++ b/apps/desktop-client/src/native_engine_host/pool_tests.rs
@@ -0,0 +1,224 @@
+//! Default native owner-queue route measurements; no GUI or IPC performance claim.
+use super::*;
+use std::sync::mpsc;
+use std::time::{Duration, Instant};
+
+type Sample = (usize, u128);
+
+fn measured_host() -> (
+    NativeEngineHost,
+    mpsc::Receiver<Sample>,
+    std::thread::JoinHandle<()>,
+) {
+    let (sender, receiver) = sync_channel::<Job>(8);
+    let closed = Arc::new(AtomicBool::new(false));
+    let owner_closed = closed.clone();
+    let (metrics_tx, metrics_rx) = mpsc::channel();
+    let owner = std::thread::Builder::new()
+        .name("desktop-engine".into())
+        .spawn(move || {
+            let mut host = HostSession::default();
+            run_requests(receiver, &owner_closed, |request| {
+                let auto = request["type"] == "autoStep";
+                let before = host
+                    .session
+                    .as_ref()
+                    .map_or(0, NativeSession::planner_jobs_submitted);
+                let started = Instant::now();
+                let result = host.dispatch(request);
+                if auto {
+                    let after = host.session.as_ref().unwrap().planner_jobs_submitted();
+                    metrics_tx
+                        .send((after - before, started.elapsed().as_nanos()))
+                        .unwrap();
+                }
+                result
+            });
+        })
+        .unwrap();
+    (
+        NativeEngineHost {
+            sender: Mutex::new(Some(sender)),
+            closed,
+        },
+        metrics_rx,
+        owner,
+    )
+}
+
+#[tokio::test]
+async fn actual_default_auto_step_owner_queue_submits_candidate_jobs_and_closes() {
+    let (host, metrics, owner) = measured_host();
+    assert_eq!(
+        host.request(json!({"id":1,"type":"init"})).await.unwrap()["ok"],
+        true
+    );
+    assert_eq!(
+        host.request(
+            json!({"id":2,"type":"start","players":4,"seed":42,"observer":0,"mode":"identity"})
+        )
+        .await
+        .unwrap()["ok"],
+        true
+    );
+    let mut submitted = 0;
+    for id in 3..131 {
+        let response = host
+            .request(json!({"id":id,"type":"autoStep"}))
+            .await
+            .unwrap();
+        assert_eq!(response["ok"], true, "{response}");
+        assert!(response["data"]["hash_hex"]
+            .as_str()
+            .is_some_and(|hash| hash.len() == 64));
+        submitted += metrics.recv_timeout(Duration::from_secs(2)).unwrap().0;
+    }
+    assert!(submitted > 1, "actual pool jobs, not just a created pool");
+    host.close();
+    assert!(host
+        .request(json!({"id":132,"type":"autoStep"}))
+        .await
+        .unwrap_err()
+        .contains("closed"));
+    owner.join().unwrap();
+}
+
+fn percentile(values: &mut [u128], percent: usize) -> u128 {
+    values.sort_unstable();
+    values[(values.len() * percent).div_ceil(100).saturating_sub(1)]
+}
+
+#[tokio::test]
+#[ignore = "actual default native owner-queue route timing; run explicitly"]
+async fn actual_default_auto_step_owner_queue_measurement() {
+    let (host, metrics, owner) = measured_host();
+    host.request(json!({"id":1,"type":"init"})).await.unwrap();
+    let mut id = 2;
+    let mut roundtrip_ns = Vec::new();
+    let mut owner_ns = Vec::new();
+    let mut submitted = 0;
+    let mut pool_steps = 0;
+    let mut completed_games = 0;
+    let mut trajectory = blake3::Hasher::new();
+    for game in 0..6 {
+        host.request(
+            json!({"id":id,"type":"start","players":4,"seed":42,"observer":0,"mode":"identity"}),
+        )
+        .await
+        .unwrap();
+        id += 1;
+        for _ in 0..1500 {
+            let started = Instant::now();
+            let response = host
+                .request(json!({"id":id,"type":"autoStep"}))
+                .await
+                .unwrap();
+            let elapsed = started.elapsed().as_nanos();
+            id += 1;
+            assert_eq!(response["ok"], true, "{response}");
+            let (jobs, compute) = metrics.recv_timeout(Duration::from_secs(2)).unwrap();
+            if game > 0 {
+                submitted += jobs;
+                pool_steps += usize::from(jobs > 0);
+                owner_ns.push(compute);
+                roundtrip_ns.push(elapsed);
+                trajectory.update(&serde_json::to_vec(&response["data"]).unwrap());
+            }
+            if response["data"]["finished"] == true {
+                if game > 0 {
+                    completed_games += 1;
+                }
+                break;
+            }
+        }
+    }
+    assert!(submitted > 0);
+    println!(
+        "{}",
+        json!({"route":"NativeEngineHost::request/run_requests/HostSession::dispatch/NativeSession::auto_step/envelope",
+        "players":4,"seed":42,"nodes":64,"deadline_ms":50,"samples":roundtrip_ns.len(),"completed_games":completed_games,
+        "accepted_candidate_jobs":submitted,"pool_steps":pool_steps,"warmup_games":1,
+        "roundtrip_p50_ns":percentile(&mut roundtrip_ns,50),"roundtrip_p95_ns":percentile(&mut roundtrip_ns,95),
+        "owner_p50_ns":percentile(&mut owner_ns,50),"owner_p95_ns":percentile(&mut owner_ns,95),
+        "trajectory_digest":trajectory.finalize().to_hex().to_string(),
+        "limitations":"test fixture uses actual owner queue/dispatch/envelope, excludes Tauri ResourceTable/WebView/IPC; no serial comparison here"})
+    );
+    host.close();
+    owner.join().unwrap();
+}
+
+#[tokio::test]
+async fn close_finishes_admitted_default_candidate_work_and_rejects_queued_command() {
+    let (sender, receiver) = sync_channel::<Job>(8);
+    let closed = Arc::new(AtomicBool::new(false));
+    let owner_closed = closed.clone();
+    let host = NativeEngineHost {
+        sender: Mutex::new(Some(sender)),
+        closed,
+    };
+    let (entered_tx, entered_rx) = sync_channel(1);
+    let (release_tx, release_rx) = sync_channel(1);
+    let (done_tx, done_rx) = sync_channel(1);
+    let owner = std::thread::spawn(move || {
+        let mut session = HostSession::default();
+        session.dispatch(json!({"id":1,"type":"init"})).unwrap();
+        session
+            .dispatch(
+                json!({"id":2,"type":"start","players":4,"seed":42,"observer":0,"mode":"identity"}),
+            )
+            .unwrap();
+        let mut checkpoint = None;
+        for id in 3..503 {
+            let live = session.session.as_ref().unwrap();
+            let archive = live.save_hex();
+            let before = live.planner_jobs_submitted();
+            session
+                .dispatch(json!({"id":id,"type":"autoStep"}))
+                .unwrap();
+            if session.session.as_ref().unwrap().planner_jobs_submitted() - before > 1 {
+                checkpoint = Some(archive);
+                break;
+            }
+        }
+        session
+            .dispatch(json!({"id":504,"type":"restore","hex":checkpoint.unwrap(),"packsJson":"[]"}))
+            .unwrap();
+        let before = session.session.as_ref().unwrap().planner_jobs_submitted();
+        run_requests(receiver, &owner_closed, |request| {
+            entered_tx.send(()).unwrap();
+            release_rx.recv().unwrap();
+            session.dispatch(request)
+        });
+        let submitted = session.session.as_ref().unwrap().planner_jobs_submitted() - before;
+        drop(session);
+        done_tx.send(submitted).unwrap();
+    });
+    let (executing_tx, executing_rx) = oneshot::channel();
+    host.sender
+        .lock()
+        .unwrap()
+        .as_ref()
+        .unwrap()
+        .try_send((json!({"id":505,"type":"autoStep"}), executing_tx))
+        .unwrap();
+    entered_rx.recv_timeout(Duration::from_secs(5)).unwrap();
+    let (queued_tx, queued_rx) = oneshot::channel();
+    host.sender
+        .lock()
+        .unwrap()
+        .as_ref()
+        .unwrap()
+        .try_send((json!({"id":506,"type":"autoStep"}), queued_tx))
+        .unwrap();
+    host.close();
+    release_tx.send(()).unwrap();
+    assert_eq!(executing_rx.await.unwrap()["ok"], true);
+    let queued = queued_rx.await.unwrap();
+    assert_eq!(queued["ok"], false);
+    assert!(queued["error"]
+        .as_str()
+        .unwrap()
+        .contains("closed before execution"));
+    assert!(done_rx.recv_timeout(Duration::from_secs(5)).unwrap() > 1);
+    owner.join().unwrap();
+}
