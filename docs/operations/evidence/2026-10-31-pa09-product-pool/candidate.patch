+use super::*;
+use std::time::Instant;
+
+// Main4dd's original auto_step is the serial control; no production option is introduced.
+impl NativeSession {
+    fn serial_auto_step_for_measurement(&mut self) -> Result<String, String> {
+        if self.inner.outcome().is_some() {
+            return Ok(serde_json::json!({ "done": true }).to_string());
+        }
+        if let Some(c) = self.inner.open_choice() {
+            let take = c.spec.min.max(1).min(c.spec.max).min(c.spec.options.len());
+            let sel: Vec<_> = c
+                .spec
+                .options
+                .iter()
+                .filter(|o| matches!(o, engine_native::ChoiceOption::Card(_)))
+                .take(take)
+                .cloned()
+                .collect();
+            let sel = if sel.len() == take {
+                sel
+            } else {
+                c.spec.options.iter().take(take).cloned().collect()
+            };
+            let (cid, obs) = (c.id, c.observer);
+            let out = self.inner.submit(engine_native::GameCommand {
+                actor: obs,
+                expected_revision: self.inner.revision(),
+                dedup_id: self.inner.revision().wrapping_mul(2).max(1),
+                action: GameAction::Answer {
+                    choice_id: cid,
+                    selection: sel,
+                },
+            });
+            return Ok(serde_json::json!({
+                "kind": "answer",
+                "outcome": outcome_json(&self.inner, &out),
+            })
+            .to_string());
+        }
+        let seat = self.inner.turn().current;
+        let planner = BoundedPlanner::new(self.planner_nodes);
+        // Zero disables the native clock so node-bounded WASM/native comparisons use the same policy.
+        let planner = if self.deadline_ms == 0 {
+            planner
+        } else {
+            planner.with_deadline_ms(self.deadline_ms)
+        };
+        let plan = self.inner.plan_action(seat, &planner);
+        match self.inner.apply_plan(&plan) {
+            Ok(out) => Ok(serde_json::json!({
+                "kind": "plan",
+                "seat": seat,
+                "outcome": outcome_json(&self.inner, &out),
+                "finished": self.inner.outcome().is_some(),
+            })
+            .to_string()),
+            Err(e) => Ok(serde_json::json!({
+                "kind": "plan",
+                "seat": seat,
+                "error": match e {
+                    engine_native::ai::ApplyPlanError::Stale { .. } => "stale",
+                    engine_native::ai::ApplyPlanError::Cancelled => "cancelled",
+                },
+            })
+            .to_string()),
+        }
+    }
+}
+
+#[test]
+fn default_auto_step_uses_real_pool_jobs_and_preserves_session_trajectory() {
+    let mut parallel = NativeSession::new_identity(4, 42).unwrap();
+    let mut serial = NativeSession::new_identity(4, 42).unwrap();
+    for _ in 0..128 {
+        let before = parallel.planner_jobs_submitted();
+        assert_eq!(
+            serial.serial_auto_step_for_measurement().unwrap(),
+            parallel.auto_step().unwrap()
+        );
+        assert_eq!(serial.save_hex(), parallel.save_hex());
+        assert_eq!(serial.state_hash_hex(), parallel.state_hash_hex());
+        assert!(parallel.planner_jobs_submitted() >= before);
+        if parallel.is_finished() {
+            break;
+        }
+    }
+    assert!(
+        parallel.planner_jobs_submitted() > 0,
+        "created pool is not sufficient: actual jobs required"
+    );
+    let accepted = parallel.planner_jobs_submitted();
+    let pool = parallel.planner_pool.as_ref().unwrap() as *const _;
+    let archive = parallel.save_hex();
+    parallel
+        .restore_hex_with_packs_json(&archive, "[]")
+        .unwrap();
+    assert_eq!(parallel.planner_jobs_submitted(), accepted);
+    assert_eq!(parallel.planner_pool.as_ref().unwrap() as *const _, pool);
+    serial.restore_hex_with_packs_json(&archive, "[]").unwrap();
+    let restored_archive = parallel.save_hex();
+    assert!(parallel.restore_hex_with_packs_json("bad", "[]").is_err());
+    assert_eq!(parallel.save_hex(), restored_archive);
+    assert_eq!(parallel.planner_jobs_submitted(), accepted);
+    for budget in [0, 1] {
+        parallel.set_planner(budget, 0);
+        serial.set_planner(budget, 0);
+        assert_eq!(
+            serial.serial_auto_step_for_measurement().unwrap(),
+            parallel.auto_step().unwrap()
+        );
+        assert_eq!(serial.save_hex(), parallel.save_hex());
+        assert_eq!(parallel.planner_jobs_submitted(), accepted);
+    }
+}
+
+fn percentile(values: &mut [u128], percent: usize) -> u128 {
+    values.sort_unstable();
+    values[(values.len() * percent).div_ceil(100).saturating_sub(1)]
+}
