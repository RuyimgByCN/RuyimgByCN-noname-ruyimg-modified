+//! Bounded admission of one seat's root attempts; results are reduced in source order.
+use super::*;
+use crate::ai_pool::PlannerPool;
+use std::collections::VecDeque;
+use std::sync::{mpsc, Arc};
+
+type Evaluation = Result<Option<i64>, [String; 2]>;
+type Completed = std::thread::Result<Evaluation>;
+type Pending = VecDeque<(usize, mpsc::Receiver<Completed>)>;
+
+#[cfg(test)]
+type RootHook = Arc<dyn Fn(usize) + Send + Sync>;
+#[cfg(test)]
+static ROOT_HOOK: std::sync::Mutex<Option<RootHook>> = std::sync::Mutex::new(None);
+
+fn evaluate_root(
+    index: usize,
+    sim: &Engine,
+    baseline: &crate::view::PlayerView,
+    seat: u8,
+    action: &GameAction,
+    planner: &BoundedPlanner,
+) -> Evaluation {
+    #[cfg(not(test))]
+    let _ = index;
+    #[cfg(test)]
+    {
+        let hook = ROOT_HOOK.lock().unwrap().clone();
+        if let Some(hook) = hook {
+            hook(index);
+        }
+    }
+    evaluation::evaluate(sim, baseline, seat, action, planner)
+        .map(|trial| trial.map(|(_, score)| score))
+}
+
+fn join_next(pending: &mut Pending, results: &mut [Option<Completed>]) -> bool {
+    let (index, receiver) = pending.pop_front().expect("admitted candidate");
+    match receiver.recv() {
+        Ok(result) => {
+            let failed = result.is_err();
+            results[index] = Some(result);
+            failed
+        }
+        Err(_) => true,
+    }
+}
+
+pub(super) fn plan_candidates(
+    sim: Engine,
+    baseline_view: crate::view::PlayerView,
+    candidates: Vec<GameAction>,
+    seat: u8,
+    revision: u64,
+    planner: &BoundedPlanner,
+    started: Instant,
+    pool: &PlannerPool,
+) -> Plan {
+    let sim = Arc::new(sim);
+    let baseline_view = Arc::new(baseline_view);
+    let mut results: Vec<Option<Completed>> =
+        Vec::with_capacity(candidates.len().min(planner.node_budget));
+    let mut pending = VecDeque::with_capacity(pool.workers());
+    let mut timed_out = false;
+    let mut budget_exhausted = false;
+    let mut cancelled_action = None;
+    let mut failed = false;
+
+    for (idx, action) in candidates.iter().enumerate() {
+        if pending.len() == pool.workers() {
+            failed = join_next(&mut pending, &mut results);
+        }
+        if failed {
+            break;
+        }
+        if planner.cancelled() {
+            cancelled_action = Some(action.clone());
+            break;
+        }
+        if planner
+            .deadline_ms
+            .is_some_and(|ms| started.elapsed() > Duration::from_millis(ms))
+        {
+            timed_out = true;
+            break;
+        }
+        if idx >= planner.node_budget {
+            budget_exhausted = true;
+            break;
+        }
+        results.push(None);
+        let root = sim.clone();
+        let baseline = baseline_view.clone();
+        let action_owned = action.clone();
+        let config = planner.clone();
+        // Each accepted job owns its only sender: a lost job disconnects without an owner-held sender.
+        let (tx, receiver) = mpsc::channel();
+        match pool.try_submit(move || {
+            let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+                evaluate_root(idx, &root, &baseline, seat, &action_owned, &config)
+            }));
+            let _ = tx.send(result);
+        }) {
+            Ok(()) => pending.push_back((idx, receiver)),
+            Err(_) => {
+                // A rejected closure never ran: compute only this root attempt once locally.
+                let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+                    evaluate_root(idx, &sim, &baseline_view, seat, action, planner)
+                }));
+                failed = result.is_err();
+                results[idx] = Some(result);
+            }
+        }
+    }
+    while !pending.is_empty() {
+        join_next(&mut pending, &mut results);
+    }
+    assert!(
+        results.iter().all(Option::is_some),
+        "candidate worker lost an admitted result"
+    );
+    let nodes = results.len();
+    let mut best = None;
+    let mut sim_faults = 0u32;
+    for (index, result) in results.into_iter().enumerate() {
+        let result = match result.expect("admitted candidate result") {
+            Ok(result) => result,
+            Err(panic) => std::panic::resume_unwind(panic),
+        };
+        match result {
+            Ok(Some(score)) => {
+                if best.as_ref().is_none_or(|(previous, _)| score > *previous) {
+                    best = Some((score, candidates[index].clone()));
+                }
+            }
+            Ok(None) => {}
+            Err(contexts) => {
+                sim_faults = sim_faults.saturating_add(1);
+                for context in contexts {
+                    note_sim_fault(context);
+                }
+            }
+        }
+    }
+    let cancelled = cancelled_action.is_some();
+    let action = cancelled_action.unwrap_or_else(|| {
+        best.map(|(_, action)| action)
+            .unwrap_or_else(|| fallback_action(&sim, seat))
+    });
+    Plan {
+        seat,
+        revision,
+        action,
+        nodes_used: nodes,
+        budget_exhausted,
+        timed_out,
+        cancelled,
+        sim_faults,
+    }
+}
+
+#[cfg(test)]
+mod tests;
