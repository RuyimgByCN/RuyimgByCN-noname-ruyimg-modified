+        if ctx.core.has_skill_any_state(holder, ydef) {
+            let p = ctx.core.player(holder);
+            if p.hp > 0 && p.hp <= p.max_hp as i32 / 2 {
+                let was_enabled = ctx.core.has_skill(holder, ydef);
