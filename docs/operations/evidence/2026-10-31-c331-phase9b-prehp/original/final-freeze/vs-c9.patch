+//! HP-change gates complete before the ordinary TargetDamage window.
+use super::*;
+pub(super) fn commit_damage_change_hp(ctx: &mut Ctx<'_>, d: &crate::event::DamageData) {
+    if let Some(ydef) = ctx
+        .catalog
