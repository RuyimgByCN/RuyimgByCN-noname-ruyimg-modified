+    pub fn tag(&self) -> u8 {
+        match self {
+            Self::Before => 0,
+            Self::HpCommitted { .. } => 1,
+            Self::TargetDamage { .. } => 2,
+            Self::DyingPending { .. } => 3,
+            Self::DyingDone { .. } => 4,
+            Self::Source { .. } => 5,
+            Self::End { .. } => 6,
+            Self::After { .. } => 7,
+            Self::Chain { .. } => 8,
+            Self::Done => 9,
+            Self::ZeroPending => 10,
+            Self::Stopped => 11,
+            Self::Start => 12,
+            Self::Begin => 13,
+            Self::Begin1 => 14,
+            Self::Begin2 => 15,
+            Self::Begin3 => 16,
+            Self::Begin4 => 17,
+            Self::SubmitHp => 18,
+            Self::CancelledPending => 19,
+        }
+    }
+    pub fn chain_eligible(&self) -> Option<bool> {
+        match self {
+            Self::HpCommitted { chain_eligible }
+            | Self::TargetDamage { chain_eligible }
+            | Self::DyingPending { chain_eligible }
+            | Self::DyingDone { chain_eligible }
+            | Self::Source { chain_eligible }
+            | Self::End { chain_eligible }
+            | Self::After { chain_eligible } => Some(*chain_eligible),
+            _ => None,
+        }
+    }
+    pub fn canonical_bytes(&self) -> Vec<u8> {
+        let mut out = vec![self.tag()];
