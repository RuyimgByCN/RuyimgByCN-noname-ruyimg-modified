+fn trigger_only_no_frame_sentinel_cannot_hide_wrong_window() {
+    trigger_only_cannot_disguise_slot(false);
+}
+#[test]
+fn trigger_only_intrinsic_slot_cannot_hide_wrong_window() {
+    trigger_only_cannot_disguise_slot(true);
