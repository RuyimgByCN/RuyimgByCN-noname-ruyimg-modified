+                    Atom::Gained => { h.update(&103u16.to_le_bytes()); }
+                    Atom::FactionIs(n) => { h.update(&104u16.to_le_bytes()); h.update(&[*n]); }
+                    Atom::ShaOrTrick => { h.update(&105u16.to_le_bytes()); }
