+            actor: 1,
+            expected_revision: e.revision(),
+            dedup_id: e.save().last_dedup + 1,
+            action: GameAction::Answer {
+                choice_id: choice.id,
+                selection: vec![choice.spec.options[256]]
+            }
+        }),
+        CommandOutcome::Rejected(_)
+    ));
+    let after = expected.save();
+    let mut session =
