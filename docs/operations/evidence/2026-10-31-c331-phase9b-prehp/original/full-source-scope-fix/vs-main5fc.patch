+    // 炎狱门控（Boss 毕方，规则 v229）：体力首次≤一半激活（隐贼/延妒/
+    // 积财/乱常/虚失同款 enable 直写）
+    if let Some(ydef) = ctx
+        .catalog
+        .skill_by_name(crate::vocabulary::names::BOSS_YANYU)
+    {
+        let holder = d.target;
