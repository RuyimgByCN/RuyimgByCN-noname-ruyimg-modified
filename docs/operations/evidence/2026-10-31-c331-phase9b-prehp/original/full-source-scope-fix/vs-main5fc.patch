+        }
+    }
+    // 乱常门控（Boss 梼杌，规则 v218）：体力首次≤一半激活（隐贼/延妒/
+    // 积财同款 enable 直写）
+    if let Some(ldef) = ctx
+        .catalog
+        .skill_by_name(crate::vocabulary::names::BOSS_LUANCHANG)
+    {
+        let holder = d.target;
+        if ctx.core.has_skill_any_state(holder, ldef) && !ctx.core.has_skill(holder, ldef) {
