diff --git a/crates/engine-native-kernel/src/kernel/damage_flow.rs b/crates/engine-native-kernel/src/kernel/damage_flow.rs
new file mode 100644
index 00000000..2965d22e
--- /dev/null
+++ b/crates/engine-native-kernel/src/kernel/damage_flow.rs
@@ -0,0 +1,141 @@
+//! The root owns progression; each ordinary window uses the existing child frame queue.
+use super::*;
+use crate::event::{DamageOutcome as O, DamageProgress as P, DamageWindowKind as W};
+
+#[derive(Clone)]
+pub struct DamageFlow {
+    pub root: EventId,
+}
+impl crate::catalog::SkillMachine for DamageFlow {
+    fn fork(&self) -> Box<dyn crate::catalog::SkillMachine> {
+        Box::new(self.clone())
+    }
+    fn snapshot(&self) -> crate::snap::MachineSnapshot {
+        crate::snap::MachineSnapshot::DamageFlow { root: self.root }
+    }
+    fn step(&mut self, ctx: &mut Ctx<'_>) -> Flow {
+        let Some(frame) = ctx.res.frame(self.root) else {
+            return Flow::Done;
+        };
+        let EventData::Damage(mut d) = frame.data.clone() else {
+            return Flow::Done;
+        };
+        if d.source.is_some_and(|s| !ctx.core.player(s).alive) {
+            d.source = None;
+        }
+        if d.settlement.outcome == O::Running {
+            if d.prevented {
+                ctx.log(LogEvent::DamagePrevented { target: d.target });
+                d.settlement.outcome = O::Cancelled;
+                d.settlement.progress = P::CancelledPending;
+            } else if d.amount <= 0 {
+                d.settlement.outcome = O::Zero;
+                d.settlement.progress = P::ZeroPending;
+            }
+        }
+        if d.settlement.outcome == O::Cancelled
+            && !matches!(d.settlement.progress, P::Stopped | P::CancelledPending)
+        {
+            d.settlement.progress = P::CancelledPending;
+        }
+        if d.settlement.outcome == O::ReplacedByLoseHp {
+            d.settlement.progress = P::Stopped;
+        }
+        let mut child = None;
+        match d.settlement.progress.clone() {
+            P::Start => d.settlement.progress = P::Before,
+            P::Before => d.settlement.progress = P::Begin,
+            P::Begin => d.settlement.progress = P::Begin1,
+            P::Begin1 => d.settlement.progress = P::Begin2,
+            P::Begin2 => d.settlement.progress = P::Begin3,
+            P::Begin3 => d.settlement.progress = P::Begin4,
+            P::Begin4 => d.settlement.progress = P::SubmitHp,
+            P::SubmitHp => {
+                ctx.res.frame_mut(self.root).unwrap().data = EventData::Damage(d.clone());
+                commit_damage(ctx, self.root, d);
+                return Flow::Yield;
+            }
+            P::ZeroPending | P::CancelledPending => {
+                let window = if d.settlement.progress == P::ZeroPending {
+                    W::Zero
+                } else {
+                    W::Cancelled
+                };
+                d.settlement.progress = P::Stopped;
+                if !d.settlement.notrigger {
+                    child = Some(EventData::DamageWindow {
+                        root: self.root,
+                        window,
+                    });
+                }
+            }
+            P::Stopped | P::Done => {
+                ctx.res.frame_mut(self.root).unwrap().data = EventData::Damage(d);
+                return Flow::Done;
+            }
+            P::HpCommitted { chain_eligible } => {
+                d.settlement.progress = P::TargetDamage { chain_eligible }
+            }
+            P::TargetDamage { chain_eligible } => {
+                d.settlement.progress = P::DyingPending { chain_eligible };
+                if ctx.core.player(d.target).alive
+                    && ctx.core.player(d.target).hp <= 0
+                    && !ctx.core.player(d.target).dying
+                {
+                    ctx.core.player_mut(d.target).dying = true;
+                    ctx.log(LogEvent::DyingEntered { player: d.target });
+                    child = Some(EventData::Dying {
+                        player: d.target,
+                        source: d.source,
+                    });
+                }
+            }
+            P::DyingPending { chain_eligible } => {
+                d.settlement.progress = P::DyingDone { chain_eligible }
+            }
+            P::DyingDone { chain_eligible } => d.settlement.progress = P::Source { chain_eligible },
+            P::Source { chain_eligible } => d.settlement.progress = P::End { chain_eligible },
+            P::End { chain_eligible } => d.settlement.progress = P::After { chain_eligible },
+            P::After { chain_eligible } => {
+                let remaining = if chain_eligible {
+                    ctx.core
+                        .seat_order_from(ctx.core.turn.current)
+                        .into_iter()
+                        .filter(|p| *p != d.target && ctx.core.player(*p).linked)
+                        .collect()
+                } else {
+                    Vec::new()
+                };
+                d.settlement.progress = P::Chain { remaining };
+            }
+            P::Chain { mut remaining } => {
+                if remaining.is_empty() {
+                    d.settlement.progress = P::Done;
+                    d.settlement.outcome = O::Completed;
+                } else {
+                    let target = remaining.remove(0);
+                    d.settlement.progress = P::Chain { remaining };
+                    if ctx.core.player(target).alive && ctx.core.player(target).linked {
+                        let mut chained =
+                            damage_data_with(d.source, target, d.amount, d.nature, d.card);
+                        chained.from_chain = true;
+                        child = Some(EventData::Damage(chained));
+                    }
+                }
+            }
+        }
+        if child.is_none() && !d.settlement.notrigger {
+            if let Some(window) = d.settlement.progress.window() {
+                child = Some(EventData::DamageWindow {
+                    root: self.root,
+                    window,
+                });
+            }
+        }
+        ctx.res.frame_mut(self.root).unwrap().data = EventData::Damage(d);
+        if let Some(child) = child {
+            ctx.emit(child);
+        }
+        Flow::Yield
+    }
+}
diff --git a/crates/engine-native-kernel/src/kernel/damage_windows.rs b/crates/engine-native-kernel/src/kernel/damage_windows.rs
new file mode 100644
index 00000000..712fba0c
--- /dev/null
+++ b/crates/engine-native-kernel/src/kernel/damage_windows.rs
@@ -0,0 +1,355 @@
+//! Source-qualified native damage transitions; ordinary window queues follow each commit.
+use super::*;
+use crate::event::DamageWindowKind as Window;
+pub(super) fn commit_damage_window(ctx: &mut Ctx<'_>, root: EventId, window: Window) {
+    let mut d = ctx.res.frame(root).expect("damage root").damage().clone();
+    if d.prevented
+        || d.amount <= 0
+        || d.settlement.outcome != crate::event::DamageOutcome::Running
+        || d.settlement.notrigger
+    {
+        return;
+    }
+    let mut amount = i64::from(d.amount);
+    match window {
+        Window::Before => {
+            // 绝情（Boss 张春华，规则 v260；一将包旧绝情）：锁定——你造成的伤害
+            // 改为目标失去等量体力（上游 source damageBefore cancel+loseHp(num)
+            // 同口径；num=增幅前原始值=d.amount；取消后伤害事件不再结算=受击/
+            // 加成类不触发；置于急冻前——上游 damageBefore 同层内容序）
+            if let Some(jqdef) = ctx
+                .catalog
+                .skill_by_name(crate::vocabulary::names::JUE_QING)
+            {
+                if let Some(src) = d.source {
+                    if src != d.target
+                        && ctx.core.player(src).alive
+                        && ctx.core.has_skill(src, jqdef)
+                    {
+                        finish_damage(
+                            ctx,
+                            root,
+                            d.clone(),
+                            crate::event::DamageOutcome::ReplacedByLoseHp,
+                        );
+                        ctx.emit(EventData::LoseHp {
+                            player: d.target,
+                            amount: d.amount as u32,
+                        });
+                        return;
+                    }
+                }
+            }
+            // 无心（Boss 张春华，规则 v260）伤害半：锁定——你受到的伤害改为失去
+            // 1 点体力（上游 damageBefore priority 10 cancel+loseHp() 无参=1 同
+            // 口径；置于绝情后=同层 priority 序）
+            if let Some(wxdef) = ctx
+                .catalog
+                .skill_by_name(crate::vocabulary::names::BOSS_WUXIN)
+            {
+                if ctx.core.has_skill(d.target, wxdef) && ctx.core.player(d.target).alive {
+                    finish_damage(
+                        ctx,
+                        root,
+                        d.clone(),
+                        crate::event::DamageOutcome::ReplacedByLoseHp,
+                    );
+                    ctx.emit(EventData::LoseHp {
+                        player: d.target,
+                        amount: 1,
+                    });
+                    return;
+                }
+            }
+            // 急冻冰封（U05 ow 美，规则 v127）：锁定——冰封目标受所有伤害无
+            // 效（上游 jidong2 damageBefore trigger.cancel() 同口径；铁索传导
+            // 的独立事件同门控）。置于各伤害增幅钩前：伤害已整体取消，
+            // damageBegin 类增幅同上游一样不再结算。
+            if ctx.core.player(d.target).jidong_active {
+                ctx.log(LogEvent::DamagePrevented { target: d.target });
+                finish_damage(ctx, root, d, crate::event::DamageOutcome::Cancelled);
+                return;
+            }
+            // 诚信免伤（U05 xianjian 明绣，规则 v164）：锁定——免伤状态目标受
+            // 所有伤害无效（上游 chengxin2 damageBefore trigger.cancel 同口径）
+            if ctx.core.player(d.target).chengxin_active {
+                ctx.log(LogEvent::DamagePrevented { target: d.target });
+                finish_damage(ctx, root, d, crate::event::DamageOutcome::Cancelled);
+                return;
+            }
+        }
+        Window::Begin => {
+            // 赤龙牙（U05 swd 第四批，规则 v88）：锁定——来源装备赤龙牙时
+            // 火属性伤害 +1（上游 damageBegin num++；非铁索传导照常）
+            if d.nature == crate::event::DamageNature::Fire {
+                if let Some(src) = d.source {
+                    if ctx.core.player(src).alive
+                        && ctx
+                            .core
+                            .player(src)
+                            .equips
+                            .iter()
+                            .any(|c| ctx.catalog.card_kind(*c) == CardKind::Chilongya)
+                    {
+                        amount += 1;
+                    }
+                }
+            }
+            // 星君眼（U05 swd 第九批，规则 v93）：锁定——你的【杀】伤害 +1
+            //（上游 damageBegin num++；card==sha 同口径；铁索传导为独立事件
+            // 照常 +1）
+            if d.card
+                .map(|c| ctx.catalog.card_kind(c) == CardKind::Sha)
+                .unwrap_or(false)
+            {
+                if let Some(src) = d.source {
+                    if ctx.core.player(src).alive
+                        && ctx
+                            .core
+                            .player(src)
+                            .equips
+                            .iter()
+                            .any(|c| ctx.catalog.card_kind(*c) == CardKind::Xingjunyan)
+                    {
+                        amount += 1;
+                    }
+                }
+            }
+            // 链钩（U05 ow 路霸，规则 v128）：本回合被钩者首次受伤害 +1
+            //（上游 liangou2 damageBegin trigger.num++ usable:1 同口径；来源
+            // 不限=上游无 source 条件；仅路霸出牌阶段可钩住，换回合解除）
+            if let Some(t) = ctx.core.turn.liangou_hook {
+                if d.target == t && !ctx.core.turn.liangou_bonus_used {
+                    amount += 1;
+                    ctx.core.turn.liangou_bonus_used = true;
+                }
+            }
+            // 飞刃（U05 ow 源氏，规则 v129）：锁定——你的黑桃杀伤害 +1（非
+            // 铁索传导；上游 damageBegin trigger.num++ notLink 同口径；花色按
+            // 实体牌——火/雷杀为黑桃时同样命中）
+            if d.card
+                .map(|c| {
+                    ctx.catalog.card_kind(c).is_sha_like()
+                        && ctx.catalog.cards[c as usize].suit == crate::catalog::Suit::Spade
+                })
+                .unwrap_or(false)
+                && !d.from_chain
+            {
+                if let Some(src) = d.source {
+                    let has_feiren = ctx
+                        .catalog
+                        .skill_by_name(crate::vocabulary::host::WUDIAN_FEIREN_KEY)
+                        .map(|def| ctx.core.has_skill(src, def))
+                        .unwrap_or(false);
+                    if has_feiren && ctx.core.player(src).alive {
+                        amount += 1;
+                    }
+                }
+            }
+            // 刺猬（U07 玩点论杀韩龙，规则 v111）：锁定——你的杀对满血目标伤
+            // 害 +1；加后 ≥ 目标体力则目标获本回合濒死即死标记（上游
+            // addTempSkill("ciqiu_dying")）且本技能移除（一次性）
+            if d.card
+                .map(|c| ctx.catalog.card_kind(c) == CardKind::Sha)
+                .unwrap_or(false)
+            {
+                if let Some(src) = d.source {
+                    if ctx.core.player(d.target).alive
+                        && ctx.core.player(d.target).hp == ctx.core.player(d.target).max_hp as i32
+                    {
+                        if let Some(def) = ctx
+                            .catalog
+                            .skill_by_name(crate::vocabulary::host::WUDIAN_CIQIU_KEY)
+                        {
+                            if ctx.core.has_skill(src, def) {
+                                amount += 1;
+                                if amount >= i64::from(ctx.core.player(d.target).hp) {
+                                    ctx.core.turn.ciqiu_dying.push(d.target);
+                                    ctx.core.skills.remove(&(src, def));
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+            // 毒瘟（U07 ow，规则 v122）：锁定——造成伤害时若你手牌数与受伤害
+            // 角色相等，伤害 +1（上游 duwen damageBegin num++ 同口径；铁索传
+            // 导为独立事件照常判定）
+            if let Some(src) = d.source {
+                if ctx.core.player(src).alive
+                    && ctx.core.player(src).hand.len() == ctx.core.player(d.target).hand.len()
+                {
+                    if let Some(def) = ctx
+                        .catalog
+                        .skill_by_name(crate::vocabulary::host::WUDIAN_DUWEN_KEY)
+                    {
+                        if ctx.core.has_skill(src, def) {
+                            amount += 1;
+                        }
+                    }
+                }
+            }
+            // 脉轮（swd 批 137，规则 v316）：3=首次造成/受到伤害 -1、4=+1（各自
+            // 一次性；上游 mailun31/32/41/42 damageBegin 用后移除同口径）
+            {
+                if let Some(src) = d.source {
+                    let mode = ctx.core.player(src).mailun_mode;
+                    if (mode == 3 || mode == 4) && !ctx.core.player(src).mailun_out_used {
+                        amount = if mode == 3 {
+                            amount.saturating_sub(1)
+                        } else {
+                            amount.saturating_add(1)
+                        };
+                        ctx.core.player_mut(src).mailun_out_used = true;
+                    }
+                }
+                let mode = ctx.core.player(d.target).mailun_mode;
+                if (mode == 3 || mode == 4) && !ctx.core.player(d.target).mailun_in_used {
+                    amount = if mode == 3 {
+                        amount.saturating_sub(1)
+                    } else {
+                        amount.saturating_add(1)
+                    };
+                    ctx.core.player_mut(d.target).mailun_in_used = true;
+                }
+            }
+            // 护天护体（swd 批 131，规则 v314）：目标寄存护天牌时伤害以「体力降至
+            // 寄存数」为上限（上游 hutian2 damageBegin priority -55 `trigger.num =
+            // hp - storage.hutian2.length` 同口径）
+            {
+                let hold = ctx.core.player(d.target).hutian_hold.len() as i32;
+                if hold > 0 {
+                    let hp = ctx.core.player(d.target).hp;
+                    let cap = hp - hold;
+                    if i64::from(cap) < amount {
+                        amount = i64::from(cap.max(0));
+                    }
+                }
+            }
+        }
+        Window::Begin1 => {
+            // 火神（Boss 周瑜，规则 v263）：锁定——火属性伤害对你无效，你回复
+            // 1 点体力（上游 damageBegin1 cancel+recover() 无参=1 同口径；置于
+            // 招祸同位=damageBegin 层，取消后增幅不结算）
+            if d.nature == crate::event::DamageNature::Fire {
+                if let Some(hsdef) = ctx
+                    .catalog
+                    .skill_by_name(crate::vocabulary::names::BOSS_HUOSHEN)
+                {
+                    if ctx.core.player(d.target).alive && ctx.core.has_skill(d.target, hsdef) {
+                        ctx.log(LogEvent::DamagePrevented { target: d.target });
+                        finish_damage(ctx, root, d.clone(), crate::event::DamageOutcome::Cancelled);
+                        ctx.recover(d.target, 1, None);
+                        return;
+                    }
+                }
+            }
+
+            // 拟态（Boss 梼杌，规则 v217）：锁定——你于回合外受到的火属性伤害
+            // +1（上游 boss_nitai_out damageBegin1 num++ 同口径）
+            if d.nature == crate::event::DamageNature::Fire {
+                if let Some(ndef) = ctx
+                    .catalog
+                    .skill_by_name(crate::vocabulary::names::BOSS_NITAI)
+                {
+                    if ctx.core.has_skill(d.target, ndef) && ctx.core.turn.current != d.target {
+                        amount += 1;
+                    }
+                }
+            }
+            // 回合伤害统计（U05 xianjian 明绣，规则 v160 灵火门控）：来源本回
+            // 合已造成伤害 +实际量（护甲/机甲吸收后；上游 getStat("damage") 按
+            // 醉酒（Boss 白无常，规则 v255）：你使用的【杀】造成的伤害 +1（上
+            // 游 damageBegin1 sha+shaParent 同口径；火杀/雷杀同属 sha 族）
+            if d.card
+                .map(|c| {
+                    matches!(
+                        ctx.catalog.card_kind(c),
+                        CardKind::Sha | CardKind::FireSha | CardKind::LeiSha
+                    )
+                })
+                .unwrap_or(false)
+            {
+                if let Some(zjdef) = ctx
+                    .catalog
+                    .skill_by_name(crate::vocabulary::names::BOSS_ZUIJIU)
+                {
+                    if let Some(src) = d.source {
+                        if ctx.core.has_skill(src, zjdef) {
+                            amount += 1;
+                        }
+                    }
+                }
+            }
+        }
+        Window::Begin4 => {
+            // 招祸（Boss 毕方，规则 v227）：锁定——你免疫所有火属性伤害（上游
+            // boss_zhaohuo damageBegin4 trigger.cancel 的火伤分支同口径；诚信免
+            // 伤同位）
+            if d.nature == crate::event::DamageNature::Fire {
+                if let Some(zdef) = ctx
+                    .catalog
+                    .skill_by_name(crate::vocabulary::names::BOSS_ZHAOHUO)
+                {
+                    if ctx.core.has_skill(d.target, zdef) {
+                        ctx.log(LogEvent::DamagePrevented { target: d.target });
+                        finish_damage(ctx, root, d, crate::event::DamageOutcome::Cancelled);
+                        return;
+                    }
+                }
+            }
+            // 拟态（Boss 梼杌，规则 v217）：锁定——防止你于回合内受到的伤害
+            //（上游 boss_nitai_in damageBegin4 trigger.cancel 同口径：当前回合
+            // =持有者）
+            if let Some(ndef) = ctx
+                .catalog
+                .skill_by_name(crate::vocabulary::names::BOSS_NITAI)
+            {
+                if ctx.core.has_skill(d.target, ndef) && ctx.core.turn.current == d.target {
+                    ctx.log(LogEvent::DamagePrevented { target: d.target });
+                    finish_damage(ctx, root, d, crate::event::DamageOutcome::Cancelled);
+                    return;
+                }
+            }
+            // 灵渠（Boss 玄武，规则 v237）：受到的大于 1 点伤害视为 0 点（上游
+            // 不佛（Boss 地藏王，规则 v274）：受到大于 1 点的伤害时改为其中 1
+            // 点（上游 boss_bufo damageBegin4 num>1→num-1 同口径；置于灵渠归零
+            // 检查前——灵渠读调整后终值；两技同持为不同武将不共存，序未登记）
+            if amount > 1 {
+                if let Some(bfdef) = ctx
+                    .catalog
+                    .skill_by_name(crate::vocabulary::names::BOSS_BUFO)
+                {
+                    if ctx.core.has_skill(d.target, bfdef) {
+                        amount -= 1;
+                    }
+                }
+            }
+            // boss_lingqu cancel damageBegin4 num>1 → num=0 同口径；置于增幅后
+            // 统计前——终值>1 才归零；随后 Zero/Stopped 不派普通 damageEnd。）
+            if amount > 1 {
+                if let Some(ldef) = ctx
+                    .catalog
+                    .skill_by_name(crate::vocabulary::names::BOSS_LINGQU)
+                {
+                    if ctx.core.has_skill(d.target, ldef) {
+                        amount = 0;
+                    }
+                }
+            }
+        }
+        _ => return,
+    }
+    let Ok(amount) = i32::try_from(amount) else {
+        ctx.res.fault = Some(crate::machine::VmFault {
+            skill: "intrinsic_damage".into(),
+            owner: d.target,
+            event: "Damage".into(),
+            kind: "DamageAmountOverflow".into(),
+            detail: "canonical source amount exceeds i32".into(),
+        });
+        return;
+    };
+    d.amount = amount;
+    ctx.res.frame_mut(root).unwrap().data = EventData::Damage(d);
+}
diff --git a/crates/engine-native-kernel/src/resolution/trigger_order.rs b/crates/engine-native-kernel/src/resolution/trigger_order.rs
new file mode 100644
index 00000000..75e0e574
--- /dev/null
+++ b/crates/engine-native-kernel/src/resolution/trigger_order.rs
@@ -0,0 +1,744 @@
+//! One recoverable window over Frame.queue, including automatic and interactive dispatch.
+use super::*;
+use crate::catalog::Catalog;
+use crate::choice::{ChoiceKind, ChoiceSpec};
+use crate::snap::{MachineSnapshot, ResolutionSnapshot, SnapshotError};
+use std::cmp::Ordering;
+
+pub(super) fn compare(a: &QueuedTrigger, b: &QueuedTrigger) -> Ordering {
+    a.order
+        .0
+        .cmp(&b.order.0)
+        .then_with(|| {
+            if a.order.0 == 1 {
+                a.order
+                    .3
+                    .cmp(&b.order.3)
+                    .then_with(|| b.order.1.cmp(&a.order.1))
+            } else {
+                b.order
+                    .1
+                    .cmp(&a.order.1)
+                    .then_with(|| a.order.3.cmp(&b.order.3))
+            }
+        })
+        .then_with(|| a.def.cmp(&b.def))
+}
+fn bucket(q: &QueuedTrigger, seats: usize) -> u16 {
+    match q.order.0 {
+        0 => 0,
+        1 => u16::from(q.order.3) + 1,
+        _ => seats as u16 + 1,
+    }
+}
+pub(crate) fn event_kind(frame: &Frame) -> EventKind {
+    if frame.stage == Stage::BeforeTriggers && frame.kind == EventKind::Damage {
+        EventKind::DamageBefore
+    } else {
+        frame.kind
+    }
+}
+fn subscribes(catalog: &Catalog, def: SkillDefId, frame: &Frame) -> bool {
+    let Some(def) = catalog.skills.get(def as usize) else {
+        return false;
+    };
+    let Some(meta) = &def.trigger else {
+        return false;
+    };
+    let kind = event_kind(frame);
+    (meta.event == kind || meta.extra_events.contains(&kind))
+        && (kind != EventKind::PhaseBegin
+            || def.behavior.is_vm_skill() == (frame.stage == Stage::BeforeTriggers))
+}
+pub(super) fn eligible(
+    core: &GameStateCore,
+    catalog: &Catalog,
+    q: &QueuedTrigger,
+    event: &EventData,
+    kind: EventKind,
+) -> bool {
+    if let EventData::Damage(d) = event {
+        let terminal = matches!(
+            (kind, d.settlement.outcome),
+            (EventKind::DamageZero, crate::event::DamageOutcome::Zero)
+                | (
+                    EventKind::DamageCancelled,
+                    crate::event::DamageOutcome::Cancelled
+                )
+        );
+        if d.settlement.notrigger {
+            return false;
+        }
+        if !terminal
+            && (d.amount <= 0
+                || d.prevented
+                || d.settlement.notrigger
+                || d.settlement.outcome != crate::event::DamageOutcome::Running)
+        {
+            return false;
+        }
+    }
+    if matches!(event, EventData::Death { player, .. } if core.player(*player).death_cancelled) {
+        return false;
+    }
+    let Some(inst) = core.skills.get(&(q.owner, q.def)) else {
+        return false;
+    };
+    let Some(def) = catalog.skills.get(q.def as usize) else {
+        return false;
+    };
+    let Some(meta) = &def.trigger else {
+        return false;
+    };
+    inst.enabled
+        && core.player(q.owner).alive
+        && (!def.limits.once_per_turn || !inst.once_used)
+        && (meta.event == kind || meta.extra_events.contains(&kind))
+        && def.behavior.filter_in_window(
+            &QueryCtx {
+                state: core,
+                catalog,
+            },
+            q.owner,
+            event,
+            kind,
+        )
+}
+fn group(
+    core: &GameStateCore,
+    frames: &[Frame],
+    frame: &Frame,
+    catalog: &Catalog,
+    cursor: u16,
+    seats: usize,
+) -> Vec<QueuedTrigger> {
+    let mut available = frame.queue.iter().filter(|q| {
+        bucket(q, seats) == cursor
+            && eligible(
+                core,
+                catalog,
+                q,
+                crate::event::damage_event(frames, frame),
+                event_kind(frame),
+            )
+    });
+    let Some(first) = available.next().cloned() else {
+        return Vec::new();
+    };
+    let mut result = vec![first.clone()];
+    if first.order.0 == 1 {
+        result.extend(available.filter(|q| q.order.1 == first.order.1).cloned());
+        result.sort_by_key(|q| q.def);
+    }
+    result
+}
+
+pub struct TriggerOrder {
+    pub frame: EventId,
+    pub owner: PlayerId,
+    pub candidates: Vec<SkillDefId>,
+    pub asked: bool,
+    pub cursor: u16,
+    pub done: Vec<(PlayerId, SkillDefId)>,
+    pub owners: Vec<PlayerId>,
+    pub normal_owners: u16,
+}
+impl TriggerOrder {
+    pub(super) fn new(frame: EventId, core: &GameStateCore) -> Self {
+        let mut owners: Vec<_> = (0..core.players.len() as PlayerId).collect();
+        owners.sort_by_key(|owner| core.seat_steps_from(core.turn.current, *owner));
+        Self {
+            frame,
+            owner: 0,
+            candidates: Vec::new(),
+            asked: false,
+            cursor: 0,
+            done: Vec::new(),
+            normal_owners: owners.len() as u16,
+            owners,
+        }
+    }
+    fn start(&mut self, ctx: &mut Ctx<'_>, selected: &QueuedTrigger) {
+        self.done.push((selected.owner, selected.def));
+        start_queued_trigger(
+            ctx.core,
+            ctx.res,
+            ctx.catalog,
+            ctx.out,
+            self.frame,
+            selected.def,
+            selected.owner,
+        );
+    }
+}
+impl SkillMachine for TriggerOrder {
+    fn trigger_order(&self) -> Option<&TriggerOrder> {
+        Some(self)
+    }
+    fn trigger_order_mut(&mut self) -> Option<&mut TriggerOrder> {
+        Some(self)
+    }
+    fn fork(&self) -> Box<dyn SkillMachine> {
+        Box::new(Self {
+            frame: self.frame,
+            owner: self.owner,
+            candidates: self.candidates.clone(),
+            asked: self.asked,
+            cursor: self.cursor,
+            done: self.done.clone(),
+            owners: self.owners.clone(),
+            normal_owners: self.normal_owners,
+        })
+    }
+    fn snapshot(&self) -> MachineSnapshot {
+        MachineSnapshot::TriggerOrder {
+            frame: self.frame,
+            owner: self.owner,
+            candidates: self.candidates.clone(),
+            asked: self.asked,
+            cursor: self.cursor,
+            done: self.done.clone(),
+            owners: self.owners.clone(),
+            normal_owners: self.normal_owners,
+        }
+    }
+    fn step(&mut self, ctx: &mut Ctx<'_>) -> Flow {
+        let Some(frame) = ctx.res.frame(self.frame) else {
+            return Flow::Done;
+        };
+        let mut current = group(
+            ctx.core,
+            &ctx.res.stack,
+            frame,
+            ctx.catalog,
+            self.cursor,
+            self.normal_owners as usize,
+        );
+        if self.asked {
+            let selected = match ctx.answer().first() {
+                Some(ChoiceOption::Skill(def)) if self.candidates.contains(def) => current
+                    .iter()
+                    .find(|q| q.def == *def && q.owner == self.owner)
+                    .cloned(),
+                _ => None,
+            };
+            self.asked = false;
+            self.candidates.clear();
+            self.owner = 0;
+            if let Some(selected) = selected.filter(|_| {
+                current.iter().all(|q| {
+                    ctx.catalog.skills[q.def as usize]
+                        .trigger
+                        .as_ref()
+                        .expect("meta")
+                        .order_selectable
+                })
+            }) {
+                self.start(ctx, &selected);
+                return Flow::Yield;
+            }
+        }
+        while current.is_empty() {
+            let seats = self.normal_owners as usize;
+            ctx.res
+                .frame_mut(self.frame)
+                .expect("frame")
+                .queue
+                .retain(|q| bucket(q, seats) > self.cursor);
+            self.cursor += 1;
+            if self.cursor > seats as u16 + 1 {
+                let frame = ctx.res.frame_mut(self.frame).expect("frame");
+                frame.stage = next_stage(frame.kind, frame.stage);
+                frame.planned = false;
+                return Flow::Done;
+            }
+            current = group(
+                ctx.core,
+                &ctx.res.stack,
+                ctx.res.frame(self.frame).expect("frame"),
+                ctx.catalog,
+                self.cursor,
+                self.normal_owners as usize,
+            );
+        }
+        let first = &current[0];
+        // Retain temporarily false peers, but discard higher unavailable priorities once passed.
+        ctx.res
+            .frame_mut(self.frame)
+            .expect("frame")
+            .queue
+            .retain(|q| {
+                bucket(q, self.normal_owners as usize) != self.cursor || q.order.1 <= first.order.1
+            });
+        let automatic = if first.order.0 != 1 {
+            Some(first.clone())
+        } else {
+            current
+                .iter()
+                .find(|q| {
+                    !ctx.catalog.skills[q.def as usize]
+                        .trigger
+                        .as_ref()
+                        .expect("meta")
+                        .order_selectable
+                })
+                .cloned()
+        };
+        if let Some(selected) = automatic.or_else(|| (current.len() == 1).then(|| first.clone())) {
+            self.start(ctx, &selected);
+            return Flow::Yield;
+        }
+        self.owner = first.owner;
+        self.candidates = current.iter().map(|q| q.def).collect();
+        self.asked = true;
+        Flow::WaitChoice {
+            observer: self.owner,
+            spec: ChoiceSpec {
+                kind: ChoiceKind::PickTag,
+                prompt: "trigger_order",
+                options: self
+                    .candidates
+                    .iter()
+                    .copied()
+                    .map(ChoiceOption::Skill)
+                    .collect(),
+                min: 1,
+                max: 1,
+                allow_cancel: false,
+            },
+        }
+    }
+}
+
+/// New seats are inventory only: upstream addTrigger cannot create an absent Normal map.
+pub fn sync_trigger_owners(core: &GameStateCore, res: &mut Resolution) {
+    for park in &mut res.parks {
+        if let Some(window) = park.machine.trigger_order_mut() {
+            window
+                .owners
+                .extend((window.owners.len()..core.players.len()).map(|p| p as PlayerId));
+        }
+    }
+}
+
+/// Register a genuinely new instance in each still-open ancestor window, as upstream addTrigger does.
+pub fn register_added(
+    core: &GameStateCore,
+    res: &mut Resolution,
+    catalog: &Catalog,
+    owner: PlayerId,
+    def: SkillDefId,
+) {
+    sync_trigger_owners(core, res);
+    let Some(meta) = catalog
+        .skills
+        .get(def as usize)
+        .and_then(|d| d.trigger.as_ref())
+    else {
+        return;
+    };
+    let additions: Vec<_> = res
+        .parks
+        .iter()
+        .filter_map(|p| p.machine.trigger_order())
+        .filter_map(|m| {
+            let seat = m.owners.iter().position(|p| *p == owner)? as u8;
+            if meta.timing == Timing::Normal && usize::from(seat) >= m.normal_owners as usize {
+                return None;
+            }
+            let q = QueuedTrigger {
+                owner,
+                def,
+                order: (
+                    match meta.timing {
+                        Timing::First => 0,
+                        Timing::Normal => 1,
+                        Timing::Last => 2,
+                    },
+                    meta.priority,
+                    0,
+                    seat,
+                    def,
+                ),
+            };
+            (bucket(&q, m.normal_owners as usize) >= m.cursor && !m.done.contains(&(owner, def)))
+                .then_some((m.frame, q))
+        })
+        .collect();
+    for (frame, q) in additions {
+        let Some(f) = res.frame_mut(frame) else {
+            continue;
+        };
+        if !subscribes(catalog, def, f)
+            || f.queue
+                .iter()
+                .any(|old| old.owner == owner && old.def == def)
+        {
+            continue;
+        }
+        f.queue.push(q);
+        f.queue.sort_by(compare);
+    }
+}
+
+/// Parallel authoritative changes invalidate an outdated order ask before republishing a new id.
+pub fn refresh_order_choice(core: &GameStateCore, res: &mut Resolution, catalog: &Catalog) {
+    if !res
+        .open_choice
+        .as_ref()
+        .is_some_and(|c| c.spec.prompt == "trigger_order")
+    {
+        return;
+    }
+    let Some(index) = res
+        .parks
+        .iter()
+        .position(|p| p.machine.trigger_order().is_some_and(|m| m.asked))
+    else {
+        return;
+    };
+    let machine = res.parks[index].machine.trigger_order().expect("window");
+    let current = res
+        .frame(machine.frame)
+        .map(|f| {
+            group(
+                core,
+                &res.stack,
+                f,
+                catalog,
+                machine.cursor,
+                machine.normal_owners as usize,
+            )
+        })
+        .unwrap_or_default();
+    if current
+        .iter()
+        .map(|q| q.def)
+        .eq(machine.candidates.iter().copied())
+        && current.iter().all(|q| {
+            q.owner == machine.owner
+                && catalog.skills[q.def as usize]
+                    .trigger
+                    .as_ref()
+                    .is_some_and(|m| m.order_selectable)
+        })
+    {
+        return;
+    }
+    let machine = res.parks[index]
+        .machine
+        .trigger_order_mut()
+        .expect("window");
+    machine.asked = false;
+    machine.candidates.clear();
+    machine.owner = 0;
+    res.open_choice = None;
+}
+
+/// Check window, queue, and choice bindings against the same frozen catalog, including checkpoints.
+pub fn validate_trigger_bindings(
+    res: &ResolutionSnapshot,
+    core: &GameStateCore,
+    catalog: &Catalog,
+) -> Result<(), SnapshotError> {
+    let bad = || SnapshotError::BadTag("trigger_order_binding", 0);
+    for (depth, frame) in res.stack.iter().enumerate() {
+        let windows: Vec<_> = res
+            .parks
+            .iter()
+            .filter_map(|park| match &park.machine {
+                MachineSnapshot::TriggerOrder {
+                    frame: id, owners, ..
+                } if *id == frame.id => Some((park, owners)),
+                _ => None,
+            })
+            .collect();
+        let needs_window =
+            frame.planned && matches!(frame.stage, Stage::BeforeTriggers | Stage::AfterTriggers);
+        if windows.len() != usize::from(needs_window) {
+            return Err(bad());
+        }
+        if windows
+            .first()
+            .is_some_and(|(park, _)| park.resume_depth != depth + 1)
+        {
+            return Err(bad());
+        }
+        let mut seen = std::collections::BTreeSet::new();
+        for q in &frame.queue {
+            let meta = catalog
+                .skills
+                .get(q.def as usize)
+                .and_then(|d| d.trigger.as_ref())
+                .ok_or_else(bad)?;
+            let expected = (
+                match meta.timing {
+                    Timing::First => 0,
+                    Timing::Normal => 1,
+                    Timing::Last => 2,
+                },
+                meta.priority,
+                0,
+                windows
+                    .first()
+                    .and_then(|(_, owners)| owners.iter().position(|p| *p == q.owner))
+                    .ok_or_else(bad)? as u8,
+                q.def,
+            );
+            if windows.first().is_some_and(|(park, _)| matches!(&park.machine, MachineSnapshot::TriggerOrder { normal_owners, .. } if q.order.0 == 1 && u16::from(q.order.3) >= *normal_owners))
+                || q.order != expected
+                || !seen.insert((q.owner, q.def))
+                || !subscribes(catalog, q.def, frame)
+            {
+                return Err(bad());
+            }
+        }
+        if frame
+            .queue
+            .windows(2)
+            .any(|qs| compare(&qs[0], &qs[1]) == Ordering::Greater)
+        {
+            return Err(bad());
+        }
+    }
+    for park in &res.parks {
+        if requires_trigger_frame(&park.machine, catalog) {
+            let Slot::Trigger { frame } = park.slot else {
+                return Err(bad());
+            };
+            let (depth, frame) = res
+                .stack
+                .iter()
+                .enumerate()
+                .find(|(_, f)| f.id == frame && frame != NO_FRAME)
+                .ok_or_else(bad)?;
+            if park.resume_depth != depth + 1 {
+                return Err(bad());
+            }
+            validate_vm_window(&park.machine, frame, catalog)?;
+        } else if let Slot::Trigger { frame } = park.slot {
+            if frame != NO_FRAME {
+                let frame = res.stack.iter().find(|f| f.id == frame).ok_or_else(bad)?;
+                validate_vm_window(&park.machine, frame, catalog)?;
+            }
+        }
+        if !matches!(park.machine, MachineSnapshot::TriggerOrder { .. })
+            && contains_window(&park.machine)
+        {
+            return Err(bad());
+        }
+        if let MachineSnapshot::OptionalGate {
+            owner,
+            def,
+            event,
+            inner: None,
+            ..
+        } = &park.machine
+        {
+            let id = match park.slot {
+                Slot::Trigger { frame } => frame,
+                _ => return Err(bad()),
+            };
+            let frame = if id == NO_FRAME {
+                park.resume_depth
+                    .checked_sub(1)
+                    .and_then(|i| res.stack.get(i))
+            } else {
+                res.stack.iter().find(|f| f.id == id)
+            }
+            .ok_or_else(bad)?;
+            let q = QueuedTrigger {
+                owner: *owner,
+                def: *def,
+                order: (0, 0, 0, 0, *def),
+            };
+            if *event != frame.data
+                || !eligible(
+                    core,
+                    catalog,
+                    &q,
+                    crate::event::damage_event(&res.stack, frame),
+                    event_kind(frame),
+                )
+            {
+                return Err(bad());
+            }
+        }
+        if let MachineSnapshot::TriggerOrder {
+            frame,
+            owner,
+            candidates,
+            asked,
+            cursor,
+            done,
+            owners,
+            normal_owners,
+        } = &park.machine
+        {
+            let f = res.stack.iter().find(|f| f.id == *frame).ok_or_else(bad)?;
+            let mut seen = std::collections::BTreeSet::new();
+            let mut player_ids = std::collections::BTreeSet::new();
+            if owners.len() != core.players.len()
+                || *normal_owners == 0
+                || *normal_owners as usize > owners.len()
+                || owners[..*normal_owners as usize]
+                    .iter()
+                    .any(|pid| u16::from(*pid) >= *normal_owners)
+                || !owners[*normal_owners as usize..]
+                    .iter()
+                    .copied()
+                    .eq((*normal_owners as usize..core.players.len()).map(|p| p as PlayerId))
+                || owners
+                    .iter()
+                    .any(|pid| *pid as usize >= core.players.len() || !player_ids.insert(*pid))
+            {
+                return Err(bad());
+            }
+            if park.slot != (Slot::Trigger { frame: *frame })
+                || !f.planned
+                || !matches!(f.stage, Stage::BeforeTriggers | Stage::AfterTriggers)
+                || *cursor > *normal_owners + 1
+                || done
+                    .iter()
+                    .any(|key| !seen.insert(*key) || !subscribes(catalog, key.1, f))
+                || f.queue.iter().any(|q| {
+                    bucket(q, *normal_owners as usize) < *cursor || seen.contains(&(q.owner, q.def))
+                })
+            {
+                return Err(bad());
+            }
+            if *asked {
+                let qs = group(
+                    core,
+                    &res.stack,
+                    f,
+                    catalog,
+                    *cursor,
+                    *normal_owners as usize,
+                );
+                let Some(open) = &res.open_choice else {
+                    return Err(bad());
+                };
+                if park.resume_depth != res.stack.len()
+                    || res.stack.last().map(|f| f.id) != Some(*frame)
+                    || qs.len() < 2
+                    || qs.iter().any(|q| {
+                        q.owner != *owner
+                            || q.order.0 != 1
+                            || !catalog.skills[q.def as usize]
+                                .trigger
+                                .as_ref()
+                                .expect("meta")
+                                .order_selectable
+                    })
+                    || *candidates != qs.iter().map(|q| q.def).collect::<Vec<_>>()
+                    || open.observer != *owner
+                    || open.spec.prompt != "trigger_order"
+                    || open.spec.kind != ChoiceKind::PickTag
+                    || open.spec.min != 1
+                    || open.spec.max != 1
+                    || open.spec.allow_cancel
+                    || open.spec.options
+                        != candidates
+                            .iter()
+                            .copied()
+                            .map(ChoiceOption::Skill)
+                            .collect::<Vec<_>>()
+                {
+                    return Err(bad());
+                }
+            } else if !candidates.is_empty() || *owner != 0 {
+                return Err(bad());
+            }
+        }
+    }
+    Ok(())
+}
+
+fn contains_window(machine: &MachineSnapshot) -> bool {
+    match machine {
+        MachineSnapshot::TriggerOrder { .. } => true,
+        MachineSnapshot::OptionalGate { inner, .. }
+        | MachineSnapshot::Aoe { inner, .. }
+        | MachineSnapshot::Chain { inner, .. }
+        | MachineSnapshot::Jijiang { inner, .. }
+        | MachineSnapshot::LiJian { inner, .. }
+        | MachineSnapshot::NullifyWindow { effect: inner, .. } => {
+            inner.as_deref().is_some_and(contains_window)
+        }
+        MachineSnapshot::Rvm { following, .. } => following.iter().any(contains_window),
+        _ => false,
+    }
+}
+
+// A module already identifies a handler; only the owning frame decides its before/after window.
+fn validate_vm_window(
+    machine: &MachineSnapshot,
+    frame: &Frame,
+    catalog: &Catalog,
+) -> Result<(), SnapshotError> {
+    match machine {
+        MachineSnapshot::Rvm {
+            module,
+            skill_name,
+            event,
+            following,
+            ..
+        } => {
+            let def = catalog
+                .skill_by_name(skill_name)
+                .ok_or(SnapshotError::UnknownMachine)?;
+            let behavior = &catalog.skills[def as usize].behavior;
+            let data_kind = if matches!(frame.data, EventData::DamageWindow { .. }) {
+                EventKind::Damage
+            } else {
+                frame.data.kind()
+            };
+            if event.kind() != data_kind
+                || !behavior.vm_trigger_window_is_authorized(module, event_kind(frame))
+            {
+                return Err(SnapshotError::UnknownMachine);
+            }
+            for next in following {
+                validate_vm_window(next, frame, catalog)?;
+            }
+        }
+        MachineSnapshot::OptionalGate { inner, .. }
+        | MachineSnapshot::Aoe { inner, .. }
+        | MachineSnapshot::Chain { inner, .. }
+        | MachineSnapshot::Jijiang { inner, .. }
+        | MachineSnapshot::LiJian { inner, .. }
+        | MachineSnapshot::NullifyWindow { effect: inner, .. } => {
+            if let Some(inner) = inner {
+                validate_vm_window(inner, frame, catalog)?;
+            }
+        }
+        _ => {}
+    }
+    Ok(())
+}
+
+fn requires_trigger_frame(machine: &MachineSnapshot, catalog: &Catalog) -> bool {
+    match machine {
+        MachineSnapshot::Rvm {
+            module,
+            skill_name,
+            following,
+            ..
+        } => {
+            catalog.skill_by_name(skill_name).is_some_and(|def| {
+                let def = &catalog.skills[def as usize];
+                def.trigger.is_some() && def.behavior.vm_module_requires_trigger_frame(module)
+            }) || following.iter().any(|m| requires_trigger_frame(m, catalog))
+        }
+        MachineSnapshot::OptionalGate { inner, .. }
+        | MachineSnapshot::Aoe { inner, .. }
+        | MachineSnapshot::Chain { inner, .. }
+        | MachineSnapshot::Jijiang { inner, .. }
+        | MachineSnapshot::LiJian { inner, .. }
+        | MachineSnapshot::NullifyWindow { effect: inner, .. } => inner
+            .as_deref()
+            .is_some_and(|m| requires_trigger_frame(m, catalog)),
+        _ => false,
+    }
+}
diff --git a/crates/engine-native-kernel/src/rvm_bridge/identity.rs b/crates/engine-native-kernel/src/rvm_bridge/identity.rs
new file mode 100644
index 00000000..dd7cac3f
--- /dev/null
+++ b/crates/engine-native-kernel/src/rvm_bridge/identity.rs
@@ -0,0 +1,65 @@
+//! Semantic identity for direct native extension declarations (without an npack manifest).
+use super::*;
+
+fn bytes(h: &mut blake3::Hasher, value: &[u8]) {
+    h.update(&(value.len() as u64).to_le_bytes());
+    h.update(value);
+}
+fn program(h: &mut blake3::Hasher, p: &VmSkillProgram) {
+    bytes(h, p.skill_name.as_bytes());
+    bytes(h, &p.module.to_bytes());
+}
+/// Encode the complete trigger tuple with fixed-width, portable fields.
+pub fn hash_trigger_meta(h: &mut blake3::Hasher, meta: &crate::catalog::TriggerMeta) {
+    h.update(&[meta.event as u8, match meta.timing { crate::event::Timing::First => 0, crate::event::Timing::Normal => 1, crate::event::Timing::Last => 2 }]);
+    h.update(&meta.priority.to_le_bytes());
+    h.update(&[u8::from(meta.order_selectable), u8::from(meta.optional)]);
+    h.update(&(meta.extra_events.len() as u64).to_le_bytes());
+    for event in &meta.extra_events { h.update(&[*event as u8]); }
+}
+impl VmFilterPolicy {
+    /// Hash all rule-visible policy and handler identity fields, retaining declaration order.
+    pub fn hash_semantics(&self, h: &mut blake3::Hasher) {
+        use VmFilterPolicy::*;
+        let tag = match self {
+            OwnerIsTarget => 0, OwnerAlive => 1, OwnerIsSource => 2,
+            OwnerAliveGaveCardsToOtherAlive => 3, Always => 4, OwnerWounded => 5,
+            OwnerLinked => 6, OwnerHandNonempty => 7, OwnerHandEmpty => 8,
+            OwnerNoTurnDamage => 9, OwnerSkippedPhasePositive => 10, OwnerTurnDamage => 11,
+            OwnerHandBelowMaxHp => 12, OwnerHandAboveHp => 13, OwnerHandAtLeastHp => 14,
+            OwnerOtherHandNonempty => 15, OwnerTurnDamageAtLeastThree => 16,
+            OwnerHandAtLeastHpOtherAlive => 17, OwnerPlayPhaseBteUsed => 18,
+            OwnerAlivePlayPhaseBteUsed => 19, OwnerHpBelow(_) => 20, OwnerPlayCountEq(_) => 21,
+            OwnerPlayCountEqHp => 22, OwnerCardUsedAtLeastHp => 23,
+            OwnerHandEmptyElementalOrTrickDamageBefore => 24, OwnerSourceMovableFieldCard => 25,
+            OwnerTiedMaxHand => 26, OwnerTiedMaxHp => 27, OwnerTiedMaxEquipNonempty => 28,
+            OwnerNotUniqueMaxHp => 29, OwnerTargetedByOtherSha => 30, Named(_) => 31,
+            OwnerSourceSha => 32, OwnerSourceFireSha => 33, OwnerSourceOrdinaryTrick => 34,
+            OwnerAliveNotEventPlayer => 35, OwnerTargetSourceAlive => 36,
+            OwnerSourceOrTarget => 37, OwnerTargetOtherSourceAlive => 38,
+            OwnerSourceTargetMarkPositive(_) => 39, AtPhase { .. } => 40,
+            Declared { .. } => 41, Handlers(_) => 42,
+        };
+        h.update(&[tag]);
+        match self {
+            OwnerHpBelow(n) | OwnerPlayCountEq(n) | OwnerSourceTargetMarkPositive(n) => { h.update(&n.to_le_bytes()); }
+            AtPhase { phase, inner } => { h.update(&[*phase as u8]); inner.hash_semantics(h); }
+            Declared { skill_def_id, hand_limit_base_max_hp, inner } => {
+                h.update(&skill_def_id.to_le_bytes()); h.update(&[u8::from(*hand_limit_base_max_hp)]); inner.hash_semantics(h);
+            }
+            Named(p) => p.hash_semantics(h),
+            Handlers(set) => {
+                h.update(&set.skill_def_id.to_le_bytes());
+                h.update(&[u8::from(set.active.is_some())]);
+                if let Some(active) = &set.active { program(h, active); }
+                let l = &set.limits;
+                h.update(&[u8::from(l.once_per_turn), u8::from(l.once_per_play_phase), u8::from(l.hand_nonempty), u8::from(l.equip_nonempty), u8::from(l.hand_gt_hp), u8::from(l.hand_gt_max_hp), u8::from(l.face_up), u8::from(l.owner_unlinked)]);
+                h.update(&[u8::from(l.mark_at_least.is_some())]);
+                if let Some((mark, count)) = l.mark_at_least { h.update(&mark.to_le_bytes()); h.update(&count.to_le_bytes()); }
+                h.update(&(set.triggers.len() as u64).to_le_bytes());
+                for trigger in &set.triggers { program(h, &trigger.program); hash_trigger_meta(h, &trigger.meta); trigger.filter.hash_semantics(h); }
+            }
+            _ => {}
+        }
+    }
+}
