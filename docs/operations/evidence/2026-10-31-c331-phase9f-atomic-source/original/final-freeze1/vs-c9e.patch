diff --git a/crates/engine-native-kernel/src/event/damage.rs b/crates/engine-native-kernel/src/event/damage.rs
index 5f6dcf11..8af2aae9 100644
--- a/crates/engine-native-kernel/src/event/damage.rs
+++ b/crates/engine-native-kernel/src/event/damage.rs
@@ -233,3 +233,44 @@ impl DamageProgress {
         })
     }
 }
+
+/// Effective damage-card meaning through the real immediate propagation lineage.
+pub fn damage_card_kind(
+    frames: &[Frame],
+    root: &Frame,
+    catalog: &crate::catalog::Catalog,
+) -> Option<crate::catalog::CardKind> {
+    let EventData::Damage(original) = &root.data else {
+        return None;
+    };
+    let card = original.card?;
+    let mut current = root;
+    for _ in 0..frames.len() {
+        let EventData::Damage(d) = &current.data else {
+            return None;
+        };
+        if d.card != Some(card) {
+            return None;
+        }
+        let index = frames.iter().position(|f| f.id == current.id)?;
+        let parent = index
+            .checked_sub(1)
+            .and_then(|i| frames.get(i))
+            .filter(|p| current.parent == Some(p.id));
+        if !d.from_chain {
+            return Some(match parent.map(|p| &p.data) {
+                Some(EventData::CardUsed(u)) if u.card == card => {
+                    u.use_as.unwrap_or_else(|| catalog.card_kind(card))
+                }
+                _ => catalog.card_kind(card),
+            });
+        }
+        let parent = parent?;
+        if !matches!(&parent.data,EventData::Damage(p)if p.card==Some(card)&&parent.stage==Stage::Intrinsic&&matches!(p.settlement.progress,DamageProgress::Chain{..}))
+        {
+            return None;
+        }
+        current = parent;
+    }
+    None
+}
