+        ..
+    } = window_machine(&mut snapshot.resolution.parks.last_mut().unwrap().machine)
+    else {
+        panic!("judge")
+    };
+    current.judge_card = current.gaiming_cards.as_ref().unwrap()[1];
+    assert!(matches!(
+        restore_bytes(&fixture, &snapshot),
