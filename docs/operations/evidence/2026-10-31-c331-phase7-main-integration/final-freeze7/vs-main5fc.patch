+                    Atom::CardDiamond => { h.update(&37u16.to_le_bytes()); }
+                    Atom::CardJiu => { h.update(&38u16.to_le_bytes()); }
+                    Atom::CardShan => { h.update(&39u16.to_le_bytes()); }
+                    Atom::CardNanman => { h.update(&40u16.to_le_bytes()); }
