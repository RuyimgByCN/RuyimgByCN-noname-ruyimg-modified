+//! Serialized native execution of the existing frontend Worker request semantics.
+use crate::native_envelope::envelope;
+use engine_native_wasm::{validate_pack_json, NativeSession, MAX_ARCHIVE_HEX_CHARS};
+use serde::Deserialize;
+use serde_json::{json, Value};
+use std::sync::{
+    atomic::{AtomicBool, Ordering},
+    mpsc::{sync_channel, Receiver, SyncSender},
+    Arc, Mutex,
+};
+use tokio::sync::oneshot;
+
+const MAX_PACK_JSON_BYTES: usize = 64 * 1024 * 1024;
+const MAX_SAFE_INTEGER: u64 = 9_007_199_254_740_991;
+type Job = (Value, oneshot::Sender<Value>);
+
+/// One bounded queue and one owner thread; engine objects never cross the IPC thread boundary.
+pub struct NativeEngineHost {
+    sender: Mutex<Option<SyncSender<Job>>>,
+    closed: Arc<AtomicBool>,
+}
+
+impl NativeEngineHost {
+    /// Start an engine owner without blocking the WebView or requiring an engine to be Send.
+    pub fn new() -> Result<Self, String> {
+        let (sender, receiver) = sync_channel::<Job>(8);
+        let closed = Arc::new(AtomicBool::new(false));
+        let owner_closed = closed.clone();
+        std::thread::Builder::new()
+            .name("desktop-engine".into())
+            .spawn(move || {
+                let mut host = HostSession::default();
+                run_requests(receiver, &owner_closed, |request| host.dispatch(request));
+            })
+            .map_err(|error| error.to_string())?;
+        Ok(Self {
+            sender: Mutex::new(Some(sender)),
+            closed,
+        })
+    }
+
+    /// Close the queue; an in-flight command can still complete and must not be retried implicitly.
+    pub fn close(&self) {
+        self.closed.store(true, Ordering::Release);
+        if let Ok(mut sender) = self.sender.lock() {
+            sender.take();
+        }
+    }
+
+    /// Submit a WorkerRequest and asynchronously receive its WorkerResponse.
+    /// Queue saturation rejects before enqueue; channel loss reports an unknown operation result.
+    pub async fn request(&self, request: Value) -> Result<Value, String> {
+        validate_payload_size(&request)?;
+        let (sender_response, receiver) = oneshot::channel();
+        {
+            let sender = self
+                .sender
+                .lock()
+                .map_err(|_| "native engine queue poisoned")?;
+            sender
+                .as_ref()
+                .ok_or("native engine closed; request was not submitted")?
+                .try_send((request, sender_response))
+                .map_err(|error| match error {
+                    std::sync::mpsc::TrySendError::Full(_) => {
+                        "native engine busy; request was not submitted".to_string()
+                    }
+                    std::sync::mpsc::TrySendError::Disconnected(_) => {
+                        "native engine unavailable; request was not submitted".to_string()
+                    }
+                })?;
+        }
+        receiver.await.map_err(|_| {
+            "native engine stopped; operation result unknown; inspect the current match".to_string()
+        })
+    }
+}
+
+fn run_requests(
+    receiver: Receiver<Job>,
+    closed: &AtomicBool,
+    mut dispatch: impl FnMut(Value) -> Result<Value, String>,
+) {
+    for (request, response) in receiver {
+        let id = request.get("id").cloned().unwrap_or(Value::Null);
+        let result = if closed.load(Ordering::Acquire) {
+            Err("native engine closed before execution; request was not submitted".into())
+        } else {
+            dispatch(request)
+        };
+        let reply = match result {
+            Ok(data) => json!({"id": id, "ok": true, "data": data}),
+            Err(error) => json!({"id": id, "ok": false, "error": error}),
+        };
+        // A disconnected caller cannot undo an operation already submitted.
+        let _ = response.send(reply);
+    }
+}
+
+fn validate_payload_size(value: &Value) -> Result<(), String> {
+    for (field, limit) in [
+        ("hex", MAX_ARCHIVE_HEX_CHARS),
+        ("packsJson", MAX_PACK_JSON_BYTES),
+        ("packJson", MAX_PACK_JSON_BYTES),
+        ("json", MAX_PACK_JSON_BYTES),
+    ] {
+        if value[field].as_str().is_some_and(|text| text.len() > limit) {
+            return Err(format!("native: {field} exceeds {limit} bytes"));
+        }
+    }
+    Ok(())
+}
+
+#[derive(Deserialize)]
+#[serde(tag = "type", rename_all = "camelCase")]
+enum Request {
+    Init {
+        #[serde(rename = "packsJson")]
+        packs: Option<String>,
+    },
+    Start {
+        players: u8,
+        seed: u64,
+        observer: u8,
+        #[serde(rename = "packsJson")]
+        packs: Option<String>,
+        mode: Option<String>,
+    },
+    EndPhase {
+        actor: Option<u8>,
+    },
+    PlayCard {
+        actor: u8,
+        card: u32,
+        targets: Vec<u8>,
+    },
+    ActivateSkill {
+        actor: u8,
+        skill: u16,
+        #[serde(default)]
+        targets: Vec<u8>,
+        #[serde(default, rename = "cardTargets")]
+        card_targets: Vec<u32>,
+    },
+    ResolveChoice {
+        actor: u8,
+        #[serde(rename = "choiceId")]
+        choice_id: u64,
+        selections: Vec<u32>,
+        #[serde(default)]
+        cancelled: bool,
+    },
+    AutoStep,
+    Observer,
+    Status,
+    GeneralCandidates,
+    ChooseGeneral {
+        seat: u8,
+        name: String,
+    },
+    Save,
+    Restore {
+        hex: String,
+        #[serde(rename = "packsJson")]
+        packs: Option<String>,
+    },
+    ValidatePackage {
+        #[serde(rename = "packJson")]
+        pack: String,
+    },
+    UseSkillCard,
+    LoadReplay,
+    SeekReplay,
+}
+
+#[derive(Default)]
+struct HostSession {
+    session: Option<NativeSession>,
+    observer: u8,
+    cursor: u32,
+}
+
+fn parsed(raw: String) -> Result<Value, String> {
+    serde_json::from_str(&raw).map_err(|error| error.to_string())
+}
+
+impl HostSession {
+    fn dispatch(&mut self, value: Value) -> Result<Value, String> {
+        let id = value["id"].as_u64().filter(|id| *id <= MAX_SAFE_INTEGER);
+        if id.is_none() {
+            return Err("native: invalid request id".into());
+        }
+        validate_payload_size(&value)?;
+        let request: Request = serde_json::from_value(value)
+            .map_err(|error| format!("native: invalid request: {error}"))?;
+        match request {
+            Request::Init { packs } => {
+                let candidate =
+                    NativeSession::new_with_packs_json(4, 4242, packs.as_deref().unwrap_or("[]"))?;
+                self.session = Some(candidate);
+                self.observer = 0;
+                self.cursor = 0;
+                return Ok(json!("native ready"));
+            }
+            Request::ValidatePackage { pack } => {
+                if pack.is_empty() {
+                    return Err("native: validatePackage requires nonempty JSON".into());
+                }
+                validate_pack_json(&pack)?;
+                return Ok(json!({"valid": true}));
+            }
+            _ => {}
+        }
+        let session = self
+            .session
+            .as_mut()
+            .ok_or("native engine not initialized")?;
+        let result = match request {
+            Request::Start {
+                players,
+                seed,
+                observer,
+                packs,
+                mode,
+            } => {
+                if players == 0 || observer >= players || seed > MAX_SAFE_INTEGER {
+                    return Err("native: invalid players, observer or seed".into());
+                }
+                let candidate = match mode.as_deref() {
+                    Some("identity") => NativeSession::new_identity_with_packs_json(
+                        players,
+                        seed,
+                        packs.as_deref().unwrap_or("[]"),
+                    )?,
+                    None => NativeSession::new_with_packs_json(
+                        players,
+                        seed,
+                        packs.as_deref().unwrap_or("[]"),
+                    )?,
+                    _ => return Err("native: unknown match mode".into()),
+                };
+                let data = envelope(&candidate, observer, &mut 0, Value::Null)?;
+                *session = candidate;
+                self.observer = observer;
+                self.cursor = 0;
+                return Ok(data);
+            }
+            Request::EndPhase { actor } => {
+                parsed(session.next_phase(actor.unwrap_or(self.observer) as u32)?)?
+            }
+            Request::PlayCard {
+                actor,
+                card,
+                targets,
+            } => parsed(session.play_card(
+                actor as u32,
+                card,
+                targets.into_iter().map(u32::from).collect(),
+            )?)?,
+            Request::ActivateSkill {
+                actor,
+                skill,
+                targets,
+                card_targets,
+            } => {
+                if !targets.is_empty() || !card_targets.is_empty() {
+                    return Err(
+                        "native: activateSkill 不接受预选目标（目标由内核开放选择应答决定）".into(),
+                    );
+                }
+                parsed(session.activate_skill(actor as u32, skill)?)?
+            }
+            Request::ResolveChoice {
+                actor,
+                choice_id,
+                selections,
+                cancelled,
+            } => {
+                if choice_id > MAX_SAFE_INTEGER {
+                    return Err("native: invalid choiceId".into());
+                }
+                let choice = parsed(session.open_choice_json(actor)?)?;
+                if choice["id"].as_u64() != Some(choice_id) {
+                    return Err(format!("native: choice {choice_id} 不匹配/不存在"));
+                }
+                let count = choice["options"].as_array().map_or(0, Vec::len);
+                if !cancelled && selections.iter().any(|index| *index as usize >= count) {
+                    return Err("native: 选项 token 不在候选".into());
+                }
+                parsed(session.answer(
+                    actor as u32,
+                    choice_id,
+                    if cancelled { Vec::new() } else { selections },
+                )?)?
+            }
+            Request::AutoStep => parsed(session.auto_step()?)?,
+            Request::Observer => Value::Null,
+            Request::Status => {
+                return Ok(
+                    json!({"kind": "status", "revision": session.revision(), "finished": session.is_finished()}),
+                )
+            }
+            Request::GeneralCandidates => return parsed(session.general_candidates_json()),
+            Request::ChooseGeneral { seat, name } => {
+                let assignment = parsed(session.assign_general(seat, &name)?)?;
+                return Ok(
+                    json!({"assignment": assignment, "envelope": envelope(session, self.observer, &mut self.cursor, Value::Null)?}),
+                );
+            }
+            Request::Save => return Ok(json!({"kind": "save", "hex": session.save_hex()})),
+            Request::Restore { hex, packs } => {
+                let mut candidate = NativeSession::new(1, 0)?;
+                candidate.restore_hex_with_packs_json(&hex, packs.as_deref().unwrap_or("[]"))?;
+                let data = envelope(&candidate, self.observer, &mut 0, Value::Null)?;
+                // Preserve planner settings on the live session, as the Worker does.
+                session.restore_hex_with_packs_json(&hex, packs.as_deref().unwrap_or("[]"))?;
+                self.cursor = 0;
+                return Ok(data);
+            }
+            Request::UseSkillCard => return Err("native backend: useSkillCard 未映射".into()),
+            Request::LoadReplay => return Err("native backend: loadReplay 未映射".into()),
+            Request::SeekReplay => return Err("native backend: seekReplay 未映射".into()),
+            Request::Init { .. } | Request::ValidatePackage { .. } => unreachable!(),
+        };
+        envelope(session, self.observer, &mut self.cursor, result)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[tokio::test]
+    async fn close_allows_the_executing_command_but_rejects_queued_commands() {
+        let (sender, receiver) = sync_channel::<Job>(8);
+        let closed = Arc::new(AtomicBool::new(false));
+        let host = NativeEngineHost {
+            sender: Mutex::new(Some(sender)),
+            closed: closed.clone(),
+        };
+        let (entered_tx, entered_rx) = sync_channel(1);
+        let (release_tx, release_rx) = sync_channel(1);
+        let (finished_tx, finished_rx) = sync_channel(1);
+        let owner = std::thread::spawn(move || {
+            let mut session = HostSession::default();
+            session.dispatch(json!({"id": 1, "type": "init"})).unwrap();
+            run_requests(receiver, &closed, |request| {
+                entered_tx.send(()).unwrap();
+                release_rx.recv().unwrap();
+                session.dispatch(request)
+            });
+            finished_tx
+                .send(
+                    session
+                        .dispatch(json!({"id": 4, "type": "status"}))
+                        .unwrap(),
+                )
+                .unwrap();
+        });
+        let (executing_tx, executing_rx) = oneshot::channel();
+        host.sender
+            .lock()
+            .unwrap()
+            .as_ref()
+            .unwrap()
+            .try_send((
+                json!({"id": 2, "type": "endPhase", "actor": 0}),
+                executing_tx,
+            ))
+            .unwrap();
+        entered_rx
+            .recv_timeout(std::time::Duration::from_secs(5))
+            .unwrap();
+        let (queued_tx, queued_rx) = oneshot::channel();
+        host.sender
+            .lock()
+            .unwrap()
+            .as_ref()
+            .unwrap()
+            .try_send((json!({"id": 3, "type": "autoStep"}), queued_tx))
+            .unwrap();
+        host.close();
+        release_tx.send(()).unwrap();
+        let executing = executing_rx.await.unwrap();
+        let queued = queued_rx.await.unwrap();
+        assert_eq!(executing["ok"], true);
+        assert_eq!(executing["data"]["revision"], 1);
+        assert_eq!(queued["ok"], false);
+        assert!(queued["error"]
+            .as_str()
+            .unwrap()
+            .contains("closed before execution"));
+        assert_eq!(
+            finished_rx
+                .recv_timeout(std::time::Duration::from_secs(5))
+                .unwrap()["revision"],
+            1
+        );
+        assert!(host
+            .request(json!({"id": 5, "type": "status"}))
+            .await
+            .unwrap_err()
+            .contains("closed"));
+        owner.join().unwrap();
+    }
+}
diff --git a/apps/desktop-client/src/native_engine_resource.rs b/apps/desktop-client/src/native_engine_resource.rs
new file mode 100644
index 00000000..799745ce
--- /dev/null
+++ b/apps/desktop-client/src/native_engine_resource.rs
@@ -0,0 +1,50 @@
+//! Per-WebView Tauri resources give each EngineClient the same independent lifetime as a Worker.
+use crate::NativeEngineHost;
+use std::sync::Arc;
+use tauri::{Resource, ResourceId, ResourceTable};
+
+impl Resource for NativeEngineHost {
+    fn close(self: Arc<Self>) {
+        NativeEngineHost::close(&self);
+    }
+}
+
+/// Allocate a bounded host resource; resource IDs are generated by Tauri.
+pub fn open_native_engine(table: &mut ResourceTable) -> Result<ResourceId, String> {
+    let count = table
+        .names()
+        .filter(|(_, name)| name.as_ref() == std::any::type_name::<NativeEngineHost>())
+        .count();
+    if count >= 8 {
+        return Err("native engine resource limit reached".into());
+    }
+    Ok(table.add(NativeEngineHost::new()?))
+}
+
+/// Retire this WebView document's engines without touching resources owned by other APIs.
+pub fn close_native_engines(table: &mut ResourceTable) -> usize {
+    let ids: Vec<_> = table
+        .names()
+        .map(|(id, _)| id)
+        .filter(|id| table.get::<NativeEngineHost>(*id).is_ok())
+        .collect();
+    for id in &ids {
+        let engine = table
+            .take::<NativeEngineHost>(*id)
+            .expect("engine selected from the same exclusive resource table");
+        Resource::close(engine);
+    }
+    ids.len()
+}
+
+/// Close only an engine resource; unknown IDs and duplicate closes are controlled errors.
+pub fn close_native_engine(
+    table: &mut ResourceTable,
+    resource_id: ResourceId,
+) -> Result<(), String> {
+    let engine = table
+        .take::<NativeEngineHost>(resource_id)
+        .map_err(|error| error.to_string())?;
+    Resource::close(engine);
+    Ok(())
+}
diff --git a/apps/desktop-client/src/native_envelope.rs b/apps/desktop-client/src/native_envelope.rs
new file mode 100644
index 00000000..7ee5e794
--- /dev/null
+++ b/apps/desktop-client/src/native_envelope.rs
@@ -0,0 +1,140 @@
+//! Existing Worker envelope projection from the shared, observer-filtered session API.
+use engine_native_wasm::NativeSession;
+use serde_json::{json, Value};
+
+fn parse(raw: String) -> Result<Value, String> {
+    serde_json::from_str(&raw).map_err(|error| error.to_string())
+}
+
+fn card(view: &Value, id: &Value, owner: Value, zone: &str) -> Value {
+    let face = &view["cards"][id.to_string()];
+    json!({"id": id, "def": face["def"], "suit": face["suit"], "rank": face["rank"],
+        "owner": owner, "zone": zone, "kind": face["kind"].as_str().unwrap_or("Other")})
+}
+
+fn snapshot(view: &Value, revision: u64) -> Value {
+    let mut cards = Vec::new();
+    let mut seats = Vec::new();
+    for player in view["players"].as_array().into_iter().flatten() {
+        for (key, zone) in [("equips", "Equip"), ("judge", "Judge")] {
+            for id in player[key].as_array().into_iter().flatten() {
+                cards.push(card(view, id, player["seat"].clone(), zone));
+            }
+        }
+        seats.push(json!({
+            "player": player["seat"], "character_def": player["characterDef"].as_u64().unwrap_or(0),
+            "seat": player["seat"], "hp": player["hp"], "max_hp": player["maxHp"],
+            "alive": player["alive"], "turned_over": player["turnedOver"],
+            "hand_count": player["handCount"], "identity": player["identity"],
+            "skills": player["skills"].as_array().into_iter().flatten().map(|name| json!({
+                "id": 0, "def": 0, "enabled": true, "use_count": 0, "active": false,
+                "view_as": false, "locked": false, "name": name,
+            })).collect::<Vec<_>>()
+        }));
+    }
+    let mut own = Vec::new();
+    if let Some(player) = view["players"]
+        .as_array()
+        .and_then(|players| players.iter().find(|p| p["seat"] == view["seat"]))
+    {
+        for id in player["hand"]["own"].as_array().into_iter().flatten() {
+            own.push(card(view, id, view["seat"].clone(), "Hand"));
+        }
+    }
+    own.extend(cards);
+    for (key, zone) in [("discard", "DiscardPile"), ("table", "Processing")] {
+        for id in view[key].as_array().into_iter().flatten() {
+            own.push(card(view, id, Value::Null, zone));
+        }
+    }
+    let phase = match view["phase"].as_str() {
+        Some("judge") => "Judge",
+        Some("draw") => "Draw",
+        Some("play") => "Play",
+        Some("discard") => "Discard",
+        Some("end") => "End",
+        _ => "Idle",
+    };
+    json!({"revision": revision, "state_hash": "", "observer": view["seat"],
+        "round": view["round"], "current_player": view["turn"], "phase": phase,
+        "seats": seats, "known_cards": own, "outcome": view["outcome"]})
+}
+
+fn option_label(option: &Value) -> String {
+    if let Some(text) = option.as_str() {
+        return text.into();
+    }
+    if option.is_number() {
+        return option.to_string();
+    }
+    for key in ["card", "player", "tag", "kind"] {
+        if !option[key].is_null() {
+            return format!("{key}:{}", option[key]);
+        }
+    }
+    "unknown".into()
+}
+
+fn choice(session: &NativeSession, observer: u8) -> Result<Value, String> {
+    let raw = parse(session.open_choice_json(observer)?)?;
+    if raw.is_null() {
+        return Ok(Value::Null);
+    }
+    let mut result = json!({"choice_id": raw["id"], "observer": observer, "kind": raw["kind"].as_str().unwrap_or("Custom"),
+        "options": raw["options"].as_array().into_iter().flatten().enumerate().map(|(index, option)| {
+            json!({"token": index, "label_key": option_label(option)})
+        }).collect::<Vec<_>>()});
+    for (source, target) in [
+        ("min", "min_count"),
+        ("max", "max_count"),
+        ("allowCancel", "allow_cancel"),
+    ] {
+        if let Some(value) = raw.get(source) {
+            result[target] = value.clone();
+        }
+    }
+    Ok(result)
+}
+
+fn public_event(code: &Value) -> Value {
+    let label = match code.as_u64() {
+        Some(1) => "对局开始",
+        Some(2) => "摸牌",
+        Some(3) => "使用或响应牌",
+        Some(4) => "伤害结算",
+        Some(5) => "回复体力",
+        Some(6) => "濒死状态变化",
+        Some(7) => "玩家阵亡",
+        Some(8) => "阶段或回合推进",
+        Some(9) => "对局结束",
+        Some(10) => "选择状态变化",
+        _ => return json!({"PublicEvent": {"code": code, "label": format!("事件 {code}")}}),
+    };
+    json!({"PublicEvent": {"code": code, "label": label}})
+}
+
+pub(super) fn envelope(
+    session: &NativeSession,
+    observer: u8,
+    cursor: &mut u32,
+    result: Value,
+) -> Result<Value, String> {
+    let view = parse(session.view_json(observer)?)?;
+    let legal = parse(session.legal_actions_json(observer)?)?;
+    let choice = choice(session, observer)?;
+    let mut events = Vec::new();
+    if !result.is_null() {
+        let end = session.log_len();
+        let codes = parse(session.public_event_codes_json((*cursor).min(end)))?;
+        events = codes
+            .as_array()
+            .into_iter()
+            .flatten()
+            .map(public_event)
+            .collect();
+        *cursor = end;
+    }
+    Ok(json!({"result": result, "events": events, "choice": choice,
+        "view": snapshot(&view, session.revision()), "legal_actions": legal["actions"],
+        "hash_hex": session.state_hash_hex(), "revision": session.revision(), "finished": session.is_finished()}))
+}
