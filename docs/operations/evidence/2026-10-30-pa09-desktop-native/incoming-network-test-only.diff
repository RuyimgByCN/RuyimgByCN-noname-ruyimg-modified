+
+test("network outcomes retain protocol seat IDs and never use the local-native normalization", async (t) => {
+  const { client, connect } = fixture(t);
+  const socket = await connect();
+  const pending = client.joinRoom(7);
+  join(socket);
+  await pending;
+  const received = [];
+  client.onEnvelope((envelope) => received.push(envelope));
+  for (const player of [1, 4]) {
+    const snapshot = { ...view(player), outcome: { SingleWin: { player } } };
+    socket.receive("CommandOutcome", { view: snapshot, choice: null, legal_actions: [], result: { Accepted: {} } });
+    assert.deepEqual(received.at(-1).view.outcome, { SingleWin: { player } });
+  }
+});
