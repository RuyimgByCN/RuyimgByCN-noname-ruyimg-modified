+const SAB_DATA_OFFSET = 8;
+let sab: SharedArrayBuffer | null = null;
+let sabInts: Int32Array | null = null;
+
+export function setSabMirror(buffer: SharedArrayBuffer | null): void {
+  sab = buffer;
+  sabInts = buffer ? new Int32Array(buffer, 0, 2) : null;
