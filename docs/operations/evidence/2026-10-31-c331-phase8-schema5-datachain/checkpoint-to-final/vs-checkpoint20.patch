+//! 内容包装载前的校验与按 ABI 启用的历史追踪（`load_package_inner` 的前两段）。
+
+use super::*;
+
+impl ContentRegistry {
+    /// 装载前校验：逻辑哈希、重复装载、VM ABI 门槛与依赖闭包（只读）。
