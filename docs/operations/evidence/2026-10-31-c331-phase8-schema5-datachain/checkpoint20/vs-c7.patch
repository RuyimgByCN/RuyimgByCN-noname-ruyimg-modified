+fn schema5_false_empty_none_presence_downgrade_and_unknown_fields() {
+    let fields=[("skill_index","charlotte",serde_json::json!(false)),("skill_index","persevere",serde_json::json!(false)),("skill_index","forever",serde_json::json!(false)),("skill_index","temporary",serde_json::json!(false)),("skill_index","group_children",serde_json::json!([])),("skill_index","reveal",serde_json::json!("none")),("trigger_index","force_die",serde_json::json!(false)),("trigger_index","force_out",serde_json::json!(false)),("trigger_index","repeat",serde_json::json!("once")),("trigger_index","hidden",serde_json::json!("public_only"))];
