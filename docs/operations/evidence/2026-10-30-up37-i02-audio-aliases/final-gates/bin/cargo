#!/usr/bin/env python3
import datetime
import json
import os
from pathlib import Path
import shutil
import sys

out = Path(__file__).resolve().parent.parent
free = shutil.disk_usage(out).free
record = {'time': datetime.datetime.now(datetime.timezone.utc).isoformat(), 'argv': sys.argv[1:], 'disk_free_bytes': free, 'incremental': os.environ.get('CARGO_INCREMENTAL'), 'jobs': os.environ.get('CARGO_BUILD_JOBS'), 'target': os.environ.get('CARGO_TARGET_DIR')}
with (out / 'cargo-invocations.jsonl').open('a') as stream:
    stream.write(json.dumps(record) + '\n')
assert free >= 3 * 1024 ** 3, 'less than 3GiB free; refusing Cargo'
assert record['incremental'] == '0' and record['jobs'] == '2'
assert record['target'] == '/var/folders/b5/2mh_j5tj7m71xhcjsk2z1t4c0000gn/T/noname-f7-stage3.czy5e9gq/target'
os.execv('/Users/ruyimg/.cargo/bin/cargo', ['cargo', *sys.argv[1:]])
