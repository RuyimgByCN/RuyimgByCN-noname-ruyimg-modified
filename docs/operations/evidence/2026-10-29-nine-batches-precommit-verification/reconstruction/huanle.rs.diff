@@ -1,3 +1,12 @@
 use super::*;
+
+/// 子进程按 `--exact` 重跑本文件测试用的 libtest 全名：分组二进制里本文件是子模块，
+/// 全名带模块前缀（`module_path!` 去掉首段 crate 名）。
+fn libtest_name(test: &str) -> String {
+    match module_path!().split_once("::") {
+        Some((_, module)) => format!("{module}::{test}"),
+        None => test.to_string(),
+    }
+}
 
