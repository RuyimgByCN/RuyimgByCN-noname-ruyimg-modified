+        *root = frame.id;
+    }
+    assert!(Engine::restore_with_extensions(&forged, &[&p]).is_err());
+    for game in [&mut e, &mut r] {
+        let choice = game.open_choice().unwrap().clone();
+        let out = game.submit(engine_native::GameCommand {
+            actor: choice.observer,
