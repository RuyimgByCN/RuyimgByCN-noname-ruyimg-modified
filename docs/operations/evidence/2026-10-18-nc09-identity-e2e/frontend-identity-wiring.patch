+export function nativeCreateIdentity(
+  players: number,
+  seed: number,
+  observer = 0,
+): NativeHandle {
+  return {
+    engine: NativeEngine.new_identity(players, BigInt(seed)),
+    seed,
+    players,
+    observer,
+  };
