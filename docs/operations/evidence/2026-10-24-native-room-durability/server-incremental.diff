+        Some(StoreFault::PartialWrite),
+        Some(StoreFault::FileSync),
+        Some(StoreFault::Rename),
+        Some(StoreFault::DirectorySync),
+    ] {
+        write_failure_retries_and_restarts(fault);
+    }
