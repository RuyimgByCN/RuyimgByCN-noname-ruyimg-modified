+    assert_eq!(
+        spectate(&handle, 3).await.unwrap().role,
+        engine_protocol::ClientRole::Spectator
+    );
+    assert_eq!(
+        store.load_all().unwrap().pop().unwrap().state.members.len(),
+        3
+    );
