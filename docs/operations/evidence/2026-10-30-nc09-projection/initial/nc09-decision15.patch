+#[test]
+fn nc09_every_standard_card_kind_preserves_local_granularity() {
+    let engine = fixture();
+    let mut snapshot = engine.save();
+    snapshot.core.discard.append(&mut snapshot.core.deck);
+    for player in &mut snapshot.core.players {
+        snapshot.core.discard.append(&mut player.hand);
+        snapshot.core.discard.append(&mut player.equips);
+        snapshot.core.discard.append(&mut player.judge);
+    }
+    snapshot.core.discard.append(&mut snapshot.core.table);
+    let engine = Engine::restore(&snapshot).unwrap();
+    assert_parity(&engine);
+    let public = observer_snapshot_for(&engine, RoomRole::Spectator, None);
+    assert_eq!(public.known_cards.len(), engine.catalog().cards.len());
+    let kinds: BTreeSet<_> = public
+        .known_cards
+        .iter()
+        .map(|c| format!("{:?}", c.kind))
+        .collect();
+    assert_eq!(
+        kinds,
+        [
+            "Sha",
+            "Shan",
+            "Tao",
+            "Jiu",
+            "ShaFire",
+            "ShaThunder",
+            "Other"
+        ]
+        .into_iter()
+        .map(String::from)
+        .collect()
+    );
