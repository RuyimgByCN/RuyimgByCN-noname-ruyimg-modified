_phase_end","entry_pc":0},{"trigger_def_id":9,"skill_def_id":882766764,"event":"phase_end","filter":"owner_is_target","optional":true,"module":"juechen_phase_end","entry_pc":0},{"trigger_def_id":10,"skill_def_id":1498596844,"event":"phase_end","filter":"owner_is_target","optional":true,"module":"chiying_phase_end","entry_pc":0},{"trigger_def_id":11,"skill_def_id":1666515245,"event":"phase_end","filter":"owner_is_target","optional":true,"module":"jingfan_phase_end","entry_pc":0},{"trigger_def_id":12,"skill_def_id":517866804,"event":"phase_end","filter":"owner_is_target","optional":true,"module":"huodi_phase_end","entry_pc":0},{"trigger_def_id":13,"skill_def_id":3402005750,"event":"phase_end","filter":"owner_is_target","optional":true,"module":"jueji_phase_end","entry_pc":0},{"trigger_def_id":14,"skill_def_id":1633666137,"event":"phase_end","filter":"owner_is_target","optional":true,"module":"xuanlei_phase_end","entry_pc":0},{"trigger_def_id":15,"skill_def_id":827342815,"event":"phase_end","filter":"owner_is_target","optional":true,"module":"konghun_phase_end","entry_pc":0}],"modifier_index":[],"active_index":[],"view_as_index":[],"translations":{"zh-CN":{"biantian":"变天","biantian_info":"锁定技，准备阶段，你进行一次判定，若为红色，你可以选择至多三名角色进入“狂风”状态直到你的下一回合开始，若为黑桃，直到下个回合开始前，你处于“大雾”状态","chiying":"持盈","chiying_info":"每当一名角色受到多于1伤害时，你可以令其防止其余伤害，然后令伤害来源摸一张牌","huodi":"惑敌","huodi_info":"结束阶段，若你本回合内没有使用过指定其他角色为目标的卡牌，你可以弃置一名其他角色的一张牌","jg_caozhen":"佳人子丹","jg_huangyueying":"工神月英","jg_liubei":"烈帝玄德","jg_pangtong":"浴火士元","jg_simayi":"断狱仲达","jg_xiahouyuan":"绝尘妙才","jg_zhanghe":"巧魁儁乂","jg_zhugeliang":"天侯孔明","jingfan":"惊帆","jingfan_info":"回合内，每当你使用一张卡牌，你的进攻距离+1；出牌阶段结束时，你可以将手牌数补至X，并指定至多X名角色令其进攻距离+1直到其下一回合结束，X为你回合内使用的卡牌数","jingmiao":"精妙","jingmiao_info":"每当有一名其他角色使用无懈可击，你可以弃置其一张牌","jizhen":"激阵","jizhen_info":"结束阶段，你可以令所至多两名已受伤角色摸一张牌","juechen":"绝尘","juechen_info":"每当你使用一张杀，可以弃置一名其他角色的一张牌（不能是杀的目标）","jueji":"绝汲","jueji_info":"其他角色的摸牌阶段开始时，若其已受伤，你可以弃置一张牌令其摸牌数-1","konghun":"控魂","konghun_info":"出牌阶段开始时，若你的体力值不大于1（场上存活角色数不小于6时改为2），你可以对至多X名角色各造成1点雷电伤害，然后你恢复等量体力，X为场上其他存活角色数的一半（向下取整且至多为4）","lingfeng":"灵锋","lingfeng_info":"摸牌阶段，你可以弃置摸牌，改为亮出牌堆顶的两张牌并获得之，若两张牌颜色不同，你可以弃置一名角色的一张牌","qiwu":"奇雾","sfanshi":"反噬","sfanshi_info":"锁定技，结束阶段，你失去1点体力","tianyu":"天狱","tianyu_info":"结束阶段，你可以将任意名未横置的其他角色横置","xuanlei":"玄雷","xuanlei_info":"锁定技，准备阶段，你令所有判定区内有牌的其他角色受到1点雷电伤害","zhinang":"智囊","zhinang_info":"准备阶段，你可以亮出牌堆顶的三张牌，你可以将其中锦囊或装备牌交给一名角色"}},"asset_manifest":{"schema_version":1,"package_id":"jiange","total_compressed_size":104065,"total_decoded_size":0,"entries":[{"asset_id":"audio_skill_qiwu.mp3","source_hash":[241,60,78,189,167,85,187,171,183,100,193,215,164,35,233,228,147,77,29,25,46,220,167,12,49,138,145,203,60,62,245,16],"kind":"Audio","image_variants":[],"audio_variants":[{"format":"Opus","platforms":[],"content_hash":[241,60,78,189,167,85,187,171,183,100,193,215,164,35,233,228,147,77,29,25,46,220,167,12,49,138,145,203,60,62,245,16],"compressed_size":104065,"decoded_size":0}],"priority":"Lazy","depends_on":[],"platforms":[]}]},"asset_paths":{"audio_skill_qiwu.mp3":"assets/audio/skill/qiwu.mp3"},"compiler_version":"0.5.0-active-selection"}