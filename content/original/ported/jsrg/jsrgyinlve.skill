// jsrgyinlve（隐略）：每轮各限一次。当一名角色受到火焰/雷电伤害时，你可以防止此伤害，然后于当前回合结束后执行一个只有摸牌/弃牌阶段的回合。
// 未建模：charlotte延迟, addTempSkill（DSL无对应原语）
skill jsrgyinlve(3290542520) {
  // INTENTIONAL_EMPTY_NOOP: 上游 jsrgyinlve（skill.js:2149）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：受伤后可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
