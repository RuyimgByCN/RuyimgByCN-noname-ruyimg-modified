// jsrgshoushu（授术）：锁定技。①每轮开始时，若场上没有【太平要术】，你可以从游戏外将【太平要术】置于一名角色的装备区内。②当【太平要术】离开一名角色的装备区后，你令此牌销毁。
// 类型：锁定技
skill jsrgshoushu(3065371268) {
  // INTENTIONAL_EMPTY_NOOP: 上游 jsrgshoushu（skill.js:11657）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
