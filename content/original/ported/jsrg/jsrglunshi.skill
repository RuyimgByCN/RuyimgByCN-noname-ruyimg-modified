// jsrglunshi（论势）：出牌阶段限一次。你可以令一名角色摸等同于其攻击范围内角色数的牌（至多摸至五张），然后其弃置等同于攻击范围内含有其的角色数的牌。
// 未建模：存活计数, 翻译调用（DSL无对应原语）
skill jsrglunshi(2813476027) {
  // INTENTIONAL_EMPTY_NOOP: 上游 jsrglunshi（skill.js:7923）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：出牌阶段限一次摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
