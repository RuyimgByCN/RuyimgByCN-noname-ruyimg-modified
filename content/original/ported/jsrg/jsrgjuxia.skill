// jsrgjuxia（居下）：每回合限一次。当其他角色使用牌指定你为目标后，若其技能数多于你，其可以令此牌对你无效，然后令你摸两张牌。
// 未建模：翻译调用, 全局状态, 延迟动画, charlotte延迟, storage状态, chooseBool（DSL无对应原语）
skill jsrgjuxia(2408441606) {
  // INTENTIONAL_EMPTY_NOOP: 上游 jsrgjuxia（skill.js:9597）含真实规则体，DSL 原语暂不足以
  // 精确建模（保真度债；原 audio-only 注记经 2026-08-21 上游体复核证伪）。
  // 原“批量最小近似：用牌后可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
