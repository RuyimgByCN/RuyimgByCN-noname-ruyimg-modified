// jsrgzhuwei（筑围）：出牌阶段限一次，你可以移动场上的一张装备牌，然后你可以令一名攻击范围内因此没有角色的角色失去2点体力。
// 未建模：存活计数（DSL无对应原语）
skill jsrgzhuwei(3566960210) {
  // INTENTIONAL_EMPTY_NOOP: 上游 jsrgzhuwei（skill.js:13536）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：出牌阶段限一次摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
