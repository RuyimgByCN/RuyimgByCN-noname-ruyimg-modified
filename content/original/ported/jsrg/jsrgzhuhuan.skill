// jsrgzhuhuan（诛宦）：准备阶段，你可以展示所有手牌并弃置所有【杀】，然后令一名其他角色选择一项：1.弃置等量的牌，然后受到1点伤害；2.令你摸等量的牌，然后你回复1点体力。
// 未建模：展示手牌, 翻译调用（DSL无对应原语）
skill jsrgzhuhuan(2556669928) {
  // INTENTIONAL_EMPTY_NOOP: 上游 jsrgzhuhuan（skill.js:9315）含真实规则体，DSL 原语暂不足以
  // 精确建模（保真度债；原 audio-only 注记经 2026-08-21 上游体复核证伪）。
  // 原“批量最小近似：结束阶段可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
