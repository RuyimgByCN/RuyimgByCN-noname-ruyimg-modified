// jsrggangfen（刚忿）：当手牌数大于你的角色使用【杀】指定其他角色为目标时，你可以成为此【杀】的额外目标，并令所有其他角色也选择是否如此做。然后使用者展示其手牌，若其黑色手牌数小于目标数，则取消此【杀】的所有目标。
// 未建模：addExpose, 翻译调用, 取消牌目标, 延迟动画, 展示手牌, 存活计数 ...等8项（DSL无对应原语）
skill jsrggangfen(2531064291) {
  // INTENTIONAL_EMPTY_NOOP: 上游 jsrggangfen（skill.js:159）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：用牌后可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
