// jsrgjuelie（绝烈）：①当你使用【杀】指定一名角色为目标后，你可以弃置任意张牌并弃置其等量的牌。②若你的手牌数或体力值为全场最小，则你使用【杀】造成的伤害+1。
// 未建模：翻译调用, 全局状态（DSL无对应原语）
skill jsrgjuelie(2746539822) {
  // INTENTIONAL_EMPTY_NOOP: 上游 jsrgjuelie（skill.js:9430）含真实规则体，DSL 原语暂不足以
  // 精确建模（保真度债；原 audio-only 注记经 2026-08-21 上游体复核证伪）。
  // 原“批量最小近似：用牌后可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
