// jsrgxundao（寻道）：当你的判定牌生效前，你可以令至多两名角色依次弃置一张牌，然后你选择一张以此法弃置且位于弃牌堆中的牌代替此判定牌。
// 未建模：全局状态, chooseButton, 翻译调用（DSL无对应原语）
skill jsrgxundao(2766787019) {
  // INTENTIONAL_EMPTY_NOOP: 上游 jsrgxundao（skill.js:11729）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
