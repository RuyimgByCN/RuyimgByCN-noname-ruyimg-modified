// jsrgzhongzen（众谮）：锁定技。①弃牌阶段开始时，你令所有手牌数小于你的角色各交给你一张手牌。②弃牌阶段结束时，若你本阶段弃置的♠牌数大于你的体力值，则你弃置所有牌。
// 未建模：历史查询（DSL无对应原语）
skill jsrgzhongzen(3972047956) {
  // INTENTIONAL_EMPTY_NOOP: 上游 jsrgzhongzen（skill.js:1423）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
