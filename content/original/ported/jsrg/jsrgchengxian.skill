// jsrgchengxian（称贤）：出牌阶段限两次。你可以将一张手牌当一张本回合未以此法使用过的普通锦囊牌使用（此转化牌须与以此法转化的手牌的合法目标数相同）。
// 未建模：chooseButton, 翻译调用, 全局状态, 标记计数, storage状态, 存活计数 ...等7项（DSL无对应原语）
skill jsrgchengxian(3613110253) {
  // INTENTIONAL_EMPTY_NOOP: 上游 jsrgchengxian（skill.js:8302）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：视为【杀】”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
