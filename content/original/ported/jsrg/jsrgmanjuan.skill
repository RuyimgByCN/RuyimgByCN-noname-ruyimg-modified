// jsrgmanjuan（漫卷）：若你没有手牌，你可以如手牌般使用或打出于本回合进入弃牌堆的牌（每种点数每回合限一次）。
// 未建模：charlotte延迟, addTempSkill（DSL无对应原语）
skill jsrgmanjuan(2837004705) {
  // INTENTIONAL_EMPTY_NOOP: 上游 jsrgmanjuan（skill.js:5939）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：手牌上限 +1”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
