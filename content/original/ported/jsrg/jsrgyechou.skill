// jsrgyechou（业仇）：当你死亡时，你可以令一名其他角色获得如下效果：当其受到伤害值不小于其体力值的伤害时，其令此伤害翻倍。
// 未建模：标记计数, charlotte延迟, 标记技, 全局状态（DSL无对应原语）
skill jsrgyechou(3679463455) {
  // INTENTIONAL_EMPTY_NOOP: 上游 jsrgyechou（skill.js:8626）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
