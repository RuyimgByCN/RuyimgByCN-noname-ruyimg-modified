// jsrgdangyi（荡异）：主公技，每局游戏限X次，你造成伤害时可以令此伤害+1（X为你获得此技能时的已损失体力值+1）。
// 类型：主公技
// 未建模：受伤判断, 标记计数, charlotte延迟, storage状态, 主公技, 标记技（DSL无对应原语）
skill jsrgdangyi(3432664635) {
  // INTENTIONAL_EMPTY_NOOP: 上游 jsrgdangyi（skill.js:12984）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：受伤后可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
