// jsrgzhimeng（执盟）：准备阶段，你可以亮出牌堆顶的Ｘ张牌（Ｘ为存活角色数），然后令所有角色同时展示一张手牌。若有角色展示的手牌花色与其他角色均不同，则这些角色从亮出牌中获得该花色的所有牌。
// 未建模：存活计数, 翻译调用（DSL无对应原语）
skill jsrgzhimeng(3999926884) {
  // INTENTIONAL_EMPTY_NOOP: 上游 jsrgzhimeng（skill.js:1673）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
