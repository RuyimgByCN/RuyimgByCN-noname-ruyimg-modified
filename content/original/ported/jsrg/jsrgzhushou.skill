// jsrgzhushou（诛首）：一名角色的回合结束时，若你于本回合内失去过牌，则你可以选择弃牌堆中本回合置入的点数唯一最大的牌，并对本回合失去过此牌的一名角色造成1点伤害。
// 未建模：历史查询, 翻译调用（DSL无对应原语）
skill jsrgzhushou(3170137288) {
  // INTENTIONAL_EMPTY_NOOP: 上游 jsrgzhushou（skill.js:529）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
