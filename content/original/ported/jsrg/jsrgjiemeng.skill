// jsrgjiemeng（皆盟）：主公技，锁定技。所有群势力角色至其他角色的距离-X（X为群势力角色数）。
// 类型：主公技 锁定技
// 未建模：存活计数, 主公技, 主公技判断（DSL无对应原语）
skill jsrgjiemeng(2293847389) {
  // INTENTIONAL_EMPTY_NOOP: 上游 jsrgjiemeng（skill.js:6452）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：手牌上限 +1”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
