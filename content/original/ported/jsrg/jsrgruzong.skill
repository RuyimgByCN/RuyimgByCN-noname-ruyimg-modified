// jsrgruzong（儒宗）：回合结束时，若你本回合使用牌指定过的目标角色仅有一名，则你可以将手牌数摸至与其相同。若该角色为你自己，则你可以改为令任意名其他角色将手牌摸至与你相同（均至多摸五张）。
// 未建模：chooseBool（DSL无对应原语）
skill jsrgruzong(2483950630) {
  // INTENTIONAL_EMPTY_NOOP: 上游 jsrgruzong（skill.js:341）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
