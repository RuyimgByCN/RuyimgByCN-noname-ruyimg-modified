// jsrgfuhai（浮海）：出牌阶段限一次。你可以令所有有手牌的其他角色同时展示一张手牌，然后你选择一个方向并摸X张牌（X为该方向上的角色展示的点数连续严格递增或严格递减的牌数，至少为1）。
// 未建模：翻译调用（DSL无对应原语）
skill jsrgfuhai(4072599140) {
  // INTENTIONAL_EMPTY_NOOP: 上游 jsrgfuhai（skill.js:3889）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：出牌阶段限一次摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
