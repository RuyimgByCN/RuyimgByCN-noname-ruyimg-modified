// jsrgbaohe（暴喝）：一名角色的出牌阶段结束时，你可以弃置两张牌，然后视为你对攻击范围内包含其的所有角色使用一张【杀】。当一名角色使用牌响应此【杀】后，此【杀】对后续目标角色造成的伤害+1。
// 未建模：storage状态, charlotte延迟, 延迟动画, addTempSkill（DSL无对应原语）
skill jsrgbaohe(3437019457) {
  // INTENTIONAL_EMPTY_NOOP: 上游 jsrgbaohe（skill.js:4726）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
