// jsrgtongli（同礼）：当你于出牌阶段内使用基本牌或普通锦囊牌指定第一个目标后，若你手牌中的花色数和你于本阶段内使用过的牌数相等，则你可以展示所有手牌，令此牌额外结算一次。
// 未建模：展示手牌, 历史查询, 翻译调用（DSL无对应原语）
skill jsrgtongli(2154312599) {
  // INTENTIONAL_EMPTY_NOOP: 上游 jsrgtongli（skill.js:3983）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：用牌后可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
