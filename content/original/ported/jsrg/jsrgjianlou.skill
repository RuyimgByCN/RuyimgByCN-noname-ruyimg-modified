// jsrgjianlou（舰楼）：每回合限一次，当场上一张装备牌进入弃牌堆时，你可以弃置一张牌并获得之，然后若此牌对应的装备栏中没有牌，你使用之。
// 未建模：延迟动画, chooseButton, 翻译调用（DSL无对应原语）
skill jsrgjianlou(4026533112) {
  // INTENTIONAL_EMPTY_NOOP: 上游 jsrgjianlou（skill.js:12326）含真实规则体，DSL 原语暂不足以
  // 精确建模（保真度债；原 audio-only 注记经 2026-08-21 上游体复核证伪）。
  // 原“批量最小近似：结束阶段可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
