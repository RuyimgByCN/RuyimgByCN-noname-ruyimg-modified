// jsrg_new_zhengyi（争义）：本轮因〖礼让〗获得牌唯一最少的角色每回合首次受到伤害时，本轮因〖礼让〗获得牌唯一最多的角色可以将此伤害转移给其。
// 未建模：存活计数, 座位数计算（DSL无对应原语）
skill jsrg_new_zhengyi(3949964226) {
  // INTENTIONAL_EMPTY_NOOP: 上游 jsrg_new_zhengyi（skill.js:10764）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：受伤后可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
