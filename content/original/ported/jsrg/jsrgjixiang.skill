// jsrgjixiang（济乡）：回合内每种牌名限一次。当一名其他角色需要使用或打出一张基本牌时，你可以弃置一张牌令其视为使用或打出之，然后你摸一张牌并令〖称贤〗于此阶段可发动次数上限+1。
// 未建模：chooseButton, 翻译调用, chooseCardTarget, 全局状态, addTempSkill, chooseToRespond替出牌 ...等13项（DSL无对应原语）
skill jsrgjixiang(2596902282) {
  // INTENTIONAL_EMPTY_NOOP: 上游 jsrgjixiang（skill.js:8119）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
