// jsrgchendu（陈笃）：锁定技，你的牌因使用、打出或弃置而进入弃牌堆时，若这些牌的数量大于你的体力值，你将这些牌交给至多等量名其他角色（若不为你的回合，选择的角色需包括当前回合角色）。
// 类型：锁定技
// 未建模：翻译调用, 全局状态（DSL无对应原语）
skill jsrgchendu(3871165906) {
  // INTENTIONAL_EMPTY_NOOP: 上游 jsrgchendu（skill.js:12618）含真实规则体，DSL 原语暂不足以
  // 精确建模（保真度债；原 audio-only 注记经 2026-08-21 上游体复核证伪）。
  // 原“批量最小近似：结束阶段可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
