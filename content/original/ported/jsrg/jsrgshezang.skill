// jsrgshezang（奢葬）：每轮限一次。当你或你回合内的其他角色进入濒死状态时，你可以亮出牌堆顶的四张牌，获得其中任意张花色各不相同的牌。
// 未建模：chooseButton, 全局状态（DSL无对应原语）
skill jsrgshezang(2728982608) {
  // INTENTIONAL_EMPTY_NOOP: 上游 jsrgshezang（skill.js:4029）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：濒死时可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
