// jsrgyansha（宴杀）：准备阶段，你可以视为对任意名角色使用【五谷丰登】。此牌结算结束后，所有非目标角色可以依次将一张装备牌当作【杀】对其中一名目标角色使用。
// 未建模：chooseCardTarget, 翻译调用, 全局状态（DSL无对应原语）
skill jsrgyansha(3830091585) {
  // INTENTIONAL_EMPTY_NOOP: 上游 jsrgyansha（skill.js:456）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
