// jsrgyizheng（义争）：出牌阶段限一次。你可以与一名手牌数大于你的角色拼点。若你：赢，其跳过下一个摸牌阶段；没赢，其可以对你造成至多2点伤害。
// 未建模：翻译调用, addTempSkill（DSL无对应原语）
skill jsrgyizheng(3571302706) {
  // INTENTIONAL_EMPTY_NOOP: 上游 jsrgyizheng（skill.js:10523）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：出牌阶段限一次摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
