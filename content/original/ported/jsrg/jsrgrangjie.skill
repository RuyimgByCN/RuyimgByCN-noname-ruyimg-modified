// jsrgrangjie（让节）：当你受到1点伤害后，你可以移动场上的一张牌，然后你可以于弃牌堆中选择获得一张本回合进入弃牌堆且与此牌花色相同的牌。
// 未建模：chooseButton, 翻译调用（DSL无对应原语）
skill jsrgrangjie(2877515526) {
  // INTENTIONAL_EMPTY_NOOP: 上游 jsrgrangjie（skill.js:10433）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：受伤后可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
