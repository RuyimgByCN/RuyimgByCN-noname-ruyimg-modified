// jsrgyingshi（鹰眎）：当你翻面时，你可以观看牌堆底的三张牌（若死亡角色数大于2则改为五张），然后将其中任意数量的牌以任意顺序置于牌堆顶，其余以任意顺序置于牌堆底。
// 未建模：延迟动画, 全局状态（DSL无对应原语）
skill jsrgyingshi(3498479504) {
  // INTENTIONAL_EMPTY_NOOP: 上游 jsrgyingshi（skill.js:2785）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
