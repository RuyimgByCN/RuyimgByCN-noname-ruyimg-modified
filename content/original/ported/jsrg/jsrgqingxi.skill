// jsrgqingxi（轻袭）：群势力技。出牌阶段每名角色限一次。你可以选择一名手牌数小于你的角色，你将手牌数弃置至与其相同，然后视为对其使用一张刺【杀】。
// 未建模：势力技能, charlotte延迟, 全局状态, addTempSkill（DSL无对应原语）
skill jsrgqingxi(4209669535) {
  // INTENTIONAL_EMPTY_NOOP: 上游 jsrgqingxi（skill.js:7140）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：出牌阶段限一次摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
