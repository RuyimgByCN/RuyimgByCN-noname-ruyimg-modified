// jsrgxunji（勋济）：结束阶段，若你本回合对本回合使用牌指定过的其他角色均造成过伤害，则你可以将本回合造成过伤害的牌对应的位于弃牌堆的实体牌分配给任意角色各一张。
// 未建模：延迟动画, 历史查询, 翻译调用, 全局状态（DSL无对应原语）
skill jsrgxunji(3343239099) {
  // INTENTIONAL_EMPTY_NOOP: 上游 jsrgxunji（skill.js:13871）含真实规则体，DSL 原语暂不足以
  // 精确建模（保真度债；原 audio-only 注记经 2026-08-21 上游体复核证伪）。
  // 原“批量最小近似：结束阶段可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
