// 博言：出牌阶段限两次拼点；没赢的角色本回合不能使用手牌并摸两张牌，平局双方均执行。
skill jyboyan(3987086504) {
  active play_phase uses_per_turn 2 targets 1 1 other can_compare select_hand 1 1 {
    effect choose_compare_selected_hand_card(self, event_source, 2251726731, 2151014347);
  }
}

skill jyboyan_win(2251726731) {
  trigger hand_compare_finished owner_is_target_once {
    effect add_skill_until_turn_end(event_source, 3400903940);
    effect draw_cards(event_source, 2);
    effect remove_skill(self_skill);
  }
}

skill jyboyan_lose(2151014347) {
  trigger hand_compare_finished owner_is_target_once {
    effect add_skill_until_turn_end(self, 3400903940);
    effect draw_cards(self, 2);
    if event_amount == 1 {
      effect add_skill_until_turn_end(event_source, 3400903940);
      effect draw_cards(event_source, 2);
    }
    effect remove_skill(self_skill);
  }
}

skill jyboyan_effect(3400903940) {
  modifier hand_card_use_response_cancel override 1;
}
