// 抬棺：弃一张牌，令攻击范围内的目标弃牌；非杀且其体力不低于自己时视为决斗。
skill dragtaiguan(3898790253) {
  active play_phase
      uses_per_turn owner_lost_hp_min_one
      targets 1 1 other in_attack_range hand_equip_nonempty
      select_he 1 1 {
    effect discard_selected(self);
    effect target_discard_then_duel_if_non_sha_and_hp_gte_owner(
      self,
      event_source
    );
  }
}
