// 策算：防止伤害并失去一点体力上限；仅体力随上限下降时摸牌。
skill nscesuan(3127862270) locked {
  // 过滤器修正（2026-08-06，C 段 omp）：上游 damageBegin3 forced 每次伤害触发
  // （无每回合限次）；owner_is_target_once 误加限次，改回 owner_is_target。
  trigger damage_before owner_is_target {
    effect prevent_current_damage();
    if hp(self) == max_hp(self) {
      effect change_max_hp(self, -1);
      effect draw_cards(self, 1);
    } else {
      effect change_max_hp(self, -1);
    }
  }
}
