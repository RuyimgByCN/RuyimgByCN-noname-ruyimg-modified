// 虚泄（邢道荣）：出牌阶段开始时，你失去 1 点体力上限，然后选择一项：①弃置与你
// 距离为 1 的每名角色各一张牌；②令与你距离为 1 的每名角色各摸一张牌。出牌阶段
// 结束时，若存在体力上限大于你的角色，你恢复 1 点体力上限。
// 旧 JS 仅作语义证据；上限牺牲、相邻判定与分支由 resolve_xuxie /
// resolve_xuxie_add 权威状态机校验（ABI 483）。
skill xuxie(3207964441) {
  trigger phase_play owner_is_target {
    effect resolve_xuxie(self);
  }
  trigger phase_play_end owner_is_target {
    effect resolve_xuxie_add(self);
  }
}
