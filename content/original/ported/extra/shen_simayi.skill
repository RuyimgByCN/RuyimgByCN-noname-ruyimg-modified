skill jilue_wansha(3522766701) {
  modifier tao_use_save_cancel_for_non_dying_others_during_owner_turn override owner_skill_mark;

  trigger dying owner_alive_current_turn {
    if 0 < mark_count(self, 3522766701) {
      effect set_non_locked_skill_suppression(self, 1);
    }
  }

  trigger dying_after owner_alive_current_turn {
    if 0 < mark_count(self, 3522766701) {
      effect set_non_locked_skill_suppression(self, 0);
    }
  }

  active play_phase uses_per_turn 1 mark_at_least 3085167840 1 {
    effect resolve_shen_simayi(self, self, 0, 3085167840, 2);
  }

  trigger turn_ended owner_is_target {
    effect remove_mark(self, 3522766701, 0);
  }
}
