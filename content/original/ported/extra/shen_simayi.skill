skill sbaiyin(2725045502) locked non_gainable {
  trigger phase_prepare owner_is_target {
    if 3 < mark_count(self, 3085167840) {
      effect change_max_hp(self, -1);
      effect add_skill(self, 4138291948);
      effect add_skill(self, 3991027258);
      effect add_skill(self, 3045250601);
      effect add_skill(self, 2747240883);
      effect add_skill(self, 3079429948);
      effect add_skill(self, 3522766701);
      effect remove_skill(self_skill);
    }
  }
}

