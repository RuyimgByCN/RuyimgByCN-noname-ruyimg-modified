// 龙怒：每个出牌阶段切换分支；首次为失去体力、红手牌转无距离火杀，
// 下次为减体力上限、锦囊转不限次数雷杀。
skill nzry_longnu(2666801006) locked {
  trigger phase_play owner_is_target {
    effect resolve_nzry_longnu(self, 3653578858, 2167979660);
  }
}

skill nzry_longnu_1(3653578858) locked {
  view_as sha any red from hand ignore_distance nature fire;

  trigger phase_play_end owner_is_target {
    effect remove_skill(self_skill);
  }
}

skill nzry_longnu_2(2167979660) locked {
  view_as sha any card_trick from hand nature thunder;
  modifier card_use_unlimited(sha_thunder) override 1;

  trigger phase_play_end owner_is_target {
    effect remove_skill(self_skill);
  }
}

// 结营：开局保持横置且不可重置；所有横置角色手牌上限 +2（多名拥有者不叠加）；
// 结束阶段强制横置一名其他未横置角色。
skill nzry_jieying(3363786286) locked {
  trigger game_started owner_alive {
    effect add_mark(self, 2, 1);
  }

  trigger phase_end owner_is_target {
    effect choose_link_other(self);
  }

  modifier link_loss_cancel override 1;
  modifier global_hand_limit add queried_player_linked_first_living_skill_owner;
  modifier global_hand_limit add queried_player_linked_first_living_skill_owner;
}
