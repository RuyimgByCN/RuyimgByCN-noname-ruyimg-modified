// 势孙綝：旧 JavaScript 仅作语义证据，不进入运行时或 npack。
skill potnigu(3220807381) {
  active play_phase uses_per_turn 1 select_he 1 4 distinct_suits {
    effect discard_selected(self);
    effect resolve_potnigu(self, 0);
  }
  trigger damage_before owner_is_source {
    effect resolve_potnigu(self, 3);
  }
  trigger turn_ended owner_is_target {
    effect resolve_potnigu(self, 4);
  }
}

skill potlulian(2734921313) locked {
  trigger card_used owner_is_source {
    effect resolve_potlulian(self, event_card, 0);
  }
  trigger card_resolved owner_is_source {
    effect resolve_potlulian(self, event_card, 1);
  }
}
