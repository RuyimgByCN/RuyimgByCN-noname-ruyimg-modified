// 势于吉：道转 / 符济。旧 JavaScript 仅作语义合同。
skill potdaozhuan(4200000577) {
  view_as basic any any from none cost potdaozhuan;
}

skill potfuji(4200000578) {
  active play_phase uses_per_turn 1
    targets 1 8 other match_selected_card_count
    select_he 1 8 {
    effect resolve_potyuji(self, event_player, event_card, 0);
  }
}

skill potfuji_effect(4200000579) locked {
  trigger card_used owner_is_source {
    effect resolve_potyuji(self, event_player, event_card, 1);
  }
  trigger damage_before owner_is_source {
    effect resolve_potyuji(self, event_player, event_card, 2);
  }
  trigger card_resolved owner_is_source {
    effect resolve_potyuji(self, event_player, event_card, 3);
  }
}

skill potfuji_sha(4200000580) locked {
  trigger card_used owner_is_source {
    effect resolve_potyuji(self, event_player, event_card, 4);
  }
  trigger card_resolved owner_is_source {
    effect resolve_potyuji(self, event_player, event_card, 6);
  }
  trigger phase_begin owner_is_target {
    effect resolve_potyuji(self, event_player, event_card, 8);
  }
}

skill potfuji_shan(4200000581) locked {
  trigger card_used owner_is_source {
    effect resolve_potyuji(self, event_player, event_card, 5);
  }
  trigger card_resolved owner_is_source {
    effect resolve_potyuji(self, event_player, event_card, 7);
  }
  trigger phase_begin owner_is_target {
    effect resolve_potyuji(self, event_player, event_card, 8);
  }
}
