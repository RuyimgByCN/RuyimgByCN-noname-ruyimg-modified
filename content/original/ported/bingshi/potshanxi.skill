// 于 phaseEnd 弃置全部带标手牌。
// INTENTIONAL_EMPTY_NOOP: 「gaintag 应机牌标记」机制族缺口（展示/明置族，批 187
// 普查第 8 族）——标记注入、按标取牌、目标去重存储均无原语；2026-09-09 上游增量
// （ad3bc6ca..d6081fd1）新将批迁移，诚实 noop（保真度债，ADR 0597）。
skill potshanxi(2372417115) {
  modifier hand_limit add 0;
}
