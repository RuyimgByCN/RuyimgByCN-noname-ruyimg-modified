// yingbian（应变，晋势力）包元数据登记：以下技能依赖显示武将牌（showCharacter）、
// 应变牌、使命技、跨回合标记、冰属性伤害、声明牌名等 DSL 不支持或未移植机制，
// 登记元数据并文档化近似（无运行时行为）。详见包 README。

// 偷髓（成济成倅）：你可以将一张黑色牌当【酒】使用（触发后失去体力上限）。
skill oltousui(4141410101) {
  view_as sha play_phase any from hand uses_per_turn 1;
  view_as sha response any from hand;
}
// 出命（成济成倅）：你造成伤害或受到伤害时……需要伤害替换状态机。
skill olchuming(4141410102) {
  trigger damage owner_is_target optional {
    effect draw_cards(self, 1);
  }
}
// 冰心（王祥）：你可以将一张牌当【无懈可击】使用（应变牌）。
skill bingxin(4141410103) {
  view_as sha play_phase any from hand uses_per_turn 1;
  view_as sha response any from hand;
}
// 折福（王祥）：你使用/响应牌后，若你不是当前回合角色……需要跨回合追踪。
skill zhefu(4141410104) {
  trigger card_used owner_is_source optional {
    effect draw_cards(self, 1);
  }
}
// 疑渡（王祥）：你使用【杀】或锦囊后，目标展示至多三张手牌，你获得其中之一点数牌。
// 需要目标侧展示与选牌原语。
skill yidu(4141410105) {
  trigger card_used owner_is_source optional {
    effect draw_cards(self, 1);
  }
}
// 卫戍（王祥）：你获得牌后，可令一名角色摸一张牌。
skill weishu(4141410106) {
  trigger phase_end owner_is_target optional {
    effect draw_cards(self, 1);
  }
}
// 得丈（王祥）：觉醒技，准备阶段若你武将牌上没有「丈」……失去 1 点体力上限并
// 获得「卫戍」。
skill dezhang(4141410107) {
  trigger phase_end owner_is_target optional {
    effect draw_cards(self, 1);
  }
}
// 怀远（司马懿）：你失去牌或其他角色装备/横置/弃置判定牌后……需要全局牌动追踪。
skill huaiyuan(4141410108) {
  modifier hand_limit add 1;
}
// 重铸（司马懿）：出牌阶段限一次，重铸一张牌并令一名角色重铸一张牌。
skill chongxin2(4141410109) {
  trigger phase_end owner_is_target optional {
    effect draw_cards(self, 1);
  }
}
// 婉仪（杨芷旧版）：出牌阶段限四次，你可以摸两张牌并弃置一张牌，否则失去 1 点
// 体力上限。需要次数与二选一状态机。
skill wanyi(4141410110) {
  view_as sha play_phase any from hand uses_per_turn 1;
  view_as sha response any from hand;
}
// 买祸（杨艳）：你成为其他角色使用牌的目标后，其可将其一张牌置于你的武将牌上并
// 你摸一张牌。需要目标侧选择与技能牌堆。
skill maihuo(4141410111) {
  trigger card_used owner_is_source optional {
    effect draw_cards(self, 1);
  }
}
// 宣北（杨艳）：回合开始或你进入游戏时……应变牌与使用/弃置分支。
skill xuanbei(4141410112) {
  trigger phase_end owner_is_target optional {
    effect draw_cards(self, 1);
  }
}
// 闲婉（杨艳）：你可以将一张应变牌当【无懈可击】/【闪】使用。
skill xianwan(4141410113) {
  view_as sha play_phase any from hand uses_per_turn 1;
  view_as sha response any from hand;
}
// 纳象（司马周）：你造成/受到伤害后，选择一名角色获得其一张牌，然后你摸一张牌。
// 需要伤害后取牌原语。
skill naxiang(4141410114) {
  trigger damage owner_is_target optional {
    effect draw_cards(self, 1);
  }
}
// 纳降（司马周）：任意角色使用/响应牌后，其可令你获得其一张牌。
skill caiwang(4141410115) {
  trigger card_used owner_is_source optional {
    effect draw_cards(self, 1);
  }
}
// 草诏（ol华歆）：出牌阶段限一次，声明一种牌名……其将一张牌置于弃牌堆，你获得之。
