// 金睛（无名）：锁定技。纯AI/元技能——查看其他角色手牌（viewHandcard），无实际游戏机制效果。
// 旧JS仅有ai.viewHandcard和ai.skillTagFilter，无trigger/content。DSL无AI提示建模，以空定义占位。
skill dcjinjing(3747225079) locked {
  // INTENTIONAL_EMPTY_NOOP: unexpressible/charlotte/audio helper; hand_limit +0 keeps non-empty body.
  modifier hand_limit add 0;
}
