// 矫金：受到伤害时可弃置一张非伤害锦囊或装备牌，取消伤害并获得伤害牌。
// 旧 JS 的「弃置特定类型牌取消伤害+回收伤害牌」无对应原语，以下给空定义。
skill oljiaojin(2199600596) {
  // INTENTIONAL_EMPTY_NOOP: 上游 oljiaojin 含真实规则体（trigger 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：受伤后可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
