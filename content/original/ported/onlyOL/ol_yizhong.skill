// 毅重：锁定技，黑色杀指定手牌数不大于你的目标时不可响应；
// 若你被黑色杀指定且来源体力值不小于你，取消此杀。
// 旧 JS 的「黑杀对手牌不高于己者不可响应」+「被黑杀且来源体力不低于己则取消」
// 需 card_use_unrespondable 过滤器配合手牌/体力条件判断，以下给近似+空定义。
skill ol_yizhong(3708139524) {
  // INTENTIONAL_EMPTY_NOOP: 上游 ol_yizhong 含真实规则体（trigger 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：用牌后可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
