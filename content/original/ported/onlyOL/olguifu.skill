// 诡伏：每轮/体力变化时获得不计手牌上限的随机闪；
// 记录造成伤害的牌名/技能名，此闪可当记录牌使用。旧 JS 的「记录+转化+专属标记」复杂链路无对应原语，以下给空定义。
skill olguifu(4061156187) {
  // INTENTIONAL_EMPTY_NOOP: 上游 olguifu 含真实规则体（trigger、mod 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：视为【杀】”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
