// 镇军：准备阶段选择一名角色，弃置其至少（手牌数-体力值）张牌（最少1张），
// 然后你须弃置等量的非装备牌；若不弃，其在你结束阶段摸等量牌。
// 旧 JS 的复杂二段抉择+延迟摸牌逻辑无对应原语，以下给空定义。
skill ol_zhenjun(4192815082) {
  // INTENTIONAL_EMPTY_NOOP: 上游 ol_zhenjun 含真实规则体（trigger 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：结束阶段可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
