// 绝颜：展示手牌中一张普通锦囊牌或红色基本牌并视为使用之；
// 每轮每类型限一次；每轮每种花色首次被展示时摸1张。
// 旧 JS 的「展示+转化+类型/花色追踪」无对应原语，以下给空定义。
skill oljueyan(2311479440) {
  // INTENTIONAL_EMPTY_NOOP: 上游 oljueyan 含真实规则体（enable 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：视为【杀】”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
