// 封赏：出牌阶段/有角色濒死时，从弃牌堆选择两张同花色牌分配给两名角色；
// 若未以此获得过牌且可用酒则视为使用酒。旧 JS 的「弃牌堆选牌+双目标分配+酒使用」
// 无对应原语，以下给空定义。
skill olfengshang(2855226800) {
  // INTENTIONAL_EMPTY_NOOP: 上游 olfengshang 含真实规则体（trigger、enable 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：出牌阶段限一次摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
