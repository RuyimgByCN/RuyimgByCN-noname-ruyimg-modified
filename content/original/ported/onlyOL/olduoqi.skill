// 夺气：锁定技，每轮首个回合结束前，你插入一个额外出牌阶段；
// 首次对该角色造成伤害时从起始手牌获得一张。
// 旧 JS 的「插入阶段+回合替换+起始手牌追踪+首次伤害回收」复杂逻辑无对应原语，以下给空定义。
skill olduoqi(3893978989) {
  // INTENTIONAL_EMPTY_NOOP: 上游 olduoqi 含真实规则体（trigger 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：手牌上限 +1”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
