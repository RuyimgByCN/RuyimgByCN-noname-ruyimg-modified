// 行令：出牌阶段可将一张杀或锦囊交给其他角色，其选择使用之或跳过判定+摸牌阶段。
// 若使用则双方各摸一张。旧 JS 的「交给牌后对方选择使用或跳过阶段」分支逻辑
// 无对应原语，以下为近似：用 active 交牌并让目标进行抉择。
// 未建模：交牌后目标使用牌 / 跳过判定+摸牌的分支；仅给出空定义。
skill caopi_xingdong(2309539860) {
  // INTENTIONAL_EMPTY_NOOP: 上游 caopi_xingdong 含真实规则体（enable、filterTarget、usable 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：出牌阶段限一次摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
