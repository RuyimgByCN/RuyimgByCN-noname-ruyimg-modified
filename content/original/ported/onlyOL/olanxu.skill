// 安恤：出牌阶段选择两名角色（可含自己），获得区域内一张牌，
// 然后手牌较少的一方若你还可展示并交出一张牌，若非黑桃你摸一张。
// 旧 JS 的「双目标分别选择区域+比较手牌数+展示交牌分支」逻辑无对应原语，
// 以下给空定义。
skill olanxu(4242915133) {
  // INTENTIONAL_EMPTY_NOOP: 上游 olanxu 含真实规则体（enable、usable、selectTarget 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：出牌阶段限一次摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
