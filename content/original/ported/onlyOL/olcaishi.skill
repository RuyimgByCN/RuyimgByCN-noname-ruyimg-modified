// 才识：每回合首次使用一种类型的牌后，手牌上限+1；
// 若已受伤角色存在，可令一名角色回复1点体力，然后此技能本回合失效。
// 旧 JS 的「类型追踪+手牌上限递增+条件回复+技能自ban」无完整对应原语，
// 以下给空定义。
skill olcaishi(2306696931) {
  // INTENTIONAL_EMPTY_NOOP: 上游 olcaishi 含真实规则体（trigger 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：手牌上限 +1”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
