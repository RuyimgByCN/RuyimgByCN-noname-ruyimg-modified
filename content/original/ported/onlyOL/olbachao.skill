// 霸朝：出牌阶段开始时，其他角色可交给你一张牌；
// 然后你可对未交非基本牌的角色造成1点伤害；若对自己造成伤害则本回合获得额外效果。
// 旧 JS 的「多人交牌+伤害选择+状态标记+后续不占次数」复杂链路无对应原语，
// 以下给空定义。
skill olbachao(2983834619) {
  // INTENTIONAL_EMPTY_NOOP: 上游 olbachao 含真实规则体（trigger 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：手牌上限 +1”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
