// 胆持（旧OL·SB版）：造成/受到牌伤害后，目标猜测你本回合下次使用的牌类型；
// 猜对者摸2张，猜错者视为使用杀。旧 JS 的「猜测机制+延时判定+分支奖励」无对应原语，
// 以下给空定义。
skill old_olsbdanchi(3662321185) {
  // INTENTIONAL_EMPTY_NOOP: 上游 old_olsbdanchi 含真实规则体（trigger 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：受伤后可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
