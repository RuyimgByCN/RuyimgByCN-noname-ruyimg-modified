// 醇醪（OL版）：锁定技，你或相邻角色弃置的杀置入「醇」区（最多9张）；
// 可将其当酒使用进行濒死救援；每回合因失去体力可回收醇牌。
// 旧 JS 的「expansion区+筛选相邻角色弃杀+酒转化+回收」无对应原语，以下给空定义。
skill olchunlao(2155344541) {
  // INTENTIONAL_EMPTY_NOOP: 上游 olchunlao（skill.js:13288）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
