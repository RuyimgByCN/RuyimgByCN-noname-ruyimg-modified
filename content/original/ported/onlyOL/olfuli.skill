// 伏枥：限定技；濒死时回复并补牌至存活势力数，累计伤害不足该值时翻面。
skill olfuli(3137508676) {
  trigger dying owner_is_target optional {
    let groups = alive_group_count();
    effect recover_hp(self, groups - hp(self));
    if hand_count(self) < groups {
      effect draw_cards(self, groups - hand_count(self));
    }
    if lifetime_damage_dealt(self) < groups {
      effect turn_over(self);
    }
    effect remove_skill(self_skill);
  }
}
