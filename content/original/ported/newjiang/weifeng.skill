// 威风（刘备）：锁定技。你使用牌后，选择一名其他角色获得「惧」标记；
// 拥有「惧」标记的角色对你造成伤害时，你弃置其一张牌并移除标记。
// 旧 JS 的「惧标记跨角色授予与移除」无对应原语，未建模（已注明）；
// weifeng2 已作为标记展示占位。
skill weifeng(3512717787) locked {
  // INTENTIONAL_EMPTY_NOOP: unexpressible/charlotte/audio helper; hand_limit +0 keeps non-empty body.
  modifier hand_limit add 0;
}
