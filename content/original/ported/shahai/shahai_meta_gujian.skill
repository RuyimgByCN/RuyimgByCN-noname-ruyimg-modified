// 修正：原跨界机制注记经 2026-08-22 复核证伪（phaseEnd 最少体力 changeHujia）。
// 旧 JavaScript 只作语义证据，不进入 npack 或运行时。
skill liyutang(1246457632) {
  trigger phase_end owner_min_hp {
    effect add_mark(self, 3, 1);
  }
}
// yougeng（酉羹）：准备阶段，若你的体力值为全场最少或之一，你回复1点体力，持续两回合。
// 实现：`trigger phase_prepare owner_min_hp` forced → body 守卫
// `hp(self) < max_hp(self)`（上游 isDamaged 门槛）→ recover_hp(self, 1)。
// 近似：同 liyutang——无持续回合；isMinHp 由过滤器表达、isDamaged 由 body-if 表达。
// 修正：原跨界机制注记经 2026-08-22 复核证伪（phaseBegin 受伤且最少体力 recover）。
// 旧 JavaScript 只作语义证据，不进入 npack 或运行时。
skill yougeng(2130169647) {
  trigger phase_prepare owner_min_hp {
    if hp(self) < max_hp(self) {
      effect recover_hp(self, 1);
    }
  }
}
