// 旧 JavaScript 只作语义证据，不进入 npack 或运行时。
skill rexue(3080267505) {
  trigger phase_prepare owner_alive optional {
    effect choose_use_virtual_sha(self, normal_distance);
    effect draw_cards(self, 1);
  }
}
