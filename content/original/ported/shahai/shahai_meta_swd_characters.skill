// add_mark(event_source, 2, 1)（横置来源）+ draw_cards(self, 1)。
// 近似：上游弃置限黑色牌；分支（已横置→翻面 / 已翻面→失去体力）无状态
// 表达式，取主分支（未横置→横置+摸牌）固定执行。
// 修正：原跨界机制注记经 2026-08-22 复核证伪（useCardToBegin black 横置/翻面）。
// 旧 JavaScript 只作语义证据，不进入 npack 或运行时。
skill ningshuang(1602703733) {
  trigger card_targeted owner_alive_targeted_by_other_black_card optional {
    effect discard_hand_equip_count(self, 1);
    effect add_mark(event_source, 2, 1);
    effect draw_cards(self, 1);
  }
}
