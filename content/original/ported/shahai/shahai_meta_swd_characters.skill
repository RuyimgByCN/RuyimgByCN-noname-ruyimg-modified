// ljifeng（疾风）：锁定技，你的攻击范围+X，【杀】可以额外指定 X 个目标
//（X 为你已损失的体力值）。
// 实现：`modifier distance_from add -owner_lost_hp`（attackFrom 等价）。
// 近似：『杀可额外指定 X 个目标』因 card_target_limit 仅收常量而未建模
//（上游 selectTarget range[1] += 已损体力）。
// 修正：原 noop 注记称依赖跨界包专属机制，上游（swd/skill.js:7869）实为纯
// modifier 技，经 2026-08-21 上游体复核证伪。
// 旧 JavaScript 只作语义证据，不进入 npack 或运行时。
skill ljifeng(3765349055) locked {
  modifier distance_from add -owner_lost_hp;
}
// lxianglong（翔龙）：每当你闪避一张【杀】，你可以视为使用一张【杀】。
// 实现：`trigger sha_dodged owner_is_player optional` →
// choose_use_virtual_sha(self, normal_distance)。
// （ShaDodged 事件 ctx.player=被闪者、ctx.source=出杀者——owner_is_player
// 即「我闪避了杀」，零新过滤器。）
// 近似：上游以被闪的实体杀为素材 useCard（norestore），DSL 虚拟杀无素材。
// 修正：原跨界机制注记经 2026-08-22 复核证伪（shaMiss 视为出杀）。
// 旧 JavaScript 只作语义证据，不进入 npack 或运行时。
skill lxianglong(4007504303) {
  trigger sha_dodged owner_is_target optional {
    effect choose_use_virtual_sha(self, normal_distance);
  }
}
