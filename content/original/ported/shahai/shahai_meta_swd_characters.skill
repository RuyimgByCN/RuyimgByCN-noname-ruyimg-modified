// huajin（化金）：出牌阶段限一次，你可以弃置一张牌令你造成的伤害+1，直到你的下一回合开始。
// 实现：`modifier damage_amount add owner_skill_mark` +
// `active play_phase uses_per_turn 1` → 弃1 + add_mark 武装；
// `trigger phase_prepare owner_is_target` forced → 清全部标记
// （「直到下一回合开始」= 自己下个回合准备阶段，时点精确）。
// 近似：无（huajin2 临时技的 mark 等价表达）。
// 修正：原跨界机制注记经 2026-08-22 复核证伪（phaseUse 弃牌+伤害+1 至下回合）。
// 旧 JavaScript 只作语义证据，不进入 npack 或运行时。
skill huajin(3382516484) {
  modifier damage_amount add owner_skill_mark;

  active play_phase uses_per_turn 1 {
    effect discard_hand_equip_count(self, 1);
    effect add_mark(self, 3382516484, 1);
  }
  trigger phase_prepare owner_is_target {
    let m = mark_count(self, 3382516484);
    effect remove_mark(self, 3382516484, m);
  }
}
