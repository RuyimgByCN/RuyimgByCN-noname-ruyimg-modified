// 触发后自移除即等价「下一次」）。
// 修正：原跨界机制注记经 2026-08-21 复核证伪（damageBegin 减伤+自失）。
// 旧 JavaScript 只作语义证据，不进入 npack 或运行时。
skill tuteng3(764613100) locked {
  trigger damage_before owner_is_target {
    effect modify_current_damage(self, -1);
    effect remove_skill(self_skill);
  }
}
// tuteng4（空气图腾）：在你的回合内，你的锦囊牌造成的首次伤害+1。
// 实现：`trigger damage_before owner_source_trick` forced + body
// `current_phase_player()==self`（回合内）+ storage 首次门槛 →
// modify_current_damage(self, 1)；turn_ended 清零（usable:1 等价）。
// 近似：上游 notLink() 排除铁索传导，DSL 不分传导。
// 修正：原跨界机制注记经 2026-08-22 复核证伪（damageBegin 回合内首伤+1）。
// 旧 JavaScript 只作语义证据，不进入 npack 或运行时。
skill tuteng4(4224257102) locked {
  trigger damage_before owner_source_trick {
    if current_phase_player() == self {
      if storage_get(self_skill, 1) == 0 {
        effect storage_set(self_skill, 1, 1);
        effect modify_current_damage(self, 1);
      }
    }
  }
  trigger turn_ended owner_is_target {
    effect storage_set(self_skill, 1, 0);
  }
}
