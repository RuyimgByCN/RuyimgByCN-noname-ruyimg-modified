// feng（风）：锁定技，当你累计摸2次牌后，你下一次摸牌时摸牌数+1。
// 实现：`modifier draw_count add owner_skill_mark`（武装时 +1）+
// `trigger cards_drawn owner_is_target` forced 计数状态机 →
// 已武装（mark==1）：本次摸牌已享 +1，remove_mark 解除；
// 未武装且计数==1：清零并 add_mark 武装（下一次摸牌 +1）；否则计数+1。
// 近似：上游在 drawBegin 当拍对第 3 次摸牌 +1；DSL 以「两次后武装 mark、
// 下一次摸牌吃 modifier、摸后解除」等效表达——固定摸牌路径不应用
// modifier 的场景会漏（罕见）。
// 修正：原跨界机制注记经 2026-08-22 复核证伪（drawBegin 计数+下一次+1）。
// 旧 JavaScript 只作语义证据，不进入 npack 或运行时。
skill feng(953027553) locked {
  modifier draw_count add owner_skill_mark;

  trigger cards_drawn owner_is_target {
    if mark_count(self, 953027553) == 1 {
      effect remove_mark(self, 953027553, 1);
    } else {
      if storage_get(self_skill, 1) == 1 {
        effect storage_set(self_skill, 1, 0);
        effect add_mark(self, 953027553, 1);
      } else {
        effect storage_set(self_skill, 1, 1);
      }
    }
  }
}
