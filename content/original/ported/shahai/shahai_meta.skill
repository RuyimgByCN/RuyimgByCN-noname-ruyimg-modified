// shenqiang（神枪）：锁定技，每当你在出牌阶段使用【杀】造成伤害，本阶段内出杀次数上限+1。
// 实现：`modifier sha_use_limit add owner_skill_mark`（每标记出杀上限+1）+
// `trigger damage owner_source_sha` forced + body `current_phase_player()==self`
// （出牌阶段门槛，回合内近似）→ add_mark；turn_ended 清零（tuji 同款）。
// 近似：上游退还当次杀计数（getStat.card.sha--），DSL 等价为上限+1；
// 「出牌阶段」以「回合内」近似；本阶段→本回合清零粒度。
// 修正：原跨界机制注记经 2026-08-22 复核证伪（damageEnd 杀 退还次数）。
// 旧 JavaScript 只作语义证据，不进入 npack 或运行时。
skill shenqiang(1521132567) locked {
  modifier sha_use_limit add owner_skill_mark;

  trigger damage owner_source_sha {
    if current_phase_player() == self {
      effect add_mark(self, 1521132567, 1);
    }
  }
  trigger turn_ended owner_is_target {
    let m = mark_count(self, 1521132567);
    effect remove_mark(self, 1521132567, m);
  }
}
