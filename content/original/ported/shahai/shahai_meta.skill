// huiqi（回气）：每当你受到一次伤害，可令一名其他角色摸X张牌，X为你已损失的体力值。
// 实现：`trigger damage owner_is_target optional` + body `hp<max` 守卫 →
// `let n = max_hp(self) - hp(self);`（伤害后口径的已损失体力）→
// choose_other_draw_or_recover(self, n, 0, 1)（令一名其他角色摸 n）。
// 近似：无（clanjiejian 同款表达式张数）。
// 修正：原跨界机制注记经 2026-08-22 复核证伪（damageEnd 摸已损体力数）。
// 旧 JavaScript 只作语义证据，不进入 npack 或运行时。
skill huiqi(1073166029) {
  trigger damage owner_is_target optional {
    if hp(self) < max_hp(self) {
      let n = max_hp(self) - hp(self);
      effect choose_other_draw_or_recover(self, n, 0, 1);
    }
  }
}
