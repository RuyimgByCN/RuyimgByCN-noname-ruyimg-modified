// gudonggeng（骨董羹）：当你下一次受到杀造成的伤害时，令伤害-1，持续三回合。
// 实现：`trigger damage_before owner_is_target` forced →
// modify_current_damage(self, -1) + remove_skill(self_skill)（自移除表达「下一次」，
// tuteng 一次性图腾同款）。
// 近似：无三回合持续。（杀限定已收紧——第五批近似注记的「任何下一次伤害
// 均减 1」缺口由第四十四批 owner_target_sha 过滤器补齐，2026-08-22 收紧。）
// 修正：原跨界机制注记经 2026-08-22 复核证伪（damageBegin num-1+自移除）。
// 旧 JavaScript 只作语义证据，不进入 npack 或运行时。
skill gudonggeng(1840348640) {
  trigger damage_before owner_target_sha {
    effect modify_current_damage(self, -1);
    effect remove_skill(self_skill);
  }
}
// qingtuan（青团）：你在回合内使用首张杀时摸一张牌，持续两回合。
// 实现：`trigger card_used owner_source_sha` forced + body 守卫
// `current_phase_player() == self`（回合内）+ `storage_get(self_skill,1)==0`
// （本回合首张，turn_ended 清零）→ draw_cards(self, 1)。
// 近似：无两回合持续；usable:1 以 storage 表达。
// 修正：原跨界机制注记经 2026-08-22 复核证伪（useCard 杀 usable 1 摸牌）。
// 旧 JavaScript 只作语义证据，不进入 npack 或运行时。
skill qingtuan(502548858) {
  trigger card_used owner_source_sha {
    if current_phase_player() == self {
      if storage_get(self_skill, 1) == 0 {
        effect storage_set(self_skill, 1, 1);
        effect draw_cards(self, 1);
      }
    }
  }
  trigger turn_ended owner_is_target {
    effect storage_set(self_skill, 1, 0);
  }
}
// liyutang（鲤鱼汤）：结束阶段，若你的体力值为全场最少或之一，你获得1点护甲，持续两回合。
// 实现：`trigger phase_end owner_min_hp` forced → add_mark(self, 3, 1)
