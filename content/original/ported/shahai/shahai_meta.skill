// xiandan（弦弹?）：每当你使用一张【杀】，你可以弃置一张红色牌令此【杀】不可
// 闪避，或弃置一张黑色牌令此【杀】伤害+1。
// 实现：`trigger card_used owner_source_sha optional` → choose(1,2) 分支：
// 1 = 弃 1 + make_current_card_unrespondable；2 = 弃 1 +
// increase_current_card_base_damage(self, event_card, 1)（oldigong 同款）。
// 近似：所弃之牌颜色约束未建模（两分支均 hand_equip 任意一张）；整张杀一次生效。
// 修正：原跨界机制注记经 2026-08-21 复核证伪。
// 旧 JavaScript 只作语义证据，不进入 npack 或运行时。
skill xiandan(3140108402) {
  trigger card_used owner_source_sha optional {
    let o = choose(1, 2);
    if o == 1 {
      effect discard_hand_equip_count(self, 1);
      effect make_current_card_unrespondable(self, event_card, 3140108402);
    }
    if o == 2 {
      effect discard_hand_equip_count(self, 1);
      effect increase_current_card_base_damage(self, event_card, 1);
    }
  }
}
// xiandan2：上游 translate 无独立 info 条目（子技/衍生），描述见父技。
