// 旧 JavaScript 只作语义证据，不进入 npack 或运行时。
skill meihuo(2953576202) {
  trigger cards_moved owner_alive_event_player_from_equip_empty optional {
    effect gain_target_hand_card(self, self_skill);
  }
}
