// 旧 JavaScript 只作语义证据，不进入 npack 或运行时。
skill binxin(4230503518) {
  trigger phase_end owner_alive optional {
    if hp(event_player) == 1 {
      effect choose_other_add_mark(self, 3, 1);
    }
  }
}
