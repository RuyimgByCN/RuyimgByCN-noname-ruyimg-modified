        effect storage_set(self_skill, 1, 1);
        effect modify_current_damage(self, 1);
      }
    }
  }
  trigger turn_ended owner_is_target {
    effect storage_set(self_skill, 1, 0);
  }
}
// tuteng6（火舌图腾）：在你的回合内，你的【杀】造成的首次伤害+1。
// 实现：同 tuteng4（杀方向）——`damage_before owner_source_sha` +
// 回合内守卫 + storage 首次门槛 → modify +1；turn_ended 清零。
// 近似：notLink 传导排除未建模。
// 修正：原跨界机制注记经 2026-08-22 复核证伪（damageBegin 回合内首杀伤+1）。
// 旧 JavaScript 只作语义证据，不进入 npack 或运行时。
skill tuteng6(339193492) locked {
  trigger damage_before owner_source_sha {
    if current_phase_player() == self {
      if storage_get(self_skill, 1) == 0 {
        effect storage_set(self_skill, 1, 1);
        effect modify_current_damage(self, 1);
      }
    }
  }
  trigger turn_ended owner_is_target {
    effect storage_set(self_skill, 1, 0);
  }
}
// tuteng7（图腾七?）：结束阶段，你令一名其他角色回复 1 点体力。
// 实现：`trigger phase_end owner_is_target` forced → choose_other_recover(self, 1)。
// 近似：上游要求存在受伤的其他角色才发动，此处以原语无目标时静默近似。
// 修正：原跨界机制注记经 2026-08-21 复核证伪（phaseEnd 回复触发）。
// 旧 JavaScript 只作语义证据，不进入 npack 或运行时。
skill tuteng7(1954578579) {
  trigger phase_end owner_is_target {
    effect choose_other_recover(self, 1);
  }
}
// hongxi（烘曦?）：锁定技，每当有一名角色死亡，你将体力回复至体力上限。
// 实现：`trigger death owner_alive` forced + body if hp<max_hp →
// recover_hp(self, max_hp(self) - hp(self))（olxushen 回满同型）。
// 修正：原 noop 注记称依赖跨界包专属机制，上游（hearth/skill.js:7263）实为普通
// 死亡触发回复，经 2026-08-21 上游体复核证伪。
// 旧 JavaScript 只作语义证据，不进入 npack 或运行时。
skill hongxi(73507340) locked {
  trigger death owner_alive {
    if hp(self) < max_hp(self) {
      effect recover_hp(self, max_hp(self) - hp(self));
    }
  }
}
