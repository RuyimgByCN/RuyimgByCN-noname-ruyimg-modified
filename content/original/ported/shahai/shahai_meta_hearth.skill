// guozaix（过载）：出牌阶段限两次，你可将手牌补至四张，并于此阶段结束时弃置等量的牌。
// 实现：同 guozai（限两次变体）——active uses_per_turn 2 +
// phase_play_end 弃等量欠账。
// 近似：同 guozai（确定性弃置）。
// 修正：原跨界机制注记经 2026-08-22 复核证伪（usable:2 同体）。
// 旧 JavaScript 只作语义证据，不进入 npack 或运行时。
skill guozaix(457163821) {
  active play_phase uses_per_turn 2 {
    if hand_count(self) < 4 {
      let n = 4 - hand_count(self);
      effect draw_cards(self, n);
      effect storage_set(self_skill, 1, n);
    }
  }
  trigger phase_play_end owner_is_target {
    let m = storage_get(self_skill, 1);
    if m > 0 {
      effect discard_hand_equip_expr(self, m);
      effect storage_set(self_skill, 1, 0);
    }
  }
}
