// lianzhan（连斩）：每当你造成一次伤害，若此伤害是你本回合第一次造成伤害，你摸两张牌；否则你增加1点体力上限并回复1点体力。
// 实现：`trigger damage owner_is_source` forced + storage 首次门槛分支 →
// 首次（storage==0）：摸两张；否则：体力上限+1 并回复 1；turn_ended 清零
// （上游 getStat().damage 与 trigger.num 比较的等价 storage 表达）。
// 近似：无（首伤判定按伤害事件次数）。
// 修正：原跨界机制注记经 2026-08-22 复核证伪（damageEnd 首伤摸2/次伤加上限）。
// 旧 JavaScript 只作语义证据，不进入 npack 或运行时。
skill lianzhan(1293119497) locked {
  trigger damage owner_is_source {
    if storage_get(self_skill, 1) == 0 {
      effect storage_set(self_skill, 1, 1);
      effect draw_cards(self, 2);
    } else {
      effect change_max_hp(self, 1);
      effect recover_hp(self, 1);
    }
  }
  trigger turn_ended owner_is_target {
    effect storage_set(self_skill, 1, 0);
  }
}
