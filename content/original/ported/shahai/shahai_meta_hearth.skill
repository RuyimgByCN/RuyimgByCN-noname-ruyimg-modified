// guozai（过载）：出牌阶段限一次，你可将手牌补至四张，并于此阶段结束时弃置等量的牌。
// 实现：`active play_phase uses_per_turn 1` + body `hand_count < 4` →
// let n = 4 - hand_count → draw_cards(self, n) + storage_set 记欠账；
// `trigger phase_play_end owner_is_target` forced → storage_get 读欠账 →
// discard_hand_equip_expr(self, m) 弃等量并清零（上游 guozai2 子技）。
// 近似：上游 chooseToDiscard 玩家选牌，DSL 确定性弃前 m 张；
// storage 欠账跨回合不失效（上游阶段结束即结算，等价场景为同阶段）。
// 修正：原跨界机制注记经 2026-08-22 复核证伪（phaseUse 补至 4+阶段末弃等量）。
// 旧 JavaScript 只作语义证据，不进入 npack 或运行时。
skill guozai(1907094152) {
  active play_phase uses_per_turn 1 {
    if hand_count(self) < 4 {
      let n = 4 - hand_count(self);
      effect draw_cards(self, n);
      effect storage_set(self_skill, 1, n);
    }
  }
  trigger phase_play_end owner_is_target {
    let m = storage_get(self_skill, 1);
    if m > 0 {
      effect discard_hand_equip_expr(self, m);
      effect storage_set(self_skill, 1, 0);
    }
  }
}
