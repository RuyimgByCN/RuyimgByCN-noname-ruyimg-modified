// ziyu（自愈）：在一名角色的结束阶段，你可以回复1点体力或摸一张牌，每隔四回合发动一次。
// 实现：`trigger phase_end owner_alive optional` → choose(1, 2) 分支
// （回复 1 或摸 1，chooseDrawRecover 等价）。
// 近似：上游 game.phaseNumber % 4 === 0（每隔四回合）门槛无法表达，
// 每个结束阶段均可发动。
// 修正：原跨界机制注记经 2026-08-22 复核证伪（global phaseEnd chooseDrawRecover）。
// 旧 JavaScript 只作语义证据，不进入 npack 或运行时。
skill ziyu(2266084957) {
  trigger phase_end owner_alive optional {
    let option = choose(1, 2);
    if option == 1 {
      effect recover_hp(self, 1);
    }
    if option == 2 {
      effect draw_cards(self, 1);
    }
  }
}
