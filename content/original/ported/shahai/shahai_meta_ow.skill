// tuji（突击）：锁定技，在你的回合内，每当你使用一张牌，你的进攻距离-1
//（上游 globalFrom = distance - countUsed()）。
// 实现：`distance_from add -owner_skill_mark`（oltielun 同型标记管线）+
// card_used owner_alive_current_turn → add_mark(1) + turn_ended 清零。
// 近似：上游仅回合内生效；本实现以 current_turn 过滤器等价门控，回合外响应用牌
// 不计标记。与上游 countUsed 口径（含打出响应）的微小差异已注明。
// 修正：原 noop 注记称依赖跨界包专属机制，上游（ow/skill.js:2163）实为纯
// globalFrom modifier，经 2026-08-21 上游体复核证伪。
// 旧 JavaScript 只作语义证据，不进入 npack 或运行时。
skill tuji(3008175639) locked {
  modifier distance_from add -owner_skill_mark;

  trigger card_used owner_alive_current_turn {
    effect add_mark(self, 3008175639, 1);
  }

  trigger turn_ended owner_is_target {
    let marks = mark_count(self, 3008175639);
    effect remove_mark(self, 3008175639, marks);
  }
}
