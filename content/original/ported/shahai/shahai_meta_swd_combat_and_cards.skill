// shoulie（狩猎）：当你使用一张【杀】指定目标后，你可以弃置一张手牌令此【杀】
// 不可闪避。
// 实现：`trigger card_used owner_source_sha optional` →
// discard_hand_equip_count(self, 1) + make_current_card_unrespondable(self,
// event_card, 4057970364)（natuxing 同款，helper def=本技）。
// 近似：上游按每个目标的响应询问逐目标发动（shaBegin），此处整张杀一次生效；
// 所弃之牌未限定手牌（hand_equip 任意）。
// 修正：原跨界机制注记经 2026-08-21 复核证伪（普通杀强化触发）。
// 旧 JavaScript 只作语义证据，不进入 npack 或运行时。
skill shoulie(4057970364) {
  trigger card_used owner_source_sha optional {
    effect discard_hand_equip_count(self, 1);
    effect make_current_card_unrespondable(self, event_card, 4057970364);
  }
}
// hudun（护盾）：锁定技，当你对其他角色造成伤害后，若你没有护甲，你获得
// 1 点护甲值。
// 实现：`trigger damage owner_is_source` forced → add_mark(self, 3, 1)。
// 近似：「没有护甲」与「目标非己」门槛未建模（DSL 无 != 运算符，含自伤场景
// 亦触发）。
// 修正：原跨界机制注记经 2026-08-22 复核证伪（damageEnd 条件护甲）。
// 旧 JavaScript 只作语义证据，不进入 npack 或运行时。
skill hudun(2311509903) locked {
  trigger damage owner_is_source {
    effect add_mark(self, 3, 1);
  }
}
