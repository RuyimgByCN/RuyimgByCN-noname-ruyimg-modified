// 天义（孙翊系）：觉醒技。准备阶段开始时，若所有角色均已受过伤害，
// 你增加 2 点体力上限并回复 1 点体力，然后令一名角色获得技能〖佐幸〗。
// 旧 JS 的「全员受过伤害」判定无对应原语；以觉醒标记 + 加上限回复近似
// （授技未建模，已注明）。
skill stianyi(2680562426) {
  trigger phase_prepare owner_is_target {
    if mark_count(self, 2680562426) == 0 {
      effect change_max_hp(self, 2);
      effect recover_hp(self, 1);
      effect add_mark(self, 2680562426, 1);
    }
  }
}
