// mbzujin（阻进）：每回合每种牌名限一次，若你未受伤或体力值不为最低，你可将一张基本牌当作【杀】使用或打出；若你已受伤，你可将一张基本牌当作【闪】或【无懈可击】使用或打出。
// 未建模：subSkill, chooseButton 等机制无 DSL 原语。
skill mbzujin(3045957946) {
  // INTENTIONAL_EMPTY_NOOP: 上游 mbzujin（skill.js:12653）含真实规则体，DSL 原语暂不足以
  // 精确建模（保真度债；原 audio-only 注记经 2026-08-21 上游体复核证伪）。
  // 原“批量最小近似：视为【杀】”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
