// mbbeini（悖逆）：出牌阶段限一次，你可以选择一名体力值不小于你的其他角色，令你或其摸两张牌，然后未摸牌的角色选择一项：1.视为对摸牌的角色使用一张【杀】；2.获得摸牌的角色场上的一张牌。
skill mbbeini(3541120398) {
  // INTENTIONAL_EMPTY_NOOP: 上游 mbbeini（skill.js:12077）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
