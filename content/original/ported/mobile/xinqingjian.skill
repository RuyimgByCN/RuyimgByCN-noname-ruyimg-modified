// 清俭（xinqingjian）：每回合限一次，非额定摸牌得到牌后可将任意张手牌扣置于武将牌上；一名角色回合结束后将这些牌交给任意名其他角色（>1 张则摸一张）。
// 上游描述引自 translate.js；此前占位头（旧批量批次未写描述）已重记。
skill xinqingjian(3287169862) {
  // INTENTIONAL_EMPTY_NOOP: 上游 xinqingjian（skill.js:28916）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
