// 募讨（mutao）：出牌阶段限一次：令一名角色将手牌中所有【杀】置于其武将牌上，依次随机交给其下家起每名角色；对最后获【杀】者A造成X伤害（X=A手【杀】数，至多2）。
// 上游描述引自 translate.js；此前占位头（旧批量批次未写描述）已重记。
skill mutao(3817810883) {
  // INTENTIONAL_EMPTY_NOOP: 上游 mutao（skill.js:16168）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
