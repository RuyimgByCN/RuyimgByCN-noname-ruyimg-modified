// rekongsheng（箜声）：准备阶段、当你失去或回复体力后，你可以将当前回合角色的任意张牌扣置于其武将牌上。若如此做，该角色的结束阶段，你可以使用其中一张牌，然后其获得其余的牌。当你死亡时，所有角色收回其“箜声”牌。
// 未建模：expansion 等机制无 DSL 原语。
skill rekongsheng(2621934272) {
  // INTENTIONAL_EMPTY_NOOP: 上游 rekongsheng（skill.js:897）含真实规则体，DSL 原语暂不足以
  // 精确建模（保真度债；原 audio-only 注记经 2026-08-21 上游体复核证伪）。
  // 原“批量最小近似：受伤后可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
