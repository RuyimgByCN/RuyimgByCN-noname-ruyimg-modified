// mbchongcha（重差）：①你的点数大于等于10的牌不计入手牌上限，且使用时视为满足〖割圆〗中的点数0。②出牌阶段限一次，你可以弃置一张牌，令〖割圆〗中的X改为后移一位的值。
// 未建模：效果逻辑复杂，无合适 DSL 原语匹配。
skill mbchongcha(4050891557) {
  // INTENTIONAL_EMPTY_NOOP: 上游 mbchongcha（skill.js:4870）含真实规则体，DSL 原语暂不足以
  // 精确建模（保真度债；原 audio-only 注记经 2026-08-21 上游体复核证伪）。
  // 原“批量最小近似：手牌上限 +1”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
