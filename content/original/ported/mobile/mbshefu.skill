// 设伏（mbshefu）：结束阶段记录一个未记录的非装备牌名并扣置一张牌为「伏兵」；回合外其他角色用牌时可移去同名「伏兵」令其无效并摸一张。
// 上游描述引自 translate.js；此前占位头（旧批量批次未写描述）已重记。
skill mbshefu(2936942909) {
  // INTENTIONAL_EMPTY_NOOP: 上游 mbshefu（skill.js:1590）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
