// scspicai（庀材）：出牌阶段限一次。你可进行判定牌不置入弃牌堆的判定。若判定结果与本次发动技能时的其他判定结果的花色均不相同，则你可以重复此流程。然后你将所有位于处理区的判定牌交给一名角色。
// 未建模：效果逻辑复杂，无合适 DSL 原语匹配。
skill scspicai(2867074474) {
  // INTENTIONAL_EMPTY_NOOP: 上游 scspicai（skill.js:17641）含真实规则体，DSL 原语暂不足以
  // 精确建模（保真度债；原 audio-only 注记经 2026-08-21 上游体复核证伪）。
  // 原“批量最小近似：出牌阶段限一次摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
