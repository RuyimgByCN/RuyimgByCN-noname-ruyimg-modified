// hefeigaigong（慨公）：每回合限一次，你对其他角色造成伤害后，或受到其他角色造成的伤害后，你可以展示你或其的至多两张手牌，然后交换这些牌与牌堆底等量张牌。若此交换流程中的牌包含至少三种花色，你可使用其中一张牌（无次数限制）。
skill hefeigaigong(3180407327) {
  // INTENTIONAL_EMPTY_NOOP: 上游 hefeigaigong（skill.js:4272）含真实规则体，DSL 原语暂不足以
  // 精确建模（保真度债；原 audio-only 注记经 2026-08-21 上游体复核证伪）。
  // 原“批量最小近似：受伤后可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
