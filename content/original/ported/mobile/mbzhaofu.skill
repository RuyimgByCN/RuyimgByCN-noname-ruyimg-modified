// mbzhaofu（照抚）：每回合限一次，你可弃置所有手牌视为使用一张：1.【杀】；2.【闪】；3.【酒】；4.【桃】。若你因此恰好弃置了序号数张牌，你可令一名其他角色获得一个对应效果的【照抚】，且其发动后或其回合结束时失去对应效果的【照抚】。
// 未建模：subSkill, chooseButton 等机制无 DSL 原语。
skill mbzhaofu(2851432099) {
  // INTENTIONAL_EMPTY_NOOP: 上游 mbzhaofu（skill.js:120）含真实规则体，DSL 原语暂不足以
  // 精确建模（保真度债；原 audio-only 注记经 2026-08-21 上游体复核证伪）。
  // 原“批量最小近似：视为【杀】”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
