// xinqiaoshui（巧说）：出牌阶段限一次，你可以和一名其他角色拼点。若你赢，则你本阶段内使用下一张基本牌或普通锦囊牌时，可以为此牌增加或减少一个目标。若你没赢，你本阶段内不能使用锦囊牌。
// 未建模：效果逻辑复杂，无合适 DSL 原语匹配。
skill xinqiaoshui(3704958015) {
  // INTENTIONAL_EMPTY_NOOP: 上游 xinqiaoshui（skill.js:26425）含真实规则体，DSL 原语暂不足以
  // 精确建模（保真度债；原 audio-only 注记经 2026-08-21 上游体复核证伪）。
  // 原“批量最小近似：出牌阶段限一次摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
