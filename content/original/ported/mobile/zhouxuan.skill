// zhouxuan（周旋）：出牌阶段限一次，你可以指定一名敌方角色，然后选择一个基本牌的名称或非基本牌的类型。其使用或打出下一张牌时，若此牌的名称或类型和你选择的相同，则你观看牌堆顶的三张，然后将这些牌分配给任意名角色。
// 未建模：效果逻辑复杂，无合适 DSL 原语匹配。
skill zhouxuan(3937263895) {
  // INTENTIONAL_EMPTY_NOOP: 上游 zhouxuan（skill.js:28375）含真实规则体，DSL 原语暂不足以
  // 精确建模（保真度债；原 audio-only 注记经 2026-08-21 上游体复核证伪）。
  // 原“批量最小近似：手牌上限 +1”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
