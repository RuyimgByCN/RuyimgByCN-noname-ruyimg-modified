// tianshu（天书）：出牌阶段开始时，若场上没有【太平要术】，则你可以弃置一张牌并选择一名角色。该角色获得并使用【太平要术】。
// 未建模：效果逻辑复杂，无合适 DSL 原语匹配。
skill tianshu(3574568580) {
  // INTENTIONAL_EMPTY_NOOP: 上游 tianshu（skill.js:25068）含真实规则体，DSL 原语暂不足以
  // 精确建模（保真度债；原 audio-only 注记经 2026-08-21 上游体复核证伪）。
  // 原“批量最小近似：结束阶段可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
