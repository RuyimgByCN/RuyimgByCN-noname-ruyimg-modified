// yijie（遗诫）：锁定技。当你死亡时，你令所有其他角色将体力回复或失去至X（X为所有其他角色的体力之和除以所有其他角色数，向下取整，且X至少为1）。
// 未建模：效果逻辑复杂，无合适 DSL 原语匹配。
skill yijie(2974911724) {
  // INTENTIONAL_EMPTY_NOOP: 上游 yijie（skill.js:15712）含真实规则体，DSL 原语暂不足以
  // 精确建模（保真度债；原 audio-only 注记经 2026-08-21 上游体复核证伪）。
  // 原“批量最小近似：结束阶段可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
