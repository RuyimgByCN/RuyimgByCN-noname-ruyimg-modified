// mbfozong（佛宗）：锁定技，与你因〖净土〗获得的牌颜色相同的手牌不计入手牌上限，造成的伤害值和恢复值+1。
// 未建模：效果逻辑复杂，无合适 DSL 原语匹配。
skill mbfozong(3854865865) {
  // INTENTIONAL_EMPTY_NOOP: 上游 mbfozong（skill.js:8351）含真实规则体，DSL 原语暂不足以
  // 精确建模（保真度债；原 audio-only 注记经 2026-08-21 上游体复核证伪）。
  // 原“批量最小近似：手牌上限 +1”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
