// tiansuan（天算）：出牌阶段限一次，若场上没有因你产生的“命运签”，则你可以抽取一张“命运签”，然后令一名角色获得“命运签”直到你的下回合开始。若你以此法抽取的“命运签”为：上上签，你观看其手牌并获得其区域内的一张牌；上签，你获得其一张牌。
// 未建模：效果逻辑复杂，无合适 DSL 原语匹配。
skill tiansuan(2711510535) {
  // INTENTIONAL_EMPTY_NOOP: 上游 tiansuan（skill.js:23840）含真实规则体，DSL 原语暂不足以
  // 精确建模（保真度债；原 audio-only 注记经 2026-08-21 上游体复核证伪）。
  // 原“批量最小近似：出牌阶段限一次摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
