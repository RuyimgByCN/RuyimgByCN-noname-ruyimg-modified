// mbshishou（侍守）：锁定技。当你发动〖佐佑〗后，若目标角色不为你，你执行〖佐佑〗中目标角色未执行的一项。
// 未建模：效果逻辑复杂，无合适 DSL 原语匹配。
skill mbshishou(3507305192) {
  // INTENTIONAL_EMPTY_NOOP: 上游 mbshishou（skill.js:13229）含真实规则体，DSL 原语暂不足以
  // 精确建模（保真度债；原 audio-only 注记经 2026-08-21 上游体复核证伪）。
  // 原“批量最小近似：结束阶段可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
