// reqianxin（遣信）：出牌阶段限一次，你可将至多两张手牌随机交给等量的其他角色，称为「信」。这些角色的准备阶段开始时，若其手牌中有「信」，则其选择一项：令你摸两张牌，本回合手牌上限-2。
// 未建模：效果逻辑复杂，无合适 DSL 原语匹配。
skill reqianxin(4141035812) {
  // INTENTIONAL_EMPTY_NOOP: 上游 reqianxin（skill.js:29770）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：出牌阶段限一次摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
