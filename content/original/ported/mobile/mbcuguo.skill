// mbcuguo（蹙国）：锁定技，当你使用伤害牌指定目标后，弃置你与目标角色点数最大的手牌。若弃置了点数小于此牌的牌，此牌对所有目标额外结算一次。
// 未建模：效果逻辑复杂，无合适 DSL 原语匹配。
skill mbcuguo(3116827396) {
  // INTENTIONAL_EMPTY_NOOP: 上游 mbcuguo（skill.js:2374）含真实规则体，DSL 原语暂不足以
  // 精确建模（保真度债；原 audio-only 注记经 2026-08-21 上游体复核证伪）。
  // 原“批量最小近似：用牌后可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
