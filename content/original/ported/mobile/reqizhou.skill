// reqizhou（绮胄）：上游 translate.js 无独立 info 条目，描述见其父技/相邻条目。
// 未建模：效果逻辑复杂，无合适 DSL 原语匹配。
skill reqizhou(4010670701) {
  // INTENTIONAL_EMPTY_NOOP: 上游 reqizhou（skill.js:28677）含真实规则体，DSL 原语暂不足以
  // 精确建模（保真度债；原 audio-only 注记经 2026-08-21 上游体复核证伪）。
  // 原“批量最小近似：用牌后可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
