// gongsun（共损）：出牌阶段开始时，你可以弃置两张牌并指定一名其他角色。你选择一个基本牌或普通锦囊牌的牌名。直到你的下回合开始或你死亡，你与其不能使用或打出或弃置此名称的牌。
// 未建模：效果逻辑复杂，无合适 DSL 原语匹配。
skill gongsun(2268017256) {
  // INTENTIONAL_EMPTY_NOOP: 上游 gongsun（skill.js:27780）含真实规则体，DSL 原语暂不足以
  // 精确建模（保真度债；原 audio-only 注记经 2026-08-21 上游体复核证伪）。
  // 原“批量最小近似：结束阶段可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
