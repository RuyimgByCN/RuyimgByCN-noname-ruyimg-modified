// mbfutu（浮图）：①一名角色的回合结束时，若你本回合造成的伤害值/令任意角色回复的体力值为全场最高，你将牌堆顶首张黑色/红色牌置于武将牌上，称为“业”。②你受到伤害时，可以弃置一张“业”并防止此伤害。
// 未建模：subSkill, expansion 等机制无 DSL 原语。
skill mbfutu(3775829743) {
  // INTENTIONAL_EMPTY_NOOP: 上游 mbfutu（skill.js:7971）含真实规则体，DSL 原语暂不足以
  // 精确建模（保真度债；原 audio-only 注记经 2026-08-21 上游体复核证伪）。
  // 原“批量最小近似：结束阶段可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
