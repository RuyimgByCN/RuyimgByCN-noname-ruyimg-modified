// scschihe（叱吓）：当你使用【杀】指定唯一目标后，你可亮出牌堆顶的两张牌，令此【杀】的伤害值基数+X（X为亮出牌中花色与此【杀】相同的牌数），且目标角色不能使用亮出牌包含的花色的牌响应此【杀】。
// 未建模：效果逻辑复杂，无合适 DSL 原语匹配。
skill scschihe(2235003125) {
  // INTENTIONAL_EMPTY_NOOP: 上游 scschihe（skill.js:17915）含真实规则体，DSL 原语暂不足以
  // 精确建模（保真度债；原 audio-only 注记经 2026-08-21 上游体复核证伪）。
  // 原“批量最小近似：手牌上限 +1”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
