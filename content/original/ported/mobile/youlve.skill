// youlve（游掠）：锁定技，当你于回合内不以此法获得一张牌时，你摸一张牌；当你于回合外不以此法失去一张牌时，你弃置一张牌。
// 未建模：subSkill, expansion 等机制无 DSL 原语。
skill youlve(3497883853) {
  // INTENTIONAL_EMPTY_NOOP: 上游 youlve（skill.js:2413）含真实规则体，DSL 原语暂不足以
  // 精确建模（保真度债；原 audio-only 注记经 2026-08-21 上游体复核证伪）。
  // 原“批量最小近似：结束阶段可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
