// spdaizui（戴罪）：限定技。当你受到伤害值不小于体力值的伤害时，你可防止此伤害并将此伤害渠道对应的所有实体牌置于伤害来源的武将牌上，称为“释”。本回合结束时，其获得所有“释”。
// 未建模：expansion 等机制无 DSL 原语。
skill spdaizui(2709079562) {
  // INTENTIONAL_EMPTY_NOOP: 上游 spdaizui（skill.js:21062）含真实规则体，DSL 原语暂不足以
  // 精确建模（保真度债；原 audio-only 注记经 2026-08-21 上游体复核证伪）。
  // 原“批量最小近似：受伤后可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
