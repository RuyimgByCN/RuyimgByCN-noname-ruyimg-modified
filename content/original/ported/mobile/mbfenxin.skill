// mbfenxin（焚心）：被你杀死的角色亮出其身份牌前，你可选择一项：1、其亮出身份牌后，若与你身份不同，你获得其武将牌上所有技能（限定技、觉醒技、使命技、主公技、持恒技除外）；2、与其交换身份牌（你与其的身份牌非明置时方可选择）。
skill mbfenxin(3573403001) {
  // INTENTIONAL_EMPTY_NOOP: 上游 mbfenxin（skill.js:32593）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
