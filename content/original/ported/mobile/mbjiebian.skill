// mbjiebian（劫辩）：一名角色的出牌阶段结束时，若本阶段没有角色受到过伤害，你可与当前回合角色或体力值最低的角色拼点（你因此拼点时可以使用“业”进行拼点），若你赢，你选择一项：1.对没赢的角色造成1点伤害；2.令没赢的角色恢复1点体力并摸一张牌，然后获得其至多两张牌。
// 未建模：subSkill, expansion, compare 等机制无 DSL 原语。
skill mbjiebian(2609935981) {
  // INTENTIONAL_EMPTY_NOOP: 上游 mbjiebian（skill.js:8215）含真实规则体，DSL 原语暂不足以
  // 精确建模（保真度债；原 audio-only 注记经 2026-08-21 上游体复核证伪）。
  // 原“批量最小近似：结束阶段可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
