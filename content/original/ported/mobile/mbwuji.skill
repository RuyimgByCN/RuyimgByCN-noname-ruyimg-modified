// mbwuji（武继）：限定技，出牌阶段，你可修改〖雪恨〗直到本阶段结束。此阶段结束时，若你因〖雪恨〗获得大于等于两张牌，你改为永久修改〖雪恨〗。
// 未建模：效果逻辑复杂，无合适 DSL 原语匹配。
skill mbwuji(3741047664) {
  // INTENTIONAL_EMPTY_NOOP: 上游 mbwuji（skill.js:9010）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：出牌阶段限一次摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
