// chongxu（冲虚）：出牌阶段限一次，你可以随机演奏一首音乐，并根据完成度来获得相应的分数（至多五分）。然后你可修改〖妙剑〗或〖莲华〗（消耗3分），并使用剩余的分数进行摸牌（每张2分）。
// 未建模：beatmap, beatmap 等机制无 DSL 原语。
skill chongxu(3188823619) {
  // INTENTIONAL_EMPTY_NOOP: 上游 chongxu（skill.js:21753）含真实规则体，DSL 原语暂不足以
  // 精确建模（保真度债；原 audio-only 注记经 2026-08-21 上游体复核证伪）。
  // 原“批量最小近似：出牌阶段限一次摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
