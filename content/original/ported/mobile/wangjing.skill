// wangjing（往京）：锁定技。当你因〖集兵〗而使用或打出牌时，若对方是场上体力值最高的角色，则你摸一张牌。
// 未建模：expansion 等机制无 DSL 原语。
skill wangjing(2287745335) {
  // INTENTIONAL_EMPTY_NOOP: 上游 wangjing（skill.js:22371）含真实规则体，DSL 原语暂不足以
  // 精确建模（保真度债；原 audio-only 注记经 2026-08-21 上游体复核证伪）。
  // 原“批量最小近似：用牌后可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
