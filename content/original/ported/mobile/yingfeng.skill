// yingfeng（迎奉）：准备阶段，你可以令一名角色获得“奉”标记并移除场上所有其他的“奉”标记。有“奉”标记的角色使用牌没有距离限制。
// 未建模：效果逻辑复杂，无合适 DSL 原语匹配。
skill yingfeng(4134634666) {
  // INTENTIONAL_EMPTY_NOOP: 上游 yingfeng（skill.js:21660）含真实规则体，DSL 原语暂不足以
  // 精确建模（保真度债；原 audio-only 注记经 2026-08-21 上游体复核证伪）。
  // 原“批量最小近似：手牌上限 +1”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
