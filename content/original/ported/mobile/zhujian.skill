// zhujian（筑舰）：出牌阶段限一次。你可以令至少两名装备区里有牌的角色各摸一张牌。
// 未建模：效果逻辑复杂，无合适 DSL 原语匹配。
skill zhujian(3984494804) {
  // INTENTIONAL_EMPTY_NOOP: 上游 zhujian（skill.js:18913）含真实规则体，DSL 原语暂不足以
  // 精确建模（保真度债；原 audio-only 注记经 2026-08-21 上游体复核证伪）。
  // 原“批量最小近似：出牌阶段限一次摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
