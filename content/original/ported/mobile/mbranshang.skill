// 燃殇：火焰伤害按点数积累“燃”；结束阶段按标记失去体力，标记大于一时再减体力上限并摸牌。
skill mbranshang(3354404150) locked {
  trigger damage owner_target_fire {
    effect add_mark(self, 1206920502, event_amount);
  }

  trigger phase_end owner_is_target {
    let burns = mark_count(self, 1206920502);
    effect lose_hp(self, burns);
    if 1 < burns {
      effect change_max_hp(self, -2);
      effect draw_cards(self, 2);
    }
  }
}

