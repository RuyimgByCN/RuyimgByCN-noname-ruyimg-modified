// mbxunjie（逊节）：锁定技，当你受到有来源的伤害时，若其体力值大于你且场上没有【大攻车】，则你进行一次判定，若结果为红色，则此伤害-1。
// 未建模：效果逻辑复杂，无合适 DSL 原语匹配。
skill mbxunjie(2808996875) {
  // INTENTIONAL_EMPTY_NOOP: 上游 mbxunjie（skill.js:12026）含真实规则体，DSL 原语暂不足以
  // 精确建模（保真度债；原 audio-only 注记经 2026-08-21 上游体复核证伪）。
  // 原“批量最小近似：受伤后可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
