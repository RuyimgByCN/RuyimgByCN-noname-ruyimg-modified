// mbxuetu（血途）：转换技。出牌阶段限一次，阳：你可以令一名角色回复1点体力；阴：你可以令一名角色摸两张牌。
// 未建模：subSkill, chooseButton 等机制无 DSL 原语。
skill mbxuetu(2636216380) {
  // INTENTIONAL_EMPTY_NOOP: 上游 mbxuetu（skill.js:14555）含真实规则体，DSL 原语暂不足以
  // 精确建模（保真度债；原 audio-only 注记经 2026-08-21 上游体复核证伪）。
  // 原“批量最小近似：出牌阶段限一次摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
