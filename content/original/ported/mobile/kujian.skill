// 苦谏（kujian）：出牌阶段限一次：将至多两张手牌称「谏」交给一名其他角色；其因使用/打出失去「谏」则你与其各摸两张，否则各弃一张。
// 上游描述引自 translate.js；此前占位头（旧批量批次未写描述）已重记。
skill kujian(2840277349) {
  // INTENTIONAL_EMPTY_NOOP: 上游 kujian（skill.js:15744）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
