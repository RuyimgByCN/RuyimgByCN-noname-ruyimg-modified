// mbhengwei（横威）：锁定技，当你对一名其他角色造成伤害时，除非其展示一张手牌并交给你，否则你令此伤害+1。你的回合内，其他角色展示牌后，其不能使用与展示牌相同颜色的手牌直到本回合结束。
// 未建模：效果逻辑复杂，无合适 DSL 原语匹配。
skill mbhengwei(2459686732) {
  // INTENTIONAL_EMPTY_NOOP: 上游 mbhengwei（skill.js:3540）含真实规则体，DSL 原语暂不足以
  // 精确建模（保真度债；原 audio-only 注记经 2026-08-21 上游体复核证伪）。
  // 原“批量最小近似：手牌上限 +1”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
