// 威肆（mbweisi）：群势力技，出牌阶段限一次：令一名其他角色将任意张手牌移出游戏至回合结束，视为对其使用【决斗】；造成伤害后获得其所有手牌。
// 上游描述引自 translate.js；此前占位头（旧批量批次未写描述）已重记。
skill mbweisi(3490492597) {
  // INTENTIONAL_EMPTY_NOOP: 上游 mbweisi（skill.js:9444）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
