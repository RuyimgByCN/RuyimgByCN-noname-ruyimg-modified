// 谙达 (mbanda) — 吴珂: once per round, a living damage source may give the dying
// player exactly two differently colored hand/equipment cards; otherwise recover 1 HP.
skill mbanda(2849838127) {
  trigger dying owner_alive_source_alive_event_player_dying_once_per_round optional {
    effect choose_give_two_different_colors_or_recover(self, event_source, event_player);
  }
}
