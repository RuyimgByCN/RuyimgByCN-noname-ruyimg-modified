// mbyuhua（羽化）：锁定技，你的非基本牌不计入手牌上限；结束阶段，若你的手牌数大于体力值，你观看牌堆顶X张牌（X为你手牌类别数），将其中任意数量的牌置于牌堆顶，其余的牌置于牌堆底。
// 未建模：效果逻辑复杂，无合适 DSL 原语匹配。
skill mbyuhua(3492701489) {
  // INTENTIONAL_EMPTY_NOOP: 上游 mbyuhua（skill.js:2096）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：手牌上限 +1”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
