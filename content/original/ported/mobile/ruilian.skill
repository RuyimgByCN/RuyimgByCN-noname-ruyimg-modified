// ruilian（睿敛）：每轮开始时，你可以选择一名角色。其下回合结束时，若其本回合弃置过牌，你可以选择其本回合弃置过的一种类别，你与其各从弃牌堆中获得一张此类别的牌。
// 未建模：效果逻辑复杂，无合适 DSL 原语匹配。
skill ruilian(2286124897) {
  // INTENTIONAL_EMPTY_NOOP: 上游 ruilian（skill.js:15823）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
