// yizheng（义争）：出牌阶段限一次，你可以和一名体力值不大于你的其他角色拼点。若你赢，其跳过下个摸牌阶段。若你没赢，你减1点体力上限。
// 未建模：效果逻辑复杂，无合适 DSL 原语匹配。
skill yizheng(3959248752) {
  // INTENTIONAL_EMPTY_NOOP: 上游 yizheng（skill.js:28809）含真实规则体，DSL 原语暂不足以
  // 精确建模（保真度债；原 audio-only 注记经 2026-08-21 上游体复核证伪）。
  // 原“批量最小近似：出牌阶段限一次摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
