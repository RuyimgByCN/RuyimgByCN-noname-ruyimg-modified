// 征荣（rezhengrong）：锁定技：出牌阶段使用的指定其他角色目标的第偶数张牌结算后，将一名其他角色的随机一张牌置于你的武将牌上称「荣」。
// 上游描述引自 translate.js；此前占位头（旧批量批次未写描述）已重记。
skill rezhengrong(2612396453) {
  // INTENTIONAL_EMPTY_NOOP: 上游 rezhengrong（skill.js:28108）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：用牌后可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
