skill pothuanshi(3829646884) {
  // INTENTIONAL_EMPTY_NOOP: 上游 pothuanshi（skill.js:624）含真实规则体，DSL 原语暂不足以
  // 精确建模（保真度债；原 audio-only 注记经 2026-08-21 上游体复核证伪）。
  // 原“批量最小近似：手牌上限 +1”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
