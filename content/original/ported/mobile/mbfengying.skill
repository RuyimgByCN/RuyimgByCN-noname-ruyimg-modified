// mbfengying（奉迎）：限定技，出牌阶段，你可以选择一名角色并令其攻击范围内的所有其他角色各将一张手牌当【无中生有】对其使用。若该角色体力上限为全场最大，此回合结束时你获得一个额外的回合。
// 未建模：效果逻辑复杂，无合适 DSL 原语匹配。
skill mbfengying(3350947389) {
  // INTENTIONAL_EMPTY_NOOP: 上游 mbfengying（skill.js:1379）含真实规则体，DSL 原语暂不足以
  // 精确建模（保真度债；原 audio-only 注记经 2026-08-21 上游体复核证伪）。
  // 原“批量最小近似：视为【杀】”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
