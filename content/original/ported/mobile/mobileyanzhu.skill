// mobileyanzhu（宴诛）：出牌阶段限一次，你可以令一名有牌的其他角色选择一项：①你获得其装备区里所有的牌，然后你失去技能〖宴诛〗并修改技能〖兴学〗。②你获得其区域里的一张牌。
// 未建模：效果逻辑复杂，无合适 DSL 原语匹配。
skill mobileyanzhu(4235871596) {
  // INTENTIONAL_EMPTY_NOOP: 上游 mobileyanzhu（skill.js:21424）含真实规则体，DSL 原语暂不足以
  // 精确建模（保真度债；原 audio-only 注记经 2026-08-21 上游体复核证伪）。
  // 原“批量最小近似：出牌阶段限一次摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
