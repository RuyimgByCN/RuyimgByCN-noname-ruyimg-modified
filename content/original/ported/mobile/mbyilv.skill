// mbyilv（遗履）：每回合限一次，一名角色使用【杀】指定你为目标后，你可与其谋奕。若你赢且你选择的选项为：“金蝉脱壳”，随机弃置其一张手牌，若为基本牌你获得之；“弃履狂奔”，此【杀】伤害-1。
skill mbyilv(2926893402) {
  // INTENTIONAL_EMPTY_NOOP: 上游 mbyilv（skill.js:3776）含真实规则体，DSL 原语暂不足以
  // 精确建模（保真度债；原 audio-only 注记经 2026-08-21 上游体复核证伪）。
  // 原“批量最小近似：用牌后可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
