// 旧 JS 语义：使用【杀】无距离限制且次数上限 +1；出牌阶段第一张【杀】不可被响应，第二张【杀】伤害 +1。
skill xinjintao(2174751337) {
  modifier sha_use_limit add 1;
  modifier card_distance_unlimited(sha) override 1;
  modifier sha_unrespondable(any) override owner_sha_used_exactly_one;
  modifier sha_damage(any) add owner_sha_used_exactly_two;
}
