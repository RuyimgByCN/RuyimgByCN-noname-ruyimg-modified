,{"skill_def_id":2307382183,"window":"play_phase","module":"diyjuntun_active_play_phase_0","entry_pc":0,"selection":{"zone":"hand_equip","min":1,"max":1,"allow_cancel":false,"same_color":false,"filter":"card_equip"},"targets":null,"uses_per_turn":null}],"view_as_index":[{"skill_def_id":3563375486,"as_kind":"sha","window":"play_phase","filter":"owner_hp_le_two_black_trick"},{"skill_def_id":3563375486,"as_kind":"sha","window":"response","filter":"owner_hp_le_two_black_trick"},{"skill_def_id":3473735644,"as_kind":"wugu","window":"play_phase","filter":"card_basic","uses_per_turn":1}],"translations":{"zh-CN":{"chezhen":"车阵","chezhen_info":"锁定技。若你的装备区里：没有牌，你的防御距离+1；有牌，你的进攻距离+1。","choudu":"筹度","choudu_info":"出牌阶段限一次，你可以弃置一张牌，并指定一名角色视为其使用一张调兵遣将。","ciqiu":"刺酋","ciqiu_info":"锁定技，每当你使用【杀】对目标角色造成伤害时，若该角色未受伤，你令此伤害+1；若其因此进入濒死状态，你令其死亡，然后你失去“刺酋”。","diaobingqianjiang":"调兵遣将","diaobingqianjiang_info":"出牌阶段，对你及其他有手牌的角色使用。你摸一张牌，然后亮出牌堆顶的X张牌（X为存活角色数的一半，向上取整），目标可以用一张手牌替换其中的一张牌。结算后，你可以将剩余的牌中的任意张以任意顺序置于牌堆顶。","diyjuntun":"军屯","diyjuntun_info":"出牌阶段，你可以重铸装备牌。","duoqi":"夺气","duoqi_info":"当一名角色于除你之外的角色的出牌阶段内因弃置而失去牌后，你可以移去一张“筑”，并结束此出牌阶段。","fuchou":"负仇","fuchou_info":"当你成为【杀】的目标时，你可以将一张牌交给此【杀】的使用者，令此【杀】对你无效。若如此做，本回合结束后，其令你摸一张牌，然后你需对其使用【杀】，否则失去1点体力。","geju":"割据","geju_info":"准备阶段开始时，你可以摸X张牌（X为攻击范围内不含有你的势力数）。","jianbi":"坚壁","jianbi_info":"当你成为锦囊牌的目标时，若此牌的目标包括其他角色，你可以令此牌对其中一个目标无效。","jinyan":"噤言","jinyan_info":"锁定技。若你的体力值不大于2，你的黑色锦囊牌视为【杀】。","juedao":"绝道","juedao_info":"出牌阶段，你可以弃置一张手牌，横置你的武将牌；锁定技，若你的武将牌横置，则你计算至其他角色的距离和其他角色计算至你的距离均+1。","kangyin":"亢音","kangyin2":"亢音","kangyin_info":"出牌阶段限一次，你可以失去1点体力并选择一名其他角色，弃置该角色的一张牌。若此牌为基本牌，你可以令一至X名角色各摸一张牌；若不为基本牌，于此回合内你的进攻距离+X，且你使用【杀】的额外目标数上限+X。（X为你已损失的体力值）","liangce":"粮策","liangce_info":"①出牌阶段限一次，你可以将一张基本牌当【五谷丰登】使用。②当因执行【五谷丰登】的效果而亮出的牌因效果执行完毕而置入弃牌堆后，你可以令一名角色获取这些牌。","liduan":"立断","liduan_info":"当一名其他角色于其回合外得到牌后，若其此次得到的牌数为1且为装备牌（无论是否可见），你可以令该角色选择一项：1.使用此牌；2.将一张手牌交给你。","moshou":"墨守","moshou_info":"锁定技，你不能成为乐不思蜀和兵粮寸断的目标。","nsshuaiyan":"率言","nsshuaiyan_info":"每当其他角色于你的回合外回复体力后，你可以令该角色选择一项：令你摸一张牌；或令你弃置其一张牌。","siji":"伺机","siji_info":"弃牌阶段结束后，你可以摸2X张牌（X为你于此阶段内弃置的【杀】的数量）。","wangmeizhike":"望梅止渴","wangmeizhike_info":"出牌阶段对一名角色使用，若没有角色体力比目标少，目标回复1点体力；若没有角色手牌比目标少，目标摸两张牌（若因此牌回复了体力则改为摸一张）。","wdb_feishi":"费诗","wdb_hanlong":"韩龙","wdb_liufu":"刘馥","wdb_liuyan":"刘焉","wdb_liuzan":"留赞","wdb_tianyu":"田豫","wdb_xizhenxihong":"习珍习宏","wdb_yangyi":"杨仪","wdb_zaozhirenjun":"枣祗任峻","youdishenru":"诱敌深入","youdishenru_info":"当以你为目标的【杀】生效前，对此【杀】使用。抵消此【杀】，然后此【杀】的使用者需对你使用【杀】（在此【杀】结算结束之后，若此【杀】未对你造成伤害，其重复此流程），否则受到你造成的1点伤害。","youzhan":"诱战","youzhan_info":"当以你距离不大于1的角色为目标的【杀】的使用结算开始时，你可以弃置一张装备牌，令该角色视为使用【诱敌深入】。","zhucheng":"筑城","zhucheng_info":"①结束阶段开始时，若没有“筑”，你可以将牌堆顶的X张牌置于你的武将牌上〔称为“筑”〕（X为你已损失的体力值与1中的较大值），否则你可以获取所有“筑”。②当你成为【杀】的目标时，若有“筑”，你可以令此【杀】的使用者弃置X张牌（X为“筑”的数量），否则此【杀】对你无效。"}},"asset_manifest":{"schema_version":1,"package_id":"wandianlunsha","total_compressed_size":11491,"total_decoded_size":0,"entries":[{"asset_id":"audio_card_wangmeizhike_male.mp3","source_hash":[48,68,91,146,210,36,127,18,142,229,202,101,122,12,203,238,198,7,110,29,12,170,36,71,154,15,192,105,115,133,147,69],"kind":"Audio","image_variants":[],"audio_variants":[{"format":"Opus","platforms":[],"content_hash":[48,68,91,146,210,36,127,18,142,229,202,101,122,12,203,238,198,7,110,29,12,170,36,71,154,15,192,105,115,133,147,69],"compressed_size":10291,"decoded_size":0}],"priority":"Lazy","depends_on":[],"platforms":[]},{"asset_id":"card_diaobingqianjiang.png","source_hash":[23,27,49,228,181,186,58,108,244,145,213,139,236,105,209,200,196,223,1,237,194,134,154,88,36,249,198,222,215,193,18,129],"kind":"Image","image_variants":[{"format":"WebP","width":0,"height":0,"platforms":[],"content_hash":[23,27,49,228,181,186,58,108,244,145,213,139,236,105,209,200,196,223,1,237,194,134,154,88,36,249,198,222,215,193,18,129],"compressed_size":100,"decoded_size":0}],"audio_variants":[],"priority":"Lazy","depends_on":[],"platforms":[]},{"asset_id":"card_wangmeizhike.png","source_hash":[173,45,60,19,195,207,214,44,164,162,75