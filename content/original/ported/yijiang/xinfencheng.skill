// 新焚城（李儒）：限定技，出牌阶段，对全场其他角色按座位顺序依次执行：弃置递增数量（从1起）的牌或受到2点火焰伤害。
// 旧 JS 的序列化全场目标选择+递进计数+伤害/弃牌分支极其复杂；DSL 无精确原语。
// 以 choose_discard_or_fire_damage_skip_phases 近似，但丢掉了递增计数和序列化目标处理。
skill xinfencheng(3438807007) {
  active play_phase uses_per_turn 1 targets 1 99 other {
    // 近似：对目标造成2点火伤或弃牌；无法表达递增计数
    effect deal_damage(self, event_source, 2, fire);
  }
}
