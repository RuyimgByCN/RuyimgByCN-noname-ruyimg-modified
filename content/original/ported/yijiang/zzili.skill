// 自立（钟会）：觉醒技。准备阶段,若你的「自新」牌不小于 4 张,你减 1 点体力上限。
// 旧 JS 仅作语义证据;「获得排异」未建模（需使用技能牌堆牌原语）;
// 觉醒仅一次以觉醒标记近似,牌堆计数用 ABI 565 skill_pile_count。
skill zzili(3434925874) {
  trigger phase_prepare owner_is_target {
    if mark_count(self, 3434925874) == 0 {
      if 3 < skill_pile_count(self, 3289308596) {
        effect change_max_hp(self, -1);
        effect add_mark(self, 3434925874, 1);
      }
    }
  }
}
