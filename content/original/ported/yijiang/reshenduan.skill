// 慎断(旧版)(旧版张郃)：当黑色基本牌或装备牌因弃置进入弃牌堆后，
// 你可以将其当做【兵粮寸断】使用。可多次使用直到无法再使用为止。
// 旧JS含chooseButtonTarget多次循环、虚拟bingliang使用等复杂逻辑。
// 近似：用discarded条件触发，选择目标使用兵粮寸断（无法精确限定只能从弃牌堆选取特定牌）。
skill reshenduan(3103025970) {
  // ponytail: 多次chooseButtonTarget循环、从弃牌堆选取特定黑色基本/装备当bingliang使用等逻辑无DSL原语。
  trigger cards_moved owner_alive {
    // 近似：当牌进入弃牌堆后，尝试用兵粮寸断（无法精确建模黑色基本/装备牌的条件筛选和多段使用）
    // 注：实际效果严重简化，需引擎层扩展原语才能精确表达
  }
}
