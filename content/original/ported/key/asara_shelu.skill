// 射鹿（国崎往人）：出牌阶段弃一张牌并展示一名其他角色一张手牌，花色相同则摸两张，点数相同则回复 1。
// 实现：出牌阶段限一次弃 1 张手牌或装备并摸 2。
// 近似：不展示对方手牌；不比较花色/点数；回复分支未建模。
// 旧 JavaScript 只作语义证据，不进入 npack 或运行时。
skill asara_shelu(4161128201) {
  active play_phase uses_per_turn 1 select_he 1 1 {
    effect discard_selected(self);
    effect draw_cards(self, 2);
  }
}
