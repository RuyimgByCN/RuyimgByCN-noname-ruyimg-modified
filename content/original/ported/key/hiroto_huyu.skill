// 虎驭（弘人）：其他角色出牌阶段结束时，可交给你两张手牌，令你获得「纵略」并在你的下回合结束时将其获得的所有牌交给该角色。
// 旧 JS 的「对方主动选择+技能授予+回合结束时追溯获得牌转移」需双人交互+状态追踪原语，未建模。
skill hiroto_huyu(2586716910) {
  // INTENTIONAL_EMPTY_NOOP: 上游 hiroto_huyu（skill.js:5644）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
