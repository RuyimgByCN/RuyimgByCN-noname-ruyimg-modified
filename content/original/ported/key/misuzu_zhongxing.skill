// 终行（观铃）：失去判定区牌后，可令一名角色选择摸两张牌或回复1点体力，自己获得临时技能（每回合限一次）。
// 旧 JS 的 判定区失去+目标二择一 需判定区变更与选项原语，未建模。
skill misuzu_zhongxing(2334379613) {
  // INTENTIONAL_EMPTY_NOOP: 上游 misuzu_zhongxing（skill.js:1305）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
