// 赴难（佐佐美）：响应牌时，可获得响应牌。
// 旧 JS 的 respondTo 检测+响应牌获取 需响应链追踪原语，未建模。
skill sasami_funan(2807672918) {
  // INTENTIONAL_EMPTY_NOOP: 上游 sasami_funan 含真实规则体（trigger 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：手牌上限 +1”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
