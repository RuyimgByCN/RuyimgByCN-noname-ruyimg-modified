// 传响·实装（琴美）：出牌阶段，将一张装备牌传给其他角色，令拥有传响的角色摸一张牌（传给传响持有者改为摸两张）。
// 旧 JS 的「装备转移+条件摸牌」需技能持有者检测+差异化收益原语，未建模。
skill kotomi_chuanxiang2(2960184064) {
  // INTENTIONAL_EMPTY_NOOP: 上游 kotomi_chuanxiang2（skill.js:4518）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：出牌阶段限一次摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
