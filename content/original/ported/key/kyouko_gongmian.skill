// 共勉（恭子）：出牌阶段，选择一名未以此法选择过的角色比较手牌数：你多则获得其一张牌再还一张，他多则其给你一张再还一张，相等则各摸一张。
// 旧 JS 的「比较手牌数+三路分支+交互给牌」需手牌比较+多分支+双人交互原语，未建模。
skill kyouko_gongmian(3855939821) {
  // INTENTIONAL_EMPTY_NOOP: 上游 kyouko_gongmian（skill.js:615）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：出牌阶段限一次摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
