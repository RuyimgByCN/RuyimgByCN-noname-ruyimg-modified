// 奔战（静流）：同 kanade_benzhan，响应牌时选目标摸/弃或回复/伤害。
// 旧 JS 与 kanade_benzhan 相同逻辑，需响应追踪原语，未建模。
skill shizuru_benzhan(3458157310) {
  // INTENTIONAL_EMPTY_NOOP: 上游 shizuru_benzhan（skill.js:7743）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：用牌后可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
