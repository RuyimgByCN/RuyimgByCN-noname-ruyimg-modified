// 综司（篝）：出牌阶段限一次，选择一张任意区域的牌移动到另一个任意区域（牌堆/弃牌堆/角色手牌/装备/判定区）。
// 旧 JS 的「任意区域选牌+任意目标区域」极度复杂，需区域遍历+多目标移动原语，未建模。
skill kagari_zongsi(2299228246) {
  // INTENTIONAL_EMPTY_NOOP: 上游 kagari_zongsi（skill.js:2739）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：出牌阶段限一次摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
