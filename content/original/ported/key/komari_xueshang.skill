// 血殇（小鞠·蓄力技·锁定技）：其他角色死亡时，获得「血殇」，自选伤害值，自身受到等量伤害后全场其他角色也受到等量伤害。
// 旧 JS 的「自选伤害值+连锁全场伤害」需伤害值选择+全图伤害原语，未建模。
skill komari_xueshang(2613841923) {
  // INTENTIONAL_EMPTY_NOOP: 上游 komari_xueshang（skill.js:11515）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
