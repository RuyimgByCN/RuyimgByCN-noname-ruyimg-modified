// 风轮：出牌阶段限一次拼点；严格获胜后，本阶段使用牌无次数和距离限制。
skill yuiko_fenglun(3729037306) {
  active play_phase uses_per_turn 1 targets 1 1 other can_compare select_hand 1 1 {
    effect choose_compare_selected_hand_card(self, event_source, 2522572214, 3908187138);
  }
}

skill yuiko_fenglun_fail(3908187138) {
  trigger hand_compare_finished owner_is_target {
    effect remove_skill(self_skill);
  }
}
