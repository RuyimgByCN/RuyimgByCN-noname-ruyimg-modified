// 羁绊（鸥·转换技）：受到/造成伤害后，可将1-2张牌交给一名其他角色，其返还2-1张牌。每回合限一次。
// 旧 JS 的「转换技状态+双向给牌+每回合限一次」需转换技状态机+双向卡牌交换原语，未建模。
skill kamome_jieban(3079516847) {
  // INTENTIONAL_EMPTY_NOOP: 上游 kamome_jieban（skill.js:1381）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：受伤后可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
