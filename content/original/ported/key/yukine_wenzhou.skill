// 温粥（雪音）：其他角色出牌阶段开始时交给你一张牌，你返还一张或让其从牌堆找同类型牌并使用同类型牌不可响应。
// 旧 JS 的 给牌+选择分支+牌堆检索+不可响应 需多重交互原语，未建模。
skill yukine_wenzhou(2557229217) {
  // INTENTIONAL_EMPTY_NOOP: 上游 yukine_wenzhou（skill.js:11360）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
