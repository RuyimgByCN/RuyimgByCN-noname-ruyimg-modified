// 改写（小太郎）：出牌阶段，从六种选项中选择一项发动（视为使用未用过的牌/移动场上牌/加体力上限扣体力/本回合伤害+1/本回合回复+1/本回合手牌上限和出杀数+1），累计三次后失去此技能。
// 旧 JS 的「六选一菜单+会话内去重+累计禁用+多种增益效果」极度复杂，未建模。
skill kotarou_rewrite(2282236310) {
  // INTENTIONAL_EMPTY_NOOP: 上游 kotarou_rewrite = 标记型技能（charlotte，skill.js:339），无规则面。
  // 原“批量最小近似：出牌阶段限一次摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
