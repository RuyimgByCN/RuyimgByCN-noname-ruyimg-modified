// 纵欢（古河渚）：出牌阶段，选择一名其他角色并观看其手牌，选一张牌强制其使用（或置入弃牌堆），若使用则自己摸一张牌。
// 旧 JS 的「观看手牌+选牌强制使用+目标选择+分支」无对应 DSL 原语，未建模。
skill ayato_zonghuan(3974222253) {
  // INTENTIONAL_EMPTY_NOOP: 上游 ayato_zonghuan（skill.js:8686）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：出牌阶段限一次摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
