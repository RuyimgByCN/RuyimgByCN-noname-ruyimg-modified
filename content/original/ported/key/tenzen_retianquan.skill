// 天全（天善）：使用【杀】指定目标后，可失去1体力或弃1牌，展示牌堆顶3-5张，每张基本牌目标需多用1闪；造成伤害后获得非基本牌。
// 旧 JS 的 展示上限+闪数量增加+造成伤害后取牌 需展示修改+闪计数原语，未建模。
skill tenzen_retianquan(4288550568) {
  // INTENTIONAL_EMPTY_NOOP: 上游 tenzen_retianquan（skill.js:86）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：用牌后可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
