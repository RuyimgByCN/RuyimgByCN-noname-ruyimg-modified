// 豪掷（伊莉雅）：出牌阶段，按斗地主牌型弃置至少两张牌，其他角色可依次用更大的同牌型响应，最终响应者按牌型获得对应效果（摸牌/弃牌/翻面/伤害等）。
// 旧 JS 的「斗地主牌型识别+多人回合制响应+多分支效果」极度复杂，无对应 DSL 原语，未建模。
skill iriya_haozhi(4276952722) {
  // INTENTIONAL_EMPTY_NOOP: 上游 iriya_haozhi（skill.js:3094）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：手牌上限 +1”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
