// 不尽·续（音无）：计算与其他角色的距离时，每有一名其他友方拥有「不尽」则-1。
// 旧 JS 的 globalFrom 友方计数 modifier 需友方判定原语，未建模。
skill yuzuru_bujin2(2292140553) {
  // INTENTIONAL_EMPTY_NOOP: 上游 yuzuru_bujin2（skill.js:8059）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：手牌上限 +1”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
