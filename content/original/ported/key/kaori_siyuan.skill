// 丝援（香织）：出牌阶段，将一张装备牌或延时锦囊牌置入其他角色对应区域，然后可视为使用一张基本牌或非延时锦囊。
// 旧 JS 的「装备/延时锦囊转移+后续虚拟使用」需双段结算+动态卡名选择原语，未建模。
skill kaori_siyuan(3294082017) {
  // INTENTIONAL_EMPTY_NOOP: 上游 kaori_siyuan（skill.js:7109）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：出牌阶段限一次摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
