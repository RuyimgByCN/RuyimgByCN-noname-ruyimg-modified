// 融注（恭子）：其他角色获得你的牌后，摸一张牌并可选交还一张，根据当前回合角色获得手牌上限+1或出杀次数+1。
// 旧 JS 的「获得牌追溯+条件返牌+双条件增益」需获得追溯+条件 modifier 原语，未建模。
skill kyouko_rongzhu(2560936418) {
  // INTENTIONAL_EMPTY_NOOP: 上游 kyouko_rongzhu（skill.js:557）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：手牌上限 +1”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
