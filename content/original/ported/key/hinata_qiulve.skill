// 求略：旧 JavaScript 仅作为语义证据；运行时只加载该类型化规则。
skill hinata_qiulve(3761656212) {
  view_as sha play_phase non_basic from hand_equip ignore_distance red_unrespondable black_no_use_count;
  view_as sha response non_basic from hand_equip;
}

// 旧版 useCard1 助手的颜色分支已折叠进 view_as 合同；保留稳定定义 ID。
skill hinata_qiulve_clear(3988736644) {
  // INTENTIONAL_EMPTY_NOOP: 上游 hinata_qiulve_clear（skill.js:9200）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：用牌后可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
