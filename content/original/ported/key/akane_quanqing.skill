// 劝请（朱音）：出牌阶段将一张牌交给攻击范围内的其他角色，再按点数令其摸牌 / 弃其区域牌 / 造成伤害。
// 实现：出牌阶段限一次弃 1 张手牌或装备，令一名其他角色摸 1。
// 近似：交给改为弃置；不限攻击范围；点数分支与弃牌/伤害未建模。
// 旧 JavaScript 只作语义证据，不进入 npack 或运行时。
skill akane_quanqing(2806428173) {
  active play_phase uses_per_turn 1 select_he 1 1 targets 1 1 other {
    effect discard_selected(self);
    effect draw_selected_targets(1);
  }
}
