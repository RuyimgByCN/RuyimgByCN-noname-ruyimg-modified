// 神视（雏·神势力技）：出牌阶段开始/结束时摸两张牌（加标记），再将一张置于牌堆顶。
// 实现：自己的出牌阶段开始与结束时各可选摸 2。
// 近似：不限神势力；不打 gaintag；不把一张牌置顶；应变子技未建模。
// 旧 JavaScript 只作语义证据，不进入 npack 或运行时。
skill hina_shenshi(3019937721) {
  trigger phase_play owner_is_target optional {
    effect draw_cards(self, 2);
  }
  trigger phase_play_end owner_is_target optional {
    effect draw_cards(self, 2);
  }
}
