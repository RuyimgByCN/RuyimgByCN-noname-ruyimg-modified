// 视心（直井文人·觉醒技）：准备阶段，若扩展区牌花色数≥3，失去「蝶归」获得「窥魂」，加1点体力上限并回复1点体力。
// 实现：准备阶段一次：+1 上限、回 1 体、卸蝶归、授窥魂。
// 近似：不检验扩展区花色数≥3；以 mark_count 门控。
// 旧 JavaScript 只作语义证据，不进入 npack 或运行时。
skill ao_shixin(2364015708) locked {
  trigger phase_prepare owner_is_target {
    if mark_count(self, 2364015708) == 0 {
      effect change_max_hp(self, 1);
      effect recover_hp(self, 1);
      effect remove_skill_by_def(self, 2867140701);
      effect add_skill(self, 3209605261);
      effect add_mark(self, 2364015708, 1);
    }
  }
}
