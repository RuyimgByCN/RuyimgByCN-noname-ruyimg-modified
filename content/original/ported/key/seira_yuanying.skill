// 缘营（星罗）：出牌阶段选择两名角色，只有此二人持有姻缘技能，其余角色失去姻缘。
// 旧 JS 的 群体 addSkills/removeSkills 需技能批量操作原语，未建模。
skill seira_yuanying(3512520583) {
  // INTENTIONAL_EMPTY_NOOP: 上游 seira_yuanying（skill.js:2530）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：出牌阶段限一次摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
