// 授计（沙耶）：使用牌后（限一次），可选一名其他角色获得此牌的使用权。
// 旧 JS 的 使用后牌转移+二次使用 需牌传递+复用原语，未建模。
skill saya_shouji(2260854311) {
  // INTENTIONAL_EMPTY_NOOP: 上游 saya_shouji 含真实规则体（trigger、usable 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：用牌后可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
