// 共勉·出牌（恭子）：出牌阶段结束时，若发动过共勉，可获一名角色至多发动次数张牌，再等量返还。
// 旧 JS 的「历史计数+条件取牌+等量返还」需历史追踪+交换原语，未建模。
skill kyouko_gongmian_use(2504931940) {
  // INTENTIONAL_EMPTY_NOOP: 上游 kyouko_gongmian_use（skill.js:679）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
