// My Song（岩泽）：锁定技，回合开始时获得「奋音」；进入濒死时取消濒死结算；回合结束后死亡。
// 旧 JS 的「濒死取消+强制死亡」无对应 DSL 原语，未建模。
skill iwasawa_mysong(3834003763) {
  // INTENTIONAL_EMPTY_NOOP: 上游 iwasawa_mysong（skill.js:11068）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：濒死时可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
