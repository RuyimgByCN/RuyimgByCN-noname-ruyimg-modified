// 行智（雏·key势力技）：使用无应变效果的牌时，可发动「助战」应变并摸两张牌。
// 旧 JS 的 yingbian 助战+afterYingbianZhuzhan 回调无对应 DSL 原语，未建模。
skill hina_xingzhi(3635099818) {
  // INTENTIONAL_EMPTY_NOOP: 上游 hina_xingzhi（skill.js:2642）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
