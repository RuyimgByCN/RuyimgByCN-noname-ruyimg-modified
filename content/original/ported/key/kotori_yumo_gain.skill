// 驭魔·获取（小鸟）：回合开始时，可消耗一个魔物标记获得对应势力的附技直到回合结束。
// 旧 JS 的「选标记消耗+临时技能获取」需标记选择+技能授予原语，未建模。
skill kotori_yumo_gain(2214916948) {
  // INTENTIONAL_EMPTY_NOOP: 上游 kotori_yumo_gain（skill.js:6373）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
