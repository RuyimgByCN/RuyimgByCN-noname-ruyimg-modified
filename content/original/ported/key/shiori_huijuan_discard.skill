// 绘卷·弃置（诗织·锁定技）：准备阶段根据绘卷使用次数决定是否需弃置装备/判定区牌.
// 旧 JS 的 历史计数+条件弃置 需跨回合统计原语，未建模。
skill shiori_huijuan_discard(2881565313) {
  // INTENTIONAL_EMPTY_NOOP: 上游 shiori_huijuan_discard（skill.js:7268）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
