// 琴击（琴美）：出牌阶段开始时，可视为使用一张【万箭齐发】。
// 旧 JS 的「chooseUseTarget 万箭+logSkill 重写」需虚拟 wanjiang 使用原语，未建模。
skill kotomi_qinji(2541277613) {
  // INTENTIONAL_EMPTY_NOOP: 上游 kotomi_qinji（skill.js:4489）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
