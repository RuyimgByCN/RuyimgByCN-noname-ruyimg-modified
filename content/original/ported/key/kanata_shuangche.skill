// 双掣·代价（奏多/春香）：锁定技，使用双掣转化的牌后，须弃置递增数量的牌或失去1点体力并禁用双掣至回合结束。
// 旧 JS 的「递增代价+技能禁用」需使用计数+技能状态控制原语，未建模。
skill kanata_shuangche(4051659614) {
  // INTENTIONAL_EMPTY_NOOP: 上游 kanata_shuangche（skill.js:10618）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：用牌后可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
