// 幻流（美凪）：准备阶段，与一名其他角色协力，获得舍愿技能。
// 旧 JS 的 chooseCooperationFor 协力机制+addAdditionalSkill 需协力系统原语，未建模。
skill minagi_huanliu(2316758231) {
  // INTENTIONAL_EMPTY_NOOP: 上游 minagi_huanliu（skill.js:1801）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
