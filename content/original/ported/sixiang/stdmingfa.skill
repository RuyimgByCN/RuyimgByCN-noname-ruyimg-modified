// Rewritten from legacy `stdmingfa`; old JavaScript is semantic reference only.
skill stdmingfa(2715469127) {
  active play_phase targets 1 1 hp_gt 1 {
    effect deal_damage(self, event_source, 1);
    effect replace_skill_with_bound_after_resolution_if_target_alive(
      self,
      self_skill,
      2582921343,
      event_source
    );
  }
}

skill stdmingfa_used(2582921343) locked {
  trigger hp_recovered owner_alive_skill_bound_target_is_event_player {
    effect add_skill(self, 2715469127);
    effect remove_skill(self_skill);
  }

  trigger death owner_alive_skill_bound_target_is_event_player {
    effect add_skill(self, 2715469127);
    effect remove_skill(self_skill);
  }
}
