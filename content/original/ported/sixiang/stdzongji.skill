// 纵计：由【杀】或【决斗】造成伤害后，可依次弃置受伤角色和伤害来源各一张手牌或装备牌。
skill stdzongji(3394363597) {
  trigger damage owner_alive_sha_or_duel_damage_source_target_alive_hand_equip_nonempty optional {
    effect choose_discard_target_card(self, event_player, hand_equip);
    effect choose_discard_target_card(self, event_source, hand_equip);
  }
}
