  view_as tao play_phase heart from hand_expansion owner_hp_min_one_cards;
  view_as tao response heart from hand_expansion owner_hp_min_one_cards;
  view_as sha play_phase diamond from hand_expansion owner_hp_min_one_cards nature fire;
  view_as sha response diamond from hand_expansion owner_hp_min_one_cards nature fire;
  view_as wuxie response spade from hand_expansion owner_hp_min_one_cards;
  view_as shan response club from hand_expansion owner_hp_min_one_cards;
}
