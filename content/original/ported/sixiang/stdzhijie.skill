// 智诫：每轮限一次，一名角色出牌阶段开始时，展示其一张手牌并记录类别；
// 其于此阶段前三次使用同类别牌时，拥有者各摸一张牌。
skill stdzhijie(2635655868) {
  trigger phase_play owner_alive_event_player_hand_nonempty_once_per_round optional {
    effect choose_reveal_hand_card_bind_category_target(self, event_player);
  }
  trigger card_used owner_source_bound_category_first_three_play_phase {
    effect draw_cards(self, 1);
  }
}
