// 3D精选 蹇硕「分野/逝潮」：旧 JavaScript 仅作语义证据，不进入运行时。
skill dddfenye(1190748172) {
  active play_phase uses_per_play_phase 1 hand_nonempty targets 1 1 other can_compare {
    effect resolve_ddd_jianshuo(self, self, 0);
  }
}

skill dddshichao(219219058) locked {
  trigger phase_prepare owner_is_target {
    effect resolve_ddd_jianshuo(self, self, 1);
  }
  trigger damage_before owner_is_target {
    effect resolve_ddd_jianshuo(self, event_source, 2);
  }
}
