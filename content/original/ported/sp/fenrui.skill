// fenrui：出牌阶段限一次，可弃置一张手牌令一名角色摸牌
// 触发事件：phaseJieshuBegin
skill fenrui(2616983300) {
  // INTENTIONAL_EMPTY_NOOP: 上游 fenrui 含真实规则体（trigger、onremove、subSkill 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 148 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：结束阶段可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
