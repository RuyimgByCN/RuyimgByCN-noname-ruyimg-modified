// 举荐（曹婴·锁定技）：你的初始手牌数上限和手牌上限+你的体力上限。
// 上游 (sp/skill.js)：mod 的 maxHandcard 与 start 阶段摸牌均 +player.maxHp。
skill jugu(2684521577) locked {
  modifier initial_hand_count add owner_max_hp;
  modifier hand_limit add owner_max_hp;
}

