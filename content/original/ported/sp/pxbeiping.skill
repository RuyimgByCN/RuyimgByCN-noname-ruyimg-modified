// 北平（pxbeiping，州郡技能）：当你获得此技能后，你从牌堆中获得两张【杀】。
// 上游 (sp/skill.js:3005)：trigger player:changeSkillsAfter；filter = addSkill 含本技；
// forced；content = gain(cardPile2("sha") ×2)。
// 实现：skill_added + owner_skill_added_self_3838939507 → gain_card_by_kind(self, sha)
// ×2（每次从牌堆/弃牌堆检索一张【杀】）。
skill pxbeiping(3838939507) {
  trigger skill_added owner_skill_added_self_3838939507 {
    effect gain_card_by_kind(self, sha);
    effect gain_card_by_kind(self, sha);
  }
}
