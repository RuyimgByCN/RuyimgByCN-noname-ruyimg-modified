// bingzheng：出牌阶段结束时，可选择一名手牌数不等于体力值的角色令其摸/弃牌
// 触发事件：phaseUseEnd
skill bingzheng(3122473765) {
  // INTENTIONAL_EMPTY_NOOP: 上游 bingzheng 含真实规则体（trigger 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 148 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：结束阶段可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
