// 返乡（SP 孙尚香）：觉醒技，准备阶段，若存在「良助」记录了你且已受伤的角色，
// 你加 1 点体力上限、回复 1 点体力，失去「良助」并获得「枭姬」。
// 上游 (sp/skill.js:41677)：juexingji + phaseZhunbeiBegin，filter 为
// `current.storage.liangzhu?.includes(player) && current.isDamaged()`，
// content=awakenSkill + gainMaxHp + recover + changeSkills(["xiaoji"], ["liangzhu"])。
// 实现：准备阶段 `owner_is_target`，以本技能标记门控一次；先加上限再回 1 体，
// 再卸良助(3065103097)、授标准包枭姬(22)。
// 近似：(1) 不检验良助 storage / 已受伤角色；(2) 觉醒以 mark_count 门控，
// 非 awakenSkill 禁用；(3) 枭姬取标准包 def 22，需与标准包同场。
// 旧 JavaScript 只作语义证据，不进入 npack 或运行时。
skill fanxiang(3943157500) locked {
  trigger phase_prepare owner_is_target {
    if mark_count(self, 3943157500) == 0 {
      effect change_max_hp(self, 1);
      effect recover_hp(self, 1);
      effect remove_skill_by_def(self, 3065103097);
      effect add_skill(self, 22);
      effect add_mark(self, 3943157500, 1);
    }
  }
}
