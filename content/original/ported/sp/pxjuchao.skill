// 居巢（pxjuchao，州郡技能）：当你获得此技能后，你可以弃置你与一名角色各一张牌。
// 上游 (sp/skill.js:2672)：trigger player:changeSkillsAfter；filter = addSkill 含本技
// 且存在可弃牌角色；content = chooseTarget → 依座次双方各 discardPlayerCard(he,
// forced)。
// 实现：skill_added + owner_skill_added_self_3375023858 → 可选确认 →
// choose_other_discard_target_card(self, hand_equip)（弃目标一张手牌/装备）+
// discard_hand_equip_count(self, 1)（弃自己一张）。
skill pxjuchao(3375023858) {
  trigger skill_added owner_skill_added_self_3375023858 optional {
    effect choose_other_discard_target_card(self, hand_equip);
    effect discard_hand_equip_count(self, 1);
  }
}
