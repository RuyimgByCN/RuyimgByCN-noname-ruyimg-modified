// 举义：准备阶段体力上限大于存活人数时觉醒；旧 JS 仅作为语义证据。
skill juyi(2383670146) locked {
  trigger phase_prepare owner_is_target {
    if alive_count() < max_hp(self) {
      effect remove_skill(self_skill);
      effect draw_cards(self, max_hp(self));
      effect add_skill(self, 3365741831);
      effect add_skill(self, 2998881378);
    }
  }
}
