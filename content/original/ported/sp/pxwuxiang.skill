// 武乡（pxwuxiang，州郡技能）：当你获得此技能后，你从牌堆中获得一张【火攻】。
// 上游 (sp/skill.js:1274)：trigger player:changeSkillsAfter；filter = addSkill 含本技；
// forced；content = gain(cardPile2("huogong"))。
// 实现：skill_added + owner_skill_added_self_4127527891 → gain_card_by_kind(self,
// huogong)（从牌堆/弃牌堆检索一张【火攻】）。
skill pxwuxiang(4127527891) {
  trigger skill_added owner_skill_added_self_4127527891 {
    effect gain_card_by_kind(self, huogong);
  }
}
