// dzkanpo：转化技，每轮限一次，可将黑色杀当看破使用
// 触发事件：source:damageSource
// 含有 viewAs/hiddenCard — 需转化技原语
// 含有 enable — 需主动技原语
skill dzkanpo(2510392331) {
  // INTENTIONAL_EMPTY_NOOP: 上游 dzkanpo 含真实规则体（trigger、subSkill 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 148 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：视为【杀】”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
