// 任城（pxrencheng）：锁定技。你的手牌上限+X（X为你手牌中【杀】的数量）。
// 上游 (sp/skill.js:2591)：mod.maxHandcard = num + countCards("h", sha)。
// 实现：hand_limit add owner_sha_hand_count（新增 ModifierValueSource::OwnerShaHandCount，
// ABI 613 尾部追加，序数稳定）。
skill pxrencheng(2654089885) locked {
  modifier hand_limit add owner_sha_hand_count;
}
