// 礼下（lixia，士燮）：一名其他角色的结束阶段开始时，若其攻击范围不包含你，可令你或
// 该角色各摸一张牌，且你获得 1 层「避乱」负距离标记。
// 上游 (sp/skill.js:40242)：trigger global phaseJieshuBegin；filter = 事件角色存活、
// 非自己、且其攻击范围不包含拥有者；content = chooseTarget(self 或事件角色) → 摸 1
// → addSkill(rebiluan2) + storage.rebiluan2--。
// 实现：phase_end + owner_alive_other_phase_end_player_outside_owner_range（其他角色结束
// 阶段且该角色攻击范围不含拥有者）→ 可选确认 → choose(1, 2)：1 = draw_cards(self, 1)，
// 2 = draw_cards(event_player, 1) → add_skill_by_name(self, rebiluan2) →
// add_mark(self, 3075740841, -1)（避乱标记每层修正距离）。
// 与上游差异：上游「目标选择」二选一以 choose 数值分支近似；rebiluan2 标记 -1 减距离。
skill lixia(2791840336) {
  trigger phase_end owner_alive_other_phase_end_player_outside_owner_range optional {
    let option = choose(1, 2);
    if option == 1 {
      effect draw_cards(self, 1);
    }
    if option == 2 {
      effect draw_cards(event_player, 1);
    }
    effect add_skill_by_name(self, rebiluan2);
    effect add_mark(self, 3075740841, -1);
  }
}
