// 界奇谋临时效果：同名标记数等于发动时失去的体力值。
skill reqimou2(2749452350) {
  modifier distance_from add -owner_skill_mark;
  modifier sha_use_limit add owner_skill_mark;

  trigger turn_ended owner_is_target {
    let amount = mark_count(self, 2749452350);
    effect remove_mark(self, 2749452350, amount);
    effect remove_skill(self_skill);
  }
}
