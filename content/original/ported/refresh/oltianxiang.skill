// oltianxiang：刷新包技能。
// 旧JS含: chooseControl 等复杂原语，DSL未覆盖。
// triggers: player:damageBegin4
skill oltianxiang(3113643556) {
  // INTENTIONAL_EMPTY_NOOP: 上游 oltianxiang（skill.js:9598）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：受伤后可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
