// refenli：刷新包技能。
// 旧JS含: subSkill 等复杂原语，DSL未覆盖。
// triggers: player:phaseJudgeBefore
// 含子技能
skill refenli(2282316204) {
  // INTENTIONAL_EMPTY_NOOP: 上游 refenli 为组/继承壳（group 指向子技承载，子技另评），原「audio-only 无规则面」注记系 2026-09-03 批 159 复核改判——壳维持 noop。
  // 原“批量最小近似：结束阶段可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
