// 旋风（rexuanfeng）：失去装备区牌/弃两张+手牌后：依次弃置一至两名其他角色共两张牌，或将一名角色装备区牌移动到另一名角色装备区；背水：废除一个装备栏。
// 上游描述引自 translate.js；此前占位头（旧批量批次未写描述）已重记。
skill rexuanfeng(3097976590) {
  // INTENTIONAL_EMPTY_NOOP: 上游 rexuanfeng（skill.js:10757）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
