// new_liyu（祝融·利驭-新版）：【杀】造成伤害后，获得受伤角色一张牌。若为装备牌，由其选一名角色视为你对其使用【决斗】；否则其摸一张牌。
// 旧JS含「获得牌+判类型分支（决斗/摸牌）」多步，DSL无对应原语，未建模。
skill new_liyu(3414962735) {
  // INTENTIONAL_EMPTY_NOOP: 上游 new_liyu（skill.js:14157）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：受伤后可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
