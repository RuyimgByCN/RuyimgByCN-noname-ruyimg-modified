// olzaoxian（OL姜维·凿险）：继承自 zaoxian 的凿险效果，觉醒技。旧JS含 inherit:"zaoxian" + awakenSkill + loseMaxHp，DSL未建模。
skill olzaoxian(3905133449) {
  // INTENTIONAL_EMPTY_NOOP: 上游 olzaoxian（skill.js:9277）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
