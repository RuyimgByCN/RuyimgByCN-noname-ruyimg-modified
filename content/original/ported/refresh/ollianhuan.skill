// ollianhuan（OL庞统·连环）：hiddenCard 机制（梅花手牌视为铁索），含 ollianhuan_add 子技能增加铁索目标。
// 旧JS含 hiddenCard 视为卡+子技能多选目标，DSL无对应原语，未建模。
skill ollianhuan(2416047328) {
  // INTENTIONAL_EMPTY_NOOP: 上游 ollianhuan（skill.js:5）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：用牌后可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
