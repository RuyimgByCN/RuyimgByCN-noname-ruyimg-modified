// decadechunlaox（程普·醇醪-防）：未横置时受到伤害前，标记此次伤害（防止 decadechunlao2 误触发）。
// 旧JS中静默标记伤害事件，纯内部状态管理。DSL 无需独立建模。
skill decadechunlaox(3842928442) {
  // INTENTIONAL_EMPTY_NOOP: 上游 decadechunlaox（skill.js:9572）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：受伤后可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
