// rezhuhai：刷新包技能。
// 旧JS含: chooseControl 等复杂原语，DSL未覆盖。
// triggers: global:phaseJieshuBegin
skill rezhuhai(2885026169) {
  // INTENTIONAL_EMPTY_NOOP: 上游 rezhuhai 含真实规则体（trigger 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：结束阶段可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
