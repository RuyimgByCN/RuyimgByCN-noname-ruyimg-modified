// rexinsheng（左慈·新生-重制）：继承自 xinsheng 的新生效果，增加化身数。旧JS含 inherit:"xinsheng" + addHuashens，DSL未建模。
skill rexinsheng(2795676402) {
  // INTENTIONAL_EMPTY_NOOP: 上游 rexinsheng（skill.js:13026）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
