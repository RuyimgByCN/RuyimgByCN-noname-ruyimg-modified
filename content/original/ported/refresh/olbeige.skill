// olbeige（OL蔡文姬·悲歌）：【杀】造成伤害后，受伤角色判定，你可弃一张牌触发花色效果：红心回复/方片摸2/黑桃翻面/梅花弃2；弃牌匹配点数或花色可回收。
// 旧JS含判定四花色分支+弃牌触发+回收匹配牌，DSL无对应原语，未建模。
skill olbeige(2240720943) {
  // INTENTIONAL_EMPTY_NOOP: 上游 olbeige（skill.js:3948）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：受伤后可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
