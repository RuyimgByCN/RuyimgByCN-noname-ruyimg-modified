// 红颜：你的黑桃牌视为红桃牌；装备区有红桃装备牌时手牌上限+1。
skill olhongyan(3860377728) locked {
  modifier card_suit(spade) override heart;
  modifier hand_limit_base_max_hp override owner_has_heart_equip;
}

