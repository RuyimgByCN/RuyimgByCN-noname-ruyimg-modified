// decadezishou（孙权·制衡-decade版）：继承 rezishou 的制衡效果，附加 decadezishou_zhiheng 子技能。
// 旧JS中 `inherit: "rezishou"` 仅为别名，实际逻辑见 rezishou，此处空定义。
skill decadezishou(3494602899) {
  // INTENTIONAL_EMPTY_NOOP: 上游 decadezishou 为组/继承壳（group 指向子技承载，子技另评），原「audio-only 无规则面」注记系 2026-09-03 批 159 复核改判——壳维持 noop。
  // 原“批量最小近似：结束阶段可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
