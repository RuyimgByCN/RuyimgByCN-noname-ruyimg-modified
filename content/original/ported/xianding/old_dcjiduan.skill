// 急断（旧版）：使用牌指定目标后，可令一名有手牌的目标展示一张手牌；
// 若展示牌点数小于使用牌点数，选择令其摸手牌中缺少花色的牌各一张，或弃置每种花色手牌各一张。
// 旧 JS 的「花色集合计算」「双选项」「每目标使用追踪」无对应原语，未建模。
skill old_dcjiduan(2248791177) {
  // INTENTIONAL_EMPTY_NOOP: 上游 old_dcjiduan 含真实规则体（trigger 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：用牌后可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
