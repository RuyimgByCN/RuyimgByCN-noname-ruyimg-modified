// dcwencan：对$使用牌无距离和次数限制。DSL缺多项原语，无法精确表达。
skill dcwencan(2382200014) {
  // INTENTIONAL_EMPTY_NOOP: 上游 dcwencan 含真实规则体（enable、usable、selectTarget 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：手牌上限 +1”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
