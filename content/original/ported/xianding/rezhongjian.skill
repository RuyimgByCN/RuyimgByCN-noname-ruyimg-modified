// 忠鉴（re版）：出牌阶段，可选择一名其他角色并为其附加效果——
// 首次造成伤害后弃两张牌，或首次受到伤害后摸两张牌。
// 发动次数 +1（若有 rewrite 标记）。
// 旧 JS 的「双效果选择」「每角色延迟触发」「子技能标记追踪」无对应原语，未建模。
skill rezhongjian(3351733126) {
  // INTENTIONAL_EMPTY_NOOP: 上游 rezhongjian（skill.js:43583）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：出牌阶段限一次摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
