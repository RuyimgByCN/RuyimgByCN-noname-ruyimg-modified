// 滤心（谋袁谭）：出牌阶段限一次，将一张牌交给其他角色，选择令目标摸/弃X张牌（X=当前轮数，上限5）。若移动牌与摸/弃牌同名，目标下个技能回复/失去1点体力。
// DSL缺轮数动态X+牌名比对+下技能触发 原语，无法表达。
skill lvxin(3438012004) {
  // INTENTIONAL_EMPTY_NOOP: 上游 lvxin 含真实规则体（enable、filterCard、filterTarget 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：出牌阶段限一次摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
