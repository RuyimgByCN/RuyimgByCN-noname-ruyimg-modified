// 展骥（zhanyuan）：觉醒技，准备阶段开始时，若通过「蛮嗣」累计获得≥7张牌——
// 回复1点体力并增加1点体力上限；可选择失去「蛮嗣」并令一名男性角色和你一同获得「系力」。
// 旧 JS 的「蛮嗣累计计数」「觉醒+技能交换」「多角色技能授予」无对应原语，未建模。
skill zhanyuan(3180287322) {
  // INTENTIONAL_EMPTY_NOOP: 上游 zhanyuan 含真实规则体（trigger、juexingji 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：结束阶段可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
