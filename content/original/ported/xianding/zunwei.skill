// 尊位：出牌阶段限一次，选择一项（不能重复选择已选过的）——
// 选择一名体力值大于你的角色：回复至与其相同；
// 选择一名手牌数大于你的角色：摸至与其相同（最多5张）；
// 选择一名装备数大于你的角色：从牌堆依次使用装备牌直至装备数相同。
// 旧 JS 的「三选项不重复」「数值追赶」「自动装备」无对应原语，未建模。
skill zunwei(3085121111) {
  // INTENTIONAL_EMPTY_NOOP: 上游 zunwei 含真实规则体（enable、usable、chooseButton 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：出牌阶段限一次摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
