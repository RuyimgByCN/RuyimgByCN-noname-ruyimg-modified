// 才识（re）：摸牌阶段结束时——
// 若摸到的牌花色全部相同：获得重铸能力；
// 否则若已受伤：回复1点体力，但本回合不能对自己使用牌。
// 旧 JS 的「摸牌花色检查」「双分支」「不能自指debuff」无对应原语，未建模。
skill recaishi(2634274471) {
  // INTENTIONAL_EMPTY_NOOP: 上游 recaishi（skill.js:43702）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：手牌上限 +1”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
