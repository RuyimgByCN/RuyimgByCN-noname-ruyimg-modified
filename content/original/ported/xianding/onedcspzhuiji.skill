// 追击（OL版）：出牌阶段结束时，若本阶段造成过伤害，可选择一名受伤角色，
// 对其连续使用等同于伤害点数的【杀】（无距离限制）。
// 旧 JS 的「伤害点数累计」「循环虚拟杀」无对应原语，未建模。
skill onedcspzhuiji(2943073029) {
  // INTENTIONAL_EMPTY_NOOP: 上游 onedcspzhuiji（skill.js:21138）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
