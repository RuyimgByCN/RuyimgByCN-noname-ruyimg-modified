// 穿心（DC张飞）：出牌阶段使用【杀】【决斗】造成伤害时，可取消之，令目标选择：弃所有装备并失去1点体力/弃两张手牌且本回合非锁定技失效。
// DSL缺伤害取消+二选一分支+技能失效 原语，无法表达。
skill dcchuanxin(3154241665) {
  // INTENTIONAL_EMPTY_NOOP: 上游 dcchuanxin（skill.js:23511）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：受伤后可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
