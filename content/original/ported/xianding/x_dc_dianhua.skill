// 点化（x版）：准备阶段/结束阶段，观看牌堆顶四张牌——
// 获得其中一张「法箓」已记录花色的牌，将其余牌以任意顺序放回牌堆顶。
// 旧 JS 的「与法箓花色联动」「移牌选择UI」无对应原语，未建模。
skill x_dc_dianhua(3681913197) {
  // INTENTIONAL_EMPTY_NOOP: 上游 x_dc_dianhua（skill.js:16005）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
