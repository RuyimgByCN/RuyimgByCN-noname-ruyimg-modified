// dcsbshimou：出牌阶段技能。DSL缺多项原语，无法精确表达。
skill dcsbshimou(3940395801) {
  // INTENTIONAL_EMPTY_NOOP: 上游 dcsbshimou 含真实规则体（enable、usable、selectTarget 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：出牌阶段限一次摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
