// 卜算（管辂）：出牌阶段限一次，选择一名其他角色，从牌堆中选择至多两种牌名，目标获得"天使的节拍"子技能（记录所选牌名）。
// DSL缺 choose_card_name_from_pile + 动态子技能授予，无法表达。
skill busuan(2994596782) {
  // INTENTIONAL_EMPTY_NOOP: 上游 busuan 含真实规则体（enable、filterTarget、usable 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：出牌阶段限一次摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
