// 控雾（旧版）：转换技，出牌阶段限一次，弃置至多体力上限张牌并选择一名其他角色；
// 阳：视为对其使用等量张【杀】；阴：弃置其等量张牌。
// 若阶段结束时其手牌数和体力值均不大于你，其下回合摸牌阶段少摸一张且装备技能失效。
// 旧 JS 的「转换技状态」「虚拟多杀」「debuff 子技能」「装备技能失效」无对应原语，未建模。
skill old_dcsbkongwu(3046131321) {
  // INTENTIONAL_EMPTY_NOOP: 上游 old_dcsbkongwu（skill.js:23260）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：手牌上限 +1”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
