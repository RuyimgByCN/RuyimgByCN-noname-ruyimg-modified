// 慈厉（DC士燮）：每轮开始时，记录一名角色的体力值。其回合结束时，若本回合用牌数<记录值→令一名角色弃等量牌；若≥ →令一名角色摸等量牌。
// DSL缺跨回合记录+条件比对+二选一效果 原语，无法表达。
skill dccili(4194284726) {
  // INTENTIONAL_EMPTY_NOOP: 上游 dccili（skill.js:40381）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
