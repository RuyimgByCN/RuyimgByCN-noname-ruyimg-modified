// 铸刃·闪电（PY）：装备技能，【杀】指定目标后，目标判定——
// 黑桃：受到3点雷电伤害；梅花：受到1点雷电伤害，你回复1点体力并摸一张牌。
// 旧 JS 的「装备技能」「目标判定」「花色分支伤害」无对应原语，未建模。
skill pyzhuren_shandian(4040348492) {
  // INTENTIONAL_EMPTY_NOOP: 上游 pyzhuren_shandian 含真实规则体（trigger 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：用牌后可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
