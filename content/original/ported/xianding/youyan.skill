// 幽燕：你的出牌/弃牌阶段内，当你失去的牌进入弃牌堆时——
// 获得与这些牌花色不同的花色牌各一张（每阶段每方向限一次）。
// 旧 JS 的「花色差集」「阶段定向追踪」「从牌堆搜索」无对应原语，未建模。
skill youyan(2558745496) {
  // INTENTIONAL_EMPTY_NOOP: 上游 youyan（skill.js:42471）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
