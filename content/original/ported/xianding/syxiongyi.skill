// 雄毅（sy）：觉醒技，濒死时发动——
// 若徐氏在将池：变身为徐氏并回复至3体力；
// 否则获得「魂姿」并回复至1体力。
// 衍生「魂姿」「英姿」「魂音」。
// 旧 JS 的「变身换将」「觉醒+多技能授予」「条件分支角色」无对应原语，未建模。
skill syxiongyi(3345276585) {
  // INTENTIONAL_EMPTY_NOOP: 上游 syxiongyi 含真实规则体（enable、limited 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：出牌阶段限一次摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
