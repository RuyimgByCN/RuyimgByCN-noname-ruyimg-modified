// 武斗：两组效果，每回合各限一次——
// 1. 其他角色对你使用伤害牌结算后：视为对其使用【决斗】；
// 2. 其他角色使用【决斗】指定目标（不包含你）后：获得此牌并将目标改为你。
// 旧 JS 的「双触发」「虚拟决斗」「决斗目标重定向+获得牌」无对应原语，未建模。
skill wudou(2650122629) {
  // INTENTIONAL_EMPTY_NOOP: 上游 wudou（原注记行 skill.js:3461）在当前上游树无对应块（快照期存在、现已移除）——批 159 复核改判快照债；移植侧头部注释已如实登记语义。
  // 原“批量最小近似：用牌后可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
