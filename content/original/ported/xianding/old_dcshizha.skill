// 恃诈（旧版）：每回合限一次，当其他角色使用牌时，若其本回合上一动作为体力变化（非使用牌），
// 你可以取消此牌并获得之。
// 旧 JS 的「全局历史回溯检查」「牌取消+获得」无对应原语，未建模。
skill old_dcshizha(2693556405) {
  // INTENTIONAL_EMPTY_NOOP: 上游 old_dcshizha（skill.js:23936）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：用牌后可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
