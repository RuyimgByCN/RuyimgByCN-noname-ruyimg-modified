// 真仪（x版）：当前回合角色本回合首次使用牌时，可消耗一条已记录花色发动——
// 红桃：目标+1/-1；方片：伤害+1/-1；黑桃：使用者用该花色牌时摸1/不能使用该花色；
// 梅花：额外结算一次/无效。
// 旧 JS 的「四花色八选项」「花色消耗」「目标/伤害/禁用修改」无对应原语，未建模。
skill x_dc_zhenyi(4039766568) {
  // INTENTIONAL_EMPTY_NOOP: 上游 x_dc_zhenyi（skill.js:15729）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：手牌上限 +1”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
