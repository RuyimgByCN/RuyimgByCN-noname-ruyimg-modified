// 挫锐（wl版）：出牌阶段开始时，选择一名队友/距离1内角色，
// 弃置其区域内一张牌。然后可展示对手至多两张手牌并获得其中与此牌同花色的牌，
// 或弃置对手装备区内至多两张同花色牌。
// 旧 JS 的「模式分支（身份/国战）」「手牌展示获取」「同花色装备弃置」无对应原语，未建模。
skill wlcuorui(3812483315) {
  // INTENTIONAL_EMPTY_NOOP: 上游 wlcuorui 含真实规则体（trigger 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：视为【杀】”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
