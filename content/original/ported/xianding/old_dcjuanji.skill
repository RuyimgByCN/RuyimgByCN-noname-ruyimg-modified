// 狷急（旧版）：回合内三阶段可选触发——摸牌阶段开始时摸体力上限张牌；
// 出牌阶段开始时失去1点体力视为对一名角色使用【杀】；
// 弃牌阶段开始时调整手牌至手牌上限并弃置一名角色区域里至多两张牌。
// 旧 JS 的「三阶段不同分支」「虚拟杀」「调整手牌+弃置区域牌」无对应原语，未建模。
skill old_dcjuanji(2559002450) {
  // INTENTIONAL_EMPTY_NOOP: 上游 old_dcjuanji（skill.js:16548）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
