// dcweiwei：本回合结束时，你可以对$中的手牌中仍有你因【维卫】交换给其的牌的角色造成1点伤害。DSL缺多项原语，无法精确表达。
skill dcweiwei(3572083408) {
  // INTENTIONAL_EMPTY_NOOP: 上游 dcweiwei 含真实规则体（trigger、usable 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：用牌后可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
