// 告谏（旧版）：出牌阶段使用锦囊牌后，可指定一名其他角色；
// 从牌堆顶展示最多5张牌，目标可选择使用其中一张锦囊牌或与展示牌交换手牌。
// 旧 JS 的「牌堆顶展示」「双选择（使用/交换）」「移牌UI」无对应原语，未建模。
skill old_dcgaojian(3280664630) {
  // INTENTIONAL_EMPTY_NOOP: 上游 old_dcgaojian（skill.js:23981）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
