// 摧心（DC曹节）：使用牌指定上家/下家为目标后，可视为对上家/下家再使用一张同名牌。
// DSL缺上家/下家方向选择+二次使用同名牌 原语，无法表达。
skill dccuixin(2594660070) {
  // INTENTIONAL_EMPTY_NOOP: 上游 dccuixin 含真实规则体（trigger 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：用牌后可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
