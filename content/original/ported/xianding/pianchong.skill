// 偏宠：摸牌阶段，放弃摸牌改为从牌堆获得红黑各一张牌；再选一种颜色，
// 直至下回合开始，失去该颜色牌时从牌堆获得另一颜色牌。
// 旧 JS 的「替换摸牌」「颜色声明」「失去牌触发补给」「跨回合状态追踪」无对应原语，未建模。
skill pianchong(3430306768) {
  // INTENTIONAL_EMPTY_NOOP: 上游 pianchong 含真实规则体（trigger 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：结束阶段可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
