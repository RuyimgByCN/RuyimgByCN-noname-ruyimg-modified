// 仇隙（DC神曹操）：限定技，出牌阶段，视为使用一张牌名长度≤本回合发动次数的伤害牌。使用后可追加本轮对其造成过伤害的角色为目标。弃置大量手牌后可刷新之。
// DSL缺限定技+牌名长度限制+历史查询+追加目标+刷新 原语，无法表达。
skill dcczchouxi(2180584699) {
  // INTENTIONAL_EMPTY_NOOP: 上游 dcczchouxi（skill.js:9112）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：视为【杀】”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
