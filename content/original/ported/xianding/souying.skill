// 擞影：每回合限一次——
// 当你本回合第二次以上对同一角色使用【杀】/锦囊牌时：弃一张牌获得使用牌；
// 或当你本回合第二次以上成为同一角色【杀】/锦囊牌的目标时：弃一张牌令此牌对你无效。
// 旧 JS 的「对同一角色使用次数追踪」「双触发方向」「弃牌cost」无对应原语，未建模。
skill souying(4284313448) {
  // INTENTIONAL_EMPTY_NOOP: 上游 souying 含真实规则体（trigger、usable 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：用牌后可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
