// 筹汐（DC神曹操）：出牌阶段，将一张牌当"沧溟"扩展区中存在的任意基本/锦囊牌使用（无次数距离限制，牌名不重复）。
// DSL缺扩展区牌名查询+chooseButton虚拟牌+无限使用 原语，无法表达。
skill dcchouxi(3890583287) {
  // INTENTIONAL_EMPTY_NOOP: 上游 dcchouxi 含真实规则体（enable、mod、chooseButton 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：视为【杀】”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
