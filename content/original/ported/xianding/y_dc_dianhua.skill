// 点化（y版）：准备/结束阶段，观看牌堆顶（1+真仪标记数）张牌；
// 获得其中一张，其余以任意顺序放回牌堆顶。
// 旧 JS 的「观看牌堆顶」「选择获得+放回」无对应原语，未建模。
skill y_dc_dianhua(4176122624) {
  // INTENTIONAL_EMPTY_NOOP: 上游 y_dc_dianhua（skill.js:16250）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
