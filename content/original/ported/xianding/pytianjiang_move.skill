// 天匠·移（PY）：出牌阶段，可将装备区一张牌移至其他角色装备区；
// 若此牌是「铸刃」锻造的装备且移动后不在你装备区，你摸两张牌。
// 旧 JS 的「装备移动」「锻造装备识别」「条件摸牌」无对应原语，未建模。
skill pytianjiang_move(3386418949) {
  // INTENTIONAL_EMPTY_NOOP: 上游 pytianjiang_move（skill.js:45258）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：出牌阶段限一次摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
