// 咒缚（xin版）：出牌阶段限一次，将一张牌置于一名角色的扩张区中；
// 该角色判定时，须用扩张区中的牌替代判定牌。
// 旧 JS 的「扩张区置入」「判定替代」无对应原语，未建模。
skill xinzhoufu(2411916165) {
  // INTENTIONAL_EMPTY_NOOP: 上游 xinzhoufu（skill.js:41503）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：出牌阶段限一次摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
