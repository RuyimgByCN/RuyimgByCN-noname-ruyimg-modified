// 天劫：其他角色的回合结束时，若本局游戏曾洗牌，可选择至多三名其他角色——
// 依次对其造成X点雷电伤害（X为其手牌中【闪】的数量，至少为1）。
// 旧 JS 的「全局洗牌历史检查」「多目标选择」「按手牌中特定牌数量伤害」无对应原语，未建模。
skill tianjie(4106647506) {
  // INTENTIONAL_EMPTY_NOOP: 上游 tianjie 含真实规则体（trigger 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：结束阶段可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
