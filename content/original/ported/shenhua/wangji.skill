// 王基【奇制/进趋】— 旧 JS 语义参考（sp 王基 qizhi/jinqu）：
// 奇制：使用牌指定目标后（首目标时机），可弃置一名非目标角色的一张手牌/装备牌并令其
// 摸一张牌，本回合奇制次数 +1。
// 进趋：出牌阶段结束时，摸两张牌并将手牌弃置至本回合奇制次数张。
skill qizhi(2224182078) {
  trigger card_used owner_is_source optional {
    effect resolve_qizhi(self);
  }
}
skill jinqu(126618454) {
  trigger phase_end owner_is_target optional {
    effect resolve_jinqu(self, 2224182078);
  }
}
