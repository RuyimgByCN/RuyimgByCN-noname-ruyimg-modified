// 雄乱（张绣，限定技）：出牌阶段，你可以废除装备栏和判定区，然后选择一名其他角色。
// 直到回合结束，你对其使用牌无距离和次数限制，其不能使用或打出手牌。
// 旧 JS 仅作语义证据；限定技的整局一次以技能实例状态标记（XL1）由
// resolve_xiongluan 权威状态机校验；装备栏/判定区废除、目标距离/次数豁免与
// 禁手牌由引擎状态机施加（ABI 590）。
skill drlt_xiongluan(1234567904) {
  active play_phase uses_per_turn 1 targets 1 1 other {
    effect resolve_xiongluan(self, event_source, 1);
  }
}

// 雄乱·封禁（目标获得）：本回合不能使用或打出手牌。
skill drlt_xiongluan_ban(1234567905) {
  modifier hand_card_use_response_cancel override 1;
}
