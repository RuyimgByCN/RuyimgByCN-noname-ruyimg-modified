// 征荣（毌丘俭）：当你使用【杀】或普通锦囊牌指定第一个目标后，若目标中有手牌数
// 不小于你的角色，你可以将其中一名目标角色的一张牌置于你的武将牌上，称为「荣」。
// 目标合法性（首个目标、伤害标签基本/锦囊、目标手牌≥持有者且有手/装备）由过滤器
// owner_source_first_damage_card_target_hand_gte_owner 与 resolve_zhengrong 权威校验
// （ABI 545）；「荣」映射为本技能牌堆。
skill zhengrong(3942454790) {
  trigger card_targeted owner_source_first_damage_card_target_hand_gte_owner optional {
    effect resolve_zhengrong(self);
  }
}

// 鸿举（毌丘俭）：觉醒技，准备阶段，若你的「荣」数量不小于 3，你可以将任意张手牌
// 与等量「荣」交换，然后减 1 点体力上限，获得「清俭」。交换为可选（旧 JS
// chooseToMove 可取消，文档化一致）；觉醒一次性以持有清俭守卫（ABI 546）。
skill hongju(1729861379) locked {
  trigger phase_prepare owner_phase_begin_skill_pile_gte_three_3942454790 {
    effect resolve_hongju(self, 3345707863, 3942454790);
  }
}

// 清俭（毌丘俭）：出牌阶段限一次，你可以弃置一张手牌，获得一张「荣」，然后弃置一名
// 其他角色装备区或判定区内的一张牌。阶段流程由 resolve_qingjian 权威校验（ABI 547）。
skill qingjian(3345707863) {
  active play_phase uses_per_turn 1 {
    effect resolve_qingjian(self, 3942454790);
  }
}
