// 雪衣（雪衣·锁定技）：其他群势力角色数使你的手牌上限+（重复项为上游同条款两次叠加，
// 与 sp/starzhonggu 同约定保留）。
skill xueyi(3178128297) locked lord_only {
  modifier hand_limit add alive_other_qun_count;
  modifier hand_limit add alive_other_qun_count;
}

