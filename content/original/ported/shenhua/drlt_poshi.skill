// 破势（陆抗）：觉醒技，准备阶段开始时若体力值为 1，或装备栏均被废除后，失去 1 点
// 体力上限，摸牌至体力上限张数，然后用「怀柔」替换「决堰」。
// 旧 JS 仅作语义证据；体力上限变化、补牌与技能替换由权威状态机校验。
// 注：旧 JS 以 phaseZhunbeiBegin 单一觉醒触发 +「无可用装备栏或体力值为 1」过滤，
// DSL 无逻辑或表达式，拆分为两个触发分支；以 drlt_poshi 觉醒标记防重复觉醒。
skill drlt_poshi(2821742222) locked {
  trigger phase_prepare owner_is_target {
    if mark_count(self, 2821742222) == 0 {
      if hp(self) == 1 {
        effect add_mark(self, 2821742222, 1);
        effect change_max_hp(self, -1);
        if 0 < max_hp(self) - hand_count(self) {
          effect draw_cards(self, max_hp(self) - hand_count(self));
        }
        effect remove_skill_by_def(self, 3834102895);
        effect add_skill(self, 3699262389);
      }
    }
  }

  trigger equip_slot_disabled owner_is_event_player_no_enabled_equip_slot_once_per_game {
    if mark_count(self, 2821742222) == 0 {
      effect add_mark(self, 2821742222, 1);
      effect change_max_hp(self, -1);
      if 0 < max_hp(self) - hand_count(self) {
        effect draw_cards(self, max_hp(self) - hand_count(self));
      }
      effect remove_skill_by_def(self, 3834102895);
      effect add_skill(self, 3699262389);
    }
  }
}
