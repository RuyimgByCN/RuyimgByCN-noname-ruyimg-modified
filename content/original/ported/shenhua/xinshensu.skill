// 神速（界夏侯渊）：判定阶段开始时，可跳过判定阶段和摸牌阶段，视为对攻击范围内一名
// 其他角色使用一张【杀】；出牌阶段开始时，可弃置一张装备牌并跳过出牌阶段，视为使用
// 一张【杀】；弃牌阶段开始时，可跳过弃牌阶段并将武将牌翻面，视为使用一张【杀】。
// 旧 JS（xinshensu group: shensu1/shensu2/shensu4）仅作语义证据；旧 group 行为
// 折叠进同一定义，阶段跳过、翻面与虚拟【杀】由权威状态机校验。
// 注：神速·二的弃牌成本旧 JS 限定装备牌，DSL 以 discard_hand_equip(1) 放宽为任意
// 手牌/装备牌，属文档化近似。
skill xinshensu(2561255694) {
  trigger phase_judge owner_is_target optional {
    effect skip_judge_and_draw_phases(self);
    effect choose_use_virtual_sha(self, normal_distance);
  }

  trigger phase_play owner_is_target optional {
    effect discard_hand_equip(self, 1);
    effect skip_current_phase(self);
    effect choose_use_virtual_sha(self, normal_distance);
  }

  trigger phase_discard owner_is_target optional {
    effect turn_over(self);
    effect skip_current_phase(self);
    effect choose_use_virtual_sha(self, normal_distance);
  }
}
