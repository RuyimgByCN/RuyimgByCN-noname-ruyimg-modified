// nsjihui（集计）晋升：第九十五批·queue_extra_turn 第五消费者（每回合一次
// storage 自锁；check=0 纯额外回合）。近似：①目标限制子技（额外回合内用牌只能
// 指定自己与弃牌者）未建模；②每回合一次自锁收窄上游事件流语义；③frequent。
skill nsjihui(3934300121) {
  trigger turn_ended owner_is_target {
    effect storage_set(self_skill, 1, 0);
  }
  trigger cards_moved cards_moved_discard_at_least_three optional {
    if storage_get(self_skill, 1) == 0 {
      effect storage_set(self_skill, 1, 1);
      effect queue_extra_turn(self, 0, self_skill);
    }
  }
}
