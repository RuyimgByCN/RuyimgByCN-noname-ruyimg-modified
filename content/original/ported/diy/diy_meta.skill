// nsfuge（复归）晋升：第八十九批 queue_extra_turn 第四消费者（storage 自锁一次性，
// check=0 纯额外回合）。上游 phaseAfter + !storage.nsfuge + insertPhase；近似：
// frequent 自动发动以 optional 确认表达。
skill nsfuge(3934300080) {
  trigger turn_ended owner_is_target optional {
    if storage_get(self_skill, 1) == 0 {
      effect storage_set(self_skill, 1, 1);
      effect queue_extra_turn(self, 0, self_skill);
    }
  }
}
