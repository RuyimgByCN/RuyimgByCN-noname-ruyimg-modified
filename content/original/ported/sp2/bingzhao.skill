// 秉诏（SP张鲁·主公技）：游戏开始时，选择一个其他势力声明并获得对应标记。
// 旧 JS 含 zhuSkill（主公技）+ chooseControl 选势力，标记用于联动技能。
// DSL 无 chooseControl（选势力）原语且无主公技标记系统。
skill bingzhao(2875669257) {
  // INTENTIONAL_EMPTY_NOOP: 上游 bingzhao 含真实规则体（trigger、zhuSkill 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：结束阶段可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
