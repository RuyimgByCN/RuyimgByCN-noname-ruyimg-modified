// 披挂（星张昭）：造成不少于2点伤害后，获得受伤角色至多roundNumber张牌；此牌不计入手牌上限且不能被弃牌阶段弃置。
// 旧 JS 含 damageSource + gainPlayerCard(by roundNumber) + gaintag + ignoredHandcard modifier + cardDiscardable modifier。
// DSL 无法表达按回合数动态获取数量、无 gaintag/ignoredHandcard modifier 原语。
skill dcpigua(3723547275) {
  // INTENTIONAL_EMPTY_NOOP: 上游 dcpigua 含真实规则体（trigger 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：手牌上限 +1”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
