// 逢时（孙桓）：使用牌指定唯一目标且手牌多于其时，可弃你与目标各一张牌并令此牌伤害+1。
// 旧 JS 含 useCard + hand count compare + 双向 discard + baseDamage 修改。
// DSL 无「你的手牌多于目标」作为触发条件、无 baseDamage++ 修改、无双向弃牌原语。
skill dcmffengshi(2828248874) {
  // INTENTIONAL_EMPTY_NOOP: 上游 dcmffengshi（skill.js:17152）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：用牌后可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
