// 崇义（牛辅）：其他角色出牌阶段使用首张杀时，可令其摸2张且本回合杀次数+1；
// 出牌阶段结束时，若其最后一张使用的牌是杀，其手牌上限+1，你可获得置入弃牌堆的此杀牌。
// 旧 JS 含双 trigger + markup + addTempSkill + modifier 子技能 + gain cards from discard。
// DSL 无「最后一张使用牌」检测、无 phaseUseEnd 子技能级联、无 gain 弃牌堆中特定牌原语。
skill dcchongyi(3173745594) {
  // INTENTIONAL_EMPTY_NOOP: 上游 dcchongyi 含真实规则体（trigger 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：手牌上限 +1”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
