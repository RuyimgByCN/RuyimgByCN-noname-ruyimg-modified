// 勤国（吕岱）：当你于回合内使用装备牌后，你可视为对一名其他角色使用一张【杀】；
// 当你失去装备区里的牌后（或其他角色使用装备、判定区有牌进入等），若你的装备区牌
// 数等于你的体力值且你已受伤，你回复 1 点体力。
// 旧 JS 仅作语义证据；装备使用→虚拟【杀】由 resolve_xinfu_qinguo 校验，回复分支由
// 过滤器 owner_equip_zone_changed + (empty_equip_slots == 5 - hp) 等价装备数==体力
// （ABI 474）。
skill xinfu_qinguo(2648676099) {
  trigger card_used owner_is_source {
    effect resolve_xinfu_qinguo(self);
  }
  trigger cards_moved owner_equip_zone_changed {
    if hp(self) < max_hp(self) {
      if empty_equip_slots(self) == 5 - hp(self) {
        effect recover_hp(self, 1);
      }
    }
  }
}
