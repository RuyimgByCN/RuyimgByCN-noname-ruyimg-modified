// mubing（sp2/skill.js:12964）：出牌阶段开始亮出牌堆顶 3/4 张牌，可弃置任意张手牌
// 并按点数之和获得其中若干张，可交给其他角色；觉醒技 diaoling 满足条件后移除。
// 旧 JS 实现较复杂，DSL 原语暂不足以精确建模（保真度债，ADR 0597 同款登记）。
skill mubing(3004071206) {
  // INTENTIONAL_EMPTY_NOOP: 上游含真实规则体，DSL 原语暂不足以精确建模；
  // 原“批量最小近似：结束阶段可选摸一张”为保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
