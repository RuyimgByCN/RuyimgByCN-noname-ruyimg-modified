// 急筹：出牌阶段，可记录并视为使用一张未记录过的锦囊牌（限一次），
// 或交出记录过的锦囊牌给其他角色。记录的牌名对其他角色对你无效。
// 缺牌名记录、虚拟锦囊使用、条件免疫原语，空定义。
skill twjichou(2992562993) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twjichou 含真实规则体（enable、chooseButton 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：视为【杀】”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
