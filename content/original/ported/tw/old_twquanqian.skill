// 劝迁（旧版）：出牌阶段，将一至四张花色各不相同的手牌交给一名其他角色；≥2张则从牌堆获一张装备牌。
// 若手牌数≥目标，无事发生；否则选择摸至与目标相同或观看其手牌并获得一种花色全部手牌。
// 旧JS中「花色集合选择」「按花色获得手牌」「孙笨标记追踪弃牌进度恢复技能」无对应原语，无法精确表达。
// 空定义，注明缺原语。
skill old_twquanqian(3251217054) {
  // INTENTIONAL_EMPTY_NOOP: 上游 old_twquanqian（skill.js:11051）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：出牌阶段限一次摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
