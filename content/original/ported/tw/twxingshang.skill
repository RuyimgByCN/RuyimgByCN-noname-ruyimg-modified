// 行殇（神·曹操）：出牌阶段，你可以消耗"颂"标记发动以下效果：
// 2标记→复原一名角色的武将牌（解锁连环/翻面）；
// 2标记→令一名角色摸min(5,max(2,已阵亡角色数))张牌；
// 5标记→令一名体力上限<10的角色回复1体力、+1体力上限、恢复一个废除的装备栏；
// 5标记→获得一名已阵亡角色的武将技能并失去〖行殇〗〖放逐〗〖颂威〗。
// 旧 JS 的「标记消耗选择」「四模式技能夺取」无对应原语。
skill twxingshang(2253228327) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twxingshang（skill.js:3988）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：出牌阶段限一次摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
