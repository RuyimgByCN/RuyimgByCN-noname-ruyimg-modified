// 募讨：出牌阶段，选择一名有手牌的角色，其将手牌中的【杀】
// 按座次依次分发给后续角色，最后一名获得【杀】的角色受到min(2,获杀数)点伤害。
// 缺连环发牌与累计伤害原语，空定义。
skill twmutao(3791332540) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twmutao 含真实规则体（enable、usable 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：出牌阶段限一次摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
