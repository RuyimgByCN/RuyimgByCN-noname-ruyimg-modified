// 滔乱（神·郭嘉）：当一名角色的判定结果确定前，你可以弃置一张与判定结果花色相同的牌，中止此判定。
// 旧 JS 的「中止判定(judgment cancel)」「花色匹配弃置」无对应原语。
skill twtaoluan(2311934577) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twtaoluan（skill.js:1234）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
