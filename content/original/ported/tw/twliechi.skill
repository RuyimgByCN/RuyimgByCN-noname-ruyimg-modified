// 烈斥（幻曹丕相关）：受伤后若来源体力不小于你且牌多于你，
// 可选三择一：令来源弃手牌差、弃来源一张牌、或「背水」弃装备并执行以上两项。
// 缺三择一分支与背水条件检测原语，空定义。
skill twliechi(3940563292) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twliechi（skill.js:18319）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：受伤后可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
