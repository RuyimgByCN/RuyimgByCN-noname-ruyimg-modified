// 履刃（童渊）：造成伤害后目标获得「刃」标记。使用多目标伤害牌时
// 可追加有「刃」的角色为额外目标（移除标记）。拼点时拼点牌点数+2*失去的牌数。
// 缺标记计数与追加目标、拼点加成原语，空定义。
skill twlvren(2365805375) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twlvren 含真实规则体（trigger 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：受伤后可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
