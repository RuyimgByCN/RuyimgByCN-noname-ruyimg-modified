// 奇计：出牌阶段开始时，选择一名角色，视为对其使用X张【杀】
// （X=手牌包含的不同类型数）。目标可依次选择其他角色摸1并转移杀。
// 缺连续虚拟多杀与转移链原语，空定义。
skill twqiji(3319625610) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twqiji 含真实规则体（trigger 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：结束阶段可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
