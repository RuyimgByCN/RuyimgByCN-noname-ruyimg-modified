// 受绶（严纲）：锁定技。当你获得牌时，其他角色至你的距离+1；
// 当你受到伤害时，其他角色至你的距离-1。
// 旧 JS 的「双标记加减距离」「分别累计正负标记」无对应原语。
skill twshoushou(3051721314) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twshoushou 含真实规则体（trigger 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：手牌上限 +1”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
