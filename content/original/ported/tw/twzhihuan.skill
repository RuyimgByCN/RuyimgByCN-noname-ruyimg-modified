// 置换（幻·诸葛果）：一名角色的回合结束时，若你本回合失去过两种以上类别的牌，
// 你可以获得其装备区一张牌，或从牌堆/弃牌堆获得并使用空置装备栏对应类别的装备牌。
// 你的拼点牌点数+已损失体力值。
// 旧 JS 的「失去牌类别统计」「空置装备栏」「拼点点数加成」无对应原语。
skill twzhihuan(2173077330) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twzhihuan 含真实规则体（trigger 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：受伤后可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
