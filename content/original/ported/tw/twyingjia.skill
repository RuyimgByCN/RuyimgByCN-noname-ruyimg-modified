// 应嘉（葛玄）：一名角色的回合结束时，若你本回合使用过同名牌锦囊牌两次，你可以弃置一张手牌，
// 令一名角色进行一个额外的回合。
// 旧 JS 的「同名牌使用两次检测」「额外回合(insertPhase)」无对应原语。
skill twyingjia(3926938433) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twyingjia 含真实规则体（trigger 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：结束阶段可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
