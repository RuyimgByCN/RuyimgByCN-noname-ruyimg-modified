// 邀虎（李遗）：回合开始时，你可以选择一个势力。当该势力角色的出牌阶段开始时，
// 其获得一张"生"并须对另一名角色使用一张【杀】，否则本回合对其使用伤害牌时须交给你两张牌否则无效。
// 旧 JS 的「势力选择」「生牌获取」「杀强制使用或惩罚」无对应原语。
skill twyaohu(2901649740) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twyaohu（skill.js:18734）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
