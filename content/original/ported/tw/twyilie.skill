// 毅烈（神·黄忠）：出牌阶段开始时，你可以选择一项：
// 1.本阶段使用【杀】次数+1；2.本回合使用【杀】指定连环状态目标后或被【闪】抵消时摸一张牌；
// 3.背水：失去1点体力并依次执行以上两项。
// 旧 JS 的「三选项含背水」「杀连环/被闪摸牌追踪」无对应原语。
skill twyilie(3577828340) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twyilie（skill.js:16948）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：手牌上限 +1”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
