// 逆我（幻刘禅）：出牌阶段开始时，选择一名角色，各选择等量张手牌标记。
// 标记牌不可使用/打出。缺等量选牌与gaintag禁用原语，空定义。
skill twniwo(4087932372) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twniwo 含真实规则体（trigger 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：手牌上限 +1”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
