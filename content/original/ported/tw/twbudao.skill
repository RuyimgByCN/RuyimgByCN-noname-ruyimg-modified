// 布道：限定技，准备阶段减1点体力上限并回复1点体力，从七个衍生技能中随机获一个，可令一名其他角色也获得并交给你一张牌。
// 旧JS中「随机技能选择」「技能分享」「交学费」无对应原语，无法表达。
skill twbudao(4099301560) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twbudao 含真实规则体（trigger、limited 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：结束阶段可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
