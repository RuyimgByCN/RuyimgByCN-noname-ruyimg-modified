// 颂威（神·魏·曹操）：主公技，锁定技。出牌阶段开始时，你增加与魏势力角色数相关的"行殇"标记。
// 出牌阶段，你可以移除一名魏势力角色的所有技能。
// 旧 JS 的「移除特定势力角色全部技能」「行殇标记联动」无对应原语。
skill twsongwei(3438223385) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twsongwei（skill.js:4544）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：出牌阶段限一次摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
