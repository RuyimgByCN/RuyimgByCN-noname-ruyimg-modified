// 困兕：出牌阶段，视为对一名未发动过此技能的角色使用【杀】。
// 若未造成伤害，目标获得「聆律」（额外技能）。
// 缺目标记录与条件技能授予原语，空定义。
skill twkunsi(2765573650) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twkunsi 含真实规则体（enable 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：出牌阶段限一次摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
