// 翰鸿：出牌阶段选择一种本阶段未选过的花色（至多4种），弃置等同于该花色手牌最大数量张牌，从牌堆获一张该花色牌；若弃牌含草花则摸一张牌。
// 旧JS中「花色计数」「牌堆检索」「花色追踪去重」无对应原语，无法表达。
skill twhanhong(2889212180) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twhanhong 含真实规则体（enable、chooseButton 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：出牌阶段限一次摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
