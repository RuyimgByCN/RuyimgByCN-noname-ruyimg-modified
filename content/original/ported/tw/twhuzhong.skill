// 护众（幻曹丕相关）：出牌阶段使用【杀】指定单一目标后，摸一张牌并选择：
// 弃置目标一张手牌（若此杀造成伤害本阶段可额外使用一张杀）或为此杀增加一个额外目标。
// 缺二选一分支与条件额外杀次数原语，空定义。
skill twhuzhong(2205633769) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twhuzhong 含真实规则体（trigger 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：手牌上限 +1”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
