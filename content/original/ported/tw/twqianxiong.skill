// 潜凶：出牌阶段，观看牌堆顶5张牌，将其中一张扣置于一名角色武将牌上。
// 其出牌阶段开始时选择：同名触发伤害+回合结束移除/或你依次使用其扣置牌。
// 缺牌扣置(expansion)与双选择分支原语，空定义。
skill twqianxiong(2470646646) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twqianxiong 含真实规则体（enable、usable 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：出牌阶段限一次摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
