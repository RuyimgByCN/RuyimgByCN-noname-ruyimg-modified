// 翔御（顾雍）：锁定技。当你使用【杀】指定目标后，若你至目标的距离小于你的攻击范围，
// 此【杀】需要两张【闪】抵消。你的攻击范围+X（X=本回合失去过牌的其他角色数，最多5）。
// 旧 JS 的「双闪需求」「攻击范围动态追踪失去牌角色」无对应原语。
skill twxiangyu(2377684682) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twxiangyu（skill.js:16731）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：手牌上限 +1”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
