// 血卫（神·典韦）：当一名其他角色的出牌阶段开始时，你可以选择第三名角色。
// 当前回合角色选择：1.本回合不能对该角色使用【杀】且手牌上限-2；
// 2.你视为对其使用一张【决斗】。
// 旧 JS 的「三目标链式选择」「杀限制+手牌上限」「虚拟决斗」无对应原语。
skill twxuewei(2695444990) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twxuewei（skill.js:18238）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：手牌上限 +1”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
