// 羽化（樊稠）：当你于非当前回合角色时失去非基本牌，你可以观看牌堆顶X张牌并任意调整顺序，
// 然后摸X张牌（X=失去的非基本牌数，至多5）。你的非基本牌不计入手牌上限且不能被弃牌阶段弃置。
// 旧 JS 的「guanxing观星」「非基本牌手牌上限豁免」无对应原语。
skill twyuhua(2669150097) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twyuhua（skill.js:15069）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：手牌上限 +1”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
