// 雄袭（袁谭）：出牌阶段，你可以弃置任意张牌，对一名其他角色造成1点伤害。
// 弃置的牌数不能超过你的暴虐值上限。
// 旧 JS 的「暴虐值上限联动」「任意张弃牌转伤害」无对应原语。
skill twxiongxi(2312365407) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twxiongxi 含真实规则体（enable、filterCard、usable 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：出牌阶段限一次摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
