// 回援（幻曹丕相关）：出牌阶段首次获得某类型牌后，展示一名角色一张手牌，
// 若类型相同则获得之，否则其弃置并摸一张；若你在其攻击范围内而它不在你的攻击范围内，
// 对其造成1点伤害。缺卡牌类型条件比较和位置判定原语，空定义。
skill twhuiyuan(2773065969) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twhuiyuan 含真实规则体（trigger 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：用牌后可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
