// 钳袭（TW牛金）：准备阶段摸一张牌并弃一张牌，选择距离1内的角色，
// 其本回合不能使用/打出所弃置花色的手牌。若你本回合对其造成杀伤害，
// 其下回合只能使用/打出该花色的手牌。
// 缺花色条件禁用与阶段切换原语，空定义。
skill twqianxi(3620954317) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twqianxi（skill.js:17661）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
