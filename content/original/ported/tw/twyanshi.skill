// 言誓（李赵）：锁定技。游戏开始时/首轮开始前，选择一名其他角色。
// 当你或该角色首次受到伤害时，你摸三张牌并令来源获1枚"誓"标记。
// 出牌阶段，你可以将一张手牌当有伤害的牌对有"誓"标记的角色使用，
// 使用后移除其"誓"标记。
// 旧 JS 的「誓标记系统」「view_as伤害牌限目标」无对应原语。
skill twyanshi(2757709924) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twyanshi 含真实规则体（enable、mod、chooseButton 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：视为【杀】”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
