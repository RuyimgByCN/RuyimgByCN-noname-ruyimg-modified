// 巧伺（TW周善）：结束阶段，获得本回合其他角色从手牌区弃置的所有牌。
// 若获得牌数小于体力值，失去1点体力。
// 缺跨角色弃牌追踪与条件体力惩罚原语，空定义。
skill twqiaosi(2694375083) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twqiaosi 含真实规则体（trigger 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：结束阶段可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
