// 试义（神·张辽）：出牌阶段，你可以选择一名有手牌的其他角色。你先选择并展示其一张手牌，
// 然后其选择并展示你的一张手牌。双方各从牌堆中获得一张与原展示牌类别相同的牌。
// 若展示的两张牌类别相同，双方各摸两张牌；否则双方再各获得一张同类别牌。
// 旧 JS 的「双向选牌展示」「类别判定分支」无对应原语。
skill twshiyi(2675612775) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twshiyi 含真实规则体（enable、usable 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：出牌阶段限一次摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
