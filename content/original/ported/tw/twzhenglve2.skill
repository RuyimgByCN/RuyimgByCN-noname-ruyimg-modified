// 征略2（神·郭淮）：〖征略〗衍生。你使用的无视次数限制的牌不计入使用次数。
// 出牌阶段对有"猎"标记的角色使用牌无目标数限制。
// 旧 JS 的「不计次数」「猎标记目标限制豁免」无对应原语。
skill twzhenglve2(3527959079) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twzhenglve2（skill.js:1722）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：手牌上限 +1”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
