// 华章（幻曹丕）：出牌阶段结束时，重铸所有可重铸手牌，
// 根据重铸牌的花色相同/点数连续/牌名相同分别计数，每满足一项摸等量牌，
// 满足两项以上获得手牌上限加成。缺 recast 后牌面分析原语，空定义。
skill twhuazhang(3385302021) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twhuazhang 含真实规则体（trigger 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：手牌上限 +1”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
