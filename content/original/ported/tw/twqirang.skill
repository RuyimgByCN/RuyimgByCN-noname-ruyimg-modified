// 绮让：装备牌后从牌堆获得一张锦囊牌（标记）。使用标记锦囊时
// 此牌不可被响应且可增减一个目标。标记在下个阶段开始时清除。
// 缺随机锦囊获取+gaintag标记增减目标原语，空定义。
skill twqirang(3569958716) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twqirang（skill.js:14943）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：手牌上限 +1”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
