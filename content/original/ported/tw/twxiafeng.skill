// 黠凤（蒋济）：出牌阶段开始时，若你拥有"暴虐"值，你可以消耗X点暴虐值，
// 则本回合你使用的前X张牌无距离限制、不可响应，且手牌上限+X。
// 旧 JS 的「暴虐值消耗」「前N张牌不可响应+距离无限」无对应原语。
skill twxiafeng(3027283883) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twxiafeng 含真实规则体（trigger 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：手牌上限 +1”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
