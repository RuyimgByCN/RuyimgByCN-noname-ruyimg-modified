// 诘狂：其他角色使用牌指定单一目标且目标体力小于你时，
// 你可失去体力或减体力上限，代替目标成为此牌目标。
// 结算后若无人因此牌受伤，你可对来源使用同名牌。
// 缺目标替换与同名牌虚拟使用原语，空定义。
skill twjiekuang(3017628878) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twjiekuang 含真实规则体（trigger、usable 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：用牌后可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
