// 黍离（幻曹昂）：可将与你已废除装备栏副类别相同的装备牌当【杀】使用或打出
// （无距离限制，不计次数）。以此法使用/打出后摸一张牌。
// 缺已废除槽位检测与view_as副类别过滤原语，空定义。
skill twliyuan(3619690223) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twliyuan 含真实规则体（enable、mod、viewAs 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：视为【杀】”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
