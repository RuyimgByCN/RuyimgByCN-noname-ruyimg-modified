// 应机·无懈（神·郭嘉）：〖应机〗的衍生技能。当你不是当前回合角色且手牌数为0时，
// 你可以视为使用【无懈可击】并摸一张牌。
// 旧 JS 的「手牌为空条件」「虚拟无懈+摸牌」无对应原语。
skill twyingji_wuxie(2698540348) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twyingji_wuxie（skill.js:23768）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：视为【杀】”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
