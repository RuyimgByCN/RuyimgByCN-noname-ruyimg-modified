// 放逐（神曹操相关）：每回合首次受到来源伤害后，选择：
// 封印其非锁定技+「远步」直到下回合结束，或令其当前手牌不可使用/打出直到下回合。
// 子技能「流放」：每轮限一次，交换两名相邻角色座次。
// 缺技能封印+牌组禁用与座次交换原语，空定义。
skill twsbfangzhu(3432288989) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twsbfangzhu（skill.js:3679）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：手牌上限 +1”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
