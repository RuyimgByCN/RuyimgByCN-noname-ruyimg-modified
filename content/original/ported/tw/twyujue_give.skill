// 予爵·给牌（神·鲁肃）：出牌阶段，你可以将任意张牌交给拥有〖予爵〗的角色
// （每轮至多2张，若你为群势力且该角色拥有主公技〖风起〗则至多4张）。
// 旧 JS 的「逐角色上限追踪」「势力+主公技联动」无对应原语。
skill twyujue_give(2305599551) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twyujue_give 含真实规则体（enable、filterCard 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：出牌阶段限一次摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
