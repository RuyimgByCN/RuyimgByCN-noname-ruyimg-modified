// 缚庶：可将一张手牌与牌堆顶拼点当【桃】使用，赢则无事否则下次受伤害+1。
// 旧JS中「拼点view-as」「拼点失败debuff」「延迟伤害+1」无对应原语，无法表达。
skill twfushu(2887044106) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twfushu 含真实规则体（enable、viewAs、filterCard 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：视为【杀】”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
