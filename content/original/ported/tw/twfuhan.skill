// 扶汉：限定技，准备阶段消耗"放魂"标记，调整体力上限至与标记相关值，回复1点体力，从五张随机蜀势力武将牌中选一张获得其所有技能，获得梅影枪。
// 旧JS中「标记消耗转换」「随机武将牌选择」「武将技能获取」「装备牌检索」无对应原语，无法表达。
skill twfuhan(2789259835) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twfuhan（skill.js:26985）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
