// 任贤：出牌阶段，将任意张非【闪】基本牌交给一名角色，
// 其执行一个仅有出牌阶段的额外回合，且只能使用交予的牌（杀不限次数）。
// 缺额外回合插入与使用牌限制原语，空定义。
skill twrenxian(4198771091) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twrenxian 含真实规则体（enable、mod、filterCard 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：手牌上限 +1”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
