// 眩惑（神·SP貂蝉）：摸牌阶段结束后，你可以交给一名其他角色两张牌，
// 然后该角色选择一项：1.视为对另一名角色使用【杀】或【决斗】；
// 2.交给你两张牌。
// 旧 JS 的「三目标链式选择」「虚拟杀/决斗二选一」无对应原语。
skill twxuanhuo(3725461617) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twxuanhuo（skill.js:17436）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
