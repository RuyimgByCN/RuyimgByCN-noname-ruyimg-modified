// 缓图：每轮限一次，其他角色摸牌阶段开始时，可交给其一张牌取消摸牌阶段。其结束阶段你选择：其回复1体+摸2 / 你摸3+交其2张手牌。若其造成伤害可执行另一选项。
// 旧JS中「交牌取消阶段」「延迟二选一+背水」无对应原语，无法表达。
skill twhuantu(3043563043) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twhuantu（skill.js:2253）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
