// 崇望（主公技）：群势力角色出牌阶段开始时可将一张牌交给你并获得庇护；本回合内你与该角色无法互相使用伤害牌指定对方。
// 旧JS中「主公技」「交牌互动」「伤害牌双向屏蔽」无对应原语，无法表达。
skill twchongwang(2376807101) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twchongwang（skill.js:11901）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：手牌上限 +1”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
