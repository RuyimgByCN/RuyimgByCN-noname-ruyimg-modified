// 轻悍：出牌阶段，弃置一张装备牌与一名角色拼点。
// 赢=视为对其使用一张可选的非延时锦囊；输=获得双方的拼点牌。
// 缺拼点结果分支与虚拟锦囊选择原语，空定义。
skill twqinghan(2943897683) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twqinghan 含真实规则体（enable、filterCard、usable 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：出牌阶段限一次摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
