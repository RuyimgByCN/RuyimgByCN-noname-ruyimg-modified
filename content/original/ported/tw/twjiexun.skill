// 诫训：结束阶段，选择一种花色，令一名其他角色摸场上该花色装备/判定牌数张，
// 然后弃置（本局已发动次数）张牌。若弃牌数相等且自动弃置，可修改技能或将次数归零摸牌。
// 缺花色全场计数、多步条件分支与技能修改原语，空定义。
skill twjiexun(3595610440) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twjiexun（skill.js:15713）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
