// 明策（幻曹冲）：出牌阶段，交给其他角色一张牌，其选择：
// 失去1体力令你摸2+额外张并获1「策」，或其摸1+额外张。
// 最多发动两次且不可重复选择。「策」可在下回合出牌阶段初造成等量伤害。
// 缺交牌+目标选择+标记累积/消费原语，空定义。
skill twmingce(3830186480) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twmingce（skill.js:2367）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：出牌阶段限一次摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
