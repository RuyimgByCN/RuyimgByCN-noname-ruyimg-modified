// 娉婷（幻大乔相关）：每轮开始时或你的回合中有角色濒死时，摸一张牌
// 并将一张牌置于武将牌上为「星舞」。有「星舞」时获得「天香」「流离」。
// 缺expansion条件技能授予与动态检测原语，空定义。
skill twpingting(3781392408) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twpingting（skill.js:18180）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：濒死时可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
