// 继伐（幻曹昂）：濒死时，根据「扶息」发动次数减体力上限，
// 选择保留「皇主」或「黍离」之一，回复体力至上限，
// 替换皮肤与技能为幻曹昂形态。缺濒死变身体系与技能选择原语，空定义。
skill twjifa(2246826515) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twjifa 含真实规则体（trigger 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：濒死时可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
