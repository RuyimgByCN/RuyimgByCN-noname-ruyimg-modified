// 魂游（幻诸葛亮）：限定技，进入濒死时发动，回复至1体力，
// 获得免疫伤害/失去体力的buff，当前阶段结束后插入额外回合，
// 替换皮肤与技能。缺阶段插入、皮肤替换、技能替换原语，空定义。
skill twhunyou(3788550412) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twhunyou 含真实规则体（enable、limited 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：出牌阶段限一次摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
