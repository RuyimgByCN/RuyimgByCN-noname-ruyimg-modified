// 舌论（神·诸葛亮）：出牌阶段，你可以选择1-2名攻击范围内的角色，与之进行辩论。
// 若你赢且出红色→弃置每名目标两张牌；若出黑色→对每名目标造成1点伤害。
// 旧 JS 的「辩论(debate)机制」「按颜色分别结算」无对应原语。
skill twshelun(2860135714) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twshelun（skill.js:1443）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：出牌阶段限一次摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
