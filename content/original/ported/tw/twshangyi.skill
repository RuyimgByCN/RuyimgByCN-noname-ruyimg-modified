// 尚义（王凌）：出牌阶段，你可以弃置一张牌，然后观看一名其他角色的手牌并选择一项：
// 1.弃置其一张黑色手牌→你摸一张牌；
// 2.与其交换各一张手牌（均红色则你摸一张牌）。
// 旧 JS 的「对方手牌中选一张弃置」「双方各选一张交换」为交互式UI，DSL无对应原语，无法精确表达。
skill twshangyi(3187506856) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twshangyi（skill.js:16636）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：出牌阶段限一次摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
