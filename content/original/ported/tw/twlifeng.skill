// 砾烽：出牌阶段，弃置两张点数差等于与目标距离的牌，对其造成1点伤害。
// 若未使用「逆我」标记的牌，摸一张牌。
// 缺点数差距离计算与标记检测原语，空定义。
skill twlifeng(2492912554) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twlifeng 含真实规则体（enable、filterCard、selectCard 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：出牌阶段限一次摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
