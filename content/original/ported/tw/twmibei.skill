// 密备：使命技。记录使用的牌名，当基本/锦囊/装备各至少记录2张不同牌名时
// 使命成功，获得「谋立」。出牌阶段未使用牌则使命失败，手牌上限-1。
// 缺三类型牌名追踪与使命成败分支原语，空定义。
skill twmibei(3997760638) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twmibei（skill.js:14679）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：手牌上限 +1”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
