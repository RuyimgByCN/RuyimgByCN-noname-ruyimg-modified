// 咒诅（神·诸葛亮）：出牌阶段，你可以选择一名其他角色并选择1-3回合的施法时长。
// 经过相应数量的"回合结束时"后，目标弃置X张牌（X=选择的回合数），然后你对其造成1点雷电伤害。
// 旧 JS 的「延迟施法(mahou)」「目标弃牌+雷电伤害」无对应原语。
skill twzhouzu(3977425549) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twzhouzu（skill.js:24978）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：出牌阶段限一次摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
