// 征建/众斥：选择出牌阶段检查条件，累计不同交牌角色后改为伤害。
skill twzhengjian(3256371970) locked {
  trigger game_started owner_alive {
    effect resolve_twzhengjian(self, self, 2937107858, 0);
  }
  trigger phase_play_end owner_alive_other_phase_play_end_twzhengjian_condition {
    effect resolve_twzhengjian(self, event_player, 2937107858, 1);
  }
}

