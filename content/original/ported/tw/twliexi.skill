// 裂隙：准备阶段，弃置任意张牌并选择一名角色。
// 若弃牌数大于其体力值则对其造成伤害，否则其对你造成伤害。
// 若弃置了武器牌则额外造成一次伤害。
// 缺弃牌数比较与武器检测原语，空定义。
skill twliexi(2576410949) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twliexi 含真实规则体（trigger 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：结束阶段可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
