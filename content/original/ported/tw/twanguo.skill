// 安国：游戏开始时/每轮开始时，令一名其他角色获得"安国"标记，赋予三个持续效果。
// 可移动标记、按已损失体力摸牌给牌、濒死时移除一个效果回血至1。
// 旧JS中「标记传递」「多效果管理」「濒死分支选效果」无对应原语，无法表达。
skill twanguo(2836724871) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twanguo（skill.js:1942）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：手牌上限 +1”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
