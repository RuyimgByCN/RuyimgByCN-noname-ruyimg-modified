// 据陈：结束阶段，若场上有手牌数大于你且体力值大于你的角色，
// 所有其他角色依次弃置一张牌（优先装备区），然后你获得其中红色牌。
// 缺逐人多弃牌与条件颜色筛选原语，空定义。
skill twjuchen(3898864127) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twjuchen 含真实规则体（trigger 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：结束阶段可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
