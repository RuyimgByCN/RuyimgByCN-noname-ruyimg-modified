// 劝迁：其他角色摸牌阶段结束时，摸至多5张牌补至手牌最多角色水平。
// 可选择交给该角色任意张牌，根据交出牌类型/花色数获得收益。
// 缺手牌差补牌与分类花色计数+子技能孙奔标记复原原语，空定义。
skill twquanqian(3805901439) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twquanqian 含真实规则体（trigger 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：手牌上限 +1”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
