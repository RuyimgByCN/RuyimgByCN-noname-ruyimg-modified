// 随征（神·张辽）：锁定技。游戏开始时，你选择一名其他角色为"随征"角色。
// 当"随征"角色造成伤害后，你摸一张牌；当其受到伤害后，你选择一项：
// 1.弃置两张基本牌，令其回复1点体力；2.失去1点体力，令其从牌堆中获得一张【杀】或【决斗】。
// 旧 JS 的「指定特定角色追踪」「二选一补偿」「基本牌弃置条件」无对应原语。
skill twsuizheng(2403902242) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twsuizheng 含真实规则体（trigger 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：结束阶段可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
