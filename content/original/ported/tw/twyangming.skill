// 扬命（邴原）：出牌阶段结束时，你可以摸X张牌（X=本回合你使用的牌的类别数），本回合手牌上限+X。
// 旧 JS 的「统计使用的牌类别数」无对应原语。
skill twyangming(4169225286) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twyangming 含真实规则体（trigger 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：手牌上限 +1”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
