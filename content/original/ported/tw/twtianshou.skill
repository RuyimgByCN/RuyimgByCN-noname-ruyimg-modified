// 天授（史阿）：回合结束时，若本回合你使用【杀】造成过伤害且你拥有"武"标记，
// 你可以令一名其他角色获得1枚"武"并获得此标记效果，然后你摸两张牌。
// 旧 JS 的「标记转移+技能临时赋予」「武标记系统联动」无对应原语。
skill twtianshou(3213954641) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twtianshou 含真实规则体（trigger 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：结束阶段可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
