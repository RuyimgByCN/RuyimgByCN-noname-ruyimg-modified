// 疠火/醇醪：普通杀改火并可加目标；以全场唯一“醇”增伤或救援。
skill twlihuo(2910350044) {
trigger card_used owner_source_normal_sha {
    effect resolve_twchengpu(self, event_player, event_source, event_card, 2257064269, 0);
    effect choose_add_current_sha_target(self, event_card);
  }
  trigger card_used owner_source_fire_sha {
    effect choose_add_current_sha_target(self, event_card);
  }
}

