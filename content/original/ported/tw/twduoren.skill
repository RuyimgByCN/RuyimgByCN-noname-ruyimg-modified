// 夺刃：有角色死亡时，与其交换非stock技能（失去自己的非初始技能，获得其非隐藏非主公技）。
// 旧JS中「技能交换」「死亡时技能接管」无对应原语，无法表达。
skill twduoren(3146366912) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twduoren 含真实规则体（trigger 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：结束阶段可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
