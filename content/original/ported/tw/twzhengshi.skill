// 争適（神·SP诸葛诞）：锁定技。游戏开始时，若角色数<=3，所有角色获得〖隽嗣〗；
// 否则你选择两名其他角色，你与这些角色获得〖隽嗣〗。
// 每轮开始时/拥有〖隽嗣〗的角色死亡后，你令一名角色的〖隽嗣〗摸牌数或弃牌数+1或-1。
// 旧 JS 的「批量技能赋予」「隽嗣参数调整」无对应原语。
skill twzhengshi(2233260984) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twzhengshi 含真实规则体（trigger 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：结束阶段可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
