// 流俪（幻司马懿）：其他角色成为伤害牌目标时，可弃置其装备/判定区一张红色牌，
// 令此牌对其无效。若你的受伤状态与其相同，摸两张牌。
// 缺条件弃置特定区域牌+免疫与对称状态检测原语，空定义。
skill twliuli(2841557854) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twliuli 含真实规则体（trigger 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：用牌后可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
