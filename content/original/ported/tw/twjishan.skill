// 积善（外服何进）：造成伤害时，可记录目标；其他角色受到伤害时，
// 可失去2体力防止伤害并各摸一张牌。已记录且体力最小的受伤角色可回复1体力。
// 缺双条件触发与目标记录/检索原语，空定义。
skill twjishan(3163036583) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twjishan（skill.js:1552）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：受伤后可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
