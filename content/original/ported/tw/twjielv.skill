// 竭律（幻诸葛亮）：锁定技。回合结束时若本回合未使用牌指定过该回合角色，
// 失去1点体力。失去体力/受伤后增加1点体力上限（最高7）。
// 幻化状态下减体力上限后改为回复体力。
// 缺本回合目标追踪与体力上限动态调整原语，空定义。
skill twjielv(2966822263) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twjielv 为组/继承壳（group 指向子技承载，子技另评），原「audio-only 无规则面」注记系 2026-09-03 批 159 复核改判——壳维持 noop。
  // 原“批量最小近似：结束阶段可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
