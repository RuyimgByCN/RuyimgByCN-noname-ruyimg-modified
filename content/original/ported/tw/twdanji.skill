// 单骑：手牌多于体力且主公不为刘备时觉醒，减一点体力上限并获得马术、怒斩。
skill twdanji(2211821528) locked {
  trigger phase_prepare owner_is_target_hand_above_hp_no_liubei_lord {
    effect remove_skill(self_skill);
    effect change_max_hp(self, -1);
    effect add_skill(self, 2);
    effect add_skill(self, 2974830679);
    effect add_skill(self, 2360461242);
  }
}

// 觉醒后的永久效果：每回合首次使用由实体牌转化的【杀】结算后摸一张牌。
skill twdanji_effect(2360461242) locked {
  trigger card_used owner_first_transformed_sha_used_this_turn {
    effect draw_cards(self, 1);
  }
}