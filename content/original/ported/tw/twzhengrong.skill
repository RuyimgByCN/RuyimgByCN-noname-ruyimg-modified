// 争荣（神·王允）：出牌阶段，当你使用牌指定其他角色为目标后（每阶段第奇数张），
// 或你本阶段首次造成伤害后，你可以将一名其他角色的一张牌作为"荣"置于你的武将牌上。
// 旧 JS 的「第奇数张追踪」「荣牌存储」无对应原语。
skill twzhengrong(3927726661) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twzhengrong（skill.js:17868）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：受伤后可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
