// 令法（张让相关）：每轮开始时，根据轮次获得不同效果：
// 第1轮=其他角色使用杀需要弃牌否则受伤，第2轮=使用桃需交牌否则受伤，
// 第3轮起=失去此技能并获得衍生技能。
// 缺轮次分支与技能替换原语，空定义。
skill twlingfa(3769189480) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twlingfa 含真实规则体（trigger 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：结束阶段可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
