// 星卜（幻·陆逊）：回合结束时，亮出牌堆顶三张牌。根据其中红色牌的数量，
// 你可令一名角色获得对应效果直到其下回合结束：
// 0张红→"荧惑守心"（出牌阶段使用【杀】次数-1）；
// 1张红→"扶匡东柱"（出牌阶段首张牌结算后弃一摸二）；
// 2张红→"五星连珠"（摸牌+2，出牌杀次数+1，跳过弃牌）。
// 旧 JS 的「三效果分支」「亮出牌计数」无对应原语。
skill twxingbu(2836647868) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twxingbu（skill.js:5784）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：手牌上限 +1”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
