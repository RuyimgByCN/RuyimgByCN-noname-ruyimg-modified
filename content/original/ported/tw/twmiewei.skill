// 灭威：出牌阶段开始时，本阶段使用【杀】次数等于攻击范围内角色数。
// 【杀】对原目标造成伤害时，伤害值+min(5,全场杀目标累计数)。
// 缺动态杀次数上限与累计目标计数加成原语，空定义。
skill twmiewei(2771199256) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twmiewei 含真实规则体（trigger 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：手牌上限 +1”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
