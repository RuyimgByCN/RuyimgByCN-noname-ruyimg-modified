// 解羽：结束阶段或每回合首次受伤后，弃置所有手牌，
// 从弃牌堆获得所有不同牌名的基本牌各一张。
// 缺弃牌堆按牌名检索与多牌获取原语，空定义。
skill twjieyu(3746061426) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twjieyu 含真实规则体（trigger 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：受伤后可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
