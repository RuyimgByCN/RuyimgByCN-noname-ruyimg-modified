// 双刃（神·刘备）：出牌阶段开始时，你可以与一名角色拼点。若你赢，
// 你可以视为对至多两名至其距离不大于1的角色使用【杀】；若你没赢，其可以视为对你使用【杀】。
// 若出牌阶段结束时你未发动此技能且未使用【杀】造成伤害，你可以弃置一张牌发动此技能。
// 旧 JS 的「拼点-虚拟杀-距离限制组合」「阶段结束补偿发动」无对应原语。
skill twshuangren(3174783316) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twshuangren（skill.js:17306）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
