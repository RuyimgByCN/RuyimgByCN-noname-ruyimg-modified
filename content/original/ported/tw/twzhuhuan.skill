// 诛宦（神·曹操）：出牌阶段，你可以展示所有手牌并弃置其中所有的【杀】。
// 选择一名其他角色，其选择：受到1点伤害并弃置X张牌，或令你回复1点体力并摸X张牌（X=弃置的【杀】数+1）。
// 旧 JS 的「展示+弃置特定牌」「目标二选一」无对应原语。
skill twzhuhuan(3515137798) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twzhuhuan（skill.js:1625）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
