// 力谏（孙策相关）：其他角色弃牌阶段结束时，你可与其分配本阶段进入弃牌堆的牌。
// 若其获得牌数比你多，你可对其造成1点伤害。有子技能「孙奔」追踪弃牌进度。
// 缺弃牌追踪与分配选择原语，空定义。
skill twlijian(3121698245) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twlijian（skill.js:11214）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
