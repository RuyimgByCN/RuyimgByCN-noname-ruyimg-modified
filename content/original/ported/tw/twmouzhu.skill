// 谋诛：出牌阶段，选择一名角色，令所有体力不大于你的其他角色
// 各交给你一张手牌。然后视为对目标使用【杀】或【决斗】
// （伤害基数=收到的手牌总数）。无人交牌则全体失去1体力。
// 缺多人索牌与动态伤害基数原语，空定义。
skill twmouzhu(3328668142) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twmouzhu（skill.js:26562）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：出牌阶段限一次摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
