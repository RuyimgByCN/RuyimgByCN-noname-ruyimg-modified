// 先锋（夏侯紫萼）：出牌阶段，当你使用【杀】或伤害类锦囊牌造成伤害后，
// 受伤角色选择一项：1.摸一张牌，你至其他角色的距离-1直到你下回合开始；
// 2.你摸一张牌，其至你的距离-1直到你下回合开始。
// 旧 JS 的「受伤方二选一」「距离标记逐人追踪」无对应原语。
skill twxianfeng(2578416180) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twxianfeng 含真实规则体（trigger 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：手牌上限 +1”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
