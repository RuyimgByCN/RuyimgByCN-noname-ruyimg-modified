// 新阵军（神·张郃）：出牌阶段开始时，你可以交给一名其他角色一张牌。
// 该角色须使用一张不为黑色的【杀】，否则你可以对其或其攻击范围内的一名角色造成1点伤害。
// 若其使用【杀】造成伤害，你摸等量张牌。
// 旧 JS 的「交牌→强制使用非黑杀」「连锁伤害/摸牌」无对应原语。
skill xinzhenjun(2942227496) {
  // INTENTIONAL_EMPTY_NOOP: 上游 xinzhenjun 含真实规则体（trigger 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：结束阶段可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
