// 援护（神·赵云）：出牌阶段，你可以将一张装备牌置入一名角色的装备区。
// 根据装备类型产生额外效果：武器→弃置距离为1的一名角色一张牌；
// 防具→其摸一张牌；坐骑/宝物→其回复1点体力。
// 若其体力值或手牌数不大于你，你摸一张牌。
// 旧 JS 的「装备类型分支效果」「体力/手牌比较摸牌」无对应原语。
skill twyuanhu(2710440934) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twyuanhu（skill.js:26256）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：出牌阶段限一次摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
