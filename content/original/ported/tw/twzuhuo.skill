// 阻祸（神·诸葛亮）：出牌阶段，你可以弃置一张非基本牌并选择1-3回合的施法时长。
// 经过相应数量的"回合结束时"后，你获得X层防止伤害效果（X=选择的回合数）。
// 旧 JS 的「延迟施法(mahou)」「多层伤害防止」无对应原语。
skill twzuhuo(2460222371) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twzuhuo（skill.js:24874）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：出牌阶段限一次摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
