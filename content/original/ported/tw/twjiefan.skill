// 解烦（旧）：限定技，出牌阶段选择一名角色，令其攻击范围内每名其他角色依次选择：
// 弃置一张武器牌或令该角色摸一张牌。全部结算后你获得技能「解烦②」。
// 缺逐人多选一结算与技能获得原语，空定义。
skill twjiefan(3499118596) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twjiefan（skill.js:17224）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：出牌阶段限一次摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
