// 攻心：出牌阶段限一次，观看一名其他角色的手牌，选择弃置其中一张或置于牌堆顶；若其手牌花色数减少，则该角色不能响应你使用的下一张牌。
// 旧JS中「观看手牌」「选择弃置/牌堆顶」「花色数比较」「禁响应」无对应原语，无法表达。
skill twgongxin(2731764784) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twgongxin（skill.js:1137）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：出牌阶段限一次摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
