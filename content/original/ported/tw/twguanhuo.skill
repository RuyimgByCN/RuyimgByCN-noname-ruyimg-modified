// 观火：出牌阶段视为使用一张【火攻】（无实体牌）；使用【火攻】摸一张牌；若视为使用的火攻未造成伤害：首次下次火攻伤害+1，再次则失去本技能。
// 旧JS中「无实体view-as」「火攻未造成伤害的条件追踪」「分支效果」无对应原语，无法表达。
skill twguanhuo(3095122979) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twguanhuo（skill.js:1767）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：视为【杀】”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
