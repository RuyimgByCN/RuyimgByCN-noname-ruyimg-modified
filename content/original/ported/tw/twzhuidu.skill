// 追妒（神·袁绍）：出牌阶段，你可以选择一名已受伤的其他角色并选择一项：
// 1.对其造成1点伤害；2.弃置其装备区一张牌；
// 3.背水：若其为女性，弃置一张牌，依次执行前两项。
// 旧 JS 的「三选项含性别条件背水」无对应原语。
skill twzhuidu(4026386550) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twzhuidu 含真实规则体（enable、usable、chooseButton 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：出牌阶段限一次摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
