// 血偿（神·吕布）：出牌阶段，你可以摸一张牌并与一名角色拼点。
// 若你赢→获得其1-2张牌，其中含装备牌则对其使用虚拟【杀】；
// 若你没赢→对其造成1点伤害，标记之使下次对其伤害+1。
// 旧 JS 的「拼点-拿牌-装备检测-虚拟杀」「伤害标记累加」无对应原语。
skill twxuechang(3850503839) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twxuechang 含真实规则体（enable、usable 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：出牌阶段限一次摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
