// 横江：出牌阶段使用基本牌或普通锦囊牌指定唯一目标时，目标改为攻击范围内的所有合法目标，本回合限一次。若有人响应此牌则摸等量张牌。
// 旧JS中「单目标改为多目标」「响应计数摸牌」无对应原语，无法表达。
skill twhengjiang(2692719950) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twhengjiang（skill.js:26175）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：用牌后可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
