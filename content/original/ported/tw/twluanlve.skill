// 乱略（冯习）：出牌阶段，将X张【杀】当【顺手牵羊】使用（X为标记数）。
// 每发动一次标记+1。发动后本阶段不可被同一角色重复顺手。
// 缺可变数量view_as与阶段目标免疫原语，空定义。
skill twluanlve(2472773886) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twluanlve 含真实规则体（enable、mod、viewAs 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：视为【杀】”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
