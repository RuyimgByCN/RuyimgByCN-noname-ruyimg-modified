// 清俭（神卞氏）：当其他角色的牌因弃置进入弃牌堆后，你可以将其中至多X张牌置于你的武将牌上（X=你的体力值+1，至少为1）；
// 你的出牌阶段结束时，你可以将这些牌分配给其他角色。
// 旧 JS 的「多目标多次交互分配」和「体力值+1上限」无对应原语，无法精确表达。
skill twsbqingjian(4018216798) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twsbqingjian（skill.js:707）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
