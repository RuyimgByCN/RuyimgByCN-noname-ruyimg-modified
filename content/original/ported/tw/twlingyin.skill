// 灵隐（幻张郃）：成为锦囊牌目标时，展示牌堆顶一张牌：
// 同色=获得之，同花色=免疫此牌，异色=弃置之。
// 缺三向花色/颜色比较与免疫原语，空定义。
skill twlingyin(3952582541) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twlingyin 含真实规则体（trigger 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：用牌后可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
