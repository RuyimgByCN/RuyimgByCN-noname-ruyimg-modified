// 秉壹：结束阶段，若所有手牌颜色或类别相同，展示所有手牌，选择至多手牌数名角色各摸一张；若颜色和类别均相同，则额外移去所有"慎"标记。
// 旧JS中「手牌颜色/类别齐整检测」「条件分支」「关联标记移除」无对应原语，无法表达。
skill twbingyi(4246188611) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twbingyi（skill.js:16864）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
