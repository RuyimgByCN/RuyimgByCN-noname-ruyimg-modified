// 延祸（神·吕布）：当你死亡时，若你的区域内有牌，你可以令一名其他角色弃置X张牌，
// 或令至多X名其他角色各弃置一张牌（X=你区域内的牌数）。
// 旧 JS 的「死亡时多目标弃牌分配」无对应原语。
skill twyanhuo(2844805273) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twyanhuo（skill.js:26677）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
