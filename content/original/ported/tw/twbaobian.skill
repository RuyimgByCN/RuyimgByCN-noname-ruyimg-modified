// 暴变：造成【杀】/【决斗】伤害时，若目标与你势力相同或手牌大于体力值，取消伤害令其补牌至体力上限；否则弃置其超过体力值的手牌。
// 旧JS中「势力判断」「分支逻辑（取消+补牌 / 弃牌）」无对应原语，无法表达。
skill twbaobian(4151788202) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twbaobian（skill.js:28624）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：受伤后可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
