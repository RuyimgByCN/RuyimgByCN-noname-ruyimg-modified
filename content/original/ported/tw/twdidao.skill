// 地道：判定牌生效前，用一张牌代替之并获得原判定牌，若颜色相同摸一张牌。
// 旧JS中「判定改判」「颜色比较摸牌」无对应原语。以 judged 相关 filter 近似可编译但语义差异大，故空定义。
skill twdidao(3851594703) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twdidao（skill.js:25165）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：结束阶段可选摸一张”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
