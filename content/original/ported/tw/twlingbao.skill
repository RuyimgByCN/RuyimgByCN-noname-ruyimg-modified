// 灵宝（张让相关）：出牌阶段，选择「丹法」移出游戏中两张不同花色的牌。
// 根据颜色组合获得效果：双红=回复1体力，双黑=弃置目标两张不同区域牌，
// 混合=目标摸1+另一目标弃1。缺expansion卡牌选择与颜色分支原语，空定义。
skill twlingbao(3546773875) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twlingbao 含真实规则体（enable、usable、chooseButton 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：出牌阶段限一次摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
