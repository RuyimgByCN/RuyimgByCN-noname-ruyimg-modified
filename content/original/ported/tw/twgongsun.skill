// 共损：锁定技，出牌阶段开始时选择攻击范围内一名其他角色并封印一种花色；你和该角色此花色牌无法使用/打出/弃置/救人，持续至下回合开始。
// 旧JS中「花色封印」「双向限制」「mod全局影响」无对应原语，无法表达。
skill twgongsun(3304263205) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twgongsun（skill.js:22737）含真实规则体，
  // DSL 原语暂不足以精确建模（见文件头注释）；原“批量最小近似：手牌上限 +1”为
  // 保真度债占位、非上游语义，已纠正为诚实 noop。
  modifier hand_limit add 0;
}
