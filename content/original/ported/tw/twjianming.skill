// 剑鸣：锁定技，使用/打出【杀】或拼点失去牌后，若此牌花色未被记录过，
// 记录该花色并摸一张牌。缺花色追踪与条件触发原语，空定义。
skill twjianming(2810704636) {
  // INTENTIONAL_EMPTY_NOOP: 上游 twjianming 含真实规则体（trigger 等键），本行原「audio-only 无规则面」注记系 2026-09-03 批 159 复核证伪——诚实 noop 待真实重写（保真度债，ADR 0597）。
  // 原“批量最小近似：用牌后可选摸一张”与上游不符（上游无此行为），已纠正。
  modifier hand_limit add 0;
}
