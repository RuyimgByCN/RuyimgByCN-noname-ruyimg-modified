// M1 standard skill pack — skill_def ids sync with engine-core skill_def / catalog.

skill jianxiong(1) {
  trigger damage owner_is_target_card_in_processing optional {
    effect move_card(event_card, zone(self, 3), zone(0, 6));
  }
}

// 护驾：需要响应【闪】时，可依次请求其他魏势力角色代为打出。
skill hujia(3353250727) lord_only {
  view_as shan response any from group_wei;
}

skill mashu(2) {
  modifier distance_from add -1;
}

// 铁骑：使用杀指定目标后可判定，红色则该目标不能响应此杀。
skill tieji(3561072419) {
  trigger card_targeted owner_source_sha optional {
    effect judge_make_current_sha_target_unrespondable_on_red(self, event_card, event_player);
  }
}

skill qicao(3) {
  modifier attack_range add 1;
}

// 离间：弃置一张牌，令第二名男性角色视为对第一名男性角色使用决斗。
skill lijian(2292478631) {
  active play_phase uses_per_turn 1
    targets 2 2 other male second_can_use_juedou_on_first
    select_he 1 1 {
      effect discard_selected(self);
      effect use_virtual_juedou_second_on_first();
    }
}

skill biyue(4) {
  trigger phase_end owner_is_target optional {
    effect draw_cards(self, 1);
  }
}

// 骁果：其他角色结束阶段，可弃基本牌，令其弃装备牌，否则受到 1 点伤害。
skill stdxiaoguo(3757481350) {
  trigger phase_end owner_alive_other_phase_end_has_discardable_basic_hand {
    effect choose_discard_basic_then_target_discard_equip_or_damage(self, event_player);
  }
}

skill fankui(5) {
  trigger damage owner_is_target_source_alive_gainable_card optional {
    if self == event_source {
      effect take_one_card(event_source, self, equip);
    } else {
      effect take_one_card(event_source, self, hand_equip);
    }
  }
}

skill tiandu(6) {
  trigger judgment_resolved owner_is_target optional {
    effect gain_event_cards(self);
  }
}

skill ganglie(7) {
  trigger damage owner_is_target optional {
    effect judge_source_discard_two_hand_or_damage(self, event_source);
  }
}

skill zhiheng(10) {
  active play_phase uses_per_turn 1 select_he 1 255 {
    effect discard_selected(self);
    effect draw_selected(self);
  }
}

// 救援：其他吴势力角色以【桃】响应濒死的主公时，额外回复 1 点体力。
skill jiuyuan(3165045964) locked lord_only {
  trigger card_responded owner_dying_other_tao_responder_group_wu {
    effect recover_hp_as(event_source, self, 1);
  }
}

skill rende(11) {
  active play_phase targets 1 1 other select_hand 1 255 {
    effect give_selected_recover_after_phase_total_two(self, event_source);
  }
}

// 激将：需要使用或响应【杀】时，依次请求其他蜀势力角色代为打出。
skill jijiang(2377283906) lord_only {
  view_as sha any any from group_shu;
}

skill kurou(12) {
  active play_phase {
    effect lose_hp(self, 1);
    effect draw_cards(self, 2);
  }
}

skill qingnang(13) {
  active play_phase uses_per_turn 1 targets 1 1 wounded select_hand 1 1 {
    effect discard_selected(self);
    effect recover_hp(event_source, 1);
  }
}

// 急救：回合外可将一张红色手牌或装备牌当桃使用。
skill jijiu(2961041949) {
  view_as tao response owner_outside_turn_red from hand_equip;
}

skill jizhi(14) {
  trigger card_used owner_source_ordinary_trick optional {
    effect draw_cards(self, 1);
  }
}

skill tuxi(15) {
  trigger phase_draw owner_is_target_other_hand_nonempty optional {
    effect choose_other_hand_targets_gain_one_replace_draw(self);
  }
}

skill wusheng(16) {
  view_as sha play_phase red;
}

skill longdan(17) {
  view_as sha play_phase card_shan;
  view_as shan any card_sha;
}
skill wushuang(18) locked {
  modifier response_count add 1;
  modifier duel_opponent_response_count add 1;
}

skill guicai(19) {
  modifier judgment_rewrite add 1;
}

// 英姿：摸牌阶段多摸 1（modifier draw_count +1）
skill yingzi(20) {
  modifier draw_count add 1;
}

// 反间：目标先猜花色，再获得一张自己的手牌；猜错则受到自己造成的 1 点伤害。
skill fanjian(36) {
  active play_phase uses_per_turn 1 hand_nonempty targets 1 1 other {
    effect target_choose_suit_gain_owner_hand_damage_if_mismatch(self, event_source);
  }
}

// 连营：手牌区失牌且手牌为空 → 摸 1（DSL 过滤器 owner_from_hand_empty）
skill lianying(21) {
  trigger cards_moved owner_from_hand_empty optional {
    effect draw_cards(self, 1);
  }
}

// 枭姬：装备区失牌 → 摸 2（DSL 过滤器 owner_from_equip）
skill xiaoji(22) {
  trigger cards_moved owner_from_equip_per_card optional {
    effect draw_cards(self, 2);
  }
}

// 咆哮：出杀无次数限制。
skill paoxiao(23) locked {
  modifier sha_use_limit override 2147483647;
}

// 倾国：黑色牌当闪（响应；window any）
skill qingguo(24) {
  view_as shan any black;
}

// 洛神：准备阶段可连续判定；获得黑色结果并可继续，红色结果停止。
skill luoshen(3972660146) {
  trigger phase_prepare owner_is_target optional {
    effect judge_black_gain_repeat(self);
  }
}

// 结姻：弃置两张手牌，令自己与一名受伤男性角色各回复 1。
skill jieyin(25) {
  active play_phase uses_per_turn 1 targets 1 1 other wounded male select_hand 2 2 {
    effect discard_selected(self);
    effect recover_hp(self, 1);
    effect recover_hp(event_source, 1);
  }
}

// 遗计：每受到一点伤害，可将牌堆顶两张牌任意分配给存活角色。
skill yiji(26) {
  trigger damage owner_is_target_per_damage_point optional {
    effect distribute_top_two_cards(self);
  }
}

// 奇袭：出牌阶段将一张黑色牌当过河拆桥使用（甘宁）
skill qixi(27) {
  view_as guohe play_phase black;
}

// 国色：出牌阶段将一张方块牌当乐不思蜀使用（大乔）
skill guose(28) {
  view_as le play_phase diamond;
}

// 流离：成为【杀】目标时，可弃一张手牌或装备牌，将目标转移给攻击范围内的其他合法角色。
skill liuli(3733125857) {
  trigger card_targeted owner_sha_target_can_discard_redirect_to_other_in_attack_range {
    effect choose_discard_redirect_current_sha(self, event_source, event_card);
  }
}

// 裸衣：通用摸牌阶段替换 + 条件伤害 modifier。（许褚）
skill luoyi(29) {
  modifier draw_replacement_damage add 1;
}

// 裸衣临时效果：来源的【杀】或【决斗】伤害 +1。
skill luoyi2(2999929189) locked {
  modifier sha_damage add 1;
}

// 谦逊：不能被顺手牵羊 / 乐不思蜀指定为目标（陆逊，锁定技）
skill qianxun(30) {
  modifier immune_shunshou add 1;
  modifier immune_le add 1;
}

// 克己与观星当前仍由通用回合/选择续体执行；声明保留完整包元数据。
skill keji(31) {
  modifier skip_discard_if_no_sha add 1;
}

skill guanxing(32) {
  modifier prepare_scry_count max 5;
}

// 空城：没有手牌时，不能成为杀或决斗的目标。
skill kongcheng(3681607931) locked {
  modifier card_target_cancel(sha) override owner_hand_empty;
  modifier card_target_cancel(juedou) override owner_hand_empty;
}

// 飞影：其他角色计算与自己的距离 +1。
skill feiying(2669566023) locked {
  modifier distance_to add 1;
}

// 奇才：使用锦囊牌无距离限制。
skill qicai(2286640837) locked {
  modifier card_distance_unlimited(trick) override 1;
}

// 将驰：摸牌阶段结束时，选择摸一张并限制杀，或弃一张并强化杀。
skill new_jiangchi(2751572143) {
  trigger phase_draw_end owner_is_target optional {
    effect choose_draw_or_discard_add_skill(self, 3349403784, 4168410091);
  }
}

// 将驰“摸牌”临时效果：不能使用或响应杀，且杀不计入手牌上限。
skill new_jiangchi3(3349403784) {
  modifier sha_use_cancel override 1;
  modifier sha_response_cancel override 1;
  modifier sha_ignored_hand_limit override 1;
  trigger turn_ended owner_is_target {
    effect remove_skill(self_skill);
  }
}

// 妄尊：其他角色准备阶段体力更高时摸一张；主公令其额外摸一张并叠加手牌上限惩罚。
skill rewangzun(3817957374) locked {
  trigger phase_prepare owner_alive_prepare_player_hp_gt_owner {
    effect draw_cards(self, 1);
  }
  trigger phase_prepare owner_alive_prepare_lord_hp_gt_owner {
    effect draw_cards(self, 1);
    effect add_skill(event_player, 2737456606);
    effect add_mark(event_player, 2737456606, 1);
  }
}

// 妄尊叠加临时效果：每层令手牌上限 -1，并在该角色的回合结束时清理。
skill rewangzun2(2737456606) {
  modifier hand_limit add -owner_skill_mark;
  trigger turn_ended owner_is_target {
    effect remove_mark(self, 2737456606, 0);
    effect remove_skill(self_skill);
  }
}

// 同疾：其他角色成为杀的目标时，其可弃一张牌，把该目标转移给技能拥有者。
skill retongji(2773091493) {
  trigger card_targeted owner_alive_other_sha_target_can_redirect_to_owner {
    effect choose_current_sha_target_discard_redirect_to_owner(
      self,
      event_source,
      event_card,
      event_player
    );
  }
}

// 机捷：每阶段限一次，展示牌堆底牌并交给任意存活角色。
skill xinfu_jijie(4028496128) {
  active play_phase uses_per_turn 1 {
    effect choose_target_gain_bottom_card(self);
  }
}

// 急援：其他角色进入濒死，或获得由自己赠予的牌后，可令其摸一张。
skill xinfu_jiyuan(2449404379) {
  trigger dying owner_alive optional {
    effect draw_cards(event_player, 1);
  }
  trigger cards_given owner_alive_gave_cards_to_other_alive optional {
    effect draw_cards(event_player, 1);
  }
}

// 神戟：使用杀的目标数上限 +2、次数上限 +1。
skill shenji(3515984232) locked {
  modifier sha_target_limit add 2;
  modifier sha_use_limit add 1;
}

// 清剿：本回合对其他群势力角色造成过伤害，结束阶段摸一张牌。
skill stdqingjiao(4273235044) locked lord_only {
  trigger phase_end owner_is_target_damaged_other_qun {
    effect draw_cards(self, 1);
  }
}

// 耀武：红色【杀】造成伤害前，存活的伤害来源强制选择摸一张牌或回复 1 点体力。
skill yaowu(3872761084) locked {
  trigger damage_before owner_is_target_red_sha_source_alive {
    effect choose_draw_or_recover(event_source, 1, 1, 0);
  }
}

// 狂斧：每个独立出牌阶段限一次；杀伤害结算后按双方当前体力分支。
skill stdkuangfu(4213747779) locked {
  trigger damage owner_source_play_sha_other_alive_once_per_play_phase {
    if hp(event_player) < hp(self) {
      effect draw_cards(self, 2);
    } else {
      effect lose_hp(self, 1);
    }
  }
}

// 淑慎：实际回复几点体力，就依次获得几次可取消的其他角色选择；空手目标改摸两张。
skill stdshushen(3504783479) {
  trigger hp_recovered owner_is_target {
    effect choose_other_draw_by_hand_count(self, 1, 2, event_amount);
  }
}

// 刚烈（国战三版）：受伤后可选择一名敌方角色判定；非红桃时其弃两张牌或受到 1 点伤害。
skill ganglie_three(3884116323) {
  trigger damage owner_is_target optional {
    effect resolve_ganglie_three(self);
  }
}

// 忠义：限定技，将一张手牌或装备牌置于武将牌上；本轮己方角色的【杀】伤害 +1。
skill zhongyi(2818590263) {
  active play_phase once_per_game select_he 1 1 {
    effect resolve_zhongyi(self, 0, 3789127080);
  }
}

skill zhongyi2(3789127080) locked {
  trigger damage_before owner_alive_source_ally_sha_damage_before {
    effect resolve_zhongyi(self, 1, 3789127080);
  }
  trigger phase_prepare owner_alive {
    effect resolve_zhongyi(self, 2, 3789127080);
  }
}

// 战神：受伤且已有友方阵亡时觉醒，弃武器、减 1 点体力上限并获得马术和神戟。
skill zhanshen(3834202888) locked {
  trigger phase_prepare owner_is_target_wounded_dead_ally {
    effect discard_equipment_slot(self, weapon);
    effect change_max_hp(self, -1);
    effect add_skill(self, 2);
    effect add_skill(self, 3515984232);
    effect remove_skill(self_skill);
  }
}

