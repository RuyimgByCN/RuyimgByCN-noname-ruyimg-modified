// 国战 gz_ 技能 DSL 批量生成（简化近似语义，旧 JS 仅作语义证据）。

// gz_beiluan：近似（trigger damage，简化为摸一张）。
skill gz_beiluan(472841726) {
  trigger damage owner_is_target optional {
    effect draw_cards(self, 1);
  }
}

